+	void PostUpdate(float afTimeStep)
+	{
+		HPL3VR_PublishSceneHands();
+        HPL3VR_UpdateNativeHands();
+		/////////////////////////
+		// Setup Properties
+		cCamera @pCam = cLux_GetPlayer().GetCamera();
+		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
+		
+		//////////////////////////////
+		// Update hand model
+		if(mbActive)
+		{
+			/////////////////////////
+			// Setup Properties
+			float fScale = mbUseFullScaleModel ? 1.0f : 0.25f;
+			cVector3f vCamRot(pCam.GetPitch(), pCam.GetYaw(), pCam.GetRoll()*0.5);
+			
+			/////////////////////////
+			// Update current rotation
+			cVector3f vCameraPos;
+			cMatrixf mtxCameraRot;
+			if(pCam.GetRotateMode() == eCameraRotateMode_EulerAngles)
+			{
+				cVector3f vDist = cMath_GetAngleDistanceVector3fRad(mvCurrentHandRotation,vCamRot);
+				float fMaxDist = cMath_ToRad(25);
+				for(int i=0; i<3; ++i)
+				{
+					float fDist = vDist.GetElement(i);
+					float fAngle = mvCurrentHandRotation.GetElement(i);
+					float fSign = cMath_Sign(fDist);
+					
+					if(cMath_Abs(fDist) > fMaxDist)
+					{
+						mvCurrentHandRotation.SetElement(i, vCamRot.GetElement(i)-fMaxDist*fSign*0.999f);
+						fAngle = mvCurrentHandRotation.GetElement(i);
+						fDist = cMath_GetAngleDistanceRad(fAngle, vCamRot.GetElement(i));
+					}
+					
+					float fT = cMath_Easing(eEasing_QuadIn, cMath_Abs(fDist)/fMaxDist);
+					mvCurrentHandRotation.SetElement(i, fAngle + fDist*afTimeStep*45*fT);		
+				}
+				
+				vCameraPos = pCam.GetPosition();
+				mtxCameraRot = cMath_MatrixRotateZXY(mvCurrentHandRotation);
+			}
+			else
+			{
+				cMatrixf mtxCamera = cMath_MatrixInverse(pCam.GetViewMatrix());
+				
+				mvCurrentHandRotation = cMath_MatrixToEulerAngles(mtxCamera.GetRotation());
+				mtxCameraRot = mtxCamera.GetRotation();
+				vCameraPos = mtxCamera.GetTranslation();
+			}
+			
+			/////////////////////////
+			// Head bob
+			cVector3f vHeadBob = Player_GetHeadBob();
+					
+			/////////////////////////
+			// Transform the hand
+			cMatrixf mtxHands = cMath_MatrixScale(fScale);
+			mtxHands = cMath_MatrixMul(cMath_MatrixRotateY(cMath_Pi), mtxHands);
+			
+			if(mbUseCustomPosition==false || mbCustomPositionUseBasicOffset)
+				mtxHands.SetTranslation(gvHandsOffset * fScale + vHeadBob*fScale*0.2f);
+				
+			if(mbUseCustomRotation)
+				mtxHands = cMath_MatrixMul(cMath_MatrixRotateXYZ(mvCustomRotation), mtxHands);
+			else
+				mtxHands = cMath_MatrixMul(mtxCameraRot, mtxHands);
+					
+			/*if(cLux_GetPlayer().GetCurrentStateId() == ePlayerState_Ladder)
+			{
+				float fFOVScale = cMath_Max(1.0f, mfHorizontalFov / mfDefaultHorizontalFov);
+				mtxHands = cMath_MatrixMul( cMath_MatrixScale(cVector3f(1, 1, fFOVScale)), mtxHands);
+				
+				mtxHands.SetTranslation(mtxHands.GetTranslation() + cVector3f(0, 0, fScale * mfMeshDepth * (fFOVScale - 1.0f) * 0.85f));
+			}*/
+
+			if(mbUseCustomPosition)
+			{
+				mtxHands.SetTranslation(mtxHands.GetTranslation() + mvCustomPosition);
+			}	
+			else
+			{
+				mtxHands.SetTranslation(mtxHands.GetTranslation() + vCameraPos);
+			}
+			
+			if(pEntity !is null) pEntity.SetMatrix(mtxHands);
+			
+			/////////////////////////
+			// Update entity
+			if(m_idCurrentAttachProp!=tID_Invalid)
+			{
+				iLuxEntity @pAttachProp = cLux_ID_Entity(m_idCurrentAttachProp);
+				if(pAttachProp !is null) pAttachProp.UpdateEntityAttachment();
+			}
+		}
+							
+		/////////////////////////
+		// Update camera
+		if(	( mbCameraAttachActive || (mbCameraAttachActive==false && mfCameraAttachT>0) ) &&
+			mbUseCustomPosition && mbUseCustomRotation)
+		{
+			cMeshEntity @pMeshEnt = pEntity.GetMeshEntity();
+			
+			/////////////////////////
+			// Update mesh (if needed)
+			// This in needed for the nodes to keep proper positions.
+			if(mbCameraAttachFadingIn && pMeshEnt.IsVisible()==false)
+			{
+				pMeshEnt.SetVisible(true);
+				pMeshEnt.ResetGraphicsUpdated();
+				pMeshEnt.UpdateAnimation(0.0f);
+				pMeshEnt.UpdateLogic(0.0f);
+				pMeshEnt.PostUpdateLogic(0.0f);
+				pMeshEnt.SetVisible(false);
+			}
+			
+			cBoneState@ pBone = pMeshEnt.GetBoneStateFromName(msCameraAttachBone);
+			if(pBone !is null)
+			{
+				////////////////////////////
+				//Get the T value
+				float fStep = mfCameraAttachFadeTime<0.0001f ? 100000.0f : afTimeStep/mfCameraAttachFadeTime;
+				
+				float fGoal = mbCameraAttachActive ? 1.0f : 0.0f;
+				mfCameraAttachT = cMath_IncreaseTo(mfCameraAttachT,  fStep, fGoal);
+				float fT = cMath_Easing(eEasing_CubicInOut, mfCameraAttachT);
+				
+				//if(mbCameraAttachActive==false) fT=0;
+				
+				////////////////////////////
+				//Set position of camera
+				cVector3f vPos = pBone.GetWorldPosition()*fT + Player_GetCameraPosition()*(1-fT);
+				vPos += cMath_MatrixMul(cMath_MatrixRotateXYZ(mvCustomRotation), mvCameraAttachPosOffset);
+				cLux_GetPlayer().GetCamera().SetPosition(vPos);
+				
+				////////////////////////////
+				//Set rotation of camera
+				iCharacterBody@ pCharBody = cLux_GetPlayer().GetCharacterBody();
+				mvCameraAttachStartRotation.y = pCharBody.GetYaw();
+				cVector3f vPlayerRot = mvCameraAttachStartRotation;
+				
+				cMatrixf mtxSocketRot;
+				{
+					mtxSocketRot = pBone.GetWorldMatrix().GetRotation();
+					mtxSocketRot = cMath_MatrixMul(mtxSocketRot, cMath_MatrixRotateXYZ(mvCameraAttachRotOffset));
+				}
+					
+				cMatrixf mtxRot = cMath_MatrixSlerp(fT, cMath_MatrixRotateXYZ(vPlayerRot), mtxSocketRot, true);
+				
+				pCam.SetRotationMatrix(mtxRot.GetTranspose());
+				
+				////////////////////////////
+				//Update model visiblity
+				if(mbCameraAttachActive)
+				{
+					//////////////////////
+					// Fade Over
+					if(mfCameraAttachT==1 && mbCameraAttachFadingIn)
+					{
+						mbCameraAttachFadingIn = false;
+						
+						///////////////////
+						//Start animation
+						SetVisible(true);
+						if(GetCurrentAnimationState() !is null)
+							GetCurrentAnimationState().SetPaused(false);
+						
+						///////////////////
+						//Callback
+						if(msCameraAttachFadeOverCallback != "")
+						{
+							tString sCallback = msCameraAttachFadeOverCallback;
+							msCameraAttachFadeOverCallback = "";
+					
+							cLuxMap @pMap = cLux_GetCurrentMap();
+							if(pMap.ScriptPrepare("void "+sCallback+"()"))
+							{
+								pMap.ScriptExecute();
+							}
+						}
+					}
+				}
+				
+				////////////////////////////
+				//Attachment is over
+				if(mbCameraAttachActive==false && mfCameraAttachT==0)
+				{
+					ClearCameraState();
+				}
+			}
+		}
+		// Apply after every authored camera/animation visibility update.
+		if (HPL3VR_ReplaceAuthoredHands() && pEntity !is null)
+			pEntity.GetMeshEntity().SetVisible(false);
+	}
