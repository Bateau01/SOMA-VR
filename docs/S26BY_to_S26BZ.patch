+	// H57.55bl semantic publisher: reports AngelScript-owned msHandModel for
+	// exact loaded-save refreshes and authored SetHandModel transitions.
+	void HPL3VR_EndHealingVisibility()
+	{
+		// Restore the default for the NEXT authored animation without showing
+		// the completed full-scale healing mesh after its entity was disabled.
+		mbEntityVisible=true;
+		iLuxEntity@ pHands=cLux_ID_Entity(m_idHands);
