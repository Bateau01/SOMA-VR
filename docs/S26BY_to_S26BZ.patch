+	//------------------------------------------------------------
+	
+	void AttachCameraToSocket(	const tString& in asBoneName, float afFadeTime,
+								const tString &in asFadeOverCallback,
+								bool abDisablePlayer, bool abAutoDetach, float afDetachTime,
+								const cVector3f&in avPosOffset, const cVector3f&in avRotOffset)
+	{
+		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
+		
+		if(pEntity.GetMeshEntity().GetBoneStateFromName(asBoneName) is null)
+		{
+			Error("Could not find bone name '"+asBoneName+"' in player hands mesh!");
+			return;
+		}
+		
+		msCameraAttachBone =asBoneName;
+		mfCameraAttachFadeTime = afFadeTime;
+		mfCameraAttachT=0;
+		mbCameraAttachActive=true;
+		mbCameraAttachFadingIn = true;
+		
+		mvCameraAttachPosOffset = avPosOffset;
+		mvCameraAttachRotOffset = avRotOffset;
+		
+		cAnimationState@ pState = GetCurrentAnimationState();
+		if(pState !is null)
+		{
+			pState.SetPaused(true);
+			
+			float fSpeed = pState.GetSpeed();
+			pState.SetTimePosition(fSpeed>=0 ? 0 : pState.GetLength());
+			
+			SetVisible(false);
+		}
+		
+		mbCameraAttachDisablePlayer = abDisablePlayer;
+		if(abDisablePlayer)
+			Player_SetActive(false);
+			
+		cCamera@ pCam = cLux_GetPlayer().GetCamera();
+		mvCameraAttachStartRotation.x = pCam.GetPitch();
+		mvCameraAttachStartRotation.y = pCam.GetYaw();
+		mvCameraAttachStartRotation.z = pCam.GetRoll();
+		
+		mbCameraAttachAutoDetach = abAutoDetach;
+		mfCameraAttachAutoDetachTime = afDetachTime;
+		
+		msCameraAttachFadeOverCallback = asFadeOverCallback;
+		
+		cLux_GetPlayer().GetCharacterBody().SetCameraUpdateActive(false);
+		
+		pCam.SetRotateMode(eCameraRotateMode_Matrix);
+	}
