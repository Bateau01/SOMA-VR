+	// H57.54h authoritative UI-state publisher. This deliberately queries the
+	// real SOMA load-screen/menu handlers rather than inferring Pause from
+	// PlayerState_Normal or Newton timing. L=loading/continue modal, M=menu
+	// handler active, G=ordinary gameplay.
+    // S26BZ: query the native stance, including camera additions used by crouch.
+    // This is read-only. The native VR rig applies compensation, not Simon's body.
+    void HPL3VR_PublishScaleHeight()
+    {
+        if (!_HPL3VR_RuntimeActive_PlayerHands()) return;
+        if (!cLux_MapIsLoaded() || cLux_IsChangingMap()) return;
+        float height = Player_GetCameraPosition().y - Player_GetFeetPosition().y;
+        if (height < 0.2f || height > 3.0f) return;
+        cScript_RunGlobalFunc("VRHEIGHT", "", ""+int(height*1000.0f+0.5f));
+    }
