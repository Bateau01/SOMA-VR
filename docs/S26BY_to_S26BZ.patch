+		
+		cLux_GetPlayer().GetCamera().SetRotateMode(eCameraRotateMode_EulerAngles);
+		cLux_GetPlayer().GetCharacterBody().SetCameraUpdateActive(true);
+		
+		cLux_GetPlayer().GetCharacterBody().SetYaw(mvCameraAttachStartRotation.y);
+		pCam.SetPitch(mvCameraAttachStartRotation.x);
+		pCam.SetYaw(mvCameraAttachStartRotation.y);
+		pCam.SetRoll(mvCameraAttachStartRotation.z);
+	}
