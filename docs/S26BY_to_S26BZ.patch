+				SetActive(false);
+			}
+			
+			////////////////////////////////////
+			// Detach
+			if(mbCameraAttachActive && mbCameraAttachAutoDetach)
+			{
+				DetachCameraFromSocket(mfCameraAttachAutoDetachTime);
+				
+				if(mbCameraAttachDisablePlayer)
+					Player_SetActive(true);
+			}
+			
+			//////////////////////////////////
+			//Callback
+			if(msAnimationOverCallback != "")
+			{			
+				tString sCallback = msAnimationOverCallback;
+				msAnimationOverCallback = "";
+				
+				if(sAnimName != "")
+				{		
+					cLuxMap @pMap = cLux_GetCurrentMap();
+					if(pMap.ScriptPrepare("void "+sCallback+"(const tString& in asAnimName)"))
+					{
+						pMap.SetArgString(0, sAnimName);
+						pMap.ScriptExecute();
+					}
+				}
+			}
+		}
