+    void HPL3VR_DestroyNativeHands(cLuxMap@ apMap)
+    {
+        if (mlVRNativeFamily>=0) cScript_RunGlobalFunc("VRMESH", "", "X");
+        for (int h=0; h<2; ++h)
+        {
+            if (mvVRNativeHands[h] !is null && apMap !is null)
+                apMap.GetWorld().DestroyMeshEntity(mvVRNativeHands[h]);
+            @mvVRNativeHands[h] = null;
+        }
+        mlVRNativeFamily = -1;
+    }
+
+    void HPL3VR_UpdateNativeHands()
+    {
+        if (!_HPL3VR_RuntimeActive_PlayerHands())
+        {
+            for (int h=0; h<2; ++h)
+                if (mvVRNativeHands[h] !is null) mvVRNativeHands[h].SetVisible(false);
+            if (mlVRNativeFamily>=0) cScript_RunGlobalFunc("VRMESH", "", "X");
+            return;
+        }
+        cLuxMap@ pMap = cLux_GetCurrentMap();
+        if (pMap is null) return;
+        int lFamily = mlVRNativeFamily;
+        if (lFamily<0 || !cScript_RunGlobalFunc("VRMESH", ""+lFamily, "F"))
+        {
+            lFamily=-1;
+            for (int f=0; f<4; ++f)
+                if (cScript_RunGlobalFunc("VRMESH", ""+f, "F")) { lFamily=f; break; }
+        }
+        if (lFamily<0) return;
+        if (lFamily!=mlVRNativeFamily)
+        {
+            HPL3VR_DestroyNativeHands(pMap);
+            // One attempt per family/map; a missing asset uses the GL fallback.
+            mlVRNativeFamily=lFamily;
+            array<tString> vFamily={"human","diving","deepsea","deepsea_mutilated"};
+            for (int h=0; h<2; ++h)
+            {
+                tString sSide=h==0 ? "left" : "right";
+                cMesh@ pMesh=cResources_CreateMesh("entities/soma_vr/s26f/hand_"+vFamily[lFamily]+"_"+sSide+".dae");
+                if (pMesh is null) continue;
+                @mvVRNativeHands[h]=pMap.GetWorld().CreateMeshEntity("S26F_TrackedHand_"+sSide,pMesh,false);
+                if (mvVRNativeHands[h] is null) { cResources_DestroyMesh(pMesh); continue; }
+                mvVRNativeHands[h].SetScriptableIsSaved(false);
+                mvVRNativeHands[h].SetVisible(false);
+                mvVRNativeHands[h].SetIsOccluder(false);
+                mvVRNativeHands[h].SetRenderFlagBit(eRenderableFlag_ShadowCaster,true);
+                mvVRNativeHands[h].SetRenderFlagBit(eRenderableFlag_VisibleInReflection,true);
+                mvVRNativeHands[h].SetRenderFlagBit(eRenderableFlag_VisibleInNonReflection,true);
+                mvVRNativeHands[h].SetDisableSleep(true);
+                mvVRNativeHands[h].Stop();
+                // Native UpdateAnimation resets active bones to their bind pose.
+                // These bones are driven by the tracked-pose bridge instead.
+                for (int b=0; b<mvVRNativeHands[h].GetBoneStateNum(); ++b)
+                    mvVRNativeHands[h].GetBoneState(b).SetActive(false);
+            }
+        }
+        for (int h=0; h<2; ++h)
+        {
+            if (mvVRNativeHands[h] is null) continue;
+            bool bVisible=false;
+            if (cScript_RunGlobalFunc("VRMESH", ""+h, "C"))
+            {
+                mvVRNativeHands[h].SetCoverageAmount(1.0f);
+                bVisible=cScript_RunGlobalFunc("VRMESH", "", "R");
+            }
+            mvVRNativeHands[h].SetVisible(bVisible);
+            if (bVisible)
+            {
+                mvVRNativeHands[h].GetBoneStateRoot().UpdateMatrix(true);
+                mvVRNativeHands[h].PostUpdateLogic(0.0f);
+            }
+        }
+    }
