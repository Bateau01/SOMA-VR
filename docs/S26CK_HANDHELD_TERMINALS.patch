+        if(msConnectedSubmesh=="medium_screen")csv+=",0.000260279,0.000055,0.999721721,0,0,0.999952331";
+        cScript_RunGlobalFunc("VRTERM",csv,mbVRTabletSurface ? "U" : "B");mbVRTabletSurface=true;
