+        tString csv=""+p.x+","+p.y+","+p.z+","+u.x+","+u.y+","+u.z+","+v.x+","+v.y+","+v.z+","+n.x+","+n.y+","+n.z+","+size.x+","+size.y+","+offset.x+","+offset.y;
