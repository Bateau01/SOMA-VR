
    bool mbHYCamera=false;
    void HYCamera(){if(!mbHYCamera)return;
        cLux_GetPlayer().GetCharacterBody().SetFeetPosition(cVector3f(18.65,252.25,-130.52),false);
        cLux_GetPlayer().GetCharacterBody().SetYaw(-1.5707963f);
        cLux_GetPlayer().GetCamera().SetYaw(-1.5707963f);
        cLux_GetPlayer().GetCamera().SetPitch(.1f);
    }
    void HRSmokeExit(const tString &in timer){
        Player_ChangeStateToNormal();Effect_Fade_In(0);
        CollideHoleArea("player","AreaClimbHole_FloorZone",1);
        mbHYCamera=true;HYCamera();
        Map_AddTimer("hy_capture",3,"HYCapture");
    }
    void HYCapture(const tString &in timer){
        if(mVREscapeGuide.mHand.mGuide.Live()){
 cMeshEntity@ m=mVREscapeGuide.mHand.mGuide.mpMesh;
 cVector3f lo=m.GetBoundingVolume().GetMin(),hi=m.GetBoundingVolume().GetMax(),cp=cLux_GetPlayer().GetCamera().GetPosition();
 LogNewLine("HZ_BOUNDS|"+lo.x+","+lo.y+","+lo.z+"|"+hi.x+","+hi.y+","+hi.z+"|camera="+cp.x+","+cp.y+","+cp.z);
 }
        LogNewLine("HY_CAPTURE_REQUEST");
        Map_AddTimer("hy_finish",6,"HYFinish");
    }
    void HYFinish(const tString &in timer){LogNewLine("HR_STORY_DONE|01_03_upsilon_outside");cEngine_Exit();}

