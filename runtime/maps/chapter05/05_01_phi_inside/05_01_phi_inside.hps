	/*Put any functions that are used in more than one scene here.*/ 
	
	//-------------------------------------------------------
 
	void SetPlayerIsUnderwater(bool abX, float afFadeTime, bool abAffectEffecs)
	{
		mbPlayerIsUnderwater = abX;
		
		//////////////////////////////
		//Underwater
		if(mbPlayerIsUnderwater)
		{
			Map_SetUnderwater(true);
			//Player_SetAmbientLight_Outdoors(true);
			Map_SetEnvironmentParticlesActive(true);
			Map_Preset_Fade("Outside", afFadeTime);
				
			if(abAffectEffecs)
			{
				Map_SetEnvironmentParticlesActive(true);
			}
		}
		//////////////////////////////
		//In Air
		else
		{
			Map_SetUnderwater(false);
			//Player_SetAmbientLight_Indoors(true);
			Map_SetEnvironmentParticlesActive(false);
			Map_Preset_Fade("Inside", afFadeTime);
				
			if(abAffectEffecs)
			{
				Map_SetEnvironmentParticlesActive(false);
			}
		}
	}
	
	//-------------------------------------------------------
	
	bool Collide_WaterSurface(const tString &in asParent, const tString &in asChild, int alState)
	{
		int lSuffixPos = cString_GetLastStringPos(asChild, "_Surface");
		tString sWaterArea = cString_Sub(asChild, 0, lSuffixPos);
		
		if (Entity_GetCollide("Player", sWaterArea)==false)
			return true;
		
		//Light_SetBrightness("AirlockWarningLight", alState == 1 ? 0.5 : 1);
		//ParticleSystem_SetVisible("Airlock1UWParticles_*", alState == -1);
		
		Effect_Screen_Start("water_splash_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 0.2f, 0.0f, 0.6f);
		
		SetPlayerIsUnderwater(alState!=1, 1, true);
		
		if(sWaterArea=="Airlock1Water")
		{
			Collide_WaterSurfacePhiEntrance(alState);
		}
		else if(sWaterArea=="Airlock2Water")
		{
			Collide_WaterSurfaceDomeExit(alState);
		}
		
		return true;
	}
	
