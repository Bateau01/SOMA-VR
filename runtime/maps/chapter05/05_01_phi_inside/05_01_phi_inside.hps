		bool LoaderArm_Move(const cVector2f &in avMoveAmount)
		{
			return false;
		}
		
		/////////////////////////////////////////////////
		
		cUtility_PickBasics mLoaderArmPickBasics;
		bool mbLoaderArmWasPicking = false;
			
		void LoaderArm_PostUpdate(float afTimeStep)
		{
			cCamera@ pCam = cLux_GetPlayer().GetCamera();

			/////////////////////////////////////
			// Zoom
			Player_FadeFOVMulTo(cMath_Clamp(1.5f-mfZoom,0.5f,1.5f),1.0f);
			
			/////////////////////////////////////
			// Picking
			bool bPicking = false;
			/*if ((mArmState != eLoaderArmState_AutoMove) && (mArmState != eLoaderArmState_Moving))
			{
				bPicking = false;
			}
			else */if (mLoaderArmPickBasics.UpdatePickCheck(pCam, true, 5, true))
			{
				iLuxEntity @pEntity = mLoaderArmPickBasics.GetFocusedEntity();
				if(pEntity !is null)
				{
					eCrossHairState state = eCrossHairState(pEntity.GetInteractIconId(0, pEntity.GetMainBody()));
					//Player_SetCrossHairState( state );
					if (state!=eCrossHairState_Default)
					{
						msLoaderPickedEntity = pEntity.GetName();
						bPicking = true;
					}
				}
			}
			
			
			if (!bPicking)
			{
				msLoaderPickedEntity = "";
				if (mbLoaderArmWasPicking)
				{
					Audio_LoadingCrane_GUI_LostTarget();
					Entity_SetActive("POVMarker_Selected",false);
					Entity_SetActive("POVMarker_Normal",true);
					Lamp_SetLit("CraneGrid_Normal",true,false);
					Lamp_SetLit("CraneGrid_Selected",false,false);
				}
			}
			else
			{
				if (!mbLoaderArmWasPicking)
				{
					Audio_LoadingCrane_GUI_OverTarget();
					Entity_SetActive("POVMarker_Selected",true);
					Entity_SetActive("POVMarker_Normal",false);
					Lamp_SetLit("CraneGrid_Normal",false,false);
					Lamp_SetLit("CraneGrid_Selected",true,false);
				}
			}
			
			mbLoaderArmWasPicking = bPicking;
		}
		
