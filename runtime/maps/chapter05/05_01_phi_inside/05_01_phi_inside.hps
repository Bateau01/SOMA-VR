				cImGuiGfx pointArk("phi_map_point_ark", eImGuiGfx_Texture);
				ImGui_DoImage(pointArk, ImGui_NrmPosGroup(0.735,0.77,4), ImGui_GetRatioCorrectSizeByNrmWidth(point, 0.0456));
			}
			
			ImGui_SetAlignment(eImGuiAlign_TopLeft);
			
			ImGui_DoTextFrameExt("InfoMapAux", cVector2f(0,0), 0, 0, textFrame, ImGui_NrmPosGroup(0.355,0.4649,5), ImGui_NrmSizeGroup(0.0977,0.1302) );
			ImGui_DoTextFrameExt("InfoMapStorage", cVector2f(0,0), 0, 0, textFrame, ImGui_NrmPosGroup(0.6966,0.8125,5), ImGui_NrmSizeGroup(0.0977,0.1302) );
		
		ImGui_GroupEnd();
	}
	
	//------------------------------------------------------------
	// InfoLaunchMech Variables
	//------------------------------------------------------------
	
	int mlSlideNumber = 0;	
	float mfSlideTime = 0.0f;
	
	//------------------------------------------------------------
	// InfoLaunchMech (Copied & modified from 01_04 terminal).
	//------------------------------------------------------------
	
	void InfoLaunchMech(float afTimeStep)
	{
		ImGui_SetTransCategory("05_01_phi_inside");
		
		if(mlSlideNumber == 0)
		{
			Map_AddTimer("TimerInfoLaunchMech", 0, "TimerInfoLaunchMech");
		}
		
		ImGui_SetAlignment(eImGuiAlign_TopLeft);
		
		if (mlSlideNumber!=0)
		{
			mfSlideTime+=afTimeStep;

			cImGuiGfx slide("spacegun_backdrop", eImGuiGfx_Texture);
			ImGui_DoImage(slide, cVector3f(0.0f,0.0f,1.0f), ImGui_NrmSize(cVector2f(1.0f,1.0f)) );

			cImGuiGfx logo("phi", eImGuiGfx_Texture);
			ImGui_DrawAlignedGfx(logo, cVector3f(50,60,3), eImGuiAlign_CenterCenter, ImGui_GetRatioCorrectSizeByWidth(logo, 215));
				
			cImGuiLabelData label = ImGui_GetDefaultLabel();
			label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
			label.mFont.mvSize = 20;
			ImGui_SetDefaultLabel(label);
		
			label.mFontAlign = eFontAlign_Center;
			ImGui_DoLabelExt("InfoSlide"+mlSlideNumber, label, ImGui_NrmPos(0.0,0.71,1.0f), ImGui_NrmSize(1.0f,0.3f), 1);
		
			label.mFontAlign = eFontAlign_Left;
			// Payload into shell
			if (mlSlideNumber==1)
			{
				float t=cMath_Clamp(mfSlideTime/3.75f, 0.0f, 1.0f);
				float fOffsX = cMath_Easing(eEasing_QuadOut, t, 550, 384);
				float fOffsY = cMath_Easing(eEasing_QuadOut, t, 150, 250);
				
				cImGuiGfx shell("spacegun_bullet_big", eImGuiGfx_Texture);
				ImGui_DrawAlignedGfx(shell, cVector3f(384,296,1.1), eImGuiAlign_CenterCenter, ImGui_GetRatioCorrectSizeByWidth(shell,90));
				label.mFontAlign = eFontAlign_Right;
				ImGui_DoLabelExt("InfoShell", label, cVector3f(150,195,4), cVector2f(150, -1));
				ImGui_DrawLine(cVector2f(300,220), cVector2f(370,230),3.0f,4.0f);
				
				cImGuiGfx ark("spacegun_payload", eImGuiGfx_Texture);
				ImGui_DrawAlignedGfx(ark, cVector3f(fOffsX,fOffsY,4), eImGuiAlign_CenterCenter, ImGui_GetRatioCorrectSizeByWidth(ark,50));
				label.mFontAlign = eFontAlign_Left;
				ImGui_DoLabelExt("InfoPayload", label, cVector3f(fOffsX+50,fOffsY-50,4));
				ImGui_DrawLine(cVector2f(fOffsX,fOffsY), cVector2f(fOffsX+45,fOffsY-30),3.0f,4.0f);
			}
			
			// Shell into gun
			else if (mlSlideNumber==2)
			{
				float tA=cMath_Clamp(mfSlideTime/4.0f, 0.0f, 1.0f);
				float tB=cMath_Clamp((mfSlideTime-4.0f)/4.0f, 0.0f, 1.0f);
				float fOffsX = cMath_Easing(eEasing_QuadOut, tA, 150, 270);
				float fOffsY = cMath_Easing(eEasing_QuadOut, tA, 300, 430);
				if (tB>0.0f)
				{
					fOffsX = cMath_Easing(eEasing_QuadIn, tB, 270, 660);
					fOffsY = cMath_Easing(eEasing_QuadIn, tB, 430, 25);
				}
			
				cImGuiGfx gun("spacegun_big", eImGuiGfx_Texture);
				ImGui_DrawAlignedGfx(gun, cVector3f(384,296,1.1), eImGuiAlign_CenterCenter, ImGui_GetRatioCorrectSizeByWidth(gun,600));
				
				cImGuiGfx shell("spacegun_bullet_small", eImGuiGfx_Texture);
				ImGui_SetModRotateAngle(43.5f);
				ImGui_DrawAlignedGfx(shell, cVector3f(fOffsX,fOffsY,3), eImGuiAlign_CenterCenter, ImGui_GetRatioCorrectSizeByWidth(shell,30));
				
				ImGui_ResetModifiers();
				
				label.mFontAlign = eFontAlign_Right;
				ImGui_DoLabelExt("InfoSpaceGun", label, cVector3f(200,200,4), cVector2f(200, -1));
				ImGui_DrawLine(cVector2f(300,220), cVector2f(400,270),3.0f,4.0f);
				label.mFontAlign = eFontAlign_Left;
			}
			
			// Launch
			else if (mlSlideNumber==3)
			{
				float t=cMath_Clamp(mfSlideTime/4.0f, 0.0f, 1.0f);
				float fOffsX = cMath_Easing(eEasing_Linear, t, 221, 576);
				float fOffsY = cMath_Easing(eEasing_Linear, t, 402, 25);
				
				cImGuiGfx gun("spacegun_small", eImGuiGfx_Texture);
				ImGui_DrawAlignedGfx(gun, cVector3f(384,296,1.1), eImGuiAlign_CenterCenter, ImGui_GetRatioCorrectSizeByWidth(gun,600));
				
				cImGuiGfx shell("spacegun_bullet_micro", eImGuiGfx_Texture);
				ImGui_DrawAlignedGfx(shell, cVector3f(fOffsX,fOffsY,3), eImGuiAlign_CenterCenter, ImGui_GetRatioCorrectSizeByWidth(shell,50));
				
				label.mFont.mvSize = 16;
				ImGui_DoLabelExt("InfoLaunchStation", label, cVector3f(260,440,4));
				ImGui_DrawLine(cVector2f(200,480), cVector2f(250,450),3.0f,3.0f);
				
				ImGui_DoLabelExt("InfoSurfaceStation", label, cVector3f(500,160,4));
				ImGui_DrawLine(cVector2f(550,120), cVector2f(575,160),3.0f,3.0f);
			}
			
			// Space
			else if (mlSlideNumber==4)
			{
				
				float t=cMath_Clamp(mfSlideTime/6.0f, 0.0f, 1.0f);
				float fGlobeX = cMath_Easing(eEasing_Linear, t,384, -200);
				float fShellX = cMath_Easing(eEasing_QuadOut, t,304, 384);
				float fShellY = cMath_Easing(eEasing_Linear, t,200, 300);
				
				float fRippleT = ImGui_FadeOscillateFloat("RippleSize",0.0f,1.0f,2.0f);
				float fRippleSize = cMath_Easing(eEasing_BounceInOut, fRippleT,200, 300);
				
				float fY = cMath_Easing(eEasing_Linear, t,296, 260);
				
				cImGuiGfx globe("trainmovie_globe", eImGuiGfx_Texture);
				ImGui_DrawAlignedGfx(globe, cVector3f(fGlobeX, 300, 2), eImGuiAlign_CenterCenter, ImGui_GetRatioCorrectSizeByWidth(globe, 450));
				
				if (t<0.8f)
				{
					ImGui_SetModRotateAngle(20.0f);
					cImGuiGfx shell("spacegun_bullet_space", eImGuiGfx_Texture);
					ImGui_DrawAlignedGfx(shell, cVector3f(fShellX,fShellY,4), eImGuiAlign_CenterCenter, ImGui_GetRatioCorrectSizeByWidth(shell,30));
					ImGui_ResetModifiers();
				}
				else
				{
					SlideshowAudioStart(true);
					cImGuiGfx sat("spacegun_satelite", eImGuiGfx_Texture);
					ImGui_DrawAlignedGfx(sat, cVector3f(fShellX,fShellY,5), eImGuiAlign_CenterCenter, ImGui_GetRatioCorrectSizeByWidth(sat,120));
					
					cImGuiGfx ripples("spacegun_ripples", eImGuiGfx_Texture);;
					ImGui_DrawAlignedGfx(ripples, cVector3f(fShellX,fShellY,3), eImGuiAlign_CenterCenter, ImGui_GetRatioCorrectSizeByWidth(ripples,fRippleSize));
	
					if (t>0.9f)
					{
						label.mFont.mvSize = 25;
						label.mFontAlign = eFontAlign_Center;
						ImGui_DoLabelExt("InfoDockComplete", label, cVector3f(0,480,4), ImGui_NrmSize(1, -1));
					}
				}
			}
		}
	}
	
	//------------------------------------------------------------
	
	void ShowSlide(int alSlide)
	{
		mlSlideNumber = alSlide;
		mfSlideTime = 0.0f;
		SlideshowAudioStart(false);
	}
	
	//------------------------------------------------------------
	
	void HideSlides()
	{
		mlSlideNumber = 0;
		mfSlideTime = 0.0f;
		
		/////Stop slideshow audio
		SlideshowAudioStop();
		
		Map_RemoveTimer("TimerInfoLaunchMech");
	}
	
	//------------------------------------------------------------
	
	void TimerInfoLaunchMech(const tString &in asTimer)
	{
		float fTimer;
		
		if(mlSlideNumber == 0)		{ ShowSlide(1); fTimer = 4.0f; }
		else if(mlSlideNumber == 1) { ShowSlide(2); fTimer = 8.0f; }
		else if(mlSlideNumber == 2) { ShowSlide(3); fTimer = 4.0f; }
		else if(mlSlideNumber == 3) { ShowSlide(4); fTimer = 6.0f; }
		
		if(fTimer == 0.0f) return;
		
		Map_AddTimer("TimerInfoLaunchMech", fTimer, "TimerInfoLaunchMech");
	}
	
