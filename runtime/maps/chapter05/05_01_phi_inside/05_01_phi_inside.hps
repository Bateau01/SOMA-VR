	//Space gun reveal
	bool Trigger_SpaceGunMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		Music_Play("04_03_spacegunreveal_short", 0.95f, false, eMusicPrio_BigEvent);
		return false;
	}
				
	//-------------------------------------------------------
	// Phi power music
	
	void PhiPowerMusic(const tString &in asTimer)
	{
		Music_Play("05_01_phi_power_on", 0.4f, false, eMusicPrio_BigEvent);
	}
			
	//-------------------------------------------------------
	// Cath corpse music
	
	bool mbCanTriggerCathCorpseMusic = false;
	bool mbCathCorpseMusicPlayed = false;
	bool Trigger_CathMusicLookAtEnable(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Entity_SetActive("TriggerLookAt_CathCorpseMusic", true);
			mbCanTriggerCathCorpseMusic = true;
		}
		else
		{
			Entity_SetActive("TriggerLookAt_CathCorpseMusic", false);
			mbCanTriggerCathCorpseMusic = false;
		}
		return true;
	}

	void CathCorpseMusic(const tString &in asEntity, int alState)
	{
		if (EyeTracking_IsEnvironmentReactive()) return;
		PlayCathCorpseMusic();
	}
	
	void PlayCathCorpseMusic()
	{
		if (mbCanTriggerCathCorpseMusic == false || mbCathCorpseMusicPlayed == true) return;
		mbCathCorpseMusicPlayed = true;
		Music_Play("05_01_chun_corpse", 0.8f, false, eMusicPrio_MinorEvent);
	}
	
	//-------------------------------------------------------
	// Cath Datamine music
	void CathDatamineMusic(const tString &in asTimer)
	{
		Music_Play("05_01_chun_blackbox", 1.0f, false, eMusicPrio_BigEvent);
		Map_AddTimer("CathDatamineMusic_FadeUp", 10.0f, "CathDatamineMusic_FadeUp");
		Sound_FadeGlobalVolume(0.7, 5.0f);
	}

	void CathDatamineMusic_FadeUp(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0, 7.0f);
	}
	
