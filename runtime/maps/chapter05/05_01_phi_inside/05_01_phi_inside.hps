    // S26DC: only the authored final-button window replaces the seated arms.
    bool mbVRLaunchButtonWindow=false;
    [nosave] int mlVRLaunchHandsPublished=-2;
    void VRLaunchHands(int state)
    {
        cScript_SetGlobalReturnBool(false);
        cScript_RunGlobalFunc("MenuHandler","cScrMenuHandler","HPL3VR_GetRuntimeActive");
        if(!cScript_GetGlobalReturnBool()) { mlVRLaunchHandsPublished=-2; return; }
        if(mlVRLaunchHandsPublished==state) return;
        cScript_SetGlobalArgInt(0,state);
        cScript_RunGlobalFunc("PlayerHandsHandler","","HPL3VR_SetSceneOverride");
        mlVRLaunchHandsPublished=state;
    }

	void Update(float afTimeStep)
	{
        // Recover the authored waiting window from saves made before S26DC.
        if(!mbVRLaunchButtonWindow && !mbARKLaunched && !mbControllingLoaderArm &&
           cLux_GetPlayer().GetCurrentStateId()==ePlayerState_InteractiveCameraAnimation &&
           !Map_GetEntity("LaunchButton").GetInteractionDisabled()) mbVRLaunchButtonWindow=true;
        VRLaunchHands(mbVRLaunchButtonWindow ? 0 : -1);
		if(mbControllingLoaderArm)
		{
			LoaderArm_Update(afTimeStep);
		}
		
		if (EyeTracking_IsEnvironmentReactive() && EyeTracking_IsEntityBeingLookedAt("Datamine_CathCorpse"))
		{
			PlayCathCorpseMusic();
		}		
	}
	
	void PostUpdate(float afTimeStep)
	{
		// If the player's damaged, maybe interrupt the dialogue.
		if (Player_WasDamaged())
		{
			cLux_AddDebugMessage("Banter interrupt PostUpdate()");
			Banter_DamageInterrupt();
		}
		
		if (mbControllingLoaderArm)
		{
			LoaderArm_PostUpdate(afTimeStep);
		}
	}
	
	
