		{
			if (alState==1)
			{
				CameraAnimation_Begin("SitAnimBackFromArmControl", "", false);
				TerminalLaunchInteract_OnPlayerInteract(asEntity);
			}
		}

		void TerminalLaunchInteract_OnPlayerInteract(const tString &in asEntity)
		{
			mbVRLaunchButtonWindow=false; VRLaunchHands(-1);
            cLux_AddDebugMessage("Launch button pressed");
			Sound_CreateAtEntity("LaunchButton", "05_01_phi_inside/SFX/spacegun_sequence/launch_button", "Player");
			Sound_PreloadGroup("Player/foley/default/hand_animation/long", true);
			
			//Micro delay for launch button sound to finish before the big one starts
			Map_AddTimer("LaunchSequenceMicroDelay", 1.5f, "LaunchSequenceBegin");
			
			Entity_SetInteractionDisabled("LaunchButton", true);
		}
				
		//-------------------------------------------------------------
		
		void LaunchSequenceBegin(const tString &in asTimer)
		{
			//Launch sequence sound (big one)
			Sound_CreateAtEntity("LaunchSequence", "05_01_phi_inside/SFX/spacegun_sequence/countdown_launch", "Player");
			Sound_FadeGlobalVolume(0.25f, 3.0f, eSoundEntryType_WorldAll);
			
			SequenceStates_Stop("Seq_PlayerNotPressingLaunch");
			if(Voice_SceneIsActive("CathAndSimon"))
				Voice_Stop("CathAndSimon");
			Dialog_Begin("");
				Dialog_AddBranch("");
					Dialog_AddSubject("4A_Cath_PlayerPressesLaunch");
			Dialog_End();
			
			Seq_Launch("");
			Seq_CathAndSimonUpload("");
		}
		
		//-------------------------------------------------------------
		
		void TimerLightUpSpaceGun(const tString &in asTimer)
		{
			int lLightIdx = cString_ToInt(asTimer, 1);
			
			tString sNextTimerIdx;
			sNextTimerIdx += lLightIdx+1;
			
			Lamp_SetLit("SpaceGunLamp_" + lLightIdx, true, true);
			if(Entity_Exists("SpaceGunLamp_" + sNextTimerIdx))
			{
				Map_AddTimer(sNextTimerIdx, 1.0f, "TimerLightUpSpaceGun");
			}
		}
		
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 4 Event B *Get transferred during launch countdown*
		//{///////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlid_Vignette = 0;
		int mlid_RadialBlur = 0;
		int mlid_ScanLines = 0;
		int mlid_scanDoF = -1;
		
		eTransferState mTransferState = eTransferState_Preparing;
		bool mbCathUploaded = false;
		bool mbSimonUploaded = false;
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceCathAndSimonUpload;
		void Seq_CathAndSimonUpload(const tString &in asX)
		{
			Sequence_Begin("Seq_CathAndSimonUpload", mSequenceCathAndSimonUpload);
			
			if(Sequence_DoStepAndWait(6.0f))
			{
			}
			else if(Sequence_DoStepAndPause())
			{
				FadeHelmetLightsOut();
				Prop_MoveLinearTo("pilot_seat_helmet", "pilot_seat_helmet_target_down", 1, 1.5, 1, true, "InitScan_VisorDown");
			}
			else if(Sequence_DoStepAndWait(4.5f))
			{
				Seq_Scan("");
			}
			else if (Sequence_DoStepAndWait(4.0f))
			{
				cLux_AddDebugMessage("Starting transfer");
				mTransferState = eTransferState_Transferring;
				
				Terminal_FadeImGuiStateFloat("TerminalLaunch_Screen2", "Progress", 0.1f, 3.0f, eEasing_ExpoOut);
			}
			else if(Sequence_DoStepAndWait(7.0f))
			{
				cLux_AddDebugMessage("Transfer step 1");
				Terminal_FadeImGuiStateFloat("TerminalLaunch_Screen2", "Progress", 0.3f, 6.0f*mfLaunchCountdownSecondLength);
			}
			else if(Sequence_DoStepAndWait(6.0f*mfLaunchCountdownSecondLength))
			{
				cLux_AddDebugMessage("Transfer step 2");
				Terminal_FadeImGuiStateFloat("TerminalLaunch_Screen2", "Progress", 0.5f, 6.0f*mfLaunchCountdownSecondLength);
			}
			else if(Sequence_DoStepAndWait(4.0f))
			{
				cLux_AddDebugMessage("Cath Uploaded!!!");
				
				Terminal_FadeImGuiStateFloat("TerminalLaunch_Screen2", "Progress", 0.6f, 4.0f*mfLaunchCountdownSecondLength);
			}
			else if(Sequence_DoStepAndWait(3.0f))
			{
				cLux_AddDebugMessage("Transfer step 4");
				Terminal_FadeImGuiStateFloat("TerminalLaunch_Screen2", "Progress", 0.7f, 7.0f*mfLaunchCountdownSecondLength);
			}
			else if (Sequence_DoStepAndPause(4.0f))
			{
				// "Come on!"
				Dialog_Begin("");
					Dialog_AddBranch("");
						Dialog_AddSubject("4B_Cath_CathIsUploaded", "CathAndSimonUpload_DoneTalking");
				Dialog_End("");
			}
			else if(Sequence_DoStepAndPause())
			{
				Terminal_FadeImGuiStateFloat("TerminalLaunch_Screen2", "Progress", 0.8f, 1.0f, eEasing_Linear);
				Dialog_Begin("");
					Dialog_AddBranch("");
						Dialog_AddSubject("4B_Cath_LaunchPlayerStressed", "CathAndSimonUpload_DoneTalking");
				Dialog_End("");
			}
			else if(Sequence_DoStepAndPause())
			{
				cLux_AddDebugMessage("Transfer step 5");
				Terminal_FadeImGuiStateFloat("TerminalLaunch_Screen2", "Progress", 1.0f, 0.5f, eEasing_Linear);
			}
			else if(Sequence_DoStepAndWait(2.0f))
			{
				cLux_AddDebugMessage("Simon Uploaded!!!");
				
				Dialog_Begin("");
					Dialog_AddBranch("");
						Dialog_AddSubject("4B_Cath_SimonIsUploaded");
				Dialog_End("");
				
				SequenceStates_Resume("Seq_Scan");
			}
						
			Sequence_End();
		}
		
		void CathAndSimonUpload_ResumeUpload()
		{
			SequenceStates_Resume("Seq_CathAndSimonUpload");
		}
		
		void InitScan_VisorDown(const tString& in asPropName)
		{
			CathAndSimonUpload_ResumeUpload();
		}
		
		void CathAndSimonUpload_LineCallback(const tString &in asScene, const tString &in asSubject, int alLineIndex, bool abStartOfLine)
		{
			if(abStartOfLine)
			{
				cLux_AddDebugMessage("Linecallback: Upload resume");
				CathAndSimonUpload_ResumeUpload();
			}
		}
		
		void CathAndSimonUpload_DoneTalking(const tString &in asSubject, bool abStartOfSubject)
		{
			if(abStartOfSubject) return;
			
			cLux_AddDebugMessage("Donetalking: Upload resume");
			CathAndSimonUpload_ResumeUpload();
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceScan;
		void Seq_Scan(const tString &in asName)
		{
			Sequence_Begin("Seq_Scan", mSequenceScan);
			
			///////////////////////////
			// Initial Delay
			if (Sequence_DoStepAndWait(1.0f))
			{
				cLux_AddDebugMessage("Scan scan scan");
				//TerminalLaunchSetState(eTerminalLaunchState_Scanning);

				Effect_Fade_Out(1.0f);
			}
			else if(Sequence_DoStepAndWait(1.0f))
			{
				CameraAnimation_End();
				CameraAnimation_Begin("CamAnimScan", "", false);
				
				Effect_ChromaticAberration_StartAnim(4.0f,0.005,0.005,cVector2f_Zero);
				
				Effect_ImageTrail_Start(0.08,0.1,4.0,1.0);
				
				//////////////////////////////////////
				// Startup the machine..
				Sound_CreateAtEntity("sound_goggle_buildup", "Entities_Urban/tech/goggle/goggle_buildup", "Player", 0, true);
			}
			else if (Sequence_DoStepAndWait(1.5f))
			{
				// Scan effects
				Player_FadeFOVMulTo(0.9f, 0.3f);		
				
				/////////////////////////////////////////////
				// Add Vignette
				mlid_Vignette = Effect_Screen_Start("vignette_screen.mat", cVector2f(0.5,0.5), cVector2f(1.4,1.0f), 1.0, 1.0, 900.0, 0.1);
				
				////////////////////////////////////////////
				// The following effect is used in darkness - but it is to "warm up" the video distortion so that it works on the fade in (in sync)
				Effect_VideoDistortion_Start(1.0f,1.0f,2.0f,0.1f,0.0f);
				
				//////////////////////////////////////
				// Blur and mouse control effects
				mlid_scanDoF=Effect_DoF_Start(3.0,10.0,0.3,50.0);
				mlid_RadialBlur = Effect_RadialBlur_Start(0.1,0.25,0.25,0.1);
				Player_SetLookSpeedMul(0.6);
			}
			else if (Sequence_DoStepAndWait(4.0f))
			{
				Entity_SetActive("pilot_seat_helmet", false);
				Effect_Fade_In(0.0f);
				FadeHelmetLightsIn(0.0f);
				
				//////////////////////////////////////
				// Distortion on fade in
				Effect_VideoDistortion_Start(1.0f,0.25f,0.1f,0.1f,0.0f);
			}
			else if(Sequence_DoStepAndPause(0.0f))
			{
				//////////////////////////////////////
				// Display scanning effect
				mlid_ScanLines = Effect_Screen_Start("00_04_scan_noise.mat", cVector2f(0.5, 0.5), cVector2f(2,1),  1, 0.1, 900, 0.1);
			}
			else if (Sequence_DoStepAndWait(7.75f))
			{
				Effect_Flash_Start(0.5f, 0.75f, 0.25);
				Effect_Shake_Start(0.08,0.65,0,0.1);
				Effect_Rumble_Start(0.9, 0.7, 0.25f);
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				//////////////////////
				// Turn off Distortion effects
				Effect_Screen_FadeOut(mlid_Vignette,2.5);
				Effect_Screen_FadeOut(mlid_ScanLines,2.5);
				
			}
			
			//////////////////////////////////
			// Fade to black and restore FOV
			if(Sequence_DoStepAndWait(0.25f))
			{
				Music_Stop(0.75, eMusicPrio_BgAmb);
				Player_FadeFOVMulTo(1.0f, 0.3f);
				Effect_DoF_FadeOut(mlid_scanDoF,0.3f);
			}
			
			if(Sequence_DoStepAndWait(0.0f))
			{
				cLux_AddDebugMessage("Helmet back on");
				Effect_RadialBlur_FadeOut(mlid_RadialBlur,1.0f);
				Entity_SetActive("pilot_seat_helmet", true);
				FadeHelmetLightsIn(0.0f);
				Player_FadeFOVMulTo(1.0f, 0.3f);	
				
				Seq_WakeUpAfterScan("");
			}

			Sequence_End();
		}
		
		//-------------------------------------------------------
				
		//}End Scene 4 Event C
		
		//-------------------------------------------------------
		
	//}End Scene 4
	
	//-------------------------------------------------------
	
	//-------------------------------------------------------
	
	//-------------------------------------------------------

	/////////////////////////////////////////
	// ==============
	// Scene 5 *ARK Launches, Simon Remains*
	// ==============
	//{///////////////////////////////////////

	//-------------------------------------------------------
	
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 5 Event A *Launch*
		//{///////////////////////////////////////
		
		//-------------------------------------------------------
			
		int mlBubbleShake=-1;
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceLaunch;
		void Seq_Launch(const tString &in asName)
		{
			Sequence_Begin("Seq_Launch", mSequenceLaunch);
			
			if(Sequence_DoStepAndWait(0.0f))
			{
				SetUpLaunchCountdown(30,1.75f);
				TurnOnDomeLamps();
			}
			else if(Sequence_DoStepAndWait(0.5f))
			{
				Entity_SetEffectsActive("TerminalLaunch_Button", false, true);
				Entity_SetActive("space_gun_buildup_bolts_*", true);
				Terminal_SetGuiActive("TerminalLaunch_Button", false, 0.1f);
			}
			else if(Sequence_DoStepAndPause())
			{
				StartLaunchCountdown();
			}
			else if(Sequence_DoStepAndPause())
			{
				Seq_LaunchEffects();
			}
			else if(Sequence_DoStepAndWait(0.0f))
			{
				mbARKLaunched = true;
				//Terminal_SetGuiActive("TerminalLaunch_Screen1",false);
			}
			
			Sequence_End();
		}
		
		int mlLaunchCountdown = 0;
		float mfLaunchCountdownSecondLength;
		void SetUpLaunchCountdown(int alSeconds, float afSecondLength=1.0f)
		{
			mlLaunchCountdown = alSeconds-1;
			mfLaunchCountdownSecondLength = afSecondLength;
			Map_AddTimer("LaunchCountdown", mfLaunchCountdownSecondLength, "Timer_LaunchCountdown");
			Map_SetTimerPaused("LaunchCountdown", true);
		}
		
		void TurnOnDomeLamps()
		{
		    Lamp_SetLit("dome_intersection_lamp_*", true, true);
		}
		
		void StartLaunchCountdown()
		{
			Map_SetTimerPaused("LaunchCountdown", false);
			Dialog_Begin("");
				Dialog_AddBranch("");
					Dialog_AddSubject("4B_Computer_CountdownVoice");
					Dialog_AddSubject("4B_Cath_LaunchReactionToSecond_30");
			Dialog_End();
		}
				
		void Timer_LaunchCountdown(const tString &in asTimer)
		{
			//cLux_AddDebugMessage("Countdown: " + mlLaunchCountdown + " seconds");
			
			bool bPlayVoice = 
				mlLaunchCountdown==20 ||
				mlLaunchCountdown<=10;

			if(bPlayVoice)
			{
				tString sFollowingSubject = "4B_Cath_LaunchReactionToSecond_" + mlLaunchCountdown;
				
				tString sDebugMsg = "Playing computer voice at " + mlLaunchCountdown + " seconds";

				Dialog_Begin("");
					Dialog_AddBranch("");
						Dialog_AddSubject("4B_Computer_CountdownVoice");
						if(Voice_SubjectExists(sFollowingSubject))
						{
							Dialog_AddSubject(sFollowingSubject);
							sDebugMsg += " (and " + sFollowingSubject + ")";
						}
				Dialog_End();
				
				cLux_AddDebugMessage(sDebugMsg);
			}					

			if(mlLaunchCountdown==25)
			{
				Lamp_SetLit("gun_prepare_warning_lamp_*", true, true);
			}
			
			if (mlLaunchCountdown==19)
			{
				mlBubbleShake = Effect_Shake_Start(0.01f,100.0f,1.0f,1.0f);
			}
			
			if (mlLaunchCountdown==18)
			{
				for(int i=1; i<=5; ++i)
					ParticleSystem_CreateAtEntity("GunBubbles_"+i, "loop_waterbubbles_plateaustation_huge_stream.ps", "Area_Bubbles_" + i, false);
			}
			
			if(mlLaunchCountdown==10)
			{
				Entity_PlayAnimation("SpaceGun", "prepare_fire");
			}
			
			if(mlLaunchCountdown==0)
			{
				SequenceStates_Resume("Seq_Launch");
				Lamp_SetLit("gun_prepare_warning_lamp_*", false, false);
			}
			else 
			{
				--mlLaunchCountdown;
				Map_RestartCurrentTimer();
			}
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqLaunchEffects;
		void Seq_LaunchEffects(const tString& in asName="")
		{
			Sequence_Begin("Seq_LaunchEffects", mSeqLaunchEffects);
			
			if (Sequence_DoStepAndWait(0.5f))
			{
			}
			if (Sequence_DoStepAndWait(0.1f))
			{
				Entity_PlayAnimation("SpaceGun", "fire");
				
				Effect_Shake_Start(0.2, 0.1, 0.0, 0.1,cVector3f(-1,-1,-0.5f));
				ParticleSystem_SetActive("space_gun_launch_*", true);
				Entity_SetActive("shell_fired", true);
				Prop_MoveLinearTo("shell_fired", "shell_fired_target", 80, 80, 80, true);				
				
				Lamp_SetLit("SpaceGunLamp_*", false,true);
				
				Effect_Rumble_Start(3.5, 1.5, 0.1, 0.7);
				
				for(int i=1; i<=6; ++i)
				{
					ParticleSystem_CreateAtEntity("", "oneshot_waterbubbles_explosion_vert.ps", "Area_SpaceGunFireParticles_" + i, false);
					ParticleSystem_CreateAtEntity("", "oneshot_waterbubbles_huge.ps", "Area_SpaceGunFireParticles_" + i, false);				
				}
				Effect_ToneMapping_FadeGrading("grading_05_01",3.0f);
			}
			else if (Sequence_DoStepAndWait(1.0f))
			{
				Effect_Shake_Start(0.05, 0.0f, 0.0, 5.0f,cVector3f(-1,-1,-0.5f));
			}
			else if (Sequence_DoStepAndWait(1.0f))
			{
				Entity_SetActive("space_gun_buildup_bolts_*", false);
			}
			else if (Sequence_DoStepAndWait(1.0f))
			{
				Effect_Shake_FadeOut(mlBubbleShake,5.0f);

				for(int i=1; i<=3; ++i)
					ParticleSystem_CreateAtEntity("", "oneshot_waterbubbles_explosion_vert.ps", "Area_BattExplosion_" + i, false);
					
				for(int i=1; i<=5; ++i)
					ParticleSystem_Destroy("GunBubbles_"+i);
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				SequenceStates_Resume("Seq_Launch");
			}
			
			Sequence_End();
		}
		
		//}End Scene 5 Event A
		
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 5 Event B *See launch*
		//{///////////////////////////////////////
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceWakeUpAfterScan;
		void Seq_WakeUpAfterScan(const tString &in asName)
		{
			Sequence_Begin("Seq_WakeUpAfterScan", mSequenceWakeUpAfterScan);
			
			if (Sequence_DoStepAndWait(0.25f))
			{				
			    cLux_AddDebugMessage("======================CONVERSATION STARTS HERE=====================");
				cLux_AddDebugMessage("AFTER SCAN");
				Effect_ToneMapping_FadeGrading("grading_05_01_overexposed.dds",0.25f);
				Effect_Fade_In(0.25f);
				Sound_FadeGlobalVolume(0.65f, 8.0f, eSoundEntryType_WorldAll);
				Sound_PreloadGroup("05_01_phi_inside/SFX", true);
                Sound_PreloadGroup("Player/foley/default/hand_animation/long", true);
			}
			else if (Sequence_DoStepAndWait(0.75f))
			{
				if (mbArmGone)
				{
					Entity_PlayAnimation("FinalHandsMutilated", "event_talk_to_cath_5_1",0.0f,true,false,"");
					Entity_SetAnimationPaused("FinalHandsMutilated", "event_talk_to_cath_5_1", false);
				}
				else
				{
					Entity_PlayAnimation("FinalHandsNormal", "event_talk_to_cath_5_1",0.0f,true,false,"");
					Entity_SetAnimationPaused("FinalHandsNormal", "event_talk_to_cath_5_1", false);
				}
			}
			else if(Sequence_DoStepAndWait(3.0f))
			{
				FadeHelmetLightsOut();
				Prop_MoveLinearTo("pilot_seat_helmet", "pilot_seat_helmet_target_up", 1, 1.5, 1, true);

				Player_SetLookSpeedMul(0.6f);
				Seq_TurnOffLights("");
			}
			else if(Sequence_DoStepAndPause(3.0f))
			{
				Dialog_Begin();
					Dialog_AddBranch("");
						Dialog_AddSubject("5C_Cath_TalkAfterWakeUp", "");
				Dialog_End();
				
			}
			else if(Sequence_DoStepAndPause(1.0f))
			{
				Dialog_Begin();
					Dialog_AddBranch("");
						Dialog_AddPause(0.75f);
						Dialog_AddSubject("5C_Cath_SimonIsLeftAlone", "SimonIsLeftAlone_OnDoneTalking");
				Dialog_End();
			}

			Sequence_End();
		}
		
		void Line_Return_Catherine(const tString &in asParent, const tString &in asChild, int alState, bool abStart)
		{
			if (abStart)
			{
				Map_AddTimer("TimerCathReturn",0.5f,"TimerCathReturn");
			}
		}
		
		void TimerCathReturn(const tString& in asName)
		{
			mTransferState = eTransferState_CathReturned;
		}
		
		bool mbCathDead = false;
			
		void LineOver_Lights_Catherine(const tString &in asParent, const tString &in asChild, int alState, bool abStart)
		{
			if (!abStart)
				return;
			SequenceStates_Resume("Seq_TurnOffLights");
		}
				
		void LineOver_Final_Catherine(const tString &in asParent, const tString &in asChild, int alState, bool abStart)
		{
			if (abStart)
			{
				Sound_CreateAtEntity("CathLineSFX", "05_01_phi_inside/SFX/cathandsimon_5c_cath_talkafterwakeup_015_catherine_001_line_break", "Player");
				
				Map_AddTimer("TimerPopLastTerminal", 1.0f, "TimerPopLastTerminal");
				return;
			}
			
			mbCathDead = true;
			ParticleSystem_CreateAtEntity("", "elec_spark_physics_oneshot.ps", "TerminalLaunch_Screen2", false);
			Entity_SetEffectsActive("TerminalLaunch_*",false,false);
			
			Entity_SetActive("TerminalLaunch_Screen2", false);
			Entity_SetActive("CathTerminalBroken",true);
			Entity_SetEffectsActive("CathTerminalBroken",false,false);
			
			Lamp_SetLit("launch_lamp_*",false,false);
			// Need a bit of light to see terminals
			Light_SetVisible("PointLight_124",true);
			Light_SetVisible("PointLight_123",true);
			SequenceStates_Resume("Seq_TurnOffLights");
			
			SequenceStates_Resume("Seq_WakeUpAfterScan");
		}

		void TimerPopLastTerminal(const tString& in asName)
		{
			OverloadTerminalScreen("TerminalLaunch_Screen1");
			Light_SetVisible("PointLight_124",false);
		}

		void TalkAfterWakeUp_OnDoneTalking(const tString &in asSubject, bool abStartOfSubject)
		{
			if(abStartOfSubject) return;
			
			cLux_AddDebugMessage("OnDoneTalking");
			SequenceStates_Resume("Seq_WakeUpAfterScan");
		}
		
		void SimonIsLeftAlone_OnDoneTalking(const tString &in asSubject, bool abStartOfSubject)
		{
			if(!abStartOfSubject) return;
			
			Seq_TheEnd("");
		}
						
		//}End Scene 5 Event B
		
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 5 Event C *Batteries overload and stuff starts breaking apart*
		//{///////////////////////////////////////
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceTurnOffLights;
		void Seq_TurnOffLights(const tString &in asX)
		{
			Sequence_Begin("Seq_TurnOffLights", mSequenceTurnOffLights);
			
			if(Sequence_DoStepAndWait(2.0f))
			{
				OverloadOutsideLight("LampOutsideEnd_*");
			}
			else if(Sequence_DoStepAndWait(1.0f))
			{
				OverloadOutsideLight("LampOutside_*");
			}
			else if (Sequence_DoStepAndWait(3.0f))
			{
				cLux_AddDebugMessage("Turn off scan chair lights.");
			    TurnOffScanChairLights();
			}
			else if(Sequence_DoStepAndWait(0.5f))
			{
				OverloadOutsideLight("LampOutsideRed_*");
			}
			else if(Sequence_DoStepAndWait(4.0f))
			{
			    TurnOffGunLights();
			}
		    else if(Sequence_DoStepAndPause(0.0f))
			{
				Map_FadeFogColor(cColor(0),8.0f);
				Map_FadeFogEnd(60.0f,15.0f);
				Map_AddTimer("TimerTurnOffRedLamps",0.1f,"TimerTurnOffRedLamps");
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Map_FadeFogEnd(20.0f,5.0f);

				// Turn off red perimeter glows
				Light_SetVisible("PointLight_164",false);
				Light_SetVisible("PointLight_165",false);
				Light_SetVisible("PointLight_166",false);
				Light_SetVisible("PointLight_167",false);
				Light_SetVisible("PointLight_169",false);
				Light_SetVisible("PointLight_170",false);
			}		
			else if (Sequence_DoStepAndWait(0.0f))
			{
				// Turn off remaining ambient lights
				cLux_AddDebugMessage("Point lights out.");
				Light_SetVisible("PointLight_20",true);
				Light_SetVisible("PointLight_21",false);
				Light_SetVisible("PointLight_22",false);
				Light_SetVisible("PointLight_23",false);
				Light_SetVisible("PointLight_24",false);
				Light_SetVisible("PointLight_5",false);
				Light_SetVisible("PointLight_2",false);
				Light_SetVisible("BoxLight_1",false);
				
				// Generators
				Entity_SetEffectsActive("build_machine_flesher_*",false,false);
				
				// Loader
				Lamp_SetLit("ClawBar_lamp_*",false,false);
				
				// Lamps on shell rail
				Lamp_SetLit("ShellRailLamp_*",false,false);
				Light_SetVisible("PointLight_187",false);
				Light_SetVisible("PointLight_188",false);
				Light_SetVisible("SpotLight_74",false);
				
				// Scan chair
				Terminal_SetGuiActive("cath_terminal_scanchair",false);
				Entity_SetEffectsActive("cath_terminal_scanchair",false,false);
				Lamp_SetLit("pilot_seat_lamp_*",false,false);
			}
			
			Sequence_End();
		}
		
		int mlRedLight=1;
		
		void TimerTurnOffRedLamps(const tString& in asName)
		{
			tString sName;
			
			for (int i=0;i<5;++i)
			{
				sName="dome_intersection_lamp_"+mlRedLight;
				mlRedLight++;
				if (!Entity_Exists(sName))
				{
					cLux_AddDebugMessage("Entity doesn't exist:"+sName);
					return;
				}
				Entity_FadeEffectBaseColor(sName,cColor(2,1.5,1.5),0.1f);
				Map_AddTimer(sName, 0.25f, "TimerKillRedLamp");
			}
			
			if(mlRedLight <= 6)
			{
				Sound_CreateAtEntity("LightsShutdown", "05_01_phi_inside/SFX/spacegun_sequence/shutdown_lights", "Player");
			}
			
			sName="dome_intersection_lamp_"+mlRedLight;
			if (!Entity_Exists(sName))
			{
				cLux_AddDebugMessage("Entity doesn't exist:"+sName);
				return;
			}
			cLux_AddDebugMessage("Restarting timer");
			Map_RestartCurrentTimer(7.7f);
		}
		
		void TimerKillRedLamp(const tString& in asName)
		{
			Lamp_SetLit(asName,false,false);
			ParticleSystem_CreateAtEntity("", "elec_spark_physics_oneshot.ps", asName, false);
			ParticleSystem_CreateAtEntity("", "oneshot_waterbubbles_explosion_vert.ps", asName, false);
		}
		
		void OverloadOutsideLight(const tString &in asName)
		{
			array<iLuxEntity@> vEntities;
			cLux_GetCurrentMap().GetEntityArray(asName, eLuxEntityType_Prop, "", vEntities);
			if(vEntities.length() == 0)
			{
				Error("Could not find any props with name '"+asName+"' for OverloadOutsideLight");
				return;
			}
	
			for (int i=0;i<vEntities.length();i++)
			{
				iLuxEntity @pEntity = vEntities[i];
				SetOutsideLightEnabled(pEntity.GetName(), false, false);
				ParticleSystem_CreateAtEntity("", "elec_spark_physics_oneshot.ps", pEntity.GetName(), false);
				ParticleSystem_CreateAtEntity("", "oneshot_waterbubbles_explosion_vert.ps", pEntity.GetName(), false);
			}
			Effect_Shake_Start(cMath_RandRectf(0.001f,0.01f), cMath_RandRectf(0.1f,0.2f), 0.0f, 0.1f);
		}
		
		void OverloadTerminalScreen(const tString &in asName)
		{
			cLux_AddDebugMessage("Killing terminal:"+asName);
			ParticleSystem_CreateAtEntity("", "elec_spark_physics_oneshot.ps", asName, false);
			Entity_SetEffectsActive(asName, false, false);
			Terminal_SetGuiActive(asName, false);
		}
		
		cSequenceStatesData mSequenceSpaceGunCollapse;
		void Seq_SpaceGunCollapse(const tString &in asName)
		{
			Sequence_Begin("Seq_SpaceGunCollapse", mSequenceSpaceGunCollapse);
			
			Sequence_End();
		}
		//}End Scene 5 Event C
		
