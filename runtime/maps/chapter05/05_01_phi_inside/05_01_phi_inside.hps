	//-------------------------------------------------------

	////////////////////////////
	// Set up map environment
	void Setup()
	{
		GetBase().SetDisplayNameEntry("05-01-phi-inside");
		RichPresence_SetCurrent(eRichPresence_SitePhi );
		
		///////////////////////////////
		// Setup presets
		{
			// When outside and underwater
			Map_Preset_SetupFog("Outside", true, 0, 100, 1, cColor(3 / 255.0, 7 / 255.0, 5 / 255.0,1), 0.025, true, true);
			Map_Preset_SetupSecondaryFog("Outside", true, 0, 10, 1, cColor(4 / 255.0, 8.5f / 255.0, 6.5f / 255.0,1));
			Map_Preset_SetupDepthOfField("Outside", true, 0.05, 12.0, 0.1);
			Map_Preset_SetupBloom("Outside", 160, 0.00001, 0.5, cColor(0.3, 0.3, 0.3, 1.0));

			// Inside and not underwater
			Map_Preset_SetupFog("Inside", true, 2, 80, 0.9, cColor(0.105f,0.115,0.15f,0.6f), 1.0, false, false);
			Map_Preset_SetupSecondaryFog("Inside", true, 0, 10, 1, cColor(0.105f,0.115,0.15f,0.1f));
			Map_Preset_SetupDepthOfField("Inside", false);
			Map_Preset_SetupBloom("Inside", 128, 0.75, 0.5, cColor(1.0, 1.0));

			// Liquid area
			Map_Preset_SetupFog("LiquidArea", false); //the luquid area has its own fog
			Map_Preset_SetupDepthOfField("LiquidArea", true, 0.05, 12.0, 0.1);
			Map_Preset_SetupBloom("LiquidArea", 160, 0.00001, 0.5, cColor(0.3, 0.3, 0.3, 1.0));
		}

		cTerrain@ pTerrain = cLux_GetCurrentMap().GetWorld().GetTerrain();
		if(pTerrain !is null) pTerrain.SetCheapMaterial("sand_flat.mat", 0.5f);
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		 // Setup lights
		Lamp_SetLit("LampUpperFloorDoor_*", false, false);
		Lamp_SetLit("LampControlRoom_*", false, false);
		Lamp_SetLit("dome_intersection_lamp_*", false, false);
		Lamp_SetLit("gun_prepare_warning_lamp_*", false, false);
		Lamp_SetLit("airlock_2_flood_lamp_*", false, false);
		Lamp_SetLit("lamp_lower_special_lowpower_*", false, false);
		Entity_FadeEffectBaseColor("lamp_sat_prep_low_power_*", cColor(1, 0, 0, 1), 1);
		Entity_FadeEffectBaseColor("lamp_sat_prep_power_indicator_*", cColor(1, 0, 0, 1), 1);
		Entity_FadeEffectBaseColor("sign_lamp_*", cColor(1, 0, 0, 1), 1);
		Lamp_SetFlickerActive("PowerLamp_SatFrame", true);
		Lamp_SetFlickerActive("PowerLamp_Airlock", true);
		
		Lamp_SetLit("airlock_1_flood_lamp_*", false, false);
		Lamp_SetLit("airlock_1_lamp_*", true, false);
		
		Lamp_SetLit("LampUpperFloorDoor_5",false,false);
		Lamp_SetLit("LampUpperFloorDoor_6",false,false);
		Lamp_SetLit("LampControlRoom_1_17",false,false);
		Lamp_SetLit("LampControlRoom_1_16", false, false);
		MovingButton_SetLocked("DoorCorridor_2_Panel_1",true);
		
		// Setup particles
		ParticleSystem_SetActive("airlock_2_fill_bubbles_oneshot", false);
		ParticleSystem_SetActive("airlock_2_flood_effects_*", false); 
		ParticleSystem_SetActive("airlock_2_fill_effects_*", false); 
		ParticleSystem_SetActive("airlock_2_jet_effects_*", false); 
		ParticleSystem_SetActive("airlock_2_drain_bubbles_oneshot", false);
		ParticleSystem_SetActive("airlock_2_drain_effects_*", false); 
		
		// Setup loading crane
		TurnOffLoadingCrane();
		
		// Setup gun effects
		ParticleSystem_SetActive("space_gun_launch_*", false);
		
		Entity_StopAnimation("swingdoor_tau_large_*");
		Entity_StopAnimation("CargoAirlockDoor");
		Entity_StopAnimation("airlock_warning_lamp_*");
		Lamp_SetLit("airlock_warning_lamp_*", false, false);
				
		MovingButton_SetSwitchedOn("DoorAirlockEntrance_Inner_Panel", false, true);
		MovingButton_SetSwitchedOn("DoorAirlockSpaceGun_Inner_Panel", false, true);
		MovingButton_SetSwitchedOn("DoorAirlockSpaceGun_Outer_Panel", false, true);
		
		Light_SetVisible("PointLight_124",false);
		Light_SetVisible("PointLight_123",false);
		
		mbArkOK = cScript_GetGlobalVarBool("ARKDamaged")==false;
		mbArmGone = cScript_GetGlobalVarBool("PlayerLostHand");
		
		if (mbArmGone)
			Player_SetLadderMoveMul(0.6f);
		
		SetupDoors();
		
		IrradianceSet_FadeInSingleProbe("Probe_UpperFloor_*", "entry_area_red", 0.0f);
		IrradianceSet_FadeInSingleProbe("Probe_LowerFloor_*", "entry_area", 0.0f);
		
		Entity_SetVarString("AirlockEntranceControlScreen", "State", "Idle");
		Terminal_SetImGuiStateFloat("AirlockEntranceControlScreen", "PressureMul", 1.0f);
		
		Entity_SetVarString("AirlockSpaceGunControlScreen", "State", "Idle");
		Terminal_SetImGuiStateFloat("AirlockSpaceGunControlScreen", "PressureMul", 0.0f);
							
		SetPlayerIsUnderwater(false, 0, false);
		Collide_WaterSurfacePhiEntrance(-1);
		
		// Assembly room setup
		
		// Space gun area setup
		Entity_SetEffectsActive("TerminalLaunch*", false, false);
		Entity_PlayAnimation("SpaceGun", "idle", 0.0f, true, false);
		
		SetUpLoaderArm();
		
		// Set up Leviathan
		for(int i=1; i<=32; ++i)
			Pathfinder_Track_Add("Leviathan", "PathNodeArea_" + i);
		Pathfinder_Track_Start("Leviathan", true);
		
		SetupSatFrame();
		
		Player_SetMoveSpeedMul(1.0f);
		
		if (mbArmGone)
		{
			PlayerHands_SetHandModel_DeepSeaMutilated();
		}
		else
		{
			PlayerHands_SetHandModel_DeepSea();
		}
		
		PlayerEnergy_SetFlowerSwallows(true);
		
		Tool_PickUp("CathBoxTool", false, false);
		
		Seq_AirlockEntranceDrain("");
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			//Add any debug stuff here
			
			cLux_SetDebugInfoWindowText("Text that should show up when pressing F1");
			
			Entity_CallEntityInteract("powerpack_1");
			Map_SetUnderwater(false);
		}
		
		Credits_Stop(0.0f);
		
		// Part open door
		
		Entity_PlayAnimation("DoorCorridor_1","door_open");
		Entity_SetAnimationRelativeTimePosition("DoorCorridor_1", "door_open", 0.7f);
		Entity_SetAnimationPaused("DoorCorridor_1","door_open",true);
		
		Sound_PreloadProject("05_01_phi_inside");
		Sound_PreloadGroup("Flashback/Level/05_01", true);
		Sound_PreloadGroup("Entities_Station/doors/tau", true);
		
		CathTool_ResetScreen(eCathToolVariant_CathAbyss);
		
		LastOnSoma_SetText("05_01_phi_inside_1");
		
		Entity_AttachToEntity("TerminalLaunchInteract","pilot_seat", "", true);
		
		/////////////////////////
		// Eye tracking
		EyeTracking_RegisterEntity("Datamine_CathCorpse", true, false, true, 15.0f, 3.0f);
	}
	
	void SetEmergencyLamp(const tString &in asName, bool abX)
	{
		cLux_AddDebugMessage("Setting " + asName + " to emergency");
		Entity_FadeEffectBaseColor(asName, cColor(0,0,0,1), 0.8f);
		Light_FadeTo(asName, cColor(0,0,0,1), -1, 1.0f);
		
		if(abX)
			Map_AddTimer(asName, 1.0f, "Timer_FadeEmergencyLamp");
		else
			Map_AddTimer(asName, 1.0f, "Timer_FadeNormalLamp");
	}
	
	void Timer_FadeEmergencyLamp(const tString &in asTimer)
	{
		Entity_FadeEffectBaseColor(asTimer, cColor(0.3,0,0,1), 3.0f);
		Light_FadeTo(asTimer, cColor(0.3,0,0,1), -1, 3.0f);
	}
	void Timer_FadeNormalLamp(const tString &in asTimer)
	{
		Entity_FadeEffectBaseColor(asTimer, cColor(1,1), 3.0f);
		Light_FadeTo(asTimer, cColor(0.997,1,0.648,1), -1, 3.0f);
	}

