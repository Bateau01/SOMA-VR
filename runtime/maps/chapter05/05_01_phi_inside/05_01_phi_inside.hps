		/////////////////////////////////////////////////
		
		bool mbLoaderArmWasMovingX = false;
		bool mbLoaderArmWasMovingZ = false;
		
		void LoaderArm_UpdatePosition(float afTimeStep)
		{
			if (mArmState==eLoaderArmState_AutoMove)
			{	
				mvLoaderArmPickPos = mvLoaderArmTarget;
			}
			else
			{
				cCamera@ pCam=cLux_GetPlayer().GetCamera();
				cVector3f vIntersection;
				float fDist=-1.0f;
				if (cMath_CheckPlaneLineIntersection(mLoaderArmControlPlane, pCam.GetPosition(), pCam.GetPosition()+pCam.GetForward()*100.0f, vIntersection,fDist))
				{
					mvLoaderArmPickPos = vIntersection;
					cBoundingVolume@ pBounds = Map_GetEntity("ClawBounds").GetMainBody().GetBoundingVolume();
					mvLoaderArmPickPos.x = cMath_Clamp(mvLoaderArmPickPos.x, pBounds.GetMin().x, pBounds.GetMax().x);
					mvLoaderArmPickPos.z = cMath_Clamp(mvLoaderArmPickPos.z, pBounds.GetMin().z, pBounds.GetMax().z);
				}
			}
			
			// Wedged in a cheat - if we're highlighting specific entities, move to them
			if (msLoaderPickedEntity=="InteractGunShell")
			{
				mvLoaderArmPickPos = Map_GetEntity("GunShell").GetPosition();
				mvLoaderArmPickPos.y = gfLoaderArmPlaneY;
			}
			else if (msLoaderPickedEntity=="InteractGun")
			{
				mvLoaderArmPickPos = Map_GetEntity("TriggerHatch").GetPosition();
			}
			
			bool bMovingX = false;
			bool bMovingZ = false;
			
			if (mArmState==eLoaderArmState_Moving || mArmState==eLoaderArmState_AutoMove)
			{
				////////////////////////////
				// Move towards the pick pos
				cVector3f vMoveVec = mvLoaderArmPickPos - mvLoaderArmCurrentPos;
				float fLen = vMoveVec.Length();
				
				bMovingX = cMath_Abs(vMoveVec.x)>0.001f;
				bMovingZ = cMath_Abs(vMoveVec.z)>0.001f;
								
				if (fLen>0.01f)
				{
					vMoveVec.Normalize();

					float fSpeed = gfLoaderArmSpeed;
					if (fLen/afTimeStep<fSpeed)
					{
						fSpeed=fLen/afTimeStep;
					}
					
					vMoveVec*=fSpeed*afTimeStep;
					mvLoaderArmCurrentPos+=vMoveVec;
				}
				else
				{
					mvLoaderArmCurrentPos = mvLoaderArmPickPos;
					if (mArmState==eLoaderArmState_AutoMove)
					{
						mArmState==eLoaderArmState_Moving;
						if (msLoaderArmTargetCallback!="")
						{
							tString sTmp=msLoaderArmTargetCallback;
							msLoaderArmTargetCallback="";
							if (cLux_GetCurrentMap().ScriptPrepare("void "+sTmp+"()"))
							{
								cLux_GetCurrentMap().ScriptExecute();
							}
						}
					}
				}
			}
			
			//////////////////////////////////////////
			// Audio
			if (bMovingX!=mbLoaderArmWasMovingX)
			{
				if (bMovingX)
					Audio_LoadingCrane_LongAxis_Start();
				else
					Audio_LoadingCrane_LongAxis_Stop();
				mbLoaderArmWasMovingX = bMovingX;
			}
			
			if (bMovingZ!=mbLoaderArmWasMovingZ)
			{
				if (bMovingZ)
					Audio_LoadingCrane_SmallAxis_Start();
				else
					Audio_LoadingCrane_SmallAxis_Stop();
				mbLoaderArmWasMovingZ = bMovingZ;
			}
		//	cLux_AddDebugMessage("Moving:"+mbLoaderArmWasMovingX+","+mbLoaderArmWasMovingZ);
		}
	
		/////////////////////////////////////////////////
		
		bool LoaderArm_Lean(float afAmount)
		{
			return false;
		}
		
		/////////////////////////////////////////////////
		
		bool LoaderArm_Action(int alAction, bool abPressed)
		{
			//cLux_AddDebugMessage("Action: "+alAction+" Pressed:"+abPressed);
			if (alAction==eAction_Interact)
			{
				mbInteractKeyDown = abPressed;
				
				if (msLoaderPickedEntity!="")
				{
					if (abPressed)
					{
						cLux_AddDebugMessage("Call entity interact:"+msLoaderPickedEntity);
						Entity_CallEntityInteract(msLoaderPickedEntity);
					}
				}
			}
			else if (alAction==eAction_InteractCancel)
			{
				if (abPressed!=mbZoomKeyDown)
					Audio_LoadingCrane_GUI_Zoom();
				mbZoomKeyDown = abPressed;
			}
			return false;
		}
		//}
		
		//////////////////////////////////////////////////////////
		// Input handling
		
		float mfLoaderArmClawY=0.0f;
		float mfZoom = 0.0f;
		bool mbLoaderArmClawMoving = false;
		
		void LoaderArm_Update(float afTimeStep)
		{
			LoaderArm_UpdatePosition(afTimeStep);
			
			// Update picker pos
			Map_GetEntity("POVMarker_Normal").SetPosition(mvLoaderArmPickPos);
			Map_GetEntity("POVMarker_Selected").SetPosition(mvLoaderArmPickPos);
				
			// Update arm & claw
			cVector3f vBasePos = mvLoaderArmCurrentPos;

			cVector3f vClawPos = vBasePos;
			vClawPos.y = mfLoaderArmClawY;
			
			float fRotateShell = 0.0f;
			float fCurrentY = mfLoaderArmClawY;
			
			if (mArmState == eLoaderArmState_PickUpDown||mArmState == eLoaderArmState_LoadDown)
			{
				// Arm going down
				mfLoaderArmClawY-=gfLoaderClawSpeed*afTimeStep;
				if (mArmState == eLoaderArmState_PickUpDown)
				{
					if (mfLoaderArmClawY<=gfLoaderShellPickupY)
					{
						if (!mbLoaderArmPickedUpShell)
						{
							mbLoaderArmPickedUpShell = true;
							mvLoaderArmOffset = Map_GetEntity("GunShell").GetPosition()-vClawPos;
							Entity_SetActive("InteractGunShell",false);
							Audio_LoadingCrane_PickUpShell();
						}
						mfLoaderArmClawY = gfLoaderShellPickupY;
						if (!mbInteractKeyDown)
							mArmState = eLoaderArmState_PickUpUp;
					}
					else if (!mbInteractKeyDown)
					{
						// Player cancelled
						mArmState = eLoaderArmState_PickUpUp;
						//Entity_SetActive("InteractGunShell",true);
					}
				}
				else if (mArmState == eLoaderArmState_LoadDown)
				{
					fRotateShell = 1.0f-(mfLoaderArmClawY-9.0f)/(gfLoaderClawTopY-9.0f);
					if (mfLoaderArmClawY<=gfLoaderShellLoadY)
					{
						Audio_LoadingCrane_ShellLoad();
						mbLoaderArmPickedUpShell = false;
						Entity_SetActive("GunShell",false);
						Entity_PlaceAtEntity("GunShell_InChamber", "GunShell", cVector3f_Zero, true, true);
						Entity_SetActive("GunShell_InChamber",true);
						Entity_PlayAnimation("SpaceGun", "hatch_close", 0.0f, false, true, "LoaderArm_OnHatchClosed"); 
						mArmState = eLoaderArmState_LoadUp;
						Entity_SetActive("InteractGun",false);
					}
					else if (!mbInteractKeyDown)
					{
						// Player cancelled
						mArmState = eLoaderArmState_LoadUp;
					//	Entity_SetActive("InteractGun",true);
					}
				}
			}
			else if (mArmState == eLoaderArmState_PickUpUp||mArmState == eLoaderArmState_LoadUp)
			{
				// Arm going up
				mfLoaderArmClawY+=gfLoaderClawSpeed*afTimeStep;
				
				if (mArmState==eLoaderArmState_LoadUp)
				{
					fRotateShell = 1.0f-(mfLoaderArmClawY-9.0f)/(gfLoaderClawTopY-9.0f);
				}
				
				if (mfLoaderArmClawY>=gfLoaderClawTopY)
				{
					if (mArmState == eLoaderArmState_PickUpUp && mbLoaderArmPickedUpShell)
						Entity_SetActive("InteractGun",true);

					mfLoaderArmClawY = gfLoaderClawTopY;
					fRotateShell=0.0f;
					if (mArmState==eLoaderArmState_LoadUp && !mbLoaderArmPickedUpShell)
					{
						LoaderArm_MoveToEntity("Area_Loader_End");
					}
					else
					{
						mArmState=eLoaderArmState_Moving;
					}
				}
			}
			else if (mArmState!=eLoaderArmState_AutoMove)
			{
				// Claw up/down when not over anything
				if (mbInteractKeyDown)
					mfLoaderArmClawY=cMath_Clamp(mfLoaderArmClawY-gfLoaderClawSpeed*afTimeStep,gfLoaderClawFailY,gfLoaderClawTopY);
				else
					mfLoaderArmClawY=cMath_Clamp(mfLoaderArmClawY+gfLoaderClawSpeed*afTimeStep,gfLoaderClawFailY,gfLoaderClawTopY);
			}
			
			if (mfLoaderArmClawY!=fCurrentY)
			{
				if (!mbLoaderArmClawMoving)
				{
					Audio_LoadingCrane_ClawMove_Start();
					mbLoaderArmClawMoving = true;
				}
			}
			else
			{
				if (mbLoaderArmClawMoving)
				{
					Audio_LoadingCrane_ClawMove_Stop();
					mbLoaderArmClawMoving = false;
				}
			}
			
			// Set the claw position
			//Map_GetEntity("Claw").SetPosition(vClawPos+Entity_GetBodyOffset("Claw"));
			
			cMatrixf matClaw = cMath_MatrixRotateY(cMath_ToRad(fRotateShell*90.0f));
			matClaw.SetTranslation(vClawPos+Entity_GetBodyOffset("Claw"));
			Map_GetEntity("Claw").SetMatrix(matClaw);
			
			// Set the loader base position
			vBasePos.y = gfLoaderArmBaseY;
			Map_GetEntity("ClawBase").GetMainBody().SetPosition(vBasePos+Entity_GetBodyOffset("ClawBase"));
			
			// Position the cross bar
			cVector3f vBarPos = Map_GetEntity("ClawBar").GetPosition();
			vBarPos.x = mvLoaderArmCurrentPos.x;
			vBarPos.y = gfLoaderArmBaseY;
			Map_GetEntity("ClawBar").SetPosition(vBarPos);
			
			// Scale the cable to the right length
			float fMeshLength = 0.5f;
			if (mfLoaderArmClawY<gfLoaderClawTopY)
				fMeshLength += gfLoaderClawTopY-mfLoaderArmClawY;
				
			float fMeshScale = fMeshLength/0.5f;
			cLuxProp@ pClawCable=cLux_ToProp(Map_GetEntity("ClawCable"));
			pClawCable.SetMeshScaleMul(cVector3f(fMeshScale,1,1));
			
			// Update the shell, if carried
			if (mbLoaderArmPickedUpShell)
			{
				cMatrixf matGunShell =  cMath_MatrixRotateZ(cMath_ToRad(fRotateShell*45.0f));
				matGunShell = cMath_MatrixMul(matGunShell, cMath_MatrixRotateY(cMath_ToRad(fRotateShell*90.0f)));
				matGunShell.SetTranslation(vClawPos+mvLoaderArmOffset+Entity_GetBodyOffset("GunShell"));
				Map_GetEntity("GunShell").SetMatrix(matGunShell);
			}
			
			// Zoom camera
			if (mbZoomKeyDown)
			{
				mfZoom=cMath_Clamp(mfZoom+gfZoomSpeed*afTimeStep,0.0f,1.0f);
			}
			else
			{
				mfZoom=cMath_Clamp(mfZoom-gfZoomSpeed*afTimeStep,0.0f,1.0f);
			}
		}
		
		//---------------------------------------------------------------------------
		
		void Timer_DelayedHatchClose(const tString &in asTimer)
		{
			Entity_PlayAnimation("SpaceGun", "hatch_close", 0.1f, false, true, "SpaceGunHatch_OnDoneClosing");
		}
		
		//---------------------------------------------------------------------------
		
		float mfMaxFOVMul = 2.0f;

		cSequenceStatesData mSequenceEnterLoaderArmControls;
		void Seq_LoaderArmControlsEnter(const tString &in asX)
		{
			Sequence_Begin("Seq_LoaderArmControlsEnter", mSequenceEnterLoaderArmControls);
			
			if(Sequence_DoStepAndPause(0.0))
			{
				cLux_AddDebugMessage("Waiting for entering loader arm controls"); 
				FadeHelmetLightsOut();
				Prop_MoveLinearTo("pilot_seat_helmet", "pilot_seat_helmet_target_down", 1, 1.5, 1, true, "LoaderArmControls_VisorDown");
				Sound_CreateAtEntity("pilotseathelmetlower", "05_01_phi_inside/SFX/pilot_control_chair/crane_helmet_down", "Player");
				Sound_PreloadGroup("05_01_phi_inside/SFX/pilot_control_chair", true);
				Sound_PreloadGroup("05_01_phi_inside/SFX/loading_crane", true);
			}
			else if (Sequence_DoStepAndWait(1.7f))
			{
				Sound_CreateAtEntity("RFCoilEnter", "05_01_phi_inside/SFX/pilot_control_chair/crane_connect", "Player");
			}
			else if (Sequence_DoStepAndWait(0.2f))
			{
				Effect_FilmGrain_FadeFilmGrainIntensity(7.0f,0.05f);
			}
			else if (Sequence_DoStepAndWait(0.2f))
			{
				Effect_FilmGrain_FadeFilmGrainIntensity(0.0f,0.05f);
			}
			else if (Sequence_DoStepAndWait(0.2f))
			{
				Effect_FilmGrain_FadeFilmGrainIntensity(7.0f,0.05f);
			}
			else if(Sequence_DoStepAndWait(0.4f))
			{
				//Effect_Flash_Start(0.2f, 0.2f, 0.2f);
				Effect_ChromaticAberration_StartAnim(3.0f,0.01f,0.0f,0);
			}
			else if(Sequence_DoStepAndWait(0.1f))
			{
				Effect_FilmGrain_FadeFilmGrainIntensity(0.0f,1.0f);
				Effect_Rumble_Start(0.9, 0.7, 0.25f);
				Player_ChangeStateToCustomControls("LoaderArm_Look", "LoaderArm_Move", "LoaderArm_Action", "LoaderArm_Lean");
				
				cLuxPlayer@ pPlayer = cLux_GetPlayer();
				cCamera@ pCamera = pPlayer.GetCamera();
			
				pPlayer.GetCharacterBody().SetCamera(null);

				iLuxEntity @pCameraNode = Map_GetEntity("LoaderArmFPCam", eLuxEntityType_Area);
				pCamera.SetPosition(pCameraNode.GetPosition());
				pCamera.SetRotateMode(eCameraRotateMode_EulerAngles);
				pCamera.SetYaw(cMath_ToRad(-40));
				pCamera.SetPitch(cMath_ToRad(-5));
				
				Player_SetYawLimits(-110,30);
				
				Player_FadeFOVMulTo(1.5f, 100.0f);
				
				Entity_SetActive("SimonLegs",false);
				Entity_SetActive("simon_pilotseat", true);
			}
			else if(Sequence_DoStepAndWait(0.5f))
			{
				mbControllingLoaderArm = true;
				
				Entity_PlayAnimation("SpaceGun", "hatch_open", 0.1f, false, true, "SpaceGunHatch_OnDoneOpening");
				Audio_LoadingCrane_CannonHatchOpen();
				Entity_SetEffectsActive("GunShell", true, true);
				Light_FadeTo("hatch_position_billboard_light",cColor(1.0,1.0,1.0,1.0),4.5,0.75);
				Entity_SetActive("POVMarker_Selected",false);
				Entity_SetActive("POVMarker_Normal",true);
				Lamp_SetLit("CraneGrid_Normal",true,false);
				Lamp_SetLit("CraneGrid_Selected",false,false);
			}
			
			Sequence_End();
		}
		
		void LoaderArmControls_VisorDown(const tString& in asPropName)
		{
			cLux_AddDebugMessage("VisorDown");
			Dialog_Begin("");
				Dialog_AddBranch("");
					Dialog_AddSubject("3A_Cath_PlayerSitsOnPilotSeatVisorDown", "PlayerSitsOnPilotSeatVisorDown_DoneTalking");
			Dialog_End();
		}
		
		void PlayerSitsOnPilotSeatVisorDown_DoneTalking(const tString &in asSubject, bool abStartOfSubject)
		{
			if(abStartOfSubject) return;
			
			cLux_AddDebugMessage("VisorDown:Done Talking");
			SequenceStates_Resume("Seq_LoaderArmControlsEnter");
		}
		
		//---------------------------------------------------------------------------
		
		cSequenceStatesData mSequenceExitLoaderArmControls;
		void Seq_LoaderArmControlsExit(const tString &in asX)
		{
			Sequence_Begin("Seq_LoaderArmControlsExit", mSequenceExitLoaderArmControls);
			
			if(Sequence_DoStepAndWait(1.0))
			{
				Dialog_Begin("");
					Dialog_AddBranch("");
						Dialog_AddSubject("3B_Cath_PlayerDoneLoadingGun");
				Dialog_End();
			}
			if (Sequence_DoStepAndWait(0.45f))
			{
				Sound_CreateAtEntity("RFCoilExit", "05_01_phi_inside/SFX/pilot_control_chair/crane_disconnect", "Player");
				Effect_FilmGrain_FadeFilmGrainIntensity(7.0f,0.05f);
				Audio_LoadingCrane_LongAxis_Stop();
				Audio_LoadingCrane_SmallAxis_Stop();
				Audio_LoadingCrane_ClawMove_Stop();
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Effect_FilmGrain_FadeFilmGrainIntensity(0.0f,0.05f);
			}
			else if (Sequence_DoStepAndWait(0.2f))
			{
				Effect_FilmGrain_FadeFilmGrainIntensity(7.0f,0.05f);
			}
			else if(Sequence_DoStepAndWait(0.2f))
			{
				mbControllingLoaderArm = false;
				Effect_ChromaticAberration_StartAnim(3.0f,0.01f,0.0f,0);
			}
			else if(Sequence_DoStepAndWait(0.1f))
			{
				TurnOffLoadingCrane();
			}
			else if(Sequence_DoStepAndWait(0.0f))
			{
				Entity_SetActive("SimonLegs",true);
				Entity_SetActive("simon_pilotseat", false);
				
				Effect_Rumble_Start(0.9, 0.7, 0.25f);
				Player_FadeFOVMulTo(1.0f, 100.0f);
				Player_SetYawLimits(0,0);
				Effect_FilmGrain_FadeFilmGrainIntensity(0.0f,1.0f);
				Player_ChangeStateToNormal();
				CameraAnimation_Begin("SitAnimBackFromArmControl", "InteractionFromSeat", false);
			}
			if(Sequence_DoStepAndWait(2.5f))
			{
				FadeHelmetLightsIn();
				Prop_MoveLinearTo("pilot_seat_helmet", "pilot_seat_helmet_target_up", 1, 1.5, 1, true);
			}
			else if(Sequence_DoStepAndWait(0.0))
			{
				Dialog_Begin("");
					Dialog_AddBranch("");
						Dialog_AddSubject("4A_Cath_PlayerDoneLoadingGunVisorUp", "Cath_PlayerDoneLoadingGunVisorUp_DoneTalking");
				Dialog_End();
			}
						
			Sequence_End();
		}
		
		void FadeHelmetLightsOut(float afTime=3.0f)
		{
			Light_FadeTo("scanchair_light_9",cColor(0),-1.0f,afTime);
			Light_FadeTo("scanchair_light_10",cColor(0),-1.0f,afTime);
		}
		
		void FadeHelmetLightsIn(float afTime=1.0f)
		{
			Light_FadeTo("scanchair_light_9",cColor(96/255.0f,1.0f,203/255.0f,1.0f),-1.0f,afTime);
			Light_FadeTo("scanchair_light_10",cColor(96/255.0f,1.0f,203/255.0f,1.0f),-1.0f,afTime);
		}
		
