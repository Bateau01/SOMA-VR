	/////////////////////////////////////////
	// Terminal Cath Face
	//{///////////////////////////////////////

	//-------------------------------------------------------
	
	void TerminalCathFace(const tString &in asEntityName, float afTimeStep)
	{
		if(mbCathDeleted==false)
		{
			Depth_ImGui_CathPortrait(afTimeStep);
			//ImGui_DoImage(cImGuiGfx("catherine_large"), cVector3f(0,0,1), ImGui_NrmSizeGroup(cVector2f(1, 1)));
		}
		else
		{
			if(ImGui_GetStateBool("CortexChipCleared", false)==false)
			{
				Depth_ImGui_DrawLineDistortedGfx(cImGuiGfx("catherine_large"), ImGui_NrmPos(-0.1,0, 0), ImGui_NrmSize(1.2), 
													cColor(1,1),0.5f, 0.2f);
			}
			else
			{
				ImGui_DoLabel("Cortex chip corrupt or empty", cVector3f(10,10,1), cVector2f_MinusOne, 3.0f);
			}
		}
	}
	
