	void TerminalLaunchPrintStatusLine(const tString &in asLine, const tString &in asStatus, float afDotEnd, 
										float afLineCharsPerSec, float afDotCharsPerSec, 
										const cVector3f &in avPos, float afTime, const cImGuiLabelData &in aLabel,
										const tString &in asCallbackOnDone="")
	{
		int lNumChars = asLine.length();
		
		float fDotSpaceWidth = afDotEnd - GetFontLengthW(aLabel.mFont, 1.0f, asLine);
		float fDotWidth = GetFontLengthW(aLabel.mFont, 1.0f, ".");
		int lNumDots = fDotSpaceWidth/fDotWidth;
		
		int lNumStatusChars = asStatus.length();
		
		float fLineNeededTime = lNumChars/afLineCharsPerSec;
		float fDotsNeededTime = lNumDots/afDotCharsPerSec;
		float fStatusNeededTime = lNumStatusChars/afLineCharsPerSec;
		
		cVector3f vPos = avPos;
		
		// If time is negative, print line as static text
		if(afTime<0.0f)
		{
			tString sDotLine;
			for(int i=0; i<lNumDots; ++i)
				sDotLine += ".";
					
			tString sLine = asLine + sDotLine + asStatus;
			ImGui_DoLabelExt(sLine, aLabel, vPos);
		}
		else if(afTime<fLineNeededTime)
		{
			TerminalTextType(asLine, vPos, afLineCharsPerSec, afTime, aLabel);
		}
		else if(afTime<fLineNeededTime+fDotsNeededTime)
		{
			ImGui_DoLabelExt(asLine, aLabel, vPos);
						
			tString sDotLine;
			for(int i=0; i<lNumDots; ++i)
				sDotLine += ".";
			
			float fWidth = GetFontLengthW(aLabel.mFont, 1.0f, asLine);
			
			vPos.x += fWidth;
			TerminalTextType(sDotLine, vPos, afDotCharsPerSec, afTime-fLineNeededTime, aLabel);
		}
		else if(afTime<fLineNeededTime+fDotsNeededTime+fStatusNeededTime)
		{
			tString sDotLine;
			for(int i=0; i<lNumDots; ++i)
				sDotLine += ".";
			
			tString sLine = asLine + sDotLine;
			ImGui_DoLabelExt(sLine, aLabel, vPos);
			
			float fWidth = GetFontLengthW(aLabel.mFont, 1.0f, sLine);
			vPos.x += fWidth;
			TerminalTextType(asStatus, vPos, afLineCharsPerSec, afTime-fLineNeededTime-fDotsNeededTime, aLabel, asCallbackOnDone);
		}
		else
		{
			tString sDotLine;
			for(int i=0; i<lNumDots; ++i)
				sDotLine += ".";
					
			tString sLine = asLine + sDotLine + asStatus;
			ImGui_DoLabelExt(sLine, aLabel, vPos);
		}
	}
	
	void TerminalLaunchPrintStatusLineWaiting(const tString &in asLine, float afLineCharsPerSec, float afDotCharsPerSec, const cVector3f &in avPos, float afTime, const cImGuiLabelData &in aLabel)
	{
		int lNumChars = asLine.length();
				
		float fLineNeededTime = lNumChars/afLineCharsPerSec;
			
		cVector3f vPos = avPos;
		
		if(afTime<fLineNeededTime)
		{
			TerminalTextType(asLine, vPos, afLineCharsPerSec, afTime, aLabel);
		}
		else
		{
			tString sWaitingDots = " . . . ";
			float fDotTimeNeeded = sWaitingDots.length()/afDotCharsPerSec;
			
			ImGui_DoLabelExt(asLine, aLabel, vPos);
			
			int lNumTimes = afTime/fDotTimeNeeded;
			float fTime = afTime-(lNumTimes*fDotTimeNeeded);
						
			float fWidth = GetFontLengthW(aLabel.mFont, 1.0f, asLine);
			
			vPos.x += fWidth;
			TerminalTextType(sWaitingDots, vPos, afDotCharsPerSec, fTime, aLabel);
		}
	}
	
	void TerminalTextType(const tString &in asText, const cVector3f &in avPos, float afCharsPerSec, float afTime, const cImGuiLabelData &in aLabel, const tString &in asCallbackOnEnd="")
	{
		int lNumTotalChars = asText.length();
		
		float fPeriod = 1.0f/afCharsPerSec;
		float fNumVisibleCharsFloat = afCharsPerSec*afTime;
		int lLastVisibleCharNum = int(fNumVisibleCharsFloat);
		
		float fRemainder = fNumVisibleCharsFloat-lLastVisibleCharNum;
		float fRelFade = fRemainder;
		
		cVector3f vPos = avPos;
		
		tWString sWText = cString_To16Char(asText);
		tWString sStaticText = cString_SubW(sWText, 0, lLastVisibleCharNum);
		tWString sLastVisibleChar = cString_SubW(sWText, lLastVisibleCharNum, 1);
			
		ImGui_DoLabelExt(cString_To8Char(sStaticText), aLabel, vPos);
			
		vPos.x += GetFontLengthW(aLabel.mFont, 1, sStaticText);
		
		if(lLastVisibleCharNum<lNumTotalChars-1)
		{
			ImGui_SetModColorMul(cColor(1,1,1, fRelFade));
			ImGui_DoLabelExt(cString_To8Char(sLastVisibleChar), aLabel, vPos);
		}
		else
		{
			if(asCallbackOnEnd!="")
			{
				cLux_AddDebugMessage("Calling shitz");
				Map_AddTimer("", 0.0f, asCallbackOnEnd);
			}
		}
	}
	
	void TerminalLaunch_Screen1(const tString &in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("05_01_phi_inside");
						
		StationGuiBG_Scanlines();
		
		cImGuiButtonData button = StationGui_CreateDefaultButtonData();
		ImGui_SetDefaultButton(button);
		
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		
		cImGuiLabelData label = ImGui_GetDefaultLabel();
		label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
		label.mFont.mvSize = 16;
		label.mFontAlign = eFontAlign_Left;
		ImGui_SetDefaultLabel(label);
		
		if (mbARKLaunched)
		{
			float fTimer = ImGui_GetStateFloat("LaunchedTimer");
			fTimer+=afTimeStep;
			ImGui_SetStateFloat("LaunchedTimer",fTimer);
			
			float fLaunchProgress = cMath_Easing(eEasing_SineOut, cMath_Clamp(fTimer/10.0f,0.0f,1.0f));
			if (fLaunchProgress<1.0f)
			{
				cImGuiGfx bg("gunstats_earth", eImGuiGfx_Texture);
				ImGui_DoImage(bg, cVector3f(0.0f,0.0f,5.0f), ImGui_NrmSize(cVector2f(1.0f,1.4f)) );
			
				cImGuiGfx graph("gunstats_earth_graph", eImGuiGfx_Texture);
				ImGui_DoImage(graph, cVector3f(0.0f,0.0f,2.0f), ImGui_NrmSize(cVector2f(1.0f,1.4f)) );
				
				cImGuiGfx block("advanced_black.dds", eImGuiGfx_Texture);
				ImGui_DoImage(block, ImGui_NrmPos(cVector3f(0.0f,-fLaunchProgress*0.875f,3.0f)), ImGui_NrmSize(cVector2f(1.0f,1.0f)) );
			}
			else
			{
				float fOrbitProgress = cMath_Easing(eEasing_QuadOut, cMath_Clamp( (fTimer-10.0f)/200.0f,0.0f,1.0f));
				cImGuiGfx solar("gunstats_solarsystem", eImGuiGfx_Texture);
				ImGui_DoImage(solar, cVector3f(0.0f,0.0f,5.0f), ImGui_NrmSize(cVector2f(1.0f,1.4f)) );
				
				cImGuiGfx graph("gunstats_solarsystem_graph", eImGuiGfx_Texture);
				ImGui_DoImage(graph, cVector3f(720.0f,450.0f,2.0f), ImGui_NrmSize(cVector2f(0.075f,0.3f)) );
				
				cImGuiGfx block("advanced_black.dds", eImGuiGfx_Texture);
				ImGui_DoImage(block, cVector3f(0.0f,-120-fOrbitProgress*230,3.0f), ImGui_NrmSize(cVector2f(1.0f,1.0f)) );
				
				cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
				
				float fSystems = ImGui_GetStateFloat("SystemCheck");
				if (fSystems==0.0f)
					ImGui_FadeStateFloat("SystemCheck",1.0f,10.0f,eEasing_SineOut);
					
				float fPrimary = cMath_Clamp(fSystems*2.0f,0.0f,1.0f);
				float fSecondary = cMath_Clamp(fSystems*2.0f-1.0f,0.0f,1.0f);
				
				cImGuiWindowData window = StationGui_CreateDefaultWindowData();
				window.mbUseBackgroundGfx = true;
				window.mfCaptionSizeMul = 2.0f;
				ImGui_DoWindowStart("LaunchStatus", window, ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 7)), ImGui_NrmSizeGroup(cVector2f(0.6, 0.9)), false);
				
					// Handle resizing for translations
					float fMaxWidth = ImGui_GetCurrentGroupSize().x*0.5;
					float fLabelWidth = 0;
					fLabelWidth = GetFontLengthW(label.mFont, 2.5, "LaunchPrimarySystems"); if (fLabelWidth > fMaxWidth) fMaxWidth = fLabelWidth;
					fLabelWidth = GetFontLengthW(label.mFont, 1.8, "LaunchPrimary1"); if (fLabelWidth > fMaxWidth) fMaxWidth = fLabelWidth;
					fLabelWidth = GetFontLengthW(label.mFont, 1.8, "LaunchPrimary2"); if (fLabelWidth > fMaxWidth) fMaxWidth = fLabelWidth;
					fLabelWidth = GetFontLengthW(label.mFont, 1.8, "LaunchPrimary3"); if (fLabelWidth > fMaxWidth) fMaxWidth = fLabelWidth;
					fLabelWidth = GetFontLengthW(label.mFont, 1.8, "LaunchPrimary4"); if (fLabelWidth > fMaxWidth) fMaxWidth = fLabelWidth;
					fLabelWidth = GetFontLengthW(label.mFont, 2.1, "LaunchSecondarySystems"); if (fLabelWidth > fMaxWidth) fMaxWidth = fLabelWidth;
					fLabelWidth = GetFontLengthW(label.mFont, 1.8, "LaunchSecondary1"); if (fLabelWidth > fMaxWidth) fMaxWidth = fLabelWidth;
					fLabelWidth = GetFontLengthW(label.mFont, 1.8, "LaunchSecondary2"); if (fLabelWidth > fMaxWidth) fMaxWidth = fLabelWidth;
					fLabelWidth = GetFontLengthW(label.mFont, 1.8, "LaunchSecondary3"); if (fLabelWidth > fMaxWidth) fMaxWidth = fLabelWidth;
					fLabelWidth = GetFontLengthW(label.mFont, 1.8, "LaunchSecondary4"); if (fLabelWidth > fMaxWidth) fMaxWidth = fLabelWidth;
					cVector3f vLabelPos = cVector3f(fMaxWidth, 0, 0);
					
					ImGui_SetTransCategory("");
					ImGui_SetAlignment(eImGuiAlign_TopRight);
					ImGui_SetModColorMul(cColor_White);
					ImGui_DoLabel( int(fPrimary*100)+"%", vLabelPos + ImGui_NrmPosGroup(cVector3f(0.45f, 0.1f, 8.0f)), cVector2f_MinusOne, 2);
					ImGui_DoLabel( int(fSecondary*100)+"%", vLabelPos + ImGui_NrmPosGroup(cVector3f(0.45f, 0.55f, 8.0f)), cVector2f_MinusOne, 2);
										
					ImGui_SetAlignment(eImGuiAlign_TopLeft);
					ImGui_SetTransCategory("05_01_phi_inside");
					
					gauge.mGfxFill.mColor = gStationGuiColor_Warning*(1.0-fPrimary) + gStationGuiColor_Highlight*fPrimary;
					ImGui_DoGauge(gauge, fPrimary, vLabelPos + ImGui_NrmPosGroup(cVector3f(0.075f, 0.1f, 8.0f)), ImGui_NrmSizeGroup(cVector2f(0.25f,0.05f)));
					
					gauge.mGfxFill.mColor = gStationGuiColor_Warning*(1.0-fSecondary) + gStationGuiColor_Highlight*fSecondary;
					ImGui_DoGauge(gauge, fSecondary, vLabelPos + ImGui_NrmPosGroup(cVector3f(0.075f, 0.55f, 8.0f)), ImGui_NrmSizeGroup(cVector2f(0.25f,0.05f)));
					
					ImGui_SetAlignment(eImGuiAlign_TopRight);
					
					ImGui_DoLabel( "LaunchPrimarySystems", vLabelPos + ImGui_NrmPosGroup(0.05f, 0.1f, 8.0f), cVector2f_MinusOne, 2.5);
					
					ImGui_DoLabel( "LaunchPrimary1", vLabelPos + ImGui_NrmPosGroup(0.05f, 0.2f, 8.0f), cVector2f_MinusOne, 1.8);
					ImGui_DoLabel( "LaunchPrimary2", vLabelPos + ImGui_NrmPosGroup(0.05f, 0.275f, 8.0f), cVector2f_MinusOne, 1.8);
					ImGui_DoLabel( "LaunchPrimary3", vLabelPos + ImGui_NrmPosGroup(0.05f, 0.35f, 8.0f), cVector2f_MinusOne, 1.8);
					ImGui_DoLabel( "LaunchPrimary4", vLabelPos + ImGui_NrmPosGroup(0.05f, 0.425f, 8.0f), cVector2f_MinusOne, 1.8);
					
					ImGui_SetAlignment(eImGuiAlign_TopLeft);
					ImGui_SetModColorMul( (fPrimary>=0.25f)?gStationGuiColor_Highlight : gStationGuiColor_Highlight2);
					if (fPrimary>0.05f)
						ImGui_DoLabel( (fPrimary>=0.25f)?"LaunchOK":"LaunchCheck", vLabelPos + ImGui_NrmPosGroup(cVector3f(0.075f, 0.2f, 8.0f)), cVector2f_MinusOne, 1.8);
					ImGui_SetModColorMul( (fPrimary>=0.5f)?gStationGuiColor_Highlight : gStationGuiColor_Highlight2);
					if (fPrimary>0.3f)
						ImGui_DoLabel( (fPrimary>=0.5f)?"LaunchOK":"LaunchCheck", vLabelPos + ImGui_NrmPosGroup(cVector3f(0.075f, 0.275f, 8.0f)), cVector2f_MinusOne, 1.8);
					ImGui_SetModColorMul( (fPrimary>=0.75f)?gStationGuiColor_Highlight : gStationGuiColor_Highlight2);
					if (fPrimary>0.55f)
						ImGui_DoLabel( (fPrimary>=0.75f)?"LaunchOK":"LaunchCheck", vLabelPos + ImGui_NrmPosGroup(cVector3f(0.075f, 0.35f, 8.0f)), cVector2f_MinusOne, 1.8);
					ImGui_SetModColorMul( (fPrimary>=1.0f)?gStationGuiColor_Highlight : gStationGuiColor_Highlight2);
					if (fPrimary>0.8f)
						ImGui_DoLabel( (fPrimary>=1.0f)?"LaunchOK":"LaunchCheck", vLabelPos + ImGui_NrmPosGroup(cVector3f(0.075f, 0.425f, 8.0f)), cVector2f_MinusOne, 1.8);
										
					ImGui_SetAlignment(eImGuiAlign_TopRight);
					ImGui_SetModColorMul(cColor_White);
					ImGui_DoLabel( "LaunchSecondarySystems", vLabelPos + ImGui_NrmPosGroup(cVector3f(0.05f, 0.55f, 8.0f)), cVector2f_MinusOne, 2.1);
					
					ImGui_DoLabel( "LaunchSecondary1", vLabelPos + ImGui_NrmPosGroup(cVector3f(0.05f, 0.65f, 8.0f)), cVector2f_MinusOne, 1.8);
					ImGui_DoLabel( "LaunchSecondary2", vLabelPos + ImGui_NrmPosGroup(cVector3f(0.05f, 0.725f, 8.0f)), cVector2f_MinusOne, 1.8);
					ImGui_DoLabel( "LaunchSecondary3", vLabelPos + ImGui_NrmPosGroup(cVector3f(0.05f, 0.8f, 8.0f)), cVector2f_MinusOne, 1.8);
					ImGui_DoLabel( "LaunchSecondary4", vLabelPos + ImGui_NrmPosGroup(cVector3f(0.05f, 0.875f, 8.0f)), cVector2f_MinusOne, 1.8);
					
					ImGui_SetAlignment(eImGuiAlign_TopLeft);
					ImGui_SetModColorMul( (fSecondary>=0.25f)?gStationGuiColor_Highlight : gStationGuiColor_Highlight2);
					if (fSecondary>0.05f)
						ImGui_DoLabel( (fSecondary>=0.25f)?"LaunchOK":"LaunchCheck", vLabelPos + ImGui_NrmPosGroup(cVector3f(0.075f, 0.65f, 8.0f)), cVector2f_MinusOne, 1.8);
					ImGui_SetModColorMul( (fSecondary>=0.5f)?gStationGuiColor_Highlight : gStationGuiColor_Highlight2);
					if (fSecondary>0.3f)
						ImGui_DoLabel( (fSecondary>=0.5f)?"LaunchOK":"LaunchCheck", vLabelPos + ImGui_NrmPosGroup(cVector3f(0.075f, 0.725f, 8.0f)), cVector2f_MinusOne, 1.8);
					ImGui_SetModColorMul( (fSecondary>=0.75f)?gStationGuiColor_Highlight : gStationGuiColor_Highlight2);
					if (fSecondary>0.55f)
						ImGui_DoLabel( (fSecondary>=0.75f)?"LaunchOK":"LaunchCheck", vLabelPos + ImGui_NrmPosGroup(cVector3f(0.075f, 0.8f, 8.0f)), cVector2f_MinusOne, 1.8);
					ImGui_SetModColorMul( (fSecondary>=1.0f)?gStationGuiColor_Highlight : gStationGuiColor_Highlight2);
					if (fSecondary>0.8f)
						ImGui_DoLabel( (fSecondary>=1.0f)?"LaunchOK":"LaunchCheck", vLabelPos + ImGui_NrmPosGroup(cVector3f(0.075f, 0.875f, 8.0f)), cVector2f_MinusOne, 1.8);
						
					ImGui_ResetModifiers();
					
				ImGui_DoWindowEnd();
			}
		}
		else if(SequenceStates_IsActive("Seq_Launch"))
		{
			cImGuiGfx bg("gunstats_earth", eImGuiGfx_Texture);
			ImGui_DoImage(bg, cVector3f(0.0f,0.0f,1.0f), ImGui_NrmSize(cVector2f(1.0f,1.4f)) );
				
			ImGui_SetModColorMul(gStationGuiColor_Normal);
			//ImGui_DoLabel("LaunchCountdown", cVector3f(100,100,1), cVector2f_MinusOne, 6);
			ImGui_SetTransCategory("");
			float fTimerDecimals = Map_GetTimerTime("LaunchCountdown")/mfLaunchCountdownSecondLength;
			tString sCountdownDecimals = "" + fTimerDecimals;
			sCountdownDecimals = cString_Sub(sCountdownDecimals, 2, 3);
			
			float fProgress = mlLaunchCountdown/30.0f;
			cColor gaugeCol = gStationGuiColor_Warning*(1.0f-fProgress) + gStationGuiColor_Highlight2*fProgress;
			ImGui_SetModColorMul(gaugeCol);
					
			ImGui_DoLabel(sCountdownDecimals, cVector3f(380,10,1), cVector2f_MinusOne, 13);
			ImGui_SetAlignment(eImGuiAlign_TopRight);
			ImGui_DoLabel("" + (mlLaunchCountdown+int(fTimerDecimals)), cVector3f(360,-10,2.0f), cVector2f_MinusOne, 18);
		}
	}
	
	void TerminalLaunch_Screen2(const tString &in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("05_01_phi_inside");
						
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		cImGuiButtonData button = StationGui_CreateDefaultButtonData();
		ImGui_SetDefaultButton(button);
		
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		
		cImGuiLabelData label = ImGui_GetDefaultLabel();
		label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
		label.mFont.mvSize = 18;
		label.mFontAlign = eFontAlign_Left;
		ImGui_SetDefaultLabel(label);
		
		cImGuiTextFrameData textFrame = StationGui_CreateDefaultTextFrameData();
		textFrame.mColorText = cColor_White;
		textFrame.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
		textFrame.mFont.mvSize = 18;
		
		cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();

		if (mbCathDead)
		{
			label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
			cVector2f vFontSize = label.mFont.mvSize;
			
			/////////////////////////////////////////
			// Show Cath is dead
			float fTime = ImGui_GetStateFloat("DeadTime");
			fTime+=afTimeStep;
			ImGui_SetStateFloat("DeadTime",fTime);
			
			if (fTime>14.0f)
			{
				ImGui_ResizeFontToFit("DieErrRepeat", label.mFont, ImGui_GetCurrentGroupSize().x*0.9, 2.5);
				ImGui_DoLabelExt("DieErrRepeat", label, cVector3f(100,100,1), cVector2f_MinusOne, 2.5);
			}
			else if (fTime>1.0f)
			{
				ImGui_ResizeFontToFit("DieErr1", label.mFont, ImGui_GetCurrentGroupSize().x*0.9, 2.5);
				ImGui_DoLabelExt("DieErr1", label, cVector3f(100,100,1), cVector2f_MinusOne, 2.5);
			}
			
			if (fTime>13.0f)
			{
				label.mFont.mvSize = vFontSize;
				ImGui_ResizeFontToFit("DieErrRepeat", label.mFont, ImGui_GetCurrentGroupSize().x*0.9, 2.5);
				ImGui_DoLabelExt("DieErrRepeat", label, cVector3f(100,150,1), cVector2f_MinusOne, 2.5);
			}
			else if (fTime>2.0f)
			{
				label.mFont.mvSize = vFontSize;
				ImGui_ResizeFontToFit("DieErr2", label.mFont, ImGui_GetCurrentGroupSize().x*0.9, 2.5);
				ImGui_DoLabelExt("DieErr2", label, cVector3f(100,150,1), cVector2f_MinusOne, 2.5);
			}
				
			label.mFont.mvSize = vFontSize;
			ImGui_ResizeFontToFit("DieErrRepeat", label.mFont, ImGui_GetCurrentGroupSize().x*0.9, 2.5);
			for (int i=0;i<10;++i)
			{
				if (fTime>3.0f+i)
					ImGui_DoLabelExt("DieErrRepeat", label, cVector3f(100,200+50*i,1), cVector2f_MinusOne, 2.5);
			}
		}
		else if(SequenceStates_IsActive("Seq_CathAndSimonUpload")||mTransferState==eTransferState_Transferred)
		{
			switch(mTransferState)
			{
				case eTransferState_Preparing:
				{
					ImGui_SetModColorMul(gStationGuiColor_Normal2);
					textFrame.mFont.mvSize = 81;
					ImGui_DoTextFrameExt("TransferPrepare", 0, 0, 0, textFrame, ImGui_NrmPosGroup(0.097, 0.125, 1), ImGui_NrmSizeGroup(0.9, 1));
					break;
				}
				case eTransferState_Transferring:
				case eTransferState_Transferred:
				{
					textFrame.mFont.mvSize = 81;
					float fProgress = ImGui_GetStateFloat("Progress");
					ImGui_SetModColorMul(gStationGuiColor_Highlight);
					if (mTransferState==eTransferState_Transferring)
						ImGui_DoTextFrameExt("TransferTransferring", 0, 0, 0, textFrame, ImGui_NrmPosGroup(0.097, 0.125, 1), ImGui_NrmSizeGroup(0.9, 1));
					else
						ImGui_DoTextFrameExt("TransferTransferred", 0, 0, 0, textFrame, ImGui_NrmPosGroup(0.097, 0.125, 1), ImGui_NrmSizeGroup(0.9, 1));
					ImGui_SetModColorMul( (fProgress>=1.0f)?gStationGuiColor_Highlight2:gStationGuiColor_Warning);
					ImGui_DoLabel("TransferSimon" , cVector3f(520,380,1), cVector2f_MinusOne, 3);
					ImGui_SetModColorMul( (fProgress>=0.5f)?gStationGuiColor_Highlight2:gStationGuiColor_Warning);
					ImGui_DoLabel("TransferCath" , cVector3f(120,380,1), cVector2f_MinusOne, 3);
					
					cColor gaugeCol = gStationGuiColor_Warning*(1.0f-fProgress) + gStationGuiColor_Highlight2*fProgress;
					ImGui_SetModColorMul(gaugeCol);
					ImGui_DoGauge(gauge, fProgress, cVector3f(100, 300, 1), cVector2f(824, 50));
						
					ImGui_ResetModifiers();
						
					ImGui_DrawLine(cVector2f(500,280),cVector2f(500,440),2,1.0f,cColor_White);
					ImGui_DrawLine(cVector2f(100,280),cVector2f(100,440),2,1.0f,cColor_White);
					ImGui_DrawLine(cVector2f(924,280),cVector2f(924,440),2,1.0f,cColor_White);
					
					if (fProgress>=0.5f)
					{
						ImGui_DoLabel("TransferDone", cVector3f(120, 440, 1), cVector2f_MinusOne, 3);
						
						if(mbCathUploaded==false)
						{
							mbCathUploaded = true;
							
							cLux_AddDebugMessage("Cath uploaded: Upload resume");
							CathAndSimonUpload_ResumeUpload();						
						}
					}
					
					if(fProgress>=1.0f)
					{
						ImGui_DoLabel("TransferDone", cVector3f(520, 440, 1), cVector2f_MinusOne, 3);
						
						if(mbSimonUploaded==false)
						{
							mbSimonUploaded = true;
					
							cLux_AddDebugMessage("Simon uploaded: Upload resume");
							mTransferState = eTransferState_Transferred;
							CathAndSimonUpload_ResumeUpload();
						}
					}
					
					float fScanProgress = fProgress;
					if (fScanProgress>0.5f)
						fScanProgress-=0.5f;
					tString sProgressLine = "TransferTransferring1";
					if (fScanProgress<=0.1f)
					{
						// do nothing
					}
					else if (fScanProgress<=0.2f)
						sProgressLine = "TransferTransferring2";
					else if (fScanProgress<=0.3f)
						sProgressLine = "TransferTransferring3";
					else if (fScanProgress<=0.4f)
						sProgressLine = "TransferTransferring4";
					else if (fScanProgress<=0.425f)
						sProgressLine = "TransferTransferring5";
					else if (fScanProgress<=0.45f)
						sProgressLine = "TransferTransferring6";
					else if (fScanProgress<=0.475f)
						sProgressLine = "TransferTransferring7";
					else if (fScanProgress<0.5f)
						sProgressLine = "TransferTransferring8";
					else
						sProgressLine = "TransferTransferring9";
						
					ImGui_SetModColorMul(gStationGuiColor_Normal);
					ImGui_DoLabel(sProgressLine, cVector3f(120, 500, 1), cVector2f_MinusOne, 2.8f);
					
					if (fScanProgress>0.49f && fScanProgress<=0.499f)
					{
						Depth_ImGui_WauLeechGibberish(cColor_White,0.5f,10.0f);
					}
				}
			}
		}
		else
		{
			if (mTransferState==eTransferState_Transferred)
			{
				Depth_ImGui_WauLeechGibberish(cColor_White,0.5f,10.0f);
			}
			else
			{
				Depth_ImGui_CathPortrait(afTimeStep);
				//ImGui_DoImage(cImGuiGfx("catherine_large"), cVector3f(0,0,1), ImGui_NrmSizeGroup(cVector2f(1, 1)));
			}
		}
	}
	
	void TerminalLaunchCath(const tString &in asEntityName, float afTimeStep)
	{
		
	}
		
	void TerminalLaunchButton(const tString &in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("05_01_phi_inside");
						
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		cStationGui_BigStatusMessageSettings statusMessage;
		
		if(SequenceStates_IsActive("Seq_Launch")==false)
		{
			statusMessage.mfTextSizeMul = 2.5;
			statusMessage.mColor = gStationGuiColor_Normal2;
			StationGui_BigStatusMessage("LaunchButtonLaunch", statusMessage);
		}
		else
		{
			statusMessage.mfTextSizeMul = 2.25;
			statusMessage.mbBlinking = true;
			StationGui_BigStatusMessage("LaunchButtonLaunching", statusMessage);
		}
	}
	
	//}End Terminal Launch
	
	//-------------------------------------------------------
    bool mbSatelliteSoundAllowed = true;
    
    bool CollideSatelliteSound(const tString &in asParent, const tString &in asChild, int alState)
    {
        if(alState==1)
        {
            mbSatelliteSoundAllowed = false;
        }
        else if (alState!=1)
        {
            mbSatelliteSoundAllowed = true;
        }
        return true;
    }
    
	bool mbSlideshowAudioActive = false;
	bool mbSlideshowEndingAudioActive = false;
	void SlideshowAudioStart(bool abSatelliteSound=false)
	{
		if(mbSlideshowAudioActive==false && abSatelliteSound==false)
		{
			Sound_CreateAtEntity("Slideshow", "05_01_phi_inside/SFX/satellite_info/slideshow", "TerminalInfo");
			Voice_Play("Slideshow");
//			Sound_CreateAtEntity("SlideshowVO", "05_01_phi_inside/SFX/satellite_info/slideshow_vo", "TerminalInfo");
			mbSlideshowAudioActive = true;
		}
		
		if(abSatelliteSound==true && mbSlideshowEndingAudioActive==false)
		{
            if(mbSatelliteSoundAllowed==true)
            {
                Sound_CreateAtEntity("Slideshow_Expand", "05_01_phi_inside/SFX/satellite_info/slideshow_expand", "TerminalInfo");
            }
			
			Map_AddTimer("Contract", 2.0f, "SatelliteSlideshowAudio");
			mbSlideshowEndingAudioActive = true;
		}
	}
	
	void SatelliteSlideshowAudio(const tString &in asTimer)
	{
		if(asTimer=="Contract")
		{
            if(mbSatelliteSoundAllowed==true)
            {
                Sound_CreateAtEntity("Slideshow_Contract", "05_01_phi_inside/SFX/satellite_info/slideshow_contract", "TerminalInfo");  
            }
			
			Map_AddTimer("Expand", 2.0f, "SatelliteSlideshowAudio");
		}
		
		if(asTimer=="Expand")
		{
            if(mbSatelliteSoundAllowed==true)
            {
               Sound_CreateAtEntity("Slideshow_Expand", "05_01_phi_inside/SFX/satellite_info/slideshow_expand", "TerminalInfo"); 
            }
			
			Map_AddTimer("Contract", 2.0f, "SatelliteSlideshowAudio");
		}
	}
	
	void SlideshowAudioStop()
	{
		Sound_Stop("Slideshow", 0.05f);
		Voice_Stop("Info");
	//	Sound_Stop("SlideshowVO", 0.05f);
		
		Map_RemoveTimer("Contract");
		Map_RemoveTimer("Expand");
		
		mbSlideshowAudioActive = false;
		mbSlideshowEndingAudioActive = false;
		
		if(Sound_Exists("Slideshow_Expand"))
		{
			Sound_Stop("Slideshow_Expand", 0.05);
		}
		
		if(Sound_Exists("Slideshow_Contract"))
		{
			Sound_Stop("Slideshow_Contract", 0.05);
		}
	}
}

