		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 5 Event D *The End*
		//{///////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbEscSkipsCredits = false;
		int mlPrevSceneRenderFlags = eSceneRenderFlag_All;
		
		cSequenceStatesData mSequenceTheEnd;
		void Seq_TheEnd(const tString &in asTimer)
		{
			Sequence_Begin("Seq_TheEnd", mSequenceTheEnd);
			
			if (Sequence_DoStepAndWait(3.0f))
			{
				// Freeze Simon's feet in place
				Player_SetMoveSpeedMul(0.0f);
				cLux_AddDebugMessage("======================CONVERSATION ENDS HERE=====================");
				Inventory_SetEnabled(false);
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				//OverloadTerminalScreen("TerminalLaunch_Screen1");
				//Light_SetVisible("PointLight_124",false);
			}
			else if(Sequence_DoStepAndWait(3.0f))
			{
				Effect_Fade_Out(3.0f);
				Sound_FadeGlobalVolume(0.0f, 4.0f, eSoundEntryType_AllExceptGui);
			}
			else if(Sequence_DoStepAndWait(4.0f))
			{
				// Disable world rendering when fade out is fully done
				mlPrevSceneRenderFlags = cEngine_GetSceneRenderFlags();
				//cEngine_SetSceneRenderFlags(eSceneRenderFlag_Gui);
			}
			else if(Sequence_DoStepAndWait(10.0f))
			{
				// Disable pause menu for credits
				PauseMenu_Enabled(false);
				
				//Slight delay before credits music starts
				Map_AddTimer("CreditsMusic", 4.5f, "CreditsMusic");
				
				RichPresence_SetCurrent(eRichPresence_Credits );
				cScript_RunGlobalFunc("VRFINALE","","B");
                Credits_Start("config/Credits.cfg", "OnCreditsComplete",0,0.006f);
			}
			else if (Sequence_DoStepAndPause())
			{
				// Enable ESC to skip
				mbEscSkipsCredits = true;
			}
			else if(Sequence_DoStepAndWait(0.0f))
			{
				// Restore world rendering
				//cEngine_SetSceneRenderFlags(mlPrevSceneRenderFlags);
				
				cLux_AddDebugMessage("Changing map!");
				Credits_Stop(0.0f);
				Player_SetMoveSpeedMul(1.0f);
				PauseMenu_Enabled(true);
				mbEscSkipsCredits = false;
				Music_Stop(1.0f,eMusicPrio_OverrideAll);
				cScript_RunGlobalFunc("VRFINALE","","E");
                Map_ChangeMap("05_02_ARK_inside.hpm", "PlayerStartArea_1", "","");
				Inventory_SetEnabled(true);
				
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void CreditsMusic(const tString &in asTimer)
		{
			Music_PlayExt("EndCredits", false, 1.0f, 1.0f, 0.0f, 0.0f, eMusicPrio_OverrideAll, false);
		}
		
		//-------------------------------------------------------
		
		void OnCreditsComplete()
		{
			SequenceStates_Resume("Seq_TheEnd");
		}
		
		//-------------------------------------------------------
				
		//}End Scene 5 Event K
	//}End Scene 5
	
