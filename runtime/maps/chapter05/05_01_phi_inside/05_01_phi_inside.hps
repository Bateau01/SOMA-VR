		float mfLoaderGuiRot = 0.0f;
		
		tString msLoaderNumSrc;
		
		void OnGui(float afTimeStep)
		{
			if (!mbControllingLoaderArm)
				return;
				
			ImGui_GroupBegin(cLux_GetHudVirtualCenterScreenStartPos(), cLux_GetHudVirtualCenterScreenSize());
			
				ImGui_DoImage(cImGuiGfx("robogui_frame", eImGuiGfx_Texture), ImGui_NrmPosGroup(0.025f,0.025f,1), ImGui_NrmSizeGroup(0.95f, 0.95f));
				
				// Rotating circle
				mfLoaderGuiRot+=afTimeStep*60.0f;
				ImGui_SetModRotateAngle(mfLoaderGuiRot);
				ImGui_DoImage(cImGuiGfx("robogui_circles", eImGuiGfx_Texture), ImGui_NrmPosGroup(0.1f,0.1f,1), ImGui_NrmSizeGroupKeepRatio(0.22f, 0.22f));
				ImGui_ResetModifiers();
				
				// Pitch
				float pitchMin = 0.215f;
				float pitchMax = 0.716f;
				cVector2f pitchLimits = Player_GetPitchLimits();
				float pitch = cMath_ToDeg(cLux_GetPlayer().GetCamera().GetPitch());
				float pitchVal = (pitch-pitchLimits.x) / (pitchLimits.y-pitchLimits.x);
				float pitchPos = cMath_Easing(eEasing_Linear,1.0f-pitchVal,pitchMin,pitchMax);
				
				ImGui_SetModRotateAngle(90.0f);
				ImGui_DoImage(cImGuiGfx("robogui_triangle", eImGuiGfx_Texture), ImGui_NrmPosGroup(0.08f,pitchPos,2), ImGui_NrmSizeGroupKeepRatio(0.03f, 0.03f));
				ImGui_ResetModifiers();
				
				// Yaw
				float yawMin = 0.241f;
				float yawMax = 0.747f;
				cVector2f yawLimits = Player_GetYawLimits();
			
				float yaw = cMath_ToDeg(cLux_GetPlayer().GetCamera().GetYaw());
				float yawVal = (yaw-yawLimits.x) / (yawLimits.y-yawLimits.x);
				float yawPos = cMath_Easing(eEasing_Linear,1.0f-yawVal,yawMin,yawMax);
				ImGui_DoImage(cImGuiGfx("robogui_triangle", eImGuiGfx_Texture), ImGui_NrmPosGroup(yawPos,0.822f,2), ImGui_NrmSizeGroupKeepRatio(0.03f, 0.03f));
			
				// Rectangles
				cImGuiGfx rect("robogui_rectangle", eImGuiGfx_Texture);
				for(int y=0;y<4;y++)
				{
					for(int x=0;x<4;x++)
					{
						float fAlpha =  Depth_ImGui_GetOscillatingSignalValue("Rects", y*4+x, eEasing_QuadInOut, 0.0f, 1.0f);
						ImGui_SetModColorMul(cColor(1,1,1,fAlpha));
						ImGui_DoImage(rect, ImGui_NrmPosGroup(0.830f+x*0.018f,0.1575f+y*0.034f,2), ImGui_NrmSizeGroup(0.012f, 0.022f));
					}
				}
				ImGui_ResetModifiers();
				
				// Zoom
				cImGuiLabelData label = ImGui_GetDefaultLabel();
				label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
				label.mFont.mvSize = 22;
				label.mFontAlign = eFontAlign_Right;
				ImGui_SetTransCategory("");
				
				ImGui_SetModColorMul(cColor(0.8f,0.6f,0.0f));
				ImGui_DoLabelExt("ZOOM:", label, ImGui_NrmPosGroup(0.62,0.235f,2), ImGui_NrmSizeGroup(0.3f,0.3f), 1);
				ImGui_ResetModifiers();
				
				if (mbZoomKeyDown)
				{
					ImGui_DoImage(cImGuiGfx("robogui_zoom_on", eImGuiGfx_Texture), ImGui_NrmPosGroup(0.82f,0.4f,2), ImGui_NrmSizeGroup(0.125f, 0.125f));
				}
				else
				{
					ImGui_DoImage(cImGuiGfx("robogui_zoom_off", eImGuiGfx_Texture), ImGui_NrmPosGroup(0.82f,0.4f,2), ImGui_NrmSizeGroup(0.125f, 0.125f));
				}
				
				// Robot Arm
				ImGui_SetModColorMul(cColor(0.8f,0.6f,0.0f));
				ImGui_DoLabelExt("CRANE:", label, ImGui_NrmPosGroup(0.62,0.435f,2), ImGui_NrmSizeGroup(0.3f,0.3f), 1);
				ImGui_ResetModifiers();
				
				if (mbLoaderArmPickedUpShell)
				{
					ImGui_DoImage(cImGuiGfx("robogui_crane_on", eImGuiGfx_Texture), ImGui_NrmPosGroup(0.79f,0.6f,2), ImGui_NrmSizeGroup(0.13f, 0.23f));
				}
				else
				{
					ImGui_DoImage(cImGuiGfx("robogui_crane_off", eImGuiGfx_Texture), ImGui_NrmPosGroup(0.79f,0.6f,2), ImGui_NrmSizeGroup(0.13f, 0.23f));
				}
				
				// Random Text
				cImGuiTextFrameData text = ImGui_GetDefaultTextFrame();
				text.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
				text.mFontAlign = eFontAlign_Left;
				text.mbUseBackgroundGfx = false;
				text.mFont.mvSize = 16;
				ImGui_SetModColorMul(cColor(0.4f,0.2f,0.0f));
				
				int line =  Depth_ImGui_GetOscillatingSignalValue("Line", 0, eEasing_QuadInOut, 0.0f, 1.0f)*10.0f;
				ImGui_DoTextFrameExt(msLoaderNumSrc,cVector2f(0,0),0,line,text,ImGui_NrmPosGroup(0.105f,0.485f,2), ImGui_NrmSizeGroup(0.11f, 0.335f));
				
				ImGui_ResetModifiers();
			
			ImGui_GroupEnd();
		}
		
