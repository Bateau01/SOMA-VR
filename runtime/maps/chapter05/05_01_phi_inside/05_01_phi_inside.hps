		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceInsertCathLaunchPanel;
		void Seq_InsertCathLaunchPanel(const tString &in asTimer)
		{
			Sequence_Begin("Seq_InsertCathLaunchPanel", mSequenceInsertCathLaunchPanel);
				
			if (Sequence_DoStepAndWait(0.5f))
			{
				cLux_AddDebugMessage("Starting launch systems");
				Entity_SetActive("ToolArea_LaunchPanel", false);
				
				CathTool_Insert("CathBoxTool", "cath_terminal_2");
				
				//////////////////////////////
				///Insert Cath Sound
				Sound_CreateAtEntity("InsertCath", "Entities_Station/object/cathtool/insert_cathtool_underwater", "CathBox_LaunchPanel", 0.0f, false, 1.0f);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Entity_SetEffectsActive("cath_terminal_scanchair", true, true);
				Terminal_SetGuiActive("cath_terminal_scanchair", true, 0.25f);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Dialog_Begin("");
					Dialog_AddBranch("");
						Dialog_AddSubject("3A_Cath_PluggedInPilotSeat", "CathPluggedInLaunchPanel_DoneTalking");
				Dialog_End();
				//Terminal_SetGuiActive("TerminalCathFace", true);
				//Voice_SetSource("Catherine", "TerminalCathFace");
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				Seq_SetUpLaunchSystem("");
			}
			
			Sequence_End();
		}
		
		void CathPluggedInLaunchPanel_DoneTalking(const tString&in asSubject, bool abStartOfSubject)
		{
			if(abStartOfSubject) return;
			
			Entity_SetActive("Area_ScanChair", true);
			Lamp_SetLit("pilot_seat_lamp_*", true, true);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceSetUpLaunchSystem;
		void Seq_SetUpLaunchSystem(const tString &in asX)
		{
			Sequence_Begin("Seq_SetUpLaunchSystem", mSequenceSetUpLaunchSystem);
			
			if(Sequence_DoStepAndWait(0.5f))
			{
				cLux_AddDebugMessage("Setting up launch system");
			}
			if(Sequence_DoStepAndWait(1.5f))
			{
				Entity_SetEffectsActive("TerminalLaunch_Screen1", true, true);
				Terminal_SetGuiActive("TerminalLaunch_Screen1", true, 0.5f);
			}
			else if(Sequence_DoStepAndWait(0.0f))
			{
				cLux_AddDebugMessage("Done setting up launch system");
				SequenceStates_Resume("Seq_InsertCathLaunchPanel");
			}
			
			Sequence_End();
		}
		
