		/////////////////////////////////////////
		// Scene 5 Event C2 *Epilogue*
		//{///////////////////////////////////////
		
		//-------------------------------------------------------
		
		// New epilogue in which Simon can get up out of his seat, discover
		// a broken Omnitool, go back into the base and see it's all shut down.
		void StartSimonEpilogue()
		{
			CathTool_AllowDetach("CathBoxTool");
			
			Prop_AlignRotation("pilot_seat_apparatus_arm", "pilot_seat_apparatus_arm_return", 2, 2, 2, true);
			Prop_MoveLinearTo("pilot_seat_apparatus_arm", "pilot_seat_apparatus_arm_return", 2, 3, 2, true);

			//Sound for pilot seat
			cLux_AddTodoMessage("SOUND: Guess this needs to change, Sam.");
			Sound_CreateAtEntity("PilotSeatMonitors", "05_01_phi_inside/SFX/pilot_control_chair/pilot_control_chair_seat_monitors", "ScreenSpinSoundSource");
			
			Sound_FadeGlobalVolume(1.0f, 5.0f, eSoundEntryType_WorldAll);
			
			Map_AddTimer("TimerSimonChairGetUp2",1.0f,"TimerSimonChairGetUp2");
		}
		
		//-------------------------------------------------------
		
		void TimerSimonChairGetUp2(const tString& in asName)
		{
			Entity_RemoveEntityAttachment("player");
			
			Prop_AlignRotation("pilot_seat", "pilot_seat_return", 1, 1.5, 1, true);
			Prop_MoveLinearTo("pilot_seat", "pilot_seat_return", 1, 1.5, 1, true);

			//Sound for pilot seat
			cLux_AddTodoMessage("SOUND: Guess this needs to change, Sam.");
			Sound_CreateAtEntity("PilotSeatStartup", "05_01_phi_inside/SFX/pilot_control_chair/pilot_control_chair_seat_startup", "Player");
			
			CameraAnimation_End();
			CameraAnimation_Begin("SitAnimUp","",true);
			
			// Set up end.
			Entity_SetActive("TriggerEnd",true);
			KillControlRoom();
		}
		
		//-------------------------------------------------------
		
		void KillControlRoom()
		{
			Lamp_SetLit("LampControlRoom_*",false,false);
			Lamp_SetLit("sign_lamp_*",false,false);
			Lamp_SetLit("sign_lamp_5",true,false);
			Lamp_SetLit("lamp_wall_deepsea_*",false,false);
			Terminal_SetGuiActive("TerminalCathFace",false);
			Terminal_SetGuiActive("TerminalInfo",false);
			Lamp_SetLit("LampUpperFloorEmer_*", false, false);
			Lamp_SetLit("LampUpperFloorDoor_*", false, false);
			Lamp_SetLit("GreenLamp_*", false, true);
			Light_SetVisible("spotliight_tunnels_*",false);
			Entity_SetEffectsActive("cath_terminal_1",false, false);
			Entity_SetEffectsActive("computer_parts_keyboard_white_1",false, false);
			Lamp_SetLit("omnislot_inside_right_light_1",false,false);
			Light_SetVisible("pointlight_tunnels_*",false);
			Light_SetVisible("PointLight_116",false);
			Light_SetVisible("SpotLight_4",false);
			Light_SetVisible("airlock_1_light_*",false);
			Light_SetVisible("airlock_1_flood_*",false);
			
			Entity_SetInteractionDisabled("cath_terminal_1",true);
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerEnd(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_TheEnd("");
			return false;
		}
		
