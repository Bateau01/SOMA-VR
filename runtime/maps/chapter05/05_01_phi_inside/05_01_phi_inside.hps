	//Generator sounds
	bool Trigger_GeneratorControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1 && mbPowerLightsLowerFloor == true)
		{
			//start generator sounds
			Sound_Play("generatorhub_spot_*", 1.0f);
			cLux_AddDebugMessage("Generator sounds on");
		}
		else if(alState==1 && mbPowerLightsLowerFloor == false)
		{
			//stop generator sounds
			Sound_Stop("generatorhub_spot_*", 3.0f);
			cLux_AddDebugMessage("Power off - no generator sounds");
		}
		else
		{
			//stop generator sounds
			Sound_Stop("generatorhub_spot_*", 3.0f);
			cLux_AddDebugMessage("Stopping generator sounds - left area");
		}
		return true;
	}


	void Audio_PowerLowerFloor(bool abPowerState = false)
	{
		if(abPowerState==false)
		{
			Map_AddTimer("PowerOff", 0.5f, "PowerLowerFloor");
		}
		else if(abPowerState==true)
		{
			Map_AddTimer("PowerOn", 0.5f, "PowerLowerFloor");
		}
	}
	
	void PowerLowerFloor(const tString &in asTimer)
	{
		if(asTimer=="PowerOff")
		{
			Sound_CreateAtEntity("GeneratorRoomPowerOff", "05_01_phi_inside/SFX/room_power/power_room/power_down", "Player");
			Sound_Stop("GeneratorRoomPowerOn", 0.5f);
			Sound_Stop("generatorhub_spot_*", 1.5f);
		}
		else if (asTimer=="PowerOn")
		{
			Sound_CreateAtEntity("GeneratorRoomPowerOn", "05_01_phi_inside/SFX/room_power/power_room/power_up", "Player");
			Sound_Stop("GeneratorRoomPowerOff", 0.5f);
			Sound_Play("generatorhub_spot_*", 0.25f);
		}
	}
    
