	//-------------------------------------------------------
	
	//////////////////////////////////////
	//{ Banter handling funcs
	
	int mlBanterAfterDatamineCount=0;
	int mlBanterGoToARKCount=0;
	bool mbBanterSeenBody=false;
	bool mbBanterQueued=false;
	
	//--------------------------------------------------------
	
	void Banter_Start()
	{
		cLux_AddDebugMessage("[Banter] Started.");
		Map_AddTimer("Timer_Banter_Play", Banter_GetIntervalTime(), "Timer_Banter_Play");
	}
	
	//--------------------------------------------------------
	
	void Banter_SetPaused(bool abPaused)
	{
		cLux_AddDebugMessage("[Banter] Set paused:"+abPaused);
		Map_SetTimerPaused("Timer_Banter_Play",abPaused);
	}
	
	//--------------------------------------------------------
	
	void Banter_Stop()
	{
		cLux_AddDebugMessage("[Banter] Stopped.");
		Map_RemoveTimer("Timer_Banter_Play");
	}
	
	//--------------------------------------------------------
	
	void Banter_SeenBody()
	{
		cLux_AddDebugMessage("[Banter] Seen body.");
		mbBanterSeenBody = true;
	}
	
	//--------------------------------------------------------
	
	void Banter_DamageInterrupt()
	{
		if (Voice_SceneIsActive("CathAndSimon"))
		{
			Depth_Audio_PlayerTakeDamage();
			Voice_Stop("CathAndSimon");
		}
	}
	
	//--------------------------------------------------------
	
	// Have we exhausted Cath's post-datamine discussion?
	bool Banter_RunOutOfAfterDatamineLines()
	{
		return (mlBanterAfterDatamineCount>=5);
	}
	
	//--------------------------------------------------------
	
	int Banter_GetIntervalTime()
	{
		int lTime=0;
		if (mbBanterSeenBody && !Banter_RunOutOfAfterDatamineLines() )
		{
			if (mlBanterAfterDatamineCount==0)	// First line comes quicker
				return 5;
			return 10;
		}
		else
		{
			if (mlBanterGoToARKCount==0)	 // First line comes quicker
				return 10;
			return 20;
		}
	}
	
	//--------------------------------------------------------
	
	void Timer_Banter_Play(const tString& in asTime)
	{
		cLux_AddDebugMessage("[Banter] Timer fires.");
		
		// Is there already something pending
		// OR is there something else going on? 
		// Try again in 5 seconds
		if (mbBanterQueued || (!Banter_CheckPlayLine("")) )
		{
			cLux_AddDebugMessage("[Banter] Busy - add 5 seconds.");
			Map_RestartCurrentTimer(5);
			return;
		}
		
		// Figure out which line to play...
		tString sLine;
		if (mbBanterSeenBody && !Banter_RunOutOfAfterDatamineLines())
		{
			mlBanterAfterDatamineCount++;
			sLine="1F_Cath_AfterDatamine_"+mlBanterAfterDatamineCount;
		}
		else
		{
			mlBanterGoToARKCount++;
			sLine="1C_Cath_GoToARK_"+mlBanterGoToARKCount;
		}
		if (Voice_SubjectExists(sLine))
		{
			cLux_AddDebugMessage("[Banter] Queued:"+sLine);
			mbBanterQueued = true;
			Voice_PlayWhenPossible(sLine,"Banter_CheckPlayLine",-1,5.0f,"Banter_OnLinePlayed");
		}
		Map_RestartCurrentTimer(Banter_GetIntervalTime()+15); // The 15 here is 15 seconds for the amount of banter. Not ideal, but better than nothing.
	}
	
	//--------------------------------------------------------
	
	bool Banter_CheckPlayLine(const tString& in asSubject)
	{
		if (Voice_AnySceneIsActive())
			return false;
			
		int lPlayerState = cLux_GetPlayer().GetCurrentStateId();	
		if (lPlayerState== ePlayerState_Terminal ||
			lPlayerState == ePlayerState_Read)
			return false;
		
		return true;
	}
	
	//--------------------------------------------------------
	
	void Banter_OnLinePlayed(const tString&in asScene, const tString&in asSubject)
	{
		cLux_AddDebugMessage("[Banter] Played:"+asSubject);
		mbBanterQueued = false;
		if (asSubject=="1C_Cath_GoToARK_4" && cScript_GetGlobalVarBool("PlayerLostHand"))
		{
			Voice_PlayWhenPossible("1C_Cath_GoToARK_4_ExtraLostHand");
		}
	}
	
	//}-------------------------------------------------------

	/////////////////////////////////////////
	// ==============
	// Scene 1 *Plug Cath & look for ARK*
	// ==============
	//{///////////////////////////////////////

	//{-------------------------------------------------------

	bool mbARKUnloaded = false;		//ARK is in cargo
	bool mbArkOK = false;			//ARK was not damaged in 4.2
	bool mbArmGone = false;			//Player lost arm in 4.3
	
	bool mbFoundAssemblyRoom = false;
	bool mbFoundARK = false;
	
	//}-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 1 Event A *Drain and exit airlock*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		int mlDrainShakeID = -1;
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceEntranceAirlockDrain;
			
		void Seq_AirlockEntranceDrain(const tString &in asTimer)
		{
			Sequence_Begin("Seq_AirlockEntranceDrain", mSequenceEntranceAirlockDrain);
			
			if (Sequence_DoStepAndWait(1))
			{
				Entity_SetActive("AMB_GlobalTunnels", true);
				Terminal_SetImGuiStateFloat("AirlockEntranceControlScreen", "PressureMul", 1.0f);
				Terminal_FadeImGuiStateFloat("AirlockEntranceControlScreen", "PressureMul", 0.0f, 0);
			}

			else if(Sequence_DoStepAndWait(0.0f))
			{
				Achievement_Unlock(eAchievement_Expressway);
				
				Entity_SetVarString("AirlockEntranceControlScreen", "State", "Opening");
				MovingButton_SetLocked("DoorAirlockEntrance_Inner_Panel", false, true);
				MovingButton_SetSwitchedOn("DoorAirlockEntrance_Inner_Panel", true, true);
				
				//Timer for enter level comment to stop from being drowned out by door opening
				Map_AddTimer("EnterLevelComment", 6.0f, "EnterLevelComment");
				
				Entity_SetVarString("AirlockEntranceControlScreen", "State", "Idle");
				Terminal_SetUpdateWhenOutOfView("AirlockEntranceControlScreen", false);
			}
			
			Sequence_End();
		}
				
		//-------------------------------------------------------
		
		void EnterLevelComment(const tString &in asTimer)
		{				
			// Comment on entering the level
			Voice_Play("Player_Enters_Level");
		}
		
		//-------------------------------------------------------
		
		void StartingAirlockAlarmEmpty(const tString &in asTimer)
		{
			Sound_CreateAtEntity("Intro_AirlockFlushingAlarm", "Entities_OceanBottom/airlock/alarms/draining_alarm", "StartingAirlockAlarmSoundSource", 0, true);
			Map_AddTimer("StartingAirlockAlarm", 1.0f, "StartingAirlockAlarmEmpty");
		}

		//-------------------------------------------------------
		
		bool Trigger_AirlockEmptied(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1) return true;
			
			SequenceStates_Resume("Seq_AirlockEntranceDrain");
			return false;
		}

		//} End Scene 1 Event A

		//-------------------------------------------------------

		
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 1 Event B *Plug in cath*
		//{///////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene X, Event X here.*/

		//-------------------------------------------------------
		
		bool CathBox_CanBeUsed(const tString &in asTool, const tString &in asEntity)
		{
			if (Map_GetEntity(asEntity).GetInteractionDisabled())
				 return false;
			
			if(asEntity=="cath_terminal_1")
			{
				return true;
			}
			else if(asEntity=="cath_terminal_2")
			{
				return true;
			}
			else if(asEntity=="AirlockEntranceControlPanel")
			{
				return true;
			}
			else if(asEntity=="AirlockSpaceGunControlPanel")
			{
				return true;
			}
				
			return false;
		}

		//-------------------------------------------------------
		
		bool CathBox_OnPickUp(const tString &in asTool)
		{
			if (mTransferState==eTransferState_CathReturned)
			{
				Entity_SetEffectsActive("cath_terminal_2",false,true);
				Entity_SetInteractionDisabled("cath_terminal_2",true);
				Tool_SetAutoHideAfterPickup("CathBoxTool",false);
				
				Seq_TheEnd("");
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		bool CathBox_OnUse(const tString &in asTool, const tString &in asEntity)
		{
			if(asEntity=="cath_terminal_1")
			{
				////////////////////////////////////////////
				// Inserting cath in control room terminal
				Seq_InsertCathControlRoom("");
				return true;
			}
			else if(asEntity=="cath_terminal_2")
			{
				////////////////////////////////////////////
				// Inserting cath in launch panel
				Seq_InsertCathLaunchPanel("");
				return true;
			}
			else if(asEntity=="AirlockEntranceControlPanel")
			{
				CathTool_UseOnPanel(asTool, asEntity);
			}
			else if(asEntity=="AirlockSpaceGunControlPanel")
			{
				SetUpDomeAirlockBlocker();
				CathTool_UseOnPanel(asTool, asEntity);
			}

			return false;
		}
		
		void OnChange_EntranceAirlockButton(const tString &in asEntity, int alState)
		{
			////////////////////////////////////////////
			// Using cath on entrance airlock
			if(mbARKLaunched==false)
				Seq_AirlockEntranceDrain("");
			
			Entity_SetActive("ToolArea_AirlockEntrance",false);
			Entity_SetInteractionDisabled("AirlockEntranceControlPanel",true);
		}
		
		void OnChange_SpaceGunAirlockButton(const tString &in asEntity, int alState)
		{
			if (SequenceStates_IsActive("Seq_AirlockSpaceGunFill")||SequenceStates_IsActive("Seq_AirlockSpaceGunEmpty"))
				return;
				
			Entity_SetActive("ToolArea_AirlockSpaceGun",false);
			Entity_SetInteractionDisabled("AirlockSpaceGunControlPanel", true);
			
			////////////////////////////////////////////
			// Using cath on dome airlock
			if (!mbAirlockFilled)
				Seq_AirlockSpaceGunFill("");
			else
				Seq_AirlockSpaceGunEmpty("");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceInsertCathControlRoom;
		void Seq_InsertCathControlRoom(const tString &in asTimer)
		{
			Sequence_Begin("Seq_InsertCathControlRoom", mSequenceInsertCathControlRoom);
				
			if (Sequence_DoStepAndWait(1))
			{
				CathTool_Insert("CathBoxTool", "cath_terminal_1");
				
				PlayerEnergy_SetAllowCathComment(true);
				
				cLux_AddTodoMessage("Talk to catherine here!");
				
				Dialog_StartConversation("Catherine", "TerminalCathFace");
				Dialog_Begin();
					Dialog_AddBranch("");
						Dialog_AddPause(1.5f); // Pause here to lock us into conversation immediately
						if(mbArmGone)	
						{
							Map_AddTimer("Timer_ShowLostArm",7.0f,"Timer_ShowLostArm");
							Dialog_AddPause(2.0f);
							Dialog_AddSubject("1B_Cath_PluggedInControlRoomOpenLostArm");
						}
						else
						{
							Dialog_AddSubject("1B_Cath_PluggedInControlRoomOpen");
						}
										
						Dialog_AddSubject("1B_Cath_PluggedInControlRoom","CathPluggedIn_DoneTalking");
				Dialog_End();
			}
			
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Terminal_SetGuiActive("TerminalCathFace", true);
				Entity_SetEffectsActive("CathCamera",true,true);
			//	HeadTracker_SetActive("CathCamera",true);
			}
			else if (Sequence_DoStepAndPause())
			{
				// This is when Cath actually starts talking
				Sound_PreloadGroup("05_01_phi_inside/SFX", true);
				Sound_PreloadGroup("05_01_phi_inside/AMB", true);
			}
			else if (Sequence_DoStepAndPause())
			{
				Seq_PowerUpControlRoom("");
			}
			else if (Sequence_DoStepAndWait(0))
			{
				// Cath comments
				Dialog_Begin();
					Dialog_AddBranch("");
						Dialog_AddSubject("1B_Cath_ControlRoomSetUpDone", "ControlRoomSetUp_DoneTalking");
				Dialog_End();
			} 

			Sequence_End();
		}
		
		void Timer_ShowLostArm(const tString& in asName)
		{
			PlayerHands_PlayAnimation("event_look_at_mutilated_hand");
			Sound_CreateAtEntity("StumpLook", "05_01_phi_inside/SFX/look_at_mutilated_hand", "Player");
		}
		
		void CathPluggedIn_DoneTalking(const tString&in asSubject, bool abStartOfSubject)
		{
			if(abStartOfSubject) return;
			
			SequenceStates_Resume("Seq_InsertCathControlRoom");
		}
		
		void ControlRoomSetUp_DoneTalking(const tString&in asSubject, bool abStartOfSubject)
		{
			if(abStartOfSubject) return;
			
			Banter_Start();
		}
		
		//-------------------------------------------------------
				
		cSequenceStatesData mSequencePowerUpControlRoom;
		void Seq_PowerUpControlRoom(const tString &in asX)
		{
			Sequence_Begin("Seq_PowerUpControlRoom", mSequencePowerUpControlRoom);
			
			if(Sequence_DoStepAndWait(2.35f))
			{
				Sound_CreateAtEntity("PowerUpHub", "05_01_phi_inside/SFX/hub_powerup", "Player");
				Sound_PreloadGroup("05_01_phi_inside/SFX/satellite_info", true);
				
				MovingButton_SetLocked("DoorCorridor_2_Panel_1",false);
				
				Entity_SetAnimationPaused("DoorCorridor_1","door_open",false);
				MovingButton_SetSwitchedOn("DoorCorridor_1_Panel_1",true,false);
				MovingButton_SetLocked("DoorCorridor_1_Panel_1",false);
				
			}
			else if(Sequence_DoStepAndWait(2.15f))
			{
				SetEmergencyLamp("LampUpperFloorEmer_*", false);
				Lamp_SetLit("LampUpperFloorDoor_*", true, false);
				
				//!!Moving these will knock them out of sync with the sound!!
				Lamp_SetLit("LampControlRoom_1_*", true, true);
				Entity_FadeEffectBaseColor("sign_lamp_*", cColor(0.4, 0.61, 0.66, 1), 1);
				Sound_Play("hub_light_buzz_*", 1.0f);
				Lamp_SetLit("GreenLamp_*", true, true);
			}
			else if(Sequence_DoStepAndWait(4.75f))
			{
				Terminal_SetGuiActive("TerminalInfo", true);
			}
			else if(Sequence_DoStepAndWait(1.0f))
			{

				Map_AddTimer("PhiPowerMusic", 1.0f, "PhiPowerMusic");
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				MovingButton_SetLocked("DoorLowerFloor_Panel_1", false);
				MovingButton_SetLocked("DoorCorridor_1_Panel_1", false);
				MovingButton_SetLocked("DoorAirlockSpaceGun_Inner_Panel", false);
			}
			else
			{
				SequenceStates_Resume("Seq_InsertCathControlRoom");
			}
			
			Sequence_End();
		}
		
		//}End Scene 1 Event B
		
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 1 Event C *Go to ARK*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		
		//} END Event Simon and Cath Banter
		
		//}End Scene 1 Event C
		
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 1 Event D *Get ARK*
		//{///////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene X, Event X here.*/
		
		tString sPowerpackAreaPrefix = "PowerpackSocketInteract_";
		tString sPowerpackPluggedPrefix = "PowerpackPlugged_";

		//-------------------------------------------------------
		
		bool Powerpack_CanBeUsed(const tString &in asTool, const tString &in asEntity)
		{
			if (Map_GetEntity(asEntity).GetInteractionDisabled())
				 return false;
			 
			return cString_GetFirstStringPos(asEntity, sPowerpackAreaPrefix)==0;
		}
		
		//-------------------------------------------------------
		
		bool Powerpack_OnUse(const tString &in asTool, const tString &in asEntity)
		{
			tString sLocation = cString_Sub(asEntity, sPowerpackAreaPrefix.length());
			tString sToolLocation = sPowerpackPluggedPrefix + sLocation;
			tString sToolInteract = sPowerpackAreaPrefix + sLocation;
			
			Entity_SetActive(sToolLocation, true);
			Entity_SetInteractionDisabled(sToolLocation,true);
			Entity_SetActive(sToolInteract, false);
			Sound_CreateAtEntity("PlugInPowerPack", "05_01_phi_inside/SFX/powerpack/plug_in", sToolLocation);
			Sound_CreateAtEntity("PlugInPowerPackSweet", "05_01_phi_inside/SFX/powerpack/plug_in_sweet", sToolLocation);
			Sound_CreateAtEntity(sToolLocation, "05_01_phi_inside/SFX/powerpack/idle", sToolLocation);
			
			if(sLocation=="Lights")
				Powerpack_UsedOnLights();
			else if(sLocation=="Cargo")
				Powerpack_UsedOnCargo();
			else if(sLocation=="SatFrameRoom")
				Powerpack_UsedOnSatFrameRoom();
			
			return true;
		}
		
		//-------------------------------------------------------
		
		bool PowerpackPlugged_OnPickUp(const tString &in asTool)
		{
            cScript_SetGlobalReturnBool(false);
            cScript_RunGlobalFunc("MenuHandler","cScrMenuHandler","HPL3VR_GetRuntimeActive");
            bool vr=cScript_GetGlobalReturnBool();
            if(vr)
            {
                // Confirm the canonical carrier before retiring the plugged presentation.
                cScript_SetGlobalArgString(0,"powerpack_1"); cScript_SetGlobalReturnBool(false);
                cScript_RunGlobalFunc("PlayerToolHandler","","_Global_GetToolIsInInventory");
                if(cScript_GetGlobalReturnBool()) return false;
                Entity_PlaceAtEntity("powerpack_1",asTool);
                Entity_SetVarString("powerpack_1","VRReturnArea",sPowerpackAreaPrefix+cString_Sub(asTool,sPowerpackPluggedPrefix.length()));
                cScript_RunGlobalFunc("VROMNITHETA","powerpack_1","R");
                cScript_SetGlobalReturnBool(false);
                cScript_RunGlobalFunc("powerpack_1","cScrPropTool","_Global_VRReturnPhiPowerpack");
                if(!cScript_GetGlobalReturnBool())
                {
                    cScript_RunGlobalFunc("VROMNITHETA","powerpack_1","X");
                    Player_RemoveTool("powerpack_1"); Entity_SetActive("powerpack_1",false);
                    Entity_SetVarString("powerpack_1","VRReturnArea","");
                    return false;
                }
            }

			tString sLocation = cString_Sub(asTool, sPowerpackPluggedPrefix.length());
			tString sToolInteract = sPowerpackAreaPrefix + sLocation;
			
			Sound_CreateAtEntity("PickUpPowerPack", "05_01_phi_inside/SFX/powerpack/plug_out", "PowerpackPlugged_"+sLocation);
			Sound_CreateAtEntity("PickUpPowerPackSweet", "05_01_phi_inside/SFX/powerpack/plug_out_sweet", "PowerpackPlugged_"+sLocation);
			Sound_Stop("PowerpackPlugged_"+sLocation, 0.5f);
			
			Entity_SetActive(asTool, false);
			Entity_SetActive(sToolInteract, true);
			if(!vr) Entity_CallEntityInteract("powerpack_1");	//Give powerpack
			
		    Entity_FadeEffectBaseColor("lamp_sat_prep_low_power_*", cColor(1, 0, 0, 1), 1);
		    Entity_FadeEffectBaseColor("lamp_sat_prep_power_indicator_*", cColor(1, 0, 0, 1), 1);
			
			if(sLocation=="Lights")
				Powerpack_PickedUpFromLights();
			else if(sLocation=="Cargo")
				Powerpack_PickedUpFromCargo();
			else if(sLocation=="SatFrameRoom")
				Powerpack_PickedUpFromSatFrameRoom();
			
			return false;
		}
				
		//-------------------------------------------------------
		
		bool mbPowerLightsLowerFloor = true;
		void Powerpack_UsedOnLights()
		{
			cLux_AddDebugMessage("Used on lights!!");
			Audio_PowerLowerFloor(true);
			Seq_PowerUpLowerFloorLights("");
			Entity_SetInteractionDisabled("PowerpackPlugged_Lights",false);
		}
		
		cSequenceStatesData mSequenceLowerFloorLightsPowerUp;
		void Seq_PowerUpLowerFloorLights(const tString &in asTimer)
		{
			Sequence_Begin("Seq_PowerUpLowerFloorLights", mSequenceLowerFloorLightsPowerUp);
			
			if(Sequence_DoStepAndWait(1.0f))
			{
				Lamp_SetFlickerActive("PowerLamp_Lights",false);
				mbPowerLightsLowerFloor = true;
				cLux_AddDebugMessage("REGULAR LIGHTS COME BACK ON");
				Lamp_SetLit("LampLowerFloor_*", true, true);
				Lamp_SetLit("lamp_lower_special_lowpower_*", false, false);
				Entity_FadeEffectBaseColor("Lamp_lower_lowpower_*", cColor(0.475, 0.976, 1, 1), 1);
			}				
			if(Sequence_DoStepAndWait(1.0f))
			{
				IrradianceSet_FadeInSingleProbe("Probe_LowerFloor_*", "entry_area", 6.0f);
				Lamp_SetLit("LampLowerFloor_1*", true, true);
			}
			if(Sequence_DoStepAndWait(1.0f))
			{
				Lamp_SetLit("LampLowerFloor_6*", true, true);
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void Powerpack_PickedUpFromLights()
		{
			cLux_AddDebugMessage("Picked up powerpack from lights!!");
			
			Entity_SetActive("PowerPackInteractAux1",false);
			
			Seq_PowerDownLowerFloorLights("");
			Audio_PowerLowerFloor(false);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceLowerFloorLightsPowerDown;
		void Seq_PowerDownLowerFloorLights(const tString &in asTimer)
		{
			Sequence_Begin("Seq_PowerDownLowerFloorLights", mSequenceLowerFloorLightsPowerDown);
			
			if(Sequence_DoStepAndWait(1.0f))
			{
				mbPowerLightsLowerFloor = false;
				Lamp_SetFlickerActive("PowerLamp_Lights",true);
				IrradianceSet_FadeInSingleProbe("Probe_LowerFloor_*", "lower_floor_red", 1.0f);
				Lamp_SetLit("LampLowerFloor_*", false, true);
				Entity_FadeEffectBaseColor("Lamp_lower_lowpower_*", cColor(1.5, 0, 0, 1), 1);
				Lamp_SetLit("lamp_lower_special_lowpower_*", true, true);
				cLux_AddDebugMessage("EMERGENCY LIGHTS SHOULD COME ON");
			}
						
			Sequence_End();
		}
		
		//-------------------------------------------------------
				
		void Timer_SetLowerFloorLampsLit(const tString &in asTimer)
		{
			cColor newColor;
			bool bLit = cString_ToBool(asTimer, true);
			if(bLit)
			{
				newColor = cColor(1,1);			
			}
			else
			{
				newColor = cColor(0.4,0,0,1);
			}
			
			Entity_FadeEffectBaseColor("LowerFloorLamp_*", newColor, 3.0f);
			Light_FadeTo("LowerFloorLamp_*", newColor, -1, 3.0f);
			Entity_FadeEffectBaseColor("LowerFloorDoorframeLamp_*", newColor, 3.0f);
			
			Lamp_SetLit("CargoRoomLockerLamp_*", false, true);
			Lamp_SetLit("CargoRoomCabinetLamp_*", false, true);
			Lamp_SetLit("CargoRoomFloorLamp_*", false, true);
			Lamp_SetLit("CargoRoomCeilingLamp_*", false, true);
		}
		
		//-------------------------------------------------------
		
		void Powerpack_UsedOnCargo()
		{
			cLux_AddDebugMessage("Used on cargo!!");
			Entity_SetActive("InteractInactiveButton_1",false);
			
			SequenceStates_Stop("Seq_PowerDownCargoAirlock");
			Seq_PowerUpCargoAirlock("");
		}
		
		cSequenceStatesData mSequenceCargoAirlockPowerUp;
		void Seq_PowerUpCargoAirlock(const tString &in asTimer)
		{
			Sequence_Begin("Seq_PowerUpCargoAirlock", mSequenceCargoAirlockPowerUp);
			
			if(Sequence_DoStepAndWait(0.3f))
			{
				Lamp_SetFlickerActive("PowerLamp_Airlock",false);
			}	
			else if(Sequence_DoStepAndWait(1.0f))
			{
				Lamp_SetLit("AirlockLight",true,true);
			}
			else if(Sequence_DoStepAndWait(0.5f))
			{
				//Lamp_SetLit("CargoAirlockDoorLight_2", true, true);
			}
			else if(Sequence_DoStepAndWait(0.5f))
			{
				Lamp_SetLit("lamp_airlock_3_*", true, true);
				Sound_CreateAtEntity("CargoAreaOn", "05_01_phi_inside/SFX/cargo_area/lights_on", "CargoAirlockLightsSoundSource");
			}
			else if(Sequence_DoStepAndWait(0.0f))
			{
				MovingButton_SetDisabled("CargoAirlock_Panel", false);
				Entity_SetInteractionDisabled("PowerpackPlugged_Cargo",false);
			}
			
			Sequence_End();
		}
		
		void Powerpack_PickedUpFromCargo()
		{
			cLux_AddDebugMessage("Picked up powerpack from cargo!!");
			
			Entity_SetActive("InteractInactiveButton_1",true);
			
			SequenceStates_Stop("Seq_PowerUpCargoAirlock");
			Seq_PowerDownCargoAirlock("");
		}
		
		cSequenceStatesData mSequenceCargoAirlockPowerDown;
		void Seq_PowerDownCargoAirlock(const tString &in asTimer)
		{
			Sequence_Begin("Seq_PowerDownCargoAirlock", mSequenceCargoAirlockPowerDown);
			
			if(Sequence_DoStepAndWait(0.5f))
			{
				MovingButton_SetDisabled("CargoAirlock_Panel", true);
			}
			else if(Sequence_DoStepAndWait(0.5f))
			{
				//Lamp_SetLit("CargoAirlockDoorLight_2", false, true);
				Lamp_SetLit("AirlockLight",false,true);
				Lamp_SetLit("lamp_airlock_3_*", false, true);
				Lamp_SetFlickerActive("PowerLamp_Airlock",true);
				Sound_CreateAtEntity("CargoAreaOff", "05_01_phi_inside/SFX/cargo_area/lights_off", "CargoAirlockLightsSoundSource");
			}			
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnInteractCargoDoor(const tString &in asEntity)
		{
			Entity_SetInteractionDisabled(asEntity,true);
			Entity_SetInteractionDisabled("PowerpackPlugged_Cargo",true);
			Map_AddTimer(asEntity,8.0f,"TimerEnableButton");
			Map_AddTimer("PowerpackPlugged_Cargo",8.0f,"TimerEnablePowerpack");
			
			if (!MovingButton_IsSwitchedOn(asEntity))
			{
				Map_AddTimer("CargoAirlockDoor_Block", 4.0f, "TimerSetEntityInactive");
			}
			else
			{
				Entity_SetActive("CargoAirlockDoor_Block",true);
			}
		}

		//-------------------------------------------------------

		void OnInteractInactiveButton(const tString &in asEntity)
		{
			Sound_CreateAtEntity("ButtonPress", "Entities_Station/object/sat_shell/button", asEntity);
			Entity_SetInteractionDisabled(asEntity,true);
			Map_AddTimer(asEntity,1.0f,"TimerEnableButton");
		}

		//-------------------------------------------------------
		
		void PlayerFoundARK()
		{
			if(mbFoundARK) return;

			mbFoundARK = true;
			
			// If we can't say it immediately, don't let it queue up over banter
			if(mbFoundAssemblyRoom)
			{
				Voice_PlayWhenPossible("1D_Cath_PlayerFoundARK_FoundAssembly", "", 4.0f, 0.5f);
			}
			else
			{
				Voice_PlayWhenPossible("1D_Cath_PlayerFoundARK_NotFoundAssembly","",4.0f, 0.5f);
			}

			ArkFoundMusic();
			
			LastOnSoma_SetText("05_01_phi_inside_2");	
		}
		
		//-------------------------------------------------------
		
		void ARK_OnPlayerLookAt(const tString &in asEntity, int alState)
		{
			if(alState==1)
				PlayerFoundARK();
		}
		
		//-------------------------------------------------------
		
		bool mbPowerToolAreasActive = true;
		
		void SetPowerToolAreasActive(bool abActive)
		{
			mbPowerToolAreasActive = abActive;
			Entity_SetActive("ToolArea_Cargo",abActive);
			Entity_SetActive("ToolArea_FrameRoom",abActive);
			Entity_SetActive("ToolArea_Lights",abActive);
			Entity_SetInteractionDisabled("PowerpackPlugged_*",!abActive);
		}
		
		//-------------------------------------------------------
		
		bool OnPickupARK(const tString &in asTool)
		{
			mbARKUnloaded = true;
			SetPowerToolAreasActive(false);
			Entity_SetActive("Ladder", false);
			Entity_SetActive("LadderArkInteract", true);
			PlayerFoundARK();
			Entity_SetInteractionDisabled("wau_flower_2", true);
			
			if(Entity_GetCollide("Player", "ArkAirlock"))
			{
				Sound_CreateAtEntity("ArkPickupRobotArm", "05_01_phi_inside/SFX/pickup_ark_robot_arm", "Player");
			}

			return true;
		}
		
		//-------------------------------------------------------
		
		bool TransportArm_Ark_Collide(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState==-1)
			{
				Entity_SetActive("TransportArm_Collider", false);
				Entity_SetActive("04_02_ark_transporter_nocollide", false);
				Entity_SetActive("04_02_ark_transporter_collide", true);
				
				return false;
			}
				
				
			return true;
		}
		
		//} End Scene 1 Event D
		
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 1 Event E *Enter assembly room*
		//{///////////////////////////////////////
		
		//-------------------------------------------------------
		 
		void PlayerFoundAssemblyRoom()
		{
			if(mbFoundAssemblyRoom) return;
			
			mbFoundAssemblyRoom = true;
			
			if (!mbARKInFrame)
				Voice_PlayWhenPossible("1E_Cath_PlayerFoundAssembly", "", 30.0f, 1.0f, "OnFinishedPlayerFoundAssembly");
			
			Entity_SetActive("Area_AssemblyRoom", false);
			Entity_SetActive("Area_EnterAssemblyRoom", false);
		}
		
		void OnFinishedPlayerFoundAssembly(const tString &in asScene, const tString &in asSubject)
		{
			if(mbFoundARK)
				Voice_PlayWhenPossible("1E_Cath_PlayerFoundAssembly_FoundARK");
			else
				Voice_PlayWhenPossible("1E_Cath_PlayerFoundAssembly_NotFoundARK");
		}
		
		bool AssemblyRoom_DoorWay(const tString &in asArea, const tString &in asEntity, int alState)
		{
			cLux_AddDebugMessage("Doorway area, state: " + alState);
			
			Entity_SetActive("Area_AssemblyRoom", alState==1);
			Banter_SetPaused(alState==1);
			return true;
		}
		
		void AssemblyRoom_OnPlayerLookAt(const tString &in asEntity, int alState)
		{
			PlayerFoundAssemblyRoom();
		}
				
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 1 Event F *Find & Datamine Catherine's Corpse*
		//{///////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbCathReactedToCorpse = false;
		bool mbKnowItsCath = false;
		
		void LineOver_Datamine_KnowItsCath(const tString &in asParent, const tString &in asChild, int alState, bool abStart)
		{
			if (!abStart)
				return;
				
			mbKnowItsCath = true;
		}
		
		void Datamine_CathDone(const tString &in asScene, const tString &in asSubject)
		{
			cLux_AddDebugMessage("CathDone");
			if(mbKnowItsCath && (!mbCathReactedToCorpse) )
			{
				Map_AddTimer("TalkWithCathOnCorpse", 2.0f, "Timer_TalkWithCathOnCorpse");
				Map_AddTimer("CathDatamineMusic", 5.0f, "CathDatamineMusic");
				Banter_SetPaused(true);
				Banter_SeenBody();
				mbCathReactedToCorpse = true;
			}				
		}
		
		void Timer_TalkWithCathOnCorpse(const tString &in asTimer)
		{
			Voice_Play("1F_Cath_ReactToCorpse", -1.0f, "TalkWithCathOnCorpse_DoneTalking");
		}
		
		void TalkWithCathOnCorpse_DoneTalking(const tString &in asSubjectName, const tString& in asSubject)
		{
			Banter_SetPaused(false);
		}
		
		//}End Scene 1 Event F
		
		
		
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 1 Event G *Load ARK in SatFrame*
		//{///////////////////////////////////////
		
		//-------------------------------------------------------
		bool mbARKInFrame = false;
		bool mbSatFrameRoomPowered = false;
		bool mbARKShellOpen = true;
		
		eSatFrameState mSatFrameState = eSatFrameState_Empty;

		//-------------------------------------------------------
		
		void SetupSatFrame()
		{
			Entity_PlayAnimation("SatFrameShell", "open_state", 0.1f, true);
			MovingButton_SetDisabled("ARKButton",true);
			Entity_SetEffectsActive("ARKButton",false,false);
			Entity_SetActive("SatFrame_Interact",true);
			SwitchSatFramePower(false);
		}
		
		//-------------------------------------------------------
		bool mbPayloadMusic = false;
		void OnARKButtonInteract(const tString &in asEntity, int alState)
		{
			
			if (alState!=1)
				return;
				
			Sound_CreateAtEntity("ButtonPress", "Entities_Station/object/sat_shell/button", asEntity);
			Entity_SetInteractionDisabled("ARKButton",true);
			Entity_SetActive("SatFrame_Interact",false);
			if (!mbARKShellOpen)
			{
				Entity_PlayAnimation("SatFrameShell", "open", 0.1f, false, true, "OnARKOpen");
				Sound_CreateAtEntity("SatFrameOpenEmpty", "05_01_phi_inside/SFX/satellite_shell/payload_bay_opening_empty", "ArkLoadingSoundSource");
				Sound_CreateAtEntity("ButtonOpen", "Entities_Station/object/sat_shell/open", asEntity);
				Sound_Stop("SatFrameCloseEmpty", 1.0f);
				mbARKShellOpen = true;
			}
			else
			{
				if(mbARKInFrame==false)
				{
					Sound_CreateAtEntity("SatFrameCloseEmpty", "05_01_phi_inside/SFX/satellite_shell/payload_bay_closing_empty", "ArkLoadingSoundSourceSource");
					Sound_CreateAtEntity("ButtonEmpty", "Entities_Station/object/sat_shell/empty", asEntity);
					Sound_Stop("SatFrameOpenEmpty", 1.0f);
				}
				else if(mbARKInFrame==true)
				{
					Sound_CreateAtEntity("ButtonFull", "Entities_Station/object/sat_shell/full", asEntity);
					Sound_CreateAtEntity("SatFrameCloseFull", "05_01_phi_inside/SFX/satellite_shell/payload_bay_closing", "ArkLoadingSoundSource");
				}
				Entity_PlayAnimation("SatFrameShell", "close", 0.1f, false, true, "OnARKClosed");
				mbARKShellOpen = false;
				if (mSatFrameState == eSatFrameState_Inserted)
					mSatFrameState = eSatFrameState_Closing;
			}
		}
		
		//-------------------------------------------------------
		
		void OnARKOpen(const tString &in asEntityName, const tString &in asAnimName)
		{
			cLux_AddDebugMessage("ARK Open");
			Entity_PlayAnimation("SatFrameShell", "open_state", 0.1f, true);
			Entity_SetInteractionDisabled("ARKButton",false);
			Entity_SetActive("SatFrame_Interact",true);
		}
		
		//-------------------------------------------------------
		void OnARKClosed(const tString &in asEntityName, const tString &in asAnimName)
		{
			cLux_AddDebugMessage("ARK Closed");
			Entity_PlayAnimation("SatFrameShell", "closed_state", 0.1f, true);
			Entity_SetInteractionDisabled("ARKButton",false);
			
			if (!mbARKShellOpen)
			{
				if (mSatFrameState == eSatFrameState_Closing)
				{
					mSatFrameState = eSatFrameState_Closed;
					cLux_AddDebugMessage("Ark in place - starting load sequence");
					MovingButton_SetDisabled("ARKButton",true);
					Entity_SetActive("ArkInFrame",false);
					Seq_LoadSatFrame("");
				}
			}
		}
		
		//-------------------------------------------------------
		bool mbSatFrameRoomPowerOnFirstTime = true;
		void Powerpack_UsedOnSatFrameRoom()
		{
			cLux_AddDebugMessage("Used on SatFrame room door!");
			Entity_FadeEffectBaseColor("lamp_sat_prep_low_power_*", cColor(0.475, 0.976, 1, 1), 1);
			Entity_FadeEffectBaseColor("lamp_sat_prep_power_indicator_*", cColor(0, 1, 0, 1), 1);
			Entity_SetInteractionDisabled("PowerpackPlugged_SatFrameRoom",false);
			
			SwitchSatFramePower(true);
			
			if(mbSatFrameRoomPowerOnFirstTime==true)
			{
				//first time power sound
				Sound_CreateAtEntity("SatFrameRoomPowerOn", "05_01_phi_inside/SFX/room_power/bullet_room/power_up", "Player");
				Sound_Stop("SatFrameRoomPowerOff", 1.0f);
			}
			else if(mbSatFrameRoomPowerOnFirstTime==false)
			{
				//not first time power on sound
				Sound_CreateAtEntity("SatFrameRoomPowerOn", "05_01_phi_inside/SFX/room_power/bullet_room/second_power_up", "Player");
				Sound_Stop("SatFrameRoomPowerOff", 1.0f);
			}			
		}

		//-------------------------------------------------------
		
		void Powerpack_PickedUpFromSatFrameRoom()
		{
			cLux_AddDebugMessage("Picked up powerpack from frame room door!");
			
			SequenceStates_Stop("Seq_PowerUpSatFrameRoom");
			SwitchSatFramePower(false);
			
			if(mbSatFrameRoomPowerOnFirstTime==true)
			{
				//turn off
				Sound_CreateAtEntity("SatFrameRoomPowerOff", "05_01_phi_inside/SFX/room_power/bullet_room/power_down", "Player");
				Sound_Stop("SatFrameRoomPowerOn", 1.0f);
				mbSatFrameRoomPowerOnFirstTime = false;
			}
			else if(mbSatFrameRoomPowerOnFirstTime==false)
			{
				//turn off quickly
				Sound_CreateAtEntity("SatFrameRoomPowerOff", "05_01_phi_inside/SFX/room_power/bullet_room/second_power_down", "Player");
				Sound_Stop("SatFrameRoomPowerOn", 1.0f);
			}
		}
		
		//-------------------------------------------------------
		void SwitchSatFramePower(bool abOn)
		{
			Lamp_SetFlickerActive("PowerLamp_SatFrame",!abOn);
			Lamp_SetLit("lamp_satprep_*", abOn, true);
			Lamp_SetLit("LampSatFrameWarning_*",!abOn,true);
			MovingButton_SetDisabled("ARKButton", ! (abOn&&(mSatFrameState == eSatFrameState_Inserted)) );
			Entity_SetEffectsActive("ARKButton",abOn,true);
			mbSatFrameRoomPowered = abOn;
			Terminal_SetGuiActive("TerminalSatFrame", abOn);
		}
		
		//-------------------------------------------------------

		bool CanUseARK(const tString &in asTool, const tString &in asEntity)
		{
			if (asEntity=="SatFrame_Interact")
				return true;
			return false;
		}

		//-------------------------------------------------------
		bool OnUseARK(const tString &in asTool, const tString &in asEntity)
		{
			if (asEntity=="SatFrame_Interact")
			{
				cLux_AddDebugMessage("Use ARK on SatFrame");
				Entity_SetActive("ARKInFrame",true);
				Player_RemoveTool("ARK");
				MovingButton_SetDisabled("ARKButton",!mbSatFrameRoomPowered);
				mSatFrameState = eSatFrameState_Inserted;
				SetPowerToolAreasActive(true);
				Entity_SetActive("Ladder", true);
				Entity_SetActive("LadderArkInteract", false);
				Sound_CreateAtEntity("InsertArk","05_01_phi_inside/SFX/satellite_shell/payload_ark_insert", "ARKInFrame");
				mbARKInFrame = true;
				Entity_SetInteractionDisabled("wau_flower_2", false);
				return false;
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		bool mbPlayedFirstArkLadderLine = false;
		
		void OnInteractLadderWithArk(const tString &in asEntity)
		{
			if (!mbPlayedFirstArkLadderLine)
			{
				mbPlayedFirstArkLadderLine = true;
				Voice_Play("Ark_NoClimb_First");
			}
			else
			{
				Voice_Play("Ark_NoClimb");
			}
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceLoadSatFrame;
		void Seq_LoadSatFrame(const tString &in asX)
		{
			Sequence_Begin("Seq_LoadSatFrame", mSequenceLoadSatFrame);
			
			if(Sequence_DoStepAndWait(2.0f))
			{
				SlideDoor_SetOpenAmount("ARKDoor",1.0f);
			}
			else if(Sequence_DoStepAndPause(0.1f))
			{
				if(Voice_SceneIsActive("CathAndSimon"))
					Voice_Stop("CathAndSimon");
				
				Dialog_Begin();
					Dialog_AddBranch("");
						Dialog_AddSubject("1G_Cath_ShellIsSetUp");
				Dialog_End();
			}
			else if (Sequence_DoStepAndWait(0.7f))
			{
				//Delay for simon saying "lock and load"
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Sound_CreateAtEntity("SatFrameMoving", "05_01_phi_inside/SFX/satellite_shell/payload_bay_moving", "ArkLoadingSoundSource");
			}
			else if (Sequence_DoStepAndPause(0.5f))
			{
				cLux_AddDebugMessage("Start shell moving forwards.");
				mSatFrameState = eSatFrameState_InTransit;
				Area_MoveLinearTo("SatFrameMover", "SatFrameTarget", 1.0f, 1.0f, 0.5f, true, "SatFrame_ReachedGoal");
			}
			else if (Sequence_DoStepAndWait(4.0f))
			{
				SlideDoor_SetOpenAmount("ARKDoor",0.0f);
			}
			else if (Sequence_DoStepAndWait(8.0f))
			{
				Entity_SetActive("SatFrameShell", false);
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				// Shell reaches gun position
				mSatFrameState = eSatFrameState_AtDest;
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void LineOver_SatFrameReady(const tString &in asParent, const tString &in asChild, int alState, bool abStart)
		{
			if (abStart)
				return;
			SequenceStates_Resume("Seq_LoadSatFrame");
            
            if(mbPayloadMusic==false)
            {
                Music_Play("05_01_loading_the_ark", 0.75f, false, eMusicPrio_BigEvent);
                mbPayloadMusic = true;
            }
            
		}
		
		//-------------------------------------------------------
		
		void SatFrame_ReachedGoal(const tString& in asAreaName)
		{
			cLux_AddDebugMessage("Shell goes through airlock and shitz");
			
			Entity_SetActive("Area_PlayerGetsCloseToCathAfterARKLoad", true);
			
			SequenceStates_Resume("Seq_LoadSatFrame");
		}
			
		//-------------------------------------------------------
		
		void OnTerminalSatFrame(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("05_01_phi_inside");
					
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();

			ImGui_GroupBegin(cVector3f_Zero, ImGui_GetSize());
			
				tString sMsg = "SatFrameEmpty";
				cStationGui_BigStatusMessageSettings settings;
				settings.mColor = gStationGuiColor_Warning2;
				settings.mfTextSizeMul = 1.75;
				
				switch (mSatFrameState)
				{
					case eSatFrameState_Inserted:
						sMsg = "SatFrameInserted";
						settings.mColor = gStationGuiColor_Normal;
						settings.mfTextSizeMul = 1.5;
						break;
					case eSatFrameState_Closing:
						sMsg = "SatFrameClosing";
						settings.mColor = gStationGuiColor_Warning;
						break;
					case eSatFrameState_Closed:
						sMsg = "SatFrameInsertedAndClosed";
						settings.mColor = gStationGuiColor_Highlight;
						settings.mfTextSizeMul = 1.5;
						break;
					case eSatFrameState_InTransit:
						sMsg = "SatFrameInTransit";
						settings.mColor = gStationGuiColor_Highlight2;
						break;
					case eSatFrameState_AtDest:
						sMsg = "SatFrameOutside";
						settings.mColor = gStationGuiColor_Highlight;
						break;
				}
				
				StationGui_BigStatusMessage(sMsg, settings);
			
			ImGui_GroupEnd();
		}
		
		//-------------------------------------------------------
		
		//}End Scene 1 Event G
	
	//}End Scene 1
	
	//-------------------------------------------------------

	/////////////////////////////////////////
	// ==============
	// Scene 2' *Conversation with Cath, exit to dome*
	// ==============
	//{///////////////////////////////////////

	//-------------------------------------------------------
	
		/////////////////////////////////////////
		// Scene 2 Event A *Arrive at Cath terminal*
		//{///////////////////////////////////////
		
		//-------------------------------------------------------

		bool Collide_PlayerGetsCloseToCath(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState==1)
			{
				Banter_Stop();
				
				Dialog_Begin();
					Dialog_AddBranch("");
						if(Voice_SceneIsActive("CathAndSimon"))
							Voice_Stop("CathAndSimon");
							
						Dialog_AddSubject("2A_Cath_SimonArrivesAfterSettingUpShell","SimonArrivesAfterSettingUpShell_DoneTalking");
				Dialog_End();
			}
			
			return false;
		}
		
		void SimonArrivesAfterSettingUpShell_DoneTalking(const tString &in asSubjectName, bool abStartOfSubject)
		{
			if(abStartOfSubject) return;
			
			Map_AddTimer("TerminalCathFace", 0.5f, "TimerTurnOffTerminal");
			Entity_SetInteractionDisabled("cath_terminal_1",true);
			Entity_SetActive("ToolArea_TransferTerminal",false);
			Entity_SetEffectsActive("CathCamera",false,true);
			//HeadTracker_SetActive("CathCamera",false);
			Map_AddTimer("", 1.0f, "TimerPopUpCathBox");
		}
		
		//}End Scene 2 Event A
		
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 2 Event E *Exit through Airlock to Space Gun*
		//{///////////////////////////////////////
		
		bool mbAirlockFilled = false;
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceSpaceGunAirlockFill;
		void Seq_AirlockSpaceGunFill(const tString &in asTimer)
		{
			Sequence_Begin("Seq_AirlockSpaceGunFill", mSequenceSpaceGunAirlockFill);

			if(Sequence_DoStepAndWait(2))
			{
				Entity_SetVarString("AirlockSpaceGunControlScreen", "State", "Closing");
				MovingButton_SetSwitchedOn("DoorAirlockSpaceGun_Inner_Panel", false, true);
				Entity_SetActive("DoorAirlockSpaceGun_Block_Inner", true);
				MovingButton_SetLocked("DoorAirlockSpaceGun_Inner_Panel", true, true);
				
				Terminal_SetUpdateWhenOutOfView("AirlockSpaceGunControlScreen", true);
				Lamp_SetLit("airlock_2_flood_lamp_*", true, true);
				Lamp_SetLit("airlock_2_lamp_*", false, false);
			}
			else if(Sequence_DoStepAndWait(2))
			{
				Entity_SetActive("DoorAirlockSpaceGun_Block", true);
				Sound_CreateAtEntity("BellRing", "Entities_OceanBottom/airlock/alarms/filling_alarm", "DomeAirlockAlarmSource");
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Entity_SetActive("DoorAirlockSpaceGun_Block_Inner", false);
			}
			else if(Sequence_DoStepAndWait(2.5))
			{
				Entity_SetVarString("AirlockSpaceGunControlScreen", "State", "Filling");
				Entity_PlayAnimation("airlock_warning_lamp_dome", "spin", 0, true, true);
		        Lamp_SetLit("airlock_warning_lamp_dome", true, true);
				Sound_CreateAtEntity("DomeAirlockFlushingAlarm", "Entities_OceanBottom/airlock/alarms/draining_alarm", "DomeAirlockAlarmSource", 0, true);
				Map_AddTimer("DomeAirlockAlarm", 1.0f, "DomeAirlockAlarm");
			}
			else if(Sequence_DoStepAndWait(2.5))
			{
				//Sound
				Sound_CreateAtEntity("DomeAirlockPumpWater_Air", "Entities_OceanBottom/airlock/air/pump/pump_loop", "DomePumpSource");
				Sound_CreateAtEntity("DomeAirlockFillingSweetener", "05_01_phi_inside/SFX/phi_airlock/airlock_pump_filling_sweet", "AirlockSweetenerSoundSource");
				ParticleSystem_SetActive("airlock_2_fill_effects_*", true);
				Map_AddTimer("DestoryAirlockFillEffects", 10.0f, "DestoryAirlockFillEffects");
			}
			else if (Sequence_DoStepAndWait(1))
			{
				DomeAirlockEffectsFillWithWater();
			}
			else if (Sequence_DoStepAndPause())
			{
				Entity_SetActive("Airlock2Water", true);
				Map_AddEnvironmentParticleClipArea("*", "Airlock2Water");

				LiquidArea_MoveLinearTo("Airlock2Water","Airlock2Water_Target_Fill",0.1, 0.5, 0.5, false, "SpaceGunAirlock_OnFlood");
			}
			else if (Sequence_DoStepAndWait(5))
			{
				Entity_SetActive("Airlock2Water", false);
				Map_RemoveEnvironmentParticleClipArea("*", "Airlock2Water");
				Terminal_FadeImGuiStateFloat("AirlockSpaceGunControlScreen", "PressureMul", 1.0f, 10);
				ParticleSystem_Destroy("airlock_2_jet_effects_*"); 
			}
			else if (Sequence_DoStepAndWait(4))
			{
				SetPlayerIsUnderwater(true, 1.0f, true);
				Map_SetUnderwater(true);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Entity_SetVarString("AirlockSpaceGunControlScreen", "State", "Opening");
				MovingButton_SetLocked("DoorAirlockSpaceGun_Outer_Panel", false, true);
				MovingButton_SetSwitchedOn("DoorAirlockSpaceGun_Outer_Panel", true, true);
				Entity_SetActive("DoorAirlockSpaceGun_Block",true);
				Entity_StopAnimation("airlock_warning_lamp_dome");
				Lamp_SetLit("airlock_warning_lamp_dome", false, false);
				Map_RemoveTimer("DomeAirlockAlarm");
			}
			else if (Sequence_DoStepAndWait(1.0f))
			{
				Entity_SetVarString("AirlockSpaceGunControlScreen", "State", "Idle");
				
				Terminal_SetUpdateWhenOutOfView("AirlockSpaceGunControlScreen", false);
				
				mbAirlockFilled = true;
				Entity_SetActive("ToolArea_AirlockSpaceGun",true);
				Entity_SetInteractionDisabled("AirlockSpaceGunControlPanel", false);
				Button_SetSwitchedOn("AirlockSpaceGunControlPanel",false,true);
				
				Game_AutoSave();
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void SetUpDomeAirlockBlocker()
		{
			Entity_SetActive("DoorAirlockSpaceGun_Block_Inner",true);
		}

		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceEntranceAirlockEmpty;
			
		void Seq_AirlockSpaceGunEmpty(const tString &in asTimer)
		{
			Sequence_Begin("Seq_AirlockSpaceGunEmpty", mSequenceEntranceAirlockEmpty);
			
			if (Sequence_DoStepAndWait(2))
			{
				cLux_AddDebugMessage("Airlock activated");
				Terminal_SetUpdateWhenOutOfView("AirlockSpaceGunControlScreen", true);
				
				MovingButton_SetLocked("DoorAirlockSpaceGun_Outer_Panel", true, true);
				MovingButton_SetSwitchedOn("DoorAirlockSpaceGun_Outer_Panel", false, true);
				
				Entity_SetVarString("AirlockSpaceGunControlScreen", "State", "Draining");
			}
			else if (Sequence_DoStepAndWait(2.6))
			{
				//Sound
				cLux_AddDebugMessage("Airlock draining start in 2.5");
				Sound_CreateAtEntity("Intro_AirlockFlushingAlarm", "Entities_OceanBottom/airlock/alarms/draining_alarm", "DomeAirlockAlarmSource", 0, true);
				Map_AddTimer("DomeAirlockAlarm", 1.0f, "DomeAirlockAlarm");
				
				Entity_PlayAnimation("airlock_warning_lamp_dome", "spin", 0, true, true);
		        Lamp_SetLit("airlock_warning_lamp_dome", true, true);
			}
			else if (Sequence_DoStepAndWait(7))
			{
				StartingAirlockEffectsFlushWater();
				LiquidArea_MoveLinearTo("Airlock2Water","Airlock2Water_Target_Drain",0.1, 0.5, 0.5, false);
				Entity_SetActive("Airlock2Water", true);
				Map_AddEnvironmentParticleClipArea("*", "Airlock2Water");
				Terminal_SetImGuiStateFloat("AirlockSpaceGunControlScreen", "PressureMul", 1.0f);
				Terminal_FadeImGuiStateFloat("AirlockSpaceGunControlScreen", "PressureMul", 0.0f, 10);
				Effect_Shake_Start(0.005, 0, 0.1, 5);
				ParticleSystem_SetActive("airlock_2_drain_bubbles_oneshot", true);
				Sound_CreateAtEntity("Intro_AirlockFlushingBubblesSweet", "Entities_OceanBottom/airlock/uw/water/drain/large_bubbles_sweet", "Player", 0, true);
			}
			else if (Sequence_DoStepAndWait(3))
			{
				Effect_Shake_Start(0.0005, 0, 0.1, 5);
				ParticleSystem_Destroy("airlock_2_flood_effects_*");
			}
			else if (Sequence_DoStepAndWait(6))
			{
				mlDrainShakeID = Effect_Shake_Start(0.0025, -1, 1, 3, cVector3f_One, 4);
				ParticleSystem_SetActive("airlock_2_drain_effects_*", true);
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				Map_SetUnderwater(false);
				cLux_AddDebugMessage("Map not underwater");
				Effect_Shake_FadeOut(mlDrainShakeID, 4);
				ParticleSystem_Destroy("airlock_2_drain_effects_3");
				ParticleSystem_Destroy("airlock_2_drain_effects_1");
			}
			else if (Sequence_DoStepAndWait(7))
			{
				ParticleSystem_Destroy("airlock_2_drain_effects_*");
			}
			else if(Sequence_DoStepAndWait(1.0f))
			{
				Entity_StopAnimation("airlock_warning_lamp_dome");
				Lamp_SetLit("airlock_warning_lamp_dome", false, false);
				MovingButton_SetLocked("DoorAirlockSpaceGun_Inner_Panel", false, true);
				MovingButton_SetSwitchedOn("DoorAirlockSpaceGun_Inner_Panel", true, true);
				Map_RemoveTimer("DomeAirlockAlarm");
				Map_AddTimer("DoorAirlockSpaceGun_Block", 4.0f, "TimerSetEntityInactive");
			}
			else if(Sequence_DoStepAndWait(0.0f))
			{
				Entity_SetVarString("AirlockSpaceGunControlScreen", "State", "Opening");
				Lamp_SetLit("airlock_2_flood_lamp_*", false, false);
				Lamp_SetLit("airlock_2_lamp_*", true, true);
				
				Entity_SetVarString("AirlockSpaceGunControlScreen", "State", "Idle");
				Terminal_SetUpdateWhenOutOfView("AirlockSpaceGunControlScreen", false);
				
				Entity_SetActive("ToolArea_AirlockSpaceGun",true);
				Entity_SetInteractionDisabled("AirlockSpaceGunControlPanel", false);
				Button_SetSwitchedOn("AirlockSpaceGunControlPanel",false,true);
			
				mbAirlockFilled = false;
			}
			
			Sequence_End();
		}
		
