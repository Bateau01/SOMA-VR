	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		//////////////////////////////////////////////////////////
		// Important! Don't remove
		if (mbEscSkipsCredits)
		{
			if (alAction == eAction_OpenMenu)
			{
				// Skip the credits
				SequenceStates_Resume("Seq_TheEnd");
			}
		}

		/////////////////////////////////////////////////////////
		// Debug Below
		if(alAction == eAction_Test1)
		{
			SetPlayerIsUnderwater(true, 1.0f, true);
			Map_SetUnderwater(true);
		}
		
		if(alAction == eAction_Test2)
		{
			LineOver_Final_Catherine("","",1,false);
		}
		
		if(alAction == eAction_Test3)
		{
			MovingButton_SetLocked("DoorAirlockSpaceGun_Inner_Panel",false,true);
		}
		
		//Test elevator
		if(alAction == eAction_Test4)
		{
			MovingButton_SetLocked("DoorAirlockSpaceGun_Outer_Panel", false, true);
			MovingButton_SetSwitchedOn("DoorAirlockSpaceGun_Outer_Panel", true, true);
		}
		if(alAction == eAction_Test5)
		{
			cLux_AddDebugMessage("Give ARK");
			
			Entity_SetActive("ARK", false);
			
			Entity_PlaceAtEntity("ARK", "Player", cVector3f(0,2,0), false);
			
			Entity_SetActive("ARK", true);
			Entity_SetActive("ARK", false);
			Entity_SetActive("ARK", true);
			cLux_GetCurrentMap().GetEntityByName("ARK").GetMainBody().Enable();
		}
		
		if(alAction == eAction_Test6)
		{
			cLux_AddDebugMessage("Ark in shell");
			
			//Entity_PlaceAtEntity("ARK", "Area_DebugARKTeleport", cVector3f_Zero, false);
			mbARKInShell = true;
			
			Entity_SetInteractionDisabled("LaunchButton", false);
			Terminal_SetGuiActive("TerminalLaunch_*", true);
			Entity_SetActive("Area_ScanChair", true);
		}
		
		if(alAction == eAction_Test7)
		{
			CathTool_AllowDetach("CathBoxTool");
			mTransferState = eTransferState_CathReturned;
			
			//mbCathDead = true;
			mbARKLaunched = true;
			Terminal_SetGuiActive("TerminalLaunch_*", true);
		}
		
		if(alAction == eAction_Test8)
		{
			Seq_LoaderArmControlsEnter("");
			//PlayerHands_SetHandModel_DeepSeaMutilated();
			//PlayerHands_PlayAnimation("event_examine_mutilated_hand_start");
		}
		
		if (alAction == eAction_Test9)
		{
			Seq_WakeUpAfterScan("");
		}
		
		if (alAction == eAction_Test0)
		{
			Seq_TheEnd("");
		}
	}
	
	void TimerDisableLamp(const tString &in asTimer)
	{
		Entity_SetActive(asTimer, false);
	}
	
	// Need to disable the airlock button to stop spamming the airlock door
	void OnInteractAirlockButton(const tString &in asEntity)
	{
		if (MovingButton_IsLocked(asEntity))
			return;
			
		if (!MovingButton_IsSwitchedOn(asEntity))
		{
			Map_AddTimer("DoorAirlockSpaceGun_Block", 4.0f, "TimerSetEntityInactive");
		}
		else
		{
			Entity_SetActive("DoorAirlockSpaceGun_Block",true);
		}
			
		Entity_SetInteractionDisabled(asEntity,true);
		Map_AddTimer(asEntity,8.0f,"TimerEnableButton");
	}
	
	//-------------------------------------------------------
	
	void TimerEnableButton(const tString&in asEntity)
	{
		Entity_SetInteractionDisabled(asEntity,false);
	}
	
	//-------------------------------------------------------
	
	void TimerEnablePowerpack(const tString&in asEntity)
	{
		if (mbPowerToolAreasActive)
			Entity_SetInteractionDisabled(asEntity,false);
	}
	
