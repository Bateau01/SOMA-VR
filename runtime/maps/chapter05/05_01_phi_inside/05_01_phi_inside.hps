		//-------------------------------------------------------
		
		void InteractScanChair(const tString &in asEntity)
		{
			EyeTracking_SetExtendedViewMul(0.07);
			//////////////////////////////////////////////
			// Player sits down after interacting with chair
			CameraAnimation_Begin("SitAnim", "", false);

			Sound_CreateAtEntity("sound_sit_down", "05_01_phi_inside/SFX/pilot_control_chair/pilot_control_chair_seat_sitdown", asEntity, 0, false);
			
			//Preload big sequence
			Sound_PreloadGroup("05_01_phi_inside/SFX/spacegun_sequence/", true);
			
			Entity_SetActive("Area_ScanChair",false);
			Sound_FadeGlobalVolume(0.65, 3.0f);
			
			Map_AddTimer("TimerKillObjects",2.0f,"TimerKillObjects");
		}
		
		//-------------------------------------------------------
		
		void TimerKillObjects(const tString& in asName)
		{
			array<iPhysicsBody@> vBodies;
			iLuxEntity@ pArea = Map_GetEntity("AreaKillObjects");
			cBoundingVolume@ pVol = pArea.GetMainBody().GetBoundingVolume();
			cLux_GetCurrentMap().GetPhysicsWorld().GetBodiesInAABB(pVol.GetMin(), pVol.GetMax(), vBodies);
		
			for(int i=0;i<vBodies.length();++i)
			{
				iPhysicsBody@ pBody = vBodies[i];
				if (pBody.GetMass()==0)
					continue;
				Entity_SetActive(Body_GetEntityName(pBody.GetName()),false);
			}
		}
		
		//-------------------------------------------------------
		
		bool CamAnim_Sit(const tString &in asEntity, int alDirection)
		{
			if (asEntity=="SitAnim_4")
			{
				Entity_SetActive("SimonLegs",true);
				
				if (mbArmGone)
				{
					Entity_SetActive("FinalHandsMutilated", true);
					Entity_PlayAnimation("FinalHandsMutilated", "event_talk_to_cath_5_1",0.0f,true,false,"");
					Entity_SetAnimationPaused("FinalHandsMutilated", "event_talk_to_cath_5_1", true);
				}
				else
				{
					Entity_SetActive("FinalHandsNormal", true);
					Entity_PlayAnimation("FinalHandsNormal", "event_talk_to_cath_5_1",0.0f,true,false,"");
					Entity_SetAnimationPaused("FinalHandsNormal", "event_talk_to_cath_5_1", true);
				}
				
			}

			return true;
		}

		bool EventPlayerSits(const tString &in asEntity, int alDirection)
		{
			iLuxEntity @pShell = Map_GetEntity("GunShell");
			pShell.WakeUp();
			pShell.SetAutoSleep(false);
			
			// Turn off flashlight
			Player_SetFlashlightActive(false,true);
			
			TurnOnOutsideLights();
			
			Dialog_Begin("");
				Dialog_AddBranch("");
					Dialog_AddSubject("3A_Cath_PlayerSitsOnPilotSeat", "Cath_PlayerSitsOnPilotSeat_OnDoneTalking");
			Dialog_End();
			return false;
		}
		
		void LineOver_CathActivateSeat(const tString &in asParent, const tString &in asChild, int alState, bool abStart)
		{	
			Map_AddTimer("TimerActivateSeat",2.5f,"TimerActivateSeat");
		}
		
		void TimerActivateSeat(const tString& in asName)
		{
			CameraAnimationNode_SetAutoMove("SitAnim_6",1.0f);
			TurnOnLoadingCrane();
		
			Entity_AttachToEntity("player","pilot_seat", "", true, true);
			Prop_AlignRotation("pilot_seat", "pilot_seat_target", 1, 1.5, 1, true);
			Prop_MoveLinearTo("pilot_seat", "pilot_seat_target", 1, 1.5, 1, true);
			Entity_SetEffectsActive("TerminalLaunch_Screen2", true, true);
			Terminal_SetGuiActive("TerminalLaunch_Screen2", true, 0.25f);
			
			Map_AddTimer("ApparatusArmTimer", 2.0f, "MoveApparatusArm");
			
			Sound_PreloadGroup("05_01_phi_inside/SFX/spacegun_sequence", true);
			
			//Sound for pilot seat
			Sound_CreateAtEntity("PilotSeatStartup", "05_01_phi_inside/SFX/pilot_control_chair/pilot_control_chair_seat_startup", "Player");
			Sound_CreateAtEntity("PilotSeatMonitors", "05_01_phi_inside/SFX/pilot_control_chair/pilot_control_chair_seat_monitors", "ScreenSpinSoundSource");
		}
		
		void MoveApparatusArm(const tString &in)
		{
			Prop_AlignRotation("pilot_seat_apparatus_arm", "pilot_seat_apparatus_arm_target", 2, 2, 2, true);
			Prop_MoveLinearTo("pilot_seat_apparatus_arm", "pilot_seat_apparatus_arm_target", 2, 3, 2, true);
		}
		
		void TurnOnLoadingCrane()
		{
		    Lamp_SetLit("CraneGrid_Normal", true, true);
			Lamp_SetLit("CraneGrid_Selected", false, false);
		    Entity_SetActive("POVMarker_Normal", true);
			Entity_SetActive("POVMarker_Normal", false);
			Lamp_SetLit("ClawBar_lamp_*", true, true);
			Lamp_SetLit("ClawBase_lamp_*", true, true);
		}
		
		void TurnOffLoadingCrane()
		{
		    Lamp_SetLit("CraneGrid_Normal", false, false);
			Lamp_SetLit("CraneGrid_Selected", false, false);
		    Entity_SetActive("POVMarker_*", false);
			Lamp_SetLit("ClawBar_lamp_*", false, false);
			Lamp_SetLit("ClawBase_lamp_*", false, false);
			Light_FadeTo("hatch_position_billboard_light",cColor(0.0,0.0,0.0,0.0),4.5,0.75);
		}
		
		void TurnOnOutsideLights()
		{
			Lamp_SetLit("LampOutsideEnd*",true, false);
			Lamp_SetLit("LampOutside_*",true,true);
			Map_AddTimer("1",1.0f,"TimerLightUpSpaceGun");
		}
		
		void TurnOffOutsideLights()
		{
			Lamp_SetLit("LampOutsideEnd*",false, false);
			Lamp_SetLit("LampOutside_*",false,false);
		}
		
		void TurnOffScanChairLights()
		{
		    Lamp_SetLit("scanchair_lamp_*", false, false);
		}
		
		void TurnOffGunLights()
		{
		    Lamp_SetLit("space_gun_red_lamp_*", false, false);
			Light_FadeTo("spotlight_highlight_gun",cColor(0,0,0,0),1.5,0.75);
		}
		
		void Cath_PlayerSitsOnPilotSeat_OnDoneTalking(const tString &in asSubjectName, bool abStartOfSubject)
		{
			if(abStartOfSubject) return;
			
			cLux_AddDebugMessage("Player on seat: Done talking");
			
			if (!mbARKInShell)
				Seq_LoaderArmControlsEnter("");
			else
			{
				Seq_Launch("");
				Seq_CathAndSimonUpload("");
			}
		}
			
		//--------------------------------------------------------------
		
		bool mbControllingLoaderArm = false;
		bool mbLoaderArmPickedUpShell = false;
		cVector3f mvLoaderArmOffset = cVector3f_Zero;
		cPlanef mLoaderArmControlPlane;		
		cVector3f mvLoaderArmPickPos = cVector3f_Zero;
		cVector3f mvLoaderArmCurrentPos = cVector3f_Zero;
		eLoaderArmState mArmState = eLoaderArmState_Moving;
		cVector3f mvLoaderArmTarget = cVector3f_Zero;
		tString msLoaderArmTargetCallback = "";
		bool mbInteractKeyDown = false;
		bool mbZoomKeyDown = false;
		
		tString msLoaderPickedEntity="";
		
		void SetUpLoaderArm()
		{
			mvLoaderArmPickPos = Map_GetEntity("Claw").GetPosition();
			mvLoaderArmPickPos.y = gfLoaderArmPlaneY;
	
			mvLoaderArmCurrentPos = mvLoaderArmPickPos;
			
			mLoaderArmControlPlane.FromNormalPoint(cVector3f_Up, cVector3f(0,gfLoaderArmPlaneY,0));
			
			msLoaderNumSrc = "";
			for (int i=0;i<500;++i)
			{
				msLoaderNumSrc+=cMath_RandRectl(0,9)+" ";
			}
		}

		
		/////////////////////////////////////////////////
		// Custom control callbacks
		//{
		bool LoaderArm_Look(const cVector2f &in avLookAmount)
		{
			cCamera@ pCam = cLux_GetPlayer().GetCamera();
			pCam.AddPitch(avLookAmount.y);
			pCam.AddYaw(avLookAmount.x);
		
			return false;
		}
		
