	//-------------------------------------------------------

	/////////////////////////////////////////
	// Terminal INFO
	//{///////////////////////////////////////

	//-------------------------------------------------------

	tString msMapPartInFocus = "";

	//-------------------------------------------------------

	void TerminalInfo(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("05_01_phi_inside");
				
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		bool bBackVisible = true;
		bool bTaskbarVisible = true;
		
		switch(StationGui_GetActiveApp())
		{
			case -1:
				StationGui_AddApp("InfoAreaMap", true, true);
				StationGui_AddApp("InfoLaunchMechanism", true, true);
				StationGui_AddApp("InfoCargoTransportStatus", true, true);
				StationGui_AddApp("InfoStaffActivity", true, true);
				StationGui_AddApp("InfoLaunchHistory", true, true);
				StationGui_MainMenu();
				bBackVisible = false;
			break;
			case 0:
				InfoMap();
			break;
			case 1:
				InfoLaunchMech(afTimeStep);
				bTaskbarVisible = false;
			break;
			case 2:
				InfoCargo();
			break;
			case 3:
				InfoStaff();
			break;
			case 4:
				InfoLaunchHist();
			break;
		}
		
		if (bTaskbarVisible)
			StationGuiBG_Taskbar("phi");
		
		if (StationGui_BackButton(bBackVisible))
		{
			//////////////////////
			//Reset Space Gun slideshow
			if(mlSlideNumber >= 1) HideSlides();
		}
	}
	
	//------------------------------------------------------------
	// InfoMap
	//------------------------------------------------------------

	void InfoMap()
	{	
		ImGui_SetTransCategory("05_01_phi_inside");
		
		cImGuiLabelData label = ImGui_GetDefaultLabel();
		label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
		label.mFont.mvSize = 20;
		label.mFontAlign = eFontAlign_Left;
		ImGui_SetDefaultLabel(label);
		
		cImGuiTextFrameData textFrame;
		textFrame.mColorText = cColor(0.6, 1);
		textFrame.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Medium));
		textFrame.mFont.mvSize = cVector2f(12, 12);
		textFrame.mFontAlign = eFontAlign_Left;
		textFrame.mbUseBackgroundGfx = false;
		
		ImGui_GroupBegin(ImGui_NrmPosGroup(0.06, 0, 0), ImGui_NrmSizeGroup(0.88));
		
			StationGui_YouAreHereIcon(ImGui_NrmPosGroup(0.4362,0.7178,4), ImGui_NrmSizeGroup(0.075));
			
			ImGui_SetAlignment(eImGuiAlign_CenterCenter);
			
			cImGuiGfx map("phi_map", eImGuiGfx_Texture);
			map.mColor = cColor(0.6, 1);
			ImGui_DoImage(map, ImGui_NrmPosGroup(0.5,0.5057,3), ImGui_GetRatioCorrectSizeByNrmWidth(map, 0.7752));
			
			cImGuiGfx bbox("phi_map_blackbox", eImGuiGfx_Texture);
			ImGui_DoImage(bbox, ImGui_NrmPosGroup(0.63,0.514,4), ImGui_GetRatioCorrectSizeByNrmWidth(bbox, 0.0326));
			
			cImGuiGfx point("phi_map_point", eImGuiGfx_Texture);
			ImGui_DoImage(point, ImGui_NrmPosGroup(0.371,0.4290,4), ImGui_GetRatioCorrectSizeByNrmWidth(point, 0.0456));
			
			bool bFlash = (ImGui_FadeOscillateFloat("PointFlash",0.0f,1.0f,0.5f,eEasing_Linear)>=0.5f);
			if (bFlash)
