/*Place any global values here. These must be const variables as they will not be saved*/
/*This is also the place for enums and classes, but these should be avoided whenever possible*/

const float gfDofMax = 3.0f;

const float gfFogNormal = 45.0f;

// Loader arm constants
const float gfLoaderArmBaseY = 16.5f;	// What's the Y of the arm top
const float gfLoaderArmPlaneY = 6.5f;	// What's the Y of the picking plane?
const float gfLoaderClawTopY = 10.5f;	// What's the Y of the highest position of the claw?
const float gfLoaderClawFailY = 10.0f;  // What's the Y when pressing interact not over an object?
const float gfLoaderArmSpeed = 3.0f;	// What's the XZ speed?
const float gfLoaderClawSpeed = 2.0f;	// What's the claw up/down speed?
const float gfLoaderShellPickupY = 5.25f; // The Y to move to to pick up the shell
const float gfLoaderShellLoadY = 9.0f;	// The Y to move to to load the shell
const float gfZoomMax = 5.0f;
const float gfZoomSpeed = 2.0f;

const float gfLoaderAudioSpamTime = 0.05f;

enum eLoaderArmState
{
	eLoaderArmState_Moving,
	eLoaderArmState_PickUpDown,
	eLoaderArmState_PickUpUp,
	eLoaderArmState_AutoMove,
	eLoaderArmState_LoadDown,
	eLoaderArmState_LoadUp
}

enum eTransferState
{
	eTransferState_Preparing,
	eTransferState_Transferring,
	eTransferState_Transferred,
	eTransferState_CathReturned
}

enum eSatFrameState
{
	eSatFrameState_Empty,
	eSatFrameState_Inserted,
	eSatFrameState_Closing,
	eSatFrameState_Closed,
	eSatFrameState_InTransit,
	eSatFrameState_AtDest
}

