		/////////////////////////////////////////////////////////
		// Termianl: Security Console
		//{//////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool CheckForAndLoadChip(const tString &in asChipName, const tString &in asText)
		{	
			int lLoadState = ImGui_GetStateInt(asChipName + "_LoadState");
			//////////////////////////////////////
			// Check if chip was inserted
			if (lLoadState==1)
			{			
				cGuiDialogBoxSettings dialogBox = StationGui_CreateDefaultDialogBox();
				dialogBox.mType = eGuiDialogBoxType_OK;
				eGuiDialogCode dialogCode = Depth_ImGui_DialogBox("", "ChipInserted", dialogBox);
				
				if (dialogCode == eGuiDialogCode_OK)
				{
					Depth_ImGui_ResetLoadingGauge(asChipName);
					ImGui_IncStateInt(asChipName + "_LoadState", 1);
				}
			}
			
			//////////////////////////////////////
			// Display loading dialog
			else if (lLoadState==2)
			{
				tString sSoundFile="level_amb_shared_machines/tech/HDD/underload_loop";
				tString sSoundSource="SecurityTerminalSoundSource";
				float fFadeInTime = 0.0f;
				float fFadeOutTime = 0.0f;
		
				if (DoLoadingWindow(asChipName, "LoadingChip_Header", asText, 2.0f, true, 1.5f, sSoundFile,sSoundSource, fFadeInTime, fFadeOutTime))
				{
					ImGui_IncStateInt(asChipName + "_LoadState", 1);
					return true;
				}
			}
			
			return false;
		}

		//-------------------------------------------------------
		
		bool ChipIsLoading(const tString &in asChipName)
		{
			int lState = ImGui_GetStateInt(asChipName + "_LoadState") ;
			return lState==1 || lState==2;
		}

		//-------------------------------------------------------
		
		bool ChipIsLoaded(const tString &in asChipName)
		{
			return ImGui_GetStateInt(asChipName + "_LoadState")==3;
		}

		//-------------------------------------------------------
		
		void AddChip(const tString &in asTerminal, const tString &in asChipName)
		{
			Terminal_SetImGuiStateInt(asTerminal, asChipName + "_LoadState", 1);
		}

		//-------------------------------------------------------
		
		void RemoveChip(const tString &in asTerminal, const tString &in asChipName)
		{
			Terminal_SetImGuiStateInt(asTerminal, asChipName + "_LoadState", 0);
		}
		
		//-------------------------------------------------------
		
		void SecurityOfficeTerminal_OnGui(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("02_06_theta_tunnels");
			
			/////////////////////////////////
			// Backdrop
			StationGuiBG_Backdrop("background/background_logo_pathosstation", cVector2f(0.05, 0.05), 0.75);
			StationGuiBG_Scanlines();
			
			if (CheckForAndLoadChip("UnformattedChip", "LoadingChip"))
			{
				// When unformatted chip is fully loaded, go back to main menu
				StationGui_SetActiveApp(asEntityName,eSecurityConsole_MainMenu);
			}
			
			if (ChipIsLoading("UnformattedChip"))
				return;
			
			bool bBackButtonEnabled = true;
			int lActiveApp = StationGui_GetActiveApp(eSecurityConsole_MainMenu);
			switch (lActiveApp)
			{
				case eSecurityConsole_MainMenu:
					StationGui_AddApp("ButtonDoorLock", true, eSecurityConsole_EnterCode);
					StationGui_AddApp("ButtonChipMaintenance", true, eSecurityConsole_FormatChip);
					StationGui_AddApp("SecurityAlertsTitle", true, eSecurityConsole_SecurityAlerts);
					StationGui_MainMenu();
					bBackButtonEnabled=false;
				break;
				
				case eSecurityConsole_FormatChip:
					SecurityOfficeTerminal_Format();
				break;
				
				case eSecurityConsole_EnterCode:
					SecurityOfficeTerminal_DoorLockApp();
				break;
				
				case eSecurityConsole_SecurityAlerts:
					Depth_ImGui_AddTextFile("SecurityAlertsTitle", "SecurityAlerts");
					StationGui_TextReaderSingle();
				break;
			}
			
			StationGuiBG_Taskbar("theta");
			if (StationGui_BackButton(bBackButtonEnabled, 0))
				Depth_ImGui_StopAudioFilePlayback(ImGui_GetName());
		}
		
		//-------------------------------------------------------
		
		void SecurityOfficeTerminal_Format()
		{
			////////////////////////////
			// Data
			cImGuiTextFrameData textData = StationGui_CreateDefaultTextFrameData();
			textData.mbUseBackgroundGfx = false;
			textData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
			textData.mFontAlign = eFontAlign_Left;
		
			cImGuiButtonData button = StationGui_CreateDefaultButtonData();
			button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.04);
			ImGui_SetDefaultButton(button);
			
			////////////////////////////
			// Handle insertion/loading of chip
			if (CheckForAndLoadChip("FormattedChip", "RepairingChip"))
			{
				Depth_Audio_Terminal_Forward("SecurityTerminalSoundSource");
				Entity_SetActive("security_chip_unformatted",true);
				Entity_SetActive("security_chip_formatted",true);
				Entity_SetActive("AreaPickupFormattedChip",true);
				Map_AddTimer("FormatChipMusic", 0.05f, "FormattedChipMusic");
				Terminal_SetUpdateWhenOutOfView("SecurityOfficeTerminal",false);
			}
			if (ChipIsLoading("FormattedChip"))
				return;
				
			cImGuiWindowData window = StationGui_CreateDefaultWindowData();
			
			ImGui_DoWindowStart("ButtonChipMaintenance", window, ImGui_NrmPosGroup(cVector3f(0.075, 0.15, 1)), ImGui_NrmSizeGroup(cVector2f(0.85, 0.5)));
				
				bool bUnformattedChipInserted = ChipIsLoaded("UnformattedChip");
				bool bFormattedChipInserted = Entity_IsActive("security_chip_formatted");
				if (bUnformattedChipInserted || bFormattedChipInserted)
				{
					ImGui_DoTextFrameExt("ChipInfo_ChipInserted", 0, 3, 0, textData, ImGui_NrmPosGroup(cVector3f(0.05,0.1,1)), ImGui_NrmSizeGroup(cVector2f(0.5, 0.8)));
					if (!bFormattedChipInserted)
					{
						textData.mColorText = gStationGuiColor_Warning;
						ImGui_DoTextFrameExt("ChipIntegrity_Error", 0, 3, 0, textData, ImGui_NrmPosGroup(cVector3f(0.475,0.4,1)), ImGui_NrmSizeGroup(cVector2f(0.435, 0.35)));
					}
					else
					{
						ImGui_DoTextFrameExt("ChipIntegrity_NoError", 0, 3, 0, textData, ImGui_NrmPosGroup(cVector3f(0.475,0.4,1)), ImGui_NrmSizeGroup(cVector2f(0.435, 0.35)));
					}
				
					ImGui_SetModUseInput(bUnformattedChipInserted);
					bool bFormat = ImGui_DoButtonExt("ButtonFormat","ButtonFormat", button, 
												  ImGui_NrmPosGroup(cVector3f(0.475, 0.7, 1)), ImGui_NrmSizeGroup(cVector2f(0.5, 0.225)));
					if (bFormat)
					{
						cLux_AddDebugMessage("Update out of view");
						Terminal_SetUpdateWhenOutOfView("SecurityOfficeTerminal",true);
						Depth_Audio_Terminal_Forward("SecurityTerminalSoundSource");
						ImGui_SetStateInt("FormattedChip_LoadState", 2);
						RemoveChip("SecurityOfficeTerminal", "UnformattedChip");
					}
				}
				else
				{
					textData.mFontAlign = eFontAlign_Center;
					textData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.045);
					ImGui_DoTextFrameExt("ChipInfo_NoChipInserted", 0, 3, 0, textData, ImGui_NrmPosGroup(cVector3f(0.0,0.4,1)), ImGui_NrmSizeGroup(cVector2f(1, 0.8)));
				}
				ImGui_SetModUseInput(true);
			
			ImGui_DoWindowEnd();
		}
		
		//-------------------------------------------------------
		
		bool mbShowUnlockedDialog = false;
		
		//-------------------------------------------------------
		
		void SecurityOfficeTerminal_DoorLockApp()
		{
			ImGui_SetTransCategory("02_06_theta_tunnels");
			
			PlayerEnterUnlockScreen();
			
			cStationGui_DoorLockAppSettings settings;
			settings.mlMinLockedCount = 2;
			settings.mMapBackground = cImGuiGfx("theta_securitymap", eImGuiGfx_Texture);
			settings.mfSizeMul = 1.375;
			settings.mvPosOffset = cVector3f(-0.125, -0.175, 0);
			
			{			
				cDoorLockAppButton lock = CreateDoorLockButton("RoomName_ChemRoom", "theta_securitymap_lab", "chemroom_doorpanel");
				lock.mvNrmPos = cVector3f(0.498, 0.18, 1);
				lock.mvNrmSize = cVector2f(0.14, 0.08);
				lock.mvButtons.push_back("chemroomB_doorpanel_3");
				lock.mvButtons.push_back("chemroomB_doorpanel_4");
				lock.msFocusText = "DoorPanel_MedLab";
				lock.msSlideDoor = "chemroom*";
				StationGui_DoorLockApp_AddLock(lock);
			}
			
			{
				cDoorLockAppButton lock = CreateDoorLockButton("RoomName_Infirmary", "theta_securitymap_infirmary", "infirmary_doorpanel");
				lock.mvNrmPos = cVector3f(0.4955, 0.313, 1);
				lock.mvNrmSize = cVector2f(0.1225, 0.085);
				lock.mvButtons.push_back("infirmaryside_doorpanel_1");
				lock.mvButtons.push_back("infirmaryside_doorpanel_2");
				lock.msFocusText = "DoorPanel_Infirmary";
				lock.msSlideDoor = "infirmary*";
				StationGui_DoorLockApp_AddLock(lock);
			}
			
			{
				cDoorLockAppButton lock = CreateDoorLockButton("RoomName_LectureRoom", "theta_securitymap_conferencehall", "lectureroom_doorpanel");
				lock.mvNrmPos = cVector3f(0.35, 0.313, 1);
				lock.mvNrmSize = cVector2f(0.0831, 0.085);
				lock.msFocusText = "DoorPanel_Conference";
				lock.msSlideDoor = "lectureroom_door";
				StationGui_DoorLockApp_AddLock(lock);
			}
			
			{
				cDoorLockAppButton lock = CreateDoorLockButton("RoomName_MastersOffice", "theta_securitymap_mastersroom", "mastersoffice_doorpanel");
				lock.mvNrmPos = cVector3f(0.63, 0.313, 1);
				lock.mvNrmSize = cVector2f(0.07, 0.085);
				lock.msFocusText = "DoorPanel_Office";
				lock.msSlideDoor = "mastersoffice_door";
				StationGui_DoorLockApp_AddLock(lock);
			}
			
			{
				cDoorLockAppButton lock = CreateDoorLockButton("RoomName_ProbeDesign", "theta_securitymap_casing", "probedesign_doorpanel");
				lock.mvNrmPos = cVector3f(0.3675, 0.6375, 1);
				lock.mvNrmSize = cVector2f(0.1094, 0.085);
				lock.msFocusText = "DoorPanel_Casing";
				lock.msSlideDoor = "probedesign_door";
				StationGui_DoorLockApp_AddLock(lock);
			}
			
			{
				cDoorLockAppButton lock = CreateDoorLockButton("RoomName_ProbeSimulation", "theta_securitymap_omegaroom", "probesimulation_doorpanel");
				lock.mvNrmPos = cVector3f(0.6, 0.6575, 1);
				lock.mvNrmSize = cVector2f(0.1531, 0.12);
				lock.msFocusText = "OmegaManagement_Info";
				lock.msSlideDoor = "probesimulation_door";
				StationGui_DoorLockApp_AddLock(lock);
			}
			
			{
				cDoorLockAppButton lock = CreateDoorLockButton("RoomName_RocketDesign", "theta_securitymap_projectroom", "rocketdesign_doorpanel");
