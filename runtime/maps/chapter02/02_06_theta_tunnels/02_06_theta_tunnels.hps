		////////////////////////////////////////////////////////////
		// Scene 1 - *Turn on power*
		//{/////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		cSequenceStatesData mArkLabPowerOnSequence;
			
		void Seq_ArkLabPowerOn(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ArkLabPowerOn", mArkLabPowerOnSequence);
			
			if (Sequence_DoStepAndPause(1))
			{
				Dialog_StartConversation("Catherine", "CathTerminal");
				Dialog_Begin();
					Dialog_AddBranch("CathPluggedIn");
						Dialog_AddPause(0.5);
						Dialog_AddSubject("1_CathPluggedIn_1", "Subject_PluginDialog");
				Dialog_End();
			}
			
			if (Sequence_DoStepAndPause())
			{
				Terminal_SetGuiActive("CathTerminal", true, 0.3);
			}
			
			if (Sequence_DoStepAndWait(1))
			{
				Sound_CreateAtEntity("PowerOnArkLab", "02_06_theta_tunnels/sfx/events/ark_room_powerup", "Player");
			}
			
			else if (Sequence_DoStepAndWait(0))
			{
				Lamp_SetLit("omnitool_station_lamp_*", true, true);
				
				for (int i = 1; Entity_Exists("ArkTestingLamp_"+i); i++)
				{
					float fMinDelay = 0.2*(i-1);
					LightFlickeringLamp("ArkTestingLamp_"+i, fMinDelay, fMinDelay+0.2, 0.5, 1.5);
				}
				
				for (int i = 1; Entity_Exists("ArkLabLampTop_"+i); i++)
				{
					float fMinDelay = 2 + 0.2*(i-1);
					LightFlickeringLamp("ArkLabLampTop_"+i, fMinDelay, fMinDelay+0.2, 0.5, 1.5);
				}
				
				for (int i = 1; Entity_Exists("ArkLabLampLow_"+i); i++)
				{
					float fMinDelay = 4 + 0.4*(i-1);
					LightFlickeringLamp("ArkLabLampLow_"+i, fMinDelay, fMinDelay+0.25, 0.5, 1.5);
				}
				
				Sound_CreateAtEntity("ArkLampSpot", "02_06_theta_tunnels/amb/spots/grid_light", "GridLightSoundSource", 1.0f, true, 1.0f);
				
				Button_SetLocked("AirlockButton_North_1", false, true);
				Button_SetLocked("ScannerDoor_Button", false, true);
				Entity_SetVarString("Scanner_ExtTerminal", "", "Scanner_Outside_Pending");
				
				Terminal_SetGuiActive("ARKTerminal", true, 0.5);
				Lamp_SetLit("ARKTerminalLED_1", true, true);
				Lamp_SetLit("ARKTerminalLED_4", true, true);
				
				Lamp_SetLit("ScannerDoor_lamp_*", true, true);
				Lamp_SetLit("ArkLabLampLow_*", true, true);
				
				Terminal_SetGuiActive("Scanner_ExtTerminal", true);
				Terminal_ForceCacheUpdate("Scanner_ExtTerminal");
				
				if (mbARKCableConnected)
				{
					Map_AddTimer("timer_bootARK",1.5f,"TimerBootArk");
					Lamp_SetFlickerActive("ARKTerminalLED_1", true);
					Lamp_SetLit("ARKTerminalLED_2", true, true);
					Lamp_SetLit("ARKTerminalLED_3", true, true);
				}
				
				Voice_Play("1_CathPluggedIn_2");
				Entity_SetActive("ArkPrototypeLookAt", true);
				CathTool_SetHintsEnabled("CathTool", true);
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnGuiCathTerminal(const tString&in asEntityName, float afTimeStep)
		{
			StationGuiBG_Scanlines();
			Depth_ImGui_CathPortrait(afTimeStep);
		}
		
		//-------------------------------------------------------
		
		void LookAt_ARKPrototype(const tString &in asEntity, int alState)
		{
			Voice_Play("1_LookAtARKPrototype", -1, "", -1);
		}
		
		//-------------------------------------------------------
		
		void Subject_PluginDialog(const tString &in asSubject, bool abStartOfSubject)
		{
			SequenceStates_Resume("Seq_ArkLabPowerOn");
		}
		
		//-------------------------------------------------------
		
		void LightFlickeringLamp(const tString &in asLamp, float afMinDelay, float afMaxDelay, float afMinFlickerTime, float afMaxFlickerTime)
		{
			float fDelay = cMath_RandRectf(afMinDelay, afMaxDelay);
			float fFlickerTime = cMath_RandRectf(afMinFlickerTime, afMaxFlickerTime);
			
			Lamp_SetFlickerActive(asLamp, true);
			Map_AddTimer(asLamp, fDelay, "TimerSetLampLit");
			Map_AddTimer(asLamp, fDelay + fFlickerTime, "TimerSetLampFlickerOff");
		}
		
		//-------------------------------------------------------
		
		//} END Event Turn on power
	
		////////////////////////////////////////////////////////////
		// Scene 1 - *Run ARK Beta*
		//{/////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool VoiceCondition_ScanningAndSimDone(const tString &in asSubject)
		{
			bool bReturn = Entity_GetCollide("Player", "ArkAndOmniPanelProximity");
			return (bReturn==true);
		}
		
		//-------------------------------------------------------
		
		bool DialogEvent_ScanningAndSimDone(const tString&in asBranch, const tString&in asBranchSubject, int alLineIndex, const tString&in asNewBranch)
		{
			bool bCloseEnough = Entity_GetCollide("Player", "ArkAndOmniPanelProximity");
			
			if (bCloseEnough==false)
			{
				Voice_PlayWhenPossible("1_ScanningAndSimDone_2", "VoiceCondition_ScanningAndSimDone", -1, 0, "VoiceOver_EjectCathTool");
			}
			
			cLux_AddDebugMessage("DialogEvent_ScanningAndSimDone "+bCloseEnough);
			return (bCloseEnough==true);
		}
		
		//-------------------------------------------------------
		
		void Subject_EjectCathTool(const tString &in asSubject, bool abStartOfSubject)
		{
			if (abStartOfSubject) return;
			StopArkLabMusic();
			VoiceOver_EjectCathTool("", "");
		}
		
		//-------------------------------------------------------
		
		void VoiceOver_EjectCathTool(const tString&in asScene, const tString&in asSubject)
		{
			Terminal_SetGuiActive("CathTerminal", false, 0.3);
			CathTool_AllowDetach("CathTool");
