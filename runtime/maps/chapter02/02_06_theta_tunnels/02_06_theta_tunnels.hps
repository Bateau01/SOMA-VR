		//--------------------------------------------------------
		bool mbAkersSpawned = false;
		//--------------------------------------------------------
		
		bool CollideAreaEnableAkers(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_CreateAtEntity("AkersSpawn", "02_06_theta_tunnels/sweeteners/akers_stuff/akers_tunnel_spawn", "Player");
			Map_AddTimer("AkersSpawn", 2.0, "AkersSpawn");
			return false;
		}
		
		void AkersSpawn(const tString &in asTimer)
		{
			Entity_SetActive("puppet_dynamic", true);
			Map_AddTimer("StartAmbient", 11.f, "AmbientMusicHandler");
			
			AttackMeter_SetAttackerTeleportPosition("puppet_spawnpos_*");
			
			cLux_AddDebugMessage("Akers puppet is enabled!");
			
			Puppet_SetAgressionAmount("puppet_dynamic", 0.0f);
			Puppet_SetComeOutOfHidingTimeMul("puppet_dynamic", 2.5f);
			
			AttackMeter_SetAfterDamageCallback("AfterDynamicPuppetDamage");
			
			mbAkersSpawned = true;
		}
		
		//-------------------------------------------------------
		
		void AfterDynamicPuppetDamage(const tString& in asSource)
		{
			mlAkersKillCount++;
			//Map_AddTimer("2_PlayerWakesUpFromDeath", 10, "TimerPlayVoice");
			
			cLux_AddDebugMessage("KillCOunt: "+mlAkersKillCount);
			
			Player_ChangeStateToNormal();
			cLux_AddDebugMessage("Stopping Datamine");
			
			
			if(mlAkersKillCount>=3)
				Puppet_SetHideAndWaitPaused("puppet_dynamic", true);
		}
		
		//-------------------------------------------------------
		
		//} END Event Activate puppet!
		
