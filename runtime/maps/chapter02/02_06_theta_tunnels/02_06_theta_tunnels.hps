	//////////////////////////////////////////
	// Mind coral distant sweeteners
	bool CollidePlayCoralSounds(const tString &in asParent, const tString &in asChild, int alState)
	{
		return false; //Interferes with the Puppet, so disabling this for now!
		
		//cLux_AddDebugMessage("parent: " + asParent + " chld: " + asChild);
		if (alState != 1) return true;
		
		////////////////////////////////////
		// Play coral sounds when player goes in to certain areas
		cLux_AddTodoMessage("SOUND: Bank of sounds for creepy coral creature lurking in vents/distance");
		
		tString sTargetArea = Entity_GetVarString(asChild,"");
		Sound_CreateAtEntity("coral_"+sTargetArea,"02_06_theta_tunnels/sfx/distant_coral_movement",sTargetArea,0.0f,false,1.f);
		
		//Disable both sets of sound triggers to stop from spam
		Entity_SetActive("Area_MindCoralSounds_*", false);
		Entity_SetActive("Area_CoralSoundsArea_*", false);
			
		//Reenable areas after random time
		Map_AddTimer("ResetCoralSoundAreas", cMath_RandRectf(35.0f, 55.0f), "MindCoralSoundTriggerEnable");
		
		//Add some fear breathing
		Map_AddTimer("CoralSoundFearBreathing", cMath_RandRectf(3.0f, 5.0f), "CoralSoundFearBreathing");
		Map_AddTimer("StopAmbientMusic", 1.0f, "AmbientMusicHandler");
		Map_AddTimer("StartAmbient", cMath_RandRectf(8.f,12.f), "AmbientMusicHandler");
		
		return false;
	}
	
	//-------------------------------------------------------

	//////////////////////////////////////////
	// Mind coral crawling sounds from vents etc
	tString msCoralSoundArea = "";
	bool MindCoralSoundTrigger(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1 && Puppet_IsHidingAndWaiting("puppet_dynamic") && Sound_Exists("puppet_dynamic_Bark")==false)
		{
			cLux_AddDebugMessage("Coral vent sound triggered @ " + asChild);
			msCoralSoundArea = Entity_GetVarString(asChild,"");
			Sound_CreateAtEntity("mindcoral_crawling","02_06_theta_tunnels/sfx/vent_sweetener",msCoralSoundArea,0,false,1.0);
			
			//Disable both sets of sound triggers to stop from spam
			Entity_SetActive("Area_MindCoralSounds_*", false);
			Entity_SetActive("Area_CoralSoundsArea_*", false);
			
			//Reenable areas after random time
			Map_AddTimer("ResetCoralSoundAreas", cMath_RandRectf(35.0f, 55.0f), "MindCoralSoundTriggerEnable");
			
			//Add some fear breathing
			Map_AddTimer("CoralSoundFearBreathing", cMath_RandRectf(3.0f, 5.0f), "CoralSoundFearBreathing");
		}
		
		
		return true;
	}
	
	void MindCoralSoundTriggerEnable(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Coral sound triggers reenabled");
		Entity_SetActive("Area_MindCoralSounds_*", true);
		Entity_SetActive("Area_CoralSoundsArea_*", true);
	}
	
	void CoralSoundFearBreathing (const tString &in asTimer)
	{
		//Depth_Audio_Fear_LowIntensity();
	}
	
	bool Trigger_CollideOfficeSoundControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Sound_Fade("BrokenNeonLight_*", 0.0f, 2.0f);
			Lamp_SetFlickerActive("fluorescent_tube_curved_special_41", false);
			Lamp_SetFlickerActive("fluorescent_tube_curved_special_39", false);
		}
		else
		{
			Sound_Fade("BrokenNeonLight_*", 1.0f, 2.0f);
			Lamp_SetFlickerActive("fluorescent_tube_curved_special_41", true);
			Lamp_SetFlickerActive("fluorescent_tube_curved_special_39", true);
		}
		
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_AreaAllowHide(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (cLux_GetExplorationModeActive() == false) return false;
		if (asChild == "puppet_dynamic")
		{
			Entity_SetVarBool(asChild, "ExplorationMode_InHideZone", alState == 1);
			cLux_AddDebugMessage("AKERS IN HIDE ZONE: " + (alState == 1));
		}
		else if (asParent == "Player")
		{
			Entity_SetVarBool("puppet_dynamic", "ExplorationMode_PlayerInHideZone", alState == 1);
			cLux_AddDebugMessage("PLAYER IN HIDE ZONE: " + (alState == 1));
		}		
		return true;
	}	
	
	//-------------------------------------------------------
	//Ark Sim
	bool mbArkSimAudioActive = false;
	bool mbArkCompileAudioActive = false;
	
	void Audio_ArkSimStart(const tString &in asEntity)
	{
		if(mbArkSimAudioActive==false)
		{
			Sound_CreateAtEntity("ArkSimStart", "02_06_theta_tunnels/sfx/ark_comp/ark_comp_sim/ark_sim_start", asEntity);
			Map_AddTimer(asEntity, 3.0f, "Audio_ArkSimLoop");
			mbArkSimAudioActive = true;
			
		}
		if(Sound_Exists("ArkSimLoop"))
		{
			Sound_Fade("ArkSimLoop", 1.0f, 1.0f);
			Sound_Stop("ArkSimPause", 1.0f);
		}
		cLux_AddDebugMessage("Audio Ark Sim Start");
	}
	
	void Audio_ArkSimLoop(const tString &in asTimer)
	{
		Sound_CreateAtEntity("ArkSimLoop", "02_06_theta_tunnels/sfx/ark_comp/ark_comp_sim/ark_sim_run", asTimer, 2.5f, false, 1.0f);
		cLux_AddDebugMessage("Audio Ark Sim Loop");
	}
	
	void Audio_ArkSimPause(const tString &in asEntity)
	{
		Sound_Fade("ArkSimLoop", 0.0f, 1.0f);
		if(Sound_Exists("ArkSimPause")==false)
		{
			Sound_CreateAtEntity("ArkSimPause", "02_06_theta_tunnels/sfx/ark_comp/ark_comp_sim/ark_sim_pause", asEntity, 1.0f, false, 1.0f);
		}
		else if(Sound_Exists("ArkSimPause"))
		{
			Sound_Fade("ArkSimPause", 1.0f, 1.0f);
		}
		cLux_AddDebugMessage("Audio Ark Sim Pause");
	}
	
	void Audio_ArkSimPauseOver()
	{
		Sound_Fade("ArkSimLoop", 1.0f, 1.0f);
		Sound_Stop("ArkSimPause", 1.0f);
		cLux_AddDebugMessage("Audio Ark Pause Over");
	}
	
	void Audio_ArkSimReset(const tString &in asEntity)
	{
		if(mbArkSimAudioActive==true)
		{
			Sound_Stop("ArkSimLoop", 0.25f);
			Sound_Stop("ArkSimStart", 0.25f);
			Sound_CreateAtEntity("ArkSimReset", "02_06_theta_tunnels/sfx/ark_comp/ark_comp_sim/ark_sim_reset", asEntity);
			cLux_AddDebugMessage("Audio Ark Sim Reset");
			mbArkSimAudioActive = false;
		}

	}
	
	void Audio_ArkCompiling(const tString &in asEntity)
	{
		if(mbArkCompileAudioActive==false)
		{
			Sound_CreateAtEntity("ArkCompileStart", "02_06_theta_tunnels/sfx/ark_comp/ark_comp_compile/ark_comp_compile_start", asEntity);
			Sound_CreateAtEntity("ArkCompileLoop", "02_06_theta_tunnels/sfx/ark_comp/ark_comp_compile/ark_comp_compile_loop", asEntity);
			mbArkCompileAudioActive = true;
		}
	}
	
	void Audio_ArkCompilingComplete(const tString &in asEntity)
	{
		if(mbArkCompileAudioActive==true)
		{
			Sound_Stop("ArkCompileLoop", 0.15f);
			Sound_CreateAtEntity("ArkCompileStop", "02_06_theta_tunnels/sfx/ark_comp/ark_comp_compile/ark_comp_compile_stop", asEntity);
			mbArkCompileAudioActive = false;
		}
	}
	
	//-------------------------------------------------------
	
	bool AreaVictimSoundControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1 && Entity_GetCollide("Player", "StorageRoomCollide")==false)
		{
			Map_AddTimer("VictimSoundControl", 0.05f, "VictimSoundControl");
		}
		else
		{
			Map_RemoveTimer("VictimSoundControl");
		}
		return true;
	}
	
	void VictimSoundControl(const tString &in asTimer)
	{
		if(Entity_GetCollide("Player", "StorageRoomCollide")==false)
		{
			if(cLux_GetCurrentMap().GetWorld().GetSoundEntity("puppet_victim_1_AnimEvent") !is null) Sound_Stop("puppet_victim_1_AnimEvent",0.05f);
			if(cLux_GetCurrentMap().GetWorld().GetSoundEntity("puppet_victim_2_AnimEvent") !is null) Sound_Stop("puppet_victim_2_AnimEvent",0.05f);
			if(cLux_GetCurrentMap().GetWorld().GetSoundEntity("wau_flower_1_AnimEvent") !is null) Sound_Stop("wau_flower_1_AnimEvent",0.05f);
			Map_AddTimer("VictimSoundControl", 0.05f, "VictimSoundControl");
		}
	}
	
