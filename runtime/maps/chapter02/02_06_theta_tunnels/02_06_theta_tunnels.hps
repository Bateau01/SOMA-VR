		//---------------------------------------------------------

		bool Trigger_OpenElevatorHatch(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1) return true;
			
			//SwingDoor_PushOpen("02_06_elevator_hatch_1", 3);
			
			Entity_WakeUp("02_06_elevator_hatch_1");
			SwingDoor_SetOpenAmount("02_06_elevator_hatch_1",0.11f);
			Map_AddTimer("timer_nudgedoor",1.0f,"TimerNudgeDoor");
			Entity_SetInteractionDisabled("02_06_elevator_hatch_1",false);
			return false;
		}
		
		void TimerNudgeDoor(const tString &in asTimer)
		{
			SwingDoor_PushOpen("02_06_elevator_hatch_1",0.5f,2,1.0f);
		}
		
		//---------------------------------------------------------
		
		bool Trigger_ElevatorHatchOpen(const tString &in asParent, const tString &in asChild, int alState)
		{
			Player_ChangeStateToNormal();
			Player_SetLookSpeedMul(0);
			Player_FadeLookSpeedMulTo(1, 1.5);
			Entity_SetActive("LadderInteractAux", true);
			
			float fOpenAmount = SwingDoor_GetOpenAmount("02_06_elevator_hatch_1");
			cLux_AddDebugMessage("Open? " + fOpenAmount);
			
			Entity_SetActive("02_06_elevator_hatch_1",false);
			Entity_SetActive("02_06_elevator_hatch_opened",true);
			SwingDoor_SetOpenAmount("02_06_elevator_hatch_opened",fOpenAmount);
			Entity_SetInteractionDisabled("02_06_elevator_hatch_opened",false);
			
			Entity_SetActive("elevator_hatch_blocker",false);
			Entity_SetActive("AuxArea_ElevatorHatch",false);
			return false;
		}
		
		//---------------------------------------------------------
		
		bool Trigger_UnsteadyElevator(const tString &in asParent, const tString &in asChild, int alState)
		{
			bool bPlayerClimbing = Entity_IsInteractedWith("LadderArea_1");
			if (bPlayerClimbing==false)
				return false;
			
			//Slight delay for pacing of sound
			Map_AddTimer("UnsteadyElevatorEvent", 0.5f, "UnsteadyElevatorEvent");

			return false;
		}
		
		void UnsteadyElevatorEvent(const tString &in asTimer)
		{
			Sound_CreateAtEntity("ElevatorUnstable", "02_06_theta_tunnels/sfx/events/elevator_sequence/exit_elevator_groan_sweetener", "Player");
			Sound_Stop("ElevatorStop", 3.0f);
			Sound_Fade("ElevatorSustained", 0.0f, 3.0f);
			Map_AddTimer("FadeUpElevatorCreaks", 3.0f, "FadeUpElevatorCreaks");
			Effect_Shake_Start(0.01, 0, 0.5, 2, 1, 30);
		}
		
		void FadeUpElevatorCreaks(const tString &in asTimer)
		{
			Sound_Fade("ElevatorSustained", 1.0f, 3.0f);
		}
		
