		//////////////////////////////////////////
		// Event: Format the chip
		//{///////////////////////////////////////
		
		//--------------------------------------------------------
		
		// H5756AT_VR_THETA_TUNNELS_PHYSICAL_CHIP_RETURN
		bool _HPL3VR_RuntimeActive_ThetaTunnelsAT()
		{
			cScript_SetGlobalReturnBool(false);
			cScript_RunGlobalFunc("MenuHandler", "cScrMenuHandler", "HPL3VR_GetRuntimeActive");
			return cScript_GetGlobalReturnBool();
		}

		bool chip_unformatted_CanBeUsed(const tString &in asTool, const tString &in asEntity)
		{
			if (asEntity == "Area_InsertUnformattedChip") return true;
			if (asEntity == "Area_Broken_Panel") return true;
			return false;
		}
		
		//--------------------------------------------------------
		
		bool chip_unformatted_OnUse(const tString &in asTool, const tString &in asEntity)
		{
			Tool_SetAutoHideAfterPickup("chip_unformatted", true);
			if (asEntity == msBrokenPanelArea)
			{
				///////////////////////////////////////////////
				// Insert the unformatted chip in to control panel
				Entity_SetActive("Replaced_Chip",true);
				Entity_PlaceAtEntity("Replaced_Chip","Replaced_Chip_Startpos");
				Prop_MoveLinearTo("Replaced_Chip","Replaced_Chip_Target",10,0.8,0.1,true);
				mbPanelChipReplaced = true;
				mbUnformattedChipInPanel = true;
				
				////////////////////////////////////////////////
				// Allow broken chip to be removed again
				Entity_SetActive("Area_RetrieveBrokenChip",true);
				
				/////////////////////////////////////////
				// Disable shock area as circuits are no longer exposed
				Entity_SetActive(msBrokenPanelArea,false);
				
				/////////////////////////////////////////
				// Sound
				Sound_CreateAtEntity("panel_chip_click","02_06_theta_tunnels/sfx/elevator_chip_insert","BrokenChipSoundArea",0,false,1.0f);
				Map_AddTimer("BadChipConfirm", 1.f, "BadChipConfirmBeep");
				
				Entity_SetInteractionDisabled("RetentionMechanism_*",true);
				
				/////////////////////////////////////////
				// Comment
				Map_AddTimer("1_InsertBadChip", 3, "TimerPlayVoice");
				
				return true;
			}
			
			if (asEntity == "Area_InsertUnformattedChip")
			{
				///////////////////////////////////////////////
				// Insert the unformatted chip in to the system
				Entity_SetActive("Area_InsertUnformattedChip",false);
				Entity_SetActive("security_chip_unformatted",true);
				Entity_SetInteractionDisabled("security_chip_unformatted",true);
				AddChip("SecurityOfficeTerminal", "UnformattedChip");
				
				/////////////////////////////////////////
				// Sound
				Sound_CreateAtEntity("InsertChipUnformatted","Entities_Station/object/memchip/insert_idle","ChipSoundArea",0,false,1.0f);
				Sound_CreateAtEntity("InsertChipUnformatted","Entities_Station/object/memchip/insert","ChipSoundArea",0,false,1.0f);
				
				return true;
			}
			
			return true;
		}

		void BadChipConfirmBeep (const tString &in asTimer)
		{
			Sound_CreateAtEntity("elevatorchipconfirm", "Entities_Station/tech/terminal_beeps/datapad/datapad_stop", "doorpanel_faceplate");
		}
		
	
		//-------------------------------------------------------
		
		//} END Event Format the chip
		
		//////////////////////////////////////////
		// Event: Fix Elevator Panel
		//{///////////////////////////////////////
	
		//-------------------------------------------------------
		
		tString msPanelToolArea = "ToolArea_DoorPanel";
		tString msBrokenPanelArea = "Area_Broken_Panel";
		
		int mlRetentionClamps = 0;
		bool mbTopClampOpen = false;
		bool mbBottomClampOpen = false;
		bool mbPlayerZapped = false;	
		bool mbPanelFaceplate = false;
		bool mbPanelChipReplaced = false;
		bool mbUnformattedChipInPanel = false;
		
		//-------------------------------------------------------
		
		void stuck_door_chip_1_OnPlayerInteract(const tString &in asEntity)
		{
			Entity_SetActive("stuck_door_chip", false);
			Entity_CallEntityInteract("door_panel_chip");
		}
		
		//-------------------------------------------------------
		
		void SetupPanelClamps()
		{
			Lever_SetAutoMoveTarget("RetentionMechanism_1",-1);
			Lever_SetAutoMoveTarget("RetentionMechanism_2",1);
			Lever_SetAutoMoveEnabled("RetentionMechanism_1",true);
			Lever_SetAutoMoveEnabled("RetentionMechanism_2",true);
		}
		
		//-------------------------------------------------------
		
		void RetentionLever_OnPlayerInteract(const tString &in asEntity)
		{
			Lever_SetAutoMoveEnabled(asEntity,false);
		}
		
		//-------------------------------------------------------
		
		bool CheckPanelRepaired()
		{
			if (mbPanelChipReplaced && mlRetentionClamps >= 2)
			{
				return true;
			}
			else
			{
				return false;
			}
		}
		
		//-------------------------------------------------------
		
		bool Area_Close_Panel(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Collision");
			bool bRepaired = CheckPanelRepaired();
			
			////////////////////////////////////////
			// If panel is fully repaired, swap in the full interactive door panel
			if (alState == 1 && bRepaired)
			{
				Entity_SetActive("doorpanel_faceplate",false);
				Entity_SetActive("TunnelEntrance_doorpanel_1",true);
				Lamp_SetLit("Panel_Light_Success_*",false,true);
				Sound_CreateAtEntity("Panel_Ventilation","Entities_Station/doors/elevator_panel/elevator_panel_lock","TunnelEntrance_doorpanel_1",0,false);
				Map_AddTimer("ActivateElevatorPanel", 1.0f, "ActivateElevatorPanel");
			}
			
			////////////////////////////////////////
			// When closing the panel door, give feedback if not fully repaired
			else if (alState == 1 && !bRepaired)
			{
				Dialog_Begin();
					Dialog_AddBranchAndSubject("1h_DoorNotFixed","","");
				Dialog_End();
			}
			return true;
		}
		
		void ActivateElevatorPanel (const tString &in asTimer)
		{
			Sound_CreateAtEntity("Panel_Ventilation","Entities_Station/tech/terminal_beeps/terminal_hardware_insert_beep","TunnelEntrance_doorpanel_1",0,false);
		}
		
		//-------------------------------------------------------
		
		void Area_RetrieveBrokenChip_OnPlayerInteract(const tString &in asEntity)
		{
            if (_HPL3VR_RuntimeActive_ThetaTunnelsAT() && (!mbPanelChipReplaced || !mbUnformattedChipInPanel)) return;
			cLux_AddDebugMessage("**** Getting broken chip back! ****");
			
			////////////////////////////////////////////
			// When removing the broken chip from the panel
			Entity_SetActive("Area_RetrieveBrokenChip",false);
			Entity_SetActive("Replaced_Chip",false);
			Entity_PlaceAtEntity("Replaced_Chip","Replaced_Chip_Startpos");
			Entity_SetInteractionDisabled("RetentionMechanism_*",false);
			
			mbPanelChipReplaced = false;
			mbUnformattedChipInPanel = false;
			
			////////////////////////////////////////////
			// Re-equip the tool via the entity
			Tool_SetAutoHideAfterPickup("chip_unformatted", false);
			// H5756AV_VR_THETA_TUNNELS_SAME_GRIP_DETACH
			if (_HPL3VR_RuntimeActive_ThetaTunnelsAT())
				cScript_RunGlobalFunc("VROMNITHETA", "chip_unformatted", "R");
			if (_HPL3VR_RuntimeActive_ThetaTunnelsAT())
            {
                Entity_SetVarString("chip_unformatted","VRReturnArea",msBrokenPanelArea);
                Entity_PlaceAtEntity("chip_unformatted", "Replaced_Chip_Startpos");
            }
			Tool_PickUp("chip_unformatted", true, true);
				
			/////////////////////////////////////////
			// Re-enable shock area
			Entity_SetActive(msBrokenPanelArea,true);
			
			Sound_CreateAtEntity("elevatorchipconfirm", "02_06_theta_tunnels/sfx/elevator_chip_remove", "BrokenChipSoundArea");
			Map_AddTimer("RemoveChipConfirm", 1.f, "RemoveChipConfirmBeep");
		}
		
		void RemoveChipConfirmBeep (const tString &in asTimer)
		{
			Sound_CreateAtEntity("elevatorchipconfirm", "Entities_Station/tech/terminal_beeps/datapad/datapad_back", "doorpanel_faceplate");
		}
		
		//-------------------------------------------------------
		
		bool door_panel_chip_OnUse(const tString &in asTool, const tString &in asEntity)
		{
			if (asEntity == msBrokenPanelArea)
			{
				/////////////////////////////////////
				// Replace the chip in the door panel 
				Entity_SetActive("Replaced_Chip",true);
				Entity_PlaceAtEntity("Replaced_Chip","Replaced_Chip_Startpos");
				Prop_MoveLinearTo("Replaced_Chip","Replaced_Chip_Target",10,0.8,0.1,true);
				Player_RemoveTool(asTool);
				mbPanelChipReplaced = true;
				
				/////////////////////////////////////////
				// Disable shock area as circuits are no longer exposed
				Entity_SetActive(msBrokenPanelArea,false);
				
				/////////////////////////////////////////
				// Sound
				Sound_CreateAtEntity("panel_chip_click","02_06_theta_tunnels/sfx/elevator_chip_insert","Replaced_Chip",0,false,1.0f);
				Map_AddTimer("ReplacedChipConfirm", 1.f, "ReplacedChipConfirmBeep");
				return true;
			}
			return false;
		}
		
		//--------------------------------------------------------
		
		void ReplacedChipConfirmBeep (const tString &in asTimer)
		{
			Sound_CreateAtEntity("elevatorchipconfirm", "Entities_Station/tech/terminal_beeps/datapad/datapad_forward", "doorpanel_faceplate");
		}
		
		//--------------------------------------------------------
		
		void Replaced_Chip_OnPlayerInteract(const tString &in asEntity)
		{
		}
			
		//-------------------------------------------------------
		
		bool door_panel_chip_CanBeUsed(const tString &in asTool, const tString &in asEntity)
		{
			if (asEntity == msBrokenPanelArea)
			{
				return true;
			}
			return false;
		}
		
		//-------------------------------------------------------
		
		void RetentionMechanism_OnConnectionStateChange(const tString &in asEntity, int alState)
		{		
			//////////////////////////////////////////////////////////////////////////////
			// If both clamps are open, allow the chip to be inserted if it hasn't already
			if (mbPanelChipReplaced == false || mbUnformattedChipInPanel)
			{
		
				if (asEntity == "RetentionMechanism_1")
				{
					mbTopClampOpen = (alState == -1) ? true : false;
				}
				
				if (asEntity == "RetentionMechanism_2")
				{
					mbBottomClampOpen = (alState == 1) ? true : false;
				}
				cLux_AddDebugMessage("mbTopClampOpen "+mbTopClampOpen);
				cLux_AddDebugMessage("mbBottomClampOpen "+mbBottomClampOpen);
				
				///////////////////////////////////////////////
				// Determine if clamps are open
				bool bOpen = (mbTopClampOpen&&mbBottomClampOpen) ? true : false;
				Entity_SetActive(msBrokenPanelArea,bOpen && mbUnformattedChipInPanel == false);	
				
				Entity_SetActive("Area_RetrieveBrokenChip", bOpen && mbUnformattedChipInPanel);
				
				return;		
			}
			
			/////////////////////////////////////////
			// Clamp the top lever in place
			if (asEntity == "RetentionMechanism_1" && alState == 1)
			{
				Lever_SetStuckState("RetentionMechanism_1",1,true);
				Lamp_SetLit("Panel_Light_1",false,true);
				Map_AddTimer("Panel_Light_1",0.75,"Timer_LightPanelIndicator");
				++mlRetentionClamps;
			}
			
			/////////////////////////////////////////
			// Clamp the bottom lever in place
			if (asEntity == "RetentionMechanism_2" && alState == -1)
			{
				Lever_SetStuckState("RetentionMechanism_2",-1,true);
				Lamp_SetLit("Panel_Light_2",false,true);
				Map_AddTimer("Panel_Light_2",0.75,"Timer_LightPanelIndicator");
				++mlRetentionClamps;
			}
		}
		
		//-------------------------------------------------------
		
		tString msLampName = "";
		void Timer_LightPanelIndicator(const tString &in asTimer)
		{
			//////////////////////////////////////////
			// Swap out red light for green light
			//todo: different on/off colours for single lamp entities?
			msLampName = "Panel_Light_Success_" + cString_GetLastChar(asTimer);
			Entity_SetActive(msLampName,true);
			Entity_PlaceAtEntity(msLampName,asTimer);
			Entity_SetActive(asTimer,false);
			
			/////////////////////////////////////////
			// Finally, light the lamp
			Lamp_SetLit(msLampName,true,true);
			cLux_AddDebugMessage("Lit Lamp: " +asTimer);
			Sound_CreateAtEntity("LightOn", "Entities_Station/tech/terminal_beeps/datapad/datapad_back", msLampName);
		}
	
		//--------------------------------------------------------
		
		//} END Event Fix Elevator Panel
		
		/////////////////////////////////////
		// Event: Player gets zapped by panel
		//{//////////////////////////////////
		
		//--------------------------------------------------------
		
		void Area_Broken_Panel_OnPlayerInteract(const tString &in asEntity)
		{
			/*/////////////////////////////////////////////
			// Zap the player for touching exposed wires
			if (mbPlayerZapped == false)
			{
				cLux_AddTodoMessage("SCRIPT: Zap the player! Ow!");
				
				cLux_AddTodoMessage("Sound: Spark as player touches exposed wires");
				Sound_PlayGui("level_01_02/events/generator_room_activated/transformer_electric_flash",1.0f);
				
				SequencePanelZap("");
			}
			else
			{
				///////////////////////////////////////////////////////////////
				// If the player has already been zapped, don't zap them again but instead give hint
			
				Dialog_Begin();
					Dialog_AddBranchAndSubject("1h_DoorHint","","");
					Dialog_End();
			}*/
			
			Dialog_Begin();
				Dialog_AddBranchAndSubject("1h_DoorHint","","");
			Dialog_End();
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mPanelZapSequence;
			
		void SequencePanelZap(const tString &in asTimer)
		{
			Sequence_Begin("SequencePanelZap", mPanelZapSequence);
				
			if (Sequence_DoStepAndWait(2.0))
			{
				///////////////////////////
				// Apply electric damage effect
				Depth_Audio_PlayerTakeDamage();
				Depth_Audio_SimonHurt_Damage();
				Player_GiveDamage(0.05f, 0.1, eDamageType_Electricity, "Area_Broken_Panel");
				
				//////////////////
				// Screen Effects
				Effect_Shake_Start(0.1, 0.1, 0, 0.4);
				
				//////////////////////////////////
				// Disable the zapping area
				mbPlayerZapped = true;
				Entity_SetActive(msBrokenPanelArea,true);	
			}
			else if (Sequence_DoStepAndWait(2))
			{
				////////////////////////////////
				// Give feedback to the player
				Dialog_Begin();
					Dialog_AddBranchAndSubject("1h_DoorZap","","");
					Dialog_End();
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		//} END Event Player Gets zapped by panel.
		
	
	//-------------------------------------------------------
	
	//} END SCENE 4, ELEVATOR CHIP PUZZLE
	
	/////////////////////////////////////////////////////
	// ==============
	// SCENE 5: ELEVATOR RIDE
	// ==============
	//{//////////////////////////////////////////////////////
	
	//-------------------------------------------------------
	
		//////////////////////////////////////////////////////
		// Event: Enter Elevator; Puppet attacks
		//{///////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool Trigger_EnterElevator(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==1)
			{
				Map_AddTimer("Seq_UnstableElevator", 1, "Seq_UnstableElevator");
			}
			else
			{
				Map_RemoveTimer("Seq_UnstableElevator");
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mUnstableElevatorSequence;
		
		tString msElevatorPuppet = "";
			
		void Seq_UnstableElevator(const tString &in asTimer)
		{
			Sequence_Begin("Seq_UnstableElevator", mUnstableElevatorSequence);
				
			if (Sequence_DoStepAndWait(0.15))
			{
				Effect_Rumble_Start(0.4, 0.5);
				
				Effect_Shake_Start(0.05, 0.1, 0, 0.5);
				
				Entity_WakeUp("elevator_door_rear");
				Entity_RemoveEntityAttachment("elevator_door_rear");
				Entity_AttachToEntity("elevator_door_rear","02_06_elevator_1","",false,false,false);
				Prop_MoveLinearTo("02_06_elevator_1", "02_06_elevator_1_Target", 9, 5, 0.05, true);
				
				Lamp_SetFlickerActive("02_06_elevator_1", true);
				
				cLux_AddDebugMessage("Sound: Elevator falls down a bit.");
				Sound_CreateAtEntity("ElevatorShortFall", "02_06_theta_tunnels/sfx/events/elevator_sequence/motor/enter_drop", "Player");
				
				Entity_SetActive("puppet_dynamic",true);
				Entity_SetActive("Area_ElevatorPuppet", false);
				Entity_SetActive("PuppetElevatorMusicCharge", true);
			}
			else if (Sequence_DoStepAndWait(0.85))
			{
				ParticleSystem_CreateAtEntity("ElevatorDust", "dust_cloud", "ElevatorDustPSArea", false);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Lamp_SetFlickerActive("02_06_elevator_1", false);
				
				Entity_RemoveEntityAttachment("elevator_door_rear");
				
				if (cLux_GetExplorationModeActive() == false)
				{
					if(	Puppet_IsHidingAndWaiting("puppet_dynamic") ||
						Entity_IsActive("puppet_dynamic")==false)
					{
						Entity_SetActive("puppet_dynamic",false);
						Entity_SetActive("puppet_elevator",true);
						Pathfinder_Track_Clear("puppet_elevator");
						Pathfinder_Track_Add("puppet_elevator", "PathNodeArea_90");
						Pathfinder_Track_Start("puppet_elevator",true,1,"");
						msElevatorPuppet = "puppet_elevator";
					}
					else
					{
						Puppet_SetHideAndWaitPaused("puppet_dynamic", false);
					
						Sound_CreateAIEventAtEntity("Area_ElevatorPuppet", 100, 10);
						msElevatorPuppet = "puppet_dynamic";
					}
				}
				else
				{
					Entity_SetActive("puppet_dynamic", true);
					Puppet_ForceHideAndWaitAppearance("puppet_dynamic");
					Sound_CreateAIEventAtEntity("Area_ElevatorPuppet", 100, 10);					
					cScript_RunGlobalFunc("puppet_dynamic", "cScrAgentPuppet", "_Global_ExplorationMode_SetupElevatorEvent");
				}
			}
			else if (Sequence_DoStepAndWait(2))
			{
				if (cLux_GetExplorationModeActive() == false)
				{
					Puppet_ChangeState_Hunt(msElevatorPuppet);
				}
				else
				{
					Entity_SetVarBool("puppet_dynamic", "ExplorationMode_DontWanderOff", true);
				}
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		bool Trigger_PuppetInElevator(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Entity_SetInteractionDisabled("Elevator_InsideTerminal", true);
				if (Entity_IsInteractedWith("Elevator_InsideTerminal"))
					Player_ChangeStateToNormal();
			}
			else
			{
				Entity_SetInteractionDisabled("Elevator_InsideTerminal", false);
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END Elevator Puppet Attack
	
		//////////////////////////////////////////////////////
		// Event: Elevator Starts
		//{///////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		void HandleElevatorClosing()
		{
			Entity_SetActive("Area_ElevatorClose",true);
			Entity_SetActive("block_box_elevator",true);
			
			SlideDoor_SetClosed("elevator_door_*",true,false);
			
			Agent_SetSensesActive("puppet_elevator", false);
		}
		
		//-------------------------------------------------------
		
		bool CollideElevatorClose(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Puppet Attacks!");
			
			if (cLux_GetExplorationModeActive())
			{
				if (Puppet_IsHidingAndWaiting("puppet_dynamic") == false &&
					Entity_GetDeltaToEntity("player", "puppet_dynamic").Length() < 12.f &&
					Entity_IsInPlayerFOV("puppet_dynamic"))
				{
					SequenceElevatorEscape("");	
				}
				else
				{
					Map_AddTimer("Timer_StartElevator", 2.5, "Timer_StartElevator");
				}
				
				Puppet_ChangeState_Hunt("puppet_*");			
				cScript_SetGlobalVarBool("PuppetElevatorAttack",true);
				return false;
			}
			
			
			Puppet_ChangeState_Hunt("puppet_*");			
			cScript_SetGlobalVarBool("PuppetElevatorAttack",true);
			
			//////////////////////////////////////////////////////////////////////////
			// If the puppet has gotten in the Elevator, it's going to eat the player.
			if (Entity_GetCollide("Area_ElevatorPuppet","puppet_elevator")) return false;
			
			//////////////////////////////////////////////
			// If player is in the clear, start the escape
			if (Entity_IsActive("puppet_elevator")==false)
				Map_AddTimer("Timer_StartElevator", 2.5, "Timer_StartElevator");
			else
				SequenceElevatorEscape("");
								
			if (Entity_GetCollide("Area_ElevatorPuppet", msElevatorPuppet)) return false;
			////////////////////////////////////////////////////////////////////
			// Disallow attack meter so player cant get hit through doors
			cLux_AddDebugMessage("DISALLLLLOOOOOOOOOOOOW");
			AttackMeter_RemoveInstance(Map_GetEntity(msElevatorPuppet).GetID());
			Map_AddTimer("DisallowAkersAttackMeter", 5.f, "");
		
			return false;
		}
		
		bool mbAkersChargeMusic = false;
		bool CollidePuppetChargeMusic(const tString &in asParent, const tString &in asChild, int alState)
		{
			//Start tense music for Akers
			Music_Play("02_06_elevatordoor", 0.35f, false, eMusicPrio_OverrideAll);
			mbAkersChargeMusic = true;
			return false;
		}
		
		//-------------------------------------------------------
		
		void DoorPounding()
		{
			int lShakeID = Effect_Shake_Start(0.02,0.1,0,0.05);
			Effect_Shake_SetSourceEntity(lShakeID, "Area_DoorPoundEffect", 0.5, 7.5);
			ParticleSystem_CreateAtEntity("SurvivorSmashParticles", "dust_falling_impact.ps", "Area_DoorPoundEffect", false);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceElevatorEscape;
		
		void SequenceElevatorEscape(const tString &in asTimer)
		{
			Sequence_Begin("SequenceElevatorEscape", mSequenceElevatorEscape);
		
			if (Sequence_DoStepAndWait(2.55f))
			{
                if(mbAkersChargeMusic==false)
                {
                    Music_Play("02_06_elevatordoor", 0.35f, false, eMusicPrio_OverrideAll);
                    mbAkersChargeMusic = true;
                }
			}
			else if (Sequence_DoStepAndWait(1.75f))
			{
				Entity_SetActive("puppet_*",false);
				
				/////////////////////
				// Pound on door
				DoorPounding();
				Effect_Shake_Start(0.1,0.1,0,0);
				
				/////////////////////
				// Audio
				Sound_CreateAtEntity("DoorPoundSequence", "02_06_theta_tunnels/sfx/events/elevator_sequence/akers_attack", "Player");
				Sound_FadeGlobalVolume(0.35f, 3.0f, eSoundEntryType_World);

				if(mbAkersChargeMusic==true)
				{
					Depth_Audio_Fear_HighIntensity(7.0f, 10.0f, 1);
				}
				
			}
			
			else if (Sequence_DoStepAndWait(1.25f))
			{
				////////////////////////////////////
				// Deactivate all the puppets
				Entity_SetActive("puppet_*",false);
				
				/////////////////////
				// Pound on door
				DoorPounding();
				Effect_Shake_Start(0.1,0.1,0,0);
			}
			else if (Sequence_DoStepAndWait(0.75f))
			{
				/////////////////////
				// Pound on door
				DoorPounding();
				Effect_Shake_Start(0.025,0.1,0,0);
			}
			else if (Sequence_DoStepAndWait(1.0f))
			{
				
			}
			else if (Sequence_DoStepAndWait(0.75f))
			{
				Timer_StartElevator("");
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void Timer_StartElevator(const tString &in asTimer)
		{
			cLux_AddDebugMessage("Timer_StartElevator");
			////////////////////////////////////
			// Start the elevator
			Area_MoveLinearTo("ElevatorMoveArea_1","ElevatorMoveTarget",1.0f,1.0f,0.0f,true);
			SetLevelLights(true);
			Sound_CreateAtEntity("elevatorloop", "02_06_theta_tunnels/sfx/events/elevator_sequence/motor/loop", "Player");
			Map_AddTimer("Timer_ElevatorStartEffects", 0.45f, "ElevatorStartEffects");
			Map_AddTimer("ElevatorLoopSlowDuck", 3.0f, "ElevatorAudioSlowlyDuck");
			
			//Incase the door pounding event didn't occur, kill all previous puppets to stop from sound leaking
			Entity_SetActive("puppet_*",false);
		}
		
		void ElevatorAudioSlowlyDuck(const tString &in asTimer)
		{
			Sound_Fade("elevatorloop", 0.5f, 20.0f);
			cLux_AddDebugMessage("Slowly ducking elevator loop sound to build tension");
		}
		
		void ElevatorStartEffects(const tString &in asTimer)
		{
			//Slight delay for keeping in sync with audio
			Effect_Shake_Start(0.01, 0.15, 0.05, 0.5, cVector3f(0.25,1,0.25));
			Effect_Shake_Start(0.005,28.5f,0,0,cVector3f(0.25,1,0.25));
		}
		
		//-------------------------------------------------------

		bool ElevatorWallCollision(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == -1)
			{
				cLux_AddDebugMessage("Coll: "+asParent+" || " + asChild);
				if (asChild == "ElevatorMoveArea_1")
				{
					Seq_ElevatorStops("");
				}
			}
			return true;
		}
		
		//---------------------------------------------------------
		
		cSequenceStatesData mElevatorStopsSequence;
			
		void Seq_ElevatorStops(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ElevatorStops", mElevatorStopsSequence);
				
			if (Sequence_DoStepAndWait(0.25))
			{
				Effect_Rumble_Start(0.9, 0.7);
				
				Entity_SetActive("puppet_*",false);
				
				Effect_Shake_Start(0.1, 0.75, 0.0, 0.15);
				Sound_Stop("elevatorloop", 0.45f);
				Sound_CreateAtEntity("ElevatorStop", "02_06_theta_tunnels/sfx/events/elevator_sequence/motor/stop", "Player");
				Sound_CreateAtEntity("ElevatorSustained", "02_06_theta_tunnels/sfx/events/elevator_sequence/sustained_groan", "Player");
				Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_World);
				Map_AddTimer("Timer_ElevatorStopMusic", 4.0f, "ElevatorStopMusic");
			}
			else if (Sequence_DoStepAndWait(0.25))
			{
				Area_StopMovement("ElevatorMoveArea_1");
				Depth_Audio_Fear_MediumIntensity(3.0f, 10.0f, 5, false, true);
				cVector3f vOffset = Entity_GetDeltaToEntity("Elevator_Center_1","Player");
				Entity_PlaceAtEntity("Player","Elevator_Center_2",vOffset,false);				
				Player_ChangeStateToNormal();
				
				array<iPhysicsBody@> vBodies;
				GetRigidBodiesInArea("Elevator_PropMover_1", vBodies);
				
				///////////////////////////////
				// Move objects with elevator
				for (int i = 0; i < vBodies.length(); i++)
				{
					iPhysicsBody @pBody = vBodies[i];
					
					cLuxProp @pProp = cLux_ToProp(cLux_GetBodyEntity(pBody));
					if(pProp == null) continue;
				
					tString sEntityName = pProp.GetName();
					cLux_AddDebugMessage("Moving: "+sEntityName);
					
					vOffset = Entity_GetDeltaToEntity("Elevator_PropMover_1",sEntityName);
					Entity_PlaceAtEntity(sEntityName,"Elevator_PropMover_2",vOffset);
				}
			}
			else if (Sequence_DoStepAndWait(0.6))
			{
				Lamp_SetLit("BrokenElevator", false, true);
				IrradianceSet_FadeIn("elevator_shaft_dark", 0.3);
				Terminal_SetGuiActive("Elevator_BrokenTerminal", false, 0.5);
				
				if (Entity_GetCollide("Player", "ElevatorHatchCheck")==false)
				{
					Trigger_OpenElevatorHatch("", "", -1);
				}
				else
				{
					Entity_AddCollideCallback("Player", "ElevatorHatchCheck", "Trigger_OpenElevatorHatch");
				}
			}
			else if (Sequence_DoStepAndWait(0.65))
			{
				//CheckPoint_Setup();
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Lamp_SetLit("ElevatorEmergencyLamp_1", true, true);
				Map_AddTimer("ElevatorEmergencyLamp_2", 0.25, "TimerSetLampLit");
				Map_AddTimer("ElevatorEmergencyLamp_3", 0.5, "TimerSetLampLit");
				Map_AddTimer("ElevatorEmergencyLamp_4", 0.75, "TimerSetLampLit");
				IrradianceSet_FadeIn("elevator_shaft_Emergency", 1);
			}
				
			Sequence_End();
		}
		
		void ElevatorStopMusic(const tString &in asTimer)
		{
			Music_Play("02_06_elevatorstops", 0.25f, false, eMusicPrio_BigEvent);
		}
		
		//-------------------------------------------------------
		
		void GetRigidBodiesInArea(const tString &in asArea, array<iPhysicsBody@> &out avOutVector)
		{
			iLuxEntity@ pArea = Map_GetEntity(asArea, eLuxEntityType_Area);
			cBoundingVolume boundingVolume = pArea.GetBody(0).GetBoundingVolume();
			cLux_GetCurrentMap().GetPhysicsWorld().GetBodiesInAABB(boundingVolume.GetMin(), boundingVolume.GetMax(), avOutVector);
			
			for (int i = 0; i < avOutVector.length(); i++)
			{
				iPhysicsBody @pBody = avOutVector[i];
				
				if(pBody.IsActive()==false || pBody.GetMass()==0)
				{
					avOutVector.removeAt(i);
					i--;
					continue;
				}
				
				iLuxEntity @pEntity = cLux_GetBodyEntity(pBody);
				if(pEntity == null || Entity_GetCollide(pEntity.GetName(), asArea)==false)
				{
					avOutVector.removeAt(i);
					i--;
				}
			}
		}
	
		//} END Elevator Starts
	
