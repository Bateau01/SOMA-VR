		bool AreaTriggerFinalPuppet(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("puppet_tunnel",true);
			
			Button_SetDisabled("TunnelPuppetDoor_Panel*", true, false);
			
			Pathfinder_Track_Clear("puppet_tunnel");
			Pathfinder_Track_Add("puppet_tunnel", "PathNodeArea_107");
			Pathfinder_Track_Start("puppet_tunnel",true,1,"");
			
			AttackMeter_SetCustomDamageCallback("TunnelPuppetDamage");
						
			Puppet_ChangeState_Hunt("puppet_tunnel");
			BarkMachine_SetActive("puppet_tunnel", false);
			Map_AddTimer("RevealPlayerPos", 0.25, "Timer_RevealPlayerPos");
			
			SlideDoor_SetClosed("elevator_doors_2", true, true);
			Sound_Stop("puppet_tunnel_SpotPlayer", 0.05f);
			Entity_SetActive("blockbox_stopplayer_*",true);
			Player_SetMoveSpeedMul(0.875f);
			
			return false;
		}
				
