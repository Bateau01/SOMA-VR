	////////////////////////////
	// The player has died.
	void OnPlayerKilled(int alRecentDeaths, const tString&in asSource)
	{
		//cLux_AddDebugMessage("OnPlayerKilled");
		Dialog_StopAll();
		
		cLux_AddDebugMessage("OnPlayerKilled "+asSource+ " deaths : " +alRecentDeaths);
		
		if (asSource == "puppet_dynamic" && alRecentDeaths >= 2)
		{
			Entity_SetActive("puppet_dynamic",false);
		}
	}

