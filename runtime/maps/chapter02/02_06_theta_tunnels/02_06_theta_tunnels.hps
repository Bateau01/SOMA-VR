		//////////////////////////////////////////////////////////////////
		// Event: Player breaks the window to get access to Brandons corpse
		//////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		void OnWindowBreak(const tString &in asEntity)
		{
			cLux_AddDebugMessage("Window is broken!");
			Puppet_SetAgressionAmount("puppet_dynamic",0.8);
			Sound_CreateAIEventAtEntity("Player",75.0f,10);
			
			if (cLux_GetExplorationModeActive() == false) return;
			Puppet_ForceHideAndWaitAppearance("puppet_dynamic");
		}
		
		//-------------------------------------------------------
		
		//////////////////////////////////////////
		// Handle enabling/disabling of puppet senses if taking window route
		bool CollideEnablePuppetSenses(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (Button_IsLocked("probesimulation_doorpanel_1") == false) return true;
			if (alState != 1) return true;
			
			Entity_SetActive("Trigger_EnablePuppetSenses_*", false);
			
			cLux_AddDebugMessage("Senses Enabled");
			Agent_SetSensesActive("puppet_dynamic",true);
			Puppet_SetAgressionAmount("puppet_dynamic",1.0f);
			return true;
		}
		
		//-------------------------------------------------------
		
		bool CollideDisablePuppetSenses(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (Button_IsLocked("probesimulation_doorpanel_1") == false) return true;
			if (alState != 1) return true;
			
			Entity_SetActive("Trigger_EnablePuppetSenses_*", true);
			
			Agent_SetSensesActive("puppet_dynamic",false);
			cLux_AddDebugMessage("Senses Disabled");
			Puppet_SetAgressionAmount("puppet_dynamic",0.0f);
			return true;
		}
		
		
