			StationGuiBG_Scanlines();
			StationGuiBG_Taskbar("theta");
			
			Depth_ImGui_AddTextFile("MastersTerminalFileName_1", "MastersTerminalFile_1");
			Depth_ImGui_AddTextFile("MastersTerminalFileName_2", "MastersTerminalFile_2");
			Depth_ImGui_AddTextFile("MastersTerminalFileName_3", "MastersTerminalFile_3");
			Depth_ImGui_AddTextFile("MastersTerminalFileName_4", "MastersTerminalFile_4");
			StationGui_TextReaderMulti();
