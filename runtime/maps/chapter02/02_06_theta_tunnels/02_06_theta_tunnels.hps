		//-------------------------------------------------------
		
		bool CollideARKCheckpoint(const tString &in asParent, const tString &in asChild, int alState)
		{
			/* This should not be called - area was removed */
			cLux_AddTodoMessage("SCRIPT: CHECKPOINT SHOULD NOT BE USED, AREA HERE - REMOVE IT!");
			
			Entity_SetActive(asChild,false);
			CheckPoint_Setup();
			return false;
		}
		
		//-------------------------------------------------------
		
		bool Trigger_LeftARKRoomCheckpoint(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			
			Map_AddTimer("StartAmbient", cMath_RandRectf(10.f,15.f), "AmbientMusicHandler");
			CheckPoint_Setup("MainAreaCheckpoint");
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void MainAreaCheckpoint(int alRecentDeaths, const tString&in asDeathSource)
		{
			Entity_SetActive(asDeathSource, false);
		}
		
		//-------------------------------------------------------
		
		bool CollideBrandonCheckpoint(const tString &in asParent, const tString &in asChild, int alState)
		{
			///////////////////////
			// Brandon Checkpoint only works if puppet is not near and we want the player to have taken the chip first.
			if(Puppet_IsHidingAndWaiting("puppet_dynamic")==false) return true;
			if (mbTookBrandonChip == false) return true;
			
			CheckPoint_Setup("MainAreaCheckpoint");
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void FinalDeathCheckpoint(int alRecentDeaths, const tString&in asDeathSource)
		{
			cLux_AddDebugMessage("Final Checkpoint - No reload will be issued");
		}
		
		//-------------------------------------------------------
		
		void CheckpointTookRepairedChip(int alRecentDeaths, const tString&in asDeathSource)
		{
			Entity_SetActive(asDeathSource, false);
			
			////////////////////////////////////////////////////////////
			// If player has died after taking formatted chip - disable the puppet encounters near here
			Entity_SetActive("Area_SecurityPuppet_*", false);
			Entity_SetActive("Area_ChemlabPuppet", false);
		}
		
