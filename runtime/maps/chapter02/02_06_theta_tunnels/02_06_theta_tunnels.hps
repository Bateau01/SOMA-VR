	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		CathTool_ResetScreen(eCathToolVariant_CathDelta);
		
		//////////////////////////////////////////
		// Player setup
		Player_SetMoveSpeedMul(1); //Might be 0 if preload locked the player
		
		Player_SetAmbientLight_Indoors();
		
		PlayerHands_SetHandModel_Diving();
		
		PlayerEnergy_SetFlowerSwallows(true);
		
		SetupArkRoom();
		SetupAirlocks();
		SetupPanelClamps();
		SetupProjectors();
		SetupCatherine();
		SetupBrandon();
		
		bool bDoIntro = true;
		
		///////////////////////////////////////////
		// Entity Setup
		Entity_PlayAnimation("puppet_victim_1", "puppet_victim_lying_against_wall", 0, true, true);
		Entity_PlayAnimation("puppet_victim_2", "puppet_victim_lying", 0, true, true);
		Entity_PlayAnimation("puppet_victim_masters", "puppet_victim_sitting_in_chair", 0, true, true);
		
		///////////////////////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			bDoIntro = false;
		}
		
		if (bDoIntro)
		{
			//Effect_Fade_Out(0.0f);
			//Effect_Fade_In(5.0f);
		}
		
		//////Level Audio and Preloads	
		Sound_PreloadProject("02_06_theta_tunnels");
		Sound_PreloadGroup("Flashback/Level/02_06", true);
		Sound_Fade("broken_tv_sweet", 0.0f, 0.0f);
		
		// re-enable fall damage after transition
		Player_SetFallDamageActive(true);
		
		if(cLux_ScriptDebugOn()==false)
		{
			//Sound_PlayGui("Player/landing/default_fake_soft", 1.0f, eSoundEntryType_GuiWorld);
			//Depth_Audio_SimonGasp();
			//Map_AddTimer("LandingBreathing", 1.0f, "LevelStart_LandingBreathing");
		}
		
		/////////////////////////
		// Eye tracking
		EyeTracking_RegisterEntity("puppet_victim_1", true, false, true, 15.0f, 4.0f);
		EyeTracking_RegisterEntity("interact_idbadge_1", true, false, true, 15.0f, 4.0f);
		
		LastOnSoma_SetText("02_06_theta_tunnels_1");
	}

