	//Cath voice source inside scanner
	bool mbInsideScanner = false;
	bool CathVoiceSourceScanner(const tString &in asParent, const tString &in asChild, int alState)
	{	
		if(alState==1)
		{
			Voice_SetSource("Catherine","CathVoiceSourceScanner",3,30,false,-1);
			cLux_AddDebugMessage("Cath voice source inside scanner");
			mbInsideScanner = true;
			cLux_AddDebugMessage(" ////////////////////////////IS INSIDE SCANNER\\\\\\\\\\\\\\\\\\\\\\\\\\");
		}
		else
		{
			Voice_SetSource("Catherine","CathTool",3,35,false,-1,0,3250,eLuxVoiceSourceFreqencyFlag_HighPass);
			cLux_AddDebugMessage("Cath voice source not inside scanner");
			mbInsideScanner = false;
		}
		return true;
	}
		
