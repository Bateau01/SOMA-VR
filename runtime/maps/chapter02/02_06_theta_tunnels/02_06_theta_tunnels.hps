		void SetupCatherine()
		{
			Tool_PickUp("CathTool", false, false);
		}
		
		bool mbLightsOut = false;
		
		void SetLevelLights(bool abOn)
		{
			cLux_AddTodoMessage("SOUND: Clunk as the lights go off please!");
			if(mbLightsOut==false)
			{
				Sound_PlayGui("02_06_theta_tunnels/sweeteners/lights_out",1.0f);
				Sound_PlayGui("02_06_theta_tunnels/sweeteners/lights_out_room_shake",1.0f);
				Sound_FadeGlobalVolume(0.6f, 0.75f, eSoundEntryType_World);
				Map_AddTimer("FadeUpWorld", 2.0f, "FadeUpWorldLightsOut");
			}
			Map_AddTimer("StopAmbientMusicQuickly", 1.0f, "AmbientMusicHandler");
			Entity_SetActive("BrandMusicControl", false);
			Entity_SetActive("SecurityOfficeMusicControl", false);
			Entity_SetActive("Area_EmptyBedMusicTrigger_*", false);
			mbAmbientMusicAllowed = false;
			mbLightsOut = true;
			
			Map_AddTimer("LightsOutMusic", 1.0f, "LightsOutMusic");
			
			//////////////////////////////////////
			// Lights out!
			cLux_AddDebugMessage("Lights toggled");
			Lamp_SetLit("fluorescent_tube_curved_special_*",abOn,true);
			Lamp_SetLit("door_lamp_*",abOn,true);
			Lamp_SetLit("theta_wall_small_1",abOn,true);
			/*Light_SetVisible("PointLight_35",abOn);
			Light_SetVisible("PointLight_36",abOn);
			Light_SetVisible("SpotLight_26",abOn);*/
			
			//Remove ventilation and distant coral spot triggers
			Entity_SetActive("Area_MindCoralSounds_*", false);
			Entity_SetActive("Area_CoralSoundsArea_*", false);
			Map_RemoveTimer("ResetCoralSoundAreas");
			
			//////////////////////////////////
			//Remove music areas for events no longer needed
			Entity_SetActive("Area_EmptyBedMusicTrigger", false);
			Entity_SetActive("Area_EmptyBedMusicTrigger_1", false);
			
			Light_SetVisible("corridor_amb_*",abOn);
			Billboard_SetVisible("corridor_billboard_*",abOn);
			
			float fBright = 0.007f;
			if (abOn == false) fBright = 0.0f;
			
			Light_SetBrightness("BoxLight_8",fBright);
		}
		
		void SetLampFlicker(bool abOn)
		{
			//////////////////////////////////////
			// Lights flicker!
			cLux_AddTodoMessage("SOUND: Flicker sounds?");
			Lamp_SetFlickerActive("fluorescent_tube_curved_special_*",abOn);
			Lamp_SetFlickerActive("door_lamp_*",abOn);
			Lamp_SetFlickerActive("theta_wall_small_1",abOn);

		}
		
		void FadeUpWorldLightsOut(const tString &in asTimer)
		{
			Sound_FadeGlobalVolume(1.0f, 5.0f, eSoundEntryType_World);
		}
		
		//-------------------------------------------------------
		
		/////////////////////////////
		// FLICKERING LIGHTS BUILD UP
		/////////////////////////////
		
		//-------------------------------------------------------
		float mfFlickerAreaIntensity = 0.0f;
		float mfTimeToNextLightFlicker = 30.0f;
		float mfLengthOfLevelFlicker = 2.0f;
		//-------------------------------------------------------
		
		bool OnCollideLightsBuildup(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			if (!mbAkersSpawned) return true;
			if (mbLightsOut) return false;
			
			
			/* The user var of the area contains a value, this is added to the intensity value for the map.
			 * Once this hits a certain threshold, we have the lights go out completely rather than just flicker.
			   Meaning we can make certain areas add more to this score, i.e the deeper you are in to the level
			   the worse things get */
			
			int fIntensity = Entity_GetVarFloat(asChild,"");
			if (fIntensity < 1.0f)
				fIntensity = 1.0f;
				
			//////////////////////////////
			// If you have Brandons chip, things are worse
			if (mbTookBrandonChip)
			{
				fIntensity *= 1.5f;
			}
			if (mbPuppetSpawnedAtSecurity)
			{
				fIntensity *= 1.5f;
			}
			
			mfFlickerAreaIntensity += fIntensity;
					
			if (mbTookBrandonChip == false)
			{
				mfFlickerAreaIntensity = cMath_Clamp(mfFlickerAreaIntensity,0.0f,19.0f);
			}
			else
			{
				mfFlickerAreaIntensity = cMath_Clamp(mfFlickerAreaIntensity,15.0f,20.0f);
			}	
			
			////////////////////////////////
			// Lights out past certain amount
			if (mfFlickerAreaIntensity >= 20 && mbTookBrandonChip)
			{
				DoLightsOutEvent();
			}

			///////////////////////////////////////////////////
			// When we pass through the area, we add a long delay before this area can be triggered again
			tString sTimerName = "timer_reenable_"+asChild;
			if (Map_TimerExists(sTimerName)) return true;
			float fTimeToReenable = cMath_RandRectf(25.0f,35.0f);
			Map_AddTimer(sTimerName,fTimeToReenable,"TimerReenableFlickerArea");
			cLux_AddDebugMessage("Flicker area " + asChild + " has been passed and will reactivate in " + fTimeToReenable);
			
			/////////////////////////////////
			// If lights are already flickering, just return
			if (Map_TimerExists("timer_TimerPreventLevelFlicker")) return true;
			
			//////////////////////////////////////////////////
			// Start lights flickering
			Map_AddTimer("timer_TimerStopLevelFlicker",fIntensity + 3.0f,"TimerStopLevelFlicker");
			Map_AddTimer("timer_TimerPreventLevelFlicker",fIntensity + cMath_RandRectf(4.5f,9.5f),"TimerReenableFlickerArea");
			SetLampFlicker(true);
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void DoLightsOutEvent()
		{
			if (Map_TimerExists("timer_lightsout") == false)
			{
				Map_AddTimer("timer_lightsout",cMath_RandRectf(4.0f,6.0f),"TimerLightsOut");
			}
		}
		
		//-------------------------------------------------------
		
		void TimerLightsOut(const tString &in asTimer)
		{
			SetLevelLights(false);
			SetLampFlicker(false);
			
			Puppet_SetAgressionAmount("puppet_dynamic",1.0f);
		}
		
		//-------------------------------------------------------
		
		void TimerStopLevelFlicker(const tString &in asTimer)
		{
			if (mbLightsOut) return;
			
			//////////////////////////////////////
			// We stop the lamps from flickering
			SetLampFlicker(false);
		}
		
		//-------------------------------------------------------
		
		void TimerReenableFlickerArea(const tString &in asTimer)
		{
			cLux_AddDebugMessage(""+asTimer);
		}
		
		//-------------------------------------------------------
		
		// Temporarily disable control panels while door is opening
		void SlidingDoorLock(const tString &in asEntity, int alState)
		{			
			///////////////////////////////////////////////////////////////
			// Get wildcard (each door uses similarly named control panels)
			tString sLastChar = cString_GetLastChar(asEntity);
			tString sEntity = cString_ReplaceCharTo(asEntity,sLastChar,"*");
			
			Entity_SetInteractionDisabled(sEntity,true);	
			Map_AddTimer(sEntity,0.25,"SlidingDoorUnlock");
		}

		//-------------------------------------------------------
		
		//////////////////////////////////
		// Re-enable disabled door panels
		void SlidingDoorUnlock(const tString &in asTimer) 
		{
			Entity_SetInteractionDisabled(asTimer,false);
		}
		
		
		//-------------------------------------------------------
		
		//Turns off office sparks when player is not in Brandon office to stop sound leak
		bool Trigger_OfficeSpark(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState==1)
			{
				//Light_SetVisible("sleved_open_animated01_1_big", true);
				cLux_AddDebugMessage("Turn on office spark");
				Light_SetFlickerActive("sleved_open_animated01_1_big", true);
				Sound_Play("sleved_open_animated01_1_spark", 1.0f);
				Sound_Fade("broken_tv_sweet", 1.0f, 3.0f);
			}
			else
			{
				Sound_Fade("broken_tv_sweet", 0.0f, 3.0f);
			}
			return true;
		}
		
		bool Trigger_OfficeSparkOff(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Turn off office spark");
			Light_SetFlickerActive("sleved_open_animated01_1_big", false);
			Sound_Stop("sleved_open_animated01_1_spark", 1.0f);
			Light_SetVisible("sleved_open_animated01_1_big", false);
			return true;
		}
		
