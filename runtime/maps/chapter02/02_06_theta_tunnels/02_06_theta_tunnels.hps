	//-------------------------------------------------------
	
		///////////////////////////////////////////
		// Event: Brandon's corpse.
		//{////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbRecognizedBrandon = false;
		bool mbTookBrandonChip = false;
		
		//-------------------------------------------------------
		
		void SetupBrandon()
		{
			Map_AddTimer("Timer_AttachBrandonHand", 5, "Timer_AttachBrandonHand");
		}
		
		void Timer_AttachBrandonHand(const tString &in asTimer)
		{
			StickyArea_AttachEntity("BrandonNeck_StickyArea_1", "brandon_corpse_1", "Body_7");
		}
		
		//-------------------------------------------------------
		
		void LookAt_BrandonCorpse(const tString &in asEntity, int alState)
		{
		}
		
		//-------------------------------------------------------
		
		void brandon_corpse_id_1_OnPlayerInteract(const tString &in asEntity)
		{
			///////////////////////////////////////
			// Disable large interact aux area on the badge after first time using it
			Entity_SetActive("interact_idbadge_1",false);
		}
		
		//-------------------------------------------------------
		
		void Interact_BrandonChip(const tString &in asEntity)
		{
			Entity_CallEntityInteract("brandon_corpse_1", "hand_body");
		}
		
		//-------------------------------------------------------

		void BrandonNeck_StickyArea_Detach(const tString &in asStickyArea, const tString &in asBodyName)
		{
			////////////////////////////////////////////////////
			// Tool is picked up
			// H5756AV_VR_THETA_TUNNELS_SAME_GRIP_DETACH
			if (_HPL3VR_RuntimeActive_ThetaTunnelsAT())
				cScript_RunGlobalFunc("VROMNITHETA", "chip_unformatted", "R");
			Entity_CallEntityInteract("chip_unformatted");
			Entity_SetActive("brandon_chip_interact",false);
			Player_ChangeStateToNormal();
			Sound_CreateAtEntity("BreakBrandon", "02_06_theta_tunnels/sfx/brandon_hand/break", asStickyArea);
			mbAmbientMusicSecondStage = true;
			
			////////////////////////////////////////
			// Simon remarks after extracting the chip
			if (mbRecognizedBrandon)
				BrandonChipRemoveComment(0.05f);
			mbTookBrandonChip = true;
			
			Entity_SetActive("Area_SecurityPuppet_1", true); //So we get the proper values setup!
			
			Puppet_SetComeOutOfHidingTimeMul("puppet_dynamic", 0.7f);
			
			/////////////////////////////////////////
			// Puppet activation area will now activate
			Entity_SetActive("Area_LeaveBrandon",true);
			
			////////////////////////////////////////
			// Disable previous puppets
			Entity_SetActive("puppet_security",false);
			Entity_SetActive("puppet_chemlab",false);
			
			/////////////////////////////////////////
			// Make datamining easier
			Entity_SetActive("DatamineArea_Brandon_Aux*", true);
		}
		
		//-------------------------------------------------------
		
		void BrandonChipRemoveComment(float afDelay)
		{
			if (mbRecognizedBrandon && mbTookBrandonChip)
				return;
			
			if(Puppet_IsHidingAndWaiting("puppet_dynamic")==false)
				return;
				
			Map_AddTimer("BrandonChipRemoveComment", afDelay + 1.45f, "Timer_BrandonChipRemoveComment");
			Map_AddTimer("StopAmbientMusic", afDelay, "AmbientMusicHandler");
		}
		
		//-------------------------------------------------------
		
		void Timer_BrandonChipRemoveComment(const tString &in asTimer)
		{
			Voice_Play("1_ExtractChip");
			Map_AddTimer("StartAmbient", 11.f, "AmbientMusicHandler");
		}
		
		//-------------------------------------------------------
		
		void security_chip_unformatted_OnPlayerInteract(const tString &in asEntity)
		{
            // VR removal is a single acquisition; ignore a replay after ownership.
            if (_HPL3VR_RuntimeActive_ThetaTunnelsAT() && Player_ToolIsInInventory("chip_unformatted")) return;
			//////////////////////////////////////////////
			// Player takes the unformatted chip
			cLux_AddDebugMessage("Player gets the unformatted chip");
			Entity_SetActive("security_chip_unformatted",false);
			Entity_SetActive("security_chip_formatted",false);
			
			/////////////////////////////////////////////
			// Call interact to get the tool back
			// H5756AV_VR_THETA_TUNNELS_SAME_GRIP_DETACH
			if (_HPL3VR_RuntimeActive_ThetaTunnelsAT())
				cScript_RunGlobalFunc("VROMNITHETA", "chip_unformatted", "R");
			// H5756AT_VR_THETA_TUNNELS_PHYSICAL_CHIP_RETURN
			if (_HPL3VR_RuntimeActive_ThetaTunnelsAT())
            {
                Entity_SetVarString("chip_unformatted","VRReturnArea","Area_InsertUnformattedChip");
                Entity_PlaceAtEntity("chip_unformatted", "security_chip_unformatted");
            }
			Entity_CallEntityInteract("chip_unformatted");
			
			Sound_Stop("InsertChip", 1.0f);
			Sound_CreateAtEntity("RemoveChip", "Entities_Station/object/memchip/remove", "ChipSoundArea");
		}
		
		//-------------------------------------------------------
		
		void TakeFormattedChip(const tString &in asEntity)
		{
			Entity_SetActive(asEntity,false);
			Entity_CallEntityInteract("security_chip_formatted");
		}
		void security_chip_formatted_OnPlayerInteract(const tString &in asEntity)
		{
            // VR removal is a single acquisition; ignore a replay after ownership.
            if (_HPL3VR_RuntimeActive_ThetaTunnelsAT() && Player_ToolIsInInventory("door_panel_chip_formatted")) return;
			/////////////////////////////////////////////
			// Player takes the freshly formatted chip
			cLux_AddDebugMessage("Player gets the formatted chip");
			Entity_SetActive("security_chip_unformatted",false);
			Entity_SetActive("security_chip_formatted",false);
			
			Sound_Stop("InsertChipUnformatted", 1.0f);
			Sound_CreateAtEntity("RemoveChip", "Entities_Station/object/memchip/remove", "ChipSoundArea");
			
			////////////////////////////////////////////
			// Equip the tool
			// H5756AV_VR_THETA_TUNNELS_SAME_GRIP_DETACH
			if (_HPL3VR_RuntimeActive_ThetaTunnelsAT())
				cScript_RunGlobalFunc("VROMNITHETA", "door_panel_chip_formatted", "R");
			// H5756AT: the formatted Prop_Tool is authored elsewhere in the map; move
			// it to the security-terminal chip presentation before VR physicalizes it.
			if (_HPL3VR_RuntimeActive_ThetaTunnelsAT())
            {
                Entity_SetVarString("door_panel_chip_formatted","VRReturnArea","Area_InsertUnformattedChip");
                Entity_PlaceAtEntity("door_panel_chip_formatted", "security_chip_formatted");
            }
			Tool_PickUp("door_panel_chip_formatted", true, true);

			///////////////////////
			// Threat level increase
			Puppet_SetAgressionAmount("puppet_dynamic", 1.0f);
			float fMul = cLux_GetExplorationModeActive() ? 0.3f : 0.15f;
			Puppet_SetComeOutOfHidingTimeMul("puppet_dynamic", fMul);
			
			
			Map_AddTimer("timerTurnOffLights",3.0f,"TimerTurnOffLights");
				
			////////////////////////////////////////////
			// Setup checkpoint
			Map_AddTimer("Timer_RepairedChipCheckpoint", 1, "Timer_RepairedChipCheckpoint");
			
			////////////////////////////////////////////
			// Disable ability to click on broken panel area and get zapped
			mbPlayerZapped = true;
			
			if (cLux_GetExplorationModeActive() == false) return;
			Puppet_ForceHideAndWaitAppearance("puppet_dynamic");
		}
		
		//-------------------------------------------------------

		void TimerTurnOffLights(const tString &in asTimer)
		{
			//////////////////////////////
			// Lights off very soon!
			DoLightsOutEvent();
		}
		
		//-------------------------------------------------------
		
		void Timer_RepairedChipCheckpoint(const tString &in asTimer)
		{
			/////////////////////////////////////////////
			// Only works if puppet is in hiding.
			if (Puppet_IsHidingAndWaiting("puppet_dynamic")==false) return;
			
			CheckPoint_Setup("CheckpointTookRepairedChip");
		}
		
