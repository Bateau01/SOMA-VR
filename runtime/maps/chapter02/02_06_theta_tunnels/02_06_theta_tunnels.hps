	bool StartingVentAkersSound(const tString &in asParent, const tString &in asChild, int alState)
	{
		Sound_CreateAtEntity("AkersVentSound_"+asChild, "02_06_theta_tunnels/sweeteners/akers_stuff/akers_vent", "AkersSoundSourceVent");
		Entity_SetActive(asChild, false);
