		//-------------------------------------------------------
		
		//} END Event Cath comments.
		
			/////////////////////////////////////////
			// Scene 1 - Body Scanner
			//{//////////////////////////////////////
			
			//-------------------------------------------------------
			
			bool mbScannerLookedAt = false;
			bool mbScanPending = false;
			bool mbScannerExamineVoiceTriggered = false;
			bool mbScannerExamineVoiceActive = false;
			bool mbScanDoorOpenDucked = false;
			
			//-------------------------------------------------------
			
			void OnGui_OuterScanTerminal(const tString&in asEntityName, float afTimeStep)
			{
				ImGui_SetTransCategory("02_06_theta_tunnels");
				
				StationGuiBG_Backdrop();
				StationGuiBG_Scanlines();
				
				StationGui_BigStatusMessage_Old(Entity_GetVarString(asEntityName, ""), gStationGuiColor_Warning, 2);
			}
			
			//-------------------------------------------------------
			
			void OnChange_ScannerDoorButton(const tString &in asEntity, int alState)
			{				
				cLux_AddDebugMessage("Scanner Door "+alState);
				
				if (mbScannerExamineVoiceTriggered==false)
				{
					mbScannerExamineVoiceTriggered = true;
					Map_AddTimer("Timer_VoiceOnScanDoorButtonPress", 1.5, "Timer_VoiceOnScanDoorButtonPress");
					Doorway_SetPlayerIsInGroup("Scanner", false);
				}
				
				if (mbScannerExamineVoiceActive)
				{
					//Sound_FadeGlobalVolume(0.45, 1.5f);
					mbScanDoorOpenDucked = true;
				}
					
				if(alState==1)
				{
					Entity_PlayProcAnimation("ScannerDoor", "Open", 1.5, false, 0);
					Map_AddTimer("OpenScannerDoor", 1.5, "Timer_OpenScannerDoor");
					
					Audio_ScannerDoor_Open();
					//Map_AddTimer("Timer_UnduckScannerDoorSound", 4.5, "UnduckScannerDoorSound");
				}
				else
				{
					SlideDoor_SetClosed("ScannerDoor", true);
					Map_AddTimer("CloseScannerDoor", 0.1, "Timer_CloseScannerDoor");
					Prop_MoveLinearTo("ScannerBridge", "ScannerBridge_target_out", 2, 2, 0.15f, true);
				}
			}
			
			//-------------------------------------------------------
			
			void Timer_OpenScannerDoor(const tString &in asTimer)
			{
				cLux_AddDebugMessage("Timer_OpenScannerDoor");
				SlideDoor_SetClosed("ScannerDoor", false);
				Prop_MoveLinearTo("ScannerBridge", "ScannerBridge_target", 1, 1, 0.5f, true);
			}
			
			//-------------------------------------------------------
			
			void Timer_CloseScannerDoor(const tString &in asTimer)
			{
				if (SlideDoor_GetOpenAmount("ScannerDoor") > 0.05)
					Map_AddTimer("CloseScannerDoor", 0.1, "Timer_CloseScannerDoor");
				else
					Entity_PlayProcAnimation("ScannerDoor", "Open", -0.5, false, 0);
			}
			
			//-------------------------------------------------------
			
			void UnduckScannerDoorSound(const tString &in asTimer)
			{
				if (mbScanDoorOpenDucked==false) return;
				
				Sound_FadeGlobalVolume(1, 3.0f);
				mbScanDoorOpenDucked = false;
			}
			
			//-------------------------------------------------------
			
			void Timer_VoiceOnScanDoorButtonPress(const tString &in asTimer)
			{
				Voice_PlayWhenPossible("1_ExaminesScanner", "VoiceCondition_ExaminesScanner", -1, 0.25, "VoiceOver_ExaminedScanner", 0);
			}
			
			//-------------------------------------------------------
			
			void LookAt_Scanner(const tString &in asEntity, int alState)
			{
				mbScannerLookedAt = alState==1;
				if (alState==-1 || mbScannerExamineVoiceTriggered || CathTool_IsInserted("CathTool")==false)
					return;
				
				mbScannerExamineVoiceTriggered = true;
				Voice_PlayWhenPossible("1_ExaminesScanner", "VoiceCondition_ExaminesScanner", -1, 0.25, "VoiceOver_ExaminedScanner", 0);
				Doorway_SetPlayerIsInGroup("Scanner", false);
			}
			
			//-------------------------------------------------------
			
			bool VoiceCondition_ExaminesScanner(const tString&in asSubject)
			{
				if (mbKnowsAboutScanner)
					return false;
					
				if (Doorway_PlayerIsInGroup("Scanner")==false && mbScannerLookedAt==false)
					return false;
					
				return true;
			}
            
			//-------------------------------------------------------
			
			void Line_ExaminesScanner(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStartOfLine)
			{
				if (abStartOfLine == false)
					return;

				mbKnowsAboutScanner = true;
                
                Map_AddTimer("ScannerDoorSoundControl", 0.05f, "ScannerDoorSoundControl");

				mbScannerExamineVoiceActive = true;
			}
            
			//-------------------------------------------------------
			
            void LineOver_ExamineScanner(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStartOfLine)
            {
                if(abStartOfLine) 
                    return;
                
                
                Map_RemoveTimer("ScannerDoorSoundControl");
                Music_FadeVolumeMul(1.0f, 3.5f);
                
                if(Sound_Exists("ScannerDoorOpen"))
                {
                    Sound_Fade("ScannerDoorOpen", 1.0f, 2.0f);
                }
            }
            
			//-------------------------------------------------------
			
            void ScannerDoorSoundControl(const tString &in asTimer)
            {
                if(Sound_Exists("ScannerDoorOpen"))
                {
                    Sound_Fade("ScannerDoorOpen", 0.45f, 2.0f);
                    Music_FadeVolumeMul(0.45f, 2.0f);
                }
                else
                {
                    Map_AddTimer("ScannerDoorSoundControl", 0.05f, "ScannerDoorSoundControl");
                }
            }
			
			//-------------------------------------------------------
			
			void VoiceOver_ExaminedScanner(const tString&in asScene, const tString&in asSubject)
			{
				mbScannerExamineVoiceActive = false;
					
				if (Doorway_PlayerIsInGroup("Scanner"))
				{
					UnduckScannerDoorSound("");
					StartScanning();
				}
				else
				{
					mbScanPending = true;
					Voice_Play("1_ExaminesScanner_2_Outside", -1, "VoiceOver_ExaminedScanner_Extra", 0);
				}
			}
			
			//-------------------------------------------------------
			
			void VoiceOver_ExaminedScanner_Extra(const tString&in asScene, const tString&in asSubject)
			{
				UnduckScannerDoorSound("");
			}
			
			//-------------------------------------------------------
			
			bool Doorway_EnteredScanner(const tString &in asArea, const tString &in asEntity, int alState)
			{
				cLux_AddDebugMessage("ScannerDoorway "+alState);
				if (mbScanPending == false)
					return true;

				if (alState == -1)
					return true;
				
				StartScanning();
				return true;
			}
			
			//-------------------------------------------------------
			
			bool Trigger_ScanChamberTableInScanner(const tString &in asParent, const tString &in asChild, int alState)
			{
				if (mbScanPending == false)
					return true;
					
				if (alState == 1 || Doorway_PlayerIsInGroup("Scanner")==false)
					return true;
					
				StartScanning();
				return false;
			}
			
			//-------------------------------------------------------
			
			void StartScanning()
			{
				Entity_SetActive("ScannerTableCheck", false);
				
				Terminal_SetGuiActive("Scanner_ExtTerminal", false);
				Button_SetSwitchedOn("ScannerDoor_Button", false, true);
				Audio_ScannerDoor_Close();
				Entity_SetActive("ScannerDoor_Blocker", true);
				Map_AddTimer("Timer_StartScanningDialog", 4, "Timer_StartScanningDialog");
			}
			
			//-------------------------------------------------------
			
			void Timer_StartScanningDialog(const tString &in asTimer)
			{
				Entity_SetActive("ScannerDoorway", false);
				Dialog_StopAll();
				Voice_Stop("Dialog");
				Voice_Play("1_EnteredScanner", -1, "VoiceOver_EnteredScanner");
			}
			
			//-------------------------------------------------------
			
			void VoiceOver_EnteredScanner(const tString&in asScene, const tString&in asSubject)
			{
				Button_SetDisabled("ScannerButton", false, true);
			}
			
			//-------------------------------------------------------
			
			void OnChange_ScannerButton(const tString &in asEntity, int alState)
			{
				Seq_ScannerScanning("");
			}
			
			//-------------------------------------------------------
			
			cSequenceStatesData mScannerScanningSequence;
				
			void Seq_ScannerScanning(const tString &in asTimer)
			{
				Sequence_Begin("Seq_ScannerScanning", mScannerScanningSequence);
					
				if (Sequence_DoStepAndWait(1))
				{
					StopArkLabMusic();
					Audio_ScannerStart();
					Terminal_SetGuiActive("Scanner", true, 1);
					Terminal_SetGuiActive("Scanner_SideTerminal", true, 1);
					Light_FadeTo("ScannerTerminalLight", cColor(0.702,0.875,1,0), -1, 1);
					Prop_RotateToSpeed("ScannerArm", 0.75, 5, true, "");
					Entity_SetEffectsActive("ScannerArm", true, true);
					Entity_SetEffectsActive("Scanner", false, true);
					Sound_CreateAtEntity("ScanTelemetry", "02_06_theta_tunnels/sfx/nuclear_scanner/scan_telemetry", "ScanScreenLookAt");
				}
				else if (Sequence_DoStepAndWait(1))
				{
					Light_SetFlickerActive("ScannerTerminalLight", true);
				}
				else if (Sequence_DoStepAndWait(1))
				{
					Terminal_IncImGuiStateInt("Scanner", "ScanState", 1);
				}
				else if (Sequence_DoStepAndPause(0.5))
				{
					Sound_FadeGlobalVolume(0.7f, 5.0f);
					Voice_Stop("Dialog");
					Dialog_Begin();
						Dialog_AddBranch("1_ScannerScanning_1", "1_ScannerScanning_2_NotLooking");
							Dialog_AddSubject("1_ScannerScanning_1", "Subject_ScannerScanning");
							Dialog_AddPause(1.5);
							Dialog_AddEndEvent_Callback("DialogEvent_LookingAtScreen", "1_ScannerScanning_2_Looking");
						Dialog_AddBranchAndSubject("1_ScannerScanning_2_NotLooking", "1_ScannerScanning_3");
						Dialog_AddBranchAndSubject("1_ScannerScanning_2_Looking", "1_ScannerScanning_3");
						Dialog_AddBranchAndSubject("1_ScannerScanning_3", "", "Subject_ScannerScanning");
					Dialog_End(); 
				}
				else if (Sequence_DoStepAndPause(0.1))
				{
					Terminal_IncImGuiStateInt("Scanner", "ScanState", 1);
				}
				else if (Sequence_DoStepAndPause(0.1))
				{
					Terminal_IncImGuiStateInt("Scanner", "ScanState", 1);
				}
				else if (Sequence_DoStepAndPause(0.1))
				{
					cLux_AddDebugMessage("Music here 3");
					Terminal_IncImGuiStateInt("Scanner", "ScanState", 1);
				}
				else if (Sequence_DoStepAndPause(0.1))
				{
					cLux_AddDebugMessage("Music here 4");
					Terminal_IncImGuiStateInt("Scanner", "ScanState", 1);
				}
				else if (Sequence_DoStepAndPause(0.1))
				{
					cLux_AddDebugMessage("Music here 5");
					Terminal_IncImGuiStateInt("Scanner", "ScanState", 1);
				}
				else if (Sequence_DoStepAndWait(3))
				{
					Sound_FadeGlobalVolume(1.0f, 2.0f);
					Terminal_SetGuiActive("Scanner", false, 0.3);
					Terminal_SetGuiActive("Scanner_SideTerminal", false, 0.3);
					Light_FadeTo("ScannerTerminalLight", cColor(0,0,0,0), -1, 0.3);
					Entity_SetEffectsActive("ScannerArm", false, true);
					Entity_SetEffectsActive("Scanner", true, true);
					StopScannerArm();
					Audio_ScannerStop();
				}
				else if (Sequence_DoStepAndWait(0.5))
				{
					Audio_ScannerDoor_Open();
					Button_SetSwitchedOn("ScannerDoor_Button", true, true);
					Entity_SetActive("ScannerDoor_Blocker", false);
					Button_SetLocked("ScannerDoor_Button", true, true);
					Button_SetLocked("ScannerButton", true, true);
				}
				else
				{
					mbPlayerScanned = true;
					Map_AddTimer("ScanFinishedMusic", 8.0f, "ScanFinishedMusic");
					
					
					if (mbFinishedSim)
					{
						Voice_Stop("Dialog");
						Voice_Play("1_ScanningAndSimDone_1");
						Voice_PlayWhenPossible("1_ScanningAndSimDone_2", "VoiceCondition_ScanningAndSimDone", -1, 0, "VoiceOver_EjectCathTool");
					}
					else
					{
						Voice_Play("1_ScanningDone_SimNotDone");
					}
				}
				Sequence_End();
			}
						
			//-------------------------------------------------------
			
			void ScanFinishedMusic (const tString &in asTimer)
			{
				StartArkLabMusic();
			}
			
			//-------------------------------------------------------
			
			void LineOver_LookAtHands(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStart)
			{
				if (abStart==false) return;
				
				Map_AddTimer("Timer_LookAtHands", 1, "Timer_LookAtHands");
			}
			
			//-------------------------------------------------------
			
			void Timer_LookAtHands(const tString &in asTimer)
			{
				
				PlayerHands_SetUseCustomPosition(false);
				PlayerHands_SetUseCustomRotation(false);
				PlayerHands_PlayAnimation("event_look_at_hands_2_1");
			}
			
			//-------------------------------------------------------
			
			bool DialogEvent_LookingAtScreen(const tString &in asBranch, const tString &in asSubject, int alLineIndex, const tString &in asNewBranch)
			{
				return Entity_IsInPlayerFOV("ScanScreenLookAt");
			}
			
			//-------------------------------------------------------
			
			void Subject_ScannerScanning(const tString &in asSubject, bool abStartOfSubject)
			{
				if (abStartOfSubject) return;
				SequenceStates_Resume("Seq_ScannerScanning");
			}
			
			//-------------------------------------------------------
			
			void LineOver_ScannerScanning(const tString &in asScene, const tString &in asSubject, int alLineIndex, bool abStart)
			{
				if(asSubject=="1_ScannerScanning_2_Looking" || asSubject=="1_ScannerScanning_2_NotLooking")
				{
					Music_Stop(1.0f, eMusicPrio_MinorEvent);
					Music_Play("02_07_voices", 0.95, false, eMusicPrio_BigEvent);
				}
				
				if (abStart) return;
				SequenceStates_Resume("Seq_ScannerScanning");
			}
			
			//-------------------------------------------------------
			
			bool mbStopScannerArm = false;
			void StopScannerArm()
			{
				mbStopScannerArm = true;
			}
			
			//-------------------------------------------------------
			
			bool Trigger_StopScannerArm(const tString &in asParent, const tString &in asChild, int alState)
			{
				if (alState==1 || mbStopScannerArm==false) return true;
				
				Prop_RotateToSpeed("ScannerArm", 2, 0, false, "");
				return false;
			}
		//} END Use Scanner

		//-------------------------------------------------------

	
		/////////////////////////////////////////
		// Scene 1 - Puppet Reveal Security Corridor
		//{//////////////////////////////////////
		
		//-------------------------------------------------------

		float mfScanningProgress = 0;
		float mfImageDisplay = 0;
		void OnGui_ScannerScreen(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("02_06_theta_tunnels");
			
			cImGuiGfx xRayFront = cImGuiGfx("xray_front", eImGuiGfx_Texture);
			cImGuiGfx xRaySide = cImGuiGfx("xray_side", eImGuiGfx_Texture);
			cImGuiGfx xRayGrid = cImGuiGfx("xray_cross", eImGuiGfx_Texture);
				
					
			//StationGuiBG_Backdrop();
			StationGuiBG_Scanlines();
			
			int lScanState = ImGui_GetStateInt("ScanState", eScannerState_Boot);
			Terminal_SetImGuiStateInt("Scanner_SideTerminal", "ScanState", lScanState);
			
			if (lScanState == eScannerState_Boot)
			{
			}
			
			///////////////////////////
			// Print scan image, line by line
			else if (lScanState == eScannerState_BodyScan)
			{
				mfScanningProgress += afTimeStep * 0.4f;
							
				if(mfScanningProgress>=2.0f)
				{
					mfScanningProgress = 2;
					ImGui_IncStateInt("ScanState", 1);
				}
					
				if (int(mfScanningProgress*10)!=int(mfImageDisplay*10))
					mfImageDisplay = cMath_RoundFloatToDecimals(mfScanningProgress, 1);
			}
					
			cVector2f vBaseImgSize = ImGui_GetRatioCorrectSizeByNrmHeight(xRayFront, 0.75);
			xRayFront.mvUVMax = xRaySide.mvUVMax = cVector2f(1, mfImageDisplay/2.0f);
			//lScanState = eScannerState_Flesh;
			
			///////////////////////////
			// Draw brain stuff
			if (lScanState == eScannerState_Brain)
			{
				ScanBodyPartHighlight("brain", vBaseImgSize);
				if (ScanPopUpImg("brain", cImGuiGfx("xray_brain_01.dds", eImGuiGfx_TextureAnimated), cVector3f(0.55, 0.3, 4), 0.35))
				{
					ScanInfoLines_AddNrmVertex(cVector2f(0.7, 0.3));
					ScanInfoLines_AddNrmVertex(cVector2f(0.7, 0.125));
					ScanInfoLines_AddNrmVertex(cVector2f(0.55, 0.125));
					ScanInfoLines("BrainLines");
				}
				
				ScanInfoText("Scanner_Brain", 2, -1, afTimeStep, ImGui_NrmPosGroup(0.55, 0.71, 5), ImGui_NrmSize(0.25, 0.35));
			}
			
			///////////////////////////
			// Draw blackbox stuff
			else if (lScanState == eScannerState_Blackbox || lScanState == eScannerState_ShowReed)
			{
				ScanBodyPartHighlight("blackbox", vBaseImgSize);
				if (ScanPopUpImg("blackbox", cImGuiGfx("xray_blackbox_01.dds", eImGuiGfx_TextureAnimated), cVector3f(0.2, 0.43, 4), 0.35))
				{
					ScanInfoLines_AddNrmVertex(cVector2f(0.4, 0.43));
					ScanInfoLines_AddNrmVertex(cVector2f(0.4, 0.13));
					ScanInfoLines_AddNrmVertex(cVector2f(0.475, 0.13));
					ScanInfoLines("BlackboxLines");
				}

				cVector3f vTextPos = ImGui_NrmPosGroup(0.2, 0.84, 5);
				bool bDrawingText = ScanInfoText("Scanner_Blackbox_1", 1, 3, afTimeStep, vTextPos, ImGui_NrmSize(0.35, 0.35));
				if (bDrawingText==false) bDrawingText = ScanInfoText("Scanner_Blackbox_2", 1, 3, afTimeStep, vTextPos, ImGui_NrmSize(0.35, 0.35));
				if (bDrawingText==false) ScanInfoText("Scanner_Blackbox_3", 0.25, -1, afTimeStep, vTextPos, ImGui_NrmSize(0.35, 0.35));
			}
			
			///////////////////////////
			// Draw battery stuff
			else if (lScanState == eScannerState_Battery)
			{
				ScanBodyPartHighlight("battery", vBaseImgSize);
				if (ScanPopUpImg("battery", cImGuiGfx("xray_battery_01.dds", eImGuiGfx_TextureAnimated), cVector3f(0.05, 0.37, 1), 0.35))
				{
					ScanInfoLines_AddNrmVertex(cVector2f(0.3, 0.37));
					ScanInfoLines_AddNrmVertex(cVector2f(0.3, 0.25));
					ScanInfoLines_AddNrmVertex(cVector2f(0.2, 0.25));
					ScanInfoLines("BatteryLines");
				}
				
				ScanInfoText("Scanner_Battery", 2, -1, afTimeStep, ImGui_NrmPosGroup(0.05, 0.78, 5), ImGui_NrmSize(0.35, 0.35));
			}
			
			///////////////////////////
			// Draw gel stuff
			else if (lScanState == eScannerState_Gel)
			{
				ScanBodyPartHighlight("body", vBaseImgSize);
				if (ScanPopUpImg("gel", cImGuiGfx("xray_gel_01.dds", eImGuiGfx_TextureAnimated), cVector3f(0.025, 0.3, 5), 0.35))
				{
/*					ScanInfoLines_AddNrmVertex(cVector2f(0.8, 0.225));
					ScanInfoLines_AddNrmVertex(cVector2f(0.725, 0.225));
					ScanInfoLines("GelLines");*/
				}
				
				ScanInfoText("Scanner_Gel", 2, -1, afTimeStep, ImGui_NrmPosGroup(0.025, 0.71, 5), ImGui_NrmSize(0.35, 0.35));
			}
			
			///////////////////////////
			// Draw flesh stuff
			else if (lScanState == eScannerState_Flesh)
			{
				ScanBodyPartHighlight("body", vBaseImgSize);
				if (ScanPopUpImg("flesh", cImGuiGfx("xray_flesh_01.dds", eImGuiGfx_TextureAnimated), cVector3f(0.25, 0.4, 6), 0.35))
				{
/*					ScanInfoLines_AddNrmVertex(cVector2f(0.8, 0.475));
					ScanInfoLines_AddNrmVertex(cVector2f(0.74, 0.475));
					ScanInfoLines("FleshLines");*/
				}
				
				ScanInfoText("Scanner_Flesh", 2, -1, afTimeStep, ImGui_NrmPosGroup(0.25, 0.81, 6), ImGui_NrmSize(0.35, 0.35));
			}
				
			////////////////////////////
			// Reed info
			if (lScanState >= eScannerState_ShowReed)
			{
				ScanPopUpImg("reed", cImGuiGfx("xray_reed"), cVector3f(0.675, 0.05, 5.1), 0.3);
				ScanInfoText("Scanner_Reed", 0, -1, afTimeStep, ImGui_NrmPosGroup(0.35, 0.55, 5)+cVector3f_Right*vBaseImgSize.x, ImGui_NrmSize(0.2, 0.35), 0.05);
			}
			
			ImGui_DoImage(xRaySide, 0, vBaseImgSize*xRayFront.mvUVMax);
			ImGui_DoImage(xRayFront, cVector3f(vBaseImgSize.x, 0, 0)/*+ImGui_NrmPosGroup(0, 0, 0)*/, vBaseImgSize*xRayFront.mvUVMax);
			ImGui_SetModRotateAngle(180);
			ImGui_SetModColorMul(gStationGuiColor_Normal*0.5);
			cVector2f vProgressSize = ImGui_NrmSizeGroup(0, 0.0125);
			vProgressSize.x = vBaseImgSize.x*2.0f*(mfScanningProgress-mfImageDisplay)*10.f;
			ImGui_DoImage(cImGuiGfx(""), cVector3f(0, vBaseImgSize.y*xRayFront.mvUVMax.y, 1), vProgressSize);
			ImGui_SetModColorMul(cColor_White);
			ImGui_SetModRotateAngle(0);
			
			////////////////////////////
			// Grid
			ImGui_GroupBegin(cVector3f(0, 0, 3), ImGui_NrmSize(0.65, 0.75));
			cVector2f vGridImageSize = ImGui_GetRatioCorrectSizeByNrmHeight(xRayGrid, 0.0875);
			float fWidth = 10;
			float fHeight = 10;
			for (int x = 0; x < fWidth; x++)
			{
				float fXPos = x*(1.0/fWidth);
				for (int y = 0; y < fHeight; y++)
				{
					ImGui_DoImage(xRayGrid, ImGui_NrmPosGroup(fXPos, y*(1.0/fHeight), 0), vGridImageSize);
				}
			}
			ImGui_GroupEnd();
		}
		
		//-------------------------------------------------------
		
		void ScanBodyPartHighlight(const tString &in asGfxSuffix, const cVector2f vImgSize)
		{
			cImGuiGfx xRayFront = cImGuiGfx("xray_front_"+asGfxSuffix, eImGuiGfx_Texture);
			cImGuiGfx xRaySide = cImGuiGfx("xray_side_"+asGfxSuffix, eImGuiGfx_Texture);
			ImGui_SetModColorMul(cColor_White * ImGui_FadeOscillateFloat("BodyPartColor", 0.75, 1, 0.5));
			ImGui_DoImage(xRaySide, cVector3f(0, 0, 2), vImgSize);
			ImGui_DoImage(xRayFront,cVector3f(vImgSize.x, 0, 2), vImgSize);
			ImGui_SetModColorMul(cColor_White);
		}
		
		//-------------------------------------------------------
		
		bool ScanPopUpImg(const tString &in asName, cImGuiGfx &in aGfx, const cVector3f &in avImgNrmPos, float afImgNrmWidth)
		{
			aGfx.mfAnimationTime = 0.125;
			aGfx.mbCrossfadeAnimation = true;
			
			const float fBorderSize = 4;
			ImGui_FadeStateFloat(asName+"_ZoomFade", 1, 0.5, eEasing_QuadInOut, false);
			float fFadeIn = ImGui_GetStateFloat(asName+"_ZoomFade", 0);
			
			cVector3f vPos = ImGui_NrmPosGroup(avImgNrmPos);
			cVector2f vSize = ImGui_GetRatioCorrectSizeByNrmWidth(aGfx, afImgNrmWidth);
			
			if (fFadeIn < 0.99) ImGui_SetModColorMul(cColor(0, 1));
			else 
			{
				ImGui_FadeStateFloat(asName+"_alpha", 1, 0.2, eEasing_QuadInOut, false);
				ImGui_SetModColorMul(cColor(ImGui_GetStateFloat(asName+"_alpha", 0), 1));
			}
				
			ImGui_DoImage(fFadeIn >= 0.99 ? aGfx : cImGuiGfx(""), vPos+cVector3f(fBorderSize, fBorderSize, 0.01), (vSize-cVector2f(fBorderSize*2.0f))*fFadeIn);
			
			ImGui_SetModColorMul(gStationGuiColor_Normal);
			ImGui_DoImage(cImGuiGfx(""), vPos, vSize*fFadeIn);
			ImGui_SetModColorMul(cColor_White);
			
			return fFadeIn > 0.99;
		}
		
		//-------------------------------------------------------
		
		bool ScanInfoText(const tString &in asEntry, float afStartTime, float afEndTime, float afDeltaTime, const cVector3f &in vPos, const cVector2f &in vSize, float afFontSize = 0.05)
		{
			if (afEndTime > 0)
			{
				ImGui_IncStateFloat(asEntry+"_End", afDeltaTime);
				if (ImGui_GetStateFloat(asEntry+"_End", 0) > afEndTime)
					return false;
			}
			
			cImGuiTextFrameData text = StationGui_CreateDefaultTextFrameData();
			text.mFont.mvSize = ImGui_NrmSizeKeepRatio(afFontSize);
				
			tWString sText = ImGui_Translate(asEntry);
			
			ImGui_IncStateFloat(asEntry+"_Delay", afDeltaTime);
			bool bDelayOver = ImGui_GetStateFloat(asEntry+"_Delay", 0) > afStartTime;
			
			if (bDelayOver)
				ImGui_FadeStateFloat(asEntry+"_Progress", sText.length()+0.1, sText.length()*0.05, eEasing_Linear, false);
			
			float fProgress = ImGui_GetStateFloat(asEntry+"_Progress", 0);
			int lSize = int(fProgress);
			
			bool bAddCaret = (lSize != sText.length()) && (bDelayOver || ImGui_FadeOscillateFloat("LineBlink", 0, 1, 0.5, eEasing_Linear) > 0.5f);
			
			sText.resize(lSize);
			
			if (bAddCaret)
				sText += "_";
				
			ImGui_SetTextOverride(sText);
			ImGui_DoTextFrameExt("", 10, 0, 0, text, vPos, vSize);
			ImGui_ClearTextOverride();
			return true;
		}
		
		//-------------------------------------------------------
		
		array<cVector2f> mvScanInfoLines;
		
		void ScanInfoLines_AddNrmVertex(const cVector2f &in avVertex)
		{
			mvScanInfoLines.push_back(avVertex);
		}
		
		void ScanInfoLines(const tString &in asName)
		{
			ImGui_FadeStateFloat(asName, 1, 0.5, eEasing_QuadInOut, false);
			float fLines = ImGui_GetStateFloat(asName);
			float fDiv = 1.0f/float(mvScanInfoLines.length()-1);
			
			ImGui_AddLineStripNrmVertex(mvScanInfoLines[0]);
			for (int i = 1; i < mvScanInfoLines.length(); i++)
			{
				if (fLines < fDiv*(i-1))
					break;
					
				float fFraction = (fLines-fDiv*(i-1))/fDiv;
				fFraction = cMath_Clamp(fFraction, 0.01, 1.f);
				
				ImGui_AddLineStripNrmVertex(mvScanInfoLines[i-1] + (mvScanInfoLines[i] - mvScanInfoLines[i-1])*fFraction);
			}
			
			ImGui_DrawAndClearLineStrip(2, 2.5, gStationGuiColor_Normal);
			
			mvScanInfoLines.resize(0);
		}
		
		//-------------------------------------------------------
		
		void OnGui_ScannerScreen_Secondary(const tString&in asEntityName, float afTimeStep)
		{
			StationGuiBG_Scanlines();
			
			ImGui_DoWindowStart("", StationGui_CreateDefaultWindowData(), ImGui_NrmPosGroup(0.025, 0.025, 1), ImGui_NrmSizeGroup(0.95, 0.95));
			
			int lScanState = ImGui_GetStateInt("ScanState", eScannerState_Boot);
			
			///////////////////////////
			// Draw brain stuff
			if (lScanState == eScannerState_Brain)
			{
				ScanZoomImage("brain", cImGuiGfx("xray_brain_large_01.dds", eImGuiGfx_TextureAnimated), ImGui_NrmPosGroup(0.05, -0.175, 0), 1.25);
			}
			
			///////////////////////////
			// Draw blackbox stuff
			else if (lScanState == eScannerState_Blackbox || lScanState == eScannerState_ShowReed)
			{
				ScanZoomImage("blackbox", cImGuiGfx("xray_blackbox_large_01.dds", eImGuiGfx_TextureAnimated));
			}
			
			///////////////////////////
			// Draw battery stuff
			else if (lScanState == eScannerState_Battery)
			{
				ScanZoomImage("battery", cImGuiGfx("xray_battery_01.dds", eImGuiGfx_TextureAnimated));
			}
			
			///////////////////////////
			// Draw gel stuff
			else if (lScanState == eScannerState_Gel)
			{
				ScanZoomImage("gel", cImGuiGfx("xray_gel_01.dds", eImGuiGfx_TextureAnimated));
			}
			
			///////////////////////////
			// Draw flesh stuff
			else if (lScanState == eScannerState_Flesh)
			{
				ScanZoomImage("flesh", cImGuiGfx("xray_flesh_01.dds", eImGuiGfx_TextureAnimated));
			}
			ImGui_DoWindowEnd();
		}
		
		//-------------------------------------------------------
		bool ScanZoomImage(const tString &in asName, cImGuiGfx &in aGfx, const cVector3f avPosOffset = 0, float afSizeMul = 1.0f)
		{
			aGfx.mfAnimationTime = 0.125;
			aGfx.mbCrossfadeAnimation = true;
			
			const float fBorderSize = 4;
			ImGui_FadeStateFloat(asName+"_ZoomFade", 1, 0.5, eEasing_QuadInOut, false);
			float fFadeIn = ImGui_GetStateFloat(asName+"_ZoomFade", 0);
			
			cVector2f vSize = ImGui_GetRatioCorrectSizeByRect(aGfx, ImGui_NrmSizeGroup(1, 0.95)*afSizeMul);
			cVector3f vPos = cVector3f((ImGui_GetCurrentGroupSize().x-vSize.x)*0.5, (ImGui_GetCurrentGroupSize().y-vSize.y)*0.25, 0);
			
			if (fFadeIn < 0.99) ImGui_SetModColorMul(cColor(0, 1));
			else 
			{
				ImGui_FadeStateFloat(asName+"_alpha", 1, 0.2, eEasing_QuadInOut, false);
				ImGui_SetModColorMul(cColor(ImGui_GetStateFloat(asName+"_alpha", 0), 1));
			}
				
			ImGui_DoImage(fFadeIn >= 0.99 ? aGfx : cImGuiGfx(""), 
					      vPos+cVector3f(fBorderSize, fBorderSize, 0.01)+avPosOffset, 
						  (vSize-cVector2f(fBorderSize*2.0f))*fFadeIn);
			
			
			return fFadeIn > 0.99;
		}
		
		//-------------------------------------------------------
		
		//} END Event Scanner GUI
		
	//} END SCENE 1
	
	
