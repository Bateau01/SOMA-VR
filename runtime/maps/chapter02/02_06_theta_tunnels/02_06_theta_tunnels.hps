				lock.mvNrmSize = cVector2f(0.0831, 0.15);
				lock.msFocusText = "DoorPanel_Payload";
				lock.msSlideDoor = "rocketdesign_door";
				StationGui_DoorLockApp_AddLock(lock);
			}
			
			{
				cDoorLockAppButton lock = CreateDoorLockButton("RoomName_Security", "theta_securitymap_security", "security_doorpanel");
				lock.mvNrmPos = cVector3f(0.35, 0.18, 1);
				lock.mvNrmSize = cVector2f(0.0831, 0.08);
				lock.msFocusText = "DoorPanel_Security";
				lock.msSlideDoor = "security_door";
				StationGui_DoorLockApp_AddLock(lock);
			}
			
			{
				cDoorLockAppButton lock = CreateDoorLockButton("RoomName_Storage", "theta_securitymap_storage", "storage_doorpanel");
				lock.mvNrmPos = cVector3f(0.58, 0.48, 1);
				lock.mvNrmSize = cVector2f(0.0831, 0.15);
				lock.msFocusText = "DoorPanel_Storage";
				lock.msSlideDoor = "storage_door";
				StationGui_DoorLockApp_AddLock(lock);
			}
			
			/*{
				cDoorLockAppButton lock = CreateDoorLockButton("RoomName_ARKRoom", "theta_securitymap_cleanroom", "AirlockButton_North");
				lock.mvNrmPos = cVector3f(0.4625, 0.75, 2);
				lock.mvNrmSize = cVector2f(0.175, 0.175);
				lock.msFocusText = "RoomName_ARKRoom";
				StationGui_DoorLockApp_AddLock(lock);
			}*/
			
			int lDoorCount = gvDoorControlButtons.length();
			
			StationGui_DoorLockApp(settings);
		}
		
		void AddDoorLockButton(const tString &in asName, const tString &in asGfx, const tString &in asPanelPrefix)
		{
			cDoorLockAppButton lock = CreateDoorLockButton(asName, asGfx, asPanelPrefix);
			StationGui_DoorLockApp_AddLock(lock);
		}
		
		cDoorLockAppButton CreateDoorLockButton(const tString &in asName, const tString &in asGfx, const tString &in asPanelPrefix)
		{
			cDoorLockAppButton lock(asName);
			lock.mvButtons.push_back(asPanelPrefix+"_1");
			lock.mvButtons.push_back(asPanelPrefix+"_2");
			lock.mGfx = cImGuiGfx(asGfx);
			return lock;
		}
		
