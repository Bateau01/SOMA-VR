	//Event Music
	bool Trigger_LeaveVentMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		Music_Play("02_06_exitvents", 0.85f, false, eMusicPrio_BigEvent);
		return false;
	}
	
	//----------------------------------------------------------------------
	bool mbEmptyBedMusicPlayed = false;
	bool Trigger_EmptyBedMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(Puppet_IsHidingAndWaiting("puppet_dynamic"))
			return true;
		
		if(mbEmptyBedMusicPlayed==false)
		{		
			mbEmptyBedMusicPlayed = true;
			Music_Stop(1.0f, eMusicPrio_BgAmb);
			mbAmbientMusicPlaying = false;
			Music_FadeVolumeMul(1.0f, 2.0f);
			Map_AddTimer("EmptyBedMusic", 1.0f, "EmptyBedMusicStart");
		}
		return false;
	}
	
	bool mbEmptyBedMusic = false;
	void EmptyBedMusicStart(const tString &in asTimer)
	{
		if(mbEmptyBedMusic==false)
		{
			mbEmptyBedMusic = true;
			Music_Play("02_06_emptybed", 0.35f, false, eMusicPrio_BigEvent);
		}
		
		Map_AddTimer("StartAmbient", 11.f, "AmbientMusicHandler");
	}
		
	//----------------------------------------------------------------------
	bool mbSleeperMusicPlayed = false;
	bool Trigger_SleeperMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(Puppet_IsHidingAndWaiting("puppet_dynamic"))
			return true;
		
		if(mbSleeperMusicPlayed==false)
		{
			Music_Play("02_06_akers_victims", 0.65f, false, eMusicPrio_BigEvent);
			mbSleeperMusicPlayed = true;
		}
		return false;
	}
	
	//----------------------------------------------------------------------
	
	//Ambient Music
	bool mbAmbientMusicPlaying = false;
	bool mbAmbientMusicSecondStage = false;
	bool mbAmbientMusicAllowed = true;
	float gfAmbientMusicMul = 1.0f;
	
	void AmbientMusicHandler(const tString &in asTimer)
	{		
		if (asTimer=="StartAmbient" && mbAmbientMusicPlaying==false && mbAmbientMusicAllowed==true)
		{
			if(mbAmbientMusicSecondStage==false)
			{
				Music_PlayExt(gsThetaUGMusicStage1, true, 0.5f, 1.0f, cMath_RandRectf(3.f,5.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			else if(mbAmbientMusicSecondStage==true)
			{
				Music_PlayExt(gsThetaUGMusicStage2, true, 0.85f, 1.0f, cMath_RandRectf(3.f,5.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			
			cLux_AddDebugMessage("Ambient music triggering");
			
			mbAmbientMusicPlaying = true;
			
			//Dynamic fades
			Map_AddTimer("RandomFadeRider", cMath_RandRectf(10.f,20.f), "AmbientMusicHandler");
			Map_AddTimer("FadeOut", cMath_RandRectf(60.f,120.f), "AmbientMusicHandler");
			Map_RemoveTimer("StopAmbientMusic");
			Map_RemoveTimer("StopAmbientMusicQuickly");
		}
		
		else if (asTimer=="StartAmbient" && mbAmbientMusicPlaying==false && mbAmbientMusicAllowed==false)
		{
			Map_AddTimer("StartAmbient", cMath_RandRectf(10.f,20.f), "AmbientMusicHandler");
		}
		
		else if (asTimer=="StopAmbientMusic" && mbAmbientMusicPlaying==true)
		{
			Music_Stop(4.5f, eMusicPrio_BgAmb);
			Map_RemoveTimer("RandomFadeRider");
			Map_RemoveTimer("FadeOut");
			Map_RemoveTimer("StartAmbient");
			Music_FadeVolumeMul(1.0f,1.0f);
			mbAmbientMusicPlaying = false;
		}
		else if (asTimer=="StopAmbientMusicQuickly" && mbAmbientMusicPlaying==true)
		{
			cLux_AddDebugMessage("Stop Ambient Music Quickly Triggered");
			Music_Stop(1.5f, eMusicPrio_BgAmb);
			Map_RemoveTimer("StartAmbient");
			Map_RemoveTimer("RandomFadeRider");
			Map_RemoveTimer("FadeOut");
			Music_FadeVolumeMul(1.0f,1.0f);
			mbAmbientMusicPlaying = false;
		}
		
		else if(asTimer=="RandomFadeRider")
		{
			if(mbAmbientMusicSecondStage==false)
			{
				Music_PlayExt(gsThetaUGMusicStage1, true, 0.5f*gfAmbientMusicMul, 1.0f, cMath_RandRectf(5.f,8.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			else if(mbAmbientMusicSecondStage==true)
			{
				Music_PlayExt(gsThetaUGMusicStage2, true, 0.85f*gfAmbientMusicMul, 1.0f, cMath_RandRectf(5.f,8.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			
			cLux_AddDebugMessage("Ambient Music Fading");
			gfAmbientMusicMul = cMath_RandRectf(0.75f, 1.2f);
			Map_AddTimer("RandomFadeRider", cMath_RandRectf(10.f,15.f), "AmbientMusicHandler");
		}
		
		else if(asTimer=="FadeOut")
		{	
			cLux_AddDebugMessage("Ambient Music Fading Out");
			Music_Stop(cMath_RandRectf(8.f,12.f), eMusicPrio_BgAmb);
			mbAmbientMusicPlaying = false;
			
			Map_RemoveTimer("RandomFadeRider");
			Map_AddTimer("StartAmbient", cMath_RandRectf(60.f,80.f), "AmbientMusicHandler");
		}
		
		cLux_AddDebugMessage("Ambient Music Playing is "+mbAmbientMusicPlaying);
	}
	
	bool Trigger_ArkLabMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Music_PlayExt(gsThetaArkLabMusic, true, 0.65f, 1.0f, cMath_RandRectf(8.f,12.f), 0.0f, eMusicPrio_BgAmb, true);
		}
		else
		{
			Music_Stop(cMath_RandRectf(4.f,8.f), eMusicPrio_BgAmb);
		}
		// turn off in scanner, turn off once door unlocked to base
		return true;
	}
	
	void LineStart_CathTalks(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStart)
	{
		if (abStart==false) return;
		
		Sound_FadeGlobalVolume(0.65f, 4.0f, eSoundEntryType_World);
	}
	
	void LineOver_ArkAmbientStart(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStart)
	{
		if (abStart==false) return;
		StartArkLabMusic();
		Sound_FadeGlobalVolume(1.0f, 4.0, eSoundEntryType_World);
	}
    
    void LineStart_EndArkLab(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStart)
	{
		if (abStart==false) return;
		StopArkLabMusic();
	}
	
	//---------------------------------------------------------------------
	//Ark lab ambient
	
	void StartArkLabMusic()
	{
		Music_PlayExt(gsThetaArkLabMusic, true, 0.65f, 1.0f, cMath_RandRectf(8.f,12.f), 0.0f, eMusicPrio_BgAmb, true);
	}
	
	void StopArkLabMusic()
	{
		Music_Stop(cMath_RandRectf(4.f,8.f), eMusicPrio_BgAmb);
	}
		
	//---------------------------------------------------------------------
	//Talking about Reed
	
	void LineOver_MusicReed(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStart)
	{
		if (abStart==false) return;
		Map_AddTimer("ReedMusic", 3.5f, "ReedMusicTimer");		
	}
	
	void ReedMusicTimer(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(0.55f, 2.5f);
		
		Sound_Fade("ScannerLoop", 0.65f, 2.5f);
		Sound_Fade("ScannerLoopPulse", 0.65f, 2.5f);
		
		Map_AddTimer("ReedMusicOver", 55.0f, "ReedMusicOver");
	}
	
	void ReedMusicOver(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(0.75f, 4.0f);
		
		Sound_Fade("ScannerLoop", 0.75f, 3.5f);
		Sound_Fade("ScannerLoopPulse", 0.75f, 3.5f);
	}
		
	//---------------------------------------------------------------------
	
	bool Trigger_BrandonMusicControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Map_AddTimer("StopAmbientMusic", 1.0f, "AmbientMusicHandler");
			Map_RemoveTimer("StartAmbient");
		}
		else
		{
			Map_AddTimer("StartAmbient", cMath_RandRectf(8.f,12.f), "AmbientMusicHandler");
			Map_RemoveTimer("StopAmbientMusic");
		}
		return true;
	}
		
	//---------------------------------------------------------------------
	
	bool Trigger_SecurityOfficeMusicControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Map_AddTimer("StopAmbientMusic", 1.0f, "AmbientMusicHandler");
			Map_RemoveTimer("StartAmbient");
		}
		else
		{
			Map_AddTimer("StartAmbient", cMath_RandRectf(8.f,12.f), "AmbientMusicHandler");
			Map_RemoveTimer("StopAmbientMusic");
		}
		return true;
	}
	
