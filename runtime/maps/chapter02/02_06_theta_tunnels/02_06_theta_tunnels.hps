		//--------------------------------------------------------
		
		int mlElevatorFallHearbeatID=-1;
		int mlElevatorFallBreathID=-1;
		bool Trigger_BreakLadder(const tString &in asParent, const tString &in asChild, int alState)
		{
			bool bPlayerClimbing = Entity_IsInteractedWith("LadderArea_1");
			
			Entity_SetActive("LadderArea_1", false);
			Player_ChangeStateToNormal();
			
			Entity_SetActive("Elevator_Ladder", false);
			Entity_SetActive("Elevator_Ladder_Broken", true);
			Entity_SetActive("Elevator_Ladder_Broken_Rung", true);
			Entity_AddImpulseFromEntity("Elevator_Ladder_Broken_Rung","ForceAreaRung",50.0f,true);
			
			mlElevatorFallHearbeatID = Emotion_StartHeartbeat(0.35, 1.0f, 1, -1, 1, 0);
			mlElevatorFallBreathID = Emotion_StartBackgroundBreath(eBreathType_Fear, 1, 1, 10, 0.0f, 0.2);
			
			cLux_AddDebugMessage("Player climbing? "+bPlayerClimbing);
			if (bPlayerClimbing==false) return false;
			
			CameraAnimation_Begin("ElevatorBreakAnim", "", true);
			
			Effect_Shake_Start(0.075, 0, 0, 0.5);
			Effect_Rumble_Start(0.7, 0.7);
			
			Sound_FadeGlobalVolume(0.0f, 0.05f, eSoundEntryType_WorldAll);
			Sound_CreateAtEntity("LadderSnap", "02_06_theta_tunnels/sfx/events/elevator_sequence/ladder/snap", "Player");
			Sound_CreateAtEntity("LadderSnapDebris", "02_06_theta_tunnels/sfx/events/elevator_sequence/ladder/snap_debris", "Player");
			Music_Stop(0.0f, eMusicPrio_BgAmb);
			Music_Stop(0.0f, eMusicPrio_BigEvent);
			Sound_Stop("ElevatorSustained", 0.0f);
			
			return false;
		}
		
		//---------------------------------------------------------
		
		bool CameraAnimation_ElevatorFall(const tString &in asEntity, int alDirection)
		{
			Player_AddBodyForce(cVector3f_Down*400, false);
			return true;
		}
		
		
		//---------------------------------------------------------
		bool Trigger_ElevatorShaftBottom(const tString &in asParent, const tString &in asChild, int alState)
		{
			Emotion_StopHeartbeat(mlElevatorFallHearbeatID);
			Emotion_StopBackgroundBreath(mlElevatorFallBreathID);
			
			//AttackMeter_AutoDamage(0, false, 0.1);
			Seq_ElevatorShaftFall("");
			return false;
		}
		
		//---------------------------------------------------------
		
		cSequenceStatesData mElevatorShaftFallSequence;
			
		void Seq_ElevatorShaftFall(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ElevatorShaftFall", mElevatorShaftFallSequence);
				
			if (Sequence_DoStepAndWait(5))
			{
				Player_SetActive(false);
				Effect_Fade_Out(0);
				Effect_Rumble_Start(0.9, 0.7);
				
				Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
				
				//Sound
				Sound_Stop("LadderSnap", 0.5f);
				Sound_CreateAtEntity("LadderLand","02_06_theta_tunnels/sfx/events/elevator_sequence/ladder/ground_hit","Player");
				Sound_FadeGlobalVolume(0.0f, 0.05f, eSoundEntryType_WorldAll);
				//cSound_FadeLowPassFilter(100.0, 0.0f, 1.0f, eSoundEntryType_World);
			}
			else if (Sequence_DoStepAndWait(5.5))
			{
				CameraAnimation_Begin("ElevatorFallGetUpAnim", "", true);
				float fHealth = cLux_GetExplorationModeActive() ? 0.8f : 0.2f;
				Player_SetHealth(fHealth);
				Effect_Fade_In(8);
				
				//Sound
				Sound_CreateAtEntity("WakeUp","02_06_theta_tunnels/sfx/events/elevator_sequence/wake_up/wakeup","Player");
				Emotion_PlayEventBreath("02_06_theta_tunnels/sfx/events/elevator_sequence/wake_up/wakeup_vo", 5);
				Sound_FadeGlobalVolume(1.0f, 1.0f, eSoundEntryType_WorldAll);
				//cSound_FadeLowPassFilter(22000.0, 0.0f, 10.0f, eSoundEntryType_World);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Player_SetActive(true);
			}		
			else if (Sequence_DoStepAndWait(0.5))
			{
				CameraAnimationNode_SetAutoMove("ElevatorFallGetUpAnim_1", 1);
				Entity_SetActive("LadderArea_2", true);
				Entity_SetActive("elevator_doors_2_blockbox", false);
				
				//Sound
				Sound_CreateAtEntity("StandUp","02_06_theta_tunnels/sfx/events/elevator_sequence/wake_up/standup","Player");
				Entity_SetActive("AMB_Elevator_Shaft_Creak", true);
			}
			Sequence_End();
		}
		
