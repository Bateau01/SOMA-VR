		//-------------------------------------------------------
		
		int mlCurrentProjector = 1;
		
		//-------------------------------------------------------
		
		void SetupProjectors()
		{
			//Entity_SetActive("Projector_1",true);
			//Entity_SetActive("Projector_2",false);
			//Entity_SetActive("Projector_3",false);
			//Entity_SetActive("Projector_4",false);
			Lamp_SetLit("Projector_1",true,false);
			Lamp_SetLit("Projector_2",false,false);
			Lamp_SetLit("Projector_3",false,false);
			Lamp_SetLit("Projector_4",false,false);
			
			Map_AddTimer("ProjectorLoop", 1.0f, "Timer_ProjectorLoop");
		}
		
		void Timer_ProjectorLoop(const tString&in asTimer)
		{
			if(Entity_GetCollide("Player","ProjectorSoundControl") || SlideDoor_GetOpenAmount("lectureroom_door") > 0.25) 
			{
				Sound_CreateAtEntity("ProjectorChange", "02_06_theta_tunnels/sweeteners/projector/projector_change", "Projector_2");
			}
			
			//Slight delay to sync with sound
			Map_AddTimer("ChangeSlide", 0.35, "ProjectorChangeSlide");
		}
		
		void ProjectorChangeSlide(const tString &in asTimer)
		{
			//Entity_SetActive("Projector_"+mlCurrentProjector,false);
			Lamp_SetLit("Projector_"+mlCurrentProjector,false,false);
						
			mlCurrentProjector++;
			if(mlCurrentProjector>4) mlCurrentProjector=1;
			
			Entity_SetActive("Projector_"+mlCurrentProjector,true);
			Lamp_SetLit("Projector_"+mlCurrentProjector,true,false);
			
			Map_AddTimer("ProjectorLoop", 5.0f, "Timer_ProjectorLoop");
		}
		
		//-------------------------------------------------------
		
		//} END Lecture Room Slideshow
		
		///////////////////////////////////////////////////
		// Event: Doctors Audio Log
		//{////////////////////////////////////////////////
		
		//-------------------------------------------------------
		bool mbDoctorSoundEventDone = false;
		//-------------------------------------------------------
		
		void Doctor_Log_OnConnectionStateChange(const tString &in asEntity, int alState)
		{
			if (alState == 1)
			{
				StartDoctorLog();
			}
			
			if (alState == -1)
			{
				StopDoctorLog();
			}
		}
			
		//-------------------------------------------------------
		
		bool mbDoctorsLogActive = false;
		void StartDoctorLog()
		{
			cLux_AddDebugMessage("Starting audio log");
			//Voice_SetSource("Masters",asEntity,0,12,true,12);
			Voice_Play("3_DoctorAudioLog");
			Sound_CreateAtEntity("DrTapeStart", "Entities_Station/object/tape_recorder/start","Doctor_Log");
			Sound_CreateAtEntity("DrTapeLoop", "Entities_Station/object/tape_recorder/loop", "Doctor_Log");
			mbDoctorsLogActive = true;
			
			//Set interaction disbaled for 1 second to stop from sound spamming
			Entity_SetInteractionDisabled("Doctor_Log", true);
			Map_AddTimer("ReEnableTapePlayerInteraction", 1.f, "Timer_TapePlayerInteractionEnable");
			
			if (mbDoctorSoundEventDone == false)
				Map_AddTimer("timer_doctorlogsoundevent",3.75f,"DoctorLogSoundEvent");
		}
		
		void StopDoctorLog()
		{
			cLux_AddDebugMessage("Stopping audio log");
			Voice_Stop("DataMining");
			Voice_Stop("DoctorAudioLog");
				
			Sound_Stop("DrTapeLoop", 0.05f);
			Sound_Stop("DrTapeStart", 0.05f);
			Sound_CreateAtEntity("DrTapeStop", "Entities_Station/object/tape_recorder/stop", "Doctor_Log");
			Sound_CreateAtEntity("DrTapeLoopEnd", "Entities_Station/object/tape_recorder/loop_end", "Doctor_Log");
			mbDoctorsLogActive = false;
				
			//Set interaction disbaled for 0.5 seconds to stop from sound spamming
			Entity_SetInteractionDisabled("Doctor_Log", true);
			Map_AddTimer("ReEnableTapePlayerInteraction", 0.5f, "Timer_TapePlayerInteractionEnable");
			
			if (Map_TimerExists("timer_doctorlogsoundevent"))
				Map_RemoveTimer("timer_doctorlogsoundevent");
		}
		
		void LineOver_DoctorsLog(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStart)
		{
			if (abStart) return;
			StopDoctorLog();
			mbDoctorSoundEventDone = false;
		}
		
		// To stop the sound from leaking through the walls during encounters
		bool Trigger_InfirmaryLogControl(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("infimary log control "+alState);
			if(alState==-1 && mbDoctorsLogActive==true)
			{
				Button_SetSwitchedOn("Doctor_Log", false, false);
				StopDoctorLog();
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void DoctorLogSoundEvent(const tString &in asTimer)
		{
			Sound_CreateAIEventAtEntity("Doctor_Log",75.0f,10);
			mbDoctorSoundEventDone = true;
		}
			
		//-------------------------------------------------------
		
		void Timer_TapePlayerInteractionEnable(const tString &in asTimer)
		{
			Entity_SetInteractionDisabled("Doctor_Log", false);
		}
	
