		cSequenceStatesData mSequencePuppetCature;
		void SequencePuppetCapture(const tString &in asTimer)
		{
			Sequence_Begin("SequencePuppetCapture", mSequencePuppetCature);
			
			if (Sequence_DoStepAndWait(0.25))
			{
				Map_RemoveTimer("RevealPlayerPos");
				Sound_PreloadGroup("NPC_Creatures/Foley/InWorld/CoralPuppet_01", true);
				
				Player_SetMoveSpeedMul(0.2);
				Player_SetLookSpeedMul(0.3f);
				Effect_Shake_Start(0.85, 0.4, 0.3, 0.3, cVector3f(1, 0.3f, 0));
				
				Sound_FadeGlobalVolume(0.0f, 0.05f, eSoundEntryType_WorldAll);
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				Effect_Fade_Out(0.025f);
				Sound_PlayGui("Player/UI/blackout_hit", 1.0f, eSoundEntryType_Gui);
				Sound_Stop("puppet_tunnel_SpotPlayer", 0.015f);
				Sound_Stop("AkersBurstDoor", 0.015f);
			}
			else if (Sequence_DoStepAndWait(0.9f))
			{
				Pathfinder_Stop("puppet_tunnel");
				Entity_SetActive("puppet_tunnel",false);
			}
			else if (Sequence_DoStepAndPause(0.1f))
			{
				
				Entity_SetActive("puppet_tunnel",true);
				Puppet_SetAfterPlayerDeathAnimtionCallback("puppet_tunnel", "PuppetTunnelDeahAnimOver");
				Puppet_StartPlayerDeathAnimation("puppet_tunnel");
			}
			else if (Sequence_DoStepAndWait(10))
			{
				Entity_SetActive("puppet_tunnel",false);
				Sound_SetGlobalVolume(0.0f, eSoundEntryType_WorldAll);
				Sound_SetGlobalVolume(0.0f, eSoundEntryType_GuiWorld);
				
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Player_SetMoveSpeedMul(1);
				Player_SetLookSpeedMul(1);
				Player_SetHealth(1);
				
				cSound_SetGlobalVolume(1.0f, eSoundEntryType_WorldAll, eScriptGlobalVolume_AttackMeter);
				
				ExitLevel();
			}
			
			Sequence_End();
		}
		
		void PuppetTunnelDeahAnimOver()
		{
			SequenceStates_Resume("SequencePuppetCapture");
		}
		
		//---------------------------------------------------------
		
		void ExitLevel()
		{
			cLux_AddDebugMessage("Change level!");
			Map_ChangeMap("02_07_theta_exit.hpm", "PlayerStartArea_1", "", "");
		}
		
		//---------------------------------------------------------
		
		bool Trigger_InfectionTransition(const tString &in asParent, const tString &in asChild, int alState)
		{		
			return false;
		}
		
		//---------------------------------------------------------
		
		cSequenceStatesData mInfectionEndingSequence;
			
		void Seq_InfectionEnding(const tString &in asTimer)
		{
			Sequence_Begin("Seq_InfectionEnding", mInfectionEndingSequence);
					
			if (Sequence_DoStepAndWait(1))
			{
				Player_FadeRunSpeedMulTo(0, 0.5);
				Player_FadeMoveSpeedMulTo(0, 1);
				Effect_ChromaticAberration_StartAnim(10.0f,0.01,0.01,cVector2f_Zero);
				Effect_ImageTrail_Start(0.5,1,10,8.0);
				Depth_Audio_Fear_LowIntensity(10, 10);
				
				cLux_AddTodoMessage("Sound: Simon feeling stronger effects of the infection.");
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Player_FadeLookSpeedMulTo(0.2, 3);
				Infection_CreateBorderTree(1, 30, cVector2f(14,35), 3.0f);
				Infection_CreateBorderTree(2, 30, cVector2f(14,35), 3.0f);
				Infection_CreateBorderTree(3, 30, cVector2f(14,35), 3.0f);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Player_SetCrouching(true, false, true);
				Player_SetStandDisabled(true);
				Player_StartLookAt("InfectionEnd_LookAt_1", 1, 1, 0.5);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Entity_SetActive("puppet_infection_end", true);
				Button_SetSwitchedOn("panel_slidedoor_medium_6", true, true);
				Player_StartLookAt("puppet_infection_end", 1, 1, 0.5);
				Player_FadeRollTo(0.2, 1, 0.1);
			}
			else if (Sequence_DoStepAndWait(5))
			{
				Player_StartLookAt("InfectionEnd_LookAt_2", 1, 1, 0.5);
				
				Voice_Play("4_AkersInfectionEnding");
				
				Effect_Fade_Out(3);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Music_Stop(0, eMusicPrio_BgAmb);
				Player_SetLookSpeedMul(1);
				Player_SetMoveSpeedMul(1);
				Player_SetRunSpeedMul(1);
				Player_SetStandDisabled(false);
				ExitLevel();
			}
			Sequence_End();
		}
		
		//---------------------------------------------------------
		
		//} END Fatal Akers Attack

	
	//-------------------------------------------------------
	
	//} END SCENE 5 ELEVATOR RIDE
	
	/////////////////////////////////////////
	// ==============
	// TERMINALS
	// ==============
	//{//////////////////////////////////////

	//-------------------------------------------------------
	
		/////////////////////////////////////////
		// Terminal Basics
		//{///////////////////////////////////////
		
		//-------------------------------------------------------
		
		void DoDialogWindowStart(const tString&in asCaption, const tString&in asText, const cVector2f &in avNrmSize = cVector2f(0.6, 0.2), float afZ=1.5f)
		{
			//////////////////////////////////
			// Setup widget data
			cImGuiWindowData window = StationGui_CreateDefaultWindowData();
			cImGuiTextFrameData textData;
			textData.mbUseBackgroundGfx = false;
			textData.mFont.mvSize = cVector2f(24, 24);
			textData.mFontAlign = eFontAlign_Center;
			textData.mColorText = cColor(0.8, 1);
			
			///////////////////////////////////////
			// Show message 
			ImGui_DoWindowStart(asCaption, window, ImGui_NrmPosGroup(cVector3f((1.f-avNrmSize.x)*0.5, (1.f-avNrmSize.y)*0.5, afZ)), ImGui_NrmSizeGroup(avNrmSize));
				
				ImGui_DoTextFrameExt(asText, ImGui_NrmSizeGroup(cVector2f(0.05, 0)), 0, 0, textData, 
								  ImGui_NrmPosGroup(cVector3f(0.0, 0.1, 1)), ImGui_NrmSizeGroup(cVector2f(1, 1)));
		}

		//-------------------------------------------------------
		
		void DoDialogWindowEnd()
		{
			ImGui_DoWindowEnd();
		}	
		
		//-------------------------------------------------------
		
		bool DoLoadingWindow(const tString &in asName, const tString &in asCaption, const tString &in asText, float afLoadTime, bool abReset, float afZ=1.5f,
							 const tString &in asSoundFile="", const tString &in asSoundSource="", float afSoundFadeInTime=0, float afSoundFadeOutTime=0)
		{
			if (asSoundFile != "" && !Depth_ImGui_LoadingInProgress(asName))
				Sound_CreateAtEntity(ImGui_GetName()+asName+"LoadSound", asSoundFile, asSoundSource == "" ? ImGui_GetName() : asSoundSource, afSoundFadeInTime);
				
			cGuiDialogBoxSettings dialogBox = StationGui_CreateDefaultDialogBox();
			dialogBox.mbEndWindow = false;
			dialogBox.mfZ = afZ;
			Depth_ImGui_DialogBox(asCaption, asText, dialogBox);
				
			bool bDone = Depth_ImGui_LoadingGauge(asName, afLoadTime, abReset, ImGui_NrmPosGroup(cVector3f(0.05, 0.4, 1)), 
														ImGui_NrmSizeGroup(cVector2f(0.9, 0.4)), StationGui_CreateDefaultGaugeData());
			
			ImGui_DoWindowEnd();
			
			if (bDone && asSoundFile != "")
				Sound_Stop(ImGui_GetName()+asName+"LoadSound", afSoundFadeOutTime);
			
			return bDone;				 
		}
		
		//-------------------------------------------------------
		
		//} END Terminal Basics

		/////////////////////////////////////////
		// Terminal *ARKTerminal*
		//{///////////////////////////////////////

		//-------------------------------------------------------

		eSimulationTerminalState mSimulationTerminalState = eSimulationTerminalState_Stopped;

		int mlARKBootCounter = 0;
		
		int mlSimulationTicks = 0;
		float mfSimulationSeconds = 0;

		//-------------------------------------------------------

		void ARKTerminal_OnGui(const tString&in asEntityName, float afTimeStep)
		{
			////////////////////////////
			// Data 
			cImGuiTextFrameData textData = StationGui_CreateDefaultTextFrameData();
			textData.mbUseBackgroundGfx = false;
			textData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.09375);
			ImGui_SetDefaultTextFrame(textData);
			
			cImGuiButtonData button = StationGui_CreateDefaultButtonData();
			button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0625);
			ImGui_SetDefaultButton(button);
			
			cImGuiLabelData label = ImGui_GetDefaultLabel();
			label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0625);
			ImGui_SetDefaultLabel(label);
			
			ImGui_SetTransCategory("02_06_theta_tunnels");
			
			StationGuiBG_Scanlines();
			
			if (StationGui_DrawAndCheckErrors())
				return;
			
			int lCurrentApp = StationGui_GetActiveApp(eSimulationTerminalApp_Idle);
			
			switch (lCurrentApp)
			{
				case eSimulationTerminalApp_Idle:
				StationGui_BigStatusMessage_Old("AWAITING_CONNECTION", gStationGuiColor_Warning, 1.5, true);
				break;
				
				case eSimulationTerminalApp_Boot:
				ARKTerminal_Boot();
				break;
				
				case eSimulationTerminalApp_WorldSetup:
				ARKTerminal_WorldSetup();
				break;
				
				case eSimulationTerminalApp_MindSetup:
				ARKTerminal_MindSetup();
				break;
				
				case eSimulationTerminalApp_Run:
				ARKTerminal_Run(afTimeStep);
				break;
				
				case eSimulationTerminalApp_Loading:
				ARKTerminal_Loading();
				break;
			}
		}
		
		void ARKTerminal_Loading()
		{
			int lNextApp = ImGui_GetStateInt("NextApp");
			Terminal_SetUpdateWhenOutOfView(ImGui_GetName(), true);
			Audio_ArkCompiling("computer_case_1");
			
			tString sHeader = "";
			switch (lNextApp)
			{
				case eSimulationTerminalApp_MindSetup:
				sHeader = "ArkTerminalUploading";
				case eSimulationTerminalApp_Run:
				sHeader = "ArkTerminalUploading";
				break;
			}
			
			cGuiDialogBoxSettings dialogBox = StationGui_CreateDefaultDialogBox();
			dialogBox.mbEndWindow = false;
			Depth_ImGui_DialogBox(sHeader, "", dialogBox);
			
			bool bLoadingFinished = Depth_ImGui_LoadingGauge("ArkTerminalLoading", 3, true, ImGui_NrmPosGroup(cVector3f(0.05, 0.3, 1)), 
														ImGui_NrmSizeGroup(cVector2f(0.9, 0.4)), StationGui_CreateDefaultGaugeData());
			ImGui_DoWindowEnd();
					
			if (bLoadingFinished==false)
				return;
					
			Terminal_SetUpdateWhenOutOfView(ImGui_GetName(), false);
			Audio_ArkCompilingComplete("computer_case_1");
			
			if (lNextApp == eSimulationTerminalApp_MindSetup)
			{
				Voice_Play("1_ArkSimInstructions");
				mbStartedSim = true;
			}
				
			StationGui_SetActiveApp(lNextApp);
		}
			
			//-------------------------------------------------------

			/////////////////////////////////////////
			// App *Boot sequence*
			//{///////////////////////////////////////

			//-------------------------------------------------------
			
			int mlARKBootCounterCheck = 0;

			//-------------------------------------------------------
		
			void ARKTerminal_Boot()
			{							
				mlARKBootCounterCheck = 0;
				
				////////////////////////////////////
				// Header
				ImGui_SetTransCategory("");
				ImGui_DoLabel("-------------------------------------------------------",ImGui_NrmPosGroup(cVector3f(0.05, -0.4, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
				ImGui_SetTransCategory("02_06_theta_tunnels");
				ImGui_DoLabel("ArkTerminalBoot_OSVersion",ImGui_NrmPosGroup(cVector3f(0.05, -0.35, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
				ImGui_DoLabel("ArkTerminalBoot_CompileInfo",ImGui_NrmPosGroup(cVector3f(0.05, -0.3, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
				ImGui_SetTransCategory("");
				ImGui_DoLabel("-------------------------------------------------------",ImGui_NrmPosGroup(cVector3f(0.05, -0.25, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
				ImGui_SetTransCategory("02_06_theta_tunnels");
				
				if (BootStepTimer(0.5)==false) return;
				
				int lMemoryMax = 1231;
				
				////////////////////////////////////
				// System Memory Check
				int lMemCheck = ImGui_GetStateFloat("MemCheckCounter", 0);
				ImGui_FadeStateFloat("MemCheckCounter", float(lMemoryMax)+0.1f, 3, eEasing_Linear, false);
				tWString sMemcheckStatus = ImGui_Translate("ArkTerminalBoot_MemcheckPre") + " " + lMemCheck + ImGui_Translate("ArkTerminalBoot_MemcheckPost");
				ImGui_SetTextOverride(sMemcheckStatus);
				if (lMemCheck >= lMemoryMax) ImGui_SetModColorMul(gStationGuiColor_Warning);
				ImGui_DoLabel("",ImGui_NrmPosGroup(cVector3f(0.05, -0.2, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
				ImGui_ClearTextOverride();
				
				if (lMemCheck < lMemoryMax) return;
				if (BootStepTimer(0.1)==false) return;
				ImGui_DoLabel("ArkTerminalBoot_MemcheckOK",ImGui_NrmPosGroup(cVector3f(0.05, -0.15, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
				ImGui_SetModColorMul(cColor_White);
				
				
				////////////////////////////////////
				// Storage Detection
				if (BootStepTimer(1)==false) return;
				ImGui_DoLabel("ArkTerminalBoot_StorageDetect",ImGui_NrmPosGroup(cVector3f(0.05, -0.1, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
				if (BootStepTimer(1)==false) return;
				ImGui_DoLabel("ArkTerminalBoot_DriveMount_1",ImGui_NrmPosGroup(cVector3f(0.05, -0.05, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
				if (BootStepTimer(0.5)==false) return;
				ImGui_DoLabel("ArkTerminalBoot_DriveMount_2",ImGui_NrmPosGroup(cVector3f(0.05, -0.0, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
				if (BootStepTimer(0.875)==false) return;
				ImGui_DoLabel("ArkTerminalBoot_Decrypt",ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
				if (BootStepTimer(0.625)==false) return;
				
				/////////////////////////////////////
				// Boot up the ARK
				ImGui_DoLabel("ArkTerminalBoot_ARKBoot",ImGui_NrmPosGroup(cVector3f(0.05, 0.1, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
				if (BootStepTimer(1)==false) return;
				ImGui_DoLabel("ArkTerminalRunHeader",ImGui_NrmPosGroup(cVector3f(0.05, 0.15, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
				if (BootStepTimer(1)==false) return;
				
				StationGui_SetActiveApp(eSimulationTerminalApp_WorldSetup);
				ARKTerminal_InitWorldSetup();
				StationGui_SetError("ArkTerminalError_MemoryCorrupted");
				
				Terminal_SetUpdateWhenOutOfView(ImGui_GetName(), false);
			}

			//-------------------------------------------------------
			
			bool BootStepTimer(float afTime)
			{
				mlARKBootCounterCheck++;
				
				if (mlARKBootCounter >= mlARKBootCounterCheck)
					return true;
		
				if (ImGui_TimerOver("NextBootStep_"+mlARKBootCounterCheck))
				{
					mlARKBootCounter++;
					return true;
				}
				else if (ImGui_TimerExists("NextBootStep_"+mlARKBootCounterCheck)==false)
				{
					ImGui_AddTimer("NextBootStep_"+mlARKBootCounterCheck, afTime);
				}
				return false;
			}

			//-------------------------------------------------------
			
			//} END BOOT APP
			
			//-------------------------------------------------------

			/////////////////////////////////////////
			// App *World Setup*
			//{///////////////////////////////////////

			//-------------------------------------------------------
			
			void ARKTerminal_InitWorldSetup()
			{
				SetupModule(eSimulationTerminalModules_System_Rigid, 0.025f, true);
				SetupModule(eSimulationTerminalModules_System_Soft, 0.155f, true);
				SetupModule(eSimulationTerminalModules_System_FluidDynamics, 0.175f, true);
				SetupModule(eSimulationTerminalModules_System_Buoyancy, 0.035f, true);
				SetupModule(eSimulationTerminalModules_System_Atmosphere, 0.045f, true);
				SetupModule(eSimulationTerminalModules_System_ScanInterface, 0.038f, true);
				SetupModule(eSimulationTerminalModules_System_Heat, 0.068f, true);
				SetupModule(eSimulationTerminalModules_System_DynamicLighting, 0.04f, true);
				SetupModule(eSimulationTerminalModules_System_BasicVegetation, 0.015f, false, eSimulationModuleType_Vegetation);
				SetupModule(eSimulationTerminalModules_System_AdvancedVegetation, 0.021f, true, eSimulationModuleType_Vegetation);
				
				SetupModule(eSimulationTerminalModules_Scene_Plains, 0.2f, false);
				SetupModule(eSimulationTerminalModules_Scene_Forest, 0.225f, true);
				
				SetupModule(eSimulationTerminalModules_Object_Humanoid, 0.113f);
				SetupModule(eSimulationTerminalModules_Object_Lake, 0.144f, true, eSimulationModuleType_Water);
				SetupModule(eSimulationTerminalModules_Object_River, 0.15f, true, eSimulationModuleType_Water);
				SetupModule(eSimulationTerminalModules_Object_Sun, 0.134f, true, eSimulationModuleType_LightSource);
				SetupModule(eSimulationTerminalModules_Object_Moon, 0.058f, false, eSimulationModuleType_LightSource);
				
				SetupModule(eSimulationTerminalModules_Object_Flowers, 0.06f, true);
				SetupModule(eSimulationTerminalModules_Object_Road, 0.075f, true);
				SetupModule(eSimulationTerminalModules_Object_Bench, 0.018f, false);
				SetupModule(eSimulationTerminalModules_Object_Boat, 0.115f, true);
				SetupModule(eSimulationTerminalModules_Object_Chair, 0.016f, true);
				SetupModule(eSimulationTerminalModules_Object_Cabin, 0.15f, false);
				SetupModule(eSimulationTerminalModules_Object_Clouds, 0.072f, true);
				
				AddModuleDependency(eSimulationTerminalModules_Object_Humanoid, eSimulationTerminalModules_System_Atmosphere);
				AddModuleDependency(eSimulationTerminalModules_Object_Humanoid, eSimulationTerminalModules_System_ScanInterface);
				AddTypeDependency(eSimulationTerminalModules_Object_Humanoid, eSimulationModuleType_LightSource);
				AddTypeDependency(eSimulationTerminalModules_Object_Humanoid, eSimulationModuleType_Water);
				
				AddModuleDependency(eSimulationTerminalModules_Object_Sun, eSimulationTerminalModules_System_DynamicLighting);
				AddModuleDependency(eSimulationTerminalModules_Object_Sun, eSimulationTerminalModules_System_Heat);
				
				AddModuleDependency(eSimulationTerminalModules_Object_Moon, eSimulationTerminalModules_System_DynamicLighting);
				AddModuleDependency(eSimulationTerminalModules_Object_Moon, eSimulationTerminalModules_System_FluidDynamics);
				
				AddModuleDependency(eSimulationTerminalModules_Object_River, eSimulationTerminalModules_System_FluidDynamics);
				AddModuleDependency(eSimulationTerminalModules_Object_River, eSimulationTerminalModules_System_Rigid);
				AddModuleDependency(eSimulationTerminalModules_Object_River, eSimulationTerminalModules_System_Buoyancy);
				
				AddModuleDependency(eSimulationTerminalModules_Object_Lake, eSimulationTerminalModules_System_Rigid);
				AddModuleDependency(eSimulationTerminalModules_Object_Lake, eSimulationTerminalModules_System_Soft);
				AddModuleDependency(eSimulationTerminalModules_Object_Lake, eSimulationTerminalModules_System_Buoyancy);
				
				AddModuleDependency(eSimulationTerminalModules_Scene_Forest, eSimulationTerminalModules_System_AdvancedVegetation);
				
				AddModuleDependency(eSimulationTerminalModules_Scene_Plains, eSimulationTerminalModules_Object_Sun);
				AddTypeDependency(eSimulationTerminalModules_Scene_Plains, eSimulationModuleType_Vegetation);
				
				AddModuleDependency(eSimulationTerminalModules_Object_Flowers, eSimulationTerminalModules_System_Atmosphere);
				AddTypeDependency(eSimulationTerminalModules_Object_Flowers, eSimulationModuleType_LightSource);
				AddTypeDependency(eSimulationTerminalModules_Object_Flowers, eSimulationModuleType_Vegetation);
				
				AddModuleDependency(eSimulationTerminalModules_Object_Boat, eSimulationTerminalModules_System_Buoyancy);
				AddModuleDependency(eSimulationTerminalModules_Object_Boat, eSimulationTerminalModules_System_Rigid);
				
				AddModuleDependency(eSimulationTerminalModules_Object_Chair, eSimulationTerminalModules_System_Rigid);
				
				AddModuleDependency(eSimulationTerminalModules_Object_Clouds, eSimulationTerminalModules_System_Atmosphere);
				AddModuleDependency(eSimulationTerminalModules_Object_Clouds, eSimulationTerminalModules_System_Heat);
			}

			//-------------------------------------------------------
			
			void SetupModule(eSimulationTerminalModules aModule, float afMemory, bool abChecked = true, eSimulationModuleType aType = eSimulationModuleType_Null)
			{
				ImGui_SetStateFloat("Module_Memory_"+aModule, afMemory);
				ImGui_SetStateInt("Module_Type_"+aModule, aType);
				ImGui_SetStateBool("ModuleChecked_"+aModule, abChecked);
			}

			//-------------------------------------------------------
			
			void AddModuleDependency(eSimulationTerminalModules aModule, eSimulationTerminalModules aDependency)
			{
				int i = 1;
				while (true)
				{
					if (ImGui_GetStateInt("Module_Dependency_"+aModule+"_"+i, -1)!=-1)
					{
						i++;
						continue;
					}
						
					ImGui_SetStateInt("Module_Dependency_"+aModule+"_"+i, aDependency);
					ImGui_SetStateInt("Module_Dependency_"+aModule+"_"+(i+1), -1);
					break;
				}
			}
			
			//-------------------------------------------------------
			
			void AddTypeDependency(eSimulationTerminalModules aModule, eSimulationModuleType aType)
			{
				int i = 1;
				while (true)
				{
					if (ImGui_GetStateInt("Type_Dependency_"+aModule+"_"+i, -1)!=-1)
					{
						i++;
						continue;
					}
						
					ImGui_SetStateInt("Type_Dependency_"+aModule+"_"+i, aType);
					ImGui_SetStateInt("Type_Dependency_"+aModule+"_"+(i+1), -1);
					break;
				}
			}

			//-------------------------------------------------------
			bool mbReInit = false;
			
			void ARKTerminal_WorldSetup()
			{
				// Debugging
				if (mbReInit)
				{
					mbReInit=false;
					ARKTerminal_InitWorldSetup();
				}
				//
				
				int lMaxMemory = 1152;
				int lMemory = 0;
				
				cImGuiButtonData toggleButton = StationGui_CreateToggleButtonData();
				toggleButton.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.04);
				toggleButton.mFont.mColor = toggleButton.mFont.mColor * cColor(0.7, 1);
				toggleButton.mFontAlign = eFontAlign_Left;
				toggleButton.mColorBase = cColor(0);
				toggleButton.mColorInFocus = toggleButton.mColorInFocus * cColor(0.75, 1);
				toggleButton.mColorTriggeredAndInFocus = toggleButton.mColorTriggeredAndInFocus * cColor(0.75, 1);
				toggleButton.mbUseBackgroundGfx = true;
				toggleButton.mbUseFrame = false;
				toggleButton.mfClipAreaPaddingRight = 50;
				toggleButton.mfClipAreaPaddingLeft = 0;
				
				cImGuiButtonData toggleButtonDisabled = toggleButton;
				//toggleButtonDisabled.mColorBase = cColor(1);
				toggleButtonDisabled.mColorDisabled = toggleButtonDisabled.mColorDisabled * cColor(2, 1);
				
				cImGuiLabelData headlineLabel = ImGui_GetDefaultLabel();
				headlineLabel.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
				headlineLabel.mFontAlign = eFontAlign_Center;
				headlineLabel.mbUseBackgroundGfx = true;
				headlineLabel.mGfxBackground.mColor = gStationGuiColor_Normal*0.875;
				headlineLabel.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0375);
				
				cImGuiLabelData label = ImGui_GetDefaultLabel();
				label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
				label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0375);
				
				//////////////////////////
				// Layout variables
				float fWindowEdge = 0.025;
				float fWindowSpace = 0.025;
				float fModuleWindowWidth = 0.525;
				float fStatusWindowX = fWindowEdge+fModuleWindowWidth+fWindowSpace;
				
				// Reset module type selections and focus
				for (int i = eSimulationModuleType_Null; i < eSimulationModuleType_LastEnum; i++) 
				{
					ImGui_SetStateBool("Type_Selected_"+i, false);
					ImGui_SetStateBool("Type_Focused_"+i, false);
				}
					
				//////////////////////////
				// Module window
				ImGui_DoWindowStart("ArkTerminalModules", StationGui_CreateDefaultWindowData(), 
									ImGui_NrmPosGroup(fWindowEdge, 0.05, 1), ImGui_NrmSizeGroup(fModuleWindowWidth, 0.9));
					ImGui_GroupBegin(ImGui_NrmPosGroup(0.0125, 0.05, 1), ImGui_NrmSizeGroup(0.48, 0.9));
					ImGui_DoLabelExt("ArkTerminalModule_System_Header", headlineLabel, ImGui_NrmPosGroup(0, 0, 1), ImGui_NrmSizeGroup(1, 0.06));
					for (int i = 1; i < eSimulationTerminalModules_System_LastEnum; i++)
					{
						lMemory += ModuleSelection(i, i*0.07f, lMaxMemory, toggleButton);
					}
					ImGui_GroupEnd();
					
					ImGui_GroupBegin(ImGui_NrmPosGroup(0.0125, 0.07*eSimulationTerminalModules_System_LastEnum, 1), ImGui_NrmSizeGroup(0.48, 0.9));
					ImGui_DoLabelExt("ArkTerminalModule_Scene_Header", headlineLabel, ImGui_NrmPosGroup(0, 0, 1), ImGui_NrmSizeGroup(1, 0.06));
					ImGui_SetModUseInput(false);
					for (int i = eSimulationTerminalModules_System_LastEnum; i < eSimulationTerminalModules_Scene_LastEnum; i++)
					{
						float fY = (i-eSimulationTerminalModules_System_LastEnum+1)*0.07;
						lMemory += ModuleSelection(i, fY, lMaxMemory, toggleButtonDisabled);
					}
					ImGui_SetModUseInput(true);
					ImGui_GroupEnd();
					
					ImGui_GroupBegin(ImGui_NrmPosGroup(0.5075, 0.05, 1), ImGui_NrmSizeGroup(0.48, 0.9));
					ImGui_DoLabelExt("ArkTerminalModule_Object_Header", headlineLabel, ImGui_NrmPosGroup(0, 0, 1), ImGui_NrmSizeGroup(1, 0.06));
					for (int i = eSimulationTerminalModules_Scene_LastEnum; i < eSimulationTerminalModules_Object_LastEnum; i++)
					{
						float fY = (i-eSimulationTerminalModules_Scene_LastEnum+1)*0.07;
						lMemory += ModuleSelection(i, fY, lMaxMemory, toggleButton);
					}
					ImGui_GroupEnd();
				ImGui_DoWindowEnd();
				
				//////////////////////////
				// Check dependencies
				int lErrorCount = 0;
				
				for (int i = 1; i < eSimulationTerminalModules_Object_LastEnum; i++)
				{
					if (ImGui_GetStateBool("Module_Selected_"+i, false)==false)
						continue;
					
					//////////////////////////
					// Specific modules
					int j = 1; 
					int lDependency = ImGui_GetStateInt("Module_Dependency_"+i+"_"+j, -1);
					while (lDependency >= 0)
					{
						if (ImGui_GetStateBool("Module_Selected_"+lDependency, false)==false)
						{
							ImGui_SetStateInt("SetupError_"+lErrorCount+"_ErrorType",0);
							ImGui_SetStateInt("SetupError_"+lErrorCount+"_Module",i);
							ImGui_SetStateInt("SetupError_"+lErrorCount+"_Dependency",lDependency);
							
							bool bFocused = ImGui_GetStateBool("Module_Focused_"+lDependency, false);
							ImGui_SetStateBool("SetupError_"+lErrorCount+"_Focus",bFocused);
							
							lErrorCount++;
						}
						
						j++;
						lDependency = ImGui_GetStateInt("Module_Dependency_"+i+"_"+j, -1);
					}
					
					
					//////////////////////////
					// Module types
					j = 1; 
					lDependency = ImGui_GetStateInt("Type_Dependency_"+i+"_"+j, -1);
					while (lDependency >= 0)
					{
						if (ImGui_GetStateBool("Type_Selected_"+lDependency, false)==false)
						{
							ImGui_SetStateInt("SetupError_"+lErrorCount+"_ErrorType",1);
							ImGui_SetStateInt("SetupError_"+lErrorCount+"_Module",i);
							ImGui_SetStateInt("SetupError_"+lErrorCount+"_Dependency",lDependency);
							
							bool bFoused = ImGui_GetStateBool("Type_Focused_"+lDependency, false);
							ImGui_SetStateBool("SetupError_"+lErrorCount+"_Focus",bFoused);
							
							lErrorCount++;
						}
						
						j++;
						lDependency = ImGui_GetStateInt("Type_Dependency_"+i+"_"+j, -1);
					}
				}
				
				//////////////////////////
				// Status window
				ImGui_DoWindowStart("ArkTerminalSetupStatus", StationGui_CreateDefaultWindowData(), 
									ImGui_NrmPosGroup(fStatusWindowX, 0.05, 1), ImGui_NrmSizeGroup(1.0f-fWindowEdge-fStatusWindowX, 0.9));
									
					/////////////////////////
					// Info
					ImGui_GroupBegin(ImGui_NrmPosGroup(0.05, 0.025, 1), ImGui_NrmSizeGroup(0.9, 0.5));
						float fInfoY = 0;	
						float fLineSpace = 0.085;
						cColor focusColor = ImGui_FadeOscillateColor("ErrorFocusColor", gStationGuiColor_Highlight, gStationGuiColor_Highlight*0.875f, 0.75);
						
						/////////////////////////
						// Memory error
						if (lMemory > lMaxMemory)
						{
							ImGui_SetModColorMul(cColor_Red);
							ImGui_DoLabelExt("ArkTerminalSetupStatusMemory_1", label, ImGui_NrmPosGroup(0, fInfoY, 0), ImGui_NrmSizeGroup(1, 0.1));
							fInfoY+=fLineSpace;
							array<tWString> lineBreaks;
							GetFontWordWrapRows(label.mFont, 1, "ArkTerminalSetupStatusMemory_2", ImGui_GetCurrentGroupSize().x, lineBreaks);
							
							for (int i = 0; i < lineBreaks.length(); i++)
							{
								ImGui_SetTextOverride(lineBreaks[i]);
								ImGui_DoLabelExt("", label, ImGui_NrmPosGroup(0, fInfoY, 0), ImGui_NrmSizeGroup(1, 0.1));
								fInfoY+=fLineSpace;
							}
							fInfoY+=fLineSpace;
							ImGui_ClearTextOverride();
						}
						
						/////////////////////////
						// Required module errors
						label.mFontAlign = eFontAlign_Left;
						bool bRequiredModulesMissing = false;
						if (ImGui_GetStateBool("Module_Selected_"+eSimulationTerminalModules_Object_Humanoid, false)==false)
						{
							bool bFocused = ImGui_GetStateBool("Module_Focused_"+eSimulationTerminalModules_Object_Humanoid, false);
							ImGui_SetModColorMul(bFocused ? focusColor : cColor_Red);
							ImGui_DoLabelExt("ArkTerminalSetupStatusRequiredModule_Soma", label, ImGui_NrmPosGroup(0, fInfoY, 0), ImGui_NrmSizeGroup(1, 0.1));
							bRequiredModulesMissing = true;
							fInfoY+=fLineSpace;
						}
						if (ImGui_GetStateBool("Module_Selected_"+eSimulationTerminalModules_Scene_Plains, false)==false && 
							ImGui_GetStateBool("Module_Selected_"+eSimulationTerminalModules_Scene_Forest, false)==false)
						{
							bool bFocused = ImGui_GetStateBool("Module_Focused_"+eSimulationTerminalModules_Scene_Plains, false) ||
											ImGui_GetStateBool("Module_Focused_"+eSimulationTerminalModules_Scene_Forest, false);
							ImGui_SetModColorMul(bFocused ? focusColor : cColor_Red);
							ImGui_DoLabelExt("ArkTerminalSetupStatusRequiredModule_Ground", label, ImGui_NrmPosGroup(0, fInfoY, 0), ImGui_NrmSizeGroup(1, 0.1));
							bRequiredModulesMissing = true;
							fInfoY+=fLineSpace;
						}
						ImGui_SetModColorMul(cColor_White);
							
						/////////////////////////
						// Dependency errors
						if (lErrorCount>0)
						{
							for (int i = 0; i < lErrorCount; i++)
							{
								// Make sure the window doesn't fill up
								if (fInfoY >= fLineSpace*10)
								{
									ImGui_SetTextOverride(tWString("..."));
									ImGui_DoLabelExt("", label, ImGui_NrmPosGroup(0, fInfoY, 0), ImGui_NrmSizeGroup(1, 0.1));
									ImGui_ClearTextOverride();
									break;
								}
								
								int lErrorType = ImGui_GetStateInt("SetupError_"+i+"_ErrorType",-1);
								int lModule = ImGui_GetStateInt("SetupError_"+i+"_Module",-1);
								int lDependency = ImGui_GetStateInt("SetupError_"+i+"_Dependency",-1);	
								bool bFocused = ImGui_GetStateBool("SetupError_"+i+"_Focus", false);
								
								label.mFontAlign = eFontAlign_Left;
								tWString sText = ImGui_Translate("ArkTerminalModule_System_"+lModule) + " " + 
												 ImGui_Translate("ArkTerminalSetupStatusDependency") + " ";
								
								if (lErrorType == 0)
									sText += ImGui_Translate("ArkTerminalModule_System_"+lDependency);
								else
									sText += ImGui_Translate("ArkTerminalModuleType_"+lDependency);
									
								ImGui_SetModColorMul(bFocused ? focusColor : cColor_Red);
								ImGui_SetTextOverride(sText);
								ImGui_DoLabelExt("", label, ImGui_NrmPosGroup(0, fInfoY, 0), ImGui_NrmSizeGroup(1, 0.1));
								ImGui_ClearTextOverride();
									
								fInfoY+=fLineSpace;
							}
							ImGui_SetModColorMul(cColor_White);
						}
					ImGui_GroupEnd();
				
					/////////////////////////
					// Memory gauge
					//label.mbUseBackgroundGfx=false;
					ImGui_SetModColorMul(lMemory <= lMaxMemory ? cColor_White : cColor_Red);
					ImGui_DoLabelExt("ArkTerminalMemory", label, ImGui_NrmPosGroup(0.05, 0.575, 1), ImGui_NrmSizeGroup(0.9, 0.06));
					ImGui_SetTransCategory("");
					label.mFontAlign = eFontAlign_Right;
					ImGui_DoLabelExt(lMemory+"TB / "+lMaxMemory+"TB", label, ImGui_NrmPosGroup(0.05, 0.575, 1), ImGui_NrmSizeGroup(0.9, 0.06));
					ImGui_DoGauge(StationGui_CreateDefaultGaugeData(), lMemory/float(lMaxMemory), ImGui_NrmPosGroup(0.05, 0.625, 1), ImGui_NrmSizeGroup(0.9, 0.1));
					ImGui_SetTransCategory("02_06_theta_tunnels");
					ImGui_SetModColorMul(cColor_White);
					
					/////////////////////////
					// Next Button
					ImGui_SetModUseInput(lMemory <= lMaxMemory && lErrorCount==0 && bRequiredModulesMissing==false);
					ImGui_SetModUISizeVertExpansion(4.5, 0);
					if (ImGui_DoButton("NextButton", "ArkTerminalSetupNext", ImGui_NrmPosGroup(0.5, 0.775, 1), ImGui_NrmSizeGroup(0.45, 0.175)))
					{
						StationGui_SetActiveApp(eSimulationTerminalApp_Loading);
						ImGui_SetStateInt("NextApp", eSimulationTerminalApp_MindSetup);
						Depth_Audio_Terminal_Forward(ImGui_GetName());
					}
				
				ImGui_DoWindowEnd();
			}

			//-------------------------------------------------------
			
			int ModuleSelection(int alModule, float afY, int alMaxMemory, const cImGuiButtonData &in aButton)
			{
				cImGuiLabelData label = ImGui_GetDefaultLabel();
				label.mFontAlign = eFontAlign_Right;
				label.mFont = aButton.mFont;
				
				bool bPressed = ImGui_DoToggleButtonExt("ArkTerminalModule_"+alModule, "ArkTerminalModule_System_"+alModule, 
														ImGui_GetStateBool("ModuleChecked_"+alModule, false), aButton, 
														ImGui_NrmPosGroup(0, afY, 1), ImGui_NrmSizeGroup(1, 0.06)); 
				bool bFocused = ImGui_PrevInFocus();
				bool bBecamePressed = ImGui_PrevBecamePressed();
														
				int lMemory = int(alMaxMemory*ImGui_GetStateFloat("Module_Memory_"+alModule, 0));
				ImGui_SetTransCategory("");
				ImGui_DoLabelExt("["+lMemory+" TB]", label, ImGui_NrmPosGroup(0, afY, 1.5), ImGui_NrmSizeGroup(1, 0.06));
				ImGui_SetTransCategory("02_06_theta_tunnels");
				
				ImGui_SetStateBool("Module_Selected_"+alModule, bPressed);
				ImGui_SetStateBool("Module_Focused_"+alModule, bFocused);
				
				if (bBecamePressed)
				{
					if (bPressed)
						Depth_Audio_Terminal_Forward(ImGui_GetName());
					else
						Depth_Audio_Terminal_Back(ImGui_GetName());
				}
				
				if (bPressed)
				{
					int lType = ImGui_GetStateInt("Module_Type_"+alModule, eSimulationModuleType_Null);
					ImGui_SetStateBool("Type_Selected_"+lType, true);
				}
				if (bFocused)
				{
					int lType = ImGui_GetStateInt("Module_Type_"+alModule, eSimulationModuleType_Null);
					ImGui_SetStateBool("Type_Focused_"+lType, true);
				}
				
				return bPressed ? lMemory : 0;
			}
			
			//} END WORLD SETUP APP
			
			//-------------------------------------------------------

			/////////////////////////////////////////
			// App *Mind Setup*
			//{///////////////////////////////////////

			//-------------------------------------------------------
			
			void ARKTerminal_MindSetup()
			{
				cImGuiButtonData toggleButton = StationGui_CreateToggleButtonData();
				toggleButton.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0375);
					
				ImGui_GroupBegin(ImGui_NrmPosGroup(cVector3f(0.025, 0.025, 1)), ImGui_NrmSizeGroup(cVector2f(0.95, 0.95)));	
				
					int lSelection = ImGui_GetStateInt("ScanSelection", -1);
					ImGui_DoWindowStart("ArkTerminalScans", StationGui_CreateDefaultWindowData(), ImGui_NrmPosGroup(0.325, 0, 1), ImGui_NrmSizeGroup(0.35, 1));
					for (int i = 1; i <= 5; i++)
					{
						bool bDeleted = cScript_GetGlobalVarBool("PlayerErasedLegacyData_"+(i-1));
						tWString sText = ImGui_Translate("ArkTerminalScan_"+i);
						if (bDeleted) sText += "  [" + cResources_Translate("02_05_theta_inside", "ScanRoom_Legacy_Deleted")+"]";
						ImGui_SetTextOverride(sText);
						
						ImGui_SetModUseInput(bDeleted==false);
						bool bSelected = ImGui_DoToggleButtonExt("ScanButton_"+i, "", lSelection==i, toggleButton, 
																 ImGui_NrmPosGroup(0.05, 0.045+0.140*(i-1), 1), ImGui_NrmSizeGroup(0.9, 0.115));
						if (bSelected) lSelection = i;
					}
					ImGui_DoWindowEnd();
					ImGui_SetStateInt("ScanSelection", lSelection);
					
					ImGui_SetModUseInput(lSelection > 0);
					if (ImGui_DoButton("UploadScanButton", "ArkTerminalScanUpload", ImGui_NrmPosGroup(0.3875, 0.8, 3), ImGui_NrmSizeGroup(0.225, 0.15)))
					{
						if (lSelection != 5)
						{
							StationGui_SetError("ArkTerminalError_IncorrectScan");
							Voice_Play("1_LegacyScanUploadError");
						}
						else
						{
							ARKTerminal_InitRun();
							StationGui_SetActiveApp(eSimulationTerminalApp_Loading);
							ImGui_SetStateInt("NextApp", eSimulationTerminalApp_Run);
							Depth_Audio_Terminal_Forward(ImGui_GetName());
						}
					}
				ImGui_GroupEnd();
			}
			
			//} END MIND SETUP APP
			
			//-------------------------------------------------------

			/////////////////////////////////////////
			// App *Run*
			//{///////////////////////////////////////

			//-------------------------------------------------------
			
			array<tString> mvModules;
			int mlModuleUpdateCount = -1;
			int mlSimUpdateSpeedIndex = 0;

			//-------------------------------------------------------
			
			void ARKTerminal_InitRun()
			{
				mvModules.push_back("ArkTerminalScan_5");
				
				for (int i = 1; i < eSimulationTerminalModules_Object_LastEnum; i++)
				{
					if (ImGui_GetStateBool("Module_Selected_"+i, false)==false)
						continue;
					
					mvModules.push_back("ArkTerminalModule_System_"+i);
				}
				
				ImGui_SetStateInt("CurrentModule", cMath_RandRectl(1, mvModules.length()-1));
				ImGui_SetStateFloat("ModuleUpdate", cMath_RandRectf(0.017f, 0.1f));
				
				mlModuleUpdateCount = mvModules.length();
			}

			//-------------------------------------------------------
			
			void ARKTerminal_Run(float afTimeStep)
			{
				if (mSimulationTerminalState == eSimulationTerminalState_Diagnostic)
				{
					cGuiDialogBoxSettings dialogBox = StationGui_CreateDefaultDialogBox();
					dialogBox.mbEndWindow = false;
					Depth_ImGui_DialogBox("", "ARKDiag", dialogBox);
					
					bool bLoadingFinished = Depth_ImGui_LoadingGauge("ArkTerminalLoading", 3, true, ImGui_NrmPosGroup(cVector3f(0.05, 0.3, 1)), 
																ImGui_NrmSizeGroup(cVector2f(0.9, 0.4)), StationGui_CreateDefaultGaugeData());
					ImGui_DoWindowEnd();
					
					if (bLoadingFinished)
					{
						Terminal_SetUpdateWhenOutOfView(ImGui_GetName(), false);
						mSimulationTerminalState = eSimulationTerminalState_Stopped;
						
						if (mbFinishedSim==false)
						{
							Voice_Stop("Dialog");
							Dialog_Begin("ArkSimComplete");
								Dialog_AddBranch("1_ArkSimComplete");
									Dialog_AddSubject("1_ArkSimComplete");
									if (mbPlayerScanned==false && mbKnowsAboutScanner) 
										Dialog_AddSubject("1_ArkSimComplete_NotScanned_SeenScanner");
									else if (mbPlayerScanned==false)
										Dialog_AddSubject("1_ArkSimComplete_NotScanned_NotSeenScanner");
									else
									{
										Dialog_AddSubject("1_ScanningAndSimDone_1", "");
										Dialog_AddEndEvent_Callback("DialogEvent_ScanningAndSimDone", "1_ScanningAndSimDone_2");
									}

								Dialog_AddBranch("1_ScanningAndSimDone_2");
									Dialog_AddSubject("1_ScanningAndSimDone_2", "Subject_EjectCathTool");
							Dialog_End();
							mbFinishedSim = true;
						}
					}
					return;
				}
					
				cImGuiWindowData window = StationGui_CreateDefaultWindowData();
				window.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0625);
				ImGui_DoWindowStart("ArkTerminalRunHeader", window, ImGui_NrmPosGroup(cVector3f(0.05,0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.9)));	
					ImGui_DoTextFrame("ARKVersion", 		  ImGui_NrmSizeGroup(cVector2f(0.05, 0)), 5, 0, ImGui_NrmPosGroup(cVector3f(0, 0.025, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
				
					switch (mSimulationTerminalState)
					{
						case eSimulationTerminalState_Running:
							ImGui_IncStateFloat("ModuleUpdate", -afTimeStep*gvArkSimulationSpeeds[mlSimUpdateSpeedIndex]);
							if (ImGui_GetStateFloat("ModuleUpdate", 0) <= 0)
							{
								int lCurrentModule = ImGui_GetStateInt("CurrentModule", 0);
								lCurrentModule = cMath_Wrap(lCurrentModule+1, -1, mvModules.length()-1);
								ImGui_SetStateInt("CurrentModule", lCurrentModule);
								ImGui_SetStateFloat("ModuleUpdate", cMath_RandRectf(0.03f, 0.04f));
								mlModuleUpdateCount-=1;
								if (mlModuleUpdateCount <= 0)
								{
									mlModuleUpdateCount = mvModules.length();
									mfSimulationSeconds += .1;
								}
							}
						break;
					}

					ImGui_SetTransCategory("02_06_theta_tunnels");
					
					cImGuiButtonData button = StationGui_CreateDefaultButtonData();
					
					ImGui_ResizeFontToFit("ButtonDiag", button.mFont, ImGui_GetCurrentGroupSize().x * 0.35);
					ImGui_ResizeFontToFit("ButtonStart", button.mFont, ImGui_GetCurrentGroupSize().x * 0.35);
					ImGui_ResizeFontToFit("ButtonStop", button.mFont, ImGui_GetCurrentGroupSize().x * 0.35);
					ImGui_ResizeFontToFit("ButtonReset", button.mFont, ImGui_GetCurrentGroupSize().x * 0.35);
					
					//////////////////////////
					// Run Diagnostics Button
					ImGui_SetModUseInput(mSimulationTerminalState == eSimulationTerminalState_Stopped && ImGui_GetStateInt("CurrentModule", -1)==0);
					if (ImGui_DoButtonExt("ButtonDiag","ButtonDiag", button, ImGui_NrmPosGroup(cVector3f(0.025, 0.2, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.15))))
					{
						Terminal_SetUpdateWhenOutOfView(ImGui_GetName(), true);
						mSimulationTerminalState = eSimulationTerminalState_Diagnostic;
						Depth_Audio_Terminal_Forward("ArkTerminalSoundSource");
					}
			
					/////////////////////////
					// Start Sim Button
					ImGui_SetModUseInput(mSimulationTerminalState != eSimulationTerminalState_Running);
					if (ImGui_DoButtonExt("ButtonStart","ButtonStart", button, ImGui_NrmPosGroup(cVector3f(0.025, 0.4, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.15))))
					{
						mSimulationTerminalState = eSimulationTerminalState_Running;
						Depth_Audio_Terminal_Forward("ArkTerminalSoundSource");
						Audio_ArkSimStart("computer_case_1");
					}
				
					/////////////////////////
					// Stop Sim Button
					ImGui_SetModUseInput(mSimulationTerminalState == eSimulationTerminalState_Running);
					if (ImGui_DoButtonExt("ButtonStop","ButtonStop", button, ImGui_NrmPosGroup(cVector3f(0.025, 0.6, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.15))))
					{
						// Force player to slow down simulation in order to press stop at the right time
						if (mlSimUpdateSpeedIndex<=1 && ImGui_GetStateInt("CurrentModule", -1)==0)
						{
							cLux_AddDebugMessage("Forced Dummy skip");
							ImGui_SetStateInt("CurrentModule", 1);
						}
						
						mSimulationTerminalState = eSimulationTerminalState_Stopped;
						Depth_Audio_Terminal_Forward("ArkTerminalSoundSource");
						Audio_ArkSimPause("computer_case_1");
						
						if (CathTool_IsInserted("CathTool") && ImGui_GetStateInt("CurrentModule", -1)!=0)
							Voice_Play("1_ArkSimPaused");
					}
					
					/////////////////////////
					// Reset Sim Button
					ImGui_SetModUseInput(mfSimulationSeconds > 0);
					if (ImGui_DoButtonExt("ButtonReset","ButtonReset", button, ImGui_NrmPosGroup(cVector3f(0.025, 0.8, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.15))))
					{
						Depth_Audio_Terminal_Negative("ArkTerminalSoundSource");
						mfSimulationSeconds = 0;
					}
					
					/////////////////////////
					// Speed Control
					ImGui_SetModUseInput(mSimulationTerminalState == eSimulationTerminalState_Running);
					if (ImGui_DoButton("SpeedDownButton","ArkTerminalRunSpeedDown", ImGui_NrmPosGroup(cVector3f(0.5, 0.725, 1)), ImGui_NrmSizeGroup(cVector2f(0.075, 0.15))))
					{
						Depth_Audio_Terminal_Negative("ArkTerminalSoundSource");
						mlSimUpdateSpeedIndex = cMath_Min(mlSimUpdateSpeedIndex+1, gvArkSimulationSpeeds.length()-1);
					}
					if (ImGui_DoButton("SpeedUpButton","ArkTerminalRunSpeedUp", ImGui_NrmPosGroup(cVector3f(0.725, 0.725, 1)), ImGui_NrmSizeGroup(cVector2f(0.075, 0.15))))
					{
						Depth_Audio_Terminal_Confirm("ArkTerminalSoundSource");
						mlSimUpdateSpeedIndex = cMath_Max(mlSimUpdateSpeedIndex-1, 0);
					}
					ImGui_SetModUseInput(true);
				
					ImGui_DoTextFrame("ARKModule", ImGui_NrmSizeGroup(cVector2f(0, 0)), 5, 0, ImGui_NrmPosGroup(cVector3f(0.5, 0, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
					ImGui_DoTextFrame(""+mvModules[ImGui_GetStateInt("CurrentModule", 0)], ImGui_NrmSizeGroup(cVector2f(0, 0)), 0, 0, ImGui_NrmPosGroup(cVector3f(0.55, 0.1, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
					ImGui_DoTextFrame("ARKTime", ImGui_NrmSizeGroup(cVector2f(0, 0)), 5, 0, ImGui_NrmPosGroup(cVector3f(0.5, 0.3, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
					ImGui_DoTextFrame("ARKTimeScale", ImGui_NrmSizeGroup(cVector2f(0, 0)), 5, 0, ImGui_NrmPosGroup(cVector3f(0.5, 0.6, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
					
					ImGui_SetTransCategory("");
					ImGui_DoTextFrame(String_SecondsToClockDisplay(mfSimulationSeconds,true,true,true,true), ImGui_NrmSizeGroup(cVector2f(0, 0)), 0, 0, ImGui_NrmPosGroup(cVector3f(0.55, 0.4, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
					
					cImGuiTextFrameData text = ImGui_GetDefaultTextFrame();
					text.mFontAlign = eFontAlign_Center;
					ImGui_DoTextFrameExt(int(gvArkSimulationSpeeds[mlSimUpdateSpeedIndex]*100)+"%", ImGui_NrmSizeGroup(cVector2f(0, 0)), 0, 0, text, ImGui_NrmPosGroup(cVector3f(0.575, 0.75, 0)), ImGui_NrmSizeGroup(cVector2f(0.1525,1)));
					
				ImGui_DoWindowEnd();
			}
			
			//} END RUN APP

		//-------------------------------------------------------
		
		//} END ARK TERMINAL
		
		/////////////////////////////////////////////////////////
		// Terminal: Main Termianl
		//{//////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		//-------------------------------------------------------
		
		void MainTerminal_OnGui(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("02_06_theta_tunnels");
			
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop("background_logo_pathosstation");
			StationGuiBG_Taskbar("theta");
			
			bool bBackButtonActive = true;
			
			int lState = StationGui_GetActiveApp(0);
			switch(lState)
			{
				case 0:
				StationGui_AddApp("Documents", true, 1);
				StationGui_AddApp("MainTerminal_ArkLocator", true, 2);
				StationGui_AddApp("MainTerminal_Quiz", true, 3);
				StationGui_MainMenu();
				bBackButtonActive = false;
				break;
				
				case 1:
				Depth_ImGui_AddTextFile("MainTerminalFileName_1", "MainTerminalFile_1");
				Depth_ImGui_AddTextFile("MainTerminalFileName_2", "MainTerminalFile_2");
				StationGui_TextReaderMulti();
				break;
				
				case 2:
				MainTerminalArkLocator();
				break;
				
				case 3:
				bBackButtonActive = OnGuiQuizApp();
				break;
			}
			
			StationGui_BackButton(bBackButtonActive, 0);
		}
		
		//-------------------------------------------------------
		
		void MainTerminalArkLocator()
		{
			cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
			ImGui_DoWindowStart("MainTerminal_ArkLocator", windowData, ImGui_NrmPos(cVector3f(0.1875, 0.025, 1.5)), ImGui_NrmSize(cVector2f(0.625, 0.8)));
			
			cImGuiGfx map = cImGuiGfx("arklocator_map", eImGuiGfx_Texture);
			cImGuiGfx ark = cImGuiGfx("arklocator_ark", eImGuiGfx_Texture);
			
			ImGui_DoImage(map, ImGui_NrmPosGroup(cVector3f(0, 0, 1)), ImGui_GetRatioCorrectSizeByNrmWidth(map, 1));
			
			StationGui_YouAreHereIcon(ImGui_NrmPosGroup(0.23, 0.55, 1.1), ImGui_NrmSizeGroupKeepRatio(0.25));
			ImGui_SetModColorMul(ImGui_FadeOscillateColor("PathGlow", cColor_White, cColor(1, 0.75), 2));
			ImGui_DoImage(cImGuiGfx("arklocator_path", eImGuiGfx_Texture), ImGui_NrmPosGroup(cVector3f(0, 0, 1.1)), ImGui_GetRatioCorrectSizeByNrmWidth(map, 1));
			ImGui_DoImage(ark, ImGui_NrmPosGroup(cVector3f(0.8, 0.445, 1.2)), ImGui_GetRatioCorrectSizeByRect(ark, ImGui_NrmSizeGroup(0.112, 0.112)));
			ImGui_SetModColorMul(cColor_White);
			
			ImGui_DoWindowEnd();
		}
				
				/////////////////////////////////////////
				// App Main Terminal: Quiz
				//{//////////////////////////////////////
				
				int mlQuizCurrentQuestion=0;
				int mlQuizSelectedAnswer=-1;
				bool mbQuizLoading=false;
				bool mbQuizOnStartScreen=true;
				bool mbQuizSaved=false;
				
				//-------------------------------------------------------
				
				bool OnGuiQuizApp()
				{
					/////////////////////
					// GUI Data
					cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
					
					cImGuiButtonData buttonData = StationGui_CreateToggleButtonData();
					buttonData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.05);
					ImGui_SetDefaultButton(buttonData);
					
					cImGuiTextFrameData textFrame = StationGui_CreateDefaultTextFrameData();
					textFrame.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.04);
					
					cImGuiLabelData labelData;
					labelData.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
					labelData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.07);
					
					///////////////////////
					// Logic data
					const int lNumOfQuestions = 5;
					
					bool bUseBackButton = false;
						
					
					///////////////////////////
					// Loading
					if(mbQuizLoading)
					{
						tWString sDots = Depth_ImGui_Effect_AnimatedDots();
						
						ImGui_SetAlignment(eImGuiAlign_CenterLeft);
					
						float fTextWidth = GetFontLengthW(labelData.mFont, 1, ImGui_Translate("MainTerminal_QuizSaving")+". . .");
						cVector3f vPos = ImGui_NrmPos(1.0f, 0.5, 2);
						vPos.x = (vPos.x-fTextWidth)*0.5f;
						
						ImGui_SetTextOverride(ImGui_Translate("MainTerminal_QuizSaving")+sDots);
						ImGui_DoLabelExt("",labelData, vPos);
						ImGui_ClearTextOverride();
						
						float fQuizLoadingCount = Depth_ImGui_Loading("QuizLoading", 0, 1.0f, 1.65, true);

						if(fQuizLoadingCount>=1.0f)
						{
							mlQuizCurrentQuestion++;
							ImGui_SetFocus("QuizSelect$0");
							mlQuizSelectedAnswer=-1;
							mbQuizLoading=false;
							
							if (mlQuizCurrentQuestion>=lNumOfQuestions)
							{
								int[] vAnswers_0 = {76, 10, 12, 2};
								int[] vAnswers_1 = {44, 52, 4, 0};
								int[] vAnswers_2 = {68, 24, 4, 4};
								int[] vAnswers_3 = {24, 32, 18, 26};
								int[] vAnswers_4 = {22, 26, 20, 32};
								SetupQuizResults(0, vAnswers_0);
								SetupQuizResults(1, vAnswers_1);
								SetupQuizResults(2, vAnswers_2);
								SetupQuizResults(3, vAnswers_3);
								SetupQuizResults(4, vAnswers_4);
							}
						}
					}
					///////////////////////////
					// Start Screen
					else if(mbQuizOnStartScreen)
					{
						StationGui_DoWindowStart("MainTerminal_QuizAppName", windowData, ImGui_NrmPos(cVector3f(0.05, 0.22, 2)), ImGui_NrmSize(cVector2f(0.9, 0.45)), false);
						
							ImGui_DoTextFrameExt("MainTerminal_QuizIntro",
												0, 0, 0,textFrame, ImGui_NrmPos(0.025f, 0.025f, 2), ImGui_NrmSizeGroup(0.95, 0.95));
							
						StationGui_DoWindowEnd();
						
						cImGuiButtonData startButton = buttonData;
						startButton.mbClipText = false;
						if(ImGui_DoButtonExt("QuizStart", "MainTerminal_QuizStart", startButton, ImGui_NrmPos(0.55, 0.69, 2), ImGui_NrmSize(0.4, 0.1)))
						{
							Depth_Audio_Terminal_Forward(ImGui_GetName());
							mbQuizOnStartScreen = false;
						}
						
						
						bUseBackButton = true;
					}
					///////////////////////////
					// End Screen
					else if(mlQuizCurrentQuestion>=lNumOfQuestions)
					{
						StationGui_DoWindowStart("MainTerminal_QuizResultHeader", windowData, ImGui_NrmPos(cVector3f(0.05, 0.05, 2)), ImGui_NrmSize(cVector2f(0.9, 0.75)), false);
						
							ImGui_DoTextFrameExt("MainTerminal_QuizResultBody",
												0, 0, 0,textFrame, ImGui_NrmPosGroup(0.025f, 0.025f, 2), ImGui_NrmSizeGroup(0.95, 0.95));
							
							for (int i = 0; i < 5; i++)
							{
								float fQuestionYPos = 0.175+(i/2)*0.275;
								ImGui_DoTextFrameExt("MainTerminal_QuestionName_"+i,
													0, 0, 0,textFrame, ImGui_NrmPosGroup(0.025+(i%2)*0.5, fQuestionYPos, 2), ImGui_NrmSizeGroup(0.95, 0.95));
										
								int lPlayerAnswer = ImGui_GetStateInt("PlayerAnswer_"+i, -1);			
								for (int lAnswer = 0; lAnswer < 4; lAnswer++)
								{
									int lPercent = ImGui_GetStateInt("ARKQuizAnswers_"+i+"_"+lAnswer, 0);
									tWString sAnswerText = ImGui_Translate("MainTerminal_Answer_"+lAnswer) + " - "+lPercent+"%";
									
									textFrame.mColorText = (lAnswer == lPlayerAnswer ? gStationGuiColor_Warning : gStationGuiColor_Disabled*2);
									ImGui_SetTextOverride(sAnswerText);
									ImGui_DoTextFrameExt("",
														 0, 0, 0,textFrame, ImGui_NrmPosGroup(0.025+(i%2)*0.5, fQuestionYPos+0.05*(lAnswer+1), 2), 
														 ImGui_NrmSizeGroup(0.95, 0.95));
									ImGui_ClearTextOverride();
									textFrame.mColorText = gStationGuiColor_Normal;
								}
								
							}
						
						StationGui_DoWindowEnd();
						
						if(mbQuizSaved==false)
						{
							mbQuizSaved = true;
						}
						
						bUseBackButton = true;
					}
					///////////////////////////
					// Answers & Questions
					else
					{
						
						float fQuestionWindowHeight = 0.5f;
						////////////////////////
						// Question
						StationGui_DoWindowStart("MainTerminal_Question", windowData, ImGui_NrmPos(cVector3f(0.05, 0.05, 2)), ImGui_NrmSize(cVector2f(0.9, fQuestionWindowHeight)), false);
							
							ImGui_DoTextFrameExt("MainTerminal_Question_"+mlQuizCurrentQuestion,
												0, 0, 0,textFrame, ImGui_NrmPos(0.025f, 0.025f, 2), ImGui_NrmSizeGroup(0.95, 0.95));
												
						StationGui_DoWindowEnd();
						
						////////////////////////
						// Answer
						StationGui_DoWindowStart("MainTerminal_Answers", windowData, 
												 ImGui_NrmPos(cVector3f(0.05, fQuestionWindowHeight+0.07, 2)), 
												 ImGui_NrmSize(cVector2f(0.9, 0.8-(fQuestionWindowHeight+0.07))), false);
												 
							for(int i=0; i<4; ++i)
							{
								ImGui_ResizeFontToFit("MainTerminal_Answer_"+i, buttonData.mFont, ImGui_GetCurrentGroupSize().x*0.35);
							}
							for(int i=0; i<4; ++i)
							{
								bool bAnswerSelected = ImGui_DoButtonExt("QuizButton_"+i, "MainTerminal_Answer_"+i, buttonData,
																	     ImGui_NrmPosGroup(0.025+(i/2)*0.5, 0.025+(i%2)*0.5, 2), 
																	     ImGui_NrmSizeGroup(0.4, 0.4));
								if (bAnswerSelected)
								{
									mbQuizLoading =true;
									ImGui_SetStateInt("PlayerAnswer_"+mlQuizCurrentQuestion, i);
									Depth_Audio_Terminal_Confirm(ImGui_GetName());
								}
							}
							
						StationGui_DoWindowEnd();
					}
					
					
					ImGui_SetAlignment(eImGuiAlign_TopLeft);
					
					return bUseBackButton;
				}
				
				//-------------------------------------------------------
				
				void SetupQuizResults(int alQuestion, array<int> aAnswers)
				{
					int lPlayerAnswer = ImGui_GetStateInt("PlayerAnswer_"+alQuestion, 0);
					
					// Adjust answer for player choice
					int lMaxIndex = lPlayerAnswer;
					for (int i = 0; i < 4; i++)
					{
						if (aAnswers[i] > aAnswers[lMaxIndex])
						{
							lMaxIndex = i;
						}
					}
					aAnswers[lPlayerAnswer] += 2;
					aAnswers[lMaxIndex] -= 2;
					
					ImGui_SetStateInt("ARKQuizAnswers_"+alQuestion+"_0", aAnswers[0]);
					ImGui_SetStateInt("ARKQuizAnswers_"+alQuestion+"_1", aAnswers[1]);
					ImGui_SetStateInt("ARKQuizAnswers_"+alQuestion+"_2", aAnswers[2]);
					ImGui_SetStateInt("ARKQuizAnswers_"+alQuestion+"_3", aAnswers[3]);
				}
				
				//-------------------------------------------------------
				
				//} END App Cloud Terminal: Quiz
		
		//-------------------------------------------------------
		
		//} END Main Terminal
		
		/////////////////////////////////////////////////////////
		// Terminal: Mater's computer
		//{//////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbEmailSent = false;
		
		//-------------------------------------------------------
		
		void MastersTerminal_OnGui(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("02_06_theta_tunnels");	
			
