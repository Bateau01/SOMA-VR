	//////////////////////////////////////////
	// Scanner
	
	void Audio_ScannerDoor_Open()
	{
		Sound_CreateAtEntity("ScannerDoorOpen", "Entities_Station/doors/nuclear_scanner_door/open", "ScannerDoor");
	}
	
	void Audio_ScannerDoor_Close()
	{
		if(mbInsideScanner==true)
		{
			if(Sound_Exists("ScannerDoorOpen"))
			{
				Sound_Stop("ScannerDoorOpen", 0.35f);
			}
			
			Sound_CreateAtEntity("ScannerDoorClose_Interior", "Entities_Station/doors/nuclear_scanner_door/close_interior", "ScannerDoor");
		}
		else if(mbInsideScanner==false)
		{
			if(Sound_Exists("ScannerDoorOpen"))
			{
				Sound_Stop("ScannerDoorOpen", 0.35f);
			}
			
			Sound_CreateAtEntity("ScannerDoorClose", "Entities_Station/doors/nuclear_scanner_door/close", "ScannerDoor");
		}
		
	}
		
	//--------------------------------------------
	bool mbScanMusicActive = false;
	void Audio_ScannerStart()
	{
		Sound_CreateAtEntity("ScannerStart", "02_06_theta_tunnels/sfx/nuclear_scanner/start", "Player", 0.0f);
		Map_AddTimer("Audio_ScannerLoop", 2.0f, "Audio_ScannerLoop");
		
		if(mbScanMusicActive==false)
		{
			//Music_PlayExt("02_06_scan_sequence_loop", true, 0.35f, 1.0f, 7.0f, 0.0f, eMusicPrio_MinorEvent, false);
			mbScanMusicActive = true;
		}
	}
	
	void Audio_ScannerLoop(const tString &in asTimer)
	{
		Sound_CreateAtEntity("ScannerLoop", "02_06_theta_tunnels/sfx/nuclear_scanner/spinning", "Player", 1.25f, false, 0.75);
		Sound_CreateAtEntity("ScannerLoopPulse", "02_06_theta_tunnels/sfx/nuclear_scanner/scan_pulse", "Player", 1.25f, false, 0.75);
	}
	
	void Audio_ScannerStop()
	{
		Sound_CreateAtEntity("ScannerStop", "02_06_theta_tunnels/sfx/nuclear_scanner/stop", "Player", 0.0f);
		Sound_Stop("ScannerLoop", 0.25f);
		Sound_Stop("ScannerLoopPulse", 0.25f);
	}
	
