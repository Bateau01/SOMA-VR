	//-------------------------------------------------------
	
	//////////////////////////////////////////
	// FLESHER KNOCKS DOWN PLAYER
	//{///////////////////////////////////////
	
	//-------------------------------------------------------
	
	int mlFloor1Flesher_KnockDownCount=0;
	
	void Floor1Flesher_AfterDamage(const tString&in asEntityName)
	{
		mlFloor1Flesher_KnockDownCount++;
		
		if(mlFloor1Flesher_KnockDownCount>=3)
		{
			Entity_SetActive("agent_flesher_floor1", false);
		}
		
	}
	
