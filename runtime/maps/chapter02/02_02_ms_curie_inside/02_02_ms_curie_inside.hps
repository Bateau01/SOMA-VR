	//------------------------------------------------------
	
	void TimerDetachWau(const tString &in asTimer)
	{
		// Number of tentacles detached is passed as timer name and we cast this to a float
		int lPhase = mlTentaclesDetached;
		float fModifier = mlTentaclesDetached * 0.015f;
		
		// Three different phases of tentacle removal
		cLux_AddDebugMessage("Phase: " + lPhase);
		switch (lPhase)
		{
			////////////////////////////
			// First tentacle is detached
			case 1:
				Sound_CreateAtEntity("ReactorBlow1", "02_02_ms_curie_inside/SFX/wau_boiler/reactor_explosions/explosion_01", "Player");
                if(Sound_Exists("OilRelease"))
                {
                    Sound_Stop("OilRelease", 0.25f);
                }
				Sound_FadeGlobalVolume(0.25f, 0.05f);
				Map_AddTimer("ReactorFadeIn", 0.5f, "ReactorFadeIn");
				Effect_Shake_Start(0.05f + fModifier,1.0f,0.2f,0.2f);
			break;
			
			////////////////////////////
			// Second tentacle is detached
			case 2:
				Map_AddTimer("SecondTentacle", 1.0f, "ReactorShake");
			break;
			
			////////////////////////////
			// Third tentacle is detached
			case 3:
				Map_AddTimer("ThirdTentacle", 1.0f, "ReactorShake");
			break;
			
			default:
			/* Not used */
			break;
		}
	}
	
	//------------------------------------------------------
	
	void ReactorShake(const tString &in asTimer)
	{
		if(asTimer=="SecondTentacle")
		{
			Sound_CreateAtEntity("ReactorBlow2", "02_02_ms_curie_inside/SFX/wau_boiler/reactor_explosions/explosion_02", "Player");
            if(Sound_Exists("OilRelease"))
            {
                Sound_Stop("OilRelease", 0.25f);
            }
			Sound_Stop("ReactorBlow1", 0.05f);
			Sound_FadeGlobalVolume(0.2f, 0.05f);
			Map_AddTimer("ReactorFadeIn", 0.5f, "ReactorFadeIn");
			Effect_Shake_Start(0.1, 0.3, 0.1, 0.3);
			Player_FadeRollTo(-5.0f,2.0f,3.0f);
		}
		if(asTimer=="ThirdTentacle")
		{
			Sound_CreateAtEntity("ReactorBlow3", "02_02_ms_curie_inside/SFX/wau_boiler/reactor_explosions/explosion_03", "Player");
			Sound_Stop("ReactorBlow2", 0.05f);
			Sound_FadeGlobalVolume(0.2f, 0.05f);
			Map_AddTimer("ReactorFadeIn", 0.6f, "ReactorFadeIn");
			Effect_Shake_Start(0.15, 0.3, 0.1, 0.2);
		}
	}
		
	//------------------------------------------------------
	
	void ReactorFadeIn(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 4.0f);
	}
	
