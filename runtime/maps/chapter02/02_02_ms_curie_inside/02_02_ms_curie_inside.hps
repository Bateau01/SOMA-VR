	//-------------------------------------------------------
	
	void Setup()
	{
		cLux_AddDebugMessage("ENTERED SETUP");
		GetBase().SetDisplayNameEntry("02-02-ms-curie-inside");
		
		////////////////////
		// PRESETS FOR NEXT LEVEL TRANSITION
		Map_Preset_SetupBloom("2.2Preset", 128, 0.75, 0.1, cColor(1, 1, 1, 0.0));
		Map_Preset_SetupDepthOfField("2.2Preset", false, 1, 12, 1.0);
		Map_Preset_SetupColorGrading("2.2Preset", "textures/colorgrading/grading_default.dds");
		
		Entity_SetVarBool("Area_PlaceCatherine_Pod", "IsOmniSlot", true);
	}
	
	//-------------------------------------------------------
	
	
	////////////////////////////
	// Run first time starting map
	void OnStart()
	{	
		cLux_AddDebugMessage("ENTERED ONSTART");
		
		CathTool_ResetScreen(eCathToolVariant_Cath);
		
		////////////////////////////
		// Preload sounds
		Sound_PreloadProject("02_02_ms_curie_inside");
		Sound_PreloadGroup("Flashback/Level/02_02", true);

		StartMorseCodeSound();
	//	Music_FadeVolumeMul(0.0f, 0.5f);
		
		////////////////////////////
		// Setup scenes
		SetupScenes();
		
		//////////////////////////////////////////
		// Player setup
		Player_SetAmbientLight_Indoors();
		
		PlayerHands_SetHandModel_Diving();
		
		PlayerEnergy_SetFlowerSwallows(true);
		
		Map_SetUnderwater(true);
		
		//----DEBUG----//
		if(cLux_ScriptDebugOn())
		{
			//Add any debug stuff here
			//Entity_SetActive("TriggerArea_EscapePodExit*",true);
			//Entity_SetActive("TriggerArea_EscapePodDoor*",true);
			
			//Fade in!
		//	Effect_Fade_In(1);
		//	Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_WorldAll);
		//	Music_FadeVolumeMul(1.0f, 3.0f);
		}
		else
		{
			///////////////////////
			// Fade level in from black
		//	Effect_Fade_Out(0);
		//	Map_AddTimer("timer_fadein",0.2,"TimerFadeIn");
			StartIntro();
		}
		
		mlID_Player = Map_GetEntityID("Player",eLuxEntityType_Player);	
		
		//////////////////////////////////////////
		// Entity setup
		Tool_PickUp("cath_box_tool", false, false); // Get Catherine
		SetEmergencyLampsActive(false);
		PhysicsSlideDoor_SetLocked("shipwreck_slidedoor_medium_17", false, false); //otherwise locked when transition from 2.1
		
		SetupReactorRoom();
		
		
		LastOnSoma_SetText("02_02_ms_curie_inside_1");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	// S26AU: these rigid props retain callback names absent from this map.
	// A nonempty name alone advertises interaction. Clear only these known
	// stale prompts in VR; preserve a real implementation if one is present.
	// No per-frame lookup and no change to damage, collision or story events.
	void VR_RemoveUnusedRigidPrompts()
	{
		cScript_SetGlobalReturnBool(false);
		cScript_RunGlobalFunc("MenuHandler", "cScrMenuHandler", "HPL3VR_GetRuntimeActive");
		if(!cScript_GetGlobalReturnBool()) return;
		cLuxMap@ pMap = cLux_GetCurrentMap();
		if(pMap is null) return;
		if(!pMap.ScriptMethodExists("void InteractBreakableGlass(const tString &in)"))
			Entity_SetPlayerInteractCallback("BreakableGlass_7", "", false);
		if(!pMap.ScriptMethodExists("void InteractDamagedGlass(const tString &in)"))
			Entity_SetPlayerInteractCallback("BreakableGlass_1_Minor", "", false);
	}

	void OnEnter()
	{
        // S26BB: physical socket and authored use area are distinct entities.
        Entity_SetVarString("cath_terminal_escapepod_3", "VRUseTarget", "Area_PlaceCatherine_Pod");
		VR_RemoveUnusedRigidPrompts();
		MainMenu_SetBGPhase(eMainMenuPhase_1_3_To_2_4);
		
		cLux_AddDebugMessage("ENTERED ONENTER");
		//////////////////////////////////////////
		// Setup checkpoint
		CheckPoint_Setup("Floor1Checkpoint");
		
		//Map_SetUnderwater(true);
		cLux_GetCurrentMap().GetWorld().SetFogUnderwater(true);
		Effect_DoF_Start(0, 6, 0.5, 0);
	    float fFadeTime = 0.5;

		Effect_Bloom_FadeBrightPass(0.00001, 0); //set so pixels that are over 127 (255 * 0.5) contributes to bloom.
		Effect_Bloom_FadeBloomWidth(160, 0); //sets 128 pixels in bloom width, looks best between 32 - 512 pixels
		Effect_Bloom_FadeBloomTint(0.3, 0.3, 0.3, 0); //sets a red tint on bloom
	}
	
