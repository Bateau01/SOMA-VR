	//------------------------------------------------------
	
	///////////////////////////////////////////////////////
	// SCENE 3 - Prevent player from going near damaged reactors
	///////////////////////////////////////////////////////
	
	//------------------------------------------------------
	
	bool mbPlayerInDangerousSmokeArea = false;
	tString msSmokeAreaName = "";
	
	//------------------------------------------------------
	
	bool CollideHurtPlayer(const tString &in asParent, const tString &in asChild, int alState)
	{
		mbPlayerInDangerousSmokeArea = alState == 1 ? true : false;
		
		/////////////////////////////////////////
		// Should only happen after the puzzle is solved
		//if (mbWAURemoved == false) return true;
		
		Depth_Audio_PlayerTakeDamage();
		Depth_Audio_SimonHurt_Damage();
		
		if (mbPlayerInDangerousSmokeArea)
		{
			msSmokeAreaName = asChild;
			Map_AddTimer("timer_checkplayerdamage",0.1f,"TimerHurtPlayer");
			
		}
		
		return true;
	}
	
	//------------------------------------------------------
	
	void TimerHurtPlayer(const tString &in asTimer)
	{
		if (mbPlayerInDangerousSmokeArea == false) return;
		
		Player_GiveDamage(0.2f,0.3f,eDamageType_Steam,msSmokeAreaName);
		Map_AddTimer("timer_checkplayerdamage",1.0f,"TimerHurtPlayer");
	}
	
	//------------------------------------------------------
	
	///////////////////////////////////////////////////////
	// SCENE 3 - Cylinders Fall
	///////////////////////////////////////////////////////
	
	//------------------------------------------------------
	
	bool OnCollideAreaFallingCylinder(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		Effect_Shake_Start(0.015f,1.0f,0.2f,0.2f);
		ParticleSystem_CreateAtEntity("ps_bubbles_"+asParent,"oneshot_waterbubbles_explosion.ps",asParent,true);
		//oneshot_waterbubbles_big.ps
		
		if(asChild=="ElectricFallingCylinder_1")
		{
			Sound_CreateAtEntity("CylinderFall_1", "02_02_ms_curie_inside/SFX/curie_tilt/cylinder_drops/metal_cylinder_drop_03", asChild);
		}
		else if(asChild=="ElectricFallingCylinder_2")
		{
			Sound_CreateAtEntity("CylinderFall_2", "02_02_ms_curie_inside/SFX/curie_tilt/cylinder_drops/metal_cylinder_drop_02", asChild);
		}
		else if(asChild=="ElectricFallingCylinder_3")
		{
			Sound_CreateAtEntity("CylinderFall_3", "02_02_ms_curie_inside/SFX/curie_tilt/cylinder_drops/metal_cylinder_drop_01", asChild);
		}
		return false;
	}
	
	//----------------------------------------------------------------------
	
	cSequenceStatesData mSequenceFallingCylinders;
		
	void SequenceFallingCylinders(const tString &in asTimer)
	{
		Sequence_Begin("SequenceFallingCylinders", mSequenceFallingCylinders);
	
		if (Sequence_DoStepAndWait(1.0f))
		{
			cLux_AddDebugMessage("1 sec delay");
		}
		else if (Sequence_DoStepAndWait(2.5f))
		{
			TiltCurieLeft(true);
		}
		else if (Sequence_DoStepAndWait(3.0f))
		{
			Sound_Stop("wau_boiler_*", 0.05f);
			TiltCurieRight(true);
			OpenEscapePodDoor();
			StopMorseCodeSound();
			ParticleSystem_CreateAtEntity("ps_bubbles_detach_ElectricFallingCylinder_1","oneshot_waterbubbles_explosion.ps","ElectricFallingCylinder_1",false);
			Prop_SetStaticPhysics("ElectricFallingCylinder_1",false);
			
		}
		else if (Sequence_DoStepAndWait(2.25f))
		{
			ParticleSystem_CreateAtEntity("ps_bubbles_detach_ElectricFallingCylinder_2","oneshot_waterbubbles_explosion.ps","ElectricFallingCylinder_2",false);
			Prop_SetStaticPhysics("ElectricFallingCylinder_2",false);
		}
		else if (Sequence_DoStepAndWait(2.25f))
		{
			ParticleSystem_CreateAtEntity("ps_bubbles_detach_ElectricFallingCylinder_3","oneshot_waterbubbles_explosion.ps","ElectricFallingCylinder_3",false);
			Prop_SetStaticPhysics("ElectricFallingCylinder_3",false);
		}
		
		Sequence_End();
	}
	
	
	
	//------------------------------------------------------
	
	///////////////////////////////////////////////////////
	// SCENE 3 EVENT B Run to Lifeboat
	///////////////////////////////////////////////////////
	
	//------------------------------------------------------
	
	int mlCargoFlesherPatrols = 0;
	int mlCargoFlesherWindowCount = 0;
	
	//------------------------------------------------------
	
	void SetupEscapeSequence()
	{
		// Some lights are failing
		Lamp_SetFlickerActive("spotlight_tripod_flesher_lamp_2",true);
		Lamp_SetLit("sunken_warning*",false,true);
		Lamp_SetLit("StorageRoomDoorLamp",false,true);
		
		cLux_AddTodoMessage("ART: CONNECT ALL LIGHTS AND BILLBOARDS ON RED WARNING LAMPS");
		
	}
	
	bool mbIsAlarmSequenceActive = false;
	void StartAlarmSequence()
	{
		if(mbIsAlarmSequenceActive == false)
		{
			///////////////////////////////////
			// Begin alarm and light escape lamps
			StartEscapeAlarms();
			Lamp_SetLit("EscapeLamp_*",true,true);
			mbIsAlarmSequenceActive = true;
		}

	}
	
	//------------------------------------------------------
	
	void TimerCargoFlesherPatrol(const tString &in asTimer)
	{
		Map_AddTimer("timer_cargoflesherdistortion",cMath_RandRectf(1.0f,2.0f),"TimerCargoFlesherDistortion");
		
		Pathfinder_Track_Clear("Agent_flesher_windowbreak");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_522");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_525");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_524");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_523");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_526", 4.0f,7.0f);	// Wait!
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_535");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_537");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_534");
			
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_530", 4.0f,7.0f); // Wait!
			
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_534");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_537");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_535");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_526", 4.0f,7.0f);	// Wait!
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_523");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_524");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_525");
			Pathfinder_Track_Add("Agent_flesher_windowbreak", "PathNodeArea_522");
		Pathfinder_Track_Start("Agent_flesher_windowbreak",true,0.5f,"");
	}
	
	//------------------------------------------------------
	
	void OnCargoFlesherEndPath(const tString& in asEntityName)
	{
		++mlCargoFlesherPatrols;
		cLux_AddDebugMessage("AI/SCRIPT: Flesher ended his path.. " + mlCargoFlesherPatrols + " times..");
	}
	
	//------------------------------------------------------
	
	void TimerCargoFlesherDistortion(const tString &in asTimer)
	{
		//Map_AddTimer("timer_cargoflesherdistortion",cMath_RandRectf(10.0f,15.0f),"TimerCargoFlesherDistortion");
	}
	
	bool CollideAreaFlesherWindow(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		++mlCargoFlesherWindowCount;
		cLux_AddDebugMessage("AI/SCRIPT: Flesher was by window.. " + mlCargoFlesherWindowCount + " times..");
		
		if (mlCargoFlesherWindowCount >= 4)
		{
			////////////////////////////
			// We should teleport the Flesher away now..
			//Effect_VideoDistortion_Start(1.0f,0.1f,0.05f,0.05f,1.0f);
			Entity_SetActive("Agent_flesher_windowbreak",false);
		}
		return true;
	}
	
	//------------------------------------------------------
	
	bool Trigger_StairChaseHelper(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbFinalChaseInProgress == false) return true;
		
		////////////////////////////////
		// When player enters this area start a timer that gives them a little downward thrust every
		// second and then stops when they exit the area
		if (alState == 1)
		{
			Map_AddTimer("timer_stairchasehelper",1.0f,"TimerStairChaseHelper");
		}
		else
		{
			if (Map_TimerExists("timer_stairchasehelper"))
				Map_RemoveTimer("timer_stairchasehelper");
			
		}
		return true;
	}
	
	//------------------------------------------------------
	
	void TimerStairChaseHelper(const tString &in asTimer)
	{
		if (Entity_GetCollide("Player","AreaStairChaseHelper") == false) return;
		
		cLux_AddDebugMessage("Pushing player downward");
		Map_AddTimer("timer_stairchasehelper",1.0f,"TimerStairChaseHelper");
		
		// Add downward thrust to player
		Player_AddBodyForce(cVector3f_Down*10.0f,true);
	}
	
	//------------------------------------------------------
	
	///////////////////////////////////////////////////////
	// SCENE 3 EVENT C Enter lifeboat and escape
	///////////////////////////////////////////////////////
	
	//------------------------------------------------------
	
	tString msWaterDrainBranch = "3C_WaterDrained";
	bool mbDoorClosed = true;
	int mlDoorPoundRepeats = 0;
	
	//------------------------------------------------------
	
	bool CollideAreaEscapeInPod(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		SealPodDoors();
		StopEscapeAlarms_Small(3.5f);
		StopEscapeMusic(3.5f);
		
		if (cLux_GetExplorationModeActive())
		{
			Map_AddTimer("StopFinalChaseDelayTimer", 1.f, "StopFinalChase");
		}
		else
		{
			StopFinalChase("");
		}		
		
		Map_AddTimer("EscapeMusicStop", 3.5f, "EscapeMusicStopTimer");
		Player_FadeRollTo(0.0f,15.0f,3.0f);
		
		if (mbCathPluggedIn)
		{
			Map_AddTimer("timer_escapeentry",1.0f,"TimerEscapeOnPodEntry");
		}
		
		Map_AddTimer("timer_sequenceBangPod",1.9f,"SequenceMonsterBangingPod");
		
		return false;
	}
	
	// S26AO: keep the authored/saved timer name and forward to its existing handler.
	void EscapeMusicStopTimer(const tString &in asTimer)
	{
		EscapeMusicStop(asTimer);
	}

	void EscapeMusicStop(const tString &in asTimer)
	{
		StopEscapeMusic(2.0f, true);
	}
	
	//------------------------------------------------------
	
	void DoorPoundParticles()
	{
		for (uint i=1; i<12; ++i)		
		{
			ParticleSystem_CreateAtEntity("poddoordust_"+i,"dust_puff", "AreaPodDoorDust_"+i,true);
		}
	}
	
	//------------------------------------------------------
	
	cSequenceStatesData mSequenceMonsterBangingPod;
	void SequenceMonsterBangingPod(const tString &in asTimer)
	{
		Sequence_Begin("SequenceMonsterBangingPod", mSequenceMonsterBangingPod);
		
		if (Sequence_DoStepAndWait(1.0f))
		{
			//Slight delay for door to close before slam
			PreloadDeload();
			Entity_SetActive("Trigger_PodMusicStop", false);
			Map_AddTimer("StopAmbientMusicQuickly", 1.0f, "AmbientMusicHandler");
		}
		else if (Sequence_DoStepAndWait(4.0f))
		{
			// Plays first pounding sweetener, then checks if cath is talking - if she is, doesn't play anymore as it steps on the dialogue
			Sound_CreateAtEntity("sfx_doorpound","02_02_ms_curie_inside/SFX/escape_pod/flesher_hitting_pod_door","AreaPodDoorPoundEffect");	
			
			Effect_Shake_Start(0.025f,1.0f,0.2f,0.2f);
			DoorPoundParticles();
		}
		else if (Sequence_DoStepAndWait(4.0f))
		{
			if(mbCathEscapeDialogueStart==false)
			{
				Sound_CreateAtEntity("sfx_doorpound2","02_02_ms_curie_inside/SFX/escape_pod/flesher_hitting_pod_door","AreaPodDoorPoundEffect");	
			
				Effect_Shake_Start(0.025f,1.0f,0.2f,0.2f);
				DoorPoundParticles();
			}
		}
		else if (Sequence_DoStepAndWait(4.0f))
		{
			if(mbCathEscapeDialogueStart==false)
			{
				Sound_CreateAtEntity("sfx_doorpound","02_02_ms_curie_inside/SFX/escape_pod/flesher_hitting_pod_door","AreaPodDoorPoundEffect");	
			
				Effect_Shake_Start(0.025f,1.0f,0.2f,0.2f);
				DoorPoundParticles();
			}
		}
		else if (Sequence_DoStepAndWait(4.0f))
		{
			if(mbCathEscapeDialogueStart==false)
			{
				Sound_CreateAtEntity("sfx_doorpound","02_02_ms_curie_inside/SFX/escape_pod/flesher_hitting_pod_door","AreaPodDoorPoundEffect");	
			
				Effect_Shake_Start(0.025f,1.0f,0.2f,0.2f);
				DoorPoundParticles();
			}
		}
		
		Sequence_End();
	}
	
	//------------------------------------------------------
	
	void PodEscape(const tString&in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		
		//////////////////////////////////////
		// Callback from dialogue after Catherine initiates escape sequence
		cLux_AddTodoMessage("SCRIPT: Pod Escape Sequence");
		msWaterDrainBranch = "3C_WaterDrained_Branch2";
		
	}
	
	//------------------------------------------------------
		
	void OpenEscapePodDoor()
	{
		Entity_SetActive("BlockBoxEscapePod",false);
		SwingDoor_PushOpen("Swingdoor_EscapePod",2.0f,4,0.1f);
		mbEscapePodSweetenerPlayed = false;
	}
	
	//------------------------------------------------------
	
	bool mbEscapePodSweetenerPlayed = false;
	void CloseEscapePodDoor()
	{
		bool bClosed = SwingDoor_GetClosed("Swingdoor_EscapePod");
		SwingDoor_PushOpen("Swingdoor_EscapePod",-2.0f,6,0.1f);
		Entity_SetActive("BlockBoxEscapePod",true);
		if(bClosed == false && mbEscapePodSweetenerPlayed == false)
		{
			//escape pod sweetener sound to tell the player they've successfully escaped
			Sound_CreateAtEntity("CloseEscapePod", "02_02_ms_curie_inside/SFX/escape_pod/escape_pod_door_close", "Swingdoor_EscapePod");
			mbEscapePodSweetenerPlayed = true;
		}
	}
	
	//------------------------------------------------------
		
	void SealPodDoors()
	{
		//////////////////////////////////////////////////////////
		// Close door and disable interaction when it is almost closed
		Entity_SetActive("BlockBoxEscapePod",true);
		CloseEscapePodDoor();
		Entity_SetInteractionDisabled("Swingdoor_EscapePod*",true);
		mbDoorClosed = true;
		Map_AddTimer("EscapePodAlarm", 1.0f, "EscapePodAlarm");
		Sound_FadeGlobalVolume(1.0f, 3.5f);
		
		/////////////////////////////////////////////
		// Disable the fleshers
		Entity_SetActive("Flesher*",false);
		Entity_SetActive("Agent*",false);
		Effect_VideoDistortion_FadeOut(-1,1.0);
		
		Music_Stop(2.0f,eMusicPrio_BigEvent);
	}
	
	void EscapePodAlarm (const tString &in asTimer)
	{
		Sound_CreateAtEntity("EscapePodAlarm", "02_02_ms_curie_inside/SFX/curie_tilt/alarm/escape_pod", "EscapePodAlarmSource");
		Map_AddTimer("EscapePodAlarm", 0.75f, "EscapePodAlarm");
	}
	
	//-------------------------------------------------------
	
	void TimerEscapeOnPodEntry(const tString &in asTimer)
	{
		//////////////////////////////////////////
		// Used when the player runs to the pod, after having already plugged Cath in
		//Dialog_StartConversation("Catherine", "PodDisplay_2", 0.5f);
		//Dialog_StartConversation()
		mbCathEscapeDialogueStart=true;
		Dialog_Begin("Catherine");
				Dialog_AddBranchAndSubject("3C_LifeboatEscape","","OnCathDrainWater");
		Dialog_End();
		
		Map_AddTimer("timer_seq_drainwater",3.0f,"SequenceDrainWater");
	}
	
	//------------------------------------------------------
	
	void OnCathDrainWater(const tString&in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		
		//////////////////////////////////////
		// Callback from dialogue after Catherine starts to drain water
		cLux_AddTodoMessage("SCRIPT: Cath drains water - play the sequence!");
		
	}
	
	//------------------------------------------------------
	
	void CollideLiquidEscapePod(int alState)
	{
		if(alState == -1)
		{
			Map_SetEnvironmentParticlesActive(false);
			Map_SetUnderwater(false,true);
			PreloadFadeGlobal();
		}
		
		if(alState == 1)
		{
			Map_SetEnvironmentParticlesActive(true);
			Map_SetUnderwater(true,true);
		}
	}

	//------------------------------------------------------
	
	cSequenceStatesData mSequenceDrainWater;
		
	void SequenceDrainWater(const tString &in asTimer)
	{
		Sequence_Begin("SequenceDrainWater", mSequenceDrainWater);
	
		if (Sequence_DoStepAndWait(3.25f))
		{
			mbEscapePodScreensActive = true;
			Sound_CreateAtEntity("Pump_Idle_Loop_Underwater", "Entities_OceanBottom/airlock/uw/pump/idle_loop", "PumpsSource", 1.0f, false, 1.0f);
			Sound_CreateAtEntity("EscapePodDrainSweet", "02_02_ms_curie_inside/SFX/escape_pod/drain_sweetener", "Player", 1.0f, false, 1.0f);
			mfEscapePodGaugeMaxValue = 1.0f;
			
			Entity_SetActive("LiquidArea_EscapePod_1",true);
			LiquidArea_SetEffectOnExit("LiquidArea_EscapePod_1", true);
		}
		else if (Sequence_DoStepAndWait(5.0f))
		{
			AirlockEffectsFlushWater();
			
			
			LiquidArea_MoveLinearTo("LiquidArea_EscapePod_1","AreaWaterDrainTarget",0.1, 1, 0.5, false);
		}
		else if (Sequence_DoStepAndWait(3.0))
		{
			Entity_SetActive("AMB_Pre_EscapePodUW", false);
			Entity_SetActive("AMB_Post_Global", false);
			Entity_SetActive("AMB_Pre_EscapePodAir", true);
			Sound_Stop("EscapePodDrainSweet", 1.0f);
		}
		else if (Sequence_DoStepAndWait(4.0f))
		{
			StartPodEscape();
			
			////////////////////////////////////////
			// Play dialog for escape
			Voice_Play(msWaterDrainBranch,-1,"",0);
		}
		else if (Sequence_DoStepAndWait(0))
		{
			Effect_VideoDistortion_SetSoundEffectsDisabled(false);
			Player_SetFootstepSoundsDisabled(false);
			
			//////////////////////
			//Intro from 2.3
			SetupSceneEscapePod();
			Map_AddTimer("SequenceIntro", 1, "SequenceIntro");
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------

	/////////////////////////////////////////
	// ==============
	// SCENE 1 *INSIDE ESCAPE POD; CRASH*
	// ==============
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	int mlEscapePodMoveShakeID;
	bool mbPlayerStoodUp = true; //SET TO TRUE AS CURRENTLY CAN*T SIT in 2.2
	bool mb23Terminals = false;
	
	//-------------------------------------------------------
	
	void SetupSceneEscapePod()
	{
	//	CameraAnimation_Begin("EscapePodRideAnim", "", true);
		
	//	Map_SetUnderwater(false);
	//	Map_SetEnvironmentParticlesActive(false);
	//	cLux_GetCurrentMap().GetWorld().SetDirectionalLightActive(false);
		
		mb23Terminals = true;
		
		Entity_SetVarBool("PodDisplay_1", "Error", false);
		Entity_SetVarBool("PodDisplay_2", "Error", false);
		
		Sound_CreateAtEntity("EscapePodEngine", "02_03_delta/SFX/transport/transport_moving", "PodSoundSource", 0, true);
		
		Voice_SetSource("Catherine", "cath_terminal_escapepod_3", 2, 20, true, 20);
	}
	
    //-------------------------------------------------------
	
	bool StandUpSound(const tString &in asEntity, int alDirection)
	{
		if (asEntity == "EscapePodRideAnim_1" && alDirection == 1)
		{
			cLux_AddDebugMessage("Stand Up Animation Sound Start");
			Sound_CreateAtEntity("StandUpAnimation", "02_03_delta/SFX/pod_crash/simon_stand_in_pod", "Player", 0.0f, false, 1.0f);
			return true;
		}
		
		else if (asEntity == "EscapePodRideAnim_1" && alDirection == -1)
		{
			cLux_AddDebugMessage("Stand Up Animation Sound Stop");
			Sound_Stop("StandUpAnimation", 0.5f);
			return true;
		}
		return true;
	}

    //-------------------------------------------------------
	
	bool AnimationStandingRide(const tString &in asEntity, int alDirection)
	{
		mbPlayerStoodUp = true;
		return true;
	}
	
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 1 Event A *Level starts. Catherine explains mission*
    /////////////////////////////////////////

	//-------------------------------------------------------
	
	cSequenceStatesData mIntroSequence;
		
	void SequenceIntro(const tString &in asTimer)
	{
		Sequence_Begin("SequenceIntro", mIntroSequence);
			
		if (Sequence_DoStepAndWait(11.0))
		{		
			Map_RemoveTimer("EscapePodAlarm");
			
			mlEscapePodMoveShakeID = Effect_Shake_Start(0.0015, -1, 0, 0, cVector3f_One, 20);
			
			Lamp_SetupFlicker("EscapePodLamp_3", 0.05, 1.0, 0.025, 0.15);
			Lamp_SetFlickerActive("EscapePodLamp_3", true);
			
			
			LastOnSoma_SetText("02_02_ms_curie_inside_2");
		}
		else if (Sequence_DoStepAndWait(0.3))
		{
			Sound_PlayGui("02_03_delta/SFX/transport/transport_bump", 1.0f, eSoundEntryType_GuiWorld);
		}
		else if (Sequence_DoStepAndWait(0.6))
		{
			Effect_Shake_Start(0.005f, 0.2, 0.1, 0.1);
		}
		else if (Sequence_DoStepAndWait(1.5))
		{
			Effect_Shake_Start(0.015f, 1.0, 0.25f, 1.0f);
		}
		else if (Sequence_DoStepAndWait(3))
		{
			Dialog_Begin();
				Dialog_AddBranch("1_Intro");
					Dialog_AddSubject("1_Intro", "SubjectEscapePodDialog");
			Dialog_End();
		}
		Sequence_End();
	}
 
	//-------------------------------------------------------
	
	void SubjectEscapePodDialog(const tString &in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		
		SequenceCurieBoomAndCrash("");
	}
	
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 1 Event C *Boom is heard; Pod has major failure & crash (dialog)*
    /////////////////////////////////////////

	//-------------------------------------------------------
	
	int mlCrashRumbleId = 0;
	
	cSequenceStatesData mCurieBoomAndCrashSequence;
	void SequenceCurieBoomAndCrash(const tString &in asTimer)
	{
		Sequence_Begin("SequenceCurieBoomAndCrash", mCurieBoomAndCrashSequence);
			
		if (Sequence_DoStepAndWait(2))
		{
			Sound_Fade("EscapePodEngine", 0.45f, 0.5f);
			Sound_CreateAtEntity("CrashSequence", "02_03_delta/SFX/pod_crash/crash_sequence", "Player", 0, false);
		}
		else if (Sequence_DoStepAndWait(4.75))
		{
			Sound_Fade("EscapePodEngine", 0.75f, 3.0f);
			Voice_Play("1_AfterExplosion");
		}
		else if (Sequence_DoStepAndWait(1.1))
		{
			CameraAnimationNode_SetInteractiveMovement("EscapePodRideAnim_*", false);
			Sound_FadeGlobalVolume(0.0f, 1.0f, eSoundEntryType_WorldAll);
		}
		else if (Sequence_DoStepAndWait(1.5))
		{
			
			Effect_Shake_Start(0.03, 1, 0.1, 2);
			if (mbPlayerStoodUp)
			{
				CameraAnimation_Begin("ShockwaveStandAnim", "", false);
			}
			else
			{
				CameraAnimation_End();
				CameraAnimation_Begin("CrashSittingAnim", "", false);
			}
			
			Voice_Stop("1_AfterExplosion");
			Lamp_SetupFlicker("EscapePodLamp_*", 0.1, 0.3, 0.05, 0.3);
			Lamp_SetFlickerActive("EscapePodLamp_*", true);
			Prop_SetStaticPhysics("FireExtinguisher", false);
			Entity_AddImpulse("FireExtinguisher", cVector3f(0.5, 1, 1.2), true, true);
			Map_AddTimer("FireExtinguisherMovementTimer", cMath_RandRectf(0.1, 0.3), "TimerFireExtinguisherMovement");
			
			Effect_Rumble_Start(3.5, 2.5, 0.1, 0.7);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			mlCrashRumbleId = Effect_Rumble_Start(0.55, 999.0f, 0.1, 1);
			Entity_SetVarBool("PodDisplay_2", "Error", true);
			
			///////////////////////////////////
			///Stop Engine Sound
			Sound_Stop("EscapePodEngine", 0.0f);
			
			Effect_Shake_FadeOut(mlEscapePodMoveShakeID, 7);
			mlEscapePodMoveShakeID = Effect_Shake_Start(0.03, -1, 7, 0, cVector3f_One, 40);
			
			
			Voice_Play("1_AfterBeingHit", -1, "SubjectPodCrashDialog", 1);
		}
		else if (Sequence_DoStepAndPause(0))
		{
			Lamp_SetLit("EscapePodLED_10", false, false);
			Lamp_SetFlickerActive("EscapePodLED_3", true);
			Lamp_SetupFlicker("EscapePodLamp_*", 0.05, 1, 0.025, 0.15);
			Entity_SetVarBool("PodDisplay_1", "Error", true);
			
		}
		else if (Sequence_DoStepAndWait(0.0))
		{
			Terminal_SetGuiActive("PodDisplay_2", false);
			Terminal_SetGuiActive("PodDisplay_1", false);
			Effect_Shake_Start(0.03, 1, 0.1, 2);
			CameraAnimationNode_SetAutoMove("CrashSittingAnim_4", 1.f);
			CameraAnimationNode_SetInteractiveMovement("ShockwaveStandAnim_*", false);
			Map_RemoveTimer("FireExtinguisherMovementTimer");
			
			Voice_Stop("1_AfterExplosion");
			
			Entity_SetActive("AMB_StaticTransporter", false);
			Effect_Fade_Out(0.0);
			
			Music_StopAll(6);
			Sound_FadeGlobalVolume(0, 6);
		}
		else if (Sequence_DoStepAndWait(8))
		{
			Effect_Rumble_Stop(mlCrashRumbleId);
			Effect_Fade_Out(0.2);
			
			Effect_Shake_FadeOut(mlEscapePodMoveShakeID, 0);
			CameraAnimation_End();
		}
		else if (Sequence_DoStepAndWait(0))
		{
			PreloadChangeOfMap();
		}
		Sequence_End();
	}

