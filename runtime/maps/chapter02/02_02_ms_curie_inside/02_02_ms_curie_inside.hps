	//-----------------------------------------------------------------------------
	
	tString msCaptainsLogMessage = "";
	float mfCaptainsLogTimer = 0;
	int mlCaptainsLogChar = 0;
	int mlCaptainsLogMaxChar = 0;
	int mlCaptainsLogPage = 1;
	int mlCaptainsLogMaxPages = 3;
	float mfCaptainsLogAlpha = 0.0f;
	bool mbLogTransition = false;
	
	void OnGuiCaptainsLog(const tString&in asEntityName, float afTimeStep)
	{
		//////////////////////////////////
		// Pulse recording message
		/*mfCaptainsLogTimer += afTimeStep;
		if (fAlpha < 0)
			fAlpha *= -1;*/
		
		
		mfCaptainsLogAlpha = cMath_InterpolateLinear(mfCaptainsLogAlpha,1.0f,afTimeStep*2.0f);
		
		
		
		//////////////////////////////
		// Window data
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		window.mColorBase = gStationGuiColor_Normal;
		
		////////////////////////////
		// Text
		cImGuiTextFrameData textData = ImGui_GetDefaultTextFrame();
		textData.mbUseBackgroundGfx = false;
		textData.mFont.mvSize = cVector2f(16);
		textData.mFontAlign = eFontAlign_Left;
		textData.mFont.mColor.a = mfCaptainsLogAlpha;
		
		/////////////////////////////////
		// Button
		cImGuiButtonData button = StationGui_CreateDefaultButtonData();
		
		/////////////////////////////////
		// Backdrop
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		bool bDoPrev = mlCaptainsLogPage > 1 ? true : false;
		bool bDoNext = mlCaptainsLogPage < mlCaptainsLogMaxPages ? true : false;
		
		if (mbLogTransition)
		{
			mfCaptainsLogTimer += afTimeStep;
			mfCaptainsLogAlpha = 0;
			if (mfCaptainsLogTimer > 0.1f)
			{
				mbLogTransition = false;
			}
		}
		
		ImGui_DoWindowStart("", window, ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.9)));
		
			ImGui_SetTransCategory("");
			ImGui_DoLabel("["+mlCaptainsLogPage + "/" + ""+mlCaptainsLogMaxPages+"]",ImGui_NrmPosGroup(cVector3f(0.46, 0.4, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			//ImGui_DoTextFrameExt(, ImGui_NrmSizeGroup(cVector2f(0.8, 0.1)), 5, 0, textData, ));
			
			ImGui_SetTransCategory("02_02_ms_curie_inside");
			ImGui_DoTextFrameExt("CaptainsLog"+mlCaptainsLogPage, ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textData, ImGui_NrmPosGroup(cVector3f(0, -0.3, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
								 
			
			ImGui_SetTransCategory("");
			if (bDoPrev)
			{
				
				if (ImGui_DoButtonExt("ButtonPrev","<<",button, ImGui_NrmPosGroup(cVector3f(0.2, 0.8, 1)), ImGui_NrmSizeGroup(cVector2f(0.2, 0.15))))
				{
					mlCaptainsLogPage--;
					mbLogTransition = true;
					mfCaptainsLogTimer = 0;
					Sound_PlayGui("Entities_Station/tech/terminal_beeps/terminal_forward",1.0);
				}
			}
			
			if (bDoNext)
			{
				if (ImGui_DoButtonExt("ButtonNext",">>",button, ImGui_NrmPosGroup(cVector3f(0.6, 0.8, 1)), ImGui_NrmSizeGroup(cVector2f(0.2, 0.15))))
				{
					mlCaptainsLogPage++;
					mbLogTransition = true;
					mfCaptainsLogTimer = 0;
					Sound_PlayGui("Entities_Station/tech/terminal_beeps/terminal_forward",1.0);
				}
			}
			
			
		ImGui_DoWindowEnd();
	}
	
	//-----------------------------------------------------------------------------
	
	////////////////////////////
	// Screen Room (Screens showing creepy images)
	///////////////////////////
	
	//-----------------------------------------------------------------------------
	
	void terminal_screenroom_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		int lImageNumber = ImGui_GetStateInt("ImageNumber",-1);
		float fTimer = ImGui_GetStateFloat("ImageTimer",0.0f);
		
		fTimer += afTimeStep;
		
		////////////////////////////
		// Display Static
		if (lImageNumber == -1)
		{
			TerminalStatic();
			if (fTimer > 4.0f)
			{
				fTimer = 0.0f;
				lImageNumber = cMath_RandRectl(1,4);
			}
		}
		
		//////////////////////////
		// Display image (selected at random between static);
		else
		{
			ImGui_SetTransCategory("");
			
			ImGui_DoLabel("TODO:",cVector3f(100.0f,100.0f,100.0f),cVector2f_MinusOne,5.0f);
			ImGui_DoLabel("CREEPY IMAGE #"+lImageNumber,cVector3f(100.0f,200.0f,100.0f),cVector2f_MinusOne,5.0f);
			if (fTimer > 5.0f)
			{
				fTimer = 0.0f;
				lImageNumber = -1;
			}
		}
		
		ImGui_SetStateFloat("ImageTimer",fTimer);
		ImGui_SetStateInt("ImageNumber",lImageNumber);
	}
	
