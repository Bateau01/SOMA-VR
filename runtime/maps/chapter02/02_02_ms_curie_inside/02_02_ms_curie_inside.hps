		Preload();
		
		return false;
	}
	
	//------------------------------------------------------
	
	void CylinderWauCable_Sticky_Detach(const tString &in asStickyArea, const tString &in asBodyName)
	{
		
		//cLux_AddDebugMessage("STICK AREA : " +asStickyArea);
		//cLux_AddDebugMessage("BODY NAME : " +asBodyName);
		
		Entity_SetActive(asStickyArea, false);
		
		////////////////////////////////////////////////
		// Which tentacle is being detached? Specify terminal
		int lTerminalNumber = -1;
		
		if (asStickyArea == "CylinderWauCable_1_Sticky")
		{
			lTerminalNumber = 1;
			mbReactor1Destroyed = true;
		}
		//if (asStickyArea == "CylinderWauCable_2_Sticky")lTerminalNumber = 2;
		if (asStickyArea == "CylinderWauCable_3_Sticky")
		{
			lTerminalNumber = 3;
			mbReactor3Destroyed = true;
		}
		if (asStickyArea == "CylinderWauCable_4_Sticky")
		{
			lTerminalNumber = 4;
			mbReactor4Destroyed = true;
		}
		//if (asStickyArea == "CylinderWauCable_5_Sticky") lTerminalNumber = 5;
		if (asStickyArea == "CylinderWauCable_6_Sticky")
		{
			lTerminalNumber = 6;
			mbReactor6Destroyed = true;
		}
		

		///////////////////////////////////////////////
		// Spray structure gel
		cLux_AddTodoMessage("TODO: DETACH EFFECTS FOR " + lTerminalNumber);
		Map_AddTimer("EffectAreaSquirt_"+lTerminalNumber,0.1f,"TimerGeneratorOil");
        Map_AddTimer("EffectAreaSquirt_"+lTerminalNumber, 0.05f, "TimerGeneratorOilSound");
		
		ParticleSystem_CreateAtEntity("ps_oil_splash_"+lTerminalNumber,"02_02_reactor_leaking.ps","EffectAreaSquirt_"+lTerminalNumber,true);
		ParticleSystem_CreateAtEntity("ps_glass_break"+lTerminalNumber,"02_02_reactor_break.ps","EffectAreaSquirt_"+lTerminalNumber,true);
		

		// Sound at spark area
		Sound_CreateAtEntity("Unplug_"+lTerminalNumber, "02_02_ms_curie_inside/SFX/wau_boiler/unplug", "EffectAreaSquirt_"+lTerminalNumber);
		Sound_Stop("wau_boiler_"+lTerminalNumber, 0.25f);
		
		Map_AddTimer("EffectAreaSparks_A_"+lTerminalNumber,cMath_RandRectf(1.0f,2.0f),"TimerGeneratorSparks");
		Map_AddTimer("EffectAreaSparks_B_"+lTerminalNumber,cMath_RandRectf(2.0f,3.0f),"TimerGeneratorSparks");
		Map_AddTimer("EffectAreaSparks_C_"+lTerminalNumber,cMath_RandRectf(2.5f,3.5f),"TimerGeneratorSparks");
		
		////////////////////////////////////////////////
		// Change the engine coil lamp from blue to red
		Entity_FadeEffectBaseColor("electrical_coil_"+lTerminalNumber,cColor_Red,1.0f);
		Light_FadeTo("reactorlight_"+lTerminalNumber,cColor_Red,2.5f,1.0f);
		
		///////////////////////////////////////////////
		// Break glass
		Map_AddTimer("electrical_coil_glass_"+lTerminalNumber,0.1f,"TimerChangeReactorColor");

		ParticleSystem_CreateAtEntity("ps_glass_break_big"+lTerminalNumber,"02_02_reactor_break_glass.ps","EffectAreaSquirt_"+lTerminalNumber,true);
		
		EnergySource_SetEnergy("ControlBoardTentacle_Flower_"+lTerminalNumber,0.0f);
		
		//////////////////////////////////////////////
		// A bit of a hack to make sure we don't re-enter past this point when we auto-destroy the remaining reactor
		if (mbWAURemoved)
		{
			Entity_SetActive("CylinderWauCable_*",false);
			return;
		}
	
		///////////////////////////////////////////////
		// Increment # of tentacles detached, trigger puzzle solved when all three are detached
		++mlTentaclesDetached;
		if (mlTentaclesDetached >= 3)
		{
			OnElectricsPuzzleSolved(lTerminalNumber);
			
			ParticleSystem_CreateAtEntity("ps_ripple_splash_"+lTerminalNumber,"02_02_reactor_break_ripple.ps","EffectAreaSquirt_"+lTerminalNumber,true);
			Effect_Rumble_Start(3.5f,1.5f,0.1f,0.7f);
		}
		
		///////////////////////////////////////////////
		// Shake Effects
		if (mlTentaclesDetached == 1)
		{
			Sound_CreateAtEntity("ReactorDestabilise1", "02_02_ms_curie_inside/SFX/wau_boiler/reactor_explosions/reactor_destabilise_01", "Player");
			Sound_FadeGlobalVolume(0.25f, 0.25f, eSoundEntryType_WorldClean);
			Map_AddTimer("ReturnVolumeDestab", 3.5f, "ReturnVolumeDestab");
			Effect_Shake_Start(0.025f,1.0f,1.0f,1.0f);
			Effect_Rumble_Start(0.9f,2.25f, 0, 1);
		}
		else if (mlTentaclesDetached == 2)
		{
			Sound_CreateAtEntity("ReactorDestabilise2", "02_02_ms_curie_inside/SFX/wau_boiler/reactor_explosions/reactor_destabilise_02", "Player");
			Sound_FadeGlobalVolume(0.25f, 0.25f, eSoundEntryType_WorldClean);
			Map_AddTimer("ReturnVolumeDestab", 3.5f, "ReturnVolumeDestab");
			Effect_Shake_Start(0.025f,1.0f,1.0f,1.0f);
			Effect_Rumble_Start(0.9f,2.25f, 0, 1);
			//Map_AddTimer("timer_delaytilt",1.5f,"TimerDelayTilt");
			
		}
		
		
		
		
		////////////////////////////////////////////////
		// Delay on effects
		Map_AddTimer("timer_detachWau_"+mlTentaclesDetached,cMath_RandRectf(1.0f,2.0f),"TimerDetachWau");
	}
	
	void ReturnVolumeDestab(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 4.0f, eSoundEntryType_WorldClean);
	}
	
