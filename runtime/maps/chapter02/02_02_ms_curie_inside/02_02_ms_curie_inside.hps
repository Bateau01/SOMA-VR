	// LOOPING VOICE (BRIDGE - SECOND FLOOR)
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	
	void TimerLoopingVoiceBridge(const tString &in asTimer)
	{
		///////////////////////////////////
		// If player is in the area, play voice and add a long timer
		if (Entity_GetCollide("Player","AreaBridgeDeck"))
		{
			if (mbFinalChaseInProgress) return;
			
			cLux_AddDebugMessage("Play message");
			Voice_Play("CaptainDialog_1");
			Map_AddTimer("timer_loopingvoicebridgerepeat",20.0f,"TimerLoopingVoiceBridge");
		}
		
		else
		{
			Map_AddTimer("timer_loopingvoicebridgerepeat",25.0f,"TimerLoopingVoiceBridge");
		}
	}
	
