	//-------------------------------------------------------
	
	///////////////////////////////////////////
	// FLESHER CHASE
	///////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbFinalChaseStarted = false;
	
	int mlExplorationMode_FinalChaseFlesherRespawnPosIndex = 1;
	
	//-------------------------------------------------------
	
	void SetupFinalChase()
	{
		/////////////////////////////////////////
		// Activate the flesher but leave senses turned off for now
		Entity_SetActive("agent_flesher_finalchase",true);
		Agent_SetSensesActive("agent_flesher_finalchase",false);
		
		if (cLux_GetExplorationModeActive())
		{
			//////////////////////////////////
			// Set up first teleport back pos
			Entity_SetVarInt("agent_flesher_finalchase", "FinalChaseFlesherTeleportBackAreaIndex", mlExplorationMode_FinalChaseFlesherRespawnPosIndex);
		}
		
		
		// This guy is fatal
		Flesher_SetAttackDamageAmount("agent_flesher_finalchase",1.0f);
		
		Effect_VideoDistortion_SetSoundEffectsDisabled(true);
		Player_SetFootstepSoundsDisabled(true);
		
		OpenChaseDoors();
	}
	
	//-------------------------------------------------------
	
	void OpenChaseDoors()
	{
		/////////////////////////////
		// Help the players flow by forcing these doors to be open
		SwingDoor_SetOpenAmount("swingdoor_gate_electrical_1",1.0f);
		
		
		PhysicsSlideDoor_AutoMoveToState("CargoBayDoor",1);
		PhysicsSlideDoor_AutoMoveToState("shipwreck_slidedoor_medium_1",1);
		PhysicsSlideDoor_AutoMoveToState("shipwreck_slidedoor_medium_4",1);
		SlideDoor_SetOpenAmount("Floor3Door_Middle",1.0f,true);
		PhysicsSlideDoor_AutoMoveToState("Floor2Door",1);
		
		/////////////////////////////
		// Make sure player can't run down the ladder again!
		Entity_SetActive("LadderPathHatch_Locked",true);
		Entity_SetActive("LadderPathHatch_Open",false);
	}
	
	//-------------------------------------------------------
	
	void BeginFinalChase()
	{
		if (mbFinalChaseStarted) return;
		mbFinalChaseStarted = true;
		
		StartEscapeMusic();
		
		/////////////////////////////
		// Kick off the chase
		Flesher_SetHuntOnlyAttackWhenLooking("agent_flesher_finalchase", true);
		Agent_SetSensesActive("agent_flesher_finalchase",true);
		Map_AddTimer("timer_finalchase",0.5f,"TimerFinalChase");
		
		//////////////////////////////
		// Make Flesher scream
		cLux_AddTodoMessage("SOUND: Player MUST hear the flesher screech here to alert the player that danger is near");
		Sound_CreateAtEntity("sfx_scream_finalchase","NPC_Creatures/Vocalisations/InWorld/Flesher/ladder_scream","agent_flesher_finalchase",0.0f, false, 1.0f);
	}
	
	//-------------------------------------------------------
	
	void TimerFinalChase(const tString &in asTimer)
	{
		Agent_RevealPlayerPosition("agent_flesher_finalchase");
		Flesher_HuntPlayer("agent_flesher_finalchase");
		Map_AddTimer("timer_finalchase",0.5f,"TimerFinalChase");
	}
	
	//-------------------------------------------------------
	
	void StopFinalChase(const tString &in asTimer)
	{
		Map_RemoveTimer("timer_finalchase");
		Entity_SetActive("agent_flesher_finalchase",false);
	}
	
	//-------------------------------------------------------
	
	void FinalChaseFlesher_AfterDamage(const tString&in asEntityName)
	{
		if (cLux_GetExplorationModeActive() == false) return;
		
		////////////////////////////////////////////////////////////////
		// Give player some time to wake up before chase begins again
		Map_RemoveTimer("timer_finalchase");
		Flesher_ForceIdleState("agent_flesher_finalchase");
		Map_AddTimer("ResumeChaseTimer", 4.f, "TimerFinalChase");	
		
		Agent_TeleportFeetToEntity("agent_flesher_finalchase", "FinalChaseFlesherRespawnPos_" + mlExplorationMode_FinalChaseFlesherRespawnPosIndex);	
		cLux_AddDebugMessage("MOVING CHASE FLESHER TO: " + mlExplorationMode_FinalChaseFlesherRespawnPosIndex);
	}
	
	//-------------------------------------------------------
	
	bool CollideFinalChaseFlesherRespawn(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (cLux_GetExplorationModeActive() == false) return false;
		if (alState == -1 || mbFinalChaseInProgress == false) return true;
		
		mlExplorationMode_FinalChaseFlesherRespawnPosIndex = cString_GetNumericSuffixInt(asChild);
		if (mlExplorationMode_FinalChaseFlesherRespawnPosIndex > 1)
		{
			mlExplorationMode_FinalChaseFlesherRespawnPosIndex--;
		}
		Entity_SetVarInt("agent_flesher_finalchase", "FinalChaseFlesherTeleportBackAreaIndex", mlExplorationMode_FinalChaseFlesherRespawnPosIndex);
		cLux_AddDebugMessage("FLESHER SPAWN AREA INDEX: " + mlExplorationMode_FinalChaseFlesherRespawnPosIndex);
		
		return true;
	}

