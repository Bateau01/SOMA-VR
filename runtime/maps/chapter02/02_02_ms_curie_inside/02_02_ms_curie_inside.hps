	///////////////////////////////////////////
	// SCENE 2 - Event A - Plug Catherine in to Lifeboat
	///////////////////////////////////////////
	
	//------------------------------------------------------
	
	
	
	//------------------------------------------------------
	
	bool cath_box_tool_CanBeUsed(const tString &in asTool, const tString &in asEntity)
	{
		if (asEntity == "Area_PlaceCatherine_Pod") return true;
		return false;
	}
	
	//-------------------------------------------------------

	tString msPlacedCathboxEntity = "";
	bool cath_box_tool_OnUse(const tString &in asTool, const tString &in asEntity)
	{
		cLux_AddTodoMessage("SCRIPT: Activate Catherine!");
		
		////////////////////////////////////////
		// Disable triggers
		Entity_SetActive("Area_PlaceCatherine_*",false);
		
		/////////////////////////////////////////
		// Insert Catherine
		CathTool_Insert("cath_box_tool","cath_terminal_escapepod_3");
		
		////////////////////////////////////////
		// Start dialogue
		Dialog_StopAll();
		
		//////////////////////////////////
		// Activate the escape pod screens
		mbCathPluggedIn = true;
		
		//////////////////////////////////
		// Start dialog with Catherine based on situation
		Voice_StopAll();
		Map_AddTimer("timer_cathconversation",0.5f,"TimerStartCathConversation");
		
		CloseEscapePodDoor();
		
		cLux_AddTodoMessage("SCRIPT/ART: Match interior of escape pod to that of 2.3 including lamps");
		Lamp_SetLit("EscapePodLamp_*",true,true);
		
		return true;
	}
	
	//------------------------------------------------------
	bool mbCathEscapeDialogueStart = false;
	void TimerStartCathConversation(const tString &in asTimer)
	{
		if (mbWAURemoved)
		{
			cLux_AddDebugMessage("Catherine plugged in AFTER player messes with power");
			
			//////////////////////////////
			// Play this dialogue if electrics room already done
			mbCathEscapeDialogueStart = true;
			//Dialog_StartConversation("Catherine", "PodDisplay_2", 0.5f);
			Dialog_Begin("Catherine");
					Dialog_AddBranchAndSubject("3C_LifeBoatEscape_Branch2","","PodEscape");
			Dialog_End();
			
			Map_AddTimer("timer_seq_drainwater",5.0f,"SequenceDrainWater");
			
			Entity_SetActive("Agent_*",false);
			
			SealPodDoors();
		}
		else
		{
			cLux_AddDebugMessage("Catherine plugged in BEFORE player messes with power");
		
			//////////////////////////////
			// Play this dialogue if player plugs in Catherine before electrics room puzzle
			Dialog_StartConversation("Catherine", "PodDisplay_2", 0.5f);
			Dialog_Begin("Catherine");
					Dialog_AddBranchAndSubject("2A_PlugInCatherine","","OnCathIntroOver");
			Dialog_End();
			
			
		}
	}
	
	//------------------------------------------------------
	
	void OnCathIntroOver(const tString&in asSubject, bool abStartOfSubject)
	{
		//////////////////////////////////////
		// Callback from dialogue after plugging in Catherine
		cLux_AddTodoMessage("SCRIPT: Cath intro over");
		Entity_SetActive("AreaActivatePodReturn_*",true);
		
		/////////////////////////////////////
		// Enable hints if electrics room not yet complete
		if (mbWAURemoved == false)
		{
			CathTool_SetHintsEnabled("cath_box_tool",true);
			CathTool_SetHintsCallback("cath_box_tool","OnCathHints");
			Entity_SetActive("BlockBoxEscapePod",false);
		}
		
		////////////////////////////////////
		// Set checkpoint here if player still has to do the electrics event
		if (mbWAURemoved == false && abStartOfSubject == false)
		{
			cLux_AddDebugMessage("Checkpoint Added");
			CheckPoint_Setup("CathConversationCheckpoint");
		}
	}
	
	//------------------------------------------------------
	
	///////////////////////////////////////////
	// SCENE 2 - Event B - Return to Lifeboat
	///////////////////////////////////////////
	
	//------------------------------------------------------
	
	int mlReturnToPodConversation = 1;
	bool mbReturnedToPodFromPowerRoom = false;
	bool mbPlayerKilledMessageAllowed = true;
	bool mbCathShouldCommentOnPlayerDeath = false;
	
	//------------------------------------------------------
	
	tString OnCathHints(const tString& in asEntityName) 
	{
		//////////////////////////////////
		// If player has found power room, give hints to wreck it
		if (mbFoundPowerRoom)
		{
			return "HintEscapePod_WreckPowerRoom";
		}
		
		//////////////////////////////////
		// Otherwise hint to go find it
		return "HintEscapePod_LookForPowerRoom";
	}
	
	//------------------------------------------------------
	
	bool CollideAreaActivatePodReturn(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		if (mbLifeboatAvailable) return false;
		
		cLux_AddDebugMessage("Return to pod area active");
		
		//////////////////////////////////
		// Activate the area to return to the escape pod when the player passes through these zones
		Entity_SetActive("AreaReturnToPod*",true);
		Entity_SetActive("AreaActivatePodReturn_*",false);
		
		return true;
	}
	
	//------------------------------------------------------
		
	bool CollideAreaReturnToPod(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		if (mbLifeboatAvailable) return true;
		
		cLux_AddDebugMessage("Returning to lifeboat..");
		
		////////////////////////////////////////
		// Swap areas so the player cannot just run in and out of the door and trigger
		// dialogue.
		Entity_SetActive("AreaReturnToPod",false);
		Entity_SetActive("AreaActivatePodReturn_*",true);
		
		////////////////////////////////////
		// If player returns after being killed by a flesher and final chase is not active
		if (mbCathShouldCommentOnPlayerDeath && mbPlayerKilledMessageAllowed && mbCathPluggedIn)
		{
			Voice_Play("2C_EnterLifeboatAfterDeath");
			mbPlayerKilledMessageAllowed = false;
			return true;
		}
		
		
		////////////////////////////////////
		// If player returns after finding the power room and hasn't yet destroyed it, play this once
		if (mbFoundPowerRoom && !mbReturnedToPodFromPowerRoom && !mbWAURemoved && mbCathPluggedIn)
		{
			Voice_StopAll();
			Voice_Play("2B_ReturnToLifeboat_PRoom");
			mbReturnedToPodFromPowerRoom = true;
			return true;
		}
		
		////////////////////////////////////
		// Do not play if three conversations have been had
		if (mlReturnToPodConversation > 3) return true;
		
		cLux_AddDebugMessage("Triggering conversation");
		
		if (mbCathPluggedIn)
		{
			Voice_StopAll();
			Voice_Play("2B_ReturnToLifeboat_"+mlReturnToPodConversation);
			mlReturnToPodConversation++;
		}
		
		return true;
	}

	//------------------------------------------------------
	
	///////////////////////////////////////////
	// SCENE 2 - Event C - Flesher Climbs up
	///////////////////////////////////////////
	
	//------------------------------------------------------
	
	bool mbFlesherInPodWarningGiven = false;

	//------------------------------------------------------
	
	bool CollideFlesherEntersPod(const tString &in asParent, const tString &in asChild, int alState)
	{
		/////////////////////////////////////////////////////////
		// Player needs to be inside the pod for this to happen and the warning must not have been played
		if (Entity_GetCollide("Player","PodArea") == false) return true;
		if (mbFlesherInPodWarningGiven) return false;
			
		//////////////////////////////////////////
		// It is possible that this flesher gets inside the escape pod while Simon is in there
		cLux_AddTodoMessage("SCRIPT/DIALOG: Look out Simon!");
		Voice_Play("2C_FlesherEntersLifeboat");
		
		mbFlesherInPodWarningGiven = true;
		
		return false;
	}
	
	//------------------------------------------------------
	
	bool CollideFlesherPodWarning(const tString &in asParent, const tString &in asChild, int alState)
	{
		/////////////////////////////////////////////////
		// Flesher must be inside pod and the warning must not have been played
		if (Entity_GetCollide("Agent_Flesher_Ladder","PodArea") == false) return true;
		if (mbFlesherInPodWarningGiven) return false;
		
		/////////////////////////////////////////////////
		// If the flesher is already inside the pod when Simon enters we also play a warning
		Voice_Play("2C_FlesherEntersLifeboat");
		
		mbFlesherInPodWarningGiven = true;
		return false;
	}
	
