			cLux_AddDebugMessage("Respawn point set to : " + msRespawnPoint);
		}
		
		return true;
	}

	//------------------------------------------------------
	
	void OnElectricsPuzzleSolved(int alTentaclePulled)
	{
		if (mbWAURemoved) return;
		mbWAURemoved = true;
		
		/////////////////////////////////////////////////////
		// When we solve the puzzle we also want to destroy the last remaining reactors
		if (mbReactor1Destroyed == false) CylinderWauCable_Sticky_Detach("CylinderWauCable_1_Sticky", "CylinderWauCable_1_Body_11");
		if (mbReactor3Destroyed == false) CylinderWauCable_Sticky_Detach("CylinderWauCable_3_Sticky", "CylinderWauCable_3_Body_11");
		if (mbReactor4Destroyed == false) CylinderWauCable_Sticky_Detach("CylinderWauCable_4_Sticky", "CylinderWauCable_4_Body_11");
		if (mbReactor6Destroyed == false) CylinderWauCable_Sticky_Detach("CylinderWauCable_6_Sticky", "CylinderWauCable_6_Body_11");
		
		///////////////////////////////////////////////////
		// Engine room goes in to total red alert - all lamps change to red
		Entity_FadeEffectBaseColor("Engine_*",cColor_Red,1.0f);
		Light_FadeTo("Engine_pointlight_*",cColor_Red,2.0f,1.0f);
		Light_FadeTo("Engine_spotlight_*",cColor_Red,7.0f,1.0f);
		
		Entity_FadeEffectBaseColor("EscapeLamp_*",cColor_Red,1.0f);
		
		
		Map_AddTimer("ReactorWarningVoice", 7.0f, "ReactorWarningVoice");
		cLux_AddTodoMessage("SCRIPT: Creepier lighting!");
		mbLifeboatAvailable = true;
		
		mbPlayerKilledMessageAllowed = false;
		
		CathTool_SetHintsEnabled("cath_box_tool",false);
		
		//////////////////////////////////////
		// Disable return to pod areas
		Entity_SetActive("AreaReturnToPod*",false);
		Entity_SetActive("AreaActivatePodReturn_*",false);
		
		// Enable chasing flesher
		SetupFinalChase();
		
		//////////////////////////////////////
		// Activate area to trigger escape
		// (Note that player will have to plug Catherine in to start the escape if they havent already)
		
		Entity_SetActive("AreaEscapeInPod",true);
	
		
		/* We want to progress in to Scene 3 Event B now - some sequences to add tension there */
		SetupEscapeSequence();
		
		mbFinalChaseInProgress = true;
		
		/////////////////////////////////////////
		// Determine Correct Animation
		tString sAnimation = "EngineBlowbackAnimA";
		
		bool bDelayFlesher = false;
		
		switch (alTentaclePulled)
		{
			case 1: sAnimation = "EngineBlowbackAnimD"; break;
			case 2: sAnimation = "EngineBlowbackAnimF"; bDelayFlesher = true; break;
			case 3: sAnimation = "EngineBlowbackAnimB"; break;
			case 4: sAnimation = "EngineBlowbackAnimA"; break;
			case 5: sAnimation = "EngineBlowbackAnimC"; bDelayFlesher = true; break;
			case 6: sAnimation = "EngineBlowbackAnimE"; break;
		}
		
		/////////////////////////////////////////
		// Shockwave from reactor
		MakeSmokeParticles();
		Player_GiveDamage(0.05f,0.3f,eDamageType_Steam,"Player");
		Effect_ImageTrail_Start(0.5f,0.1f,2.0f,0.2f);
		CameraAnimation_Begin(sAnimation,"",true);
		
		//////////////////////////////////////
		// Force fixed health and disable wau flowers
		Player_SetHealth(0.8f);
		EnergySource_SetEnergy("*",0.0f);
		
		//////////////////////////////////////
		// Sound for getting hit
		Map_RemoveTimer("ReturnVolumeDestab");
		Sound_FadeGlobalVolume(0.15f, 0.15f, eSoundEntryType_WorldClean);
		Sound_CreateAtEntity("ReactorDestabHit", "02_02_ms_curie_inside/SFX/wau_boiler/reactor_explosions/reactor_destabilise_hit", "Player");
		
		//////////////////////////////////////
		// Set emergency states and enable falling objects
		SetEmergencyLampsActive(true);			
		SlideDoor_SetClosed("CargoBayDoor",false,true);
		SlideDoor_SetClosed("StorageRoomDoor",false,true);
		SlideDoor_SetClosed("StorageRoomDoor_1",true,true);
		Entity_SetActive("falling_crate_cable_*",false);
		
		////////////////////////////////////////
		// Start a timer to reset camera lean from the ship tilting slightly, or things will 'pop' at the end of a camera animation
		Map_AddTimer("timer_resetcurietilt",2.25f,"TimerResetCurieTilt");
		
		/////////////////////////////////////////
		// Flesher starts walking (possibly delayed if too close)
		float fFlesherTimer = bDelayFlesher ? 7.5f : 5.0f;
		if (mlFinalSequenceDeaths > 1) fFlesherTimer += 2.45f;
		
		Map_AddTimer("timer_flesherapproach",fFlesherTimer,"TimerFlesherApproach");
	}
		
