	//////////////////////////////////////////
	// FLESHER MOVES TOWARDS THE LADDER AREA WHEN SIMON IS NEAR THE LADDER
	//{///////////////////////////////////////
	
	//-------------------------------------------------------
	//-------------------------------------------------------
	
	bool CollideAreaMoveFlesherToLadder(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == -1 || cLux_GetExplorationModeActive()) return true;
		
		Pathfinder_Track_Stop("agent_flesher_floor1");
		Pathfinder_Track_Clear("agent_flesher_floor1");
		
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_145", 3.0f, 5.0f);
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_4", 3.0f, 5.0f);
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_429", 3.0f, 5.0f);
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_129", 3.0f, 5.0f); //Goes far off
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_128", 3.0f, 5.0f);
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_137", 3.0f, 5.0f);
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_124", 3.0f, 5.0f); //Goes far off
			
		Pathfinder_Track_Start("agent_flesher_floor1",true,0.5f,"");
		
		return false;
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaDisableLadderFlesher(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == -1) return true;
		
		Agent_SetAutoDisableWhenOutOfSightActive("agent_flesher_floor1",true,6.0f);
		
		return false;
	}
	
