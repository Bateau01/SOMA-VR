	//-------------------------------------------------------
 
    /////////////////////////////////////////
    // ==============
    // PRELOAD
    // ==============
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	bool PreloadDisabled(bool abCheckIfPreloading = true)
	{
		if(cLux_ScriptDebugOn())
		{
			cLux_AddDebugMessage("PRELOAD DISABLED!"); 
			
			return true;
		}

		if(abCheckIfPreloading == true && Map_IsPreloading() == false)
			return true;
			
		return false;
	}
	
	//-------------------------------------------------------
	
	void Preload()
	{
		if(PreloadDisabled(false)) return;


		Map_Preload("02_03_delta.hpm");
	}
	
	//-------------------------------------------------------
	
	void PreloadDeload()
	{
		if(PreloadDisabled()) return;
		cLux_AddDebugMessage("DELOADING");
		
		Map_Deload("transfer2223");
		//Map_SetPreloadPriority(eWorldStreamPriority_High);
	}
	
	//-------------------------------------------------------
	
	void PreloadFadeGlobal()
	{
		Map_AddTimer("FadeGlobal", 0, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	
	void PreloadChangeOfMap()
	{
		if(PreloadDisabled()) 
		{
			PreloadManualChangeMap();
			return;
		}
		
		Map_AddTimer("ChangeMap", 0, "PreloadTimer");
		Map_AddTimer("ChangeMapNotReady", 3, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	
	//bool mbGlobalCopyCompleted = false;
	void PreloadTimer(const tString &in asTimer)
	{
		////////////////////////////
		//Preload - Change map globals when possible.
		if(asTimer == "FadeGlobal")
		{
			//if(mbGlobalCopyCompleted)
			{
				Map_Preset_Fade("2.2Preset", 0.1); 
				return;
			}
			
			//mbGlobalCopyCompleted = Map_CopyGlobalSettings(Map_GetPreloadMap(), 0.1);
			
		//	Map_AddTimer("FadeGlobal", 0.2, "PreloadTimer");
		}

		////////////////////////////
		//Preload - Change map when possible
		if(asTimer == "ChangeMap")
		{
			if(Map_IsPreloadCompleted())
			{
				Description_SetForceFading(true);
				
				Entity_SetActive("cath_box_tool", false);
				Entity_SetActive("PodDisplay_*", false);
				Entity_SetActive("BlockBoxEscapePod", false);
				
				Lamp_SetLit("EscapePodLamp_*", false, false);
				
				Map_ChangeMap("02_03_delta.hpm", "crashed_shuttle", "", "");
			}
			else
			{
				Map_AddTimer("ChangeMap", 0.6f, "PreloadTimer");
			}	
		}
		
		if(asTimer == "ChangeMapNotReady")
		{
			Description_Add("02_05_theta_inside", "ScanRoom_Legacy_Loading", 10, false);
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
		}
	}
	
	//-------------------------------------------------------
	
	void PreloadManualChangeMap()
	{
		Map_ChangeMap("02_03_delta.hpm", "crashed_shuttle", "", "");
	}
	
	//-----------------------------------------------------------------------------

	/////////////////////////////////////////
	// TERMINALS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------------
	
	//-----------------------------------------------------------------------------
	
	void OnGuiCreepyImages(const tString&in asEntityName, float afTimeStep)
	{
		float fStaticTime = ImGui_GetStateFloat("CreepyStaticMax",0.0f);
		float fTimer = ImGui_GetStateFloat("CreepyStaticTimer", 0.0f);
		fTimer += afTimeStep;
		
		//bigscreen_L
		//desaster01
		
		//bigscreen_R
		//desaster02
		
		
		int lCreepyImageLoop = ImGui_GetStateInt("CreepyImageLoop",0);
		bool bCycleCreepyImage = false;
		tString sImageName = Entity_GetVarString(asEntityName,"");
		
		cVector2f vDimensions = cVector2f(-1,-1);
		
		/////////////////////////////////
		// After wau flowers are drained, screens should be forced to display static for a while
		if (mbWauFlowerStatic)
		{
			fTimer = fStaticTime + 0.01f;
		}
		
		//////////////////////////////////////////
		// Occasional bursts of static
		bool bStaticBurst = false;
		if (fTimer > fStaticTime)
		{
			bStaticBurst = true;
			TerminalStatic();
			
			if (ImGui_GetStateBool("StaticSoundPlayed",false) == false)
			{
				ImGui_SetStateBool("StaticSoundPlayed",true);
				
				//cLux_AddTodoMessage("SOUND: STATIC BURST HERE");
				/* Sam - speak to Steve about this, there are several screens close together, so may wanna handle this differently? */
				//Sound_CreateAtEntity("sfx_staticburst","03_01_omicron_outside/Gameplay/wau_glitch/wau_glitch_burst","asEntityName",0.0f,false,1.0f);
			}
		}
		
		/////////////////////////////////////////
		// Communal Room first floor
		else if (sImageName == "CommunalRoom")
		{
			vDimensions = cVector2f(1.35,1);
			sImageName = "desaster00";
		}		
		
		else if (sImageName == "bigscreen_L")
		{
			sImageName = "desaster01";
			vDimensions = cVector2f(1.35,1);
			bCycleCreepyImage = true;
		}
		
		else if (sImageName == "bigscreen_R")
		{
			sImageName = "desaster02";
			vDimensions = cVector2f(1.35,1);
			bCycleCreepyImage = true;
		}
		
		////////////////////////////////////
		// Kitchen
		else if (sImageName == "kitchen_1")
		{
			sImageName = "desaster03";
			vDimensions = cVector2f(1.35,1);
			bCycleCreepyImage = true;
		}
		else if (sImageName == "kitchen_2")
		{
			sImageName = "desaster04";
			vDimensions = cVector2f(1.35,1);
			bCycleCreepyImage = true;
		}
		
		////////////////////////////////////
		// Bridge Deck
		else if (sImageName == "bridgedeck_1")
		{
			sImageName = "desaster05";
			vDimensions = cVector2f(1.35,1);
			bCycleCreepyImage = true;
		}
		else if (sImageName == "bridgedeck_2")
		{
			sImageName = "desaster06";
			vDimensions = cVector2f(1.35,1);
			bCycleCreepyImage = true;
		}
		
		
				
		//////////////////////////////////////////
		// Comm Room Screens
		else if (sImageName == "commroom_big_L1")
		{
			sImageName = "desaster07";
			vDimensions = cVector2f(1.35,1);
		}
		else if (sImageName == "commroom_big_L2")
		{
			sImageName = "desaster08";
			vDimensions = cVector2f(1.35,1);
		}
		else if (sImageName == "commroom_big_R1")
		{
			sImageName = "desaster09";
			vDimensions = cVector2f(1.35,1);
		}
		else if (sImageName == "commroom_big_R2")
		{
			sImageName = "desaster10";
			vDimensions = cVector2f(1.35,1);
		}
		
		
		//////////////////////////////////////////
		// Power Room Screens
		else if (sImageName == "powerroom_big_L")
		{
			sImageName = "desaster11";
			vDimensions = cVector2f(1.35,1);
		}
		else if (sImageName == "powerroom_big_M")
		{
			TerminalStatic();
		}
		else if (sImageName == "powerroom_big_R")
		{
			sImageName = "desaster12";
			vDimensions = cVector2f(1.35,1);
		}
		
		///////////////////////////////////////////
		// Show image when the static is not visible
		if (bStaticBurst == false)
		{
			ImGui_SetStateBool("StaticSoundPlayed",false);
			ImGui_DoImage(cImGuiGfx(sImageName, eImGuiGfx_Texture), cVector3f(0,0,0), ImGui_NrmSize(vDimensions));
			StationGuiBG_Scanlines();
			TerminalStatic(0.1f);
		}
		
		//////////////////////////////////////
		// Reset static so we can see the image
		if (fTimer > (fStaticTime+0.5f))
		{
			fTimer = 0.0f;
			fStaticTime = cMath_RandRectf(1.25f,3.25f);
			ImGui_SetStateFloat("CreepyStaticMax",fStaticTime);
		}
		

		float fImageCycle = ImGui_GetStateFloat("CreepyImageTimer",0.0f);
		fImageCycle += afTimeStep;
		if (fImageCycle > 3.0f)
		{
			lCreepyImageLoop++;
			if (lCreepyImageLoop >= 3)
			{
				lCreepyImageLoop = 0;
				//cLux_AddDebugMessage("Reset!");
			}
				
			fImageCycle = 0;
		}
		ImGui_SetStateInt("CreepyImageLoop",lCreepyImageLoop);
		ImGui_SetStateFloat("CreepyImageTimer",fImageCycle);
		
			
		ImGui_SetStateFloat("CreepyStaticTimer",fTimer);
		
	}
	
	//-----------------------------------------------------------------------------
	
	void TerminalStatic(float afAlpha=1.0f, tString asEntity="")
	{
		tString sTag = "";
		
		if (asEntity != "")
		{
			sTag = Entity_GetVarString(asEntity,"");
		}
		
		cVector2f vSize;
		cVector3f vPos=ImGui_NrmPosGroup(cVector3f(0.0f, 0.0f, 2.0f));
				
		cImGuiGfx imageGfx;
		if (ImGui_RepeatTimer("StaticIndex", 0.1))
		{
			ImGui_SetStateInt("StaticImageIndex", cMath_RandRectl(0, 1));
			ImGui_SetStateInt("AnimationRotation", cMath_RandRectl(0, 1));
		}
		imageGfx.SetFile("static_"+ImGui_GetStateInt("StaticImageIndex", 0));
		imageGfx.mColor = cColor(0.5f, 0.5f, 0.5f, afAlpha);
		vSize = ImGui_NrmSizeGroup(cVector2f(1.0, 1.0f));
					
		ImGui_SetModRotateAngle(ImGui_GetStateInt("AnimationRotation", 0)*180);
		
		ImGui_GroupBegin(vPos, vSize);
			ImGui_DoImage(imageGfx, 0, ImGui_NrmSizeGroup(1));
		ImGui_GroupEnd();
		ImGui_SetModRotateAngle(0);
		
	}
	
	void TerminalCabin_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		TerminalStatic();
	}
	
	//-----------------------------------------------------------------------------
	
