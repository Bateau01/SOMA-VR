	//------------------------------------------------------
	
	//////////////////////////////////////////////////
	// Breaking glass sequence
	//////////////////////////////////////////////////
	
	//------------------------------------------------------
	
	tString msGlassToBreak;
	cSequenceStatesData mBreakGlassSequence;
	bool mbGlassBrokenFlesherSoundTriggered = false;
		
	void SequenceBreakGlass(const tString &in asTimer)
	{
		Sequence_Begin("SequenceBreakGlass", mBreakGlassSequence);
		if (Sequence_DoStepAndWait(0.2))
		{
			Player_UnequipTool();
			Entity_SetInteractionDisabled("BreakableGlass_*", true);
		}
		else if (Sequence_DoStepAndWait(0.1f))
		{
			tString sNextBrokenStep = Entity_GetVarString(msGlassToBreak, "NextBrokenStep");
			Entity_SetActive(msGlassToBreak, false);
			Entity_SetActive(sNextBrokenStep, true);
			
			// Window broken
			if (cString_GetFirstStringPos(sNextBrokenStep, "_Broken") >= 0)
			{
				Sound_CreateAtEntity("HammerGlassBroken", "level_02_02/events/cabin_window/hit_hammer_break", sNextBrokenStep, 0, false);
				
				/////////////////////////////////////////////////////////////////////////
				// Enable player to climb through window and make moaning voices clearer
				if (sNextBrokenStep == "BreakableGlass_1_Broken")
				{
					Entity_SetActive("CargoRoomClimb_1_*", true);
					mbVoicesClearer = true;
				}
				if (sNextBrokenStep == "BreakableGlass_2_Broken")
				{
					Entity_SetActive("CargoRoomClimb_2_*", true);
					mbVoicesClearer = true;
				}
				
				cVector3f vImpulse;
				for (int i = 1; i <= 7; i++)
				{
					vImpulse = cVector3f(cMath_RandRectf(-0.5f, 0.5f), cMath_RandRectf(-0.5f, 0.5f), -1);
					vImpulse.Normalize();
					Body_AddImpulse(sNextBrokenStep + "_shard_body_" + i, vImpulse*0.3, true);
					
				}
				
				//Activate and push extra shards
				Entity_SetActive(sNextBrokenStep + "_Extra", true);
				Map_AddTimer(sNextBrokenStep + "_Extra", 3.f, "TimerInactivateEntity");
				for (int i = 1; i <= 23; i++)
				{
					vImpulse = cVector3f(cMath_RandRectf(-0.5f, 0.5f), cMath_RandRectf(-0.5f, 0.5f), -1);
					vImpulse.Normalize();
					Body_AddImpulse(sNextBrokenStep + "_Extra_Body_" + i, vImpulse*0.3, true);
					
				}
			}
			else
			{
				Sound_CreateAtEntity("HammerGlassCrack", "level_02_02/events/cabin_window/hit_hammer", sNextBrokenStep, 0, false);
			}
									
		}
		else if (Sequence_DoStepAndWait(0.3f))
		{
			Player_ReEquipTool(0.3f);
		}
		else if (Sequence_DoStepAndWait(0))
		{
			Entity_SetInteractionDisabled("BreakableGlass_*", false);
		}
		Sequence_End();
	}

	//------------------------------------------------------
	
	////////////////////////////////////////////////////
	// 3G BABBLING CORPSES
	////////////////////////////////////////////////////
	
	//------------------------------------------------------
	
	bool mbEnteredCargoBay = false;
	bool mbVoicesClearer = false;
	int mlWindowClicks = 0;
	
	//------------------------------------------------------
	
	///////////////////////////////////////////////////
	// 3H. ENTER CARGO BAY                           //
	///////////////////////////////////////////////////
	
	//-----------------------------------------------------------------
	
	bool CollisionEnteredCargoBay(const tString &in asParent, const tString &in asChild, int alState)
	{
		cLux_AddDebugMessage("Entered Cargo Bay");
		
		///////////////////////////////
		// Player enters the cargo bay
		mbEnteredCargoBay = true;
				
		///////////////////////////////
		// Fleshers pull box with body up to the hatch
		SequencePullCrate("");
		
		///////////////////////////////////////////////
		//Sound for crate yank up
		Sound_CreateAtEntity("CoffinPull", "02_02_ms_curie_inside/SFX/coffin_pulley/coffin_pulley", "Sound_CoffinSoundArea", 0.0, false, 1.0f);
		
		return false;
	}
	
	//-----------------------------------------------------------------
	
	int mlCratePulls = 0;
	cSequenceStatesData mSequencePullCrate;
		
	void SequencePullCrate(const tString &in asTimer)
	{
		Sequence_Begin("SequencePullCrate", mSequencePullCrate);
			
		///////////////////////////////////////////////
		// Fleshers yank the crate up in a few pulls
		if (Sequence_DoStepWaitAndRepeat(4,3.0))
		{
			mlCratePulls++;
			Prop_MoveLinearTo("BodyCrate","Area_CrateTarget_"+mlCratePulls,1.0,2.0,1.0,false);
		}

		Sequence_End();
	}
	
	//-----------------------------------------------------------------
	
	bool TriggerArea_CrateHatch(const tString &in asParent, const tString &in asChild, int alState)
	{
		///////////////////////////////////////////////
		// Close hatch door when box is pulled through
		if (alState == 1)
		{
			SlideDoor_SetClosed("CargoBayCeilingDoor",true,false);
			return false;
		}
		return true;
	}
	
	//-----------------------------------------------------------------
	
	////////////////////////////////////////
	// CATHERINE COMMUNICATION SEQUENCE   //
	////////////////////////////////////////
	
	//-----------------------------------------------------------------
	
	cSequenceStatesData mCatherineElectricsTalk;
	void SequenceCatherineElectricsTalk(const tString &in asTimer)
	{
		Sequence_Begin("SequenceCatherineElectricsTalk", mCatherineElectricsTalk);
	
		if (Sequence_DoStepAndWait(0.75f))
		{
			//Player_SetMoveSpeedMul(0);
			Sound_CreateAtEntity("RadioStart", "level_amb_shared_machines/signals/burst", "CathContactSpeaker_Lamp_Electrics", 0, false);
			Sound_CreateAtEntity("RadioCrackle", "level_amb_shared_machines/signals/crackling", "CathContactSpeaker_Lamp_Electrics", 0.75, true);
			
			Lamp_SetLit("CathContactSpeaker_Lamp_Electrics", true, true);
		}
		else if (Sequence_DoStepAndWait(1.5f))
		{
			Voice_SetSource("Catherine", "CathContactSpeaker_Lamp_Electrics", 3, 10, true, 10);
			
			Voice_Play("19_EnterElectricsA",-1,"SubjectEnterElectricsOver");
			
			Lamp_SetFlickerActive("CathContactSpeaker_Lamp_Electrics", true);
		}
		else if (Sequence_DoStepAndWait(3.0f))
		{
			cLux_AddTodoMessage("Violent roar from flesher!\n");
			
			Sound_CreateAtEntity("FlesherHowl", "02_04_theta_outside/spot/mind_coral/distant_call", "FlesheTransmissions_4");
		
		}
		else if (Sequence_DoStepAndPause(0.5f))
		{
			Voice_Play("19_EnterElectricsB",-1,"SubjectCatherineElectricsOver");
		}
		else if (Sequence_DoStepAndWait(1.5))
		{
			Sound_Stop("RadioCrackle", 1.5f);		
			Lamp_SetLit("CathContactSpeaker_Lamp_Electrics", false, true);
			
			///////////////////////////
			// Explosion particles
			cLux_AddTodoMessage("Sound: Radio panel shorts out");
			Sound_CreateAtEntity("RadioShortcircuit","shipwreck/doors/cabin_door_panel/malfunction","CathContactSpeaker_Lamp_Electrics",0,false,1.0f);
			ParticleSystem_CreateAtEntity("elec_spark_huge_oneshot","elec_spark_huge_oneshot.ps","CathContactSpeaker_Lamp_Electrics",false);
		}
		else if (Sequence_DoStepAndWait(0.0))
		{
			//////////////////////////////
			// Simon curses
			Dialog_Begin();
				Dialog_AddBranch("19_EnterElectrics");
				Dialog_AddSubject("19_EnterElectricsC","");
			Dialog_End();
			
			/////////////////////////////
			// Remove blockbox on door
			Entity_SetActive("TransformerRoomBlocker",false);
		}
		
		Sequence_End();
	}	
	
	//-----------------------------------------------------------------
		
	///////////////////////////////////////////////////////
	// 3I PLAYER FINDS AND ENTER VENTILATION ENTRANCE
	///////////////////////////////////////////////////////
		
	//-----------------------------------------------------------------
	
	void OnChangeTransformerVent(const tString &in asEntity, int alState)
	{
		if (alState != 1) return;
		
		Player_ChangeStateToNormal();
		Player_SetLookSpeedMul(0);
		Player_FadeLookSpeedMulTo(1, 0.5);
		
		Entity_SetActive(asEntity, false);
		Entity_SetActive(asEntity + "_Grab", true);
		Entity_PlaceAtEntity(asEntity + "_Grab", asEntity);
		
		Entity_AddImpulse(asEntity + "_Grab", cVector3f_Forward*1.5, true, true);
		
		Map_RemoveTimer(asEntity);
		Sound_Stop("TransformerVentStress", 0.05f);
		cLux_AddTodoMessage("Sound: Vent torn open");
		Sound_CreateAtEntity("TransformerVentTornOpen", "level_01_02/tech/lever_metallic/start", asEntity + "_Grab", 0, false);
		
		Effect_Shake_Start(0.015, 0.3f, 0.0f, 0.1f);
	}
	
	//-------------------------------------------------------
	
	void InteractTransformerVent(const tString &in asEntity)
	{
		// Play sound
		cLux_AddTodoMessage("Sound: Hinges of panel under stress");
		Sound_CreateAtEntity("TransformerVentStress", "level_01_02/tech/lever_metallic/loop", asEntity, 0.5f, true);
		Map_AddTimer(asEntity, 0.25f, "TimerCheckTransformerVentInteraction");
	}
	
	//-------------------------------------------------------
	
	void TimerCheckTransformerVentInteraction(const tString &in asTimer)
	{
		// Player has stopped interacting
		if (!Entity_IsInteractedWith(asTimer))
		{
			Sound_Stop("TransformerVentStress", 0.05f);
			return;
		}
		
		// Check again in x secs
		Map_AddTimer(asTimer, 0.25f, "TimerCheckTransformerVentInteraction");
	}
		
	//------------------------------------------------------
	
	void InteractReactorVentGrate(const tString &in asEntity)
	{
		cLux_AddTodoMessage("Sound: Vent torn open");
		Sound_CreateAtEntity("TransformerVentTornOpen", "level_01_02/tech/lever_metallic/start", asEntity, 0, false);
		
		Prop_SetStaticPhysics(asEntity, false);
		Entity_AddImpulse(asEntity, cVector3f_Forward*1.5, true, true);
		Player_ChangeStateToNormal();
		
		Effect_Shake_Start(0.015, 0.3f, 0.0f, 0.1f);
	}
	
	
	
