	//-------------------------------------------------------
	
	void DrainAllWauFlowers()
	{
		EnergySource_SetEnergy("wau_flower*",0.0f);
		mbWauFlowerStatic = true;
		Map_AddTimer("timer_stopwaustatic",7.0f,"TimerStopWauStatic");
		Map_AddTimer("timer_wautilt",3.5f,"TimerWauflowerTilt");
		
	}
	
	void TimerWauflowerTilt(const tString &in asTimer)
	{
		//////////////////////////////
		// We actually want to roll the camera the OPPOSITE direction to the ship
		Sound_PlayGui("02_02_ms_curie_inside/SFX/curie_tilt/flower_tilt", 1.0f, eSoundEntryType_GuiWorld);
		Sound_FadeGlobalVolume(0.25f, 0.5f);
		Map_AddTimer("TiltMixerReturn", 4.5f, "TiltMixerReturnNoAlarm");
		Player_FadeRollTo(-8.5f,5.0f,5.0f);
		Effect_Shake_Start(0.025,2.0f,1.0f,1.0f);
		
		Map_AddTimer("timer_tiltreset",3.0f,"TimerWauFlowerTiltReset");
	}
	
	//----------------------------------------
	
	void TimerWauFlowerTiltReset(const tString &in asTimer)
	{
		Player_FadeRollTo(0.0f,0.75f,0.75f);
	}
	
	//----------------------------------------
	
	void TimerStopWauStatic(const tString &in asTimer)
	{
		mbWauFlowerStatic = false;
	}
	
	//------------------------------------------------------
	
	//////////////////////////////////////////
	// Ship Tilting
	//////////////////////////////////////////
	
	//-------------------------------------------------------
	
	void TimerTestTilt(const tString &in asTimer)
	{
		if (asTimer == "timer_tilt_1")
			TiltCurieLeft(true);
		if (asTimer == "timer_tilt_2")
			TiltCurieRight(true);
		if (asTimer == "timer_tilt_3")
			TiltCurieReset(true);
			
		Map_AddTimer("timer_tilt_"+cMath_RandRectl(1,3),5.0f,"TimerTestTilt");
	}
	
	void TiltCurieReset(bool abShake)
	{
		//////////////////////////////
		// We actually want to roll the camera the OPPOSITE direction to the ship
		Sound_PlayGui("02_02_ms_curie_inside/SFX/curie_tilt/tremor_tilt", 1.0f, eSoundEntryType_GuiWorld);
		Sound_FadeGlobalVolume(0.25f, 1.5f);
		Map_AddTimer("TiltMixerReturn", 2.5f, "TiltMixerReturn");
		StopEscapeAlarms(1.5f);
		StartAlarmSequence();
		Sound_Fade("BigAlarm", 0.25f, 0.5f);
		Music_FadeVolumeMul(0.55f, 1.5f);
		
		Player_FadeRollTo(0.0f,15.0f,7.0f);
		Effect_Shake_Start(0.1,2.0f,1.0f,1.0f);
	}
	
	void TiltCurieLeft(bool abShake)
	{
		//////////////////////////////
		// We actually want to roll the camera the OPPOSITE direction to the ship
		Sound_PlayGui("02_02_ms_curie_inside/SFX/curie_tilt/tremor_tilt", 1.0f, eSoundEntryType_GuiWorld);
		Sound_FadeGlobalVolume(0.25f, 0.5f);
		Map_AddTimer("TiltMixerReturn", 2.5f, "TiltMixerReturn");
		StopEscapeAlarms(1.5f);
		StartAlarmSequence();
		Sound_Fade("BigAlarm", 0.25f, 1.5f);
		Music_FadeVolumeMul(0.55f, 1.5f);
		
		Player_FadeRollTo(-15.0f,5.0f,5.0f);
		Effect_Shake_Start(0.025,2.0f,1.0f,1.0f);
	}
	
	void TiltCurieRight(bool abShake)
	{
		//////////////////////////////
		// We actually want to roll the camera the OPPOSITE direction to the ship
		Sound_PlayGui("02_02_ms_curie_inside/SFX/curie_tilt/tremor_tilt", 1.0f, eSoundEntryType_GuiWorld);
		Sound_FadeGlobalVolume(0.25f, 0.5f);
		Map_AddTimer("TiltMixerReturn", 2.5f, "TiltMixerReturn");
		StopEscapeAlarms(1.5f);
		StartAlarmSequence();
		Sound_Fade("BigAlarm", 0.25f, 1.5f);
		Music_FadeVolumeMul(0.55f, 1.5f);
		
		Player_FadeRollTo(15.0f,5.0f,5.0f);
		Effect_Shake_Start(0.025,2.0f,1.0f,1.0f);
	}
	
	void TiltMixerReturn (const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 6.5f);
		Sound_Fade("BigAlarm", 1.0f, 3.0f);
		Music_FadeVolumeMul(1.0f, 3.0f);
		StartEscapeAlarms(2.0f);
		Depth_Audio_Fear_HighIntensity(12.0f, 5.0f, 1, false, true);
	}
	
	void TiltMixerReturnNoAlarm (const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 6.5f);
		Sound_Fade("BigAlarm", 1.0f, 3.0f);
		Music_FadeVolumeMul(1.0f, 3.0f);
		Depth_Audio_Fear_HighIntensity(12.0f, 5.0f, 1, false, true);
	}
		
	//-----------------------------------------------------------------------------------------
	
	bool OnCollideCrateFall(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == -1) return true;
		
		cLux_AddDebugMessage("Child = " + asChild);
		
		//Prop_StopMovement(asChild);
		
		Prop_SetStaticPhysics(asChild,false);
		Entity_AddImpulse(asChild,cVector3f(5,0,0),false,true);
		
		return false;
	}
	
	//-----------------------------------------------------------------------------------------
	
	bool OnCollideAreaChaseHangingCrate(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		if (!mbFinalChaseInProgress) return true;
		
		////////////////////////////////////////
		// Hanging cargo box just falls straight down
		Entity_SetActive("block_box_cargocrate",false);
		Prop_SetStaticPhysics("CargoBox_1",false);
		Entity_SetInteractionDisabled("CargoBox_1",true);
		Entity_SetActive("falling_crate_cable_*",false);
		
		Entity_SetActive("AreaChaseHangingCrate_*",false);
		TiltCurieLeft(true);
		
		///////////////////////////
		// Begin the chase if not already active
		BeginFinalChase();
		
		
		//Map_AddTimer("timer_cratecables",0.75f,"TimerCrateCables");
		
		return false;
	}
	
	void TimerCrateCables(const tString &in asTimer)
	{
		Prop_SetStaticPhysics("falling_crate_cable_*",false);
	}
	
	//-----------------------------------------------------------------------------------------
	
	bool OnCollideAreaTiltCurie(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		if (!mbFinalChaseInProgress) return true;
		
		// Get uservar from area
		tString sDirection = Entity_GetVarString(asChild,"");
		
		////////////////////////////
		// Tilt left/right, with or without shake
		if (sDirection == "left")
		{
			TiltCurieLeft(true);
		}
		else if (sDirection == "right")
		{
			TiltCurieRight(true);
		}
		else if (sDirection == "leftnoshake")
		{
			TiltCurieRight(false);
		}
		else if (sDirection == "rightnoshake")
		{
			TiltCurieRight(false);
		}
		
		///////////////////////////
		// When in the bridge room (floor 1)
		else if (sDirection == "lockers")
		{
			TiltCurieRight(false);
			SwingDoor_PushOpen("locker_bridge_1",5.0f,4,0.1f);
			SwingDoor_PushOpen("locker_bridge_2",3.0f,4,0.1f);
			SwingDoor_PushOpen("locker_bridge_3",2.0f,4,0.1f);
		}
		
		///////////////////////////
		// Fall through to reset camera to middle
		else
		{
			TiltCurieReset(false);
		}
		
		return false;
	}
	
	//-------------------------------------------------------
	
	bool OnCollideAreaChaseSlidingCrates(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		if (!mbFinalChaseInProgress) return true;
		
		TiltCurieRight(true);
		Prop_MoveLinearTo("cargo_crate_19","cargo_crate_19_target",0.75f,0.75f,0.75f,false);
		return false;
	}
	
