	{
		if (alState == 1)
		{
			cLux_AddDebugMessage("Kicked off bridge looping voice");
			
			//////////////////////////////
			// Play looping static voice on first floor
			Map_AddTimer("timer_loopingbridgedeck",1.0f,"TimerLoopingVoiceBridge");
			return false;
		}
		return true;
	}
	
