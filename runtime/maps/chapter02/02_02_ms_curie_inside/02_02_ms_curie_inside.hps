	bool CamAnimHitHead(const tString &in asEntity, int alDirection)
	{
		if (alDirection == 1)
		{
			Effect_Shake_Start(0.2f,0.1f,0.0f,0.1f);
			Player_GiveDamage(0.05f,0.3f,eDamageType_Hit,"Player");
		}
		return true;
	}
	
	bool PassNode(const tString &in asEntity, int alDirection)
	{
		//cLux_AddDebugMessage(""+asEntity);
		return true;
	}
	//-------------------------------------------------------
	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed)
	{	
		if(abPressed==false) return;
	
		if(alAction == eAction_Test1)
		{
			Player_GiveDamage(0.05f,0.3f,eDamageType_Steam,"Player");
			Effect_ImageTrail_Start(0.5f,0.1f,2.0f,0.2f);
			CameraAnimation_Begin("EngineBlowbackAnimA","",true);
		}
		
		if(alAction == eAction_Test2)
		{
			Player_GiveDamage(0.05f,0.3f,eDamageType_Steam,"Player");
			Effect_ImageTrail_Start(0.5f,0.1f,2.0f,0.2f);
			CameraAnimation_Begin("EngineBlowbackAnimD","",true);
		}
		
		
		if(alAction == eAction_Test3)
		{
			//Seq_EndPreview("");
			
			mbWAURemoved = true;
			mbFinalChaseInProgress = true;
			Entity_SetActive("AreaEscapeInPod",true);
			
			//mbLifeboatAvailable = true;
			//Entity_SetActive("AreaEscapeInPod",true);
			//Map_AddTimer("timer_startcath",1.0f,"TimerStartCathConversation");
			//Map_AddTimer("timer_seq_drainwater",5.0f,"SequenceDrainWater");
		}
		
		
		
		if (alAction == eAction_Test4)
		{
			mbFinalChaseInProgress = true;
			//OnChangeLadderWheel("",1);
			//Entity_SetActive("BlockBoxEscapePod",false);
			//SwingDoor_PushOpen("Swingdoor_EscapePod",2.0f,4,0.1f);
			//SwingDoor_SetDisableAutoClose("Swingdoor_EscapePod*",false);
			//SwingDoor_SetClosed("Swingdoor_EscapePod*",false,true);
			//SwingDoor_SetOpenAmount("Swingdoor_EscapePod*",0.1f);
			
			
		}
		if (alAction == eAction_Test5)
		{
			//SwingDoor_PushOpen("Swingdoor_EscapePod",-2.0f,6,0.1f);
			//Entity_SetActive("BlockBoxEscapePod",true);
			//SwingDoor_SetClosed("Swingdoor_EscapePod*",true,true);
			//Entity_SetInteractionDisabled("Swingdoor_EscapePod*",true);
			
			cLuxPathfinder @pPathfinder = cast<cLuxPathfinder@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_Pathfinder, "agent_flesher_floor2"));
			pPathfinder.SetTrackPaused(true);
			pPathfinder.Stop();
	
		}
		if (alAction == eAction_Test6)
		{
			cLuxPathfinder @pPathfinder = cast<cLuxPathfinder@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_Pathfinder, "agent_flesher_floor2"));
			pPathfinder.SetTrackPaused(false);
			pPathfinder.MoveToNode("PathNodeArea_281",1,false);
			//Entity_SetInteractionDisabled("Swingdoor_EscapePod*",false);
			//Entity_AddImpulse("SwingDoor_EscapePod",cVector3f_Right*10000.0f,true,false);
			//Entity_AddForce("Swingdoor_EscapePod*",cVector3f_Up*50000.0f,true,true);
		}
		
		if (alAction == eAction_Test7)
		{
			Entity_SetActive("agent_flesher_floor2", true);
			Agent_SetSensesActive("agent_flesher_floor2",true);
		
			Pathfinder_Track_Clear("agent_flesher_floor2");
			
			Pathfinder_Track_Add("agent_flesher_floor2","PathNodeArea_409", 1.0f, 5.0f);
			Pathfinder_Track_Add("agent_flesher_floor2","PathNodeArea_411", 1.0f, 5.0f);
			Pathfinder_Track_Add("agent_flesher_floor2","PathNodeArea_207", 1.0f, 5.0f);
			Pathfinder_Track_Add("agent_flesher_floor2","PathNodeArea_432", 1.0f, 5.0f);
			Pathfinder_Track_Add("agent_flesher_floor2","PathNodeArea_425", 1.0f, 5.0f);
			Pathfinder_Track_Add("agent_flesher_floor2","PathNodeArea_408", 1.0f, 5.0f);
			Pathfinder_Track_Add("agent_flesher_floor2","PathNodeArea_281", 1.0f, 5.0f);
			
			Pathfinder_Track_Start("agent_flesher_floor2", true, 0.5f);
		}
		
		////////////////////////////
		//Allow leaving level.
		if (alAction == eAction_Test8)
		{
			OnElectricsPuzzleSolved(1);
			CollideAreaBeginPreload("", "", 1);
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
		}
	
		if (alAction == eAction_Test9)
		{
			//cLux_AddDebugMessage("****************************************************");
			//cLux_AddDebugMessage("****** SKIPPING DIALOGUE! USE THIS WISELY!!! *******");
			//cLux_AddDebugMessage("****************************************************");
			//Voice_SkipCurrentLine("CathMeeting");
			//cLux_AddDebugMessage("TEST!!");
			//PhysicsSlideDoor_AutoMoveToState("slidedoor_cabin_cut_fresh_1", 1);
			
			AttackMeter_AutoDamage(1, 0.1f,false);			
		}
	}
	
	void OnPlayerKilled(int alNumberOfRecentDeaths, const tString &in asSource)
	{
		//////////////////////////////////////////
		// Allow message from Catherine when returning to the pod
		mbPlayerWasKilled = true;
		
		cLux_AddDebugMessage("Killed by : " + asSource);
		
		if (mbPlayerKilledMessageAllowed)
		{
			Entity_SetActive("AreaActivatePodReturn_*",true);
			
			//////////////////////////////
			// This time if Cath is already plugged in she will comment on player death
			if (mbCathPluggedIn)
			{
				cLux_AddDebugMessage("Catherine will now comment on player death");
				mbCathShouldCommentOnPlayerDeath = true;
			}
			else
			{
				cLux_AddDebugMessage("Catherine will NOT comment on player death as she is not plugged in!");
			}
		}
	}
	
