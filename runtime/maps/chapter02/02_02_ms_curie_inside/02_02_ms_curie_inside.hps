	//{///////////////////////////////////////
	
	//-------------------------------------------------------
	bool mbWindowFlesherPatrolStarted = false;
	//-------------------------------------------------------
		
	bool WindowFlesherAppear(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
		{
			//////////////////////////////////
			// Flesher staring in through the window at the player
			Entity_SetActive("agent_flesher_floor1",true);
			Entity_SetActive("WindowFlesherLookAt",true);
					
			return false;
		}
		
		return true;
	}
	
	//-------------------------------------------------------

	void WindowFlesherLookAt_OnPlayerLookAt(const tString &in asEntity, int alState)
	{
		////////////////////////////////////////////
		// The first way the player is able to activate the flesher, looking at it and seeing it in the window
		if (alState == 1)
		{
			Map_AddTimer("timer_removewindowflesher",1.1f,"TimerBeginWindowFlesherPatrol");
		}
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaForceFlesherPatrol(const tString &in asParent, const tString &in asChild, int alState)
	{
		////////////////////////////////////////////
		// If the player goes too far up the corridor, we need to kick off the flesher event too
		if (alState == 1)
		{
			Map_AddTimer("timer_removewindowflesher",1.1f,"TimerBeginWindowFlesherPatrol");
			return false;
		}
		
		return true;
	}
	
	//-------------------------------------------------------
	
	void TimerBeginWindowFlesherPatrol(const tString &in asTimer)
	{
		if (mbWindowFlesherPatrolStarted) return;
		
		mbWindowFlesherPatrolStarted = true;
		
		////////////////////////////////////////////////
		// Make flesher walk by the window for build up when player leaves the area
		Pathfinder_Track_Clear("agent_flesher_floor1");
		
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_23");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_584");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_507");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_606");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_22");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_121");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_21");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_507");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_131");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_620");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_565");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_19");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_482");
			Pathfinder_Track_Add("agent_flesher_floor1", "PathNodeArea_290");
			
		
		Pathfinder_Track_Start("agent_flesher_floor1",true,0.5f,"");
		
		///////////////////////////////////////////
		// Delay the activation of senses
		Map_AddTimer("timer_fleshersenses",3.0f,"TimerActivateWindowFlesherSenses");
	}
	
	//-------------------------------------------------------
	
	void TimerActivateWindowFlesherSenses(const tString &in asTimer)
	{
		Agent_SetSensesActive("agent_flesher_floor1",true);
	}
	
