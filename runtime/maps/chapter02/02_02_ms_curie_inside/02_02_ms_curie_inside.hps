	void TimerFadeIn(const tString &in asTimer)
	{
		Effect_Fade_In(5.0);
		Sound_FadeGlobalVolume(1.0f, 5.0f, eSoundEntryType_WorldAll);
		Music_FadeVolumeMul(1.0f, 5.0f);
	}
	
