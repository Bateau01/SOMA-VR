		{
			msPortMapEntry = "PortmapBrest";
		}
		fLineY += 0.09;
		if (ImGui_DoButtonExt("ButtonMap4","PortmapButton4",button, ImGui_NrmPosGroup(cVector3f(fLineX, fLineY, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.08))))
		{
			msPortMapEntry = "PortmapCasablanca";
		}
		fLineY += 0.09;
		if (ImGui_DoButtonExt("ButtonMap5","PortmapButton5",button, ImGui_NrmPosGroup(cVector3f(fLineX, fLineY, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.08))))
		{
			msPortMapEntry = "PortmapDublin";
		}
		fLineY += 0.09;
		if (ImGui_DoButtonExt("ButtonMap6","PortmapButton6",button, ImGui_NrmPosGroup(cVector3f(fLineX, fLineY, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.08))))
		{
			msPortMapEntry = "PortmapPlymouth";
		}
		fLineY += 0.09;
		if (ImGui_DoButtonExt("ButtonMap7","PortmapButton7",button, ImGui_NrmPosGroup(cVector3f(fLineX, fLineY, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.08))))
		{
			msPortMapEntry = "PortmapRabat";
		}
		fLineY += 0.09;
		if (ImGui_DoButtonExt("ButtonMap8","PortmapButton8",button, ImGui_NrmPosGroup(cVector3f(fLineX, fLineY, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.08))))
		{
			msPortMapEntry = "PortmapTangier";
		}
		fLineY += 0.09;
		if (ImGui_DoButtonExt("ButtonMap9","PortmapButton9",button, ImGui_NrmPosGroup(cVector3f(fLineX, fLineY, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.08))))
		{
			msPortMapEntry = "PortmapPathos";
		}
		
		ImGui_DoWindowStart("", StationGui_CreateDefaultWindowData(), ImGui_NrmPosGroup(cVector3f(0.475, 0.6, 5)), ImGui_NrmSizeGroup(cVector2f(0.5, 0.275)));
			ImGui_DoTextFrameExt(msPortMapEntry, ImGui_NrmSizeGroup(cVector2f(0.05, 0.05)), 5, 0, textData, 
								 ImGui_NrmPosGroup(cVector3f(0, 0, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
		ImGui_DoWindowEnd();
	}
	
	//-----------------------------------------------------------------------------
	
	////////////////////////////
	// Escape Pod Terminals
	///////////////////////////
	
	//-----------------------------------------------------------------------------
	
	bool mbEscapePodScreensActive = false;
	bool mbEscapePodInitializing = true;
	float mfEscapePodGaugeValue = 0.0f;
	float mfEscapePodGaugeMaxValue = 0.0f;
	
	//-----------------------------------------------------------------------------
	
	void DoDialogWindowStart(const tString&in asCaption, const tString&in asText, const cVector2f &in avNrmSize = cVector2f(0.6, 0.2), float afZ=1.5f)
	{
		//////////////////////////////////
		// Setup widget data
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		cImGuiTextFrameData textData;
		textData.mbUseBackgroundGfx = false;
		textData.mFont.mvSize = cVector2f(24, 24);
		textData.mFontAlign = eFontAlign_Center;
		textData.mColorText = cColor(0.8, 1);
		
		///////////////////////////////////////
		// Show message 
		ImGui_DoWindowStart(asCaption, window, ImGui_NrmPosGroup(cVector3f((1.f-avNrmSize.x)*0.5, (1.f-avNrmSize.y)*0.5, afZ)), ImGui_NrmSizeGroup(avNrmSize));
			
			ImGui_DoTextFrameExt(asText, ImGui_NrmSizeGroup(cVector2f(0.05, 0)), 0, 0, textData, 
							  ImGui_NrmPosGroup(cVector3f(0.0, 0.1, 1)), ImGui_NrmSizeGroup(cVector2f(1, 1)));
	}

	//-------------------------------------------------------
	
	void DoDialogWindowEnd()
	{
		ImGui_DoWindowEnd();
	}	
	
	//-------------------------------------------------------
	
	void DoStatusGaugesHorizontal(int alCount, const cVector3f &in avNrmPos, const cVector2f &in avNrmSize, float afThicknessMul = 0.8, float afMinValue = 0.75, 
								  float afMaxValue = 1.0f, const cColor &in aFillColor = cColor_White, const tString &in asPrefix = "Horizontal")
	{
		afMinValue *= mfEscapePodGaugeValue;
		afMaxValue *= mfEscapePodGaugeValue;
				
		cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
		gauge.mGfxFill.mColor = aFillColor;
		cVector2f vSize = ImGui_NrmSizeGroup(avNrmSize);
		vSize.y = (vSize.y/alCount) * afThicknessMul;
		cVector3f vOffsetPos = cVector3f(0, avNrmSize.y/alCount, 0);
		for (int i = 0; i < alCount; i++)
			ImGui_DoGauge(gauge, Depth_ImGui_GetOscillatingSignalValue(asPrefix, i, eEasing_QuadInOut, afMinValue, afMaxValue), ImGui_NrmPosGroup(avNrmPos + vOffsetPos*i), vSize);
	}

	//-------------------------------------------------------
	
	void DoStatusGaugesVertical(int alCount, const cVector3f &in avNrmPos, const cVector2f &in avNrmSize, float afThicknessMul = 0.8, float afMinValue = 0.75, 
								float afMaxValue = 1.0f, const cColor &in aFillColor = cColor_White, const tString &in asPrefix = "Vertical")
	{
		
		afMinValue *= mfEscapePodGaugeValue;
		afMaxValue *= mfEscapePodGaugeValue;
		
		cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
		gauge.mGfxFill.mColor = aFillColor;
		gauge.mOrientation = eImGuiGaugeOrientation_Vert;
		cVector2f vSize = ImGui_NrmSizeGroup(avNrmSize);
		vSize.x = (vSize.x/alCount) * afThicknessMul;
		cVector3f vOffsetPos = cVector3f(avNrmSize.x/alCount, 0, 0);
		for (int i = 0; i < alCount; i++)
			ImGui_DoGauge(gauge, Depth_ImGui_GetOscillatingSignalValue(asPrefix, i, eEasing_QuadInOut, afMinValue, afMaxValue), ImGui_NrmPosGroup(avNrmPos + vOffsetPos*i), vSize);
	}

	//-------------------------------------------------------
	
	void DoRandomNumbers(int alColumns, int alRows, const cVector3f &in avNrmPos, const cVector2f &in avSpacing, int alFontSize = 2, 
						 int alMinValue = 100, int alMaxValue = 999, const tString &in asPrefix = "Number")
	{		
		for (int i = 0; i < alRows*alColumns; i++)
		{
			ImGui_DoLabel("" + int(Depth_ImGui_GetOscillatingSignalValue(asPrefix, i, eEasing_QuadInOut, alMinValue, alMaxValue)), 
						  ImGui_NrmPosGroup(avNrmPos + cVector3f(avSpacing.x*(i%alColumns), avSpacing.y*(i/alColumns), 0)), cVector2f_MinusOne, alFontSize);
		}
	}
	
	//-----------------------------------------------------------------------------
	
	bool DoLoadingWindow(const tString &in asName, const tString &in asCaption, const tString &in asText, float afLoadTime, bool abReset, float afZ=1.5f)
	{		
		DoDialogWindowStart(asCaption, asText, cVector2f(0.6, 0.2), afZ);
			bool bDone = Depth_ImGui_LoadingGauge(asName, afLoadTime, abReset, ImGui_NrmPosGroup(cVector3f(0.1, 0.5, 1)), 
												  ImGui_NrmSizeGroup(cVector2f(0.8, 0.3)), StationGui_CreateDefaultGaugeData());
		DoDialogWindowEnd();
		
		return bDone;
	}
	
	//-----------------------------------------------------------------------------
	
	void OnGuiEscapePodMap(const tString&in asEntityName, float afTimeStep)
	{
		if (!mbEscapePodScreensActive) return;
		
		///////////////////////
		//Render terminal from 2.3
		if(mb23Terminals)
		{
			OnGuiEscapePodMap23("PodDisplay_1", afTimeStep);
			return;
		}
		
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		if (mbEscapePodInitializing)
		{
			if (DoLoadingWindow("pod_init", "Booting", "Standby", 2.0f, true))
			{
				mbEscapePodInitializing = false;
			}
			return;
		}
		
		//ImGui_DoImage(cImGuiGfx("catherine_large"), cVector3f(0,0,1), ImGui_NrmSizeGroup(cVector2f(1, 1)));
		Depth_ImGui_CathPortrait(afTimeStep);
	}

	//-----------------------------------------------------------------------------

	void OnGuiEscapePodStatus(const tString&in asEntityName, float afTimeStep)
	{
		///////////////////////
		//Render terminal from 2.3
		if(mb23Terminals)
		{
			OnGuiEscapePodStatus23("PodDisplay_2", afTimeStep);
			return;
		}
		
		//////////////////////////////////////
		// If pods are not active, display Catherine if appropriate
		if (!mbEscapePodScreensActive)
		{
			OnGuiEscapePodCatherine(asEntityName, afTimeStep);
			return;		
		}
		
		ImGui_SetTransCategory("");
		
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		if (mbEscapePodInitializing)
		{
			if (DoLoadingWindow("pod_init", "Booting", "Standby", 2.0f, true))
			{
				mbEscapePodInitializing = false;
			}
			return;
		}
		
		mfEscapePodGaugeValue = cMath_InterpolateLinear(mfEscapePodGaugeValue,mfEscapePodGaugeMaxValue,afTimeStep);
		
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		ImGui_DoWindowStart("Status", window, ImGui_NrmPosGroup(cVector3f(0.1, 0.1, 3)), ImGui_NrmSizeGroup(cVector2f(0.8, 0.8)));
		
			DoStatusGaugesHorizontal(5, cVector3f(0.1, 0.1, 1), cVector2f(0.75, 0.525));
			DoStatusGaugesVertical(4, cVector3f(0.55, 0.7, 1), cVector2f(0.2, 0.19), 0.6, 0.3, 0.9);
			DoRandomNumbers(3, 2, cVector3f(0.15, 0.7, 1), cVector2f(0.1, 0.1), 2, 10, 99);
			
		ImGui_DoWindowEnd();
	}
	
	//-----------------------------------------------------------------------------
	
	void OnGuiEscapePodCatherine(const tString&in asEntityName, float afTimeStep)
	{
		if (mbCathPluggedIn == false) return;
		
		/////////////////////////////
		// Display Catherines face
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		//ImGui_DoImage(cImGuiGfx("catherine_large"), cVector3f(0,0,1), ImGui_NrmSizeGroup(cVector2f(1, 1)));
		
		Depth_ImGui_CathPortrait(afTimeStep);

	}
	
	//-------------------------------------------------------
 
    /////////////////////////////////////////
    // Terminal *Escape pod status displays* FROM 2.3
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	void OnGuiEscapePodStatus23(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("02_03_delta");
		
		///////////////////
		// Data
		cImGuiGaugeData gaugeData = StationGui_CreateDefaultGaugeData();
		cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
		cImGuiLabelData labelData = ImGui_GetDefaultLabel();
		
		// Draw background
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		bool bError = Entity_GetVarBool(asEntityName, "Error");
		
		int lStatusIndex = 0;
		
		//////////////////////
		// Gauges
		ImGui_DoWindowStart("StabilityControl", windowData, ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.5)));
			for (int i = 0; i < 4; i++)
			{
				float fTargetStatus = bError ? cMath_RandRectf(0.01, 0.1) : cMath_RandRectf(0.8, 1.0);
				float fCurrentStatus = ImGui_GetStateFloat("Status_" + lStatusIndex, 1);
				float fNewStatus = fCurrentStatus + cMath_Sign(fTargetStatus-fCurrentStatus)*afTimeStep*0.3;
				ImGui_SetStateFloat("Status_" + lStatusIndex, fNewStatus);
				ImGui_DoGauge(gaugeData, fNewStatus, ImGui_NrmPosGroup(cVector3f(0.05, 0.075+(0.22*i), 1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.15)));
				lStatusIndex++;
			}
		ImGui_DoWindowEnd();
		
		/////////////////////////
		// Equalizer-like thing
		ImGui_DoWindowStart("EnergyOutput", windowData, ImGui_NrmPosGroup(cVector3f(0.515, 0.575, 1)), ImGui_NrmSizeGroup(cVector2f(0.435, 0.375)));
			const int lResolution = 20;
			const float fPadding = 0.2f;
			const float fXSize = 1/float(lResolution);
			ImGui_GroupBegin(ImGui_NrmPosGroup(cVector3f(0.05, 0.1, 1)), ImGui_NrmSizeGroup(cVector2f(0.87, 0.75)));
				//ImGui_DoImage(cImGuiGfx(""), ImGui_NrmPosGroup(cVector3f(0, 0, 0.5)), ImGui_NrmSizeGroup(cVector2f(1, 1)));
				for (int i = 0; i < lResolution; i++)
				{
					float fTargetStatus = cMath_RandRectf(0.0, 1.0);
					float fCurrentStatus = ImGui_GetStateFloat("Status_" + lStatusIndex, 0.1);
					float fNewStatus = fCurrentStatus + cMath_Sign(fTargetStatus-fCurrentStatus)*afTimeStep*(bError ? 4.0 : 0.3);
					ImGui_SetStateFloat("Status_" + lStatusIndex, fNewStatus);
					float fXPos = fXSize*i;
					float fYPos = 0.5-fNewStatus*(0.5-fPadding);
					ImGui_SetModColorMul(cColor(0.5*fNewStatus,1-fNewStatus,0,1));
					ImGui_DoImage(cImGuiGfx(""), ImGui_NrmPosGroup(cVector3f(fXPos, fYPos, 1)), 
								  ImGui_NrmSizeGroup(cVector2f(fXSize, 1-2*fYPos)));
					ImGui_ResetModifiers();
					lStatusIndex++;
				}
			ImGui_GroupEnd();
		ImGui_DoWindowEnd();
		
		/////////////////////////
		// Icons
		ImGui_DoWindowStart("EngineStatus", windowData, ImGui_NrmPosGroup(cVector3f(0.05, 0.575, 1)), ImGui_NrmSizeGroup(cVector2f(0.435, 0.375)));
		if (!bError)
		{
			ImGui_DoImage(cImGuiGfx("escapepod_statusicon_1"), ImGui_NrmPosGroup(cVector3f(0.1, 0.1, 1)), ImGui_NrmSizeGroup(cVector2f(0.15, 0.225)));
			ImGui_DoImage(cImGuiGfx("escapepod_statusicon_3"), ImGui_NrmPosGroup(cVector3f(0.1, 0.6, 1)), ImGui_NrmSizeGroup(cVector2f(0.15, 0.225)));
			ImGui_DoImage(cImGuiGfx("escapepod_statusicon_2"), ImGui_NrmPosGroup(cVector3f(0.433, 0.6, 1)), ImGui_NrmSizeGroup(cVector2f(0.15, 0.225)));
			ImGui_DoImage(cImGuiGfx("escapepod_statusicon_4"), ImGui_NrmPosGroup(cVector3f(0.433, 0.1, 1)), ImGui_NrmSizeGroup(cVector2f(0.15, 0.225)));
			ImGui_DoImage(cImGuiGfx("escapepod_statusicon_5"), ImGui_NrmPosGroup(cVector3f(0.766, 0.1, 1)), ImGui_NrmSizeGroup(cVector2f(0.15, 0.225)));
			ImGui_DoImage(cImGuiGfx("escapepod_statusicon_6"), ImGui_NrmPosGroup(cVector3f(0.766, 0.6, 1)), ImGui_NrmSizeGroup(cVector2f(0.15, 0.225)));
		}
		else
		{
			ImGui_SetModColorMul(ImGui_FadeOscillateColor("EngineFailureCol", cColor(1, 0, 0, 1), cColor(0.5, 0, 0, 1), 0.3));
			labelData.mFontAlign = eFontAlign_Center;
			ImGui_DoLabelExt("EngineFailure", labelData, ImGui_NrmPosGroup(cVector3f(0, 0.35, 1)), ImGui_NrmSizeGroup(cVector2f(1, -1)), 2);
		}
		ImGui_DoWindowEnd();
	}
 
	//-------------------------------------------------------
	
	void OnGuiEscapePodMap23(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("02_03_delta");
		
		///////////////////
		// Data
		cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
		windowData.mfPaddingTop = -14;
		
		// Draw background
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		///////////////////////
		// Setup variables
		bool bError = Entity_GetVarBool(asEntityName, "Error");
		const int lNumOfDots = 5;
		float fTimeBetweenDots = bError ? 0.75f : 6.f;
		ImGui_DoWindowStart("MapWindow", windowData, ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.9)));
		
			////////////////////////////
			// Overlay
			ImGui_SetModColorMul(cColor(0.8,1));
			ImGui_DoImage(cImGuiGfx("escapepod_mapoverlay"), ImGui_NrmPosGroup(cVector3f(0, 0, 3)), ImGui_NrmSizeGroup(cVector2f(1, 1)));
			////////////////////////////
			
			////////////////////////////
			// Movement
			const cVector3f vLambdaPos = cVector3f(1, 0.75, 0.1);
			const cVector3f vThetaPos = cVector3f(0.475, 0.9, 0.1);
			const cVector3f vDeltaPos = cVector3f(0.65, 0.525, 0.1);
			cVector3f vTargetPos = bError ? vDeltaPos : vThetaPos;
			cVector3f vNewPos = ImGui_GetStateVector3f("Position", vLambdaPos);
			vNewPos += cMath_Vector3Normalize(vTargetPos-vNewPos)*afTimeStep* (bError ? 0.04 : 0.005);
			ImGui_SetStateVector3f("Position", vNewPos);
			
			////////////////////////////
			// Map
			ImGui_GroupBegin(ImGui_NrmPosGroup(vNewPos), ImGui_NrmSizeGroup(cVector2f(1, 1)));
				ImGui_DoImage(cImGuiGfx("escapepod_map", eImGuiGfx_Texture), ImGui_NrmPosGroup(cVector3f(-1, -1, 0)), ImGui_NrmSizeGroup(cVector2f(1.5, 1.5)));
				ImGui_SetModColorMul(cColor(0.8, 0, 0,0.4));
				
				for (int i = 0; i < lNumOfDots; i++)
				{
					ImGui_SetModColorMul(ImGui_GetStateColor("DotColor_" + i, cColor_White));
					cVector3f vDotPos = ImGui_GetStateVector3f("Dot_" + i, cVector3f(-100, -100, 0));
					ImGui_DoImage(cImGuiGfx(""), ImGui_NrmPosGroup(cVector3f(0.495)-vDotPos), ImGui_NrmSizeKeepRatio(cVector2f(0.01, 0.01)));
				}
				
			ImGui_GroupEnd();
		ImGui_DoWindowEnd();
		
		////////////////////////
		// Trail dots
		if (ImGui_TimerExists("NewMapDot") == false)
		{
			ImGui_AddTimer("NewMapDot", fTimeBetweenDots);
		}
		
		if (ImGui_TimerOver("NewMapDot"))
		{
			ImGui_AddTimer("NewMapDot", fTimeBetweenDots);
			
			int lDotIndex = ImGui_GetStateInt("DotIndex", 0) + 1;
			if (lDotIndex >= lNumOfDots) lDotIndex = 0;
			
			ImGui_SetStateVector3f("Dot_" + lDotIndex, ImGui_GetStateVector3f("Position", vLambdaPos));
			ImGui_SetStateColor("DotColor_" + lDotIndex, cColor_White);
			ImGui_FadeStateColor("DotColor_" + lDotIndex, cColor(1, 0), fTimeBetweenDots*lNumOfDots);
			
			ImGui_SetStateInt("DotIndex", lDotIndex);
		}
	}
	
	//-----------------------------------------------------------------------------
	
	//////////////////////////////////////////
	// Terminal - Electric room cylinders
	//////////////////////////////////////////
	
	//-----------------------------------------------------------------------------
	float mfWarningFlash = 0.0f;
	float mfBigWarningTimer = 0.0f;
	//-----------------------------------------------------------------------------
	
	void CylinderTerminal_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("02_02_ms_curie_inside");
		//tString sState = Entity_GetVarString(asEntityName,"");
		
		StationGuiBG_Scanlines();
		
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
			
		cImGuiLabelData label = ImGui_GetDefaultLabel();
		label.mFontAlign = eFontAlign_Center;
		label.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.075);
		cVector2f vFontSize = label.mFont.mvSize;
		
		cImGuiTextFrameData textFrame = ImGui_GetDefaultTextFrame();
		textFrame.mFont.mvSize = 40.0f;
		textFrame.mbUseBackgroundGfx = false;
		textFrame.mFontAlign = eFontAlign_Center;
		
		
		
		////////////////////////////////
		// Set warning text
		tString sTemperatureCat = "CoreTemperatureStable";
		tString sActionText = "CoreActionStable";
		cColor colorTemperature = cColor_White;
		
		if (mlTentaclesDetached >= 3)
		{
			sTemperatureCat = "CoreTemperatureCritical";	
			sActionText = "CoreActionCritical";
			colorTemperature = cColor_Red;
		}
		else if (mlTentaclesDetached >= 2)
		{
			sTemperatureCat = "CoreTemperatureWarning";	
			sActionText = "CoreActionWarning";
			colorTemperature = cColor(1,0.75,0,1);
		}
		else if (mlTentaclesDetached >= 1)
		{
			sTemperatureCat = "CoreTemperatureModerate";	
			sActionText = "CoreActionModerate";
			colorTemperature = cColor(0,1,0,1);
		}
		
		cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
		gauge.mOrientation = eImGuiGaugeOrientation_Vert;
		gauge.mbUseBackgroundGfx = true;
		gauge.mGfxFill.mColor = colorTemperature;
		
		
		////////////////////////////////
		// Set target temperature
		float fTemperature = 0.1f;
		fTemperature += mlTentaclesDetached * 0.15f;
		if (mlTentaclesDetached >= 3) fTemperature = 1.0f;
		
		float fCurrentTemp = ImGui_GetStateFloat("CoreTemperature",0.0f);
		fCurrentTemp = cMath_InterpolateLinear(fCurrentTemp, fTemperature, afTimeStep * 2.0f);
		ImGui_SetStateFloat("CoreTemperature",fCurrentTemp);
		
		/////////////////////////////
		// Periodically flash a really big warning
		float fWarningTimer = ImGui_GetStateFloat("BigWarningTimer",0.0f);
		fWarningTimer += afTimeStep;
		if (fWarningTimer > 6.0f) fWarningTimer = 0.0f;
		ImGui_SetStateFloat("BigWarningTimer", fWarningTimer);
		
		if (sTemperatureCat == "CoreTemperatureCritical" && fWarningTimer > 3.0f)
		{
			GuiAbandonShip(sActionText, afTimeStep);
			return;
		}

		
		ImGui_DoWindowStart("", window, ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 3)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.9)));
		
			///////////////////////////
			// Show temperature gauge
			ImGui_DoGauge(gauge,fCurrentTemp,ImGui_NrmPosGroup(cVector3f(0.1,0.2,3)), ImGui_NrmSizeGroup(cVector2f(0.1f,0.7f)));
			
			ImGui_ResizeFontToFit("CoreTemperature", label.mFont, ImGui_GetCurrentGroupSize().x*0.275);
			ImGui_DoLabelExt("CoreTemperature", label, ImGui_NrmPosGroup(cVector3f(0.1,-0.4,3)),ImGui_NrmSizeGroup(1.0f,1.0f));
			label.mFont.mvSize = vFontSize;
			
			ImGui_SetModColorMul(colorTemperature);
			ImGui_DoLabelExt(sTemperatureCat, label, ImGui_NrmPosGroup(cVector3f(0.1,-0.3,3)),ImGui_NrmSizeGroup(1.0f,1.0f));
			
			ImGui_SetModColorMul(cColor_White);
			ImGui_DoLabelExt("CoreAction", label, ImGui_NrmPosGroup(cVector3f(0.1,-0.1,3)),ImGui_NrmSizeGroup(1.0f,1.0f));
			
			float fWarningFlash = ImGui_GetStateFloat("WarningFlash",0.0f);
			fWarningFlash += afTimeStep;
			if (fWarningFlash > 1.0f) fWarningFlash = 0.0f;
			ImGui_SetStateFloat("WarningFlash",fWarningFlash);
			
			if (mlTentaclesDetached >= 2 && fWarningFlash > 0.5f)
			{
				ImGui_SetModColorMul(cColor_Red);
				ImGui_DoLabelExt(sActionText, label, ImGui_NrmPosGroup(cVector3f(0.1,-0.0,3)),ImGui_NrmSizeGroup(1.0f,1.0f));	
			}
			else if (mlTentaclesDetached < 2)
			{
				ImGui_SetModColorMul(cColor_White);
				ImGui_DoLabelExt(sActionText, label, ImGui_NrmPosGroup(cVector3f(0.1,-0.0,3)),ImGui_NrmSizeGroup(1.0f,1.0f));	
			}
			
		ImGui_DoWindowEnd();
	}
	
	//------------------------------------------
	
	void GuiAbandonShip(tString asActionText, float afTimeStep)
	{
		cStationGui_BigStatusMessageSettings settings;
		settings.mbBlinking = true;
		settings.mfTextSizeMul = 1.5;
		StationGui_BigStatusMessage(asActionText, settings);
	}
	
	//---------------------------------------------------------------------

	/////////////////////////////////////////
	// AUDIO
	//{//////////////////////////////////////
	
	//---------------------------------------------------------------------

	/**
	*Simple ambient music player that fades the ambience randomly whilst playing to stop it from getting repetitive
	**/
	
	bool mbAmbientMusicPlaying = false;
	bool mbAmbientMusicSecondStage = false;
	bool mbAmbientMusicAllowed = true;
	float gfAmbientMusicMul = 1.0f;
	
	void AmbientMusicHandler(const tString &in asTimer)
	{		
		if (asTimer=="StartAmbient" && mbAmbientMusicPlaying==false && mbAmbientMusicAllowed==true)
		{
			if(mbAmbientMusicSecondStage==false)
			{
				Music_PlayExt(gsCurieMusicLevel1, true, 0.7f, 1.0f, cMath_RandRectf(3.f,5.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			else if(mbAmbientMusicSecondStage==true)
			{
				Music_PlayExt(gsCurieMusicLevel2, true, 0.85f, 1.0f, cMath_RandRectf(3.f,5.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			
			cLux_AddDebugMessage("Ambient music triggering");
			
			mbAmbientMusicPlaying = true;
			
			//Dynamic fades
			Map_AddTimer("RandomFadeRider", cMath_RandRectf(10.f,20.f), "AmbientMusicHandler");
			Map_AddTimer("FadeOut", cMath_RandRectf(120.f,180.f), "AmbientMusicHandler");
			Map_RemoveTimer("StopAmbientMusic");
			Map_RemoveTimer("StopAmbientMusicQuickly");
		}
		
		else if (asTimer=="StartAmbient" && mbAmbientMusicPlaying==false && mbAmbientMusicAllowed==false)
		{
			Map_AddTimer("StartAmbient", cMath_RandRectf(10.f,20.f), "AmbientMusicHandler");
		}
		
		else if (asTimer=="StopAmbientMusic" && mbAmbientMusicPlaying==true)
		{
			Music_Stop(4.5f, eMusicPrio_BgAmb);
			Map_RemoveTimer("RandomFadeRider");
			Map_RemoveTimer("FadeOut");
			Map_RemoveTimer("StartAmbient");
			Music_FadeVolumeMul(1.0f,1.0f);
			mbAmbientMusicPlaying = false;
		}
		else if (asTimer=="StopAmbientMusicQuickly" && mbAmbientMusicPlaying==true)
		{
			cLux_AddDebugMessage("Stop Ambient Music Quickly Triggered");
			Music_Stop(1.5f, eMusicPrio_BgAmb);
			Map_RemoveTimer("StartAmbient");
			Map_RemoveTimer("RandomFadeRider");
			Map_RemoveTimer("FadeOut");
			Music_FadeVolumeMul(1.0f,1.0f);
			mbAmbientMusicPlaying = false;
		}
		
		else if(asTimer=="RandomFadeRider")
		{
			if(mbAmbientMusicSecondStage==false)
			{
				Music_PlayExt(gsCurieMusicLevel1, true, 0.65f*gfAmbientMusicMul, 1.0f, cMath_RandRectf(5.f,8.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			else if(mbAmbientMusicSecondStage==true)
			{
				Music_PlayExt(gsCurieMusicLevel2, true, 0.65f*gfAmbientMusicMul, 1.0f, cMath_RandRectf(5.f,8.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			
			cLux_AddDebugMessage("Ambient Music Fading");
			gfAmbientMusicMul = cMath_RandRectf(0.85f, 1.1f);
			Map_AddTimer("RandomFadeRider", cMath_RandRectf(10.f,15.f), "AmbientMusicHandler");
		}
		
		else if(asTimer=="FadeOut")
		{	
			cLux_AddDebugMessage("Ambient Music Fading Out");
			Music_Stop(cMath_RandRectf(8.f,12.f), eMusicPrio_BgAmb);
			mbAmbientMusicPlaying = false;
			
			Map_RemoveTimer("RandomFadeRider");
			Map_AddTimer("StartAmbient", cMath_RandRectf(120.f,180.f), "AmbientMusicHandler");
		}
		
		cLux_AddDebugMessage("Ambient Music Playing is "+mbAmbientMusicPlaying);
	}
	
	//---------------------------------------------------------------------

	bool Trigger_SetStage2Music(const tString &in asParent, const tString &in asChild, int alState)
	{
		mbAmbientMusicSecondStage = true;
		cLux_AddDebugMessage("Second stage music set");
		return false;
	}
		
	//---------------------------------------------------------------------

	bool Trigger_PodMusicStop(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbFinalChaseInProgress) return false;
		
		if(alState==1)
		{
			Map_AddTimer("StopAmbientMusicQuickly", 1.0f, "AmbientMusicHandler");
		}
		else
		{
			Map_AddTimer("StartAmbient", 1.0f, "AmbientMusicHandler");
		}
		return true;
	}
		
	//---------------------------------------------------------------------

	bool Trigger_PodMusicEnter(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbFinalChaseInProgress) return false;
		
		Music_Play("03_02_body_cortex", 0.5f, false, eMusicPrio_BigEvent);
		
		return false;
	}
	
	//}Endaudio--------------------------------------------------------------------
	
}