	/////////////////////////////////////////
	// LOOPING VOICE (FIRST FLOOR)
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	bool mbVoiceListenerArea = false;
	bool Trigger_VoiceListenerArea(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			mbVoiceListenerArea = true;
		}
		else
		{
			mbVoiceListenerArea = false;
		}
		return true;
	}
	
	void TimerLoopingVoiceFirstFloor(const tString &in asTimer)
	{
		///////////////////////////////////
		// If player is in the area, play voice and add a long timer
		if (Entity_GetCollide("Player","AreaNearAutomatedVoice"))
		{
			cLux_AddDebugMessage("Play message");
			Map_AddTimer("timer_loopingvoicerepeat",cMath_RandRectf(60.0f,80.0f),"TimerLoopingVoiceFirstFloor");
			
			if(mbVoiceListenerArea==false)
			{
				cLux_AddDebugMessage("voice false");
			}
			
			if (mbVoiceListenerArea==false) return;
			
			Voice_Play("1_StaticVoice");
			
		}
		
		///////////////////////////////////
		// Otherwise make it a bit more frequent.
		else
		{
			Map_AddTimer("timer_loopingvoicerepeat",40.0f,"TimerLoopingVoiceFirstFloor");
		}
	}
	
	//-------------------------------------------------------
	
	bool OnCollideLoopingVoice(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
		{
			cLux_AddDebugMessage("Kicked off first floor looping voice");
			
			//////////////////////////////
			// Play looping static voice on first floor
			Map_AddTimer("timer_loopingvoice",1.0f,"TimerLoopingVoiceFirstFloor");
			return false;
		}
		
		return true;
	}
	
