	//-------------------------------------------------------
	bool mbIsEscapeMusicActive = false;
	void StartEscapeMusic()
	{
		if(mbIsEscapeMusicActive == false)
		{
			Music_PlayExt("02_02_flesherattacks_DEMO", true, 0.75f, 1.0f, 2.0f, 0.0f, eMusicPrio_OverrideAll, false);
		}
	}
		
	//-------------------------------------------------------

	void StopEscapeMusic(float afFadeTime, bool abPlayerSuccessful=false)
	{
		Music_Stop(afFadeTime, eMusicPrio_OverrideAll);
		mbIsEscapeMusicActive = false;
		
		if(abPlayerSuccessful==true)
		{
			//Music_PlayOverlay("01_02_torturecarl", 0.35f);
		}
	}
		
	//-------------------------------------------------------
	
	bool Trigger_StairCreak(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		cLux_AddDebugMessage("stair creakw");
		Sound_CreateAtEntity("StairCreak", "02_02_ms_curie_inside/AMB/spot/creaky_stairs", "Player");
		Entity_SetActive("StairCreakTrigger_*", false);
		Map_AddTimer("Timer_ActiveStairCreakArea", cMath_RandRectf(6.0f,12.0f), "Timer_ActiveStairCreakArea");
		return true;
	}
		
	//-------------------------------------------------------
	
	void Timer_ActiveStairCreakArea(const tString &in asTimer)
	{
		cLux_AddDebugMessage("stair creak areas enabled");
		Entity_SetActive("StairCreakTrigger_*", true);
	}
	
	//-------------------------------------------------------
	
	void StartMorseCodeSound()
	{
		Map_AddTimer("timer_morsecode", 1.0f, "morsecodesound");
	}
			
	//-------------------------------------------------------
	
	void morsecodesound (const tString &in asTimer)
	{
		Sound_CreateAtEntity("MorseCodeBeep", "02_02_ms_curie_inside/SFX/wau_morse/morse", "MorseSoundArea");
		Map_AddTimer("timer_morsecode", 10.0f, "morsecodesound");
	}
			
	//-------------------------------------------------------
	
	void StopMorseCodeSound()
	{
		Sound_Stop("MorseCodeBeep", 0.25f);
		Map_RemoveTimer("timer_morsecode");
	}
		
	//-------------------------------------------------------
	
	bool mbIsEscapeAlarmsActive = false;
	bool mbIsBigEscapeAlarmActive = false;
	bool mbAmbientAreasDisabledForEscape = false;
	void StartEscapeAlarms(float afFadeTime=0.0f)
	{
		Entity_SetActive("StairCreakTrigger_*", false);
		if(mbAmbientAreasDisabledForEscape == false)
		{
			//Remove old sound areas for optimisation
			Entity_SetActive("AMB_Pre_*", false);
			Entity_SetActive("AMB_Post_*", true);
			mbAmbientAreasDisabledForEscape = true;
		}
		if(mbIsEscapeAlarmsActive == false)
		{			
			Sound_CreateAtEntity("AreaCargoHoldAlarm_1", "02_02_ms_curie_inside/SFX/curie_tilt/alarm/general", "AreaCargoHoldAlarm_1", afFadeTime);
			Sound_CreateAtEntity("AreaCargoHoldAlarm_2", "02_02_ms_curie_inside/SFX/curie_tilt/alarm/general", "AreaCargoHoldAlarm_2", afFadeTime);
			Sound_CreateAtEntity("AreaCargoHoldAlarm_3", "02_02_ms_curie_inside/SFX/curie_tilt/alarm/general", "AreaCargoHoldAlarm_3", afFadeTime);
			Sound_CreateAtEntity("AreaCargoHoldAlarm_4", "02_02_ms_curie_inside/SFX/curie_tilt/alarm/general", "AreaCargoHoldAlarm_4", afFadeTime);
			Sound_CreateAtEntity("AreaCargoHoldAlarm_5", "02_02_ms_curie_inside/SFX/curie_tilt/alarm/general", "AreaCargoHoldAlarm_5", afFadeTime);
			Sound_CreateAtEntity("AreaCargoHoldAlarm_6", "02_02_ms_curie_inside/SFX/curie_tilt/alarm/general", "AreaCargoHoldAlarm_6", afFadeTime);
			Sound_CreateAtEntity("AreaCargoHoldAlarm_7", "02_02_ms_curie_inside/SFX/curie_tilt/alarm/general", "AreaCargoHoldAlarm_7", afFadeTime);
			Sound_CreateAtEntity("AreaCargoHoldAlarm_7", "02_02_ms_curie_inside/SFX/curie_tilt/alarm/general", "AreaCargoHoldAlarm_8", afFadeTime);
			Sound_CreateAtEntity("AreaCargoHoldAlarm_7", "02_02_ms_curie_inside/SFX/curie_tilt/alarm/general", "AreaCargoHoldAlarm_9", afFadeTime);
			mbIsEscapeAlarmsActive = true;
		}
		if(mbIsBigEscapeAlarmActive == false)
		{
			Map_AddTimer("timer_alarmloop",1.0f,"TimerStartAlarms");
			mbIsBigEscapeAlarmActive = true;
		}
	}
			
	//------------------------------------------------------
	
	void StopEscapeAlarms_Small(float afFadeTime=0.25f)
	{
		if(mbIsEscapeAlarmsActive == true)
		{
			Sound_Stop("AreaCargoHoldAlarm_*", afFadeTime);
			mbIsEscapeAlarmsActive = false;
		}
	}
		
	//------------------------------------------------------
	
	bool mbIsBigSirenPlaying = false;
	void TimerStartAlarms(const tString &in asTimer)
	{
		Sound_CreateAtEntity("BigAlarm", "02_02_ms_curie_inside/SFX/curie_tilt/alarm/big", "Player");
		Map_AddTimer("timer_alarmloop",10.f,"TimerStartAlarms");
		if(mbIsBigSirenPlaying == false)
		{
			Sound_CreateAtEntity("BigSiren", "02_02_ms_curie_inside/SFX/curie_tilt/alarm/big_siren", "Player");
			mbIsBigSirenPlaying = true;
		}
	}
		
	//-------------------------------------------------------

	void StopEscapeAlarms(float afFadeTime=0.25f)
	{
		Sound_Stop("AreaCargoHoldAlarm_*", afFadeTime);
		mbIsEscapeAlarmsActive = false;
	}
	
	//----------------------------------------------------
	
	void AirlockEffectsFlushWater()
	{
		Depth_Audio_AirlockDrainLeadInUW();
		Depth_Audio_AirlockDrainLoopUW();
		Map_AddTimer("AirlockDrainUWStopTimer", 6.0f, "AirlockDrainUWStop");
		Sound_PreloadGroup("02_02_ms_curie_inside/SFX/escape_pod", true);
	}
 
    //-------------------------------------------------------
	
	void AirlockDrainUWStop(const tString &in asTimer)
	{
		Sound_CreateAtEntity("PumpingAirLoop", "Entities_OceanBottom/airlock/air/pump/pump_loop_nointro", "PumpsSource", 0.55f, false, 1.0f);
		Depth_Audio_AirlockDrainLoopUWStop();
		Depth_Audio_AirlockDrainLoopAir();
		Map_AddTimer("AirlockDrainingAirStopTimer", 4.0f, "AirlockDrainingAirStop");
		Sound_Stop("Pump_Idle_Loop_Underwater", 0.25f);
	}
	
	//-------------------------------------------------------
	
	void AirlockDrainingAirStop(const tString &in asTimer)
	{
		Depth_Audio_AirlockDrainLoopAirStop();
		Depth_Audio_AirlockDrainLeadOutAir();
		Sound_Stop("PumpingAirLoop", 0.5f);
		Sound_CreateAtEntity("PumpAirLeadOut", "Entities_OceanBottom/airlock/air/pump/pump_end", "PumpsSource", 0.0f, false, 1.0f);
		AirlockEffectsTurnOnPumps();
	}
	
	void AirlockEffectsTurnOnPumps()
	{
		//airlock not full, play non-underwater idle sound
		Sound_CreateAtEntity("Pump_Idle_Loop_Air", "Entities_OceanBottom/airlock/air/pump/idle_loop", "PumpsSource", 1.0f, false, 1.0f); 
	}
		
	//-------------------------------------------------------
	//Escape Sequence
	void StartPodEscape()
	{
		Sound_CreateAtEntity("EscapePodLiftOff", "02_02_ms_curie_inside/SFX/escape_pod/escape_pod_startup_sequence", "Player");
		Sound_Stop("BigSiren", 13.0f);

		Map_AddTimer("StartUpScreenShake", 3.2f, "StartUpScreenShake");
		Map_AddTimer("DockingScreenShake", 7.75f, "DockingScreenShake");
		Map_AddTimer("EndingMusic", 5.0f, "EndingMusic");
	}
	
	void StartUpScreenShake(const tString &in asTimer)
	{
		Effect_Rumble_Start(0.4, 10, 2, 5);
		
		Effect_Shake_Start(0.0075, 15.0, 1.0f, 3.0f);
	}
	
	void DockingScreenShake(const tString &in asTimer)
	{
		Effect_Shake_Start(0.05, 0.5, 0.1, 0.1);
		Sound_Stop("BigAlarm", 5.0f);
		Map_RemoveTimer("timer_alarmloop");
	}
	
	void EndingMusic(const tString &in asTimer)
	{
		//Music_PlayExt("02_02_leaving", false, 0.75f, 1.0, 5.0f, 0.0f, eMusicPrio_BigEvent, false);
	}
	
		
	//-------------------------------------------------------
	
	bool Trigger_RemoveVent(const tString &in asParent, const tString &in asChild, int alState)
	{
		Sound_CreateAtEntity("RemoveVent", "03_02_omicron_inside/SFX/vent_hatch_rip", "Player");	
		return false;
	}
	
	//-------------------------------------------------------
	
	void StartAmbientCurieMusic()
	{
		/* Note for Sam - this method is actually called in a few places. 
		 * One, when you leave the starting room.
		 * Two, when you enter the escape pod we have similar cutting in/out of the ambient music like we do in 3.2 containment.
		 * Three, the power room also cuts the music in the same fashion as the escape pod.
		 */
		 
		Map_AddTimer("StartAmbient", 1.0f, "AmbientMusicHandler");
	}
	
	//-------------------------------------------------------
	
	void StopAmbientCurieMusic()
	{
		Map_AddTimer("StopAmbientMusic", 1.0f, "AmbientMusicHandler");
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaPowerRoomMusicStop(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		if (mbFinalChaseInProgress) return false;
		
		Entity_SetActive("AreaPowerRoomMusicResume*",true);
		StopAmbientCurieMusic();
		
		return true;
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaPowerRoomMusicResume(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbFinalChaseInProgress) return false;
		if (alState != 1) return true;
		
		Entity_SetActive("AreaPowerRoomMusicResume*", false);
		StartAmbientCurieMusic();
		
		return true;
	}
	
