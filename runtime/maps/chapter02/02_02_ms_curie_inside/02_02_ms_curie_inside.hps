	bool EnterElectricRoom(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		/////////////////////////////////
		// First time entering power room, set checkpoint
		if (mbElectricsCheckpointSet == false)
		{
			mbElectricsCheckpointSet = true;
			cLux_AddDebugMessage("Electrics Checkpoint");
			CheckPoint_Setup("ElectricsCheckpoint");
		}
		
		mbFoundPowerRoom = true;
		
		
			
		return false;
	}
	
