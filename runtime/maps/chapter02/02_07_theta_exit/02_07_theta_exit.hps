	//-------------------------------------------------------

	void PreloadData()
	{
		// Gui
		StationGui_PreloadDefault();
		OmnitoolGui_Preload();

		ImGui_PreloadImage("urban/tv/00_05_tv_no_disc", eImGuiGfx_Image);
		ImGui_PreloadImage("wakeup.dds", eImGuiGfx_Texture);

		// Player hands
		PlayerHands_PreloadHandModel_Diving();
		
		// Particles
		ParticleSystem_Preload("elevator_crash_cloud.ps");
		ParticleSystem_Preload("oneshot_waterbubbles_explosion.ps");
		ParticleSystem_Preload("elec_spark_physics_oneshot.ps");
		ParticleSystem_Preload("tunnel_flood.ps");
		ParticleSystem_Preload("loop_waterbubbles_large_cloud.ps");
		ParticleSystem_Preload("mindcoral_escape.ps");
	}
	
	//-------------------------------------------------------
	
	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		CathTool_ResetScreen(eCathToolVariant_CathDelta);
		
		SetupWakeUp();
		SetupPowerStation();
		SetupPool();
		SetupFlood();
		SetupPumpRoom();
		SetupCatherine();
		SetupEntities();
		SetupConsoles();
		
		Map_AddTimer("SetupWaterfall", 1, "SetupWaterfallAudio");

		if (!cLux_ScriptDebugOn())
		{
			EyeTracking_SetExtendedViewMul(0.4f);
			StartWakeUp();
		}
		
		/////////////////////////
		// Debug
		
		Light_SetVisible("DebugBoxLight",mbDebugBoxLight);
		
		if(cLux_ScriptDebugOn())
		{
			
		}
		
		// Reset volumes
		Music_Stop(0, eMusicPrio_BgAmb);
		Music_FadeVolumeMul(1, 0);

		//Set sound to 0 for intro
		Sound_SetGlobalVolume(0.0f, eSoundEntryType_World);
		if(cLux_ScriptDebugOn())	{
			Sound_SetGlobalVolume(1.0f, eSoundEntryType_All);
		}
		
		//////////////////////////////////////////
		// Player setup
		Player_SetAmbientLight_Indoors();
		
		PlayerHands_SetHandModel_Diving();
		
		//////Level Audio and Preloads	
		Sound_PreloadProject("02_07_theta_exit_a");
		Sound_PreloadGroup("Flashback/Level/02_07", true);
		
		LastOnSoma_SetText("02_07_theta_exit_1");
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map

	// S26AQ: this legacy Trigger has no handler and no independent climb action.
	// Retire only its false VR prompt; collision/story areas and working climbs stay active.
	void VR_RemoveUnusedClimbPrompt()
	{
		cScript_SetGlobalReturnBool(false);
		cScript_RunGlobalFunc("MenuHandler", "cScrMenuHandler", "HPL3VR_GetRuntimeActive");
		if (!cScript_GetGlobalReturnBool()) return;
		cLuxMap@ pMap = cLux_GetCurrentMap();
		if (pMap is null || pMap.ScriptMethodExists("void OnInteractCrateLadder_2(const tString &in)")) return;
		Entity_SetPlayerInteractCallback("TriggerLadderTop_2", "", false);
	}

	// S26AU: these rigid props retain callback names absent from this map.
	// A nonempty name alone advertises interaction. Clear only these known
	// stale prompts in VR; preserve a real implementation if one is present.
	// No per-frame lookup and no change to damage, collision or story events.
	void VR_RemoveUnusedRigidPrompts()
	{
		cScript_SetGlobalReturnBool(false);
		cScript_RunGlobalFunc("MenuHandler", "cScrMenuHandler", "HPL3VR_GetRuntimeActive");
		if(!cScript_GetGlobalReturnBool()) return;
		cLuxMap@ pMap = cLux_GetCurrentMap();
		if(pMap is null) return;
		if(!pMap.ScriptMethodExists("void InteractPickJacket(const tString &in)"))
			Entity_SetPlayerInteractCallback("Jacket", "", false);
	}

	void OnEnter()
	{
		VR_RemoveUnusedRigidPrompts();
		VR_RemoveUnusedClimbPrompt();
		MainMenu_SetBGPhase(eMainMenuPhase_2_4_To_3_3);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
	}

	//-------------------------------------------------------

	bool mbDebugBoxLight = false;

	////////////////////////////
	// To get when player makes input (mostly used for debug)

	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if (alAction == eAction_Test1)
		{
			array<iLuxEntity@> vEnts;
			cLux_GetCurrentMap().GetEntityArray("*", eLuxEntityType_Agent,"",vEnts);
			for(int i=0; i<vEnts.size(); ++i)
			{
				iLuxEntity@ pEnt = vEnts[i];
				if(pEnt.IsActive())
					cLux_AddDebugMessage("Agent: "+pEnt.GetName());
			}
		}
		
		if (alAction == eAction_Test2)
		{
			Player_SetHealth(0.1f);
		}
		
		if (alAction == eAction_Test3)
		{
			ParticleSystem_CreateAtEntity("ElevatorCrashParticles", "elevator_crash_cloud.ps", "ElevatorCrashPSArea", false);
			ParticleSystem_CreateAtEntity("ElevatorCrashParticles2", "elevator_crash_cloud_blast.ps", "ElevatorCrashPSArea", false);
		}
	
		if (alAction == eAction_Test4)
		{
			CoralBreak_Start();
		}
		
		if (alAction == eAction_Test5)
		{
			mbShowingEnd = !mbShowingEnd;
		}
		
		if (alAction == eAction_Test6)
		{
			mbDebugBoxLight = !mbDebugBoxLight;
			Light_SetVisible("DebugBoxLight",!mbDebugBoxLight);
		}
		
		if (alAction == eAction_Test7)
		{
			//Player_SetHealth(0.1);
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
			Preload();
		}
		
		if (alAction == eAction_Test8)
		{
			SlideDoor_SetClosed("TunnelDoor",false);
			Sequence_Flood("");
		}
		
	}

	//-------------------------------------------------------

	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afY)
	{
		//afY = cLux_DrawDebugText("Player Crouch", afY);
		return afY;
	}

	//-------------------------------------------------------
	
	void Update(float afTimestep)
	{
		UpdatePowerLevel(afTimestep);
	}
	
