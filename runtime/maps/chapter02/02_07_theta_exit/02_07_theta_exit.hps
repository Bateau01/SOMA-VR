	//----------------------------------------------------------------------
	//{Waterfall logic
	bool mbWaterfallsAudible = false;
	bool mbWaterfallsPlayerBehindBulkhead = false;
	
	//Start waterfall sounds but make them inaudible
	void SetupWaterfallAudio(const tString &in asTimer)
	{
		Sound_Play("waterfall_top_1", 0.0f);
		Sound_Play("waterfall_top_2", 0.0f);
		Sound_Play("waterfall_top_3", 0.0f);
		Sound_Play("waterfall_top_m_1", 0.0f);
		Sound_Play("waterfall_top_m_2", 0.0f);
		Sound_Fade("waterfall_top_1", 0.0f, 1.0f);
		Sound_Fade("waterfall_top_2", 0.0f, 1.0f);
		Sound_Fade("waterfall_top_3", 0.0f, 1.0f);
		Sound_Fade("waterfall_top_m_1", 0.0f, 1.0f);
		Sound_Fade("waterfall_top_m_2", 0.0f, 1.0f);
		
		mbWaterfallsAudible = false;
	}

	//Stop waterfall audio when player exits area
	bool StopWaterfallAudio(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState ==1 && mbWaterfallsAudible==true)
		{
			cLux_AddDebugMessage("Fading waterfall sounds");
			
			Sound_Fade("waterfall_top_1", 0.0f, 3.0f);
			Sound_Fade("waterfall_top_2", 0.0f, 3.0f);
			Sound_Fade("waterfall_top_3", 0.0f, 3.0f);
			Sound_Fade("waterfall_top_m_1", 0.0f, 1.0f);
			Sound_Fade("waterfall_top_m_2", 0.0f, 1.0f);
			
			mbWaterfallsAudible = false;
		}
		else
		{
			cLux_AddDebugMessage("Waterfall Stop - nothing to do");
		}
		return true;
	}
	
	//Start waterfall audio when player enters area
	bool StartWaterfallAudio(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState==1 && mbWaterfallsAudible==false && mbWaterfallBulkheadOpen==true)
		{
			cLux_AddDebugMessage("Starting waterfall sounds");
			
			Sound_Fade("waterfall_top_1", 1.0f, 1.5f);
			Sound_Fade("waterfall_top_2", 1.0f, 1.5f);
			Sound_Fade("waterfall_top_3", 1.0f, 1.5f);
			Sound_Fade("waterfall_top_m_1", 1.0f, 1.5f);
			Sound_Fade("waterfall_top_m_2", 1.0f, 1.5f);
			
			mbWaterfallsAudible = true;
		}
		else
		{
			cLux_AddDebugMessage("Waterfall Start - nothing to do");
		}
		return true;
	}
	
	//If player behind bulkhead door then start/stop sounds based on door open/closed
	bool mbWaterfallBulkheadOpen = false;
	
	bool WaterfallDoor(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==-1 && mbWaterfallsAudible==false && mbWaterfallsPlayerBehindBulkhead==true)
		{
			cLux_AddDebugMessage("Door Opening - starting waterfall sound");
			Sound_Fade("waterfall_top_1", 1.0f, 1.5f);
			Sound_Fade("waterfall_top_2", 1.0f, 1.5f);
			Sound_Fade("waterfall_top_3", 1.0f, 1.5f);
			Sound_Fade("waterfall_top_m_1", 1.0f, 1.0f);
			Sound_Fade("waterfall_top_m_2", 1.0f, 1.0f);
			mbWaterfallBulkheadOpen = true;
			mbWaterfallsAudible = true;
		}
		else if (mbWaterfallsPlayerBehindBulkhead==true && mbWaterfallsAudible==true)
		{
			cLux_AddDebugMessage("Fading waterfall sounds");
			Sound_Fade("waterfall_top_1", 0.0f, 3.0f);
			Sound_Fade("waterfall_top_2", 0.0f, 3.0f);
			Sound_Fade("waterfall_top_3", 0.0f, 3.0f);
			Sound_Fade("waterfall_top_m_1", 0.0f, 1.5f);
			Sound_Fade("waterfall_top_m_2", 0.0f, 1.5f);
			mbWaterfallBulkheadOpen = false;
			mbWaterfallsAudible = false;
		}
		return true;
	}
	
	void SetupEntities()
	{
		//////////////////////////
		// setup entity animations
		Entity_PlayAnimation("alice_body", "alice02_breathing",0,true,true);
		Entity_PlayAnimation("dreamer_2", "stuck_on_wall",0,true,true);
		Entity_PlayAnimation("VictimStrohmeier", "",0,true,true);
		Entity_PlayAnimation("VictimGoya", "stuck_on_wall",0,true,true);
		Entity_PlayAnimation("VictimFrost", "stuck_on_wall",0,true,true);
		Entity_PlayAnimation("mvictim_stading_02", "stuck_on_wall",0,true,true);
		Entity_PlayAnimation("mind_coral_victim01_23", "stuck_on_wall",0,true,true);
		Entity_PlayAnimation("mvictim_stading_01", "stuck_on_wall",0,true,true);
	}
	
	//Determines if player is behind bulkhead
	bool Trigger_BehindBulkheadArea(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState==1)
		{
			mbWaterfallsPlayerBehindBulkhead = true;
			cLux_AddDebugMessage("Player behind bulkhead door is "+mbWaterfallsPlayerBehindBulkhead);
		}
		else
		{
			mbWaterfallsPlayerBehindBulkhead = false;
			cLux_AddDebugMessage("Player behind bulkhead door is "+mbWaterfallsPlayerBehindBulkhead);
		}
		return true;
	}
	
	//Sewer pipes area
	bool StopWaterfallAudioSewer(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1 && mbWaterfallsAudible==true)
		{
			cLux_AddDebugMessage("Fading waterfall sounds");
			
			Sound_Fade("waterfall_top_1", 0.0f, 3.0f);
			Sound_Fade("waterfall_top_2", 0.0f, 3.0f);
			Sound_Fade("waterfall_top_3", 0.0f, 3.0f);
			Sound_Fade("waterfall_top_m_1", 0.0f, 1.0f);
			Sound_Fade("waterfall_top_m_2", 0.0f, 1.0f);
			
			mbWaterfallsAudible = false;
		}
		else
		{
			cLux_AddDebugMessage("Waterfall Stop - nothing to do");
		}
		return true;
	}
	
	bool StartWaterfallAudio_Sewer(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState==1 && mbWaterfallsAudible==false)
		{
			cLux_AddDebugMessage("Starting waterfall sounds");
			
			Sound_Fade("waterfall_top_1", 1.0f, 1.5f);
			Sound_Fade("waterfall_top_2", 1.0f, 1.5f);
			Sound_Fade("waterfall_top_3", 1.0f, 1.5f);
			Sound_Fade("waterfall_top_m_1", 1.0f, 1.5f);
			Sound_Fade("waterfall_top_m_2", 1.0f, 1.5f);
			
			mbWaterfallsAudible = true;
		}
