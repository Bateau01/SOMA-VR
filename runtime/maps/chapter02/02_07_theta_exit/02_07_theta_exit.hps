		// Event: Flush water and get flushed away
		//{//////////////////////////////////////
		
		//-------------------------------------------------------

		void SetupPumpRoom()
		{				
			Lamp_SetLit("HatchLamp_*", false, false);
			Puppet_SetAttackFatal("EndChasePuppet", true);
		}
		
		//------------------------------------------------------
		
		void SetupFlood()
		{
			////////////////////////
			// Tunnel water
			Entity_SetActive("WaterSheet_*",false);
			Entity_SetActive("TunnelFloodWaterArea_*",false);
			Entity_AttachToEntity("WaterSheet_1","TunnelFloodArea","",false,false);
			Entity_AttachToEntity("WaterSheet_2","TunnelFloodArea","",false,false);
			Entity_AttachToEntity("WaterSheet_3","TunnelFloodArea","",false,false);
			Entity_AttachToEntity("TunnelFloodWaterArea_1","TunnelFloodArea","",false,false);
			Entity_AttachToEntity("TunnelFloodPS_1","TunnelFloodArea","",false,false);
			Entity_AttachToEntity("TunnelFloodPS_2","TunnelFloodArea","",false,false);
			Entity_AttachToEntity("TunnelFloodPS_3","TunnelFloodArea","",false,false);
			
			/////////////////////////
			// Room water
			Entity_SetActive("FloorFloodArea",false);
			
			////////////////////////
			// Side tunnel
			Entity_SetActive("SideWaterSheet_*",false);
			Entity_SetActive("SideFloodWaterArea_*",false);
			Entity_AttachToEntity("SideWaterSheet_1","SideFloodArea","",false,false);
			Entity_AttachToEntity("SideWaterSheet_2","SideFloodArea","",false,false);
			Entity_AttachToEntity("SideWaterSheet_3","SideFloodArea","",false,false);
			Entity_AttachToEntity("SideFloodWaterArea_1","SideFloodArea","",false,false);
			Entity_AttachToEntity("SideFloodPS_1","SideFloodArea","",false,false);
			Entity_AttachToEntity("SideFloodPS_2","SideFloodArea","",false,false);
			Entity_AttachToEntity("SideFloodPS_3","SideFloodArea","",false,false);
			
			// Lever
			Entity_SetEffectBaseColor("FloodLeverLamp", cColor(1.0f,0.7f,0.0f,1.0f));
			Lamp_SetupFlicker("FloodLeverLamp",0.5f,0.5f,0.5f,0.5f,true);
		}
		
		//-------------------------------------------------------
		
		void OnFlushLeverStateChange(const tString &in asEntity, int alState)
		{
			if (alState!=1)
				return;
				
			Map_AddTimer("TimerBreakWauFlower",1.5f,"TimerBreakWauFlower");
			
			Entity_SetEffectBaseColor("FloodLeverLamp", cColor(4.0f,0.0f,0.0f,1.0f));
			Lamp_SetupFlicker("FloodLeverLamp",1.0f,1.0f,0.5f,0.5f,true);
				
			SequenceOpenFloodDoor("");
		}
		
		//-------------------------------------------------------
		
		void TimerBreakWauFlower(const tString& in asName)
		{
			// Wau flower fails
			EnergySource_SetEnergy("wau_flower_4",0);
			ParticleSystem_CreateAtEntity("SparksWF", "elec_spark_physics_oneshot.ps", "WauFlowerEffectArea", false);
			Sound_CreateAtEntity("SparksWF", "02_05_theta/amb/spots/small_spark_hallway_falloff", "WauFlowerEffectArea");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceOpenFloodDoor;
		void SequenceOpenFloodDoor(const tString& in asSequence)
		{
			Sequence_Begin("SequenceOpenFloodDoor", mSequenceOpenFloodDoor);
			
			if (Sequence_DoStepAndWait(1.0f))
			{
				Sound_CreateAtEntity("FlushValveOpenBeep", "02_07_theta_exit_a/SFX/flood_sequence/flush_valve_terminal_confirmed", "computer_panel_medium_reboot_prompt_1");
				Sound_CreateAtEntity("FlushValveOpen", "02_07_theta_exit_a/SFX/flood_sequence/flush_valve_open", "Player");
				Sound_CreateAtEntity("DrainingLoop", "02_07_theta_exit_a/SFX/flood_sequence/flush_valve_drain_loop", "DrainingLoopSoundSource", 3.0f, false, 1.0f);
				
				Entity_SetActive("StartEndChaseTrigger_*",true);
				Entity_SetActive("TriggerAkersScream",true);
				Entity_SetActive("EndChasePuppet",true);
				BarkMachine_SetActive("EndChasePuppet", false);
				Puppet_ChangeState_Patrol("EndChasePuppet");
				
				//Preload flooding sounds
				Sound_PreloadGroup("02_07_theta_exit_a/SFX/flood_sequence/breach", true);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				cLux_AddTodoMessage("SOUND: Akers entering tunnel back at the flooded room.");
			}
			else if (Sequence_DoStepAndWait(0.1f))
			{
				///////////////
				// Door fails
				cLux_AddTodoMessage("SOUND: Start grinding noise @DoorFailArea_1 as the door fails");
			}
			else if (Sequence_DoStepAndWait(0.1f))
			{
				///////////////
				// Door sparks 1
				ParticleSystem_CreateAtEntity("SparksPS1", "elec_spark_physics_oneshot.ps", "DoorFailArea_1", false);
				Sound_CreateAtEntity("Sparks", "02_05_theta/amb/spots/small_spark_hallway_falloff", "DoorFailArea_1");
				
			}
			else if (Sequence_DoStepAndWait(2.4f))
			{
				///////////////
				// Door sparks 2
				ParticleSystem_CreateAtEntity("SparksPS2", "elec_spark_physics_oneshot.ps", "DoorFailArea_2", false);
				Sound_CreateAtEntity("Sparks", "02_05_theta/amb/spots/small_spark_hallway_falloff", "DoorFailArea_2");
				
				////////////////
				// Start lights flashing
				cLux_AddDebugMessage("FLOOD: Start flashing lights");
			
				cLux_AddTodoMessage("SOUND: Start siren @FlushPump");			
				
				Lamp_SetLit("HatchLamp_*",true,true);
				Lamp_SetupFlicker("HatchLamp_*",0.5f,0.5f,0.5f,0.5f, false, "Entities_Station/object/siren_alarm/upsilon_blink_louder");
				Lamp_SetFlickerActive("HatchLamp_*",true);
				
			}
			else if (Sequence_DoStepAndWait(1.0f))
			{
				Sound_CreateAtEntity("DoorOpens", "02_07_theta_exit_a/SFX/flood_sequence/flush_door_open_sweet", "TunnelDoor");
				
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				SlideDoor_SetClosed("TunnelDoor",false);
				StartFloodAlarm();
				Sound_FadeGlobalVolume(0.65f, 3.0f, eSoundEntryType_WorldAll);
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerAkersScream(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(mbFloodEventSound==false)
			{
				Sound_CreateAtEntity("AkersScream", "02_07_theta_exit_a/SFX/flood_sequence/akers_scream_sweet", "EndChasePuppet");
			}
			return false;
		}

		//-------------------------------------------------------

		void OnLookAtChaseTrigger(const tString &in asEntity, int alState)
		{
			cLux_AddDebugMessage("Player sees Akers.");
			Depth_Audio_Fear_MediumIntensity();
			Sound_CreateAtEntity("SirenLoopAlarm", "02_07_theta_exit_a/SFX/flood_sequence/flush_valve_siren_loop", "sirensource");
			
			Sequence_StartEndChase("");
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerEndChase(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Player sets too close to the door.");
			Sequence_StartEndChase("");
			return false;
		}

		//-------------------------------------------------------
		
		bool AkersChaseSweet(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(mbFloodEventSound==false)
		{
			Sound_Stop("AkersScream", 2.0f);
			Sound_CreateAtEntity("AkersChasing", "02_07_theta_exit_a/SFX/flood_sequence/akers_chase_sweet", "EndChasePuppet");
		}
		return false;
	}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqEndChase;
		void Sequence_StartEndChase(const tString& in asName="")
		{
			Sequence_Begin("Sequence_StartEndChase", mSeqEndChase);
			
			if (Sequence_DoStepAndWait(3.0f))
			{	
				cLux_AddDebugMessage("Akers starts chasing player!");
				BarkMachine_SetActive("EndChasePuppet", false);
				Entity_SetActive("StartEndChaseTrigger_*",false);
				
				
				Agent_SetSensesActive("EndChasePuppet", true);
			
				AttackMeter_SetAttackerTeleportPosition("");
				AttackMeter_SetAfterDamageCallback("AkersKnocksDownPlayer");
				
				Pathfinder_Track_Add("EndChasePuppet", "PathNodeArea_1"); //Needs a path node to use proper mode!
				Puppet_ChangeState_Hunt("EndChasePuppet");
				Puppet_Hunt_RevealCurrentPlayerPos("EndChasePuppet");
				TimerPuppetChasePlayer("");
											
				//Tense music
				Sound_FadeGlobalVolume(0.65f, 3.0f, eSoundEntryType_World);
				
				Entity_SetActive("TriggerMainFlood_*", true);
				Map_AddTimer("Timer_TriggerMainFlood",4.0f,"Timer_TriggerMainFlood");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerMainFlood(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_RemoveTimer("Timer_TriggerMainFlood");
			Sequence_Flood("");
			return true;
		}
		
		//-------------------------------------------------------
		
		void Timer_TriggerMainFlood(const tString& in asName)
		{
			Entity_SetActive("TriggerMainFlood_*", false);
			Sequence_Flood("");
		}
		
		//-------------------------------------------------------

		void OnAkersDamage(const tString&in asEntityName)
		{
			if (cLux_GetExplorationModeActive() == false)
			{
				Player_SetHealth(0);
				return;
			}
		}
		
		//-----------------------------------------------------
		
		void Timer_ExplorationModeFakeKnockOut(const tString &in asTimer)
		{			
			Entity_SetActive("EndChasePuppet", false);
			Map_RemoveTimer("TimerPuppetChasePlayer");
			
			Map_AddTimer("ForceFloodResumeTimer", 4.f, "Timer_ForceFloodResume");
		}
		
		//------------------------------------------------------
		
		void Timer_ForceFloodResume(const tString &in asTimer)
		{
			Effect_Fade_In(15.f);
			
			cLux_AddDebugMessage("Water hits player!");
			SequenceStates_Resume("Sequence_Flood");
		}
			
		//-------------------------------------------------------
		
		void TimerPuppetChasePlayer(const tString &in asTimer)
		{
			//cLux_AddDebugMessage("UPDATE HUNT!!");
			Puppet_Hunt_RevealCurrentPlayerPos("EndChasePuppet");
			Map_AddTimer(asTimer, 0.2f, "TimerPuppetChasePlayer");
		}
		
		//-------------------------------------------------------
		
		int mlBreathID;
		int mlHeartbeatID;
		int mlShakeID;
		bool mbFloodEventSound = false;
		
		cSequenceStatesData mSequenceFlood;
		void Sequence_Flood(const tString& in asSequence)
		{
			Sequence_Begin("Sequence_Flood", mSequenceFlood);
			
			if (Sequence_DoStepAndWait(0.5f))
			{
				// Start shake
				mlShakeID = Effect_Shake_Start(0.1f, 50.0f, 3.0f, 0.0f);
				
				Effect_Rumble_Start(0.6f, 4, 1, 2.0f);
				
				//End Chase Music
				StopFloodAlarm();
				Music_StopAll(0.05f);
				Sound_FadeGlobalVolume(0.0f, 0.5f, eSoundEntryType_WorldAll);
				Sound_Stop("AkersChasing", 0.5f);
				
				if(mbFloodEventSound==false)
				{
					Sound_CreateAtEntity("FloodEvent", "02_07_theta_exit_a/SFX/flood_sequence/breach/FloodSequence_Breach", "Player");
					mbFloodEventSound = true;
				}
				
			}
			else if (Sequence_DoStepAndPause())
			{
				// Start pump
				int lPumpShake = Effect_Shake_Start(0.005f,10.0f,3.0f,1.0f);
				Effect_Shake_SetSourceEntity(lPumpShake,"FlushPump",3.0f,15.0f);
				
				// Start flood
				Entity_SetActive("WaterSheet_*",true);
				Entity_SetActive("TunnelFloodWaterArea_*",true);
				ParticleSystem_CreateAtEntity("TunnelFloodPS1","tunnel_flood.ps","TunnelFloodPS_1",true);
				ParticleSystem_CreateAtEntity("TunnelFloodPS2","tunnel_flood.ps","TunnelFloodPS_2",true);
				ParticleSystem_CreateAtEntity("TunnelFloodPS3","tunnel_flood.ps","TunnelFloodPS_3",true);
				Area_MoveLinearTo("TunnelFloodArea", "TunnelFloodTarget", 30.0f, 30.0f, 0.0f, false);
			}
			else if (Sequence_DoStepAndPause())	// When main flood hits TunnelFloodTarget (OnTunnelTriggerSideFlood)
			{
				Map_RemoveTimer("TimerPuppetChasePlayer");
				
				Entity_SetActive("SideWaterSheet_*",true);
				Entity_SetActive("SideFloodWaterArea_*",true);
				ParticleSystem_CreateAtEntity("SideFloodPS1","tunnel_flood.ps","SideFloodPS_1",true);
				ParticleSystem_CreateAtEntity("SideFloodPS2","tunnel_flood.ps","SideFloodPS_2",true);
				ParticleSystem_CreateAtEntity("SideFloodPS3","tunnel_flood.ps","SideFloodPS_3",true);
				Area_MoveLinearTo("SideFloodArea", "SideFloodTarget", 30.0f, 30.0f, 0.0f, false);
			}
			else if (Sequence_DoStepAndPause(0.4)) // When side flood hits player (OnWaterHitPlayer)
			{
				cLux_AddDebugMessage("FLOOD: Hit player");
				
				Sound_Stop("FloodEvent", 0.5f);
				Sound_CreateAtEntity("FloodHitsPlayer", "02_07_theta_exit_a/SFX/flood_sequence/breach/FloodSequence_WaterHits", "Player");
				
				Effect_Screen_Start("water_splash_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 0.4f, 0.0f, 0.6f); 
			
				// Kill the shake - we're in the water.
				Effect_Shake_FadeOut(mlShakeID,0.0f);
				
				Effect_Rumble_Start(1.0f,0.5f,0,0.25f);
		
				// The player is panicking from here on in...
				mlHeartbeatID = Emotion_StartHeartbeat(0.75f,0.75f, 1, -1, 1.0f, 1.0f);
				mlBreathID = Emotion_StartBackgroundBreath(eBreathType_Fear,0.5f, 1, -1, 1.0f, 1.0f);
				
				if (Player_GetHealth()>0.7f)
					Player_SetHealth(0.7f);
				
				cLux_AddDebugMessage("Water hit player.");
				
				// Water hit player - suck them down
				AttachPlayerBubbles();
				
				if (cLux_GetExplorationModeActive() == false ||
					cLux_GetExplorationModeActive() && Entity_IsInPlayerFOV("EndChasePuppet") == false)
				{
					Entity_SetActive("EndChasePuppet", false);
				}
				else
				{
					Agent_SetAutoDisableWhenOutOfSightActive("EndChasePuppet", true, 0.5f);
				}
				
				AttackMeter_SetPlayerIsRecovering(false);
				Effect_Fade_Out(0.4f);
			}
			else if (Sequence_DoStepAndWait(1.0f))
			{
				cLux_AddDebugMessage("FLOOD: Flood areas turn on.");
				
				// Turn on proper flood area
				Entity_SetActive("FloorFloodArea",true);
				StartPlayerBubbles();
				ParticleSystem_CreateAtEntity("FlushBubblesPS", "oneshot_waterbubbles_explosion.ps", "FlushBubblesArea", true);

				// Turn off other flood areas
				Entity_SetActive("SideFloodWaterArea_*",false);
				Entity_SetActive("TunnelFloodWaterArea_*",false);
				
				Emotion_StopBackgroundBreath(mlBreathID);
				Emotion_StopHeartbeat(mlHeartbeatID);
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				cLux_AddDebugMessage("FLOOD: Trigger flush sequence.");
				SequenceFlush("");
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerSideFlood(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("OnTriggerSideFlood");
			SequenceStates_Resume("Sequence_Flood");
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnTunnelFloodComplete(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("WaterSheet_*",false);
			ParticleSystem_Destroy("TunnelFloodPS1");
			ParticleSystem_Destroy("TunnelFloodPS2");
			ParticleSystem_Destroy("TunnelFloodPS3");
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnWaterHitPlayer(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Water hits player.");
			SequenceStates_Resume("Sequence_Flood");
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnSideFloodComplete(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("OnSideFloodComplete");
			Entity_SetActive("SideWaterSheet_*",false);
			ParticleSystem_Destroy("SideFloodPS1");
			ParticleSystem_Destroy("SideFloodPS2");
			ParticleSystem_Destroy("SideFloodPS3");
			
			SequenceStates_Resume("Sequence_Flood");
			return false;
		}
		
		
		//-------------------------------------------------------
		
		//} END Event Flush water and get flushed away
		
		/////////////////////////////////////////
		// Event: Travel through water streams
		//{//////////////////////////////////////

	//-------------------------------------------------------

	/*Put any variables that are only used in Scene X, Event X here.*/

	//-------------------------------------------------------

	cSequenceStatesData mSequenceFlush;
	void SequenceFlush(const tString& in asSequence)
	{
		Sequence_Begin("SequenceFlush", mSequenceFlush);
		
		if (Sequence_DoStepAndPause())
		{
			PreloadDeload();
			
			Effect_Fade_Out(0.0f);
			
			Effect_Rumble_Start(0.5f,1.0f,0.5,0.5f);
			
			StartFlushAnim("Flush1", 0.65f, 0.7f);
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			cLux_AddDebugMessage("Flush 1 complete.");
			Effect_Fade_Out(0.0f);
		}
		else if (Sequence_DoStepAndPause())
		{
			StartFlushAnim("Flush2", 0.5f, 0.8f);
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			PreloadFadeGlobal();
			
			cLux_AddDebugMessage("Flush 2 complete.");
			Effect_Fade_Out(0.0f);
		}
		else if (Sequence_DoStepAndPause())
		{
			StartFlushAnim("Flush3", 0.75f, 0.6f);
		}
		else if (Sequence_DoStepAndWait(0.0f))
		{
			cLux_AddDebugMessage("Flush 3 complete.");
			Effect_Fade_Out(0.0f);
		}
		else if (Sequence_DoStepAndWait(1.0f))
		{
			StopPlayerBubbles();
		
			Emotion_StopBackgroundBreath(mlBreathID);
			Emotion_StopHeartbeat(mlHeartbeatID);
		
			cLux_AddDebugMessage("Flush complete.");
			cLux_AddTodoMessage("END OF LEVEL - GO TO NEXT");
			// Temp!
			mbShowingEnd = true;
		}
		else if (Sequence_DoStepAndWait(0.0f))
		{
			PreloadChangeOfMap();
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	// Bunch of similar things happen for each flush, so lets collect them together...
	void StartFlushAnim(const tString&in asName, float afHeartbeatTime, float afFearLevel)
	{
		Effect_Fade_In(1.0f);
		
		// Panicking!
		mlHeartbeatID = Emotion_StartHeartbeat(afHeartbeatTime,0.75f,1, -1, 1.0f, 1.0f);
		mlBreathID = Emotion_StartBackgroundBreath(eBreathType_Fear, afFearLevel, 1, 1.0f, 1.0f);
		
		CameraAnimation_End();
		CameraAnimation_Begin(asName,"", false);
		AttachPlayerBubbles();
		
		cLux_AddTodoMessage("SOUND: Fade in player struggling as carried through through water flow");
	}
	
	//-------------------------------------------------------
	
	bool OnFlushFade(const tString &in asEntity, int alDirection)
	{
		Effect_Fade_Out(1.0f);
		
		Emotion_StopBackgroundBreath(mlBreathID);
		Emotion_StopHeartbeat(mlHeartbeatID);
			
		cLux_AddTodoMessage("SOUND: Fade out player struggling as carried through through water flow");
		Sound_Stop("TEMPFLOOD", 8.0f);
						
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnFlushComplete(const tString &in asEntity, int alDirection)
	{
		SequenceStates_Resume("SequenceFlush");
		return true;
	}
	
	//-------------------------------------------------------
	
	void StartPlayerBubbles()
	{
		ParticleSystem_CreateAtEntity("PlayerBubblesPS", "loop_waterbubbles_large_cloud.ps", "PlayerBubblesArea", true);
	}
	
	//-------------------------------------------------------
	
	void AttachPlayerBubbles()
	{
		CameraAnimation_SetAttachedEntity("PlayerBubblesArea", false, false, false);
	}
	
	//-------------------------------------------------------
	
	void StopPlayerBubbles()
	{
		ParticleSystem_Destroy("PlayerBubblesPS");
		CameraAnimation_RemoveAttachedEntity();
	}
	
	//-------------------------------------------------------
	
	//} END Event Flush water and get flushed away
	
	//-------------------------------------------------------
	
	//} END SCENE 3
 
    /////////////////////////////////////////
    // ==============
    // PRELOAD
    // ==============
    //{//////////////////////////////////////
 
    //-------------------------------------------------------
	
	bool PreloadDisabled(bool abCheckIfPreloading = true)
	{
		if(cLux_ScriptDebugOn())
		{
			cLux_AddDebugMessage("PRELOAD DISABLED!"); 
			
			return true;
		}

		if(abCheckIfPreloading == true && Map_IsPreloading() == false)
			return true;
			
		return false;
	}
	
	//-------------------------------------------------------
	
	void Preload()
	{
		if(PreloadDisabled(false)) return;
		
		Map_Preload("03_01_omicron_outside.hpm", eWorldStreamPriority_Low);
	}
	
	//-------------------------------------------------------
		
	void PreloadChangePrioNormal()
	{
		Map_SetPreloadPriority(eWorldStreamPriority_Normal);
	}
	
	//-------------------------------------------------------
	
	void PreloadDeload()
	{
		if(PreloadDisabled()) return;
		
		Map_Deload("transfer2731");
		Map_SetPreloadPriority(eWorldStreamPriority_High);
	}
	
	//-------------------------------------------------------
	
	void PreloadFadeGlobal()
	{
		if(PreloadDisabled(false)) return;
		
		Map_AddTimer("FadeGlobal", 0, "PreloadTimer");
		Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
	}
	
	//-------------------------------------------------------
	
	void PreloadChangeOfMap()
	{
		if(PreloadDisabled()) 
		{
			PreloadManualChangeMap();
			return;
		}
		
		Map_AddTimer("ChangeMap", 0.6f, "PreloadTimer");
		Map_AddTimer("ChangeMapNotReady", 2, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	
	bool mbGlobalCopyCompleted = false;
	void PreloadTimer(const tString &in asTimer)
	{
		////////////////////////////
		//Preload - Change map globals when possible.
		if(asTimer == "FadeGlobal")
		{
			if(mbGlobalCopyCompleted)
			{
				Map_Preset_Fade("Omicron3.1", 0.1); 
				Map_FadeEnvironmentParticleColor("*", cColor(0.295,0.556,0.59,1.0), 0.1);
				return;
			}
			
			mbGlobalCopyCompleted = Map_CopyGlobalSettings(Map_GetPreloadMap(), 0.4);
			
			Map_AddTimer("FadeGlobal", 0.5, "PreloadTimer");
		}

		////////////////////////////
		//Preload - Change map when possible
		if(asTimer == "ChangeMap")
		{
			if(Map_IsPreloadCompleted())
			{
				Description_SetForceFading(true);
				Map_ChangeMap("03_01_omicron_outside.hpm", "", "transfer2731", "", "");
			}
			else Map_AddTimer("ChangeMap", 0.6f, "PreloadTimer");
		}
		
		if(asTimer == "ChangeMapNotReady")
		{
			Description_Add("02_05_theta_inside", "ScanRoom_Legacy_Loading", 10, false);
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
		}
	}
	
	//-------------------------------------------------------
	
	void PreloadManualChangeMap()
	{
		Map_ChangeMap("03_01_omicron_outside.hpm", "PlayerStartArea_1", "", "");
	}


	//-------------------------------------------------------
	
	//} END PRELOAD
	
