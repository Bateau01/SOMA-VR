	//-------------------------------------------------------

	//-------------------------------------------------------
		
		/////////////////////////////////////////
		// Event: Dreamers
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool OnTriggerVictim(const tString &in asParent, const tString &in asChild, int alState)
		{
			int lUnderscorePos = cString_GetFirstCharPos(asChild,'_');
			tString sVictimName = cString_Sub(asChild,lUnderscorePos+1);
			
			if (alState==1)
			{
				// ===============================
				// Start victim
				// ===============================
				cLux_AddTodoMessage("SOUND: Start 'dreamer nearby' loop @"+sVictimName);
				
				Sound_PreloadGroup("02_07_theta_exit_a/SFX/dreamers/VO_FX", true);
				
				// Start distortion
				int lDistortionID = Effect_VideoDistortion_Start(0.25f, -1.0f, 1.0f, 1.0f);
				Entity_SetVarInt(sVictimName, "DistortionID", lDistortionID);
				
				// Start speech
				Map_AddTimer(sVictimName, cMath_RandRectf(2.0f,4.0f), "TimerVictimTalk");
				
				Entity_SetVarBool(sVictimName, "VictimTalking", true);
				
				if(mbVictimAudioActive==false)
				{
					Sound_CreateAtEntity("DreamerLoop", "02_07_theta_exit_a/SFX/dreamers/loop", sVictimName, 3.0f, false, 1.0f);
					VictimAudio();
				}
			}
			else
			{
				// ===============================
				// Stop victim
				// ===============================
				cLux_AddTodoMessage("SOUND: Stop 'dreamer nearby' loop.");
				
				VictimAudioEnd();
				
				// Stop distortion
				int lDistortionID = Entity_GetVarInt(sVictimName, "DistortionID");
				Effect_VideoDistortion_FadeOut(lDistortionID, 1.0f);
				
				// Stop speech
				Map_RemoveTimer(sVictimName);
				
				Entity_SetVarBool(sVictimName, "VictimTalking", false);
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void TimerVictimTalk(const tString& in asEntity)
		{
			int lTalkLine = Entity_GetVarInt(asEntity, "TalkLine");
			lTalkLine++;
			Entity_SetVarInt(asEntity,"TalkLine",lTalkLine);
			
			tString sSubject = asEntity+"_"+lTalkLine;
			if (!Voice_SubjectExists(sSubject))
				sSubject = asEntity+"_Random";
			

			Voice_SetSource(asEntity, asEntity, 1, 5, true, 0, 110, 400, eLuxVoiceSourceFreqencyFlag_HighPass);
			Voice_Play(sSubject, -1, "OnVictimTalkDone");
			
			if(Sound_Exists("DreamerLoop"))
			{
				Sound_Fade("DreamerLoop", 0.65f, 3.0f);
				if(mbVictimAudioActive==true)
				{
					Sound_FadeGlobalVolume(0.35f, 3.0f, eSoundEntryType_World);
					Sound_FadeGlobalVolume(0.65f, 3.0f, eSoundEntryType_GuiWorld);
				}
				
			}
		}
		
		//-------------------------------------------------------
		
		void OnVictimTalkDone(const tString&in asScene, const tString&in asSubject)
		{
			int lUnderscorePos = cString_GetFirstCharPos(asSubject,'_');
			tString sVictimName = cString_Sub(asSubject,0,lUnderscorePos);
			
			if(Sound_Exists("DreamerLoop"))
			{
				Sound_Fade("DreamerLoop", 1.0f, 3.0f);
				if(mbVictimAudioActive==true)
				{
					Sound_FadeGlobalVolume(0.65f, 3.0f, eSoundEntryType_World);
					Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_GuiWorld);
				}
			}
			
			if (Entity_GetVarBool(sVictimName, "VictimTalking"))
			{
				Map_AddTimer(sVictimName, cMath_RandRectf(2.0f,8.0f), "TimerVictimTalk");
			}
		}
				
		//-------------------------------------------------------
		bool mbVictimAudioActive = false;
		void VictimAudio()
		{
			if(mbVictimAudioActive==false)
			{
				Sound_FadeGlobalVolume(0.65f, cMath_RandRectf(3.f,5.f), eSoundEntryType_WorldAll);
				mbVictimAudioActive = true;
			}
		}
		
		void VictimAudioEnd()
		{
			if(mbVictimAudioActive==true)
			{
				Sound_Stop("DreamerLoop", cMath_RandRectf(3.f,5.f));
				Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_WorldAll);
				mbVictimAudioActive = false;
			}
			
		}
		
		void StateChangeTrainSwitch(const tString &in asEntity, int alState)
		{
			Sound_CreateAtEntity("TrainSwitch", "Entities_Station/object/train/console_switch", asEntity, 0.0f, false, 1.0f);
		}
        
        void StateChangeTrainButton(const tString &in asEntity, int alState)
		{
            Sound_CreateAtEntity("TrainSwitch", "Entities_Station/tech/control_board_pplant_button/interact", asEntity, 0.0f, false, 1.0f);
		}
		
		//-------------------------------------------------------
		//Alice look at stinger
		
		bool AliceLookAtEnable(const tString &in asParent, const tString &in asChild, int alState)
