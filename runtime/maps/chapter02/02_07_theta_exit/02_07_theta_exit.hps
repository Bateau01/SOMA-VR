	// ==============
	// SCENE 3: Escape Through Pipes; Get Flushed Out
	// ==============
	//{//////////////////////////////////////

	//-------------------------------------------------------
	
		/////////////////////////////////////////
		// Event: Enter flooded Tunnel Hub; jump & climb through water
		//{//////////////////////////////////////

		//-------------------------------------------------------

		void SetupPool()
		{
			Prop_SetStaticPhysics("moss_float*",true);
			
			// Turn off main liquid area for speed
			Entity_SetActive("LiquidPool",false);
			
			// Animations on theta doors
			Entity_StopAnimation("theta_gate_inner_layer*");
		}
			
		//-------------------------------------------------------
		
		bool DoorwayShowHidePool(const tString &in asArea, const tString &in asEntity, int alState)
		{	
			Entity_SetActive("LiquidPool",alState==1);
			// Show/hide fog areas which will be reflected in the pool if they're active (ask Marc)
			FogArea_SetVisible("PuppetFogArea_*",(alState==-1));
			Prop_SetStaticPhysics("moss_float*",(alState==-1));
			return true;
		}

		//-------------------------------------------------------

		bool mbFirstTimeInWater = true;
		
		bool OnPlayerHitPool(const tString &in asParent, const tString &in asChild, int alState)
		{
			// Splash as we hit the water
			if (alState==1)
			{
				if (Player_GetVelocity().y < -6.5f)
				{	
					Effect_Rumble_Start(0.7, 1.7, 0,  0.7);
					Sound_PlayGui("Player/liquid/enter_high", 1.0f);
					ParticleSystem_CreateAtEntity("PlayerSplashPS","oneshot_waterbubbles_explosion.ps","player",true);
				}
				// Shut down AI in section 2
				Agent_SetAutoDisableWhenOutOfSightActive("Puppet_*", true, 5);
				
				if (mbFirstTimeInWater)
				{
					// Save after being in the maze
					Map_AddTimer("TimerSaveHitPool",2.0f,"TimerSaveHitPool");
					mbFirstTimeInWater = false;
				}
			}
			else
			{
				ParticleSystem_Destroy("PlayerSplashPS");
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void CameraCollide_Pool(int alState)
		{
			if (alState==1)
			{
				Effect_Screen_Start("water_splash_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 0.1f, 0.7f, 0.7f); 
			}
		}
		
		//-------------------------------------------------------
		
		void TimerSaveHitPool(const tString&in asName)
		{
			Game_AutoSave();
		}

		//-------------------------------------------------------

		bool OnTriggerFixHealth(const tString &in asParent, const tString &in asChild, int alState)
		{
			float fHealthDiff = 0.6f-Player_GetHealth();
			if (fHealthDiff<=0.0f)
				return false;
				
			int lSteps=fHealthDiff/0.1f;
			for(int i=0;i<=lSteps;i++)
			{
				Map_AddTimer("Timer_FixHealth",i*0.5f,"Timer_FixHealth");
			}
			return false;
		}

		//-------------------------------------------------------
		
		void Timer_FixHealth(const tString& in asName)
		{
			cLux_AddDebugMessage("Add health");
			Player_AddHealth(0.1f);
		}
		
