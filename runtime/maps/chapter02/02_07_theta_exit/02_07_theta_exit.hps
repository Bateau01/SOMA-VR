		bool Collide_TriggerStartPuppet1(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Start Puppet 1");
			
			mbSection1Entered = true;
			
			Entity_SetActive("Puppet_1",true);
			Pathfinder_Track_Clear("Puppet_1");
			Pathfinder_Track_Add("Puppet_1", "PathNodeSection1_20",1, 8);
			Pathfinder_Track_Add("Puppet_1", "PathNodeSection1_15",1, 8);
			Pathfinder_Track_Add("Puppet_1", "PathNodeSection1_22",1, 8);
			Pathfinder_Track_Add("Puppet_1", "PathNodeSection1_133",1, 8);
			Pathfinder_Track_Add("Puppet_1", "PathNodeSection1_111",1, 8);
			Pathfinder_Track_Add("Puppet_1", "PathNodeSection1_145",1, 8);
			Pathfinder_Track_Add("Puppet_1", "PathNodeSection1_21",1, 8);
			Pathfinder_Track_Add("Puppet_1", "PathNodeSection1_118",1, 8);
			Pathfinder_Track_Add("Puppet_1", "PathNodeSection1_139",1, 8);
			Pathfinder_Track_Start("Puppet_1",true,1,"");
			
			AttackMeter_SetAttackerTeleportPosition("Spawn_Section1_*");
					
			return false;
		}
		
		bool Collide_TriggerRestartSection1(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState !=1) return true;
			if(mbSection1Entered ==false) return true;
			
			if (Entity_IsActive("Puppet_1")==false)
			{
				cLux_AddDebugMessage("Restarting Puppet1!");
				
				Agent_SetAutoDisableWhenOutOfSightActive("Puppet_*", true, 7);
				Agent_SetAutoDisableWhenOutOfSightActive("Puppet_1", false, 0);
				Entity_SetActive("Puppet_1",true);
				Pathfinder_Track_Start("Puppet_1",true,1,"");
				
				AttackMeter_SetAttackerTeleportPosition("Spawn_Section1_*");
				
				SlideDoor_SetClosed("hatch_3", true);
			}
			else
			{
				cLux_AddDebugMessage("Restarting Puppet1, but puppet already active.");
			}
			return true;
		}
		
		bool Collide_TriggerStopSection1(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState !=1) return true;
			if (Entity_IsActive("Puppet_1"))
			{
				cLux_AddDebugMessage("Stop Puppet1!");
				
				Agent_SetAutoDisableWhenOutOfSightActive("Puppet_1", true, 7);
			}
			
			SlideDoor_SetClosed("hatch_4", true, true);
			
			return true;
		}
		
