	/////////////////////////////////////////
	// ==============
	// SCENE 1: Wake Up Inside Coral
	// ==============
	//{//////////////////////////////////////

	//-------------------------------------------------------

		/////////////////////////////////////////
		// Event: Wake up
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		int mlFadeDistortionID = -1;

		//-------------------------------------------------------
		
		void SetupWakeUp()
		{
			Entity_SetActive("Ashley", true);
			
			Entity_PlayAnimation("SimonArms", "event_escape_coral_infection", 0.0, false, false);
			Entity_SetAnimationPaused("SimonArms", "event_escape_coral_infection");
		}
		
		//-------------------------------------------------------
			
		void StartWakeUp()
		{
			Effect_Fade_Out(0.0f);
			Map_AddTimer("SequenceWakeup", 2.0, "SequenceWakeup");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceWakeup;
		bool mbAwake = false;
		int mlIntroDOF = 0;
		
		void SequenceWakeup(const tString& in asName)
		{
			Sequence_Begin("SequenceWakeup", mSequenceWakeup);
			
			if (Sequence_DoStepAndWait(6.0))
			{
				//DO NOT REMOVE THIS STEP - IT STOPS SEQUENCE FROM GOING OUT OF SYNC ON PS4
				CameraAnimation_Begin("IntroAnimRoom", "", false);
				Sound_PreloadProject("02_07_theta_exit_a");
				
				// Player health to 1.0 no matter what has happened up til this point
				Player_SetHealth(1.0f);
				Player_SetFlashlightActive(false,true);
				Player_SetFlashlightDisabled(true);
				
				Entity_SetActive("SimonDreamHands",true);
			}
			else if (Sequence_DoStepAndWait(13.f))
			{			
				//Fade filter and reset audio from last level
				Music_FadeVolumeMul(1.0, 0.1f);
				
				//Long start for intro drone - to space the difference between the last level
				Sound_CreateAtEntity("IntroDrone", "02_07_theta_exit_a/SFX/intro/drone", "Player");
				
				Wake_SetAsleep(true);
			}
			else if (Sequence_DoStepAndWait(2.5))
			{
				Effect_Fade_In(0);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{			
				mlIntroDOF = Effect_DoF_Start(0, 0.5f, 1.0f, 0.01f);
				Wake_StartWakeup(5.0f);
						
				Voice_Play("WakeUp_1", -1, "VoiceAshleyIllusionOver");
				
				// Conversation hand anim will start here
				Entity_PlayAnimation("SimonDreamHands", "dream_sequence_ashley",0.0,false,false,"");	
			}
			else if (Sequence_DoStepAndWait(24.0f))
			{

			}
			else if (Sequence_DoStepAndWait(0.25f))
			{	
				cLux_AddDebugMessage("resume conversation");
				Effect_ImageTrail_Start(1.5, 0.5, 0.5, 2);
			}
			//changing the timing will knock audio out of sync
			else if (Sequence_DoStepAndWait(4.5f))
			{
				Sound_PreloadGroup("02_07_theta_exit_a/SFX/coral_cocoon/hand_anim", true);
			}
			
			// Explode
			else if (Sequence_DoStepAndWait(0.25f))
			{			
			    // Conversation hand anim will end here
				Effect_Flash_Start(0.25, 0.25, 0.5);
				
				// Player health to 0.75 no matter what has happened up til this point
				Player_SetHealth(0.75f);
			
				Sound_FadeGlobalVolume(1.0f, 2.0f, eSoundEntryType_All);
				Entity_SetActive("Ashley", false);
				Effect_Shake_Start(0.15f,0.5f,0.1f,0.75f);
				Entity_SetActive("SimonDreamHands",false);
				
				Effect_Rumble_Start(0.9, 1.0f,0.0f,0.75f);
			}
			
			else if (Sequence_DoStepAndWait(4.75f))
			{		
				ParticleSystem_CreateAtEntity("ElevatorCrashParticles", "elevator_crash_cloud.ps", "ElevatorCrashPSArea", false);
				ParticleSystem_CreateAtEntity("ElevatorCrashParticles2", "elevator_crash_cloud_blast.ps", "ElevatorCrashPSArea", false);
				CameraAnimation_End();
				Effect_DoF_FadeOut(mlIntroDOF,3.0f);
				CoralBreak_Start();
			}
			
			else if (Sequence_DoStepAndWait(3.0f))
			{
				//Voice removed due to new animation
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				Player_SetFlashlightDisabled(false);
				
				LastOnSoma_SetText("02_07_theta_exit_2");
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void TimerDisplayCounter(const tString &in asTimer)
		{
			cLux_AddDebugMessage("Time: "+(1000-Map_GetTimerTime("Counter")));
			Map_AddTimer("DisplayCounter", 1, "TimerDisplayCounter");
		}
		
		
		//-------------------------------------------------------
		
		void VoiceAshleyIllusionOver(const tString&in asScene, const tString&in asSubject)
		{
			SequenceStates_Resume("SequenceWakeup");
		}
		
		//-------------------------------------------------------
		
		void OnGuiApartmentTV(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_DoImage(cImGuiGfx("urban/tv/00_05_tv_no_disc"),ImGui_NrmPos(cVector3f(0.35,0.2,1.0)),ImGui_NrmSize(cVector2f(0.315,0.5)));
		}

		//-------------------------------------------------------
		
		//} END Event Wake up
		
		/////////////////////////////////////////
		// Event: Get free from Mind Coral
		//{//////////////////////////////////////

		//-------------------------------------------------------

		int mlCoralTrailID = 0;
		int mlCoralDOF = 0;

		void CoralBreak_Start()
		{
			CameraAnimation_Begin("IntroEndAnim", "", false);
			mlCoralTrailID = Effect_ImageTrail_Start(3.0f,0.0f,-1,0.0f);
			mlCoralDOF = Effect_DoF_Start(0, 0.5, 1, 0);
			EyeTracking_SetExtendedViewMul(0.0f);
		}
		
		//-------------------------------------------------------
		
		bool OnBreakCoral(const tString &in asEntity, int alDirection)
		{
			Sound_FadeGlobalVolume(0.45f, 3.0f);
			CameraAnimation_End();
			CoralBreak_PlayAnim();
			CoralBreak_StartParticles();
			Map_AddTimer("CoralRumble0", 0.5f, "Timer_CoralRumbleLongShake");
			Map_AddTimer("CoralRumble1", 7.9f, "Timer_CoralRumbleMedium");
			Map_AddTimer("CoralRumble2", 10.5f, "Timer_CoralRumbleLarge");
			Map_AddTimer("CoralRumble2", 11.6f, "Timer_CoralRumbleMedium");
			return false;
		}
		
		//---------------------------------------------------------------------

		void CoralBreak_StartParticles()
		{
			Map_AddTimer("CoralPSArea_1", 3.3f, "CoralBreak_TimerErupt");
			Map_AddTimer("CoralPSArea_2", 3.8f, "CoralBreak_TimerErupt");
			Map_AddTimer("CoralPSArea_3", 4.5f, "CoralBreak_TimerErupt");
			Map_AddTimer("CoralPSArea_4", 5.5f, "CoralBreak_TimerErupt");
			Map_AddTimer("CoralPSArea_5", 6.3f, "CoralBreak_TimerErupt");
			Map_AddTimer("CoralPSArea_6", 6.7f, "CoralBreak_TimerErupt");
		}
		
		void Timer_CoralRumbleLongShake(const tString&in asTimer)
		{
			Effect_Rumble_Start(0.25, 13, 3, 1);
		}
		
		void Timer_CoralRumbleMedium(const tString&in asTimer)
		{
			Effect_Rumble_Start(0.8, 1, 0, 0.3);
		}
		
		void Timer_CoralRumbleLarge(const tString&in asTimer)
		{
			Effect_Rumble_Start(1.5, 2, 0, 0.3);
		}
		
		//---------------------------------------------------------------------
		
		void CoralBreak_TimerErupt(const tString& in asName)
		{
			ParticleSystem_CreateAtEntity(asName+"_PS", "mindcoral_escape.ps", asName, true);
			Effect_Rumble_Start(0.6, 0.7f, 0.1f, 0.1f);
		}
		
		//---------------------------------------------------------------------
				
		void CoralBreak_PlayAnim()
		{					
			PlayerHands_SetUseCustomPosition(true);
			PlayerHands_SetCustomPositionFromEntity("CoralAnim");
			PlayerHands_SetUseCustomRotation(true);	
			PlayerHands_SetCustomRotationFromEntity("CoralAnim");
			PlayerHands_PlayAnimation("event_escape_coral_infection",false,true,0.0f,"");
			
			Entity_SetActive("SimonArms", false);
			PlayerHands_AttachCameraToSocket("Socket_Camera", 2.0f, "CoralBreak_CameraAttachDone", true,true,1.0f);
		}
		//---------------------------------------------------------------------
		
		void CoralBreak_CameraAttachDone()
		{
			PlayerHands_SetAnimationOverCallback("CoralBreak_HandAnimOver");
			Effect_DoF_FadeOut(mlCoralDOF, 20.0f);
			Effect_ImageTrail_FadeOut(mlCoralTrailID,25.0f);
			Player_Teleport("CoralAnimEnd");
		}
		
		//---------------------------------------------------------------------
		
		void CoralBreak_HandAnimOver(const tString&in asAnim)
		{
			Entity_SetActive("SimonDivingSuit", false);
			Entity_SetActive("CoralBlock_*",true);
			Map_AddTimer("CamBreak_TimerResetPos",5.0f,"CamBreak_TimerResetPos");
			
			Map_AddTimer("SimonCommentBreakOut", 1.0f, "SimonCommentsBreakOut");
			Sound_FadeGlobalVolume(1.0f, 2.5f);
			EyeTracking_SetExtendedViewMul(1.0f);
		}
				
		//---------------------------------------------------------------------
		
		void SimonCommentsBreakOut(const tString &in asTimer)
		{
			Emotion_StartBackgroundBreath(eBreathType_Normal, 0.6f, 3, 8, 0, 3);
		}
		
		//---------------------------------------------------------------------
		
		void CamBreak_TimerResetPos(const tString&in asName)
		{
			PlayerHands_SetUseCustomPosition(false);
			PlayerHands_SetUseCustomRotation(false);	
			
			Game_AutoSave();
		}	

		//-------------------------------------------------------
		
		//} END Event Wake up
		
	//-------------------------------------------------------
	
	//} END SCENE 1
	
