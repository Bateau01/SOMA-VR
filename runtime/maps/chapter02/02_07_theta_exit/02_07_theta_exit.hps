		/////////////////////////////////////////
		// Event: Turn on power station
		//{/////////////////////////////////////

		//-------------------------------------------------------

		bool mbPowerOn = false;
		float mfPowerLevel = 0;
		
		//-------------------------------------------------------

		void SetupPowerStation()
		{
			//////////////////////////
			// Power stations and door
			SlideDoor_SetClosed("PowerDoor_Door",true);
			mbPowerOn=false;
					
			SetDoorPowerOn(false);
			
			//////////////////
			// Lamps
			Lamp_SetLit("PowerLampOff",true,false);
			
			Entity_PlayAnimation("GeneratorFan", "switchoff");
			
			Entity_SetEffectsActive("turbine_huge_1",false,false);
			Entity_SetEffectsActive("Generator_Habitat_9",false,false);
		}
		
		//-------------------------------------------------------
		
		int mlLightLevel = -1;
		float mfPowerLeverVel = 0;
		
		float mfPowerLastStateAmount=0.0f;
		
		void UpdatePowerLevel(float afTimestep)
		{
			float fPowerStateAmount = MovingButton_GetStateAmount("PowerStation");
			float fSlideVel = fPowerStateAmount-mfPowerLastStateAmount;
			mfPowerLastStateAmount = fPowerStateAmount;
			
			fSlideVel*=-25.0f;

			if (fSlideVel>0.0f)	
				mfPowerLevel=cMath_Clamp(mfPowerLevel+fSlideVel*afTimestep, 0.0f, 1.0f);
			
			if ( (mfPowerLevel<1.0f) && (mfPowerLevel>0.0f) )
			{
				mfPowerLevel=cMath_Clamp(mfPowerLevel-0.1f*afTimestep, 0.0f, 1.0f);
			}

			int lLightLevel = cMath_RoundToInt(mfPowerLevel*15.0f);
			if (lLightLevel==mlLightLevel)
				return;
			mlLightLevel = lLightLevel;
			mfPowerLeverVel = fSlideVel;
				
			for (int i=1;i<=15;i++)
			{
				Lamp_SetLit("PowerLamp_"+i, i<=lLightLevel, true);
			}
			
			float fr=1.0f;
			float fg=1.0f;
			
			if (lLightLevel<=8)
			{
				fg = lLightLevel/8.0f;
			}
			if (lLightLevel>=7)
			{
				fr = (15-lLightLevel)/8.0f;
			}
			
			Light_FadeTo("PowerLight", cColor(fr,fg,0.0f),-1,0.1f);
			
			if ((lLightLevel==15) && (!mbPowerOn))
			{
				TurnPowerOn();
			}
			else if ((lLightLevel<8) && (mbPowerOn))
			{
				TurnPowerOff();
			}
		}
		
		//Sound
		bool PowerLevelSound(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Power Level Pulled in direction "+alState);
			if (alState != 1) return true;
			
			if(mfPowerLeverVel>=0.225)
			{
				if(mlLightLevel<=4 && mbPowerOn==false && Map_TimeHasPassed("LowPush", 0.5f))
				{
					Sound_CreateAtEntity("LowPush", "02_07_theta_exit_a/SFX/power_charger/power_charge_pump_small", "PowerStation");
					Sound_CreateAtEntity("LowCharge", "02_07_theta_exit_a/SFX/power_charger/power_clunk_02", "PowerStation");
					Sound_Stop("MediumPush", 0.5f);
					Sound_Stop("HighPush", 0.5f);
					cLux_AddDebugMessage("Low Push Triggered");
				}
				else if(mlLightLevel<=8 && mbPowerOn==false && Map_TimeHasPassed("MediumPush", 0.5f))
				{
					Sound_CreateAtEntity("MediumPush", "02_07_theta_exit_a/SFX/power_charger/power_charge_pump_med", "PowerStation");
					Sound_CreateAtEntity("MediumCharge", "02_07_theta_exit_a/SFX/power_charger/power_clunk_03", "PowerStation");
					Sound_Stop("LowPush", 0.5f);
					Sound_Stop("HighPush", 0.5f);
					cLux_AddDebugMessage("Med Push Triggered");
				}
				else if(mlLightLevel<=16 && mbPowerOn==false && Map_TimeHasPassed("HighPush", 0.5f))
				{
					Sound_CreateAtEntity("HighPush", "02_07_theta_exit_a/SFX/power_charger/power_charge_pump_large", "PowerStation");
					Sound_CreateAtEntity("HighCharge", "02_07_theta_exit_a/SFX/power_charger/power_clunk_04", "PowerStation");
					Sound_Stop("MediumPush", 0.5f);
					Sound_Stop("LowPush", 0.5f);
					cLux_AddDebugMessage("High Push Triggered");
				}	
			}
			return true;
		}	
		
		
		//-------------------------------------------------------

		int mlGeneratorShake = -1;
		
		//-------------------------------------------------------
		
		void TurnPowerOn()
		{
			/////////////////////////
			// Station turned on
			mbPowerOn=true;
			mfPowerLevel=1.0f;
			Sound_CreateAtEntity("GeneratorStart", "02_07_theta_exit_a/SFX/power_charger/generator_powerup", "PowerStation");
			Map_AddTimer("GeneratorShake", 5.0f, "GeneratorLoopSound");
				
			SetDoorPowerOn(true);
			DoorUnlockMusic();
			
			Terminal_ForceCacheUpdate("PowerDoorPanel_Screen");
			
			Entity_PlayAnimation("GeneratorFan", "spin",1.0f,true);

			Entity_SetEffectsActive("turbine_huge_1",true,false);
			Entity_SetEffectsActive("Generator_Habitat_9",true,false);
			
			/////////////
			// Start preloading
			Preload();
		}
		
		void GeneratorLoopSound(const tString &in asTimer)
		{
			Sound_CreateAtEntity("GeneratorStartLoop", "02_07_theta_exit_a/SFX/power_charger/generator_powerup_loop", "PowerStation", 1.0f, true);
			Map_AddTimer("FadeGeneratorLoop", 5.0f, "FadeGeneratorLoop");
		}
		
		void FadeGeneratorLoop(const tString &in asTimer)
		{
			Sound_Fade("GeneratorStartLoop", 0.65f, 15.0f);
		}
		
		//-------------------------------------------------------
		
		void TurnPowerOff()
		{
			////////////////////////
			// Station turned off
			mbPowerOn=false;
			Effect_Shake_FadeOut(mlGeneratorShake,1.0f);
			mlGeneratorShake = 0;
			cLux_AddTodoMessage("SOUND: Generator stops.");
				
			Entity_PlayAnimation("GeneratorFan", "switchoff");
				
			Entity_SetEffectsActive("turbine_huge_1",false,false);
			Entity_SetEffectsActive("Generator_Habitat_9",false,false);
			Entity_SetEffectsActive("strut_open_1",false,false);
			
			SetDoorPowerOn(false);
		}

		//-------------------------------------------------------
		
		void SetDoorPowerOn(bool abState)
		{	
			if (Button_IsLocked("PowerDoor_PanelInside")!=abState)
				return;

			Button_SetLocked("PowerDoor_PanelInside", !abState);
			if (!abState)
			{
				cLux_AddTodoMessage("SOUND: Door powers off @PowerDoor_PanelInside.");
				Map_RemoveTimer("TimerTurnOnDoorLamps");
				
				Lamp_SetLit("ExitLamp_*",false,true);
				
				SlideDoor_SetOpenableByAgent("PowerDoor_Door", false);
			}
			else
			{
				cLux_AddTodoMessage("SOUND: Door powers on @PowerDoor_PanelInside.");
				Map_AddTimer("TimerTurnOnDoorLamps",0.5f,"TimerTurnOnDoorLamps");
				
				Sound_CreateAIEventAtEntity("PowerStation",30.0f,3);
				Lamp_SetLit("ExitLamp_*",true,true);
				
				SlideDoor_SetOpenableByAgent("PowerDoor_Door", true);
			}
		}
		
		//-------------------------------------------------------
		
		void TimerTurnOnDoorLamps(const tString& in asName)
		{
			Lamp_SetLit("ExitLamp_*",true,true);
		}
		
		//-------------------------------------------------------
		
		void OnGuiDoorPowerStatus(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("02_07_theta_exit");
			
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();
			
			cStationGui_BigStatusMessageSettings settings;
			
			if (Button_IsLocked("PowerDoor_PanelInside"))
			{
				settings.mfTextSizeMul = 1.5;
				StationGui_BigStatusMessage("DoorPower_Off", settings);
			}
			else
			{
				settings.mfTextSizeMul = 1.75;
				settings.mColor = gStationGuiColor_Highlight;
				StationGui_BigStatusMessage("DoorPower_On", settings);
			}
		}
		
		//} END Turn on power station
		
