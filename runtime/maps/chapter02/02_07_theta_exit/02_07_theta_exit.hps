	bool EnterHallMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		Music_Play("02_07_entergianthall", 0.75f, false, eMusicPrio_BigEvent);
		Sound_FadeGlobalVolume(0.55f, 4.0f);
		Map_AddTimer("EnterHallFadeUp", 5.0f, "FadeUpSound");
		
		PreloadChangePrioNormal();
		return false;
