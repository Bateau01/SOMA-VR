		//-------------------------------------------------------
	
		int mlSwayCount=0;
		
		bool OnTriggerSwayArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==1)
			{
				cLux_AddDebugMessage("Enter sway area: "+asChild);
				StartSwaySound();
				float fAmount = Entity_GetVarFloat(asChild,"");
				cMatrixf matArea=Map_GetEntity(asChild).GetMatrix().GetRotation().GetTranspose();
				cVector3f vAngles = cMath_MatrixToEulerAngles(matArea);
				float fAngle = cMath_ToDeg(vAngles.y);
				Effect_Sway_FadeIn(fAmount, 1.0f, 1.0f, fAngle,-1.0f,0.25f,0.997f,0.5f);
				mlSwayCount++;

				//if(Platform_IsPS4() == false) //Dof casued problems on PS4 (KISS solution)
				{
					int lDoF = Entity_GetVarInt(asChild,"DoF");
					if(lDoF == 0) lDoF = Effect_DoF_Start(0.0f, 10.0f, 1.0f, 0.25f);

					Entity_SetVarInt(asChild,"DoF",lDoF);
				}
				StartSwaySound();
			}
			else
			{
				cLux_AddDebugMessage("Exit sway area.");
				StopSwaySound();
				mlSwayCount--;
				if (mlSwayCount==0)
				{
					Effect_Sway_FadeOut(1.0f);
				}
				//if(Platform_IsPS4() == false) //Dof casued problems on PS4 (KISS solution)
				{
					int lDoF = Entity_GetVarInt(asChild,"DoF");
					Effect_DoF_FadeOut(lDoF,1.0f);
					Entity_SetVarInt(asChild,"DoF",0);
				}
			}
			return true;
		}
		
		//-------------------------------------------------------
		bool mbSwaySoundActive = false;
		void StartSwaySound()
		{
			if(mbSwaySoundActive==false)
			{
				if(Sound_Exists("ScafCreak")==false)
				{
					Sound_CreateAtEntity("ScafCreak", "02_07_theta_exit_a/amb/spot/scaffolding_creak", "Player", cMath_RandRectf(1.f,3.f), true, 1.0f);
				}
				Map_RemoveTimer("Timer_StopSwaySound");
				mbSwaySoundActive = true;
			}
		}
				
		//-------------------------------------------------------
		
		void StopSwaySound()
		{
			if(mbSwaySoundActive==true)
			{
				Map_AddTimer("Timer_StopSwaySound", cMath_RandRectf(1.f,3.f), "Timer_StopSwaySound");
			}
		}
		
		void Timer_StopSwaySound(const tString &in asTimer)
		{
			Sound_Stop("ScafCreak", 3.0f);
			mbSwaySoundActive = false;
		}
				
