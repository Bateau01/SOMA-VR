	}
	
	bool mbKlaxonActive = false;
	void FloodAlarmRing(const tString &in asTimer)
	{
		Sound_CreateAtEntity("FloodAlarmRinging", "02_07_theta_exit_a/SFX/flood_sequence/flush_valve_alarm_bell", "BellSource");
		
		if(mbKlaxonActive==false)
		{
			Sound_CreateAtEntity("Klaxon", "02_07_theta_exit_a/SFX/flood_sequence/flush_valve_klaxon", "klaxonsource");
			mbKlaxonActive = true;
		}
		
		Map_AddTimer("FloodAlarmRing", 2.5, "FloodAlarmRing");
	}
	
	void StopFloodAlarm()
	{
		Map_RemoveTimer("FloodAlarmRing");
		Sound_Stop("TerminalAlarm", 0.05f);
		Sound_Stop("SirenLoopAlarm", 0.05f);
		Sound_Stop("Klaxon", 0.05f);
	}
	
