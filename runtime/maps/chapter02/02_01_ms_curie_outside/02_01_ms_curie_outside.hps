	//-------------------------------------------------------------------
	
	//Stop music during angry bot encounter
	bool AmbientMusicStop(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbOmniToolLoadingDone==false && alState==1)
		{
			cLux_AddDebugMessage("Enter music stop area");
			Map_AddTimer("StopAmbientMusic", 1.0f, "AmbientMusicHandler");
		}
		else if (mbOmniToolLoadingDone==false && alState==-1)
		{
			cLux_AddDebugMessage("Exit music stop area");
			Map_AddTimer("AmbientExplorationMusic", cMath_RandRectf(9.f, 15.f), "AmbientExplorationMusic");
		}
		return true;
	}
	
