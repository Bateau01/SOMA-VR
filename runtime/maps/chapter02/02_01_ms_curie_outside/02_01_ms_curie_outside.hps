	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// PRELOADING
	//{//////////////////////////////////////

	//-------------------------------------------------------

	bool PreloadDisabled(bool abCheckIfPreloading = true)
	{
		if(cLux_ScriptDebugOn())
		{
			cLux_AddDebugMessage("PRELOAD DISABLED!"); 
			
			return true;
		}

		if(abCheckIfPreloading == true && Map_IsPreloading() == false)
			return true;
			
		return false;
	}
	
	//-------------------------------------------------------
	
	void Preload()
	{
		if(PreloadDisabled(false)) return;
		
		Map_Preload("02_02_ms_curie_inside.hpm", eWorldStreamPriority_Low);
	}
	
	//-------------------------------------------------------
	
	void PreloadSetPrioNormal()
	{
		if(PreloadDisabled()) return;
		
		Map_SetPreloadPriority(eWorldStreamPriority_Normal);
	}

	//-------------------------------------------------------

	void PreloadDeload()
	{
		if(PreloadDisabled()) return;
		
		Map_Deload("Transfer2122");
	}
	
	//-------------------------------------------------------

	void PreloadChangeOfMap()
	{
		if(PreloadDisabled()) 
		{
			PreloadManualChangeMap();
			return;
		}
		
		PreloadDeload();
		
		Map_AddTimer("FadeGlobal", 0, "PreloadTimer");
		Map_AddTimer("ChangePrio", 1, "PreloadTimer");	
		Map_AddTimer("ChangeMap", 3, "PreloadTimer");
		Map_AddTimer("ChangeMapNotReady", 8, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	bool mbGlobalCopyCompleted = false;
	bool mbPreloadNotReadyMsgShown = false;
	
	void PreloadTimer(const tString &in asTimer)
	{
		////////////////////////////
		//Preload - Change map globals when possible.
		if(asTimer == "FadeGlobal")
		{
			if(mbGlobalCopyCompleted)
			{
				Map_AddTimer("FadePreset", 0, "PreloadTimer");
				return;
			}

			mbGlobalCopyCompleted = Map_CopyGlobalSettings(Map_GetPreloadMap(), 0.2);
			
			Map_AddTimer("FadeGlobal", 0.3, "PreloadTimer");
		}

		if(asTimer == "FadePreset")
		{
			Map_Preset_Fade("Inside2.2", 0.2); 
		}
		
		if(asTimer == "ChangePrio")
		{
			Map_SetPreloadPriority(eWorldStreamPriority_High);
		}
		
		////////////////////////////
		//Preload - Change map when possible
		if(asTimer == "ChangeMap")
		{
			if(Map_IsPreloadCompleted())
			{
				Entity_SetActive("slidedoor_cabin_cut_freshx", false);
				Entity_SetActive("CrewQuarterLadderx", false);
				Entity_SetActive("LadderWheelx", false);
				Entity_SetActive("LevelExitx", false);
				
				Description_SetForceFading(true);
				Map_ChangeMap("02_02_ms_curie_inside.hpm", "", "Transfer2122", "", "");
			}
			else Map_AddTimer("ChangeMap", 0.55f, "PreloadTimer");
		}
		
		if(asTimer == "ChangeMapNotReady")
		{
			if(mbPreloadNotReadyMsgShown) return;
			
			Description_Add("02_05_theta_inside", "ScanRoom_Legacy_Loading", 10, false);
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
			
			mbPreloadNotReadyMsgShown = true;
		}
	}
	
	//-------------------------------------------------------
	
	void PreloadNotReadyMessage()
	{
		Map_AddTimer("ChangeMapNotReady", 0, "PreloadTimer");
	}
		
	//-------------------------------------------------------

	void PreloadManualChangeMap()
	{
		Map_ChangeMap("02_02_ms_curie_inside.hpm", "PlayerStartArea_1", "", "");
	}
	
	
	//-------------------------------------------------------
	
	//} END PRELOADING
	
	/////////////////////////////////////////
	// ==============
	// TERMINALS
	// ==============
	//{//////////////////////////////////////

	//-------------------------------------------------------

		/////////////////////////////////////////
		// Comm Terminal
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
			
		void OnCommTerminal(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("01_02_upsilon_inside");
			
			StationGuiBG_Scanlines();
			
			cImGuiGfx imageGfx;
					
			///////////////////////////////////////
			// Contact cam window
			cImGuiWindowData data = StationGui_CreateDefaultWindowData();
			data.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
			data.mFont.mvSize = cVector2f(36, 36);
			data.mFont.mMaterial = eGuiMaterial_FontNormal;
			data.SetPadding(10.0f, 0.0f, 0.0f, 10.0f);

			ImGui_DoWindowStart("ContactID", data, ImGui_NrmPos(cVector3f(0.11f, 0.1f, 1.0f)), ImGui_NrmSize(cVector2f(0.4f, 0.62f)), true);
			{				
				cVector2f vSize;
				cVector3f vPos=ImGui_NrmPosGroup(cVector3f(0.075f, 0.0f, 2.0f));
				
				if (ImGui_RepeatTimer("StaticIndex", 0.1))
				{
					ImGui_SetStateInt("StaticImageIndex", cMath_RandRectl(0, 1));
					ImGui_SetStateInt("AnimationRotation", cMath_RandRectl(0, 1));
				}
				imageGfx.SetFile("static_"+ImGui_GetStateInt("StaticImageIndex", 0)+"");
				imageGfx.mColor = cColor(0.5f, 0.5f, 0.5f, 1.0f);
				vSize = ImGui_NrmSizeGroup(cVector2f(0.8, 0.9f));
				
				ImGui_SetModRotateAngle(ImGui_GetStateInt("AnimationRotation", 0)*180);
				
				ImGui_GroupBegin(vPos, vSize);
				ImGui_DoImage(imageGfx, 0, ImGui_NrmSizeGroup(1));
				ImGui_GroupEnd();
				ImGui_SetModRotateAngle(0);
			}
			StationGui_DoWindowEnd();	
			
			///////////////////////////////////////
			// Com utility window
			data.SetPadding(10.0f,0,0,40.0f);
			ImGui_DoWindowStart("ComUtility", data, ImGui_NrmPos(cVector3f(0.53f, 0.1f, 1.0f)), ImGui_NrmSize(cVector2f(0.36f, 0.7f)), true);
			{
				cImGuiLabelData labelData;
				labelData.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Medium));
				labelData.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.1);
				
				OnGuiCommRoomTerminal_SignalBars();
			
				labelData.mFontAlign = eFontAlign_Center;
				
				tString sCommStation = "CommContact_3";
				if (cScript_GetGlobalVarBool("TalkedToCathInLambda"))
					sCommStation = "CommContact_5";
				ImGui_ResizeFontToFit(ImGui_Translate(sCommStation), labelData.mFont, ImGui_GetCurrentGroupSize().x*0.9);
				ImGui_DoLabelExt(sCommStation, labelData, ImGui_NrmPosGroup(cVector3f(-0.1, 0.51f, 3)), ImGui_NrmSizeGroup(cVector2f(1.1, -1)));
				
				////////////////////////////////////
				//Status button				
				tString sStatus = "";
				cImGuiButtonData buttonData = StationGui_CreateDefaultButtonData();
				buttonData.mbClipText = false;
				buttonData.mbUseInFocusColor = false;
				buttonData.mGfxFrame.mGfxCornerBottomRight.SetFile("stationV2/button/small_corner_bottomright");
				
				buttonData.mColorBase = gStationGuiColor_Highlight;
				buttonData.mColorTriggered = gStationGuiColor_Highlight;
				sStatus = "Online";
			
				ImGui_SetModUseUIPos(false);
				ImGui_ResizeFontToFit(ImGui_Translate(sStatus), buttonData.mFont, ImGui_GetSize().x*0.225);
				ImGui_DoButtonExt("OnlineButton", sStatus, buttonData, ImGui_NrmPos(cVector3f(0.02f, 0.51f, 3)), ImGui_NrmSize(cVector2f(0.25f, 0.08f)));
				ImGui_SetModUseUIPos(true);
			}
			ImGui_DoWindowEnd();
			
			{
				if (ImGui_RepeatTimer("OverlayStaticIndex", 0.15f))
				{
					ImGui_SetStateInt("OverlayStaticImageIndex", cMath_RandRectl(0, 1));
					ImGui_SetStateInt("OverlayAnimationRotation", cMath_RandRectl(0, 1));
				}
				imageGfx.SetFile("static_"+ImGui_GetStateInt("OverlayStaticImageIndex", 0)+"");
				imageGfx.mColor = cColor(0.5f, 0.5f, 0.5f, 1.0f);

				ImGui_SetModRotateAngle(ImGui_GetStateInt("OverlayAnimationRotation", 0)*180);
				ImGui_SetModColorMul(cColor(1,1,1,0.15f));
				ImGui_DoImage(imageGfx, ImGui_NrmPos(cVector3f(0,0,10)), ImGui_NrmSize(cVector2f(1.0f,1.0f)));
				ImGui_SetModRotateAngle(0);
			}
		}
		
		//-------------------------------------------------------
			
		void OnGuiCommRoomTerminal_SignalBars()
		{
			cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
			gauge.mOrientation = eImGuiGaugeOrientation_Vert;
			gauge.mColorBase = gStationGuiColor_Warning;
			
			float fMin = 0.1;
			float fMax = 0.4;
			
			ImGui_LayoutBegin(eImGuiLayout_X, cVector3f(33, 10, 2), ImGui_GetCurrentGroupSize()-cVector2f(80,0), cVector2f(34.0f,0));
			{
				cVector2f vBarSize(30,140);
				
				for (int i = 0; i < 4; i++)
					ImGui_DoGauge(gauge, Depth_ImGui_GetOscillatingSignalValue("COMWindow", i, eEasing_Linear, fMin, fMax), cVector3f_Zero, vBarSize);
			}
			ImGui_LayoutEnd();
		}

		//-------------------------------------------------------
		
		//} END Comm Terminal

		/////////////////////////////////////////
		// Terminal Cloud Computer
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbCloudComputerLoginCompleted=false;
		bool mbCloudComputerLeaveAndNoArkCommentRunning=false;
		int mlCloudComputerLeaveAndNoArkCommentCount=0;
		bool mbCloudComputerInUse=false;
		bool mbCloudComputerFound=false;
		
		//-------------------------------------------------------
		
		
		void OnGuiCloudComputer(const tString&in asEntityName, float afTimeStep)
		{
			if(ImGui_BecameInFocus())
			{
				mbCloudComputerFound=true;
			}
			
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();
			
			///////////
			// Translation setup
			ImGui_SetTransCategory("02_01_ms_curie_outside");
			
			///////////
			// Data
			cImGuiLabelData label = ImGui_GetDefaultLabel();
			label.mFontAlign = eFontAlign_Left;
			ImGui_SetDefaultLabel(label);
			
			///////////
			// Select Current App
			bool bDrawBackButton = true;
			int lBackApp = eCloudTerminalState_MainMenu;
			int lActiveApp = StationGui_GetActiveApp(eCloudTerminalState_Login);
			switch(lActiveApp)
			{
			case eCloudTerminalState_Login:	
				if(OnGuiCloudLoginApp())
				{
					StationGui_SetActiveApp(eCloudTerminalState_MainMenu);
				}
				bDrawBackButton=false;
				break;
				
			case eCloudTerminalState_MainMenu:
				StationGui_AddApp("Interviews");
				StationGui_AddApp("CityPlans");
				StationGui_AddApp("ARKSchematics");
				StationGui_AddApp("Examination");
				StationGui_AddApp("Tracking");
				StationGui_MainMenu();
				bDrawBackButton=false;
				break;
				
			case eCloudTerminalState_Interviews:
				OnGuiInterviewsApp();
				break;
				
			case eCloudTerminalState_CityPlans:
				OnGuiCityPlansApp();
				break;
				
			case eCloudTerminalState_ARKSchematics:
				OnGuiARKSchematicsApp();
				break;
				
			case eCloudTerminalState_Quiz:
				bDrawBackButton = OnGuiQuizApp(afTimeStep);
				break;
				
			case eCloudTerminalState_Tracking:
				OnTrackingApp();
				break;
			}
			
			// Skip drawing the task bar during the quiz to avoid having to resize and rearrange the entire app
			if (lActiveApp != eCloudTerminalState_Quiz || bDrawBackButton)
			{
				StationGuiBG_Taskbar("lambda");
			
				////////////////////////////
				// Back
				if (StationGui_BackButton(bDrawBackButton, lBackApp))
				{
					if(lActiveApp==eCloudTerminalState_Interviews)
						InterviewStopAudio();
					if(lActiveApp==eCloudTerminalState_Tracking)
						TrackingReset();
				}
			}
		}
		
		//-------------------------------------------------------
		
		void CloudComputer_Enter(const tString&in asEntityName)
		{
			if(mbCloudComputerLeaveAndNoArkCommentRunning)
			{
				Map_RemoveTimer("LeaveCloudAndFoundNoARKTalk");
				mbCloudComputerLeaveAndNoArkCommentRunning =false;
			}
			
			mbCloudComputerInUse = true;
		}
				
		void CloudComputer_Leave(const tString&in asEntityName)
		{
			mbCloudComputerInUse = false;
							
			if(mbCloudComputerLoginCompleted==false) return;
			
			if(Map_TimeHasPassed("CloudComputer_Leave", 30)==false) return;
			
			if(mbTrackingDone==false && mbCloudComputerLeaveAndNoArkCommentRunning==false)
			{
				Map_AddTimer("LeaveCloudAndFoundNoARKTalk",cMath_RandRectl(5, 10), "Timer_LeaveCloudAndFoundNoARKTalk");
				mbCloudComputerLeaveAndNoArkCommentRunning = true;
			}
		}
		
		void Timer_LeaveCloudAndFoundNoARKTalk(const tString&in asTimer)
		{
			if(Voice_SceneIsActive("CathAndSimon"))
			{
				Map_RestartCurrentTimer(5);
				return;
			}
						
			Voice_Play("3_Cath_LeaveCloudAndFoundNoARK_"+((mlCloudComputerLeaveAndNoArkCommentCount%3)+1));
			mlCloudComputerLeaveAndNoArkCommentCount++;
			mbCloudComputerLeaveAndNoArkCommentRunning = false;
		} 
			
		
		//-------------------------------------------------------
		
			/////////////////////////////////////////
			// App Cloud Terminal: Login
			//{//////////////////////////////////////

			//-------------------------------------------------------
			
			bool mbLoginLoading = false;
			
			//-------------------------------------------------------
			
			bool OnGuiCloudLoginApp()
			{
				bool bLoggedIn = false;
				
				cGuiDialogBoxSettings dialogBox = StationGui_CreateDefaultDialogBox();
				dialogBox.mfZ = 9.5;
				
				///////////////////////////
				// Loading
				if(mbLoginLoading)
				{
					dialogBox.mType = eGuiDialogBoxType_NoButton;
					dialogBox.mbEndWindow = false;
					
					Depth_ImGui_DialogBox("CloudComputerLoginTitle", "", dialogBox);
			
					bLoggedIn = Depth_ImGui_LoadingGauge("LoginLoading", 5, true, ImGui_NrmPosGroup(cVector3f(0.05, 0.3, 1)), 
																ImGui_NrmSizeGroup(cVector2f(0.9, 0.4)), StationGui_CreateDefaultGaugeData());
																
					ImGui_DoWindowEnd();
					
					if (bLoggedIn)
					{
						mbLoginLoading=false;
						StopArkLoadingSound();
						mbCloudComputerLoginCompleted = true;
					}
				}
				///////////////////////////
				// Input
				else
				{
					dialogBox.mType = eGuiDialogBoxType_OK;
					eGuiDialogCode buttonPressed = Depth_ImGui_DialogBox("CloudComputerLoginTitle", "CloudComputerLoginMessage", dialogBox);
					if (buttonPressed == eGuiDialogCode_OK)
					{
						StartArkLoadingSound();
						mbLoginLoading = true;
					}
				}
				
				return bLoggedIn;
			}
				
			//-------------------------------------------------------
			
			//} END App Cloud Terminal Login
			
		
			/////////////////////////////////////////
			// App Cloud Terminal: Interviews
			//{//////////////////////////////////////

			//-------------------------------------------------------
			
				void InterviewPlayAudio(const tString& in asSubject)
				{
					InterviewStopAudio();
					StationGui_StartVoicePlayback(ImGui_GetName(), asSubject, "SubjectOver_Interview");
				}
						
				void InterviewStopAudio()
				{					
					Depth_ImGui_StopAudioFilePlayback(ImGui_GetName());
				}
				
				void SubjectOver_Interview(const tString&in asScene, const tString&in asSubject)
				{
				}
			
			//-------------------------------------------------------
			
			void OnGuiInterviewsApp()
			{
				Depth_ImGui_CheckAudioFilePlaybackEnd();
				
				/////////////////////
				// Data
				////////////////////
						
				cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
				
				cImGuiLabelData label;
				label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
				ImGui_SetDefaultLabel(label);
						
				
				/////////////////////
				// Variables
				////////////////////
				int lSelection = -1;
							
				/////////////////////
				// File list window
				////////////////////
				
				StationGui_DoWindowStart("Files", windowData, ImGui_NrmPos(cVector3f(0.05, 0.02, 2)), ImGui_NrmSize(cVector2f(0.4, 0.775)), false);
					
					cImGuiButtonData toggleButton = StationGui_CreateToggleButtonData();
					toggleButton.mbClipText = false;
					
					for (int i = 1; i <= 3; i++)
					{
						ImGui_AddItemString("Interview_"+i);
						ImGui_ResizeFontToFit("Interview_"+i, toggleButton.mFont, ImGui_GetCurrentGroupSize().x*0.8);
					}
					
					lSelection = ImGui_DoMultiToggleExt("FileSelection", lSelection, 1,  ImGui_NrmSizeGroup(cVector2f(0, 0.03)), toggleButton,
															ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 0.1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.405)));
																
					if (ImGui_PrevUpdated())
					{
						if (lSelection != -1)
						{
							Depth_Audio_Terminal_Forward(ImGui_GetName());
						}
						InterviewStopAudio();
					}
					ImGui_SetModUseInput(true);
					
				StationGui_DoWindowEnd();
				
				/////////////////////
				// Interviewee
				////////////////////
				if(lSelection>=0)
				{
					tString sName="";
					tString sDate="";
					tString sImage="02_01_cloud_interview_photo_0"+lSelection;
					tString sSubject = "Terminal_InterviewRecording_"+(lSelection+1);
					
					switch(lSelection){
						case 0:		sName="InterviewName_1"; sDate="InterviewDate_1"; break;
						case 1:		sName="InterviewName_2"; sDate="InterviewDate_2"; break;
						case 2:		sName="InterviewName_3"; sDate="InterviewDate_3"; break;
						case 3:		sName="InterviewName_4"; sDate="InterviewDate_4"; break;
					}
					
					StationGui_DoWindowStart("Subject", windowData, ImGui_NrmPos(cVector3f(0.5, 0.02, 2)), ImGui_NrmSize(cVector2f(0.45, 0.775)), false);
						
						cImGuiGfx gfxPhoto = cImGuiGfx(sImage);
						
						cVector2f vPhotoSize = ImGui_GetRatioCorrectSizeByRect(gfxPhoto, ImGui_NrmSizeGroup(0.95, 0.45));
						ImGui_SetAlignment(eImGuiAlign_TopCenter);
						ImGui_DoImage(gfxPhoto, ImGui_NrmPosGroup(cVector3f(0.5, 0.05, 2)), vPhotoSize);
						ImGui_SetAlignment(eImGuiAlign_TopLeft);
											
						ImGui_GroupBegin((cVector3f_Up * vPhotoSize.y) + ImGui_NrmPos(cVector3f(0.025, 0.06, 2)));
							ImGui_LayoutBegin(eImGuiLayout_Y);
								ImGui_DoLabel("Name:");
								ImGui_AddLayoutVerticalSpace(5);
								ImGui_DoLabel("Date:");
							ImGui_LayoutEnd();
							
							ImGui_LayoutBegin(eImGuiLayout_Y, ImGui_NrmPos(cVector3f(0.12, 0,0)));
								ImGui_DoLabel(sName);
								ImGui_AddLayoutVerticalSpace(5);
								ImGui_DoLabel(sDate);
							ImGui_LayoutEnd();
						ImGui_GroupEnd();
						
						ImGui_SetModUISizeVertExpansion(5, 0);
						ImGui_SetTransCategory("GUI");
						bool bPlaybackActive = Depth_ImGui_PlaybackActive();
						if (ImGui_DoButtonExt("StopStartAudioPlayback", bPlaybackActive ? "Stop" : "Play", StationGui_CreateDefaultButtonData(), 
											  ImGui_NrmPos(cVector3f(0.1, 0.55, 2)), ImGui_NrmSize(0.265, 0.1)))
						{	
							if (bPlaybackActive) 		 InterviewStopAudio();
							else				 		 InterviewPlayAudio(sSubject);
						}
						ImGui_SetTransCategory("02_01_ms_curie_outside");
						ImGui_SetModUISizeVertExpansion(0, 0);
									
					StationGui_DoWindowEnd();
				}
			}
			
			//-------------------------------------------------------
			
			//} END App Cloud Terminal
					
			/////////////////////////////////////////
			// App Cloud Terminal: City Plans
			//{//////////////////////////////////////
			
			//-------------------------------------------------------
			
			bool mbCityPlansFirstVisit=true;
			
			void OnGuiCityPlansApp()
			{
				
				/////////////////////
				// Voice
				if(mbCityPlansFirstVisit)
				{
					Voice_Play("3_Cath_CheckCityPlans",-1,"", -2);
					mbCityPlansFirstVisit=false;
				}
				
				Depth_ImGui_AddPhotoFile("02_01_cloud_city_plans_01", eImGuiGfx_Texture, "CityPlanImageDesc_1");
				Depth_ImGui_AddPhotoFile("02_01_cloud_city_plans_02", eImGuiGfx_Texture, "CityPlanImageDesc_2");
				Depth_ImGui_AddPhotoFile("02_01_cloud_city_plans_03", eImGuiGfx_Texture, "CityPlanImageDesc_3");
				StationGui_PhotoViewer("Images", "CityPlansImages");
				
			}
			
			//-------------------------------------------------------
			
			//} END App Cloud Terminal: City Plans
			
			/////////////////////////////////////////
			// App Cloud Terminal: ARK Schematics
			//{//////////////////////////////////////
			
			
			//-------------------------------------------------------
			
			int mlArkSchemCurrentImage=1;
			
			//-------------------------------------------------------
					
			void OnGuiARKSchematicsApp()
			{
				
				Depth_ImGui_AddPhotoFile("02_01_cloud_ark_schematics_01", eImGuiGfx_Texture);
				Depth_ImGui_AddPhotoFile("02_01_cloud_ark_schematics_02", eImGuiGfx_Texture);
				Depth_ImGui_AddPhotoFile("02_01_cloud_ark_schematics_03", eImGuiGfx_Texture);
				Depth_ImGui_AddPhotoFile("02_01_cloud_ark_schematics_04", eImGuiGfx_Texture);
				Depth_ImGui_AddPhotoFile("02_01_cloud_ark_schematics_05", eImGuiGfx_Texture);
				StationGui_PhotoViewer("Images", "SchematicsImages");
				
			}
			
			
			//-------------------------------------------------------
			
			//} END App Cloud Terminal: ARK Schematics
			
			/////////////////////////////////////////
			// App Cloud Terminal: Quiz
			//{//////////////////////////////////////
			
			int mlQuizCurrentQuestion=0;
			int mlQuizSelectedAnswer=0;
			bool mbQuizLoading=false;
			float mfQuizLoadingCount=0;
			bool mbQuizOnStartScreen=true;
			bool mbQuizSaved=false;
			
			//-------------------------------------------------------
			
			bool OnGuiQuizApp(float afTimeStep)
			{
				/////////////////////
				// GUI Data
				cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
				
				cImGuiButtonData buttonData = StationGui_CreateToggleButtonData();
				ImGui_SetDefaultButton(buttonData);
				
				cImGuiTextFrameData textFrame = ImGui_GetDefaultTextFrame();
				textFrame.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
				textFrame.mFontAlign = eFontAlign_Left;
				textFrame.mbUseBackgroundGfx = false;
				textFrame.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.04);
				
				cImGuiLabelData labelData;
				labelData.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
				labelData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.07);
				
				///////////////////////
				// Logic data
				const int lNumOfQuestions = 8;
				int[] vNumOfAnswers = {4,4,4,4,4,4,4,3,4,4};
				
				bool bUseBackButton = false;
				
				///////////////////////////
				// Loading
				if(mbQuizLoading)
				{
					tWString sDots = Depth_ImGui_Effect_AnimatedDots();
					
					ImGui_SetAlignment(eImGuiAlign_CenterLeft);
					
					float fTextWidth = GetFontLengthW(labelData.mFont, 1, ImGui_Translate("Saving")+". . .");
					cVector3f vPos = ImGui_NrmPos(1.0f, 0.5, 2);
					vPos.x = (vPos.x-fTextWidth)*0.5f;
					ImGui_SetTextOverride(ImGui_Translate("Saving")+sDots);
					ImGui_DoLabelExt("",labelData, vPos);
					ImGui_ClearTextOverride();

					mfQuizLoadingCount += afTimeStep;
					if(mfQuizLoadingCount>1.0f)
					{
						mlQuizCurrentQuestion++;
						ImGui_SetFocus("QuizSelect$0");
						mlQuizSelectedAnswer=0;
						mbQuizLoading=false;
					}
				}
				///////////////////////////
				// Start Screen
				else if(mbQuizOnStartScreen)
				{
					StationGui_DoWindowStart("ExaminationAppName", windowData, ImGui_NrmPos(cVector3f(0.05, 0.175, 2)), ImGui_NrmSize(cVector2f(0.9, 0.45)), false);
					
						ImGui_DoTextFrameExt("ExaminationIntro",
											0, 0, 0,textFrame, ImGui_NrmPos(0.025f, 0.025f, 2), ImGui_NrmSizeGroup(0.95, 0.95));
						
					
					StationGui_DoWindowEnd();
					
					if(ImGui_DoButton("QuizStart", "StartExamination", ImGui_NrmPos(0.65, 0.65, 2), ImGui_NrmSize(0.3, 0.1)))
					{
						Depth_Audio_Terminal_Confirm(ImGui_GetName());
						mbQuizOnStartScreen = false;
					}
					
					
					bUseBackButton = true;
				}
				///////////////////////////
				// End Screen
				else if(mlQuizCurrentQuestion>=lNumOfQuestions)
				{
					StationGui_DoWindowStart("Alert", windowData, ImGui_NrmPos(cVector3f(0.05, 0.32, 2)), ImGui_NrmSize(cVector2f(0.9, 0.25)), false);
					
						ImGui_DoTextFrameExt("ExaminationEnd",
											0, 0, 0,textFrame, ImGui_NrmPos(0.025f, 0.025f, 2), ImGui_NrmSizeGroup(0.95, 0.95));
						
					
					StationGui_DoWindowEnd();
					
					if(mbQuizSaved==false)
					{
						mbQuizSaved = true;
					}
					
					bUseBackButton = true;
				}
				///////////////////////////
				// Answers & Questions
				else
				{
					////////////////////////
					// Question
					StationGui_DoWindowStart("Question", windowData, ImGui_NrmPos(cVector3f(0.05, 0.05, 2)), ImGui_NrmSize(cVector2f(0.9, 0.25)), false);
						
						ImGui_DoTextFrameExt("Question_"+mlQuizCurrentQuestion,
											0, 0, 0,textFrame, ImGui_NrmPos(0.025f, 0.025f, 2), ImGui_NrmSizeGroup(0.95, 0.95));
											
					StationGui_DoWindowEnd();
					
					////////////////////////
					// Answer
					StationGui_DoWindowStart("Answers", windowData, ImGui_NrmPos(cVector3f(0.05, 0.32, 2)), ImGui_NrmSize(cVector2f(0.9, 0.5)), false);
					
						int lNumOfAnswers = vNumOfAnswers[mlQuizCurrentQuestion];
						
						ImGui_SetTransCategory("");
						for(int i=0; i<lNumOfAnswers; ++i)
							ImGui_AddItemString(""+(i+1));
						ImGui_SetTransCategory("02_01_ms_curie_outside");
						
						mlQuizSelectedAnswer = ImGui_DoMultiToggle("QuizSelect", mlQuizSelectedAnswer, 1, ImGui_NrmSize(0.03/4.0f)*lNumOfAnswers,
																	ImGui_NrmPos(0.025, 0.025, 2), ImGui_NrmSize(0.098, 0.10*lNumOfAnswers));
																	
						if (ImGui_PrevUpdated() && mlQuizSelectedAnswer != -1)
						{
							Depth_Audio_Terminal_Forward(ImGui_GetName());
						}
																	
						for(int i=0; i<lNumOfAnswers; ++i)
						{
							
							textFrame.mFont.mColor = i==mlQuizSelectedAnswer ? cColor(1,0,0,1) :  cColor(1,1,1,1);
							
							ImGui_DoTextFrameExt("Answer_"+mlQuizCurrentQuestion+"_"+i,
												0, 0, 0,textFrame, ImGui_NrmPos(0.135f, 0.035f + 0.108*i, 2), ImGui_NrmSizeGroup(0.812, 0.95));
						}
						
					StationGui_DoWindowEnd();
					
					////////////////////////
					// Next question
					ImGui_SetAlignment(eImGuiAlign_TopRight);
					ImGui_SetModUISizeHoriExpansion(1.3, 0);
					if(ImGui_DoButton("QuizNextQuestion", "Next Question", ImGui_NrmPos(0.95, 0.85, 2), ImGui_NrmSize(0.45, 0.095f)))
					{
						cScript_SetGlobalVarInt("2_1_QuizAnswer_"+mlQuizCurrentQuestion, mlQuizSelectedAnswer);
						
						Depth_Audio_Terminal_Confirm(ImGui_GetName());
						mbQuizLoading =true;
						mfQuizLoadingCount=0;
						
					}
					
					if (ImGui_ActionTriggered(eImGuiAction_Confirm))
					{
						ImGui_SetFocus("QuizNextQuestion");
					}
				}
				
				
				ImGui_SetAlignment(eImGuiAlign_TopLeft);
				
				return bUseBackButton;
			}
			
			//-------------------------------------------------------
			
			//} END App Cloud Terminal: Quiz
			
			/////////////////////////////////////////
			// App Cloud Terminal: Tracking
			//{//////////////////////////////////////
		
			//-------------------------------------------------------
			
			cVector2l[] mvTrackingCorrectGridCoord = {cVector2l(1,4), cVector2l(3,2), cVector2l(5,2), cVector2l(2,0)};
			
			int mlTrackingCurrentMap=0;
			bool mbTrackingDone=false;
			bool mbTrackingSearchingSector=false;
			bool mbTrackingShowSearchResult=false;
			cVector2l mvTrackingSearchSector;
			bool mbTrackingMapTransition=false;
			bool mbTrackingFirstUsage = true;
			tString msTrackingLastPressedGrid;
			
			//-------------------------------------------------------
					
			void TrackingReset()
			{
				mlTrackingCurrentMap=0;
				mbTrackingSearchingSector=false;
				mbTrackingMapTransition=false;
			}
			
			//-------------------------------------------------------
			
			void OnTrackingApp()
			{
				/////////////////////
				// Voice on first usage
				if(mbTrackingFirstUsage)
				{
					mbTrackingFirstUsage = false;
					Voice_Play("3_Cath_TrackingStarted", -1, "", 1);
				}
				
				/////////////////////
				// GUI Data
				cImGuiTextFrameData textFrame = ImGui_GetDefaultTextFrame();
				textFrame.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
				textFrame.mFontAlign = eFontAlign_Left;
				textFrame.mbUseBackgroundGfx = false;
				textFrame.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.03);
				
				cImGuiButtonData gridButton;
				gridButton.mColorBase = cColor(1,0,0,0.0f);
				gridButton.mColorInFocus = (mbTrackingSearchingSector || mbTrackingMapTransition) ? 
											cColor(0.2,0.2,0.075,0.4f) : cColor(1,1,0,0.5f);
				gridButton.mbUseInFocusColor = true;
				
				cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
				
				cImGuiLabelData labelData;
				labelData.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
				labelData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.07);
				labelData.mFont.mColor = cColor(0.85,0.65,0);
				
				
				cImGuiGfx gfxBlinkSquare;
				
				/////////////////////////////////
				// Tracking Done
				if(mbTrackingDone)
				{
					cImGuiGfx gfxImage = cImGuiGfx("ark_map.dds", eImGuiGfx_Texture);
					ImGui_DoImage(gfxImage, ImGui_NrmPos(-0.2, 0.0, 2.0f), ImGui_NrmSize(1.2,1));
					
					cImGuiGfx gfxOverlay = cImGuiGfx("ark_map_route.dds", eImGuiGfx_Texture);
					cColor col = ImGui_FadeOscillateColor("ArkRouteColor",cColor_White,cColor(1,1,1,0),0.5f);
					ImGui_SetModColorMul(col);
					ImGui_DoImage(gfxOverlay, ImGui_NrmPos(-0.2, 0.0, 3.0f), ImGui_NrmSize(1.2,1));
					ImGui_ResetModifiers();
					
					StationGui_DoWindowStart("Results", windowData, ImGui_NrmPos(cVector3f(0.05, 0.05, 4)), ImGui_NrmSize(cVector2f(0.4, 0.3)), false);
					
						ImGui_DoTextFrameExt("TrackingDone",
											0, 0, 0,textFrame, ImGui_NrmPos(0.025f, 0.025f, 4), ImGui_NrmSizeGroup(0.95, 0.95));
						
					
					StationGui_DoWindowEnd();
				}
				/////////////////////////////////
				// Tracking Board
				else
				{
					/////////////////////////////////
					// Board
					ImGui_GroupBegin(ImGui_NrmPos(0.05,0.05,2), ImGui_NrmSize(0.9, 0.76), true);
					
						if(mbTrackingMapTransition)
						{
							//ImGui_SetModUseInput(false);						
						}
						
						/////////////////////////////////
						// Map
						float fMapT = mbTrackingMapTransition ? ImGui_GetStateFloat("TrackingTransT") : 0;
						
						cImGuiGfx gfxImage = cImGuiGfx("02_01_cloud_tracker_map_"+mlTrackingCurrentMap, eImGuiGfx_Texture);
						gfxImage.mColor = cColor(1,1-fMapT);
						
						ImGui_SetAlignment(eImGuiAlign_CenterCenter);
						ImGui_DoImage(gfxImage, ImGui_NrmPosGroup(0.5, 0.5, 0.1f), ImGui_NrmSizeGroup(1,1)*(1+fMapT*0.5f));
						
						if(mlTrackingCurrentMap==0)
						{
							ImGui_SetTransCategory("");
							
							ImGui_SetModColorMul(cColor(1,1-cMath_Easing(eEasing_ExpoOut,fMapT)));
							ImGui_DoLabelExt("earth", labelData, ImGui_NrmPosGroup(0.2356, 0.69, 2.1f), -1, 0.6f);
							ImGui_DoLabelExt("venus", labelData, ImGui_NrmPosGroup(0.34, 0.185, 2), -1, 0.6f);
							ImGui_DoLabelExt("mercury", labelData, ImGui_NrmPosGroup(0.455, 0.241, 2), -1, 0.6f);
							ImGui_SetModColorMul(cColor(1,1));
							
							ImGui_SetTransCategory("02_01_ms_curie_outside");
						}
						
						if(mlTrackingCurrentMap<3)
						{
							cImGuiGfx gfxNextImage = cImGuiGfx("02_01_cloud_tracker_map_"+(mlTrackingCurrentMap+1), eImGuiGfx_Texture);
							gfxNextImage.mColor = cColor(fMapT,1);
							ImGui_DoImage(gfxNextImage, ImGui_NrmPosGroup(0.5, 0.5, 0), ImGui_NrmSizeGroup(1,1));
						}
						
						ImGui_SetAlignment(eImGuiAlign_TopLeft);
						
						if(mbTrackingMapTransition && ImGui_IsFading("TrackingTransT")==false)
						{
							if(mlTrackingCurrentMap>=3)
							{
								mbTrackingDone = true;
								Map_RemoveTimer("LeaveCloudAndFoundNoARKTalk");
								Map_AddTimer("TrackingIsDoneARKIsFound", 0.3f, "Timer_TrackingIsDoneARKIsFound");
								Sound_CreateAtEntity("ArkTracker_Found", "Entities_Station/tech/terminal_beeps/ark_scanner/ark_scanner_ark_located", "ArkTracker_SoundSource");
							}
							else
							{
								mbTrackingMapTransition=false;
								mlTrackingCurrentMap++;
							}
						}
									
						/////////////////////////////////
						// Lines
						for(int i=0; i<6; ++i) {
							float fY = 0.05f + 0.15f*i;
							ImGui_DrawLine(ImGui_NrmSize(0.05,fY), ImGui_NrmSize(0.95,fY),3, 1.5f, cColor(0.6f,0.5f));
						}
						for(int i=0; i<7; ++i) {
							float fX = 0.05f + 0.15f*i;
							if(i==6) fX-=0.004;
							ImGui_DrawLine(ImGui_NrmSize(fX,0.05), ImGui_NrmSize(fX,0.8),3, 1.5f, cColor(0.6f,0.5f));
						}
						
						/////////////////////////////////
						// Squares
						for(int i=0; i<6; ++i) 
						for(int j=0; j<5; ++j)
						{
							float fX = 0.15f*i;
							float fY = 0.15f*j;
							cVector2l vCoord(i, j);
							
							///////////////////////////
							// Blinking search rect
							if(mbTrackingSearchingSector && vCoord == mvTrackingSearchSector)
							{
								float fA = ImGui_FadeOscillateFloat("TrackingSquareBlink", 0.5,1, 0.3);
								float fT = ImGui_FadeOscillateFloat("TrackingSquareMove", -1,1, 1);
								
								gfxBlinkSquare.mColor = cColor(fA, 0,0,fA);
								ImGui_DoImage(gfxBlinkSquare, ImGui_NrmPos(fX,fY,0.2f),ImGui_NrmSize(0.15, 0.15));
							}
							
							///////////////////////////
							// Button
							bool bPressed = ImGui_DoButtonExt("grid_"+i+"_"+j,"",gridButton, ImGui_NrmPos(fX,fY,0.1f),
																ImGui_NrmSize(0.15, 0.15));
							
							///////////////////////////
							// Pressed actions
							bool bCorrectSector = mvTrackingSearchSector == mvTrackingCorrectGridCoord[mlTrackingCurrentMap];
						
							
							if(bPressed && 
								mbTrackingMapTransition ==false &&
								(mbTrackingSearchingSector==false || 
								 (mbTrackingShowSearchResult && bCorrectSector==false))
							   )
							{
								mbTrackingSearchingSector=false;
								mbTrackingShowSearchResult=false;
								
								mvTrackingSearchSector = vCoord;
								
								msTrackingLastPressedGrid = "grid_"+i+"_"+j;
								
								Sound_CreateAtEntity("ArkTracker_Tracking", "Entities_Station/tech/terminal_beeps/ark_scanner/ark_scanner_scan", "ArkTracker_SoundSource");
								Sound_CreateAtEntity("ArkTracker_Start", "Entities_Station/tech/terminal_beeps/ark_scanner/ark_scanner_button", "ArkTracker_SoundSource");
								cLux_AddTodoMessage("Sound: Tracker searching sound!");
								
								mbTrackingSearchingSector=true;
								
								ImGui_SetStateFloat("TrackingSearchCount",0);
								
								float fGoal = GetTrackingSignalStrength();
								ImGui_FadeStateFloat("TrackingSearchCount", fGoal, fGoal/0.35f, eEasing_Linear);
							}
						}
						
						///////////////////////////
						//Reset mods
						ImGui_SetModUseInput(true);					
									
					ImGui_GroupEnd();
					
					/////////////////////////////////
					// Signal Strength.
					ImGui_GroupBegin(ImGui_NrmPos(0.175,0.775f,0),ImGui_NrmSize(0.71,0.17));
					{
						/////////////////////////////////
						// Base Text
						cImGuiLabelData label;
						
						
						///////////////////////////////////////
						// Idle
						if(mbTrackingSearchingSector==false)
						{
							if(mbTrackingMapTransition==false)
							{
								label.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.25);
								ImGui_DoLabelExt("SelectSearchSector",label, ImGui_NrmPosGroup(0.1,0.2,3));
							}
						}
						///////////////////////////////////////
						// Searching
						else
						{
							/////////////////////////
							// Variables
							bool bCorrectSector = mvTrackingSearchSector == mvTrackingCorrectGridCoord[mlTrackingCurrentMap];
							
							/////////////////////////
							// Top text
							label.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.17);
							
							if(mbTrackingShowSearchResult)
							{
								if(bCorrectSector)
									ImGui_DoLabelExt("GoodSignal",label, ImGui_NrmPosGroup(0.1,0.2,3));
								else
									ImGui_DoLabelExt("BadSignal",label, ImGui_NrmPosGroup(0.1,0.2,3));
								
							}
							else
								ImGui_DoLabelExt("SignalStrength",label, ImGui_NrmPosGroup(0.1,0.2,3));
							
							/////////////////////////
							// Gague Basics
							float fTrackingX = ImGui_GetStateFloat("TrackingSearchCount");
							cImGuiGaugeData gague = StationGui_CreateDefaultGaugeData();
							
							/////////////////////////
							// Gague Color
							if(fTrackingX < 0.1)
								gague.mColorBase = cColor(1,0,0);
							if(fTrackingX < 0.5)
							{
								float fX = (fTrackingX-0.1)/0.4;
								gague.mColorBase = cColor(1,0,0)*(1-fX) + cColor(1,1,0)*fX;
							}
							else if(fTrackingX < 0.95)
							{
								float fX = (fTrackingX-0.5)/0.45;
								fX*=fX;
								gague.mColorBase = cColor(1,1,0)*(1-fX) + cColor(0,1,0)*fX;
							}
							else
								gague.mColorBase = cColor(0,1,0);
								
							if(mbTrackingShowSearchResult)
							{
								gague.mColorBase = gague.mColorBase * ImGui_FadeOscillateFloat("BadSignlBlink", 0.5f, 1, 0.5);
							}
							
							/////////////////////////
							// Gague
							ImGui_DoGauge(gague, fTrackingX, ImGui_NrmPosGroup(0.1,0.4,3), ImGui_NrmSizeGroup(0.8,0.3));
							
							/////////////////////////
							// Signal Result.
							if(mbTrackingShowSearchResult && ImGui_IsFading("TrackingSignalResultCount")==false)
							{
								mbTrackingShowSearchResult=false;
								mbTrackingSearchingSector=false;
								
								if(bCorrectSector)
								{
									mbTrackingMapTransition = true;
									ImGui_SetStateFloat("TrackingTransT", 0);
									ImGui_FadeStateFloat("TrackingTransT", 1, 2);
									Sound_CreateAtEntity("ArkTracker_Zoom", "Entities_Station/tech/terminal_beeps/ark_scanner/ark_scanner_zoom", "ArkTracker_SoundSource");
								}
							}
							/////////////////////////
							// Check if search is done
							else if(mbTrackingShowSearchResult==false && ImGui_IsFading("TrackingSearchCount")==false)
							{
								if(bCorrectSector)
								{
									Sound_Stop("ArkTracker_Tracking", 0.5f);
									Sound_CreateAtEntity("ArkTracker_Correct", "Entities_Station/tech/terminal_beeps/ark_scanner/ark_scanner_signal_located", "ArkTracker_SoundSource");
								}
								///////////////////////////
								// Incorrect coord found
								else
								{
									Sound_Stop("ArkTracker_Tracking", 0.5f);
									Sound_CreateAtEntity("ArkTracker_Failed", "Entities_Station/tech/terminal_beeps/ark_scanner/ark_scanner_negative", "ArkTracker_SoundSource");
								}
								
								mbTrackingShowSearchResult=true;
								ImGui_SetStateFloat("TrackingSignalResultCount", 0);
								ImGui_FadeStateFloat("TrackingSignalResultCount", 1, bCorrectSector ? 3 : 2);
							}
						}
							
						
					}
					ImGui_GroupEnd();
				}
			}
			
			float GetTrackingSignalStrength()
			{
				cVector2l vPos =  mvTrackingSearchSector;
				cVector2l vWanted = mvTrackingCorrectGridCoord[mlTrackingCurrentMap];
				float fDist = cMath_Vector2Dist(cVector2f(vPos.x,vPos.y),cVector2f(vWanted.x, vWanted.y));
							
				if(fDist>0) return cMath_Max(1 - fDist/5.0f, 0.1);
				return 1.0f;
			}
			
			//-------------------------------------------------------
			
			void Timer_TrackingIsDoneARKIsFound(const tString&in asTimer)
			{
				Dialog_Begin();
					Dialog_AddBranch("Main");
						Dialog_AddSubject("3_Cath_TrackingDone_1", "SubjectOver_Cath_TrackingDone");
				Dialog_End();
				
				CathTool_SetHintsEnabled("CathTool_WithChip", false);
			}
			
			void SubjectOver_Cath_TrackingDone(const tString&in asSubject, bool abStartOfSubject)
			{
				if(abStartOfSubject) return;
				
				Map_AddTimer("LeaveTerminalWithARKInfo", 1, "Timer_LeaveTerminalWithARKInfo");
			}
			
			//-------------------------------------------------------
			
			void Timer_LeaveTerminalWithARKInfo(const tString&in asTimer)
			{
				//We keep checking so this is played when the player has left the terminal.
				if(mbCloudComputerInUse)
				{
					Map_RestartCurrentTimer(1);
					return;
				}
				
				Dialog_Begin();
					Dialog_AddBranch("Main");
						Dialog_AddSubject("4_Cath_BackToGetOmniTool_1");
					
						if(mbLifeBoat_HasTriedOmniTool)
						{
							Dialog_AddSubject("4_Cath_BackToGetOmniTool_2_LifeboatFound", "SubjectOver_LeaveTerminalWithARKInfo");
							
							LastOnSoma_SetText("02_01_ms_curie_outside_5");
						}
						else
						{
							Dialog_AddSubject("4_Cath_BackToGetOmniTool_2_NoLifeboat", "SubjectOver_LeaveTerminalWithARKInfo");
							
							LastOnSoma_SetText("02_01_ms_curie_outside_4");
						}
				Dialog_End();
			}
			
			void SubjectOver_LeaveTerminalWithARKInfo(const tString&in asSubject, bool abStartOfSubject)
			{
				if(abStartOfSubject) return;
				
				cLux_AddDebugMessage("SubjectOver_LeaveTerminalWithARKInfo");
				
				Entity_SetActive("Area_NearCathAfterTrackingDone", true);
				Map_AddTimer("ReminderReturnAfterTracking", 10, "Timer_ReminderReturnAfterTracking");
			}	
						
			void Timer_ReminderReturnAfterTracking(const tString&in asTimer)
			{
				Voice_Play("3_Cath_ReminderReturnAfterTracking");
				
				Map_AddTimer("ReminderReturnAfterTracking", cMath_RandRectl(20, 40), "Timer_ReminderReturnAfterTracking");
			}
						
			//-------------------------------------------------------
		
		//} END App Cloud Terminal: Quiz
				
		//-------------------------------------------------------
		
		//} END Terminal Cloud COmputer
		
