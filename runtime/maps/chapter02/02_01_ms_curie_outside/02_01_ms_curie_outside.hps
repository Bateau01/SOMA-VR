			EnergySource_SetEnergy("wau_flower_2", 0);
		}
		
		//-------------------------------------------------------
		
		void DrainedWauFlower2(const tString &in asEntity)
		{
			EnergySource_SetEnergy("wau_flower_1", 0);
		}
		
