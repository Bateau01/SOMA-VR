			mbArkLoadingSound = true;
			Depth_Audio_Terminal_Forward("ArkTracker_SoundSource");
			Sound_CreateAtEntity("ArkLoading", "02_01_ms_curie_outside/SFX/cathbot/ark_locator_loading", "ArkTracker_SoundSource");
