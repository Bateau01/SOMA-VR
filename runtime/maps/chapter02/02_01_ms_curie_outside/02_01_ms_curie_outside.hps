		//-------------------------------------------------------
		
		bool CollideAreaNearCathAfterTrackingDone(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("CollideAreaNearCathAfterTrackingDone");
			
			StopCathSimonBanter();
			Map_RemoveTimer("ReminderReturnAfterTracking");
			Map_AddTimer("BackToPickOmniToolUpTalk", 1, "Timer_BackToPickOmniToolUpTalk");
			
			return false;
		}
		
		void Timer_BackToPickOmniToolUpTalk(const tString&in asTimer)
		{
			cLux_AddDebugMessage("Voice_Play 4_Cath_BackToGetOmniTool_3");
			
			Voice_Play("4_Cath_BackToGetOmniTool_3", -1,"",2);
		}
		
		
		void LineOver_Cath_BackToPickOmniToolUp(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStartOfLine)
		{
			if(abStartOfLine) return;
			
			CathTool_AllowDetach("CathTool_WithChip");
			mbOmniToolInserted = false;

			Map_AddTimer("PickupCathMusic", 1.5f, "PickupCathMusic");
			
			//End ambient music inside room now that Cath is no longer in there
			Entity_SetActive("Area_CathRoom_Music", false);
			Music_Stop(cMath_RandRectf(3.0f, 6.0f), eMusicPrio_BgAmb);
		}
				
		//-------------------------------------------------------
		
		bool CathToolCortexChip_OnPickUp(const tString &in asTool)
		{
			mbCathCanTalk = false;
			Entity_SetActive("ToolArea_OmniToolSlot", false);
			
			Voice_SetCharacterSpeakingCallback("CatherineOmniTool", "");
			
			Preload();
			
			return true;
		}

		//-------------------------------------------------------
		
		//} END Event Back to pick Catherine up
		
		
		//////////////////////////////////////////////////////////////////////////////////
		// Event - Propeller Flesher
		//{//////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------
		
		bool CollideAreaPropellerFlesher(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState!=1) return true;
			if(mbCortexChipInserted==false) return true;
			
			Seq_FlesherPropellerAppearance("");
			
			return false;
		}
		
		cSequenceStatesData mSeqFlesherPropellerAppearance;
		void Seq_FlesherPropellerAppearance(const tString &in asX)
		{
			Sequence_Begin("Seq_FlesherPropellerAppearance", mSeqFlesherPropellerAppearance);
			
			if (Sequence_DoStepAndWait(3))
			{
				Entity_SetActive("AreaPropellerFlesherTooClose", true);
				Entity_SetActive("AreaNearPropellerFlesher", true);

			}
			if (Sequence_DoStepAndWait(3))
			{
				Entity_SetActive("FlesherPropeller_1", true);
                BarkMachine_SetActive("FlesherPropeller_1", false);
				Light_SetBrightness("FlesherPropeller_1_Light", 5.0f);	
				Effect_TimeGlitch_Start(2.0f, 1.0f, 0.3f, true, 0.5f);
				Music_PlayExt("NPC_robotheadgirl_scare3",false, 0.95, 1, 0,0, eMusicPrio_MinorEvent, false);
				Depth_Audio_Fear_HighIntensity();
				FleshProp_MoveWreckFish();
			}
			else if (Sequence_DoStepAndWait(2.5f))
			{
				Entity_SetActive("FlesherPropeller_1", false);	
				Entity_SetActive("FlesherPropeller_2", true);
                BarkMachine_SetActive("FlesherPropeller_2", false);
				Light_SetBrightness("FlesherPropeller_2_Light", 5.0f);
				Light_SetBrightness("FlesherPropeller_1_Light", 0.0f);
				Effect_TimeGlitch_Start(2.0f, 1.0f, 0.45f, true, 0.65f);	
				FleshProp_MoveWreckFish();
			}
			else if (Sequence_DoStepAndWait(4.0f))
			{
				Entity_SetActive("FlesherPropeller_2", false);
				Effect_TimeGlitch_Start(2.0f, 1.0f, 0.6f, true, 0.95f);	
				FleshProp_MoveWreckFish();
				Entity_SetActive("AreaPropellerFlesherTooClose", false);
				Entity_SetActive("AreaNearPropellerFlesher", false);
				Music_PlayExt("NPC_robotheadgirl_scare5",false, 0.95, 1, 0,0, eMusicPrio_BigEvent, false);
			}
			
			Sequence_End();
		}
		
		bool CollideAreaPropellerFlesherTooClose(const tString &in asParent, const tString &in asChild, int alState)
		{
			SequenceStates_Stop("Seq_FlesherPropellerAppearance");
			
			Music_Stop(7, eMusicPrio_BigEvent);
			
			Light_SetBrightness("FlesherPropeller_1_Light", 0.0f);	
			Light_SetBrightness("FlesherPropeller_2_Light", 0.0f);	
			Entity_SetActive("FlesherPropeller_*", false);
			Effect_TimeGlitch_Start(2.0f, 1.0f, 0.6f, true, 0.85f);	
			FleshProp_MoveWreckFish();
			
			return false;
		}
		
		void FleshProp_MoveWreckFish()
		{
			array<iLuxEntity@> vFishes;
			cLux_GetCurrentMap().GetEntityArray("flesher_prop_wreckfish_*", eLuxEntityType_Critter,"",vFishes);
			
			for(int i=0; i<vFishes.size(); ++i)
			{
				iLuxEntity @pEnt = vFishes[i];
				
				pEnt.SetPosition(pEnt.GetPosition()+cMath_RandRectVector3f(cVector3f(-2, -1, -1), cVector3f(2, 1, 1) ));
				
				for(int j=0; j<10; ++j)
					pEnt.VariableUpdate(1.0f);
			}
		}

		//-------------------------------------------------
		
		
		bool CollideAreaNearPropellerFlesher(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("FlesherPropeller", false);	
			Effect_TimeGlitch_Start(1, 1, 0.1, false);
			Sound_PlayGui("Player/UI/time_glitch_louder", 1.0f);
                
			Seq_PropellerFlesherScare("");
			
			return false;
		}
		
		//-------------------------------------------------
		
		cSequenceStatesData mSeqPropellerFlesherScare;
		void Seq_PropellerFlesherScare(const tString &in asX)
		{
			Sequence_Begin("Seq_PropellerFlesherScare", mSeqPropellerFlesherScare);
			
			if (Sequence_DoStepAndWait(5)){
			}
			if (Sequence_DoStepAndWait(3.5f)){
				Effect_VideoDistortion_Start(0.3, 3.5, 1, 1);
			}
			if (Sequence_DoStepAndWait(3.0f)){
				Effect_VideoDistortion_Start(0.5, 3.5, 1, 1);
			}
			if (Sequence_DoStepAndWait(1.5f)){
				Effect_VideoDistortion_Start(0.75, 1, 1, 1);
			}
			if (Sequence_DoStepAndWait(2.0f)){
				Effect_VideoDistortion_Start(1.0, 2, 0.1, 1);
			}
			if (Sequence_DoStepAndWait(0.4f)){
			}
			if (Sequence_DoStepAndWait(0.0f)){
			}
					
			Sequence_End();
		}

		//-------------------------------------------------
		
		//} END event  Propellor Flesher
		
		//////////////////////////////////////////////////////////////////////////////////
		// Event - Open Midsection Door
		//{//////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbOmniToolHasCurieCodes=false;
		
		//-------------------------------------------------------
		
		bool MidsectionPanel_UseOmniTool(const tString &in asTool, const tString &in asEntity)
		{
			if(mbOmniToolHasCurieCodes==false)
			{				
				OmniPanel_AccessDenied("MidsectionPanel");
				
				Map_AddTimer("TimerPlayMidsectionComplaint", 3.0f, "TimerPlayMidsectionComplaint");
			}
			CathTool_UseOnPanel(asTool, asEntity);
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void TimerPlayMidsectionComplaint(const tString& in asName)
		{
			if (!mbSaidLifeboatPiece)
			{
				if (mbEnteredLifeboat && mbCathChipInOmnitool)
					Voice_Play("3_Comment_LeaveLambda_VisitedLifeboat");
				else
					Voice_Play("3_Comment_LeaveLambda_NotVisitedLifeboat");
				mbSaidLifeboatPiece = true;
			}
		}
				
		//-------------------------------------------------------
		
		void OnChange_MidsectionPanel(const tString &in asEntity, int alState)
		{
			if (alState==-1) return;
			
			cLux_AddTodoMessage("Sound: 2 secs of the door unlocking  @ship_entrance_swing_1");
				
			Entity_SetActive("ToolArea_Midsection", false);
				
			Map_AddTimer("MidsectionDoorOpen", 2, "Timer_MidsectionDoorOpen");
		}
		
		void Timer_MidsectionDoorOpen(const tString&in asTimer)
		{
			SlideDoor_SetOpenAmount("ship_entrance_swing_1", 1.0, false);
		}
		
				
		//-------------------------------------------------------
				
		//} END Open Midsection Door
	
		//////////////////////////////////////////////////////////////////////////////////
		// Event - Use OmniTool in LifeBoat
		//{//////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbLifeBoat_OmniToolInserted=false;
		bool mbLifeBoat_StartUpSequenceRunning=false;
		bool mbLifeBoat_HasTriedOmniTool=false;
		bool mbEnteredLifeboat = false;
		
		//-------------------------------------------------------
		
		bool OmniToolSlotLifeBoat_CanUseOmniTool()
		{
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OmniToolSlotLifeBoat_UseOmniTool()
		{
			Voice_SetSource("CatherineOmniTool", "OmniToolSlotLifeBoat", 2, 30, true, 30);
			Sound_PreloadGroup("02_02_ms_curie_inside/SFX/escape_pod", true);
            
			if(mbCortexChipInserted)
			{
				CathTool_Insert("CathTool_WithChip", "OmniToolSlotLifeBoat");
				Entity_SetActive("ToolArea_OmniToolLifeBoat", false);
				
				Map_AddTimer("LifeBoatCathBoot", 0.25f, "Timer_LifeBoatCathBoot");
			}
			else
			{
				CathTool_Insert("CathTool_NoChip", "OmniToolSlotLifeBoat");
				Map_AddTimer("LifeBoatOmniToolErrorEject", 3.5f, "Timer_LifeBoatOmniToolErrorEject");
			}
			
			mbLifeBoat_OmniToolInserted = true;
			mbLifeBoat_HasTriedOmniTool = true;
						
			return true;
		}
		
		//-------------------------------------------------------
		
		void Timer_LifeBoatCathBoot(const tString&in asTimer)
		{
			Dialog_StartConversation("CatherineOmniTool", "Area_LifeboatConvFocus");
			Dialog_Begin();
				Dialog_AddBranchAndSubject("4_Cath_PutIntoLifeBoat_1");
			Dialog_End();
		}
		
		void LineOver_Cath_PutIntoLifeBoat_1(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStartOfLine)
		{
			if(abStartOfLine) return;
			
			Player_ChangeStateToNormal();
			Seq_LifeBoatFailedStartUp("");			
		}
		
		cSequenceStatesData mSeqLifeBoatFailedStartUp;
		void Seq_LifeBoatFailedStartUp(const tString &in asX)
		{
			Sequence_Begin("Seq_LifeBoatFailedStartUp", mSeqLifeBoatFailedStartUp);
			
			if (Sequence_DoStepAndWait(0.5)){
				mbLifeBoat_StartUpSequenceRunning = true;
				Sound_CreateAtEntity("CloseEscapePod", "02_02_ms_curie_inside/SFX/escape_pod/escape_pod_door_close", "EscapePodDoor");
				Lever_SetInteractionDisablesStuck("EscapePodDoor",false);
				Lever_SetAutoMoveTarget("EscapePodDoor",-1);
				Lever_SetAutoMoveEnabled("EscapePodDoor",true);
				Lever_SetStuckState("EscapePodDoor",-1,true);
				// Hack - levers should behave better than this. :(
				Entity_AddForce("EscapePodDoor",cVector3f_One,true,true);
			}
			if (Sequence_DoStepAndWait(0.3)){
				Lamp_SetLit("LifeBoatSideLamp_5", true, true);
			}
			if (Sequence_DoStepAndWait(0.3)){
				Lamp_SetLit("LifeBoatSideLamp_1", true, true);
			}
			if (Sequence_DoStepAndWait(0.3)){
				Lamp_SetLit("LifeBoatSideLamp_2", true, true);
			}
			if (Sequence_DoStepAndWait(0.3)){
				Lamp_SetLit("LifeBoatSideLamp_3", true, true);
			}
			if (Sequence_DoStepAndWait(0.3)){
				Lamp_SetLit("LifeBoatSideLamp_4", true, true);
			}
			if (Sequence_DoStepAndWait(1.0)){
				//Audio
				Sound_CreateAtEntity("PodStart", "02_01_ms_curie_outside/SFX/escape_pod_fail/start", "Player");
				Sound_FadeGlobalVolume(0.4f, 3.5f, eSoundEntryType_WorldAll);
				Map_AddTimer("PodEngineFadeUp", 3.5f, "PodEngineFadeUp");
				Map_AddTimer("PodEngineHeaveSound", 2.0f, "PodEngineHeaveSound");
			}
			if (Sequence_DoStepAndWait(2.0)){
				Lamp_SetFlickerActive("LifeBoatSideLamp_*", true);
				int lId = Effect_Shake_Start(0.005,2, 3.5, 1);
				Effect_Rumble_Start(0.65, 6, 3.5,1);
				Effect_Shake_SetSourceEntity(lId, "ToolArea_OmniToolLifeBoat", 3, 7);
			}
			if (Sequence_DoStepAndWait(2.0)){
				Lamp_SetFlickerActive("LifeBoatSideLamp_*", false);
				Lamp_SetLit("LifeBoatSideLamp_*", false, true);
			}
			if (Sequence_DoStepAndWait(0.0)){
				Voice_Play("4_Cath_PutIntoLifeBoat_2");
				mbLifeBoat_StartUpSequenceRunning = false;
				
				cLux_AddDebugMessage("Release door.");
				Lever_SetInteractionDisablesStuck("EscapePodDoor",true);
				Lever_SetAutoMoveTarget("EscapePodDoor",1);
				Lever_SetAutoMoveEnabled("EscapePodDoor",true);
			}
			
			Sequence_End();
		}
		
		void PodEngineHeaveSound(const tString&in asTimer)
		{
			Sound_CreateAtEntity("PodHeave", "02_01_ms_curie_outside/SFX/escape_pod_fail/explode", "Player");
			Map_AddTimer("PodEngineShake", 3.5f, "PodEngineShake");
		}
		
		void PodEngineShake(const tString&in asTimer)
		{
			Effect_Shake_Start(0.05f, 0.5f, 0.05f, 1.0f);
		}
		
		void PodEngineFadeUp(const tString&in asTimer)
		{
			Sound_FadeGlobalVolume(1.f, 4.5f, eSoundEntryType_WorldAll);
		}

