		//////////////////////////////////////////////////////////////////////////////////
		// Event - Entering curie at top of stairs
		/////////////////////////////////////////////////////////////////////////////////
		
		void InteractCurieDoor(const tString &in asEntity)
		{
			Map_AddTimer("", 0, "TimerExitDoorPush");
		}
		
		//-------------------------------------------------------
		
		void TimerExitDoorPush(const tString &in asTimer)
		{
			Entity_AddForce("LevelExitx", cVector3f(5,0,5), false, true);
			Map_AddTimer("", 0, "TimerExitDoorPush");
		}
		
		//-------------------------------------------------------
		int mlPlayerInCurie = -1;
		bool CollideEnteredCurie(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlPlayerInCurie = alState;
			
			if(mlPlayerInCurie == 1)
			{
				Entity_AddImpulse("LevelExitx", cVector3f(2,0,2), false, true);
				
				if(mlExitClosed == 1) CollideCurieDoorClosed("", "", 1);
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		int mlExitClosed = 1;
		bool CollideCurieDoorClosed(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlExitClosed = alState;
			
		//	cLux_AddDebugMessage("Curie Entrance: "+alState);
			
			if(mlPlayerInCurie != 1) return true;

			SwingDoor_SetLocked("LevelExitx", true, true);
			
			Map_RemoveTimer("TimerExitDoorPush");
			
			PreloadChangeOfMap();
			
			return false;
		}
		
		//-------------------------------------------------------
	
		bool CollisionDebrisLockerOpened(const tString &in asParent, const tString &in asChild, int alState)
		{
			for (int i = 1; Entity_Exists("LockerDebris_" + i); i++)
			{
				Prop_SetStaticPhysics("LockerDebris_" + i, false);
				cVector3f vImpulse = cVector3f(cMath_RandRectf(-0.5f, 0.5f), cMath_RandRectf(-0.5f, 0.5f), -1.f);
				vImpulse.Normalize();
				Entity_AddImpulse("LockerDebris_" + i, vImpulse * 0.3f, false, true);
			}
			
			cScript_SetGlobalVarBool("2.1LockerSceneOccured", true); //Transfer makes this area disabled in 2.2
			
			return false;
		}
		
