    bool mbLifeSupportSoundControl = false;
    bool OnCollideLifeSupportAudioControl(const tString &in asParent, const tString &in asChild, int alState)
    {
        if(alState==1)
        {
            Map_AddTimer("Timer_LifeSupportSoundControl", 0.05f, "Timer_LifeSupportSoundControl");
            mbLifeSupportSoundControl = true;
        }
        else
        {
            Map_RemoveTimer("Timer_LifeSupportSoundControl");
            mbLifeSupportSoundControl = false;
        }
        return true;
    }
    
    void Timer_LifeSupportSoundControl(const tString &in asTimer)
    {
        if(mbLifeSupportSoundControl==true)
        {
            Sound_Stop("lifesupport_oxymixer_1_AnimEvent", 0.05f);
            Sound_Stop("lifesupport_oxymixer_1_motor_sound", 0.05f);
            Map_AddTimer("Timer_LifeSupportSoundControl", 0.05f, "Timer_LifeSupportSoundControl");
        }
        else
        {
          Map_RemoveTimer("Timer_LifeSupportSoundControl");  
        }
        
    }
        
