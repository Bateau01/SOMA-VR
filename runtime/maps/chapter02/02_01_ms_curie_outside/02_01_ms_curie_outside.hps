	bool LamdaMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		Map_AddTimer("StopAmbientMusic", 0.5f, "AmbientMusicHandler");
		Map_AddTimer("LambdaMusic", 3.5f, "LambdaSightingMusic");
		return false;
	}
	
