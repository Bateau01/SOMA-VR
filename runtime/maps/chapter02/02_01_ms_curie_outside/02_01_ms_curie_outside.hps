		//////////////////////////////////////////////////////////////////////////////////
		// Event - Engine - Flesher by engine
		//{///////////////////////////////////////////////////////////////////////////////

		//-------------------------------------------------------
		
		bool CollideAreaActivateFlesherEngine(const tString &in asParent, const tString &in aschild, int alState)
		{
			if(alState != 1) return true;
			
			Entity_SetActive("FlesherEngine_1", true);
            BarkMachine_SetActive("FlesherEngine_1", false);
			Light_SetBrightness("FlesherEngine_1_Light", 5);
			Music_PlayOverlay("NPC_robotheadgirl_sighting3", 0.95f);
			Music_PlayExt("NPC_generic_darkencounter3",true, 0.45, 1, 5,0, eMusicPrio_BigEvent, true);
			
			return false;
		}
		
		//-------------------------------------------------------
		
		bool CollideAreaActivateFlesherAwayFromEngine(const tString &in asParent, const tString &in aschild, int alState)
		{
			if(alState != 1) return true;
			
			cLux_AddDebugMessage("Flesher moving away from engine.");
			
			SequenceFlesherAwayFromEngine("");
			
			return false;
		}
		
		//-------------------------------------------------------
		bool mbFearBreathingFlesherEngine = false;
		void LookAt_FlesherEngine(const tString &in asEntity, int alState)
		{
			cLux_AddDebugMessage("LOOK AT FLESHER ENGINE");
			
			Map_AddTimer("RemoveFlesherEngine", 6, "Timer_RemoveFlesherEngine");
			
			if(mbFearBreathingFlesherEngine==false)
			{
				Depth_Audio_Fear_HighIntensity();
				mbFearBreathingFlesherEngine = true;
			}
		}
		
		int mlLookAtFlesherCount =0;
		void Timer_RemoveFlesherEngine(const tString&in asTimer)
		{
			if(Entity_IsInPlayerFOV("FlesherEngine_1") && mlLookAtFlesherCount<3)
			{
				mlLookAtFlesherCount++;
				Map_AddTimer("RemoveFlesherEngine", 2, "Timer_RemoveFlesherEngine");
				return;
			}
			
			Entity_SetActive("AreaActivateFlesherAwayFromEngine", false);
			Light_SetBrightness("FlesherEngine_1_Light", 0);
			SequenceStates_Stop("SequenceFlesherAwayFromEngine");
			Music_Stop(1.0f, eMusicPrio_BigEvent);
			Entity_SetActive("FlesherEngine_*", false);
			Effect_TimeGlitch_Start(2.0f, 1.0f, 0.3f, true, 0.75f);
			Music_PlayOverlay("NPC_robotheadgirl_scare3", 0.95f);
			FleshEngine_MoveWreckFish();
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mFlesherAwayFromEngine;
			
		void SequenceFlesherAwayFromEngine(const tString &in asX)
		{
			Sequence_Begin("SequenceFlesherAwayFromEngine", mFlesherAwayFromEngine);
			
			if (Sequence_DoStepAndWait(0.7f))
			{
				Map_RemoveTimer("RemoveFlesherEngine");
				
				Light_SetBrightness("FlesherEngine_1_Light", 0);
				Entity_SetActive("FlesherEngine_1", false);
				Entity_SetActive("FlesherEngine_2", true);
                BarkMachine_SetActive("FlesherEngine_2", false);
				Effect_TimeGlitch_Start(2.0f, 1.0f, 0.3f, true, 1.0f);
				Effect_Shake_Start(0.3, 0.7, 0.1, 0.1);
				FleshEngine_MoveWreckFish();
			}
			else if (Sequence_DoStepAndWait(2.7f))
			{
				Entity_SetActive("FlesherEngine_2", false);
				Effect_TimeGlitch_Start(2.0f, 1.0f, 0.3f, true, 0.75f);
				Music_PlayOverlay("NPC_robotheadgirl_scare3", 0.95f);
				Music_Stop(1.0f, eMusicPrio_BigEvent);
				FleshEngine_MoveWreckFish();
			}
			
			Sequence_End();
		}
		
		void FleshEngine_MoveWreckFish()
		{
			array<iLuxEntity@> vFishes;
			cLux_GetCurrentMap().GetEntityArray("FlesherEngine_ray_*", eLuxEntityType_Critter,"",vFishes);
			
			for(int i=0; i<vFishes.size(); ++i)
			{
				iLuxEntity @pEnt = vFishes[i];
				
				pEnt.SetPosition(pEnt.GetPosition()+cMath_RandRectVector3f(cVector3f(-2, -2, -1), cVector3f(2, 1, 1) ));
				
				for(int j=0; j<10; ++j)
					pEnt.VariableUpdate(1.0f);
			}
		}
		
		//-------------------------------------------------------
		
		//} END Event Engine Flesher
	
