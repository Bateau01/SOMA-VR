		//////////////////////////////////////////////////////////////////////////////////
		// Event - Simon and Cath Banter
		//{///////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqCathSimonBanter;
		void Seq_CathSimonBanter(const tString &in asX)
		{
			Sequence_Begin("Seq_CathSimonBanter", mSeqCathSimonBanter);
			
			if (Sequence_DoStepAndWait(3)){
			}
			else if (Sequence_DoStepAndWait(2)){
				Button_SetLocked("ComputerRoom_Door_1_Panel_2", false);
				Button_SetLocked("StorageRoom_Door_1_Panel_1", false);
		
				Voice_PlayWhenPossible("3_Cath_BanterWithSimon_1");
			}
			else if (Sequence_DoStepAndWait(27)){
			}
			else if (Sequence_DoStepAndWait(30)){
				Voice_PlayWhenPossible("3_Cath_BanterWithSimon_2");
			}
			else if (Sequence_DoStepAndWait(60)){
				Voice_PlayWhenPossible("3_Cath_BanterWithSimon_3");
			}
			else if (Sequence_DoStepAndWait(30)){
				Voice_PlayWhenPossible("3_Cath_BanterWithSimon_4");
			}
			else if (Sequence_DoStepAndWait(60)){
				Voice_PlayWhenPossible("3_Cath_BanterWithSimon_5");
			}
			else if (Sequence_DoStepAndWait(30)){
				Voice_PlayWhenPossible("3_Cath_BanterWithSimon_6");
			}
			
			Sequence_End();
		}
		
		void Timer_CathSimonBanterController(const tString&in asTimer)
		{
			int lPlayerState = cLux_GetPlayer().GetCurrentStateId();
			
			if(mbCathSimonBanterPaused)
			{
				Map_RestartCurrentTimer();
				return;
			}	
			
			if(	Voice_SceneIsActive("CathAndSimon") || 
				Voice_SceneIsActive("Terminal") ||
				lPlayerState == ePlayerState_Terminal ||
				lPlayerState == ePlayerState_Read
				)
			{
				if(Voice_SceneIsActive("Terminal")) Voice_Stop("CathAndSimon");
				
				SequenceStates_Pause("Seq_CathSimonBanter");
			}
			else
			{
				SequenceStates_Resume("Seq_CathSimonBanter");
			}
			
			
			Map_RestartCurrentTimer();
		}
		
		//-------------------------------------------------------
		
		bool mbCathSimonBanterPaused=false;
				
		void SetCathSimonBanterPaused(bool abX)
		{
			mbCathSimonBanterPaused = abX;
			if(abX)
			{
				SequenceStates_Pause("Seq_CathSimonBanter");
			}
			else
			{
				SequenceStates_Resume("Seq_CathSimonBanter");
			}
		}
		
		void StopCathSimonBanter()
		{
			Map_RemoveTimer("CathSimonBanterController");
			SequenceStates_Stop("Seq_CathSimonBanter");
		}
		
		//-------------------------------------------------------
		
		//} END Event Simon and Cath Banter
	
		
		//////////////////////////////////////////////////////////////////////////////////
		// Event - Flesher Footstepsa
		//{///////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool CollideAreaFlesherFootStepsHeard(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Enter footstep area: "+alState);
			
			if(Voice_AnySceneIsActive() || alState!=1)
			{
				return true;
			}
				
			Seq_FlesherFootSteps("");		
						
			return false;
		}
		
		cSequenceStatesData mSeqFlesherFootSteps;
		void Seq_FlesherFootSteps(const tString &in asX)
		{
			Sequence_Begin("Seq_FlesherFootSteps", mSeqFlesherFootSteps);
			
			if (Sequence_DoStepAndWait(1.0f)){
				SetCathSimonBanterPaused(true);
				
				cLux_AddTodoMessage("Sound: Some flesher footsteps @Area_FlesherFootStepSource");
				Sound_CreateAtEntity("FlesherReturnEvent", "02_01_ms_curie_outside/SFX/lambda_flesher/crash_spot/flesher_crash_spot", "Area_FlesherFootStepSource");
				Map_AddTimer("FlesherStepsLoopSound", 4.0f, "StartFlesherStepsLoopSound");
			}
			else if(Sequence_DoStepAndWait(1.5f)){
				Depth_Audio_Fear_MediumIntensity();
				Effect_VideoDistortion_Start(0.5, 3, 2, 3, 1);
				Entity_SetActive("Area_FlesherStepsEnd_*", true);
			}
			else if(Sequence_DoStepAndPause()){
				if (mbCathCanTalk)
				{
					if(mbPlayerWasHurt)
						Voice_Play("3_Cath_HearFootSteps_WasHurt");
					else
						Voice_Play("3_Cath_HearFootSteps_WasUnhurt");
				}
			}
			else if(Sequence_DoStepAndWait(2.0f)){
				//Slight pause after end trigger hit
			}
			else if (Sequence_DoStepAndWait(1.0f)){
				Depth_Audio_Fear_MediumIntensity(4.0f, 8.0f, 2, true, true);
				Sound_Stop("FlesherStepsLoop", 0.1f);
				Effect_TimeGlitch_Start(1, 1, 0.1, false);
                Sound_PlayGui("Player/UI/time_glitch_louder", 1.0f);
                
				Effect_VideoDistortion_Start(0.2, 1, 1, 1, 1);
			}
			else if(Sequence_DoStepAndWait(2.0f)){
			}
			else if(Sequence_DoStepAndWait(10.0f)){
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				SetCathSimonBanterPaused(false);
			}
						
			Sequence_End();
		}
		
		bool FlesherFootstepsEnd(const tString &in asParent, const tString &in asChild, int alState)
		{
			//removing timer incase it hasn't finished before player hits trigger, otherwise sound would be stuck looping
			Map_RemoveTimer("FlesherStepsLoopSound");
			SequenceStates_Resume("Seq_FlesherFootSteps");
			Entity_SetActive("Area_FlesherStepsEnd_*", false);
			return false;
		}
		
		void StartFlesherStepsLoopSound(const tString&in asTimer)
		{
			Sound_CreateAtEntity("FlesherStepsLoop", "02_01_ms_curie_outside/SFX/lambda_flesher/crash_spot/lambda_flesher_loop", "Area_FlesherFootStepSource");
		}

		
		//-------------------------------------------------------
		
		//} END Flesher Footsteps
		
		//////////////////////////////////////////////////////////////////////////////////
		// Event - Glass Pounder
		//{///////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbGlassPoundFirstCrash = true;
		int mlGlassPoundCount=0;
		
		//-------------------------------------------------------
				
		bool CollideAreaGlassPounder(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(Voice_AnySceneIsActive() || alState!=1)
			{
				return true;
			}
			
			Billboard_SetVisible("RobotAngryGlassPound_Billboard_1", false);
			Entity_SetActive("RobotAngryGlassPound", true);
			ConstructWorker_SetMoveSoundsActive("RobotAngryGlassPound", false);
			BarkMachine_SetActive("RobotAngryGlassPound",false);
			Entity_SetEffectsActive("RobotAngryGlassPound", false, false);
			
			Pathfinder_Track_Add("RobotAngryGlassPound", "PathNodeArea_435");
			Pathfinder_Track_Start("RobotAngryGlassPound");
			
			Map_AddTimer("GlassPoundRobotAppear", 1, "Timer_GlassPoundRobotAppear");
			
			Entity_SetActive("Area_RemoveGlassPound_*", true);
			
			SetCathSimonBanterPaused(true);
			
			return false;
		}
		
		void Timer_GlassPoundRobotAppear(const tString&in asTimer)
		{
			Entity_SetEffectsActive("RobotAngryGlassPound", true, true);
			ConstructWorker_SetSpeedState_Dash("RobotAngryGlassPound");
		}
		
		//-------------------------------------------------------
				
		int mlWindowState = 1;
			
		bool CollideAreaRobotHitGlass(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(mbGlassPoundFirstCrash)
			{
				mbGlassPoundFirstCrash = false;
				ConstructWorker_SetIdleMode_HeadPound("RobotAngryGlassPound");
				
				Sound_CreateAtEntity("GlassBang", "02_01_ms_curie_outside/SFX/construct_headbang/first_bang", "AreaRobotHitGlass");
				
				if (mbCathCanTalk)
					Map_AddTimer("GlassPoundVoiceResponse",2, "Timer_GlassPoundVoiceResponse");
			}
			else if(alState==1)
			{
				Sound_CreateAtEntity("GlassBang", "02_01_ms_curie_outside/SFX/construct_headbang/bang", "AreaRobotHitGlass");
			}
			
			if (alState==1)
			{
				mlWindowState++;
				if (Entity_Exists("BreakingWindow_"+mlWindowState))
				{
					Entity_SetActive("BreakingWindow_"+(mlWindowState-1), false);
					Entity_SetActive("BreakingWindow_"+mlWindowState, true);
					Sound_CreateAtEntity("GlassBangCrack", "02_01_ms_curie_outside/SFX/construct_headbang/glass_crack", "AreaRobotHitGlass");
				}
				else
				{
					Entity_FadeEffectBaseColor("RobotAngryGlassPound", cColor(0,0), 2);
					Agent_SetSensesActive("RobotAngryGlassPound",false);
					CharMover_SetWallAvoidanceActive("RobotAngryGlassPound", false);
					ConstructWorker_SetSpeedState_Wander("RobotAngryGlassPound");
					
					ConstructWorker_SetIdleMode_Normal("RobotAngryGlassPound");
					Pathfinder_Track_Clear("RobotAngryGlassPound");
					Pathfinder_Track_Add("RobotAngryGlassPound", "PathNodeArea_430", 2);
					Pathfinder_Track_Add("RobotAngryGlassPound", "PathNodeArea_469");
					Pathfinder_Track_Start("RobotAngryGlassPound", false, 0.1f, "RobotAngryGlassPound_EndOfTrackRemove");
				}
			}
			
			return true;
		}
		
		void RobotAngryGlassPound_EndOfTrackRemove(const tString& in asEntityName)
		{
			Entity_SetActive("RobotAngryGlassPound", false);
			SetCathSimonBanterPaused(false);
		}
		
		
		
		void Timer_GlassPoundVoiceResponse(const tString&in asTimer)
		{
			if(mbPlayerWasHurt)
				Voice_Play("3_Cath_GlassPoundResponse_Hurt");
			else
				Voice_Play("3_Cath_GlassPoundResponse_Unhurt");
		}
		
		//-------------------------------------------------------
		
		bool CollideArea_RemoveGlassPound(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("RobotAngryGlassPound", false);
			Entity_SetActive("Area_RemoveGlassPound_*", false);
			SetCathSimonBanterPaused(false);
			
			return true;
		}
		
		//-------------------------------------------------------
		
		
		//} END Glass Pounder
			
