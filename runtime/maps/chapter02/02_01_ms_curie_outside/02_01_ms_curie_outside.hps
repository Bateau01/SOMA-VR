		//////////////////////////////////////////////////////////////////////////////////
		// Event - Mild Tremor with Debris (Halfway up the Tower)
		//{///////////////////////////////////////////////////////////////////////////////
		
		//-------------------------------------------------------

		bool Collide_Tremor_1(const tString &in asParent, const tString &in asChild, int alState)
		{
			SequenceCurieTremorClimb("");
			return false;	
		}
		
		cSequenceStatesData mCurieTremorClimbSequence;
			
		void SequenceCurieTremorClimb(const tString &in asX)
		{
			Sequence_Begin("SequenceCurieTremorClimb", mCurieTremorClimbSequence);
			
			if (Sequence_DoStepAndWait(0.3))
			{
				Sound_CreateAtEntity("Tremor", "02_01_ms_curie_outside/SFX/Curie/Tremor/climb", "Player");
				Sound_FadeGlobalVolume(0.65, 3.0f, eSoundEntryType_WorldClean);
			}
			
			else if (Sequence_DoStepAndWait(2.3))
			{
				Effect_Shake_Start(0.0075, 0.5f, 0.05f, 1.25f);
				Depth_Audio_Fear_MediumIntensity(5.0f);
			}
			
			else if (Sequence_DoStepAndWait(1.0))
			{
				Sound_FadeGlobalVolume(1.0, 3.0f, eSoundEntryType_WorldClean);
				Player_SetMoveSpeedMul(0.7);
				Effect_Shake_Start(0.005, 0.5f, 1.0f, 3.0f);
				
				ParticleSystem_CreateAtEntity("bubbles", "oneshot_waterbubbles_small_vertical.ps", "AreaPipeBubbles_1", true);
			
				Player_FadeAspectMulTo(0.8, 0.08);
				Player_FadeRollTo(-45, 4, 2);
				
				Map_AddTimer("TimerTrembleEnd", 2.0, "TimerTrembleEnd");
			}
			
			Sequence_End();
		}
		//-------------------------------------------------------
		
		void TimerMorePipeEffects(const tString &in asTimer)
		{
			if(asTimer == "pipe1")
			{
				//TODO: Maybe a sound?
				Prop_SetStaticPhysics("PipeBreak_*", false);
				Entity_AddImpulse("PipeBreak_*", cVector3f(0,-10,0), false, false);
			}
		
			if(asTimer == "pipe2")
			{
				ParticleSystem_CreateAtEntity("bubbles2", "loop_waterbubbles_small_stream_fadein.ps", "AreaPipeBubbles", true);
				Player_SetMoveSpeedMul(1);
			}
		}
		
		//-------------------------------------------------------
		
		//} END Event tremor halfway up.

