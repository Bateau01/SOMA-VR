		/////////////////////////////////////////
		// Terminal Map Computer
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		void OnGuiMapComputer(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("02_03_delta");
		
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();
			
			tString sImage = "imgui/station/lambda_map/map_lambda.dds";
			tString sBeacon = "imgui/station/lambda_map/map_lambda_beacons";
			
			ImGui_DoWindowStart("BunkerApp_Map", StationGui_CreateDefaultWindowData(), ImGui_NrmPos(cVector3f(0.05, 0.02, 1)), ImGui_NrmSize(cVector2f(0.9, 0.96)));
					
					cImGuiGfx image;
					image.SetFile(sImage);
					image.mType = eImGuiGfx_Texture;
					
					cImGuiGfx beacon(sBeacon);
					
					ImGui_DoImage(image, cVector3f(0.603, 0.645, 1.1), cVector2f(650, 470) );
										
					ImGui_SetModColorMul(cColor_White*0.9);
					StationGui_YouAreHereIcon(ImGui_NrmPosGroup(cVector3f(0.603, 0.645, 1.2)), ImGui_NrmSizeGroupKeepRatio(0.05));
					ImGui_SetModColorMul(cColor_White);
					
					ImGui_SetModColorMul(cColor_White*0.2 + ImGui_FadeOscillateFloat("Beacon", 0, 0.55, 0.8f));
					ImGui_DoImage(beacon, ImGui_NrmPosGroup(cVector3f(0.535, 0.535, 1.2)), cVector2f(25, 25) );
					
					ImGui_DoImage(beacon, ImGui_NrmPosGroup(cVector3f(0.665, 0.325, 1.2)), cVector2f(25, 25) );
					
					ImGui_DoImage(beacon, ImGui_NrmPosGroup(cVector3f(0.825, 0.102, 1.2)), cVector2f(42, 42) );
						
					ImGui_SetModRotateAngle(0);
			ImGui_DoWindowEnd();
		}
		
		//-------------------------------------------------------
		
		//} END Terminal Map Compu
		
		/////////////////////////////////////////
		// Terminal Lifeboat
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbLifeBoatOmniToolLoadingDone=false;
		
		//-------------------------------------------------------
		
		void OnGuiLifeboat(const tString&in asEntityName, float afTimeStep)
		{
			//////////////////////////
			// Basics
			StationGuiBG_Scanlines();
			
			///////////
			// Translation setup
			ImGui_SetTransCategory("02_01_ms_curie_outside");
			
			///////////
			// Data Setup
			cImGuiLabelData errorLabel = ImGui_GetDefaultLabel();
			errorLabel.mFontAlign = eFontAlign_Left;
			errorLabel.mFont.mvSize = ImGui_NrmSize(0.075);
			errorLabel.mFont.mColor = cColor(1,0,0,1);
			
			//////////////////////////
			// Default message
			if(mbLifeBoat_OmniToolInserted==false)
				mbLifeBoatOmniToolLoadingDone = false;
			//////////////////////////
			// Default message
			else
			{
				if(mbLifeBoatOmniToolLoadingDone==false)
				{
					mbLifeBoatOmniToolLoadingDone = Depth_ImGui_LoadingGauge(	
												"OmniToolLoading", mbCortexChipInserted ? 1.5f : 3, true, 
												ImGui_NrmPos(0.05, 0.35, 0), ImGui_NrmSize(0.9, 0.3),
												StationGui_CreateDefaultGaugeData());
												
					StartSubCompLoadingSound();
				}
				else
				{
					StopSubCompLoadingSound();
					//////////////////////////
					// Cortex Chip is missing
					if(mbCortexChipInserted==false)
					{
						StationGui_BigStatusMessage_Old("LifeBoatCortexChip", gStationGuiColor_Warning, 0.95f);
					}
					//////////////////////////
					// Cath pops up!
					else 
					{
						if(mbLifeBoat_StartUpSequenceRunning)
						{
							//Unsure if anything should be displayed.
						}
						else
						{
							Depth_ImGui_CathPortrait(afTimeStep, "CatherineOmniTool");
							//ImGui_DoImage(cImGuiGfx("catherine_large"), cVector3f(0,0,1), ImGui_NrmSizeGroup(cVector2f(1, 1)));
						}
					}
				}
			}
		}
				
		//-------------------------------------------------------
		
		//} END Terminal Lifeboat

		
		//-------------------------------------------------------
		
		/////////////////////////////////////////
		// Terminal OmniTool
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbOmniToolLoadingDone=false;
		float mfOmniToolLoadingAmount=0;
		
		//-------------------------------------------------------
		
		void OnGuiOmniToolComputer(const tString&in asEntityName, float afTimeStep)
		{
			//////////////////////////
			// Basics
			StationGuiBG_Scanlines();
			
			///////////
			// Translation setup
			ImGui_SetTransCategory("02_01_ms_curie_outside");
			
			//////////////////////////
			// Default message
			if(mbOmniToolInserted == false)
			{
				StationGui_BigStatusMessage("OmniToolNotInserted");
			}
			//////////////////////////
			// Cortex Chip is missing
			else if(mbCortexChipInserted==false)
			{
				///////////////////////////////////
				// Loading the Omni tool
				if(mbOmniToolLoadingDone==false)
				{
					ImGui_DoGauge(	StationGui_CreateDefaultGaugeData(), mfOmniToolLoadingAmount, 
									ImGui_NrmPos(0.1, 0.4, 0), ImGui_NrmSize(0.8, 0.2));
				}
				///////////////////////////////////
				// In wait for cortex chip!
				else
				{
					cStationGui_BigStatusMessageSettings statusMessage;
					statusMessage.mvEdgeSpacing = 32;
					StationGui_BigStatusMessage("OmniToolStatus", statusMessage);			
					
					//ImGui_DoLabelExt("CorextChipNotInserted",errorLabel,ImGui_NrmPos(0.03, 0.6, 0));
				}
			}
			//////////////////////////
			// Cortex Chip is inserted
			else
			{
				Depth_ImGui_CathPortrait(afTimeStep, "CatherineOmniTool");
				//ImGui_DoImage(cImGuiGfx("catherine_large"), cVector3f(0,0,1), ImGui_NrmSizeGroup(cVector2f(1, 1)));
			}
			
		}
		
		//-------------------------------------------------------
		
		void OmniToolComputer_StartOmniToolLoading()
		{
			Map_AddTimer("OmniToolLoadingTick", 0.1, "Timer_OmniToolLoadingTick");
		}
		
		bool mbOmniToolLoadingActive = false;
		void Timer_OmniToolLoadingTick(const tString&in asTimer)
		{
			if(mbOmniToolLoadingActive==false)
			{
				Sound_CreateAtEntity("OmnitoolLoading", "02_01_ms_curie_outside/SFX/cathbot/omnitool_loading", "OmniToolSlot");
				mbOmniToolLoadingActive = true;
			}
			
			if(mfOmniToolLoadingAmount==1) //Putting this here to make sure the meter is displayed as full.
			{
				OmniToolLoadingIsDone(); //Callback to Scene 3
				
				mbOmniToolLoadingDone =true;
				return;
			}
			
			//I Cather
			if(mbCatherineOmniToolChatOver || mbInteractedWithCatherineMachine==false)
				mfOmniToolLoadingAmount += 0.05f * 0.5f;
			else
			{
				mfOmniToolLoadingAmount += (0.05f * 0.2f) * (1 - mfOmniToolLoadingAmount);
			}
						
			if(mfOmniToolLoadingAmount>=1.0f)
				mfOmniToolLoadingAmount = 1;
			
			Map_RestartCurrentTimer(0.05f);
		}
		
		//-------------------------------------------------------
		
		//} END OmniTool
		
		//-------------------------------------------------------
		
		/////////////////////////////////////////
		// Terminal Cath Machine
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		float mfCathMachineTalkingAlpha=0;
		float mfCathMachineAcitveAlpha=1;
		
		//-------------------------------------------------------
		bool mbCathScreenLoopActive = false;
		void OnGuiCathMachine(const tString&in asEntityName, float afTimeStep)
		{
			StationGuiBG_Scanlines();
			
			bool bCathIsTalking = Voice_CharacterIsSpeaking("CatherineRobot");
			
			if(bCathIsTalking)
			{
				mfCathMachineTalkingAlpha = cMath_IncreaseTo(mfCathMachineTalkingAlpha, afTimeStep*4, 1);
				
				if(mbCathMachineActive==true && mbCathScreenLoopActive==false)
				{
					Sound_CreateAtEntity("catherine_screen", "02_02_ms_curie_inside/SFX/cathbot_screen_loop", "catherine_screen", 0.15f, false, 1.0f);
					mbCathScreenLoopActive = true;
				}
			}
			else
			{
				mfCathMachineTalkingAlpha = cMath_IncreaseTo(mfCathMachineTalkingAlpha, afTimeStep*4, 0);
				
				if(mbCathScreenLoopActive==true)
				{
					Sound_Stop("catherine_screen", 0.2f);
					mbCathScreenLoopActive = false;
				}
			}
				
				
			if(mbCathMachineActive==false)
				mfCathMachineAcitveAlpha = cMath_IncreaseTo(mfCathMachineAcitveAlpha, afTimeStep, 0);
			
			cImGuiGfx gfxImageIdle = cImGuiGfx("02_01_cath_machine_idle", eImGuiGfx_Texture);
			cImGuiGfx gfxImageActive = cImGuiGfx("02_01_cath_machine_active", eImGuiGfx_Texture);
			
			
			float fT = mfCathMachineTalkingAlpha * mfCathMachineAcitveAlpha;
			Depth_ImGui_DrawLineDistortedGfx(gfxImageActive, ImGui_NrmPos(-0.1,0, 0), ImGui_NrmSize(1.2), 
											cColor(1,fT),0.09+(1-fT),1); 
			
			fT = (1-mfCathMachineTalkingAlpha)*mfCathMachineAcitveAlpha;
			Depth_ImGui_DrawLineDistortedGfx(gfxImageIdle, ImGui_NrmPos(-0.1,0, 0), ImGui_NrmSize(1.2), 
											cColor(1,fT), 0.04+(1-fT),1); 
		}
		
		//-------------------------------------------------------
		
		//} END Cath Machine
		
		
	//-------------------------------------------------------
	
	//} END TERMIANALS
	
	 //////////////////////////////////////////////////////////////////////////////////////////
	 // ==============
	 // AUDIO
	 // ==============
	 //{//////////////////////////////////////////////////////////////////////////////////////
	
	//{Airlocks
	
	void AirlockEffectsTurnOnPumps()
	{
		if (mbAirlockedFilled==false)
		{
				//airlock not full, play non-underwater idle sound
				Sound_CreateAtEntity("Pump_Idle_Loop_Air", "Entities_OceanBottom/airlock/air/pump/idle_loop", "PumpsSource", 1.0f, false, 1.0f); 
		}
		else if (mbAirlockedFilled==true)
		{
				//airlock is full play underwater idle sound
				Sound_CreateAtEntity("Pump_Idle_Loop_Underwater", "Entities_OceanBottom/airlock/uw/pump/idle_loop", "PumpsSource", 1.0f, false, 1.0f);
		}
	}
 
    //-------------------------------------------------------
	
	void AirlockEffectsTurnOffPumps()
	{
		if (mbAirlockedFilled==false)
		{
				//Airlock not full, play air idle sound
				Sound_Stop("Pump_Idle_Loop_Air", 1.0f);
		}
		else if (mbAirlockedFilled==true)
		{
				//Airlock is full play underwater idle sound
				Sound_Stop("Pump_Idle_Loop_Underwater", 1.0f);
		}
	}
 
    //-------------------------------------------------------
	
	void AirlockEffectsFlushWater()
	{
		Depth_Audio_AirlockDrainLeadInUW();
		Depth_Audio_AirlockDrainLoopUW();
		Map_AddTimer("AirlockDrainUWStopTimer", 6.95f, "AirlockDrainUWStop");
	}
 
    //-------------------------------------------------------
	
	void AirlockDrainUWStop(const tString &in asTimer)
	{
		AirlockSoundLogic();
		Sound_Stop("PumpUW", 0.55f);
		Sound_CreateAtEntity("PumpingAirLoop", "Entities_OceanBottom/airlock/air/pump/pump_loop_nointro", "PumpsSource", 0.55f, false, 1.0f);
		Depth_Audio_AirlockDrainLoopUWStop();
		Depth_Audio_AirlockDrainLoopAir();
		Map_AddTimer("AirlockDrainingAirStopTimer", 2.0f, "AirlockDrainingAirStop");
	}
	 
    //-------------------------------------------------------
	
	void AirlockDrainingAirStop(const tString &in asTimer)
	{
		Depth_Audio_AirlockDrainLoopAirStop();
		Depth_Audio_AirlockDrainLeadOutAir();
		Sound_Stop("PumpingAirLoop", 0.25f);
		Sound_CreateAtEntity("PumpAirLeadOut", "Entities_OceanBottom/airlock/air/pump/pump_end", "PumpsSource", 0.0f, false, 1.0f);
		AirlockEffectsTurnOnPumps();
	}
	 
    //-------------------------------------------------------
	
	void AirlockEffectsFillWithWater()
	{
		Depth_Audio_AirlockFillingLeadInAir();
		Depth_Audio_AirlockFillingLoopAir();
		Map_AddTimer("AirlockFillingAirStopTimer", 8.5f, "AirlockFillingAirStop");
	}
	 
    //-------------------------------------------------------
	
	void AirlockFillingAirStop(const tString &in asTimer)
	{
		AirlockSoundLogic();
		Depth_Audio_AirlockFillingLoopAirStop();
		Depth_Audio_AirlockFillingLoopUW();
		
		///////////////////
		//Pump Sounds
		Sound_Stop("PumpingAirLoop", 0.5f);
		Sound_CreateAtEntity("PumpUW", "Entities_OceanBottom/airlock/uw/pump/pump_loop_nointro", "PumpsSource", 0.0f, false, 1.0f);
		Map_AddTimer("AirlockFillingLoopUWStopTimer", 5.0f, "AirlockFillingLoopUWStop");
	}
	 
    //-------------------------------------------------------
	
	void AirlockFillingLoopUWStop(const tString &in asTimer)
	{
		Depth_Audio_AirlockFillingLoopUWStop();
		Depth_Audio_AirlockFillingLeadOutUW();
		
		///////////////////
		//Pump Sounds
		Sound_CreateAtEntity("PumpUWLeadOut", "Entities_OceanBottom/airlock/uw/pump/pump_end", "PumpsSource", 0.0f, false, 1.0f);
		Sound_Stop("PumpUW", 1.f);
		AirlockEffectsTurnOnPumps();
	}
	 
    //-------------------------------------------------------
	
	bool mbIsAirlockEmptySound = false;
	
	void AirlockSoundLogic()
	{
		if (mbIsAirlockEmptySound==false)
		{
			cLux_AddDebugMessage("Air Sound Areas Active");
			Entity_SetActive("AMB_INT_*", true);
			Entity_SetActive("AMB_EXT_*", false);
			
			mbIsAirlockEmptySound = true;
		}
		
		else if (mbIsAirlockEmptySound==true)
		{
			cLux_AddDebugMessage("Air Sound Areas Disabled");
			Entity_SetActive("AMB_INT_*", false);
			Entity_SetActive("AMB_EXT_*", true);
			
			mbIsAirlockEmptySound = false;
		}
	}
	
