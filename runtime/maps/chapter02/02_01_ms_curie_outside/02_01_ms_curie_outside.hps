    //-------------------------------------------------------------------
    bool mbBarracksWaterSpotControl = false;
    bool BarracksWaterSpotControl(const tString &in asParent, const tString &in asChild, int alState)
    {
        if(alState==1)
        {
            Map_AddTimer("BarracksWaterSoundControl", 1.0f, "BarracksWaterSoundControl");
            mbBarracksWaterSpotControl = true;
        }
        else
        {
            Map_RemoveTimer("BarracksWaterSoundControl");
            Sound_Stop("broken_corridor_12", 0.5f);
            Sound_Stop("broken_corridor_11", 0.5f);
            Sound_Stop("broken_corridor_10", 0.5f);
            mbBarracksWaterSpotControl = false;
        }
        return true;
    }
    
    void BarracksWaterSoundControl(const tString &in asTimer)
    {
        if(SlideDoor_GetOpenAmount("PersRoom_Door_2") < 0.5 && mbBarracksWaterSpotControl==true)
        {
            Sound_Stop("broken_corridor_12", 0.5f);
            Sound_Stop("broken_corridor_11", 0.5f);
            Sound_Stop("broken_corridor_10", 0.5f);
            Sound_Stop("broken_corridor_19", 0.5f);
            Map_AddTimer("BarracksWaterSoundControl", 1.0f, "BarracksWaterSoundControl");
        }
        else if(SlideDoor_GetOpenAmount("PersRoom_Door_2") > 0.5)
        {
            Sound_Play("broken_corridor_12", 0.5f);
            Sound_Play("broken_corridor_11", 0.5f);
            Sound_Play("broken_corridor_10", 0.5f);
            Sound_Play("broken_corridor_19", 0.5f);
            Map_AddTimer("BarracksWaterSoundControl", 1.0f, "BarracksWaterSoundControl");
        }
    }
	        
