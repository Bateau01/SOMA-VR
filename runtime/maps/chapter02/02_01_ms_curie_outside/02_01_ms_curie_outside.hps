	//Kitchen area fridge compressor
	bool mbFridgeCompressorSoundActive = false;
	void LivingArea_FridgeCompressor_SoundStart(const tString &in asTimer)
	{
		if(mbFridgeCompressorSoundActive == false)
		{
			Map_RemoveTimer("LivingArea_FridgeCompressor_SoundStart");
			Sound_CreateAtEntity("CompressorStart", "Entities_Station/object/sliding_fridge/compressor/start", "FridgeCompSoundSrc", 0.0f, true, 1.0f);
			Sound_CreateAtEntity("CompressorLoop", "Entities_Station/object/sliding_fridge/compressor/loop", "FridgeCompSoundSrc", 1.0f, true, 1.0f);
			Map_AddTimer("LivingArea_FridgeCompressor_SoundStop", cMath_RandRectf(18, 30), "LivingArea_FridgeCompressor_SoundStop");
			mbFridgeCompressorSoundActive = true;
		}
	}
	
	void LivingArea_FridgeCompressor_SoundStop(const tString &in asTimer)
	{
		if(mbFridgeCompressorSoundActive == true)
		{
			Map_RemoveTimer("LivingArea_FridgeCompressor_SoundStop");
			Sound_CreateAtEntity("CompressorStop", "Entities_Station/object/sliding_fridge/compressor/stop", "FridgeCompSoundSrc", 0.0f, true, 1.0f);
			Sound_Stop("CompressorLoop", 1.0f);
			Map_AddTimer("LivingArea_FridgeCompressor_SoundStart", cMath_RandRectf(30, 45), "LivingArea_FridgeCompressor_SoundStart");
			mbFridgeCompressorSoundActive = false;
		}

	}
			
	//-------------------------------------------------------------------
	//Controls whether cath dist lines should be heard
	bool mbCathDistAllowed = true;
	bool CathDistControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			mbCathDistAllowed = false;
			cLux_AddDebugMessage("Close to cath - distant lines not allowed");
		}
		else
		{
			mbCathDistAllowed = true;
			cLux_AddDebugMessage("Away from cath - distant lines allowed");
		}
		return true;
	}
		
	//-------------------------------------------------------------------
	//Sub Comp loading sound
	
	bool mbSubCompLoadingActive = false;
	
	void StartSubCompLoadingSound()
	{
		if(mbSubCompLoadingActive==false)
		{
			mbSubCompLoadingActive = true;
			Sound_CreateAtEntity("SubCompLoadLoop", "02_02_ms_curie_inside/SFX/sub_comp/escape_sub_comp_load_loop", "02_01_computer_parts_readout_flat_1", 0.15f, true, 1.0f);
		}
	}
	
	void StopSubCompLoadingSound()
	{
		if(mbSubCompLoadingActive==true)
		{
			if(Sound_Exists("SubCompLoadStart"))
			{
				Sound_Stop("SubCompLoadStart", 0.25f);
			}
			
			Sound_Stop("SubCompLoadLoop", 0.5f);
			Sound_CreateAtEntity("SubCompLoadEnd", "02_02_ms_curie_inside/SFX/sub_comp/escape_sub_comp_load_end", "02_01_computer_parts_readout_flat_1", 0.0f, true, 1.0f);
			mbSubCompLoadingActive = false;
		}
	}
	
