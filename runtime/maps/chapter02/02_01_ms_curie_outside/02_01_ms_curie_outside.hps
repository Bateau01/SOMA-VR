    //--------------------------------------------------
    
    //Music
    bool mbExteriorAmbientMusicPlaying = false;
    bool mbAmbientMusicStage2 = false;
    float gfAmbientMusicMul = 1.0f;
    
	bool Trigger_RevealMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		Map_AddTimer("AmbientExplorationMusic", cMath_RandRectf(10.f, 15.f), "AmbientExplorationMusic");
		return false;
	}
	
	void AmbientExplorationMusic(const tString &in asTimer)
	{
        if(mbAmbientMusicStage2==false)
        {
            Music_PlayExt(gsLambdaExtMusicStage1, true, 0.7f, 1, cMath_RandRectf(5.f, 8.f), 0.0f, eMusicPrio_BgAmb , true);  
        }
        else if(mbAmbientMusicStage2==true)
        {
            Music_PlayExt(gsLambdaExtMusicStage2, true, 0.7f, 1, cMath_RandRectf(5.f, 8.f), 0.0f, eMusicPrio_BgAmb , true);  
        }
        
        cLux_AddDebugMessage("Ambient music triggering");
			
        //Dynamic fades
        Map_AddTimer("RandomFadeRider", cMath_RandRectf(20.f,30.f), "AmbientMusicHandler");
        Map_AddTimer("FadeOut", cMath_RandRectf(120.f,180.f), "AmbientMusicHandler");
        Map_RemoveTimer("StopAmbientMusic");
        Map_RemoveTimer("StopAmbientMusicQuickly");
        
        mbExteriorAmbientMusicPlaying = true;
	}
    
    //-------------------------------------------------------------------------
	
    void AmbientMusicHandler(const tString &in asTimer)
    {
        if (asTimer=="StopAmbientMusic" && mbExteriorAmbientMusicPlaying==true)
        {
            Music_Stop(4.5f, eMusicPrio_BgAmb);
            Map_RemoveTimer("RandomFadeRider");
            Map_RemoveTimer("FadeOut");
            Map_RemoveTimer("AmbientExplorationMusic");
            Music_FadeVolumeMul(1.0f,1.0f);
            mbExteriorAmbientMusicPlaying = false;
        }
		else if (asTimer=="StopAmbientMusicQuickly" && mbExteriorAmbientMusicPlaying==true)
		{
            cLux_AddDebugMessage("Stop Ambient Music Quickly Triggered");
            Music_Stop(1.5f, eMusicPrio_BgAmb);
            Map_RemoveTimer("AmbientExplorationMusic");
            Map_RemoveTimer("RandomFadeRider");
            Map_RemoveTimer("FadeOut");
            Music_FadeVolumeMul(1.0f,1.0f);
            mbExteriorAmbientMusicPlaying = false;
		}
		
		else if(asTimer=="RandomFadeRider")
		{
			if(mbAmbientMusicStage2==false)
			{
				Music_PlayExt(gsLambdaExtMusicStage1, true, 0.7f*gfAmbientMusicMul, 1.0f, cMath_RandRectf(5.f,8.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			else if(mbAmbientMusicStage2==true)
			{
				Music_PlayExt(gsLambdaExtMusicStage2, true, 0.7f*gfAmbientMusicMul, 1.0f, cMath_RandRectf(5.f,8.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			
			cLux_AddDebugMessage("Ambient Music Fading");
			gfAmbientMusicMul = cMath_RandRectf(0.8f, 1.2f);
			Map_AddTimer("RandomFadeRider", cMath_RandRectf(20.f,35.f), "AmbientMusicHandler");
		}
		
        else if(asTimer=="FadeOut")
        {	
            cLux_AddDebugMessage("Ambient Music Fading Out");
            Music_Stop(cMath_RandRectf(8.f,12.f), eMusicPrio_BgAmb);
            mbExteriorAmbientMusicPlaying = false;
            Map_RemoveTimer("RandomFadeRider");
            Map_AddTimer("AmbientExplorationMusic", cMath_RandRectf(120.f,180.f), "AmbientExplorationMusic");
        }
		
		cLux_AddDebugMessage("Ambient Music Playing is "+mbExteriorAmbientMusicPlaying);
    }
    
