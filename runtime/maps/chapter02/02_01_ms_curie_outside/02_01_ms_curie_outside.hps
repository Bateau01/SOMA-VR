	//-------------------------------------------------------------------
	
	//Second half of level ambient music	
	bool OnLifeboatDoorway(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState==-1) // Leave
		{
			Map_AddTimer("AmbientExplorationMusic", cMath_RandRectf(3.f, 6.f), "AmbientExplorationMusic");
			return true;
		}
		else	// Enter
		{
            Map_AddTimer("StopAmbientMusic", 1.0f, "AmbientMusicHandler");
            mbEnteredLifeboat = true;
            return true;
		}
	}
	
