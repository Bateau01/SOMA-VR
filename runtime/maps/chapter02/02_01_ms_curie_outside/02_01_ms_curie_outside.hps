class cScrMap : iScrMap
{
    // S26IO: permission for unrelated physical world controls only.
    // Native exit callbacks, GUI ownership, B/distance exit and pickups are unchanged.
    bool VR_CanUseWorldControlsFromTerminal(const tString &in asEntityName)
    {
        return asEntityName=="monitor_theta_terminal_1";
    }

 void Update(float dt){EnsureVRTraversalIA();mVRTraversalHY.Update(dt);}

 [nosave] cVRTraversalGuidesHY mVRTraversalHY;

	//-------------------------------------------------------

	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////	
	
	//-------------------------------------------------------
	
	void Setup()
	{
		GetBase().SetDisplayNameEntry("02-01-ms-curie-outside");
		RichPresence_SetCurrent(eRichPresence_SiteLambda );
		
		///////////////////////////////
		// Setup presets
		{
			// When outside and underwater
			Map_Preset_SetupFog("Outside", true, 2, 30, 0.4, cColor(2.0 / 255.0, 7.0 / 255.0, 9.0 / 255.0,1), 1.0, true, true);
			Map_Preset_SetupDepthOfField("Outside", true, 0.05, 12.0, 0.1);
			Map_Preset_SetupBloom("Outside", 160, 0.00001, 0.5, cColor(0.3, 0.3, 0.3, 1.0));
			Map_Preset_SetupSecondaryFog("Outside", true, 0, 70, 0.15, cColor(0, 0, 0, 1));

			// Inside and not underwater
			Map_Preset_SetupFog("Inside", true, 2, 60, 0.9, cColor(0, 0, 0, 1), 1.0, false, false);
			Map_Preset_SetupDepthOfField("Inside", false);
			Map_Preset_SetupBloom("Inside", 128, 0.75, 0.5, cColor(1.0, 1.0));
			Map_Preset_SetupSecondaryFog("Inside", false, 0, 70, 0.15, cColor(0, 0, 0, 1));

			// Liquid area
			Map_Preset_SetupFog("LiquidArea", false); //the luquid area has its own fog
			Map_Preset_SetupDepthOfField("LiquidArea", true, 0.05, 12.0, 0.1);
			Map_Preset_SetupBloom("LiquidArea", 160, 0.00001, 0.5, cColor(0.3, 0.3, 0.3, 1.0));
			Map_Preset_SetupSecondaryFog("LiquidArea", true, 0, 70, 0.15, cColor(0, 0, 0, 1));

			// Temp: Set this here until level editor support
			cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();
			pWorld.SetFogApplyAfterFogAreas(false);
			
			////////////////////
			//PRESET FOR TRANSITION TO LEVEL 2.2
			Map_Preset_SetupBloom("Inside2.2", 160, 0.00001, 0, cColor(0.3, 0.3, 0.3, 0));
			Map_Preset_SetupDepthOfField("Inside2.2", true, 0, 6, 0.5);
			Map_Preset_SetupColorGrading("Inside2.2", "textures/colorgrading/grading_02_02.dds");
			
			Player_SetFlashlightEnvParticleMul(4);
		}
		cTerrain@ pTerrain = cLux_GetCurrentMap().GetWorld().GetTerrain();
		if(pTerrain !is null) pTerrain.SetCheapMaterial("sand_flat.mat", 0.5f);
	}
	
	//-------------------------------------------------------
	
	void PreloadData()
	{
		//////////////////////////
		// GUI
		StationGui_PreloadDefault();
		OmnitoolGui_Preload();

		ImGui_PreloadImage("02_01_cloud_city_plans_01", eImGuiGfx_Texture);
		ImGui_PreloadImage("02_01_cloud_city_plans_02", eImGuiGfx_Texture);
		ImGui_PreloadImage("02_01_cloud_city_plans_03", eImGuiGfx_Texture);
		ImGui_PreloadImage("02_01_cloud_ark_schematics_01", eImGuiGfx_Texture);
		ImGui_PreloadImage("02_01_cloud_ark_schematics_02", eImGuiGfx_Texture);
		ImGui_PreloadImage("02_01_cloud_ark_schematics_03", eImGuiGfx_Texture);
		ImGui_PreloadImage("02_01_cloud_ark_schematics_04", eImGuiGfx_Texture);
		ImGui_PreloadImage("02_01_cloud_ark_schematics_05", eImGuiGfx_Texture);
		ImGui_PreloadImage("ark_map_route.dds", eImGuiGfx_Texture);
		ImGui_PreloadImage("02_01_cloud_tracker_map_0", eImGuiGfx_Texture);
		ImGui_PreloadImage("02_01_cloud_tracker_map_1", eImGuiGfx_Texture);
		ImGui_PreloadImage("02_01_cloud_tracker_map_2", eImGuiGfx_Texture);
		ImGui_PreloadImage("02_01_cloud_tracker_map_3", eImGuiGfx_Texture);
		ImGui_PreloadImage("imgui/station/lambda_map/map_lambda.dds", eImGuiGfx_Texture);
		ImGui_PreloadImage("02_01_cath_machine_idle", eImGuiGfx_Texture);
		ImGui_PreloadImage("02_01_cath_machine_active", eImGuiGfx_Texture);
		
		//////////////////////////
		// Models
		PlayerHands_PreloadHandModel_Diving();
		
		//////////////////////////
		// Particles
		ParticleSystem_Preload("smoke_bright_med_slow_loop.ps");
		ParticleSystem_Preload("elec_spark_oneshot.ps");
		ParticleSystem_Preload("oneshot_waterbubbles_small_vertical.ps");
		ParticleSystem_Preload("loop_waterbubbles_small_stream_fadein.ps");
	}
	
	//-------------------------------------------------------
	
	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		CathTool_ResetScreen(eCathToolVariant_HelperJane);
		
		//////////////////////////////////
		//Disabled
		Entity_SetActive("PipeBreak_*", false);
		
		//////////////////////////////////
		// Map setup
		Map_AddTimer("", 2, "TimerOpenAirLock");
		
		//////////////////////////////////////////
		// Player setup
		Player_SetAmbientLight_Outdoors();
		Tool_PickUp("CathTool_NoChip", false, false);
		
		//////////////////////////////////////////
		// Entity Setup
		SwingDoor_SetOpenAmount("locker_cabin_15", 0.6f);
					
				
		/////////////////////////////////////////
		// Load Sounds
		Sound_PreloadProject("02_01_ms_curie_outside");
		Sound_PreloadGroup("Flashback/Level/02_01", true);
		Player_SetClothing("default");
		Player_SetFootWear("default");
		
		//Airlock
		AirlockEffectsTurnOnPumps();
		
		/////////////////////////////////////
		// LEVEL SETUP
		
		Entity_PlayAnimation("ladder_extender", "retracted", 0.1f, false, false);
		
		Entity_SetActive("Start_Ladder", false);
		Entity_SetInteractionDisabled("crate_flesher_large_base_1", true);
		
		SetPlayerIsUnderwater(true, 0.001f, true);
		
		PlayerHands_SetHandModel_Diving();
		
		Voice_SetCharacterSpeakingCallback("CatherineOmniTool", "OnCathTalking");
		
		Map_AddTimer("LivingArea_FridgeCompressor_SoundStart", cMath_RandRectf(30, 45), "LivingArea_FridgeCompressor_SoundStart");
		
		///////////////////////////////////////////
		// THIS IS NOT A GOOD SOLUTION
		// Set some debris to not collide with character
		array<iLuxEntity@> vAnnoyingDebrisObjects;
		cLux_GetCurrentMap().GetEntityArray("annoying_*", eLuxEntityType_LastEnum, "", vAnnoyingDebrisObjects);
		for(int i=0; i<vAnnoyingDebrisObjects.size(); ++i)
		{
			iLuxEntity@ pEnt = vAnnoyingDebrisObjects[i];
			pEnt.GetBody(0).SetCollideCharacter(false);
		}
		
		Prop_SetAllowMapTransfer("shipwreck_slidedoor_medium_18", false);
		Prop_SetAllowMapTransfer("locker_cabin_*", false);
		Prop_SetAllowMapTransfer("DebrisLocker", false);
		
		//-------------------------------------------------------
		
		
		//----DEBUG----//
		if(cLux_ScriptDebugOn())
		{
			//SetPlayerIsUnderwater(false,0.01f, true);
			//mbAirlockedFilled = false;
						
			//Entity_SetActive("AreaCathSaysHide", false);
			//Entity_SetActive("AreaFlesherGlimpse", false);
			
			//mbCortexChipInserted = true;
			//mbOmniToolHasCurieCodes = true;
			//mbInteractedWithCatherineMachine = false;
			//mbCatherineOmniToolChatOver = true;
			
			//mbLifeBoat_HasTriedOmniTool = true;
						
			//mbCathCanTalk = true;
		}
		else
		{
			Effect_Fade_In(1.0);
		}
		
		Entity_SetAutoSleep("EscapePodDoor",false);
		
		
		LastOnSoma_SetText("02_01_ms_curie_outside_1");
	}
	
	    // Visual-only initialization also runs after save loading, which can skip OnEnter.
    void EnsureVRTraversalIA()
    {
        if(mVRTraversalHY.mvPoints.length()!=0)return;
        mVRTraversalHY.Add("LadderArea_3",cVector3f(0.1176079f,-0.7430220f,0.0355741f),cVector3f(0.0000000f,1.0000000f,0.0000000f),cVector3f(-0.0046300f,-0.0000000f,0.9999893f));

        mVRTraversalHY.Add("LadderArea_3",cVector3f(-0.4438674f,2.1301260f,-0.0808066f),cVector3f(0.0000000f,0.0000000f,-1.0000000f),cVector3f(-0.0000000f,1.0000000f,0.0000000f));

        mVRTraversalHY.Add("Start_Ladder",cVector3f(0.1500000f,-2.7000000f,0.0000000f),cVector3f(0.0000000f,1.0000000f,0.0000000f),cVector3f(0.0000000f,0.0000000f,1.0000000f));

        mVRTraversalHY.Add("Start_Ladder",cVector3f(-0.1056429f,3.9516197f,-0.1839184f),cVector3f(0.0000000f,0.0000000f,-1.0000000f),cVector3f(0.0482254f,0.8230080f,0.5659789f));

        mVRTraversalHY.Add("LadderArea_1",cVector3f(0.1469231f,-1.5248841f,0.0222689f),cVector3f(0.0000000f,1.0000000f,0.0000000f),cVector3f(0.0176391f,0.0000000f,0.9998444f));

        mVRTraversalHY.Add("LadderArea_1",cVector3f(-0.3094757f,3.3625407f,-0.1938377f),cVector3f(0.0000000f,0.0000000f,-1.0000000f),cVector3f(0.5625618f,0.8266957f,-0.0099197f));

    }

void OnEnter()
	{
        // HY ladder surfaces: source triangles recorded in ladder_coverage_hy.json.
        mVRTraversalHY.Dispose();EnsureVRTraversalIA();
        
        
        
        

        
        


		MainMenu_SetBGPhase(eMainMenuPhase_1_3_To_2_4);
		
		FogArea_SetVisibleInReflection("FogArea_2_(Conflict1)", false);
	}
	
