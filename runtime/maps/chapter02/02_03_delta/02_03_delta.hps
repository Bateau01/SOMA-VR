    //-------------------------------------------------------
	
	bool CollisionPlayerBlocksZeppelin(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
		{
			if (Player_GetCrouching())
			{
				if (cLux_GetExplorationModeActive())
				{
					Effect_Fade_Out(0.1f);
					AttackMeter_AutoDamage(0.f, 1.f, false);				
					Map_AddTimer("Timer_TeleportToZeppStart", 1.5f, "OnTimer_TeleportToZeppStart");
					return true;
				}

				Player_GiveDamage(1, 0, eDamageType_Hit, "");
				Player_MoveHeadPos(cVector3f_Down*0.375, 9, 4, 0);
				Depth_Audio_PlayerTakeDamage();
				//Depth_Audio_SimonHurt_Damage();
			}
			else
			{
				Player_SetCrouching(true);
			}
		}
		return true;
	}
	
