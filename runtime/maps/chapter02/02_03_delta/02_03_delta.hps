	bool mbZeppelinTerminalActive=false;
	 
	void OnChangeMainBaseButton(const tString &in asEntity, int alState)
	{  
		Terminal_SetGuiActive("ZeppelinComputer", alState==1, 0.5);
	  
	    //activate zeppelin platform lights
		Lamp_SetLit("zepp_platform_highlight_*", true, true);
		/////////////////////////////////
		//Button sound
		Sound_CreateAtEntity("ZeppelinTerminalButton", "Entities_OceanBottom/button/plastic_push", "Player", 0.0f, false, 1.0f);
		mbZeppelinTerminalActive = !mbZeppelinTerminalActive;

		/////////////////////////////////
		//Terminal computer sound
		if (mbZeppelinTerminalActive==false)
		{
			Sound_Stop("ZeppelinTerminalSound", 0.0f);
			Sound_Stop("ZeppelinTerminalSoundStart", 0.0f);
			cLux_AddDebugMessage("Stop Terminal Sound");
			return;
		}

		if (mbZeppelinTerminalActive==true)
		{
			Sound_CreateAtEntity("ZeppelinTerminalSound", "Entities_OceanBottom/tech/terminal/loop", "ZeppelinTerminalSoundSource", 2.0f, true, 1.0f);
			Sound_CreateAtEntity("ZeppelinTerminalSoundStart", "Entities_OceanBottom/tech/terminal/start", "ZeppelinTerminalSoundSource", 0.0f, true, 1.0f);
			cLux_AddDebugMessage("Start Terminal Sound");
			return;
		}
	}
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 7 Event F *Zeppelin Arrives*
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	cSequenceStatesData mZeppelinArrivesSequence;
		
	void SequenceZeppelinArrives(const tString &in asTimer)
	{
		Sequence_Begin("SequenceZeppelinArrives", mZeppelinArrivesSequence);
			
		//////////////////////////////////
		// Activate and start movement
		if (Sequence_DoStepAndPause(1))
		{
			
			Lamp_SetLit("LandingPadLamp_1", true, false);
			Map_AddTimer("LandingPadLamp_1", 0.4, "TimerLandingLightsLoop");
			
			///////////////////////////////////////////////
			///Timer for Zeppelin Arrival Music
			Map_AddTimer("FadeoutAmbientMusic", 10, "AmbienceMusicGracefulFadeout");
			Map_AddTimer("ZeppelinCallSound", 15, "ZeppelinCallSound");
			Map_AddTimer("ZeppelinMusic", 20, "ZeppelinApproachingMusic");
			
			Sound_Stop("zeppelin_pad_spot_*", 5.0f);
			Entity_SetActive("AMB_LandingPlatform", false);
			
			Entity_SetActive("ZepTerminalA", true);
			Entity_SetActive("ZepTerminalB", true);
			Entity_SetActive("ZeppelinPlatform", true);
			Entity_SetActive("Zeppelin", true);
			Entity_SetActive("CatherineSlotInteract", true);
			Entity_SetActive("ZeppelinCathTerminal", true);
			Entity_SetActive("ZeppelinCathTerminal_*", true);
			Entity_SetActive("TerminalCathZep", true);
			Entity_SetActive("ZeppelinPlatformRailing_*", true);
			Entity_SetActive("StunRodLockbox", true);
			Entity_SetActive("StunRodLockboxLid", true);
			Entity_SetActive("StunRodLockboxButton", true);
			Entity_SetActive("StunRodInnerHatch", true);
			Entity_SetActive("StunRod", true);
			Entity_SetActive("LiftoffLever", true);
			Entity_SetActive("LiftoffButton", true);
			Entity_SetActive("LiftoffLever_Lamp", true);
			Entity_SetActive("LiftoffButton_Lamp", true);
			Entity_SetActive("CatherineTerminal", true);
			Entity_SetActive("zeppelin_searchlight01_1", true);
			Entity_SetActive("zeppelin_searchlight01_2", true);
			Entity_SetActive("BrokenRadio", true);
			Entity_SetActive("ZeppelinPlatformExtra_1", true);
			Entity_SetInteractionDisabled("ZeppelinPlatformRailing_*", true);
			Entity_SetEffectsActive("LiftoffLever", false, false);
			Entity_SetEffectsActive("LiftoffButton", false, false);
			
			for (int i = 1; Entity_Exists("ZeppelinEngine_"+i); i++)
			{
				ParticleSystem_CreateAtEntity("ZeppelinEngineOn_"+i, "02_03_zeppelin_engine_on", "ZeppelinEngine_"+i, true);
			}

			Prop_MoveLinearTo("ZeppelinPlatform", "ZeppelinTargetPos_1", 1, 2, 8, true);
		}
		
		/////////////////////
		// Land
		if (Sequence_DoStepAndPause(4))
		{
			Prop_MoveLinearTo("ZeppelinPlatform", "ZeppelinTargetPos_2", 0.8, 0.6, 0.5, false);
			Entity_SetActive("LandingPlatformArea", true);
		}
		
		////////////////////
		// Lower railing
		if (Sequence_DoStepAndWait(3))
		{
			for (int i = 1; Entity_Exists("ZeppelinEngine_"+i); i++)
			{
				ParticleSystem_CreateAtEntity("ZeppelinEngineOff_"+i, "02_03_zeppelin_engine_off", "ZeppelinEngine_"+i, true);
				ParticleSystem_Destroy("ZeppelinEngineOn_"+i);
			}
			
			Prop_SetStaticPhysics("ZeppelinPlatformRailing_*", false);
			Lever_SetAutoMoveEnabled("ZeppelinPlatformRailing_*", true);
			Lever_SetAutoMoveTarget("ZeppelinPlatformRailing_*", 1);
			Entity_SetActive("LiftoffBlocker_*", false);
			
			
			Sound_CreateAtEntity("ZeppelinRailingsDown", "NPC_Zeppelin/SFX/linear/gates_open_onboard", "ZeppelinPlatformRailing_2", 0.0f, false, 1.0f);
			
			Entity_SetActive("ZeppelinLandingBlocker", false);
			
			Prop_SetStaticPhysics("StunRodLockboxLid", false);
			Prop_SetStaticPhysics("StunRodLockboxButton", false);
			Prop_SetStaticPhysics("StunRodInnerHatch", false);
			Prop_SetStaticPhysics("LiftoffLever", false);
			
			Entity_SetPlayerLookAtCallback("Zeppelin", "", false);
			
			Entity_SetActive("CatherineToolArea", true);
			
			mbZeppelinArrived = true;

			Preload();
		}
		if (Sequence_DoStepAndWait(0))
		{
			Prop_SetStaticPhysics("ZeppelinPlatformRailing_*", true);
		}
		Sequence_End();
	}
	
