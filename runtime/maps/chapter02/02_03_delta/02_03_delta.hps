		if (alState == 1)
		{
			Map_RemoveTimer(asEntity);
		}
		else
		{
			cLux_AddDebugMessage("Removing " + asEntity + " in 2 secs.");
			Map_AddTimer(asEntity, 2, "TimerDisableEntity");
