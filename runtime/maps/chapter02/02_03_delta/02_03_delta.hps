	void InteractTrainDoor(const tString &in asEntity)
	{
		if (Map_TimeHasPassed("InteractTrainDoor", 2))
			Sound_CreateAtEntity("LockedTrainDoor", "shipwreck/doors/heavy_metal_door/locked", asEntity, 0.0f, false, 1.0f);
		
		if (!mbTriedOpeningTrainDoor) 
			Voice_Play("7_TriedOpeningTrainDoor");
		
		mbTriedOpeningTrainDoor = true;
	}
	
	void BrokenTrainStationInteract(const tString &in asEntity, int alState)
	{
		if(alState!=1)
			return;
			
		Sound_CreateAtEntity("PressButton", "Entities_OceanBottom/button/plastic_stiff", asEntity, 0.0f, false);
		Map_AddTimer("AllowInteractionTrainDoor", 3.0f, "AllowInteractionTrainDoor");
		Entity_SetInteractionDisabled("TransportStationPanel_Outside", true);
		
		if(mbTriedOpeningTrainDoor==false)
		{		
			if (Map_TimeHasPassed("BrokenTrainStationInteract", 2))
			{
				if (!mbTriedOpeningTrainDoor) 
				Voice_Play("7_TriedOpeningTrainDoor");
			
				mbTriedOpeningTrainDoor = true;
			}
		}
	}
	
	void AllowInteractionTrainDoor(const tString &in asTimer)
	{
		Entity_SetInteractionDisabled("TransportStationPanel_Outside", false);
	}
	 
    //-------------------------------------------------------
	
	bool Collide_TrainDoorStuck(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1 && Map_TimeHasPassed("InteractTrainDoor", 2))
			Sound_CreateAtEntity("LockedTrainDoor", "shipwreck/doors/heavy_metal_door/locked", asChild, 0.0f, false, 1.0f);
			
		return true;
	}
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 7 Event A *Enter; Robot turns on power*
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	bool CollisionMainBaseEntrance(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1) return true;
		
		mbInsideMainBase = Entity_PlayerIsInFront(asChild);
		
		////////////////////////////
		// Player entered building
		if (mbInsideMainBase && !mbStopKateFollowing)
		{
			if (mbKateWeldingInProgress) StopKateWelding();
			Kate_Investigate("Kate", "MainBaseInvestigateNode", "ZeppelinComputer", -1);
		}
		
		////////////////////////////
		// Player left building
		else
		{
			if (!mbStopKateFollowing)
			{
				if (mbKateWeldingInProgress) StopKateWelding();
				Kate_FollowPlayer("Kate");
			}
		}
		
		return true;
	}
 
