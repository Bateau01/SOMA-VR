	bool CollisionRaySpawn(const tString &in asParent, const tString &in asChild, int alState)
	{
		Entity_SetActive("Ray", true);
		Entity_SetActive("RayLookAt", true);
		return false;
	}
	
	//-------------------------------------------------------
	
	bool CollisionRayPathChange(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == -1) return true;
		
		int lTarget = cString_GetNumericSuffixInt(asParent)+1;
		if (!Entity_Exists("RayTarget_"+lTarget))
			lTarget = 1;
		
		Critter_SetGroupEntity("Ray", "RayTarget_"+lTarget);
		
		return true;
	}
	
