	{
		StationGui_TextReaderSingle("BunkerLogCaption", "MainBaseLog");
	}
	
	//-------------------------------------------------------
	
	void OnGuiChess(const tString &in asStatsEntry, float afBoardSizeMul = 1.0f)
	{
		bool bChessError = ImGui_GetStateBool("ChessError", false);
		
		//////////////////////
		// GUI Data
		cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
		
		cImGuiLabelData labelData = ImGui_GetDefaultLabel();
		labelData.mFontAlign = eFontAlign_Center;
		labelData.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Additive));
		
		cImGuiButtonData button = StationGui_CreateDefaultButtonData();
		button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0375);
		button.mbClipText = false;
		
		ImGui_GroupBegin(ImGui_NrmPosGroup(0.3, 0.025, 1), ImGui_NrmSizeGroup(0.45*afBoardSizeMul, 0.855));
			ImGui_SetModColorMul(gStationGuiColor_Normal*0.9);
			cImGuiGfx board = cImGuiGfx("chessboard");
			ImGui_DoImage(board, ImGui_NrmPosGroup(cVector3f(0, 0.155, 1)), ImGui_GetRatioCorrectSizeByNrmWidth(board, 1));
			ImGui_SetModColorMul(cColor_White);
			
			ImGui_DoLabelExt("ChessGame", labelData, ImGui_NrmPosGroup(cVector3f(0, 0, 1)), ImGui_NrmSizeGroup(cVector2f(1, -1)), 5);
		ImGui_GroupEnd();
		
		ImGui_DoWindowStart("", windowData, ImGui_NrmPosGroup(cVector3f(0.025, 0.155, 1)), ImGui_NrmSizeGroup(cVector2f(0.25, 0.6)));
			
		ImGui_ResizeFontToFit("ChessNewGame", button.mFont, ImGui_GetCurrentGroupSize().x*0.75);
		ImGui_ResizeFontToFit("ChessContinue", button.mFont, ImGui_GetCurrentGroupSize().x*0.75);
		
		ImGui_SetModUseInput(!bChessError);
		if (ImGui_DoButtonExt("ChessNewGameButton", "ChessNewGame", button, ImGui_NrmPosGroup(cVector3f(0.1, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.8, 0.1625))))
		{
			Depth_Audio_Terminal_Error(ImGui_GetName());
			ImGui_SetStateBool("ChessError", true);
		}
		
		ImGui_SetModUseInput(false);
		ImGui_DoButtonExt("ChessContinueButton", "ChessContinue", button, ImGui_NrmPosGroup(cVector3f(0.1, 0.3, 1)), ImGui_NrmSizeGroup(cVector2f(0.8, 0.1625)));
		ImGui_SetModUseInput(!bChessError);
			
/*		if (ImGui_DoButton("ChessExitButton", "ChessExit", ImGui_NrmPosGroup(cVector3f(0.1, 0.35, 1)), ImGui_NrmSizeGroup(cVector2f(0.8, 0.13))))
		{
			ImGui_SetStateInt("CurrentState", 0);
		}*/
		
		ImGui_DoTextFrameExt(asStatsEntry, ImGui_NrmSizeGroup(cVector2f(0.1, 0.05)), 5, 0, StationGui_CreateDefaultTextFrameData(), 
							 ImGui_NrmPosGroup(cVector3f(0, 0.5, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
		
		ImGui_DoWindowEnd();
		ImGui_SetModUseInput(true);
		
		if (bChessError)
		{
			cGuiDialogBoxSettings dialogBox = StationGui_CreateDefaultDialogBox();
			dialogBox.mType = eGuiDialogBoxType_OK;
			dialogBox.mfZ = 5;
			eGuiDialogCode code = Depth_ImGui_DialogBox("GUIError", "ChessError", dialogBox);
			
			if (code == eGuiDialogCode_OK)
			{
				ImGui_SetStateBool("ChessError", false);
				Depth_Audio_Terminal_Forward(ImGui_GetName());
			}
		}
	}
 
