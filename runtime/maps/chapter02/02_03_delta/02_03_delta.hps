bool _HPL3VR_DeltaManualBaton()
{
	cScript_SetGlobalReturnBool(false);
	cScript_RunGlobalFunc("MenuHandler", "cScrMenuHandler", "HPL3VR_GetRuntimeActive");
	return cScript_GetGlobalReturnBool();
}

class cScrMap : iScrMap
{
	//--------------------------------------------

	/////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	/////////////////////////////////////////

	//--------------------------------------------
	
	////////////////////////////
	// Run first time starting map
	void OnStart()
	{		
		bool bDoIntro = true;
		
		//----DEBUG----//
		if(cLux_ScriptDebugOn())
		{			
			bDoIntro = false;			
			Trigger_GoyaStart("", "", 1);
			Entity_SetActive("Trigger_MusicBunker_*", true);
			Map_AddTimer("StartAmbient", cMath_RandRectf(5.f,8.f), "AmbientMusicHandler");
		}
			
		SetupSceneAwakenRobotRelay();
		if (bDoIntro)
		{
			///////////////////////////////////////////////////
			//// Do after crash as start scene instead (old start is now in 2.2)	
			Sound_SetGlobalVolume(0.0f, eSoundEntryType_WorldAll);
			mbAmbientMusicAllowed = false;
			Player_SetActive(false);
			Effect_Fade_Out(0);
			
			Map_AddTimer("StartAfterCrash", 6.0f, "TimerStartAfterCrash");		
			Map_AddTimer("WakeUpSound", 0.0f, "WakeUpDreamSound");
			
		}
		else
		{
			StartSceneAwakenRobotRelay(false);
		}
		
		//////////////////////////////////////////
		// CathTool initial state (not in setup - would screw the transition scene)
		CathTool_ResetScreen(eCathToolVariant_CathDelta);
		CathTool_SetDisabled("CathTool_Crashed", true);
		CathTool_SetChipBroken(true);
		
		//////////////////////////////////////////
		// Player setup
		Player_SetAmbientLight_Outdoors();
		
		PlayerHands_SetHandModel_Diving();
		
		SetupExploreLaunchSite();
		SetupExploreRocketConstruction();
		SetupExploreReefAndConstructionSite();
		SetupActivateMainBase();
		SetupSubBase2();
		SetupKillRobot();
		
		Critter_AddExtraEscapeEntity("Shoal_*", "Kate");	
		
		///////////////////////////////////////////////////
		///Fade in audio
		Music_Stop(12.0f, eMusicPrio_BigEvent);
		
		
		///////////////////////////////////////////////////
		///Entities
		Entity_SetInteractionDisabled("transformer_cabinet_electricity_1", true);
		Prop_SetAllowMapTransfer("StunRodLockboxLid", false);
		
		Sound_PreloadGroup("Flashback/Level/02_03", true);
		Sound_PreloadProject("02_03_delta");
		
		LastOnSoma_SetText("02_03_delta_1");
		
		/////////////////////////
		// Eye tracking
		EyeTracking_RegisterEntity("MaggieDatamineAux", true, false, true, 15.0f, 3.0f);
		EyeTracking_RegisterEntity("CorpseDatamineAux", true, false, true, 15.0f, 3.0f);
		EyeTracking_RegisterEntity("mindcoral_victim", true, false, true, 15.0f, 3.0f);
	}
	
