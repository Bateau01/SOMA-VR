			Prop_MoveLinearTo("Moray", "Moray_In", 1, 0.5, 0.2, false);
		}
		else
		{
			Map_AddTimer("MorayUnhide", 2, "TimerDelayMorayUnhide");
		}
		return true;
	}
	
