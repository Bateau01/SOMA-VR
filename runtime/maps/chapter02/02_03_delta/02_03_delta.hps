    // Terminal *Launch Computer*
    /////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbSentLaunchBunkerDraft = false;
	bool mbSawMessageError = false;
	
	//-------------------------------------------------------
	
	void OnGuiLaunchBunkerTerminal(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("02_03_delta");
		
		// Draw background
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		StationGuiBG_Taskbar("delta");
		
		if (StationGui_DrawAndCheckErrors())
			return;
			
		int lActiveApp = StationGui_GetActiveApp(eBunkerTerminalApp_Log);
		bool bBackButton = true;
		switch(lActiveApp)
		{
			case eBunkerTerminalApp_MainMenu:
			StationGui_AddApp("BunkerApp_Log");
			StationGui_AddApp("BunkerApp_Messages");
			StationGui_AddApp("BunkerApp_Map");
			StationGui_MainMenu();
			bBackButton = false;
			break;
			
			case eBunkerTerminalApp_Log:
			StationGui_TextReaderSingle("BunkerLogCaption", "BunkerLog");
			break;
			
			case eBunkerTerminalApp_Messages:
			Depth_ImGui_AddMail("BunkerDraftName", "BunkerDraft", "", "", eMailAppEntryType_Draft);
			StationGui_MailApp("SendMail_BunkerDraft");
			//OnGuiLaunchBunkerTerminal_Messages();
			break;
			
			case eBunkerTerminalApp_Map:
			OnGuiLaunchBunkerTerminal_Map(cVector2f(0.465, 0.495), cVector2f(0.375, 0.4125));
			break;
		}
		
		StationGui_BackButton(bBackButton);
	}
	

	//-------------------------------------------------------
		
	bool SendMail_BunkerDraft(const tString &in asTitle)
	{
		StationGui_SetError("ErrorMsg_BunkerMessageFailed");
		return false;
	}
					
 
    //-------------------------------------------------------
	
	void OnGuiLaunchBunkerTerminal_Messages()
	{
		StationGuiBG_Backdrop();
		StationGuiBG_Scanlines();
		
		/////////////
		// Data
		cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
		windowData.mColorText = cColor(0.2, 1);
		//windowData.mfCaptionSizeMul = 1.5;
		
		cImGuiButtonData buttonData = StationGui_CreateDefaultButtonData();
		buttonData.mFont.mvSize = cVector2f(28, 28);
		buttonData.mColorText = cColor(0.8, 1);
		ImGui_SetDefaultButton(buttonData);
		
		cImGuiTextFrameData textData;
		textData.mbUseBackgroundGfx = false;
		textData.mFont.mvSize = cVector2f(24, 24);
		textData.mFont.mColor = cColor(0.7, 1);
		
		ImGui_DoWindowStart("BunkerMessages_0", windowData, ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.23, 0.75)));
			if (!mbSentLaunchBunkerDraft)
				ImGui_DoButton("DraftButton", "BunkerDraftName", ImGui_NrmPosGroup(cVector3f(0.1, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.8, 0.12)));
		ImGui_DoWindowEnd();
		
		ImGui_DoWindowStart("BunkerDraftName", windowData, ImGui_NrmPosGroup(cVector3f(0.3, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.65, 0.75)));
			if (!mbSentLaunchBunkerDraft)
			{
				ImGui_DoTextFrameExt("BunkerDraft", ImGui_NrmSizeGroup(cVector2f(0.05, 0.05)), 5, 0, textData, 
									 ImGui_NrmPosGroup(cVector3f(0, 0, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
									 
				if (ImGui_DoButton("SendButton", "GUISend", ImGui_NrmPosGroup(cVector3f(0.7, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.25, 0.125))))
				{
					StationGui_SetError("ErrorMsg_BunkerMessageFailed");
				}
			}
			else
			{
				textData.mFontAlign = eFontAlign_Center;
				ImGui_DoTextFrameExt("BunkerNoMessages", ImGui_NrmSizeGroup(cVector2f(0.05, 0.05)), 5, 0, textData, 
									 ImGui_NrmPosGroup(cVector3f(0, 0.4, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			}
		ImGui_DoWindowEnd();
	}
	

	void OnGuiLaunchBunkerTerminal_Map(const cVector2f &in vZoomOutPos, const cVector2f &in vZoomInPos)
	{
		bool bZoomedIn = ImGui_GetStateBool("ZoomedIn", false);
		
		cImGuiGfx image;
		if (bZoomedIn)
		{
			image = cImGuiGfx("map_delta", eImGuiGfx_Texture);
			image.mvUVMax = cVector2f(1, 0.84); // compensate for image not being centered due to power of 2. 
		}
		else
		{
			image = cImGuiGfx("zeppelin_map", eImGuiGfx_Texture);
			//image.mvUVMax = cVector2f(1, 0.84);
		}
		
		tString sZoomEntry = bZoomedIn ? "BunkerMapZoom_Out" : "BunkerMapZoom_In";
		
		ImGui_DoWindowStart("BunkerApp_Map", StationGui_CreateDefaultWindowData(), 
							ImGui_NrmPos(cVector3f(0.02, 0.02, 1)), ImGui_NrmSize(cVector2f(0.96, 0.775f)));
				
				cVector2f vImageSize = ImGui_GetRatioCorrectSizeByRect(image, ImGui_NrmSizeGroup(0.6, 0.95), true);
				
				cVector3f vImagePos = cVector3f_Forward;
				vImagePos = ImGui_NrmPosGroup(cVector3f(0.05, 0, 1));
				vImagePos.y += (ImGui_GetCurrentGroupSize().y-vImageSize.y)*0.5f;
				vImagePos.x += (ImGui_GetCurrentGroupSize().x*0.65-vImageSize.x)*0.5f;
				
				ImGui_GroupBegin(vImagePos, vImageSize);
				
				if (bZoomedIn==false)
				{
					ImGui_SetModColorMul(cColor_White*0.9);
					StationGui_YouAreHereIcon(ImGui_NrmPosGroup(cVector3f(vZoomOutPos.x, vZoomOutPos.y, 1.2)), ImGui_NrmSizeGroupKeepRatio(0.15));
					ImGui_SetModColorMul(cColor_White);
				}
				else
				{
					StationGui_YouAreHereIcon(ImGui_NrmPosGroup(cVector3f(vZoomInPos.x, vZoomInPos.y, 1.2)), ImGui_NrmSizeGroupKeepRatio(0.125));
				}
				
				//vImagePos.x = (vImagePos.x-vImageSize.x)*0.5f;
				ImGui_DoImage(image, 0, ImGui_NrmSizeGroup(1));
				ImGui_GroupEnd();
				
				cVector3f vButtonPos = ImGui_NrmPosGroup(cVector3f(0.70, 0.75, 1.2));
				cVector2f vButtonSize = ImGui_NrmSizeGroup(0.975, 0.15)-(cVector2f_Right*vButtonPos.x);
				cImGuiButtonData button = StationGui_CreateDefaultButtonData();
				button.mbClipText = false;
				button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.05);
				ImGui_ResizeFontToFit(sZoomEntry, button.mFont, vButtonSize.x*0.8);
				if(ImGui_DoButtonExt("ZoomButton", sZoomEntry, button, 
									 vButtonPos, vButtonSize))
				{
					if (!bZoomedIn) Depth_Audio_Terminal_Forward(ImGui_GetName());
					else			Depth_Audio_Terminal_Back(ImGui_GetName());
					ImGui_SetStateBool("ZoomedIn", !bZoomedIn);
				}
		ImGui_DoWindowEnd();
	}
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Terminal *Zeppelin Computer*
    /////////////////////////////////////////
	
	//-------------------------------------------------------
	
	int mlContactedZeppelin = 0;
	int mlZeppelin3ContactCounter = 1;
	int mlZepScreenResetUIPos = -1;
	
	//-------------------------------------------------------
	
	void OnGuiZeppelinComputer(const tString&in asEntityName, float afTimeStep)
	{		
		///////////////////////
		// Data
		cImGuiButtonData buttonData = StationGui_CreateDefaultButtonData();
		buttonData.mFont.mvSize = cVector2f(20, 20);
		ImGui_SetDefaultButton(buttonData);
		
		ImGui_SetTransCategory("02_03_delta");
				
		// Draw background
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		if (StationGui_DrawAndCheckErrors()) return;
		
		bool bBackButtonEnabled = true;
		int lActiveApp = StationGui_GetActiveApp(0);
		
		/////////////////////////
		// States
		switch (lActiveApp)
		{
			case 0:
				ZeppelinComputerMenu();
				bBackButtonEnabled = false;
				break;
			case 1:
				StationGui_TextReaderSingle("GUIManifest", "ManifestText");
				break;
			case 2:
				ZeppelinComputerZeppelinStatusScreen();
				bBackButtonEnabled = mlContactedZeppelin==0;
				break;
			case 3:
				ZeppelinComputerSignalStatusScreen();
				break;
			case 5:
				ZeppelinComputerTransmissions(asEntityName, afTimeStep);
				break;
		}
		
		StationGuiBG_Taskbar("delta");
		if (StationGui_BackButton(bBackButtonEnabled, 0))
			Depth_ImGui_StopAudioFilePlayback(ImGui_GetName());
		
		///////////////////////
		// Zeppelin on route
		if (mbZeppelinOnRoute || mbZeppelinArrived)
		{
			cImGuiLabelData labelData = ImGui_GetDefaultLabel();
			labelData.mFontAlign = eFontAlign_Center;
			labelData.mFont.mColor = ImGui_FadeOscillateColor("ZeppelinOnRouteColor", cColor(0.3, 0.8, 0.3, 1), cColor(0.1, 0.4, 0.1, 1), 1.5);
			ImGui_DoLabelExt(mbZeppelinArrived ? "TransportCallStep_8" : "TransportCallStep_7", labelData, 
						     ImGui_NrmPos(cVector3f(0, 0.825, 1)), ImGui_NrmSize(cVector2f(1, 0.05)), 1.3);
		}
	}
	
	//-------------------------------------------------------
	
	void ZeppelinComputerMenu()
	{		
		StationGui_AddApp("GUIManifest", true, 1);
		StationGui_AddApp("GUIZeppelinStatus", true, 2);
		StationGui_AddApp("GUISignalStatus", true, 3);
		StationGui_AddApp("GUITransmissions", true, 5);
		StationGui_MainMenu();
	}
	
	//-------------------------------------------------------
	
	bool DoMainMenuSelectionButton(const tString &in asText, float afPosition, float afHeight)
	{
		if (ImGui_DoButton(asText, asText, ImGui_NrmPosGroup(cVector3f(0, afPosition, 1)), ImGui_NrmSizeGroup(cVector2f(1, afHeight))))
		{
			Depth_Audio_Terminal_Forward(ImGui_GetName());
			return true;
		}
		return false;
	}
	
	//-------------------------------------------------------
	
	void ZeppelinComputerZeppelinStatusScreen()
	{		
		///////////////////////
		// Data		
		cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
		windowData.mFont.mColor = cColor(0.4, 1);
		
		if (ImGui_TimerOver("StartZeppelinContact"))
		{
			switch (mlContactedZeppelin)
			{
				case 1:
				StationGui_StartVoicePlayback(ImGui_GetName(), "7_ZeppelinContact_1", "");
				break;
				
				case 2:
				
				//TEMP
				StationGui_SetError("ErrorMsg_WrongZeppelin");
				mlContactedZeppelin = 0;
				//TEMP
				break;
				
				case 3:
				if (mlZeppelin3ContactCounter==4)
				{
					StationGui_SetError("ErrorMsg_WrongZeppelin");
					mlContactedZeppelin = 0;
				}
				else
				{
					StationGui_StartVoicePlayback(ImGui_GetName(), "7_ZeppelinContact_3_" + mlZeppelin3ContactCounter, "");
					mlZeppelin3ContactCounter = cMath_Min(mlZeppelin3ContactCounter+1, 4);
				}
				break;
			}
		}
		if (Depth_ImGui_CheckAudioFilePlaybackEnd())
		{
			ImGui_AddTimer("EndZeppelinContact", 1);
		}
		if (ImGui_TimerOver("EndZeppelinContact"))
		{
			mlContactedZeppelin = 0;
		}
		
		tString sNewFocus = "";
		////////////////////////////////////////////////
		// Reset focus after contact attempt if using gamepad
		if (mlZepScreenResetUIPos >= 0 && ImGui_ActionIsDown(eImGuiAction_Confirm, true))
		{
			int lZep = (mlZepScreenResetUIPos/2)+1;
			int lButton = mlZepScreenResetUIPos%2;
			if (lButton==0) sNewFocus = "ContactZeppelin_" + lZep;
			else			sNewFocus = "RequestTransport_" + lZep;
			
			mlZepScreenResetUIPos = -1;
		}
		
		//////////////////////
		// Status screen
		ImGui_SetModUseInput(mlContactedZeppelin == 0);
		ImGui_GroupBegin(ImGui_NrmPos(cVector3f(0.1, 0.05, 1.5)), ImGui_NrmSize(cVector2f(0.8, 0.75)));
			DoZeppelinStatusWindow(1, mbZeppelinOnRoute ? "Zeppelin_1_Moving" : "Zeppelin_1_Idle", windowData);
			DoZeppelinStatusWindow(2, "Zeppelin_2_Status", windowData);
			DoZeppelinStatusWindow(3, "Zeppelin_3_Status", windowData);
		ImGui_GroupEnd();
		ImGui_SetModUseInput(true);
		
		if (sNewFocus != "") ImGui_SetFocus(sNewFocus);
	}
	
	//-------------------------------------------------------
	
	void DoZeppelinStatusWindow(int alZeppelin, const tString &in asStatus, cImGuiWindowData@ apWindowData)
	{		
		cImGuiTextFrameData textData = StationGui_CreateDefaultTextFrameData();
		
		int lConnectedZeppelin = GetAntennaConnectedZeppelin("Antenna_Peripheral1");
		apWindowData.mfPaddingLeft = 0;
		apWindowData.mfPaddingTop = 0;
		
		ImGui_DoWindowStart("Zeppelin_" + alZeppelin, apWindowData, ImGui_NrmPosGroup(cVector3f(0, 0.333*(alZeppelin-1), 0.1)), ImGui_NrmSizeGroup(cVector2f(1, 0.32)));
			ImGui_DoTextFrameExt(asStatus, ImGui_NrmSizeGroup(cVector2f(0, 0)), 0, 0, textData, 
								 ImGui_NrmPosGroup(cVector3f(0.05, 0.25, 0.1)), ImGui_NrmSizeGroup(cVector2f(1, 1)));
						
			///////////////////
			// Contact button
			ImGui_SetModUseInput(mbZeppelinOnRoute==false && mlContactedZeppelin==0);
			
			if (ImGui_DoButton("ContactZeppelin_" + alZeppelin, "GUIContact", 
				ImGui_NrmPosGroup(cVector3f(0.45, 0.1, 0.1)), ImGui_NrmSizeGroup(cVector2f(0.37, 0.32))))
			{			
				if (mlContactedZeppelin == 0)
				{
					if (alZeppelin == lConnectedZeppelin)
					{	
						Depth_Audio_Terminal_Confirm(ImGui_GetName());	
						mlContactedZeppelin = alZeppelin;
						ImGui_AddTimer("StartZeppelinContact", 2);
					}
					
					else
					{
						mlZepScreenResetUIPos = (alZeppelin-1)*2;
						StationGui_SetError("ErrorMsg_NoSignal");
					}
				}
			}
			
			///////////////////
			// Transport button
			if (ImGui_DoButton("RequestTransport_" + alZeppelin, "GUITransport", 
				ImGui_NrmPosGroup(cVector3f(0.45, 0.5, 0.1)), ImGui_NrmSizeGroup(cVector2f(0.37, 0.32))))
			{
				if (lConnectedZeppelin!=alZeppelin)
				{
					StationGui_SetError("ErrorMsg_NoSignal");
					mbZeppelinCallFailed = true;
					mlZepScreenResetUIPos = (alZeppelin-1)*2+1;
				}
				else if (alZeppelin==1)
				{
					Depth_Audio_Terminal_Forward(ImGui_GetName());
					
					Terminal_SetUpdateWhenOutOfView("ZeppelinComputer", true);
					mbZeppelinOnRoute = true;
					Map_AddTimer("TimerZepCalled",0.5f,"TimerZepCalled");
				}
				else if (alZeppelin==3 || alZeppelin==2)
				{
					Sound_CreateAtEntity("TerminalNegative", "Entities_Station/tech/terminal_beeps/underwater/terminal_computer_denied", ImGui_GetName(), 0.0f, false, 1.0f);
					StationGui_SetError("ErrorMsg_NoResponse");
					mbZeppelinCallFailed = true;
					mlZepScreenResetUIPos = (alZeppelin-1)*2+1;
				}
			}
			ImGui_SetModUseInput(true);
		ImGui_DoWindowEnd();
	}
	
	//-------------------------------------------------------
	
	void TimerZepCalled(const tString& in asName)
	{
		Sound_CreateAtEntity("CodeInputConfirm", "Entities_Station/tech/terminal_beeps/underwater/terminal_confirm", "ZeppelinComputer", 0.0f, false, 1.0f);
		Map_AddTimer("7_CalledZeppelin", 0.5, "TimerPlayVoice");
		
		/////////////////////////////////////////////////////
		//trigger puzzle success music
		Map_AddTimer("StopAmbientMusicQuickly", 0.25f, "AmbientMusicHandler");
		Map_AddTimer("PuzzleSuccessMusic", 2.5f, "PuzzleSuccessMusic");

		SequenceZeppelinArrives("");
		Terminal_SetUpdateWhenOutOfView("ZeppelinComputer", false);
		
		Sound_PreloadProject("NPC_Zeppelin");
	}
		
	//-------------------------------------------------------
	
	void PuzzleSuccessMusic(const tString &in asTimer)
	{
		Music_Play("02_03_antenna_success", 0.8f, false, eMusicPrio_BigEvent);
	}
	
	//-------------------------------------------------------
	
	void VoiceZeppelinContact(const tString&in asScene, const tString&in asSubject)
	{
		mlContactedZeppelin = 0;
	}
	
	//-------------------------------------------------------
	
	void ZeppelinComputerSignalStatusScreen()
	{	
		////////////////////////
		// Data
		cImGuiTextFrameData textData;
		textData.mbUseBackgroundGfx = false;
		textData.mFont.mvSize = cVector2f(16, 16);
		textData.mFontAlign = eFontAlign_Center;
		textData.mColorText = cColor(0.8, 1);
		ImGui_SetDefaultTextFrame(textData);
		
		cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
		windowData.mColorText = cColor(0.4, 1);
		
		ImGui_DoWindowStart("GUISignalStatus", windowData, ImGui_NrmPos(cVector3f(0.1, 0.025, 1.5)), ImGui_NrmSize(cVector2f(0.8, 0.8)));
		
			//////////////////
			// Map
			ImGui_GroupBegin(ImGui_NrmPosGroup(cVector3f(0, 0.1, 0)), ImGui_NrmSizeGroup(cVector2f_One));
				ImGui_DoImage(cImGuiGfx("transportcontrol_antennalayout", eImGuiGfx_Texture), ImGui_NrmPosGroup(cVector3f(0, -0.0875, 0.3)), ImGui_NrmSizeGroup(1));
				
				// Positions
				cVector3f vPlatformPos = cVector3f(0.48, 0.48, 0.5);
				cVector3f vAntennaOffset = cVector3f(-0.03, 0.02, 0);
				cVector3f vCurrentZeppelinDelta = Entity_GetDeltaToEntity("ZeppelinTargetPos_2", "ZeppelinPlatform");
				vCurrentZeppelinDelta.y = 0;
				float fCurrentZeppelinDistance = vCurrentZeppelinDelta.Length();
				cVector3f vZeppelin1IconOffset = gvZeppelinPosition_1*(fCurrentZeppelinDistance/mfInitialZeppelinDistance);
				cVector3f vZeppelin2IconOffset = gvZeppelinPosition_2;
				cVector3f vZeppelin3IconOffset = gvZeppelinPosition_3;
				
				// Antennas
				DoSignalTowerIcon(vPlatformPos+vAntennaOffset, "Peripheral1");
				
				// Zeppelins
				DoZeppelinIcon(1, vPlatformPos + vZeppelin1IconOffset, gZeppelinColor_1);
				DoZeppelinIcon(2, vPlatformPos + vZeppelin2IconOffset, gZeppelinColor_2);
				DoZeppelinIcon(3, vPlatformPos + vZeppelin3IconOffset, gZeppelinColor_3);
			ImGui_GroupEnd();
				
			
			///////////////////
			// Strength gauge
			ImGui_GroupBegin(ImGui_NrmPosGroup(cVector3f(0.015, 0.86, 1)), ImGui_NrmSizeGroup(cVector2f(0.375, 0.125)));
				ImGui_DoLabel("SignalStrength", ImGui_NrmPosGroup(cVector3f(0, 0, 1)));
				cImGuiGaugeData gaugeData = StationGui_CreateDefaultGaugeData();
				
				float fSignalStrength = 0.01;
				if (GetAntennaConnectedZeppelin("Antenna_Peripheral1")!=-1)
					fSignalStrength = 1;
				ImGui_DoGauge(gaugeData,  Depth_ImGui_GetOscillatingSignalValue("SignalStrength", 0, eEasing_Linear, fSignalStrength*0.97, fSignalStrength, 0.5), 
							  ImGui_NrmPosGroup(cVector3f(0, 0.33, 1)), ImGui_NrmSizeGroup(cVector2f(1, 0.66)));
			ImGui_GroupEnd();
			
			///////////////////
			// Status text
			textData.mFontAlign = eFontAlign_Left;
			textData.mbUseBackgroundGfx = true;
			textData.mColorBase = cColor(0, 0.5);
			textData.mFont.mColor = cColor(1, 0.14, 0.14, 1);
			textData.mFont.mvSize = cVector2f(20, 20);
			ImGui_DoTextFrameExt("NoAutomaticAlignment", ImGui_NrmSizeGroup(cVector2f(0.025, 0.025)), 0, 0, textData, ImGui_NrmPosGroup(cVector3f(0, 0, 1)), ImGui_NrmSizeGroup(cVector2f(0.525, 0.225)));
			if (GetAntennaConnectedZeppelin("Antenna_Peripheral1") != -1)
			{
				textData.mbUseBackgroundGfx = false;
				textData.mFont.mColor = cColor(0.8, 1);
				textData.mFontAlign = eFontAlign_Right;
				ImGui_DoTextFrameExt("SignalFull", 0, 0, 0, textData, ImGui_NrmPosGroup(cVector3f(0, 0.925, 1)), ImGui_NrmSizeGroup(cVector2f(0.95, 0.225)));
			}
		ImGui_DoWindowEnd();
	}
	
	//-------------------------------------------------------
	
	void DoSignalTowerIcon(const cVector3f &in avPos, const tString &in asLocation)
	{
		bool bActive = true;
		
		cColor iconCol = cColor(0.15, 0.8, 0.2);
		cVector3f vScreenPos = ImGui_NrmPosGroup(avPos);
		
		ImGui_SetModColorMul(iconCol);
		cImGuiGfx antenna = cImGuiGfx("transportcontrol_icon_antenna");
		cVector2f vAntennaSize = ImGui_NrmSizeKeepRatio(cVector2f(0.05, 0.05));
		antenna.mvOffset = cVector3f(-vAntennaSize.x*0.5, -vAntennaSize.y, 0);
		ImGui_DoImage(antenna, vScreenPos, vAntennaSize);

		////////////////////////////////
		// Arrow
		bool bAligned = GetAntennaConnectedZeppelin("Antenna_"+asLocation) != -1;
		cColor arrowCol = (bAligned ? cColor(0.2, 0.2, 1, 0.35) : cColor(0.4, 0.3, 0.8, 0.25));
		cVector2f vArrowSize = ImGui_NrmSizeGroupKeepRatio(cVector2f(0.225, 0.37));
		cImGuiGfx arrow = cImGuiGfx("transportcontrol_antenna_cone");
		arrow.mvOffset = cVector3f(-vArrowSize.x*0.5, -vArrowSize.y, 0);
		
		ImGui_SetModRotateCustomPivot(true);
		cVector3f vOffset3 = ImGui_GetCurrentGroupPos();
		ImGui_SetModRotatePivot(cVector2f(vScreenPos.x+vOffset3.x+vArrowSize.x*0.5, vScreenPos.y+vOffset3.y+vArrowSize.y));
		ImGui_SetModRotateAngle(GetAntennaRotation("Antenna_"+asLocation));
		//ImGui_SetModRotateAngle(gfZeppelinAngle_1);
		ImGui_SetModColorMul(arrowCol);
		ImGui_DoImage(arrow, vScreenPos-cVector3f_Forward*0.1, vArrowSize);
		
		ImGui_ResetModifiers();
	}
	
	//-------------------------------------------------------
	
	void DoZeppelinIcon(int alZeppelin, const cVector3f &in avPos, const cColor &in aColor)
	{
		cImGuiGfx zeppelin = cImGuiGfx("transportcontrol_icon_zeppelin");
		cVector2f vZeppelinSize = ImGui_NrmSizeKeepRatio(cVector2f(0.05, 0.05));
		zeppelin.mvOffset = cVector3f(-vZeppelinSize.x*0.5, -vZeppelinSize.y, 0);
		
		ImGui_SetModColorMul(aColor);
		ImGui_DoImage(zeppelin, ImGui_NrmPosGroup(avPos), vZeppelinSize);
		ImGui_SetModColorMul(cColor_White);
		
		ImGui_DoTextFrame("Zeppelin_"+alZeppelin+"_Map", cVector2f_Zero, -3, 0, ImGui_NrmPosGroup(avPos)+cVector3f(-vZeppelinSize.x*0.5, 0, 0), vZeppelinSize);
	}
	
    //-------------------------------------------------------
	
	void ZeppelinComputerTransmissions(const tString&in asEntityName, float afTimeStep)
	{
		int lRestoredFiles = 0;
		
		cStationGui_DataRestorationSettings restoreSettings;
		restoreSettings.msCustomMsgEntry_Error = "ZeppelinCorruptedData_Detected";
		restoreSettings.msCustomMsgEntry_Progress = "ZeppelinCorruptedData_Restoring";
		restoreSettings.msCustomMsgEntry_Result = "ZeppelinCorruptedData_Results";
		if (StationGui_DataRestoration(2, 3, lRestoredFiles, restoreSettings) == false)
		{
			ImGui_SetModColorMul(cColor(1, 0.5));
			ImGui_SetModUseInput(false);
		}
		if (lRestoredFiles>=1) Depth_ImGui_AddAudioFile_Voice("ZeppelinTransmission_1", "7_ZeppelinTransmission_1", "ZeppelinRecordingEnded");
		if (lRestoredFiles>=2) Depth_ImGui_AddAudioFile_Voice("ZeppelinTransmission_2", "7_ZeppelinTransmission_2", "ZeppelinRecordingEnded");
		StationGui_AudioPlaybackApp();
		
		ImGui_SetModColorMul(cColor_White);
		ImGui_SetModUseInput(true);
	}
 
    //-------------------------------------------------------
	
	void ZeppelinRecordingEnded(const tString&in asScene, const tString&in asSubject)
	{
		OnGuiStopPlayback("ZeppelinComputer", "Recording", false);
	}
 
