	{
		return asEntity == "RelayStationLeverHolder";
	}

	//-------------------------------------------------------
	
	bool ToolUseLever(const tString &in asTool, const tString &in asEntity)
	{
		// Replace broken entity with fixed entity
		Prop_SetActiveAndFade("RelayStationLeverFixed", true, 0.5f);
		Map_AddTimer("RelayStationLeverHolder", 0.5f, "TimerDisableEntity");
		
		////////////////////
