    /////////////////////////////////////////
    // Scene 8 Event A *Datamine Exposed Blackbox (dialog)*
    /////////////////////////////////////////
 
    //-------------------------------------------------------
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 8 Event B *Insert Catherine (dialog)*
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	bool CanUseCathTool(const tString &in asTool, const tString &in asEntity)
	{
		return asEntity=="ZeppelinCathTerminal" || asEntity=="CatherineSlotInteract";
	}
 
    //-------------------------------------------------------
	
	bool OnUseCathTool(const tString &in asTool, const tString &in asEntity)
	{
		cLux_AddDebugMessage("Tool: "+asTool);
		
		CathTool_Insert(asTool, "ZeppelinCathTerminal");
		CathTool_SetHintsCallback(asTool, "GiveCathHints");
		CathTool_SetHintsEnabled(asTool, true);
		Entity_AttachToEntity(asTool, "ZeppelinPlatform", "", true);
		Prop_SetActiveAndFade("CathChip_Old", true, 0.5);
		Voice_SetSource("Catherine", "ZeppelinCathTerminal", 5, 15, true, 15);
		Voice_StopAll();
		
		Entity_SetActive("CatherineSlotInteract", false);
		Terminal_SetGuiActive("TerminalCathZep", true, 0.3);
		
		CathTool_SetDisabled(asTool, false, true);
				
		Dialog_StartConversation("Catherine", asEntity);
		Dialog_Begin();
			Dialog_AddBranchAndSubject("8_InsertCatherineOnPlatform", "", "Subject_CatherineKillExplanation");
		Dialog_End();
		
		//////////////////////////////
		// Setup broken chip effects
		ParticleSystem_CreateAtEntityExt("ZeppelinOmniToolPS_Sparks", "elec_sparks_tiny_continous.ps", "ZeppelinOmniToolSparkPos", false, cColor_White, 2);
		ParticleSystem_SetVisible("ZeppelinOmniToolPS_Sparks", false);
		ParticleSystem_CreateAtEntityExt("ZeppelinOmniToolPS_Bubbles", "loop_waterbubbles_small_stream.ps", "ZeppelinOmniToolBubblePos", false, cColor_White, 1);
		Map_AddTimer("OmniToolFlash", cMath_RandRectf(0.25, 2.0), "Timer_ZeppelinOmniToolFlash");
		Sound_CreateAtEntity("BrokenCathtoolBubbles", "02_03_delta/AMB/Spot/omnitool_bubble_sparks", "ZeppelinOmniToolBubblePos");
		
		return true;
	}
 
    //-------------------------------------------------------
	
	void Subject_CatherineKillExplanation(const tString &in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		
		//////////////////////////////////
		// Setup catherine interaction
		Entity_SetCustomInteractIcon("CatherineSlotInteract", eCrossHairState_Talk);
		Entity_SetPlayerInteractCallback("CatherineSlotInteract", "Interact_TalkToCath", false);
		
		//2 second delay for sound intro of lockbox opening
		Sound_CreateAtEntity("LockboxOpen", "Entities_OceanBottom/stunbox/open", "StunRodLockboxLid", 0, false);
		Map_AddTimer("StunrodBoxOpen", 2.0f, "StunrodBoxOpen");
		
		
		LastOnSoma_SetText("02_03_delta_2");
	}
	
	void StunrodBoxOpen(const tString &in asTimer)
	{
		Lever_SetStuckState("StunRodLockboxLid", 0, true);
		Entity_SetInteractionDisabled("StunRodLockboxLid", true);
		if (Entity_IsInteractedWith("StunRodLockboxLid"))
		{
			Player_ChangeStateToNormal();
			Player_SetLookSpeedMul(0);
			Player_FadeLookSpeedMulTo(1, 1);
		}
		
		///////////////////////////////////////////////////////////////////
		// If the player is clever enough to go back to the broken bots
		Entity_SetPlayerInteractCallback("soma_kate_broken_copy_grab_*", "InteractBrokenKateBots", true);
		
		//////////////////////////////////////////////////////////////////
		// To stop sound from spamming, the force applied + baked sfx is enough
		Entity_SetInteractionDisabled("StunRodInnerHatch", true);
		
		Entity_SetActive("CatherineSlotInteract", true);
	}
 
    //-------------------------------------------------------
	
	void OnChangeLockboxButton(const tString &in asEntity, int alState)
	{
		if (alState != 1) return;
		
		Sound_CreateAtEntity("ButtonPush", "Entities_OceanBottom/button/plastic_red_push", "Player", 0.0f, false, 1.0f);
		Entity_SetInteractionDisabled("StunRodLockboxButton", true);
		
		Slide_SetLocked("StunRodInnerHatch", false, true);
		Entity_AddImpulse("StunRodInnerHatch", cVector3f_Left*0.4f, true, true);
		Sound_CreateAtEntity("StunRodDoorAutoOpen", "Entities_OceanBottom/stunbox/glassdoor/auto_slide", "StunRodInnerHatch", 0.0f, false, 1.0f);
	}
 
    //-------------------------------------------------------
	
	bool PickupStunRod(const tString &in asTool)
	{
		Map_AddTimer(asTool, 0, "TimerStunRodEffectColorDelay"); // Has to be done on the next frame.
		Map_AddTimer("KateUrgingTimer", 15, "TimerCatherineExtraUrging");
		Sound_CreateAtEntity("StunrodPickup", "02_03_delta/SFX/stunrod/pickup", "Player", 0.0f, false, 1.0f);
		Voice_Play("8_TookStunRod");
		mbTookStunRod = true;
		
		Entity_SetActive("GoyaInteract", false);
		
		Map_AddTimer("Timer_StunRodAutoSave", 6, "Timer_StunRodAutoSave");
		
		return true;
	}
	
	void Timer_StunRodAutoSave(const tString &in asTimer)
	{
		Game_AutoSave();
	}
	
	void TimerStunRodEffectColorDelay(const tString &in asTimer)
	{
		Entity_SetEffectBaseColor(_HPL3VR_DeltaManualBaton() ? asTimer : asTimer+"_HudObject", cColor(0,0.977,1,1));
		Entity_SetEffectsActive(_HPL3VR_DeltaManualBaton() ? asTimer : asTimer+"_HudObject", true, false);
	}
 
    //-------------------------------------------------------
	
	tString GiveCathHints(const tString& in asName)
	{
		// Overrides other hints
		if ((mlStunRodHits_Kate+mlStunRodHits_Goya)==0 && !mbCathHasBeenImpatient)
		{
			return "";
		}
		
		// player has not taken stunrod
		if (mbTookStunRod==false)
		{
			return "8_CathHint_NoStunRod";
		}
		
		// player has not hurt a robot
		if ((mlStunRodHits_Kate+mlStunRodHits_Goya)==0)
		{
			return "8_CathHint_HurtRobot";
		}
		
		if ((mlStunRodHits_Kate+mlStunRodHits_Goya) > 0 && mlStunRodHits_Kate < 5 && mlStunRodHits_Goya < 3)
		{
			if (!mbCathHasBeenPushy) return "";
			return "8_CathHint_KillRobot";
		}
		
		if (mbTookChip == false)
		{
			return "8_CathHint_NoChip";
		}
		
		return "";
	}
 
    //-------------------------------------------------------
	
	///////////////////////////////////////////////////////////
	// Keeps these ugly if cases in one place
	void UpdateCathTalkArea()
	{
		bool bActive = false;
		if ((mlStunRodHits_Kate+mlStunRodHits_Goya)==0 && !mbCathHasBeenImpatient)
			bActive = true;
		else if ((mlStunRodHits_Kate+mlStunRodHits_Goya) > 0 && mlStunRodHits_Kate < 5 && mlStunRodHits_Goya < 3 && !mbCathHasBeenPushy)
			bActive = true;
			
		Entity_SetActive("CatherineSlotInteract", bActive);
	}
 
    //-------------------------------------------------------
 
	void Interact_TalkToCath(const tString &in asEntity)
	{
		// Shouldn't happen, but just in case
		if (Voice_SceneIsActive("Dialog"))
			return;
			
		tString sHint = "";
		
		// Overrides other hints
		if ((mlStunRodHits_Kate+mlStunRodHits_Goya)==0 && !mbCathHasBeenImpatient)
		{
			sHint = "8_PushyCatherine_1";
			mbCathHasBeenImpatient = true;
		}
		
		// player has not killed a root
		else if ((mlStunRodHits_Kate+mlStunRodHits_Goya) > 0 && mlStunRodHits_Kate < 5 && mlStunRodHits_Goya < 3 && !mbCathHasBeenPushy)
		{
			sHint = "8_StunningTakingTooLong_1";
			mbCathHasBeenPushy = true;
		}
		
		if (sHint == "") return;
		
		Entity_SetActive(asEntity, false);
		Dialog_StartConversation("Catherine", asEntity);
		Dialog_Begin();
			Dialog_AddBranchAndSubject(sHint, "", "");
		Dialog_End();
	}
	
	void Subject_CathConvoDone(const tString&in asScene, const tString&in asSubject)
	{
		Entity_SetActive("CatherineSlotInteract", true);
	}
 
    //-------------------------------------------------------
	
	void Timer_ZeppelinOmniToolFlash(const tString &in asTimer)
	{
		if (asTimer == "StopFlash")
		{
			OmniToolSparkEffect_Stop("Zeppelin");
			Map_AddTimer("OmniToolFlash", cMath_RandRectf(0.25, 2.0), "Timer_ZeppelinOmniToolFlash");
			return;
		}
		float fTime = OmniToolSparkEffect_Start("Zeppelin");
		Map_AddTimer("StopFlash", fTime, "Timer_ZeppelinOmniToolFlash");
	}
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 8 Event C *Use Stun Rod on Robot*
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	bool mbStunRodCharged = true;
 
    //-------------------------------------------------------
	
	bool CanUseStunRod(const tString &in asTool, const tString &in asEntity)
	{
		return mbStunRodCharged && (asEntity == "Kate" || asEntity == "KateCrashed" || asEntity == "Goya");
	}
 
    //-------------------------------------------------------
	
	bool UseStunRod(const tString &in asTool, const tString &in asEntity)
	{
		Map_AddTimer(asEntity, 0.25, "Timer_StunRodUseDelay");
		if (!_HPL3VR_DeltaManualBaton()) Player_PlayCustomToolAnimation("tool_stunrod_prod", false, "");
		mbStunRodCharged = false;
		
		return false;
	}
	
	void Timer_StunRodUseDelay(const tString &in asTimer)
	{
		if (asTimer == "Kate" || asTimer == "KateCrashed")
		{
			if (mlStunRodHits_Kate+mlStunRodHits_Goya==0)
				Timer_KateScaredByHit("");
				
			UseStunRod_Kate("StunRod", asTimer);
		}
		else
		{
			if (mlStunRodHits_Kate+mlStunRodHits_Goya==0)
            {
                Map_AddTimer("Timer_KateScaredByHit", 0.5, "Timer_KateScaredByHit");
            }
			UseStunRod_Goya("StunRod", asTimer);
		}
		
		SequenceStunRodEffects("");
	}
	
	//-------------------------------------------------------
	
	void Timer_KateScaredByHit(const tString &in asTimer)
	{
		// Only play scream if Kate was hit since otherwise it's hard to tell the screem wasn't coming from Goya
		if (mlStunRodHits_Goya==0)
			Sound_CreateAtEntity("KateOuch", "NPC_Kate/talk/katebot_scream", "Kate", 0, false);
			
		Kate_FleeFromPlayer("Kate", 5, "KateMainBaseHome", 10);
		mbStopKateFollowing = true;
		
		for (int i = 1; i <= 5; i++)
			Map_RemoveTimer("KateIdlePos_" + i);
	}
	
	//-------------------------------------------------------
	bool mbChasingKateMusicActive = false;
	void UseStunRod_Kate(const tString &in asTool, const tString &in asEntity)
	{		
		mlStunRodHits_Kate++;
		switch (mlStunRodHits_Kate)
		{
			case 1:
			if(mbChasingKateMusicActive==false)
			{
				Music_Play("02_03_chasingkate", 0.65f, true, eMusicPrio_SceneAmb);
				mbChasingKateMusicActive = true;
			}
			
			Kate_ReduceHealth("Kate", 0.2f);
			Map_AddTimer("RechargeStunRod", 4, "TimerRechargeStunRod");
			if (mlStunRodHits_Goya == 0)
				Map_AddTimer("8_FirstStunRodHit", 1.5f, "TimerPlayVoice");
			Map_AddTimer("RandomKateScreams", cMath_RandRectf(3,8),"KateHurtRandomScream");
			break;
			
			case 2:
			Sound_CreateAtEntity("KateOuch", "NPC_Kate/talk/katebot_scream", "Kate", 0, false);
			Sound_CreateAtEntity("KateBroken", "NPC_Kate/katebot_engine/katebot_engine_broken", "Kate");
			Kate_FleeFromPlayer("Kate", 8, "KateMainBaseHome", 10);
			Kate_SlowDownFleeSpeed("Kate");
			Kate_ReduceHealth("Kate", 0.2f);
			Map_AddTimer("RechargeStunRod", 4, "TimerRechargeStunRod");
			Sound_Stop("KateScared", 0.0f);
			break;
			
			case 3:
			Sound_CreateAtEntity("KateOuch", "NPC_Kate/talk/katebot_scream", "Kate", 0, false);
			Kate_SlowDownFleeSpeed("Kate");
			Kate_ReduceHealth("Kate", 0.2f);
			Map_AddTimer("RechargeStunRod", 4, "TimerRechargeStunRod");
			Sound_Stop("KateScared", 0.0f);
			break;
			
			case 4:
			Sound_CreateAtEntity("KateOuch", "NPC_Kate/talk/katebot_scream", "Kate", 0, false);
			Entity_AddCollideCallback("Kate", "KateCrashSite", "CollisionBotCrashed");
			Entity_AddCollideCallback("Kate", "KateCrashStopAvoidance", "CollisionCrashBotNoAvoidance");
			//CharMover_SetWallAvoidanceActive("Kate", false);
			Kate_Crash("Kate", "KateCrashSite", "");
			Kate_ReduceHealth("Kate", 0.2f);
			Sound_Stop("KateScared", 0.0f);
			Map_RemoveTimer("RandomKateScreams");
			Music_Stop(5.0f, eMusicPrio_SceneAmb);
			Map_AddTimer("KateDyingSound", 4.0f, "KateDyingLoop");
			break;
			
			case 5:
			/////////////////////////
			// Allow opening Kate
			ParticleSystem_CreateAtEntity("DeadKateSparks", "elec_sparks_katebot.ps", "KateCrashed", false);
			Entity_SetEffectsActive("KateCrashed", false, true);
			Entity_SetInteractionDisabled("KateCrashed", false);
			Lever_SetStuckState("KateCrashed", 0, true);
			
			/////////////////////////
			//Trigger Kate Killed Music and Sound
			Map_RemoveTimer("KateDyingSound");
			Sound_CreateAtEntity("KateOuch", "NPC_Kate/talk/katebot_scream", "Kate", 0, false);
			Map_AddTimer("KateDeathMusic", 6.0f, "TriggerKateDeathMusic");
			Sound_Stop("KateDying", 0.0f);
			
			Map_AddTimer("KateCrashed_Bubbles_1", 0.1, "TimerSetParticlesActive");
			Map_AddTimer("KateCrashed_Bubbles_2", 0.75, "TimerSetParticlesActive");
			Map_AddTimer("KateCrashed_Bubbles_3", 1.8, "TimerSetParticlesActive");
			
			Entity_SetPlayerInteractCallback("soma_kate_broken_copy_grab_*", "", false);
			
			msKilledRobot = "Kate";
			mbHasLastStunrodBeenShot = true;
			
			Entity_SetActive("KateCrashedProximity", true);
			Entity_SetActive("KateKillzone", false);
			
			break;
		}
		
		UpdateCathTalkArea();
	}
	
	//-------------------------------------------------------
	
	void UseStunRod_Goya(const tString &in asTool, const tString &in asEntity)
	{
		mlStunRodHits_Goya++;
		switch (mlStunRodHits_Goya)
		{
			//////////////////////////
			// Goya flees
			case 1:
			Entity_SetActive("BaseAreaTrigger", false);
			Voice_Play("8_GoyaHit", -1, "", 1);
			
			if(mbChasingKateMusicActive==false)
			{
				Music_Play("02_03_chasingkate", 0.65f, true, eMusicPrio_SceneAmb);
				mbChasingKateMusicActive = true;
			}
			Goya_FleeFromPlayer("Goya", 5, "GoyaMainBaseHome", 25);
			Sound_CreateAtEntity("GoyaSpeedSweet", "NPC_Kate/goya_engine/speed_sweet", "Goya");
			Goya_ReduceHealth("Goya", 0.33f);
			Map_AddTimer("RechargeStunRod", 4, "TimerRechargeStunRod");
			
			if (mlStunRodHits_Kate == 0)
				Map_AddTimer("8_FirstStunRodHit", 1.5f, "TimerPlayVoice");
			break;
			
			////////////////////////////////////
			// Goya flees close to crash site
			case 2:
			Voice_Play("8_GoyaHit", -1, "", 2);
			Sound_CreateAtEntity("GoyaBroken", "NPC_Kate/katebot_engine/katebot_engine_broken", "Goya");
			Goya_FleeFromPlayer("Goya", 8, "GoyaMainBaseHome", 10);
			Sound_CreateAtEntity("GoyaSpeedSweet", "NPC_Kate/goya_engine/speed_sweet", "Goya");
			Goya_SlowDownFleeSpeed("Goya");
			Goya_ReduceHealth("Goya", 0.33f);
			Map_AddTimer("RechargeStunRod", 4, "TimerRechargeStunRod");
			Sound_Stop("GoyaScared", 0.0f);
			break;
			
			////////////////////////////////////
			// Goya crashes and dies
			case 3:
			Voice_Play("8_GoyaHit", -1, "", 3);
			Entity_AddCollideCallback("Goya", "GoyaCrashSite", "CollisionBotCrashed");
			Entity_AddCollideCallback("Goya", "GoyaCrashStopAvoidance", "CollisionCrashBotNoAvoidance");
			Sound_CreateAtEntity("GoyaSpeedSweet", "NPC_Kate/goya_engine/speed_sweet", "Goya");
			Goya_Crash("Goya", "GoyaCrashSite", "");
			Goya_ReduceHealth("Goya", 0.4f);
			Sound_Stop("GoyaScared", 0.0f);
			Music_Stop(5.0f, eMusicPrio_SceneAmb);
			
			StartDropStunRodSeq(0.25);
			
			msKilledRobot = "Goya";
			mbHasLastStunrodBeenShot = true;
			
			break;
		}
		
		UpdateCathTalkArea();
	}
	
	//-------------------------------------------------------
	
	void KateHurtRandomScream(const tString &in asTimer)
	{
		Map_AddTimer("RandomKateScreams", cMath_RandRectf(3,8),"KateHurtRandomScream");
		Sound_CreateAtEntity("KateScared", "NPC_Kate/talk/katebot_cower", "Kate", 0, false);
		cLux_AddDebugMessage("Kate scared sound");
	}
 
	void KateDyingLoop(const tString &in asTimer)
	{
		Sound_CreateAtEntity("KateDying", "NPC_Kate/talk/katebot_dying", "KateDyingSoundSource", 0, false);
		cLux_AddDebugMessage("Kate dying loop triggered");
	}
    //-------------------------------------------------------
	bool mbKateDeathMusic = false;
	void TriggerKateDeathMusic(const tString &in asTimer)
	{
		if(mbKateDeathMusic==false)
		{
			Music_Play("02_03_killedkate", 0.65f, false, eMusicPrio_BigEvent);
			cLux_AddDebugMessage("Kate Killed Music Triggered");
			mbKateDeathMusic = true;
		}
		return;
	}	
	
	//-------------------------------------------------------
	
	bool mbHasLastStunrodBeenShot=false;
	
	cSequenceStatesData mStunRodEffectsSequence;
		
	void SequenceStunRodEffects(const tString &in asTimer)
	{
		Sequence_Begin("SequenceStunRodEffects", mStunRodEffectsSequence);
			
		if (Sequence_DoStepAndWait(0.075))
		{
			cCamera@ pCam = cLux_GetPlayer().GetCamera();
			
			//Effect_Flash_Start(0.1, 0, 0.5);
			Effect_ToneMapping_FadeExposure(3, 0.075);
			Effect_Shake_Start(0.05, 0, 0.1, 0.1);
			Effect_Rumble_Start(1, 0.4, 0, 0);
			Sound_CreateAtEntity("UseStunRod", "02_03_delta/SFX/stunrod/fire", "Player", 0, false);
			Entity_SetEffectsActive(_HPL3VR_DeltaManualBaton() ? "StunRod" : "StunRod_HudObject", false, true);
			if (_HPL3VR_DeltaManualBaton())
			{
				iLuxEntity@ pRod = Map_GetEntity("StunRod");
				iLuxEntity@ pPS = Map_GetEntity("StunRodPSArea");
				if (pRod !is null && pRod.GetMainBody() !is null && pPS !is null)
				{
					Entity_RemoveEntityAttachment("StunRodPSArea");
					pPS.SetPosition(cMath_MatrixMul(pRod.GetMainBody().GetWorldMatrix(), cVector3f(-0.199f,-0.00282334f,0)));
					Entity_AttachToEntity("StunRodPSArea", "StunRod", "", true);
				}
			}
			else
			{
			Entity_PlaceAtEntity("StunRodPSArea", "Camera", pCam.GetForward()*0.3+pCam.GetRight()*0.04+pCam.GetUp()*-0.04, false);
			Entity_AttachToEntity("StunRodPSArea", "Camera", "", true);
			}
			ParticleSystem_CreateAtEntityExt("StunRodUsePS", "02_03_stun_rod_usage.ps", "StunRodPSArea", true, cColor_White, 5);
		}
		else if (Sequence_DoStepAndWait(0.075))
		{
			Effect_ToneMapping_FadeExposure(0, 0.075);
		}
		else if (Sequence_DoStepAndWait(0.075))
		{
			Effect_ToneMapping_FadeExposure(4.5, 0.075);
		}
		else if (Sequence_DoStepAndWait(1))
		{
			Effect_ToneMapping_FadeExposure(0, 0.5);
		}
		else if (Sequence_DoStepAndWait(0))
		{
			cLux_AddDebugMessage("Play Powerdown?");
			if (mbHasLastStunrodBeenShot==false)
			{
				cLux_AddDebugMessage("YES?");
				Sound_CreateAtEntity("StunRodOutOfJuice", "02_03_delta/SFX/stunrod/beep_powerdown", "Player", 0, false);
				return;
			}
		}
		Sequence_End();
	}
 
    //-------------------------------------------------------
	
	void TimerRechargeStunRod(const tString &in asTimer)
	{
		if (_HPL3VR_DeltaManualBaton() && mbStunRodDropStarted) { mbStunRodCharged = false; return; }
		mbStunRodCharged = true;
		Sound_CreateAtEntity("RechargeStunRod", "02_03_delta/SFX/stunrod/powerup", "Player", 0, false);
		
		Entity_SetEffectsActive(_HPL3VR_DeltaManualBaton() ? "StunRod" : "StunRod_HudObject", true, true);
	}
 
    //-------------------------------------------------------
	
	bool CollisionCrashBotNoAvoidance(const tString &in asParent, const tString &in asChild, int alState)
	{
		cLux_AddDebugMessage("Disabling Wall Avoidance for: "+asParent);
		CharMover_SetWallAvoidanceActive(asParent, false);
		return false;
	}
    //-------------------------------------------------------
	
	bool CollisionBotCrashed(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (asParent == "Kate")
			Seq_KateCrashed("");
		else
			Seq_GoyaCrashed("");
		return false;
	}
 
    //-------------------------------------------------------
	
	cSequenceStatesData mKateCrashedSequence;
		
	void Seq_KateCrashed(const tString &in asTimer)
	{
		Sequence_Begin("Seq_KateCrashed", mKateCrashedSequence);
			
		if (Sequence_DoStepAndWait(0.2))
		{
			Sound_Stop("KateBroken", 0.15f);
			Sound_CreateAtEntity("KateCrash", "NPC_Kate/sfx/kate_crash", "KateCrashed", 0, false);
			ParticleSystem_CreateAtEntity("KateCrashPS", "katebot_crash.ps", "Kate", false);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Entity_SetInteractionDisabled("KateCrashed", true);
			Entity_SetActive("KateCrashed", true);
			Entity_SetActive("KateChip", true);
			Entity_SetActive("Kate", false);
		}
		else if (Sequence_DoStepAndWait(0))
		{
			Map_AddTimer("RechargeStunRod", 0.75, "TimerRechargeStunRod");
		}
		Sequence_End();
	}
 
    //-------------------------------------------------------
	
	cSequenceStatesData mGoyaCrashedSequence;
		
	void Seq_GoyaCrashed(const tString &in asTimer)
	{
		Sequence_Begin("Seq_GoyaCrashed", mGoyaCrashedSequence);
			
		if (Sequence_DoStepAndWait(0.2))
		{
			Sound_Stop("GoyaBroken", 0.1f);
			
			Sound_CreateAtEntity("GoyaCrash", "NPC_Kate/sfx/goya_crash", "GoyaCrashed", 0, false);
			ParticleSystem_CreateAtEntity("GoyaCrashPS", "katebot_crash.ps", "Goya", false);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Entity_SetInteractionDisabled("GoyaCrashed", true);
			Entity_SetActive("GoyaCrashed", true);
			Entity_SetActive("GoyaLamp_*", true);
			Entity_SetActive("GoyaCrashed_hatch", true);
			Entity_SetActive("GoyaChip", true);
			Entity_SetActive("GoyaChip_Aux", true);
			Entity_SetActive("Goya", false);
			
			/////////////////////////
			//Trigger Goya Killed Music and Sound
			Map_AddTimer("KateDeathMusic", 6.0f, "TriggerKateDeathMusic");
			
			Map_AddTimer("GoyaCrashed_Bubbles_1", 0.1, "TimerSetParticlesActive");
			Map_AddTimer("GoyaCrashed_Bubbles_2", 0.75, "TimerSetParticlesActive");
			Map_AddTimer("GoyaCrashed_Bubbles_3", 1.8, "TimerSetParticlesActive");
			
			Entity_SetPlayerInteractCallback("soma_kate_broken_copy_grab_*", "", false);
		}
		Sequence_End();
	}
 
    //-------------------------------------------------------
	
	void OnChangeKrashedKateOpen(const tString &in asEntity, int alState)
	{
		if (alState == 1)
		{
			Entity_SetActive("KateChipPickupArea", true);
		}
	}
 
    //-------------------------------------------------------
	
	bool InteractTakeKateChip(const tString &in asEntity)
	{
		mbTookChip = true;
		Voice_Play("8_TakingChip");

		Sound_CreateAtEntity("RemoveChipfromKate", "02_03_delta/SFX/voice_chip_remove", "Player", 0.0f, false, 1.0f);

		StartDropStunRodSeq(4.0);

		if (asEntity=="GoyaChip")
		{
			Lamp_SetLit("GoyaLamp_*", false, true);
			Entity_SetActive("GoyaChip_Aux", false);
		}
		else
		{
			Entity_SetActive("KateChipPickupArea", false);
			Entity_SetActive("CatherineSlotInteract", false);
		}

		// AA telemetry only. This does not gate CanUse/OnUse or alter the stock sequence.
		if (_HPL3VR_RuntimeActive_DeltaAA())
			cScript_RunGlobalFunc("VROMNIDELTA", asEntity, "P");

		return true;
	}

    //-------------------------------------------------------

	bool CanUseChip(const tString &in asTool, const tString &in asEntity)
	{
		return asEntity == "CatherineSlotInteract" || asEntity == "CathTool" || asEntity == "ZeppelinCathTerminal";
	}

    //-------------------------------------------------------

	bool OnUseChip(const tString &in asTool, const tString &in asEntity)
	{
		SequenceInsertCatherineChip("");
		return true;
	}

    //-------------------------------------------------------

	bool _HPL3VR_RuntimeActive_DeltaAA()
	{
		cScript_SetGlobalReturnBool(false);
		cScript_RunGlobalFunc("MenuHandler", "cScrMenuHandler", "HPL3VR_GetRuntimeActive");
		return cScript_GetGlobalReturnBool();
	}

	void StartDropStunRodSeq(float afDelay)
	{
		cLux_AddDebugMessage("StartDropStunRodSeq");
		if (mbStunRodDropStarted) return;
		mbStunRodDropStarted = true;
		
		Entity_SetActive("KateCrashedProximity", false);
		Map_AddTimer("DropStunRod", afDelay, "SequenceDropStunRod");
	}
 
    //-------------------------------------------------------
 
	bool mbStunRodDropStarted = false;
	cSequenceStatesData mDropStunRodSequence;
	void SequenceDropStunRod(const tString &in asTimer)
	{
		if (_HPL3VR_DeltaManualBaton())
		{
			// Spent baton stays in the player's hand/storage for a manual drop.
			mbStunRodCharged = false;
			Sound_CreateAtEntity("StunRodOutOfJuice", "02_03_delta/SFX/stunrod/beep_powerdown", "Player", 0, false);
			Entity_SetActive("CatherineToolArea", true);
			Prop_SetAllowMapTransfer("StunRod", false);
			return;
		}
		Sequence_Begin("SequenceDropStunRod", mDropStunRodSequence);
		
		float fBlinkTime = 0.5;
		
		if (Sequence_DoStepAndWait(fBlinkTime))
		{
			cLux_AddDebugMessage("SequenceDropStunRod 1");
			mbStunRodDropStarted = true;
			
			Player_EquipTool("StunRod");
			
			Entity_RemoveEntityAttachment("StunRod");
			
			Sound_CreateAtEntity("StunrodPowerOut", "02_03_delta/SFX/stunrod/powerout_beep", "Player", 0.0f, false, 1.0f);
			Entity_SetEffectBaseColor("StunRod_HudObject", cColor_Red);
			Entity_SetEffectsActive(_HPL3VR_DeltaManualBaton() ? "StunRod" : "StunRod_HudObject", true, false);
			
			// Do this so the chip popping up on the zeppelin doesn't conflict with showing the stun rod.
			Entity_SetActive("CatherineToolArea", false);
		}
		StunRodLowEnergy_Off(fBlinkTime);
		StunRodLowEnergy_On(fBlinkTime);
		StunRodLowEnergy_Off(fBlinkTime);
		StunRodLowEnergy_On(fBlinkTime);
		StunRodLowEnergy_Off(fBlinkTime);
		StunRodLowEnergy_On(fBlinkTime);
		if (Sequence_DoStepAndWait(1))
		{
			cLux_AddDebugMessage("SequenceDropStunRod 3");
			Entity_SetEffectsActive(_HPL3VR_DeltaManualBaton() ? "StunRod" : "StunRod_HudObject", false, true);
		}
		
		if (Sequence_DoStepAndWait(0))
		{
			cLux_AddDebugMessage("SequenceDropStunRod 4");
			if (Player_GetCurrentToolEntityName() == "")
				Player_EquipTool("StunRod");
		}
		
		bool bStunRodEquipped = Player_GetCurrentToolEntityName() == "StunRod";
		float fDelay = bStunRodEquipped ? 2 : 0.3;
		if (Sequence_DoStepAndWait(fDelay))
		{
			cLux_AddDebugMessage("SequenceDropStunRod 5");
			if (bStunRodEquipped)
				Player_UnequipTool(true);
			else
				Player_RemoveTool("StunRod");
		}
		
		if (Sequence_DoStepAndWait(0))
		{
			cLux_AddDebugMessage("SequenceDropStunRod 6");
			
			cCamera@ pCam = cLux_GetPlayer().GetCamera();
			cVector3f vOffset = pCam.GetUp()*-0.5 + pCam.GetForward()*0.2;
			cVector3f vPlayerVel = cLux_GetPlayer().GetAverageMoveDirection()*cLux_GetPlayer().GetAverageMoveSpeed();
			
			Entity_SetActive("StunRod", true);
			Prop_SetAllowMapTransfer("StunRod", false);
			Entity_PlaceAtEntity("StunRod", "Camera", vOffset);
			Prop_DisableCollisionUntilOutsidePlayer("StunRod");
			Prop_SetStaticPhysics("StunRod", false);
			Entity_AddImpulse("StunRod", pCam.GetForward()*3+vPlayerVel, false, true);
			Entity_AddTorque("StunRod", cMath_RandRectVector3f(-5, 5), true, true);
			Entity_SetInteractionDisabled("StunRod", true);
			
			Entity_SetActive("CatherineToolArea", true);
		}
		
		Sequence_End();
	}
	
	void StunRodLowEnergy_Off(float afBlinkTime)
	{
		if (Sequence_DoStepAndWait(afBlinkTime)) 
		{
			Entity_SetEffectsActive(_HPL3VR_DeltaManualBaton() ? "StunRod" : "StunRod_HudObject", false, false);
		}
	}
	
	void StunRodLowEnergy_On(float afBlinkTime)
	{
		if (Sequence_DoStepAndWait(afBlinkTime))
		{
			Sound_CreateAtEntity("StunrodPowerOut", "02_03_delta/SFX/stunrod/powerout_beep", "Player", 0.0f, false, 1.0f);
			Entity_SetEffectsActive(_HPL3VR_DeltaManualBaton() ? "StunRod" : "StunRod_HudObject", true, false);
		}
	}
 
    //-------------------------------------------------------
	
	void LookAt_RemoveStunRod(const tString &in asEntity, int alState)
	{
		if (_HPL3VR_DeltaManualBaton()) return;
		if (mbStunRodDropStarted==false) return;
		
		if (alState == -1)
		{
			Map_AddTimer("Timer_RemoveStunRod", 4, "Timer_RemoveStunRod");
		}
		else
		{
			Map_RemoveTimer("Timer_RemoveStunRod");
		}
		
	}
	
	void Timer_RemoveStunRod(const tString &in asTimer)
	{
		if (_HPL3VR_DeltaManualBaton()) return;
		Entity_SetActive("StunRod", false);
	}
 
    //-------------------------------------------------------
	
	bool Trigger_DropStunRod(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState==1) return true;
		if (mbStunRodDropStarted) return false;
		
		StartDropStunRodSeq(0.25);
		return false;
	}
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 8 Event D *Fix Catherine (dialog)*
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	bool mbCatherineFixed = false;

 
    //-------------------------------------------------------
	
	void InteractInsertChip(const tString &in asEntity)
	{		
		/////////////////////////////
		// Play chip insertion sequence
		SequenceInsertCatherineChip("");
	}
	
    //-------------------------------------------------------
	
	cSequenceStatesData mInsertCatherineChipSequence;
		
	void SequenceInsertCatherineChip(const tString &in asTimer)
	{
		Sequence_Begin("SequenceInsertCatherineChip", mInsertCatherineChipSequence);
			
		if (Sequence_DoStepAndWait(0.6))
		{			
			Player_FadeMoveSpeedMulTo(0, 0.5);
			Prop_MoveLinearTo("CathChip_Old", "CathChip_OldTarget", 1, 0.5, 0, true);
			
			Sound_CreateAtEntity("CathChipInserted", "02_03_delta/SFX/voice_chip_insert", "ZeppelinCathTerminal", 0, false);
		
			//Remove broken chip effects
			Map_RemoveTimer("OmniToolFlash");
			Map_RemoveTimer("StopFlash");
			ParticleSystem_Destroy("ZeppelinOmniToolPS_*");
			Sound_Stop("BrokenCathtoolBubbles", 0.25f);
			
			//////////////////////////////////////////////////////////
			// Start convo here to prevent player from running off
			Voice_StopAll();
			Dialog_StartConversation("Catherine", "CathTool");
			Dialog_Begin();
				Dialog_AddBranch("8_FixCatherine");
					Dialog_AddPause(2);
					Dialog_AddSubject("8_FixCatherine_Start");
					if (msKilledRobot == "Kate")
						Dialog_AddSubject("8_FixCatherine_Kate");
					else
						Dialog_AddSubject("8_FixCatherine_DelusionalRobot");
					Dialog_AddSubject("8_FixCatherine_End", "Subject_CatherineFixed");
			Dialog_End();
		}
		else if (Sequence_DoStepAndWait(0.01))
		{
			Entity_RemoveEntityAttachment("CathChip_Old");
			Prop_SetStaticPhysics("CathChip_Old", false);
			Entity_AddTorque("CathChip_Old", cVector3f_Forward*0.6, true, true);
		}
		else if (Sequence_DoStepAndWait(0.59))
		{
			Entity_AddImpulse("CathChip_Old", cVector3f_Right*0.6, true, true);
		}
		else if (Sequence_DoStepAndWait(0.3))
		{
			Entity_RemoveEntityAttachment("CathChip_New");
			Prop_SetActiveAndFade("CathChip_New", true, 0.2);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Prop_MoveLinearTo("CathChip_New", "CathChip_Target", 1, 0.5, 0, true);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{			
			mbCatherineFixed = true;
			CathTool_SetChipBroken(false);
			
			Player_FadeMoveSpeedMulTo(1, 0.5);
		}
		Sequence_End();
	}
 
    //-------------------------------------------------------
	
	void Subject_CatherineFixed(const tString &in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		
		Lamp_SetLit("LiftoffLever_Lamp", true, true);
		Entity_SetEffectBaseColor("LiftoffLever_Lamp", cColor_Red);
		Lever_SetStuckState("LiftoffLever", 0, true);
		Lamp_SetLit("LiftoffButton_Lamp", true, true);
		Entity_SetEffectBaseColor("LiftoffButton_Lamp", cColor_Red);
		MovingButton_SetReturnToOffTime("LiftoffButton", -1);
		Entity_SetConnectionStateChangeCallback("LiftoffButton", "OnChangeLiftoffControls");
		Sound_PreloadProject("NPC_Zeppelin");
		
		// Fix for player trying to use controls outside of zeppelin
		mbLiftoffInteractionAllowed = true;
		if (Entity_GetCollide("Player", "LiftoffInteractArea")==false)
		{
			Entity_SetInteractionDisabled("LiftoffLever", true);
			Entity_SetInteractionDisabled("LiftoffButton", true);
		}
		
		LastOnSoma_SetText("02_03_delta_3");
	}
 
    //-------------------------------------------------------
	
	void LookAt_RemoveOldChip(const tString &in asEntity, int alState)
	{		
		if (alState == 1 || mbCatherineFixed==false) return;
		
		Entity_SetActive(asEntity, false);
	}
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 8 Event E *Start Zeppelin (dialog)*
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	int mlLiftoffControlsUsed = 0;
	bool mbLiftoffInteractionAllowed = false;
 
    //-------------------------------------------------------
	
	bool Trigger_LiftoffInteractArea(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbLiftoffInteractionAllowed==false) return true;
		
		Entity_SetInteractionDisabled("LiftoffLever", alState==-1);
		Entity_SetInteractionDisabled("LiftoffButton", alState==-1);
		
		return true;
	}
 
    //-------------------------------------------------------
	
	void OnChangeLiftoffControls(const tString &in asEntity, int alState)
	{
		if (alState != 1) return;
		
		mlLiftoffControlsUsed++;

		Entity_FadeEffectBaseColor(asEntity+"_Lamp", cColor_Green, 0.5);
		
		if (mlLiftoffControlsUsed == 1)
		{
			Prop_SetStaticPhysics("ZeppelinPlatformRailing_*", false);
			Lever_SetAutoMoveEnabled("ZeppelinPlatformRailing_*", true);
			Lever_SetAutoMoveTarget("ZeppelinPlatformRailing_*", -1);
			Entity_SetConnectionStateChangeCallback("ZeppelinPlatformRailing_*", "OnChangeZeppelinRailingUp");
			Sound_CreateAtEntity("ZeppelinRailingsUp", "NPC_Zeppelin/SFX/linear/gates_close_onboard", "ZeppelinPlatformRailing_4", 0.0f, false, 1.0f);
			
			Lever_SetAutoMoveTarget("StunRodLockboxLid", -1);
			Slide_SetLocked("StunRodInnerHatch", true, false);
			
			Entity_SetActive("LiftoffBlocker_*", true);
		}
		else
		{
			Entity_AttachToEntity("CathChip_New", "ZeppelinPlatform", "", true, false, true);
			Entity_SetInteractionDisabled("BrokenRadio", true);
			SequenceZeppelinLiftoff("");
			Sound_CreateAtEntity("StartupSweet", "02_03_delta/SFX/zeppelin_startup_sweet", "Player");
		}
	}
 
    //-------------------------------------------------------
	
	void LiftOffButtonPressed(const tString &in asEntity)
	{
		Sound_CreateAtEntity("LiftOffButtonPressed", "Entities_OceanBottom/button/plastic_red_push", "LiftoffButton", 0.0f, false, 1.0f);
	}
	
	cSequenceStatesData mZeppelinLiftoffSequence;
		
	void SequenceZeppelinLiftoff(const tString &in asTimer)
	{
		Sequence_Begin("SequenceZeppelinLiftoff", mZeppelinLiftoffSequence);
		
		if (Sequence_DoStepAndWait(2))
		{
			///////////////////////////////////////
			///Trigger lift off sound, end level music, shut off engine idle and add timer for sound fadeout.
			Sound_CreateAtEntity("ZeppelinLiftOff" , "NPC_Zeppelin/SFX/linear/takeoff_sequence", "Player", 0.0f, false, 1.0f);
			Sound_CreateAtEntity("ZeppelinLiftEngineMotion","NPC_Zeppelin/SFX/engine/motion", "Player", 16.0f, false, 1.0f);
			Sound_Stop("ZeppelinIdleEngine", 6.0f);
			Music_Play("02_03_leavinglevel.ogg", 0.9f, false, eMusicPrio_BigEvent);
			Sound_FadeGlobalVolume(0.75f, 9.0f, eSoundEntryType_WorldClean);
			
			Entity_SetEffectsActive("ZeppelinPlatform", true, false);
			
			Entity_SetInteractionDisabled("BrokenRadio", true);
			Entity_SetEffectsActive("BrokenRadio",false,true);
			Prop_SetAllowMapTransfer("BrokenRadio",false);
			
			Voice_StopAll();
			
			// Stop headbob on zep
			Player_SetHeadBobMul(0);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Prop_SetStaticPhysics("LiftoffLever", true); //Bugs out if you fiddle with it otherwise.
			 
			Effect_Rumble_Start(0.3, 2.75, 0.5, 1.25);
			Prop_MoveLinearTo("ZeppelinPlatform", "ZeppelinTargetPos_3", 0.17, 1, 0, true);
			if (Entity_GetCollide("CathChip_Old", "ZeppelinPlatform"))
			{
				Prop_SetStaticPhysics("CathChip_Old", true);
				Entity_AttachToEntity("CathChip_Old", "ZeppelinPlatform", "", true, false, true);
				Prop_SetAllowMapTransfer("CathChip_Old", false);
			}
			
			for (int i = 1; Entity_Exists("ZeppelinEngine_"+i); i++)
			{
				ParticleSystem_CreateAtEntity("ZeppelinEngineOn_"+i, "02_03_zeppelin_engine_on", "ZeppelinEngine_"+i, true);
				ParticleSystem_Destroy("ZeppelinEngineOff_"+i);
			}
			
			Prop_SetStaticPhysics("ZeppelinPlatformRailing_*", true);
			
			Voice_Play("8_ZeppelinLiftoff");
		}
		else if (Sequence_DoStepAndWait(6))
		{
			Prop_RotateToSpeed("ZeppelinPlatform", 0.05, -0.12, false, "");
			//Prop_AlignRotation("ZeppelinPlatform", "ZeppelinTargetPos_3", 0.05, 0.1, 0, true);
		}
		else if (Sequence_DoStepAndWait(18))
		{
			//Prop_AlignRotation("ZeppelinPlatform", "ZeppelinTargetPos_4", 0.05, 0.2, 0, false);
			
			Prop_MoveLinearTo("ZeppelinPlatform", "ZeppelinTargetPos_4", 0.1, 2.7, 0, false);
		}
		else if (Sequence_DoStepAndWait(0))
		{
			PreloadSetPrioNormal();
			
			Prop_RotateToSpeed("ZeppelinPlatform", 0.05, 0, false, "");
			
			Music_Stop(6, eMusicPrio_BgAmb);
			mbAmbientMusicPlaying = false;
		}
		else if (Sequence_DoStepAndWait(8))
		{
			PreloadChangeOfMap(false);
		}
		else if (Sequence_DoStepAndWait(7))
		{
			Prop_MoveLinearTo("ZeppelinPlatform", "ZeppelinTargetPos_4", 0.03, 1.4, 0, false);
		}
		else if (Sequence_DoStepAndWait(0))
		{
/*			Sound_Stop("ZeppelinLiftEngineMotion", 1);
			for (int i = 1; Entity_Exists("ZeppelinEngine_"+i); i++)
			{
				ParticleSystem_Destroy("ZeppelinEngineOn_"+i);
			}*/
		}
		
		Sequence_End();
	}
 
    //-------------------------------------------------------
 
	void OnChangeZeppelinRailingUp(const tString &in asEntity, int alState)
	{
		if (alState == -1) Prop_SetStaticPhysics(asEntity, true);
	}
 
