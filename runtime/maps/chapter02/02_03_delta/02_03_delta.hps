	//-------------------------------------------------------
	
	void SetupActivateMainBase()
	{		
		Entity_SetVarInt("Antenna_Peripheral1", "RotationIndex", 12);
		Entity_SetVarFloat("Antenna_Peripheral1", "RotationOffset", -16.821);
		Entity_SetVarBool("Antenna_Peripheral1", "Active", false);
		Entity_SetVarBool("Antenna_Peripheral1", "RotationDisabled", false);
		
		Entity_SetVarString("MainBaseDoorButton_Outside", "ConnectedButton", "MainBaseDoorButton_Inside");
		Entity_SetVarString("MainBaseDoorButton_Inside", "ConnectedButton", "MainBaseDoorButton_Outside");
		
		//Entity_AttachToEntity("CatherineToolArea", "ZeppelinPlatform", "", true);
		
		cVector3f vInitialZeppelinDelta = Entity_GetDeltaToEntity("ZeppelinTargetPos_2", "ZeppelinPlatform");
		vInitialZeppelinDelta.y = 0;
		mfInitialZeppelinDistance = vInitialZeppelinDelta.Length();
	}
 
    //-------------------------------------------------------
	
	bool CollisionAntennaProximity(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbStopKateFollowing) return false;
		if (mbKateWeldingInProgress) return true;
		
		if (alState == 1)
		{
			tString sLocation = Entity_GetVarString(asChild, "");
			Kate_Investigate("Kate", "AntennaLookNode_" + sLocation, "AntennaTerminal_" + sLocation, -1);
		}
		else
		{
			Kate_FollowPlayer("Kate");
		}
		return true;
	}
 
    //-------------------------------------------------------
	
	bool CollisionLeverProximity(const tString &in asParent, const tString &in asChild, int alState)
	{
		////////////////////////////////////////////////////////////////////////
		// Disable lever interaction if player walks behind or too far away from lever
		tString sLocation = Entity_GetVarString(asChild, "");
		Entity_SetInteractionDisabled("AntennaLever_"+sLocation, alState==-1);
		
		if (Entity_IsInteractedWith("AntennaLever_"+sLocation))
			Player_ChangeStateToNormal();
		
		return true;
	}
 
    //-------------------------------------------------------
	
	void RotateAntenna(const tString &in asEntity, int alDir)
	{		
		int lOldRotId = Entity_GetVarInt(asEntity, "RotationIndex");
		int lRotId = lOldRotId+alDir;
		if (lRotId > glAntennaDirs) lRotId-=glAntennaDirs;
		if (lRotId < 1) lRotId+=glAntennaDirs;
		cLux_AddDebugMessage("Rotating to: " + lRotId);
			
		if (mbAntennaIsRotating == false)
		{
			Sound_CreateAtEntity("AntennaMoveLoop", "02_03_delta/SFX/radar/spin/loop", "Antenna_Peripheral1", 0.25);
			Sound_CreateAtEntity("AntennaMoveStart", "02_03_delta/SFX/radar/spin/start", "Antenna_Peripheral1");
			mbAntennaIsRotating = true;
		}
		
		Prop_RotateToSpeed(asEntity, 0.5, 0.5*-alDir, false, "");
		Entity_SetVarInt(asEntity, "RotationIndex", lRotId);
	}
 
    //-------------------------------------------------------
	
	float GetAntennaRotation(const tString &in asEntity)
	{
		return Entity_GetVarFloat(asEntity, "RotationOffset") +  Entity_GetVarInt(asEntity, "RotationIndex")*(360.0f/float(glAntennaDirs));
	}
 
    //-------------------------------------------------------
	
	int GetAntennaConnectedZeppelin(const tString &in asEntity)
	{		
		float fRotation = cMath_Wrap(GetAntennaRotation(asEntity), 0.f, 360.f);
		if (fRotation >= gfZeppelinAngle_1-10 && fRotation <= gfZeppelinAngle_1+10 && mlComChannel == glZeppelinChannel_1)
		{
			return 1;
		}
		else if (fRotation >= gfZeppelinAngle_2-10 && fRotation <= gfZeppelinAngle_2+10 && mlComChannel == glZeppelinChannel_2)
		{
			return 2;
		}
		else if (fRotation >= gfZeppelinAngle_3-10 && fRotation <= gfZeppelinAngle_3+10 && mlComChannel == glZeppelinChannel_3)
		{
			return 3;
		}
		return -1;
	}
 
    //-------------------------------------------------------
	
	bool CollisionAntennaRotation(const tString &in asParent, const tString &in asChild, int alState)
	{
		int lIndex = cString_GetNumericSuffixInt(asChild);
		
		if (lIndex == Entity_GetVarInt("Antenna_Peripheral1", "RotationIndex"))
		{
			cLux_AddDebugMessage("Stopping Antenna");
			Prop_RotateToSpeed("Antenna_Peripheral1", 1, 0, false, "");
			
			Sound_Stop("AntennaMoveLoop", 0.25);
			Sound_CreateAtEntity("AntennaMoveStop", "02_03_delta/SFX/radar/spin/stop", "Antenna_Peripheral1");
			mbAntennaIsRotating = false;
		}
		
		return true;
	}
 
