	{			
		TimerAntennaPulseLightsOn(asEntity);
	}
 
    //-------------------------------------------------------
	
	void TimerAntennaPulseLightsOn(const tString &in asTimer)
	{
		Entity_SetEffectsActive(asTimer, true, true);
		Map_AddTimer(asTimer, 1, "TimerAntennaPulseLightsOff");
	}
 
    //-------------------------------------------------------
	
	void TimerAntennaPulseLightsOff(const tString &in asTimer)
	{
		if (GetAntennaConnectedZeppelin(asTimer)==-1)
		{
			Entity_SetEffectsActive(asTimer, false, true);
		}
		Map_AddTimer(asTimer, 1, "TimerAntennaPulseLightsOn");
	}
 
