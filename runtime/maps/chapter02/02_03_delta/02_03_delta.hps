	//-------------------------------------------------------
	
	bool CollideRelayInterior(const tString &in asParent, const tString &in asChild, int alState)
	{
		//Datamine_SetBeepActive("Maggie", alState==1);
		
		if (mbStopKateFollowing) return true;
		
		if (mbKateWeldingInProgress) StopKateWelding();
		
		if (alState==1)
		{
			cLux_AddDebugMessage("CollideRelayInterior entered");
			Kate_Investigate("Kate", "InsideRelayStationWaitNode", "Player", -1);
		}
		else
		{
			cLux_AddDebugMessage("CollideRelayInterior left");
			Kate_Investigate("Kate", "BelowRelayStationWaitNode", "Player", -1);
		}
		
		return true;
	}
 
