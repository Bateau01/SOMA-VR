	//-------------------------------------------------------

	/////////////////////////////////////////
	// ==============
	// SCENE 8 *KILL ROBOT, REPAIR CATHERINE & ESCAPE*
	// ==============
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	int mlStunRodHits_Kate = 0;
	int mlStunRodHits_Goya = 0;
	bool mbCathHasBeenPushy = false;
	bool mbCathHasBeenImpatient = false;
	bool mbTookChip = false;
	bool mbTookStunRod = false;

	// H5756AA_VR_DELTA_VANILLA_REPLACEMENT_TRIGGER
	// VR changes only how KateChip/GoyaChip reaches the already-inserted CathTool.
	// Once stock CanUseChip/OnUseChip accepts the physical contact, the original
	// SequenceInsertCatherineChip() runs unchanged: old-chip ejection, replacement
	// fly-in, dialogue/audio, movement lock and progression remain authored.

	bool mbWasRemindedToTakeChip = false;
	bool mbEndAutoSaveDone = false;

	//-------------------------------------------------------
	
	void SetupKillRobot()
	{
		ParticleSystem_SetActive("KateCrashed_Bubbles_*", false);
		ParticleSystem_SetActive("GoyaCrashed_Bubbles_*", false);
		
		Timer_CheckGoyaKateAreas("");
	}

	//-------------------------------------------------------
	
	bool Trigger_GoyaStart(const tString &in asParent, const tString &in asChild, int alState)
	{
		Goya_Wander("Goya");
		StartGoyaMovement();
		Map_AddTimer("Timer_CheckGoyaMovement", 1, "Timer_CheckGoyaMovement");
		
		return false;
	}

	//-------------------------------------------------------
	
	void Timer_CheckGoyaMovement(const tString &in asTimer)
	{
		if (mlStunRodHits_Goya >= 3) return; 
		
		if (Goya_IsMoving("Goya")==false)
		{
			StartGoyaMovement();
		}
		Map_AddTimer("Timer_CheckGoyaMovement", 1, "Timer_CheckGoyaMovement");
	}

	//-------------------------------------------------------
	
	void StartGoyaMovement()
	{
		cLux_AddDebugMessage("StartGoyaMovement");
		Pathfinder_Track_Clear("Goya");
		Pathfinder_Track_Add("Goya", "PathNodeAreaX_2");
		Pathfinder_Track_Add("Goya", "PathNodeAreaX_20");
		Pathfinder_Track_Add("Goya", "PathNodeArea_388");
		Pathfinder_Track_Add("Goya", "PathNodeArea_286");
		Pathfinder_Track_Add("Goya", "PathNodeArea_388");
		Pathfinder_Track_Add("Goya", "PathNodeAreaX_20");
		Pathfinder_Track_Start("Goya", true, 1, "");
	}

	//-------------------------------------------------------
	
	void Interact_Goya(const tString &in asEntity)
	{
		if (Voice_SceneIsActive("Goya"))
			Voice_Stop("Goya");
		
		cLux_AddDebugMessage("Interact_Goya");
		Dialog_Begin();
			Dialog_AddBranch("InteractGoya");
				Dialog_AddSubject("2_GoyaInteract_Player");
				Dialog_AddSubject("2_GoyaInteract_Goya", "Subject_GoyaConvoDone");
		Dialog_End();
		
		Entity_SetInteractionDisabled("GoyaInteract", true);
	}
	
	void Subject_GoyaConvoDone(const tString &in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		cLux_AddDebugMessage("Subject_GoyaConvoDone");
		
		Entity_SetInteractionDisabled("GoyaInteract", false);
	}

	//-------------------------------------------------------
	
	bool CollisionLandingPlatform(const tString &in asParent, const tString &in asChild, int alState)
	{
		cLux_AddDebugMessage("CollisionLandingPlatform "+alState);
		////////////////////////////////////////////////////////
		// Stuff that happens when you're close to zeppelin
		
		if (alState == 1)
		{
			////////////////////////////////
			// Kate don't want to be here
			if (!mbStopKateFollowing)
			{
				if (mbKateWeldingInProgress) StopKateWelding();
				
				Kate_Scare("Kate");
				int lSelectedNode = cMath_RandRectl(1, 5);
				TimerKateMainBaseIdle("KateIdlePos_" + lSelectedNode);
			}
			
			//////////////////////////////////
			// Reminder to pick up chip
			if (!mbTookChip && (mlStunRodHits_Kate == 5 || mlStunRodHits_Goya == 3) && !mbWasRemindedToTakeChip)
			{
				mbWasRemindedToTakeChip = true;
				Voice_Play("8_NotTakingChip");
			}
			
			if (mbTookChip && mbEndAutoSaveDone==false)
			{
				Game_AutoSave();
				mbEndAutoSaveDone = true;
			}
			
		}
		else
		{
			////////////////////////////////
			// Kate can follow player again
			if (!mbStopKateFollowing && !mbKateWeldingInProgress)
			{		
				for (int i = 1; i <= 5; i++)
					Map_RemoveTimer("KateIdlePos_" + i);
				Kate_FollowPlayer("Kate");
			}
			Map_RemoveTimer("KateUrgingTimer");
		}
		
		return true;
	}
 
    //-------------------------------------------------------
	
	void InvestigateKateMainBaseIdle(const tString &in asEntity)
	{
		int lSelectedNode = cMath_RandRectl(1, 5);
		Map_AddTimer("KateIdlePos_" + lSelectedNode, 3, "TimerKateMainBaseIdle");
	}
 
