			Sound_CreateAtEntity("DeflectTerminalSoundStart", "Entities_OceanBottom/tech/terminal/start", "DeflectInfoTerminal", 0.0f, true, 1.0f);
			
			Terminal_SetGuiActive("DeflectInfoTerminal", true, 0.5);
