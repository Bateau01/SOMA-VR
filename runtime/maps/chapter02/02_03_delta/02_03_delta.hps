    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Locked doors
    /////////////////////////////////////////
 
	//-------------------------------------------------------
	
	bool mbKateWeldingInProgress = false;
	tString msKateWeldingDoor = "";
 
	//-------------------------------------------------------
	
	void InteractBunkerDoor(const tString &in asEntity)
	{
		if (mbKateWeldingInProgress || mbStopKateFollowing || Entity_GetVarBool(asEntity, "FailedOpen")) return;
		
		Entity_SetActive("KateKillzone", false);
		Entity_SetActive("GoyaKillzone", false);
				
		TimerKateDoorWelding(asEntity);
		Kate_Investigate("Kate", asEntity+"_WeldingPos", asEntity+"_WeldTarget_1", -1, "KateAtPanel_LaunchSite");
	}
 
	//-------------------------------------------------------
	
	void InteractMainBaseDoor(const tString &in asEntity)
	{
		if (mbKateWeldingInProgress || mbStopKateFollowing || Entity_GetVarBool(asEntity, "FailedOpen")) return;
		
		Entity_SetActive("KateKillzone", false);
		Entity_SetActive("GoyaKillzone", false);
				
		TimerKateDoorWelding(asEntity);
		Kate_Investigate("Kate", asEntity+"_WeldingPos", "MainBaseDoor_1_WeldTarget_1", -1, "KateAtPanel_MainBase");
	}
 
	//-------------------------------------------------------
	
	void TimerKateDoorWelding(const tString &in asTimer)
	{		
		if (!Entity_IsInPlayerFOV("KateInPlayerFOVArea"))
		{
			Entity_PlaceAtEntity("Kate", asTimer+"_UnlockTeleportPos");
			Agent_FaceEntity("Kate", asTimer+"_WeldTarget_1");
		}
		
		mbKateWeldingInProgress = true;
		msKateWeldingDoor = asTimer;
		
		Entity_SetVarBool(asTimer, "FailedOpen", true);
		Map_RemoveTimer("KateFollowPlayerTimer");
		Map_AddTimer("HelpfulSoundTimer", 0.75, "TimerKateHelpfulSound");
		
		cLux_ToAgent(Map_GetEntity("Kate")).GetCharBody().SetTestCollision(false);
	}
 
	//-------------------------------------------------------
	
	void TimerKateHelpfulSound(const tString &in asTimer)
	{
		Sound_CreateAtEntity("HelpfulKate", "NPC_Kate/talk/katebot_idle_talk", "Kate", 0, false);
	}
 
    //-------------------------------------------------------
	
	void OnChangeDoorButton(const tString &in asEntity, int alState)
	{
		//////////////////////////////////////
		// Temporarily disable interaction
		Entity_SetInteractionDisabled(asEntity, true);
		//////////////////
		//Need to be above 3-4 seconds to prevent sound from being spammed/breaking
		Map_AddTimer(asEntity, 2.0f, "TimerEnableInteraction");
		
		///////////////////////////////////////////////
		// Change state of other button as well
		tString sConnectedButton = Entity_GetVarString(asEntity, "ConnectedButton");
		if (sConnectedButton != "") Button_SetSwitchedOn(sConnectedButton, alState == 1, true);
		
	}
	
	void StopKateWelding()
	{		
		mbKateWeldingInProgress = false; 
		
		Entity_SetActive("KateKillzone", true);
		Entity_SetActive("GoyaKillzone", true);
		iCharacterBody@ body = cLux_ToAgent(Map_GetEntity("Kate")).GetCharBody();
		body.SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag("+player"));
		body.SetTestCollision(true);
		
		//Kate_FollowPlayer("Kate");
		
		cLux_AddDebugMessage("Check for collision with "+msKateWeldingDoor+"_KateBlocker");
		if (Entity_GetCollide("Kate", msKateWeldingDoor+"_KateBlocker"))
		{
			Entity_PlaceAtEntity("Kate", msKateWeldingDoor+"_FailsafePos");
		}
		Entity_SetActive(msKateWeldingDoor+"_KateBlocker", true);
		
		if (msKateWeldingDoor == "LaunchSiteDoor")
		{
			SequenceStates_Stop("SequenceKateUnlocksLaunchSite");
			SwingDoor_SetBlocked("LaunchSiteDoor", false, false);
			SwingDoor_SetLocked("LaunchSiteDoor", false, true);
			SwingDoor_PushOpen("LaunchSiteDoor", 0.075, 3, 0.1);
		}
		else
		{
			SequenceStates_Stop("Seq_KateOpensMainBase");
			Slide_SetSlideAmount("MainBaseDoor_1", 0);
			Entity_SetInteractionDisabled("MainBaseDoor_1", false);
			Slide_SetLocked("MainBaseDoor_1", false, true);
			Slide_AutoMoveTo("MainBaseDoor_1", 0.05);
		}
	}
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Wau flowers
    /////////////////////////////////////////
 
	//-------------------------------------------------------
	
	void FlowerDrained_MainBase(const tString &in asEntity)
	{
		Seq_MainBaseFlowerDrained("");
	}
 
	//-------------------------------------------------------
	
	cSequenceStatesData mMainBaseFlowerDrainedSequence;
		
	void Seq_MainBaseFlowerDrained(const tString &in asTimer)
	{
		Sequence_Begin("Seq_MainBaseFlowerDrained", mMainBaseFlowerDrainedSequence);
			
		if (Sequence_DoStepAndWait(3))
		{
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Entity_SetEffectsActive("MainBaseServer_1", false, true);
			//Lamp_SetFlickerActive("MainBaseLamp_1", false);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Entity_SetEffectsActive("MainBaseServer_2", false, true);
		}
		else if (Sequence_DoStepAndWait(1))
		{
			Entity_SetEffectsActive("MainBaseServer_3", false, true);
			//Lamp_SetupFlicker("MainBaseLamp_1", 0.05, 0.25, 0.025, 0.15);
			//Lamp_SetFlickerActive("MainBaseLamp_1", true);
		}
		else
		{
			//Lamp_SetLit("MainBaseLamp_1", false, true);
		}
		Sequence_End();
	}
 
	//-------------------------------------------------------
	
	void FlowerDrained_Relay(const tString &in asEntity)
	{
		Seq_RelayFlowerDrained("");
	}
 
    //-------------------------------------------------------
	
	cSequenceStatesData mRelayFlowerDrainedSequence;
		
	void Seq_RelayFlowerDrained(const tString &in asTimer)
	{
		Sequence_Begin("Seq_RelayFlowerDrained", mRelayFlowerDrainedSequence);
			
		if (Sequence_DoStepAndWait(3))
		{
		}
		else if (Sequence_DoStepAndWait(0.2))
		{	
			ParticleSystem_SetActive("RelayStationBox_Bubbles", true);
			ParticleSystem_SetActive("RelayStationBox_Sparks_*", true);
			
			Light_SetVisible("RelayStationBox_Light", true);
			
			Sound_CreateAtEntity("BrokenLeverBubbles", "02_03_delta/SFX/broken_lever/broken_lever_sparks", "RelayStationBox", 0, false);	
		}
		else if (Sequence_DoStepAndWait(0.4))
		{
			Entity_SetEffectsActive("RelayStationBox", false, true);
		}
		else
		{
			ParticleSystem_SetVisible("RelayStationBox_Sparks_*", false);
			ParticleSystem_SetActive("RelayStationBox_Sparks_*", false);
			Light_SetVisible("RelayStationBox_Light", false);
		}
		Sequence_End();
	}
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Broken OmniTool
    /////////////////////////////////////////
 
	//-------------------------------------------------------
	
	float OmniToolSparkEffect_Start(const tString &in asPrefix)
	{
		ParticleSystem_SetVisible(asPrefix+"OmniToolPS_Sparks", true);
		float fTime = cMath_RandRectf(0.013, 0.04);
		LightFlash_Add(fTime, 0.01, 0.01, asPrefix+"OmniToolSparkPos", cColor(0.438,0.829,1,0.03), 0.5, 10);
		return fTime;
	}
 
    //-------------------------------------------------------
	
	void OmniToolSparkEffect_Stop(const tString &in asPrefix)
	{
		ParticleSystem_SetVisible(asPrefix+"OmniToolPS_Sparks", false);
	}
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Misc
    /////////////////////////////////////////
 
	//-------------------------------------------------------
	
	///////////////////////////////////////////////////////////////////////
	// Fixes potential bug where killzones get invalid coordinates.
	void Timer_CheckGoyaKateAreas(const tString &in asTimer)
	{		
		if (Entity_GetDeltaToEntity("Kate", "KateKillzone").Length()==0 || 
			Entity_GetDeltaToEntity("Kate", "KateKillzone").Length() > 100)
		{
			cLux_AddDebugMessage("Kate Killzone invalid, fixing.");
			Entity_PlaceAtEntity("KateKillzone", "Kate", cVector3f_Up*0.895);
		}
		
		if (Entity_GetDeltaToEntity("Goya", "GoyaKillzone").Length()==0 || 
			Entity_GetDeltaToEntity("Goya", "GoyaKillzone").Length() > 100)
		{
			cLux_AddDebugMessage("Goya Killzone invalid, fixing.");
			Entity_PlaceAtEntity("GoyaKillzone", "Goya", cVector3f_Up*1.921);
		}
		
		Map_AddTimer("Timer_CheckGoyaKateAreas", 10, "Timer_CheckGoyaKateAreas");
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// ==============
	// SCENE 2 *AWAKEN, MEET ROBOT AND FIND RELAY STATION*
	// ==============
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	bool mbAllowKateWelding = false;

	//-------------------------------------------------------
	
	void SetupSceneAwakenRobotRelay()
	{		
		////////////////////
		// Escape pod
		Map_AddTimer("OmniToolFlash", 0, "Timer_OmniToolFlash");
		
		//////////////////////////
		// Relay station general
		Entity_SetInteractionDisabled("RelayStationHatch", true);
		Entity_SetInteractionDisabled("RelayStationComputer", true);
		
		////////////////////
		// Broken Lever
		ParticleSystem_SetActive("RelayStationBox_Bubbles", false);
		ParticleSystem_SetActive("RelayStationBox_Sparks_*", false);
		Light_SetVisible("RelayStationBox_Light", false);
		
		////////////////////
		// Wau flower
		ParticleSystem_SetActive("RelayComputerSparkParticle_*", false);
		ParticleSystem_SetActive("RelayComputerBubbleParticles_*", false);
		Light_SetVisible("RelayComputerSparkLight", false);
		
		//////////////////////////
		// Relay door starts open
		Entity_SetInteractionDisabled("RelayStationHatchWheel", true);
		Entity_SetInteractionDisabled("RelayStationHatch", true);
		SwingDoor_SetDisableAutoClose("RelayStationHatch", true);
		SwingDoor_SetLocked("RelayStationHatch", false, true);
		SwingDoor_SetClosed("RelayStationHatch", false, true);
		
		Prop_SetStaticPhysics("RelayStationLadder", false);
	}
	
	//-------------------------------------------------------
	
	void TimerStartAfterCrash(const tString &in asTimer)
	{
		//Player_Teleport("crash_site");
		
		Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_World);
		Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_WorldClean);
		
		Entity_SetActive("Trigger_MusicBunker_1", true);
		Entity_SetActive("Trigger_MusicBunker_2", true);
		Entity_SetActive("Trigger_MusicBunker_3", true);
			
		StartSceneAwakenRobotRelay();
	}
 
 
    //-------------------------------------------------------
	
	void WakeUpDreamSound(const tString &in asTimer)
	{
		Sound_CreateAtEntity("WakeUpSequence", "02_03_delta/SFX/pod_crash/wakeup", "Player", 0.0f, false, 1.0f);
		Sound_CreateAtEntity("CathBeep", "02_03_delta/SFX/pod_crash/cath_beep", "BeepSoundSource", 0.0f, false, 1.0f);
		cLux_AddDebugMessage("Wake up sound triggered");
	}
	
	//-------------------------------------------------------
	
	void StartSceneAwakenRobotRelay(bool abStartInPod = true)
	{
		///////////////////////////
		// Underwater settings
		cLux_AddDebugMessage("StartSceneAwakenRobotRelay");
		Map_SetUnderwater(true);
		Map_SetEnvironmentParticlesActive(true);
		cLux_GetCurrentMap().GetWorld().SetFogUnderwater(true);
		
		float fFadeTime = 0.0;
		Effect_Bloom_FadeBrightPass(0.00001, fFadeTime); //sets pixels over 127 (255 * 0.5) to add to bloom
		Effect_Bloom_FadeBloomWidth(160, fFadeTime); //sets 128 pixels in bloom width, looks best within 32 - 512 pixels.
		Effect_Bloom_FadeBloomTint(0.3, 0.3, 0.3, fFadeTime); //sets red tint to bloom
		
		mlDepthOfFieldEffect = Effect_DoF_Start(0, 12, 1.0f, 3);
		
		cLux_GetCurrentMap().GetWorld().SetDirectionalLightActive(true);
		
		
		//////////////////
		// Other stuff
		Entity_AttachToEntity("KateKillzone", "Kate", "", false, false, true);
		Entity_AttachToEntity("GoyaKillzone", "Goya", "", false, false, true);
		if (abStartInPod)
		{ 
			SequenceCrashedPodWakeUp("");
		}
		else 
		{
			Kate_FollowPlayer("Kate");
		}
	}
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 2 Event A *Awaken Inside pod*
    /////////////////////////////////////////

	//-------------------------------------------------------
	
	cSequenceStatesData mCrashedPodWakeUpSequence;
		
	void SequenceCrashedPodWakeUp(const tString &in asTimer)
	{
		Sequence_Begin("SequenceCrashedPodWakeUp", mCrashedPodWakeUpSequence);
			
		if (Sequence_DoStepAndWait(2))
		{
			Player_SetActive(true);
			
			
			if (Player_GetHealth()>=0.8)
				Player_SetHealth(0.8);
			Entity_SetEffectsActive("Kate", false, false);
			
			CameraAnimation_Begin("CrashWakeUpAnim", "", true);
			Voice_Play("2_EscapePodDistressSignal");
		}	
		if (Sequence_DoStepAndWait(2))
		{
			Effect_Fade_In(3);
			Effect_ImageTrail_Start(2.25, 0, 3, 10);
		}
		Sequence_End();
	}
	
	//-------------------------------------------------------

	bool CrashAnimationWakeUp(const tString &in asEntity, int alDirection)
	{
		if (asEntity == "CrashWakeUpAnim_2" && alDirection == 1)
		{
			cLux_AddDebugMessage("Wake Up Animation Sound Start");
			Sound_CreateAtEntity("WakeUpAnimation", "02_03_delta/SFX/pod_crash/rise_up_animation", "Player", 0.0f, false, 1.0f);
			Sound_FadeGlobalVolume(0.7f, 3.0f);
			return true;
		}
		
		else if (asEntity == "CrashWakeUpAnim_2" && alDirection == -1)
		{
			cLux_AddDebugMessage("Wake Up Animation Sound Stop");
			Sound_FadeGlobalVolume(1.0f, 3.0f);
			Sound_Stop("WakeUpAnimation", 0.5f);
			return true;
		}
		return true;
	}


	//-------------------------------------------------------
	
	bool AnimationPlayerGotUpAfterCrash(const tString &in asEntity, int alDirection)
	{
		Player_SetMoveSpeedMul(0);
		Player_FadeMoveSpeedMulTo(1, 3);
		Sound_FadeGlobalVolume(1.0f, 3.0f);
		return true;
	}

	//-------------------------------------------------------
	
	// BJ: the crashed display is a proxy, not a second inventory tool.
	// Both its body and the authored interaction area acquire the real carrier.
	bool VR_TakeCrashedCathTool()
	{
		if (!_HPL3VR_DeltaManualBaton()) return false;
		if (!Entity_IsActive("CathTool_InteractArea")) return false;
		iLuxEntity@ pTool=Map_GetEntity("CathTool");
		iLuxEntity@ pDisplay=Map_GetEntity("CathTool_Crashed");
		if (pTool is null || pDisplay is null) return false;
		cMatrixf mtxDisplay=pDisplay.GetMatrix();
		Entity_CallEntityInteract("CathTool");
		if (!Player_ToolIsInInventory("CathTool")) return false;
		// Keep the acquired tool at the touched display, not its hidden staging spot.
		pTool.SetMatrix(mtxDisplay);
		Entity_SetActive("CathTool_InteractArea", false);
		Entity_SetActive("CathTool_Crashed", false);
		Sound_Stop("CrashedOmniBubbles", 0.25f);
		Map_RemoveTimer("OmniToolFlash");
		Map_RemoveTimer("StopFlash");
		ParticleSystem_Destroy("CrashedOmniToolPS_*");
		return true;
	}

	void Interact_TakeCathTool(const tString &in asEntity)
	{
		if (_HPL3VR_DeltaManualBaton()) { VR_TakeCrashedCathTool(); return; }
		Entity_CallEntityInteract("CathTool");
		Entity_SetActive(asEntity, false);
		Entity_SetActive("CathTool_Crashed", false);
		
		Sound_Stop("CrashedOmniBubbles", 0.25f);
		
		Map_RemoveTimer("OmniToolFlash");
		Map_RemoveTimer("StopFlash");
		ParticleSystem_Destroy("CrashedOmniToolPS_*");
	}

	//-------------------------------------------------------
	
	bool PickupCathTool(const tString &in asTool)
	{
		Sound_Stop("CathBeep", 0.1f);
		Entity_SetInteractionDisabled(asTool, false);
		
		CameraAnimationNode_SetAutoMove("CrashWakeUpAnim_1", 0.8);
		
		if (mbAllowKateWelding)
		{
			Map_AddTimer("PlayKateApproachSound", 2.0f, "KateApproachSound");
			Map_AddTimer("BeginWeldingTimer", 7.f, "SequenceKateRescue");
		}
			
		mbAllowKateWelding = true;
		return true;
	}
 
    //-------------------------------------------------------
	
	void Timer_OmniToolFlash(const tString &in asTimer)
	{
		if (asTimer == "StopFlash")
		{
			OmniToolSparkEffect_Stop("Crashed");
			Map_AddTimer("OmniToolFlash", cMath_RandRectf(0.25, 2.0), "Timer_OmniToolFlash");
			return;
		}
		float fTime = OmniToolSparkEffect_Start("Crashed");
		Map_AddTimer("StopFlash", fTime, "Timer_OmniToolFlash");
	}
 
