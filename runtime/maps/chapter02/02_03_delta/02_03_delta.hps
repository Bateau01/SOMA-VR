    //-------------------------------------------------------
	
	cSequenceStatesData mKateUnlocksLaunchSiteSequence;

	void SequenceKateUnlocksLaunchSite(const tString &in asTimer)
	{
		Sequence_Begin("SequenceKateUnlocksLaunchSite", mKateUnlocksLaunchSiteSequence);
		
		KateWeldSequence_Start("LaunchSiteDoor");
		
		if (Sequence_DoStepAndWait(1.25))
		{
			cLux_AddTodoMessage("Sound: Launch Site Door welded open");
			ParticleSystem_CreateAtEntity("LaunchSiteDoorParticles_1", "oneshot_waterbubbles_big.ps", "LaunchSiteDoorPSArea_1", false);
			ParticleSystem_CreateAtEntity("LaunchSiteDoorParticles_2", "oneshot_waterbubbles_big.ps", "LaunchSiteDoorPSArea_2", false);
			ParticleSystem_CreateAtEntity("LaunchSiteDoorParticles_3", "oneshot_waterbubbles_big.ps", "LaunchSiteDoorPSArea_3", false);
			
			iCharacterBody@ body = cLux_ToAgent(Map_GetEntity("Kate")).GetCharBody();
			body.SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag("-player"));
		}
		else if (Sequence_DoStepAndPause(0))
		{
			Sound_CreateAtEntity("LaunchDoorUnlocked", "shipwreck/doors/cabin_slide_door/open", "LaunchSiteDoor", 0, true);
			SwingDoor_SetLocked("LaunchSiteDoor", false, true);
			SwingDoor_PushOpen("LaunchSiteDoor", 0.075, 3, 0.1);
		}
		
		KateWeldSequence_End("LaunchSiteDoor");
		
		Sequence_End();
	}
 
    //-------------------------------------------------------
	
	cSequenceStatesData mKateOpensMainBaseSequence;
		
	void Seq_KateOpensMainBase(const tString &in asTimer)
	{
		Sequence_Begin("Seq_KateOpensMainBase", mKateOpensMainBaseSequence);
		
		KateWeldSequence_Start("MainBaseDoor_1");
		
		if (Sequence_DoStepAndWait(0.5))
		{			
			iCharacterBody@ body = cLux_ToAgent(Map_GetEntity("Kate")).GetCharBody();
			body.SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag("-player"));
		}
		else if (Sequence_DoStepAndWait(0.1))
		{
			Sound_CreateAtEntity("LaunchDoorUnlocked", "shipwreck/doors/cabin_slide_door/open", "MainBaseDoor_1", 0, true);
			Entity_SetInteractionDisabled("MainBaseDoor_1", false);
			Slide_SetLocked("MainBaseDoor_1", false, true);
		}
		else if (Sequence_DoStepAndPause(0))
		{
			Slide_AutoMoveTo("MainBaseDoor_1", 0.05);
		}
		
		KateWeldSequence_End("MainBaseDoor_1");
		
		Sequence_End();
	}
 
