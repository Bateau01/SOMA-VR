	bool CollisionCaveProximity(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbStopKateFollowing) return false;
		if (mbKateWeldingInProgress) StopKateWelding();
		
		if (alState == 1)
		{
			if (Map_GetTimerTime("KateFollowTimer") == 0) Kate_Scare("Kate");
			Kate_Investigate("Kate", "ScaredOfCaveNode", "CaveEntrance", -1, "", false);
			
			Map_RemoveTimer("KateFollowTimer");
		}
		else
		{
			Map_AddTimer("KateFollowTimer", 2, "TimerKateFollowPlayer");
		}
		
		return true;
	}
	
