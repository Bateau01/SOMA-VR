    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Transmission screens
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	void TransmissionError(const tString&in asEntityName, float afTimeStep)
	{
		/////////////////////
		// Error window
		cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
		windowData.mColorText = cColor(0.8, 1);
		StationGui_DoWindowStart("GUIError", windowData, ImGui_NrmPos(cVector3f(0.25, 0.33, 3)), ImGui_NrmSize(cVector2f(0.5, 0.33)), false);
			
			//text
			cImGuiTextFrameData textData;
			textData.mbUseBackgroundGfx = false;
			textData.mFont.mvSize = cVector2f(20, 20);
			textData.mFontAlign = eFontAlign_Center;
			textData.mColorText = cColor(0.8, 1);
			ImGui_DoTextFrameExt("CorruptedData", cVector2f(0), 0, 0, textData, 
							  ImGui_NrmPosGroup(cVector3f(0.0, 0.13, 1)), ImGui_NrmSizeGroup(cVector2f(1, 1)));
			
			//button
			cImGuiButtonData buttonData = StationGui_CreateDefaultButtonData();
			buttonData.mColorText = cColor(0.8, 1);
			if (ImGui_DoButtonExt("ErrorOK", "GUIOK", buttonData, ImGui_NrmPos(cVector3f(0.16, 0.15, 1)), ImGui_NrmSize(cVector2f(0.18, 0.11))))
			{
				ImGui_SetStateInt("RestorationState", 1);
				ImGui_SetStateFloat("WindowResize", 0);
				ImGui_FadeStateFloat("WindowResize", 1, 1);
				ImGui_AddTimer("WindowResizeTime", 1);
			}
			
		StationGui_DoWindowEnd();
	}
 
    //-------------------------------------------------------
	
	void TransmissionRestoration(const tString&in asEntityName, float afTimeStep)
	{			
		/////////////////////
		// Check timers
		const float fRestorationTime = 3.f;
		if (ImGui_TimerOver("WindowResizeTime"))
		{
			ImGui_SetStateFloat("RestorationProgress", 0);
			ImGui_FadeStateFloat("RestorationProgress", 1, fRestorationTime, eEasing_Linear);
		}
		if (ImGui_TimerOver("RestorationEndDelay"))
		{
			ImGui_SetStateInt("RestorationState", 2);
			ImGui_SetStateFloat("WindowFade", 0);
			ImGui_FadeStateFloat("WindowFade", 1, 1);
		}
			
		float fResizeProgress = ImGui_GetStateFloat("WindowResize", 1);
		
		/////////////////////
		// Progress window
		cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
		windowData.mColorText = cColor(0.8, 1);
		StationGui_DoWindowStart("RestoreFiles", windowData, ImGui_NrmPos(cVector3f(0.25-0.1*fResizeProgress, 0.33+0.03*fResizeProgress, 3)), 
															  ImGui_NrmSize(cVector2f(0.5+0.2*fResizeProgress, 0.33-0.08*fResizeProgress)), false);
			
			if (ImGui_TimerExists("WindowResizeTime") == false)
			{
				//text
				cImGuiTextFrameData textData;
				textData.mbUseBackgroundGfx = false;
				textData.mFont.mvSize = cVector2f(20, 20);
				textData.mFontAlign = eFontAlign_Left;
				textData.mColorText = cColor(0.8, 1);
				ImGui_DoTextFrameExt("RestorationProgress", cVector2f(0), 0, 0, textData, 
								  ImGui_NrmPosGroup(cVector3f(0.1, 0.13, 1)), ImGui_NrmSizeGroup(cVector2f(1, 1)));
				
				if (Depth_ImGui_LoadingGauge("RestorationGauge", fRestorationTime, false, ImGui_NrmPosGroup(cVector3f(0.1, 0.45, 1)), 
											 ImGui_NrmSizeGroup(cVector2f(0.8, 0.27)), StationGui_CreateDefaultGaugeData()))
				{
					ImGui_AddTimer("RestorationEndDelay", 0.4f);
				}
			}
			
		StationGui_DoWindowEnd();
	}
 
    //-------------------------------------------------------
	
	int TransmissionFileList(const tString&in asFileNamePrefix, const tString&in asScene, int alFileCount)
	{
		int lSelection = -1;
		float fFadeState = ImGui_GetStateFloat("WindowFade", 0);
		float fRestorationProgress = ImGui_GetStateFloat("RestorationProgress", 0);
		
		/////////////////////
		// File list window
		cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
		windowData.mColorBase = cColor(0.07f, 0.41f, 0.72f, 1) * (0.4+0.6*fFadeState);
		windowData.mColorText = cColor(0.3+0.3*fFadeState, 1);
		StationGui_DoWindowStart("TransmissionRecords", windowData, ImGui_NrmPos(cVector3f(0.05, 0.05, 2)), ImGui_NrmSize(cVector2f(0.5, 0.9)), false);
			
			float fHeight = 0.14;
			float fFileInterval = 1/float(alFileCount);
			if (fRestorationProgress>fFileInterval)
			{
				ImGui_AddItemString(asFileNamePrefix+"_1"); 
				fHeight=0.14;
			
				for (int i = 2; i <= alFileCount; i++)
				{
					if (fRestorationProgress < fFileInterval*i) break;
					ImGui_AddItemString(asFileNamePrefix+"_"+i);
					fHeight = 0.16667*i;
				}
			
				ImGui_SetModUseInput(ImGui_GetStateInt("RestorationState", 0) == 2);
				lSelection = ImGui_DoMultiToggle("FileSelection", -1, 1,  ImGui_NrmSizeGroup(cVector2f(0, 0.04)), 
														ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 0.1)), ImGui_NrmSizeGroup(cVector2f(0.9, fHeight)));
														
				if (ImGui_PrevUpdated())
				{
					OnGuiStopPlayback(ImGui_GetName(), asScene, true);
				}
				ImGui_SetModUseInput(true);
			}
			
		StationGui_DoWindowEnd();
		return lSelection;
	}
 
    //-------------------------------------------------------
	
	void OnGuiStopPlayback(const tString &in asTerminal, const tString &in asScene, bool abResetTime)
	{
		Terminal_SetImGuiStateInt(asTerminal, "FilePlaybackActive", 0);
		Terminal_StopImGuiFade(asTerminal, "FilePlayback");
		if (abResetTime) Terminal_SetImGuiStateFloat(asTerminal, "FilePlayback", 0);
		
		Terminal_SetUpdateWhenOutOfView(asTerminal, false);
		
		Voice_Stop(asScene);
	}
 
    //-------------------------------------------------------
	
	void OnGuiStartPlayback(const tString &in asTerminal, const tString &in asSubject, const tString &in asCallback)
	{			
		Terminal_SetImGuiStateInt(asTerminal, "FilePlaybackActive", 1);
		Terminal_SetImGuiStateFloat(asTerminal, "FilePlayback", 0);
		Terminal_FadeImGuiStateFloat(asTerminal, "FilePlayback", 10000, 10000, eEasing_Linear);
		
		Terminal_SetUpdateWhenOutOfView(asTerminal, true);
		
		Voice_Play(asSubject, -1, asCallback);
	}
 
    //-------------------------------------------------------
	
	void TransmissionPlayFile(const tString &in asFile, const tString &in asSubject, const tString &in asCallback)
	{
		float fPlaybackTime = ImGui_GetStateFloat("FilePlayback", 0);
		bool bPlaybackActive = ImGui_GetStateInt("FilePlaybackActive")==1;
		
		////////////////////
		// Playback window
		float fFadeState = ImGui_GetStateFloat("WindowFade", 0);
		cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
		windowData.mColorBase = cColor(0.07f, 0.41f, 0.72f, 1) * (0.4+0.6*fFadeState);
		windowData.mColorText = cColor(0.3+0.3*fFadeState, 1);
		StationGui_DoWindowStart("GUIPlayback", windowData, ImGui_NrmPos(cVector3f(0.555, 0.05, 3)), ImGui_NrmSize(cVector2f(0.4, 0.33)), false);
			
			//text
			cImGuiLabelData textData;
			textData.mbUseBackgroundGfx = false;
			textData.mFont.mvSize = cVector2f(20, 20);
			textData.mFontAlign = eFontAlign_Center;
			textData.mColorText = cColor(0.8, 1);
						
			if (asFile != "")
			{
				ImGui_DoLabelExt(asFile, textData, 
								  ImGui_NrmPosGroup(cVector3f(0.0, 0.12, 1)), ImGui_NrmSizeGroup(cVector2f(1, -1)), 0.75);
				ImGui_SetTransCategory("");
				ImGui_DoLabelExt(String_SecondsToClockDisplay(fPlaybackTime, false, true, true, true), textData, 
								  ImGui_NrmPosGroup(cVector3f(0.0, 0.25, 1)), ImGui_NrmSizeGroup(cVector2f(1, -1)));
				ImGui_SetTransCategory("02_03_delta");
			}
			
			//button
			cImGuiButtonData buttonData = StationGui_CreateDefaultButtonData();
			buttonData.mColorBase = buttonData.mColorBase * (0.4+0.6*fFadeState);
			buttonData.mFont.mColor = cColor(0.8, 1) * (0.4+0.6*fFadeState);
			
			if (asFile != "" && 
				ImGui_DoButtonExt("StopStartPlayback", bPlaybackActive ? "GUIStop" : "GUIPlay", buttonData, 
								  ImGui_NrmPosGroup(cVector3f(0.25, 0.5, 1)), ImGui_NrmSizeGroup(cVector2f(0.5, 0.35))))
			{	
				if (bPlaybackActive) OnGuiStopPlayback(ImGui_GetName(), "Recording", true);
				else				 OnGuiStartPlayback(ImGui_GetName(), asSubject, asCallback);
			}
			
		StationGui_DoWindowEnd();
	}
 
    //-------------------------------------------------------
	
	void TransmissionSend(const tString&in asEntityName, float afTimeStep)
	{		
		///////////////////////
		// Transmission window
		float fFadeState = ImGui_GetStateFloat("WindowFade", 0);
		float fFadeColorMul = (0.4+0.6*fFadeState);
		cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
		windowData.mColorBase = cColor(0.3, 1) * fFadeColorMul;
		windowData.mColorText = cColor(0.3+0.3*fFadeState, 1);
		StationGui_DoWindowStart("GUITransmit", windowData, ImGui_NrmPos(cVector3f(0.555, 0.4, 1)), ImGui_NrmSize(cVector2f(0.4, 0.45)), false);
			
			//text
			cImGuiTextFrameData textData;
			textData.mbUseBackgroundGfx = false;
			textData.mFont.mvSize = cVector2f(14, 14);
			textData.mFontAlign = eFontAlign_Center;
			textData.mFont.mColor = cColor(0.6, 1) * fFadeColorMul;
			
			ImGui_DoTextFrameExt("RelayMalfunctionMsg", cVector2f(5, 0), 0, 0, textData, ImGui_NrmPosGroup(cVector3f(0, 0.1, 1)), ImGui_NrmSizeGroup(cVector2f(1, 1)));
			
			//button
			ImGui_SetModUseInput(false);
			cImGuiButtonData buttonData = StationGui_CreateDefaultButtonData();
			buttonData.mColorBase = buttonData.mColorBase * fFadeColorMul;
			ImGui_DoButtonExt("SendMessage", "GUISendMessage", buttonData, ImGui_NrmPosGroup(cVector3f(0.15, 0.6, 1)), ImGui_NrmSizeGroup(cVector2f(0.7, 0.275)));
			ImGui_SetModUseInput(true);
			
		StationGui_DoWindowEnd();
	}
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Terminal *Antenna controls*
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	void EnterAntennaControls(const tString&in asEntityName)
	{
		Terminal_SetImGuiStateBool(asEntityName, "ForcePowerFocus", true);
	}
 
    //-------------------------------------------------------
	
	void OnGuiAntennaControls(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("02_03_delta");
		
		////////////////////
		// Data
		cImGuiButtonData buttonData = StationGui_CreateDefaultButtonData();
		buttonData.mbUseFrame = false;
		buttonData.mbUseBackgroundGfx = true;
		
		cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
		windowData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.07);
		windowData.mColorText = cColor(0.125, 1);
		
		cImGuiButtonData defaultStationData = StationGui_CreateToggleButtonData();
		
		cImGuiLabelData textData;
		textData.mbUseBackgroundGfx = false;
		textData.mFontAlign = eFontAlign_Right;
		textData.mFont.mColor = cColor(0.5, 1);
			
		tString sLocation = Entity_GetVarString(asEntityName, "");
		int lConnectedZeppelin = GetAntennaConnectedZeppelin("Antenna_"+sLocation);
			
		ImGui_GroupBegin(cVector3f(10,0,0), ImGui_NrmSizeGroup(cVector2f_One));
			// Draw background
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();
		ImGui_GroupEnd();
		
		if (ImGui_TimerOver("ConnectionDelay"))
		{
			if (lConnectedZeppelin == -1)
				Sound_CreateAtEntity("ConnectionBAD", "Entities_Station/tech/terminal_beeps/pathOS_underwater_comp/antenna_panel_no_signal", "AntennaTerminalSoundSource");
			else
				Sound_CreateAtEntity("ConnectionOK", "Entities_Station/tech/terminal_beeps/pathOS_underwater_comp/antenna_panel_link_establ", "AntennaTerminalSoundSource");
		}
			
		////////////////////////////
		// ROTATION
		bool bAntennaActive = Entity_GetVarBool("Antenna_"+sLocation, "Active");
		ImGui_SetModUseInput(bAntennaActive);
		cVector3f vRotationControlsPos = ImGui_NrmPosGroup(cVector3f(0.05,0.1,2));
		cVector2f vRotationControlsSize = ImGui_NrmSizeGroup(cVector2f(0.4, 0.8));
		ImGui_DoWindowStart("", windowData, vRotationControlsPos, vRotationControlsSize);
			float fIndicatorTurnTime = 0.8;
			
			//////////////////////////
			// Background	
			ImGui_SetModColorMul(cColor(0.4, 0.4, 1, 1));	
			cVector2f vRadarSize = ImGui_NrmSizeGroupKeepRatio(cVector2f(0.65, 0.65));
			cVector3f vRadarCenter = ImGui_NrmPosGroup(cVector3f(0.5, 0.375, 0.5));
			cImGuiGfx radar = cImGuiGfx("antennacontrol_radar");
			radar.mvOffset = cVector3f(-vRadarSize.x*0.5, -vRadarSize.y*0.5, 0);
			ImGui_DoImage(radar, vRadarCenter, vRadarSize);
			ImGui_SetModColorMul(cColor_White);
			
			////////////////////////////
			// Rotation buttons
			buttonData.mGfxBackground = cImGuiGfx("antennacontrol_turnccw");
			if (ImGui_DoRepeatButtonExt("RotateLeft", "", buttonData, ImGui_NrmPosGroup(cVector3f(0.06, 0.8, 1)), ImGui_NrmSizeGroup(cVector2f(0.3, 0.175))))
			{
				if (Map_TimeHasPassed("RotationRepeater", fIndicatorTurnTime))
				{
					Sound_CreateAtEntity("RotatingAntenna", "Entities_Station/tech/terminal_beeps/pathOS_underwater_comp/antenna_panel_arrow", "AntennaTerminalSoundSource");
					ImGui_StopTimer("ConnectionDelay");
					ImGui_AddTimer("ConnectionDelay", fIndicatorTurnTime+1.2);
					RotateAntenna("Antenna_"+sLocation, -1);
				}
			}
			
			buttonData.mGfxBackground = cImGuiGfx("antennacontrol_turncw");
			if (ImGui_DoRepeatButtonExt("RotateRight", "", buttonData, ImGui_NrmPosGroup(cVector3f(0.64, 0.8, 1)), ImGui_NrmSizeGroup(cVector2f(0.3, 0.175))))
			{
				if (Map_TimeHasPassed("RotationRepeater", fIndicatorTurnTime))
				{
					Sound_CreateAtEntity("RotatingAntenna", "Entities_Station/tech/terminal_beeps/pathOS_underwater_comp/antenna_panel_arrow", "AntennaTerminalSoundSource");
					ImGui_StopTimer("ConnectionDelay");
					ImGui_AddTimer("ConnectionDelay", fIndicatorTurnTime+0.75);
					RotateAntenna("Antenna_"+sLocation, 1);
				}
			}
			
			//////////////////////////
			// Direction indicator
			if (bAntennaActive)
			{				
				float fAntennaRotation = GetAntennaRotation("Antenna_Peripheral1");
				float fArrowDir = ImGui_GetStateFloat("ArrowDir", fAntennaRotation);
				fArrowDir = cMath_IncreaseTo(fArrowDir, afTimeStep*(22.5/fIndicatorTurnTime), fArrowDir+cMath_GetAngleDistanceDeg(fArrowDir, fAntennaRotation));
				ImGui_SetStateFloat("ArrowDir", fArrowDir);
				
				cVector2f vArrowSize = ImGui_NrmSizeGroupKeepRatio(cVector2f(0.201, 0.33));
				bool bConnected = lConnectedZeppelin!=-1 && !ImGui_TimerExists("ConnectionDelay");
				cColor arrowCol = (bConnected ? cColor(0.2, 0.2, 1, 0.9) : cColor(0.4, 0.3, 0.8, 0.75));
				DoRadarIndicator("transportcontrol_antenna_cone", vRadarCenter, vArrowSize, arrowCol, fArrowDir, 1.9);
				
				//////////////////////////
				// Zeppelin indicators
				float fZeppelinIndicatorDelay = ImGui_GetStateFloat("ZeppelinIndicatorDelay", 0);
				cVector2f vZepLineSize = ImGui_NrmSizeGroupKeepRatio(cVector2f(0.05, 0.33));
				cColor col = gZeppelinColor_1;
				if (mlComChannel != glZeppelinChannel_1) col.a *= 0.45;
				if (fZeppelinIndicatorDelay > 0.333) DoRadarIndicator("antennacontrol_zeppelin_line", vRadarCenter, vZepLineSize, col, gfZeppelinAngle_1, 2);
				col = gZeppelinColor_2;
				if (mlComChannel != glZeppelinChannel_2) col.a *= 0.45;
				if (fZeppelinIndicatorDelay > 0.666) DoRadarIndicator("antennacontrol_zeppelin_line", vRadarCenter, vZepLineSize, col, gfZeppelinAngle_2, 2);
				col = gZeppelinColor_3;
				if (mlComChannel != glZeppelinChannel_3) col.a *= 0.45;
				if (fZeppelinIndicatorDelay >= 0.999) DoRadarIndicator("antennacontrol_zeppelin_line", vRadarCenter, vZepLineSize, col, gfZeppelinAngle_3, 2);
			}
			
		ImGui_DoWindowEnd();
		
		/////////////////////////
		// CHANNEL SELECT
		ImGui_SetModUseInput(true);
		ImGui_DoWindowStart("ComChannel", windowData, ImGui_NrmPosGroup(cVector3f(0.475, 0.6, 1)), ImGui_NrmSizeGroup(cVector2f(0.475, 0.3)));
			textData.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(cVector2f(0.27, 0.27));
			textData.mFontAlign = eFontAlign_Left;
			
			ImGui_SetTransCategory("");
			ImGui_AddItemString("1");
			ImGui_AddItemString("2");
			ImGui_AddItemString("3");
			ImGui_AddItemString("4");
			ImGui_AddItemString("5");
			ImGui_AddItemString("6");
			ImGui_AddItemString("7");
			ImGui_AddItemString("8");
			
			defaultStationData.mFont.mvSize = cVector2f(42, 42);
			mlComChannel = ImGui_DoMultiToggleExt("ChannelSelect", mlComChannel-1, 4, ImGui_NrmSizeGroup(cVector2f(0.025, 0.025)), defaultStationData,
												  ImGui_NrmPosGroup(cVector3f(0.1, 0.1, 1)), ImGui_NrmSizeGroup(cVector2f(0.8, 0.8)));
			mlComChannel+=1;
			if (ImGui_PrevUpdated())
			{
				Sound_CreateAtEntity("AntennaChannel", "Entities_Station/tech/terminal_beeps/pathOS_underwater_comp/antenna_panel_number", "AntennaTerminalSoundSource");
				ImGui_StopTimer("ConnectionDelay");	
				if (bAntennaActive) ImGui_AddTimer("ConnectionDelay", 1.4);
			}
			ImGui_SetTransCategory("02_03_delta");
			
		ImGui_DoWindowEnd();
		
		/////////////////////////
		// SIGNAL STATUS
		ImGui_DoWindowStart("", windowData, ImGui_NrmPosGroup(cVector3f(0.475, 0.35, 1)), ImGui_NrmSizeGroup(cVector2f(0.475, 0.225)));
			if (ImGui_TimerExists("ConnectionDelay"))
			{
				int lConnectDotCount = ImGui_GetStateInt("ConnectDotCount", 1);
				if (ImGui_TimerOver("ConnectDotInc") || !ImGui_TimerExists("ConnectDotInc"))
				{
					ImGui_AddTimer("ConnectDotInc", 0.3);
					lConnectDotCount++;
					if (lConnectDotCount > 4)
						lConnectDotCount = 1;
					ImGui_SetStateInt("ConnectDotCount", lConnectDotCount);
				}
				tString sDots = "....";
				sDots.resize(lConnectDotCount);
				
				ImGui_SetTransCategory("");
				textData.mFontAlign = eFontAlign_Center;
				ImGui_DoLabelExt(sDots, textData, ImGui_NrmPosGroup(cVector3f(0, 0, 1)), ImGui_NrmSizeGroup(cVector2f(1, -1)));
				ImGui_SetTransCategory("02_03_Delta");
			}
			else if (lConnectedZeppelin == -1)
			{
				textData.mFont.mvSize = cVector2f(50, 50);
				textData.mFontAlign = eFontAlign_Center;
				ImGui_DoLabelExt("AntennaControl_NoSignal", textData, ImGui_NrmPosGroup(cVector3f(0, 0.15, 1)), ImGui_NrmSizeGroup(cVector2f(1, -1)));
			}
			else
			{
				textData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0525);
				ImGui_DoLabelExt("AntennaControl_Aligned", textData, ImGui_NrmPosGroup(cVector3f(0.05, 0, 1)));
				textData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.08);
				ImGui_DoLabelExt("Zeppelin_"+lConnectedZeppelin+"_IDOnly", textData, ImGui_NrmPosGroup(cVector3f(0.05, 0.25, 1)));
			}
		ImGui_DoWindowEnd();
			
		///////////////////
		// POWER BUTTON
		ImGui_SetModUseInput(!bAntennaActive);
			buttonData.mColorBase = gStationGuiColor_Warning;
			buttonData.mColorTriggered = gStationGuiColor_Highlight;
			buttonData.mGfxBackground = cImGuiGfx("antennacontrol_power");
			if (ImGui_DoToggleButtonExt("Activate", "", false, buttonData, ImGui_NrmPosGroup(cVector3f(0.70, 0.1, 1)), ImGui_NrmSizeGroupKeepRatio(cVector2f(0.2, 0.2))))
			{
				if (!bAntennaActive)
				{	
					cLux_AddTodoMessage("Sound: Activating antenna");	
					Sound_CreateAtEntity("ActivatingAntenna", "Entities_Station/tech/terminal_beeps/pathOS_underwater_comp/antenna_panel_activate_power", "AntennaTerminalSoundSource");
					Entity_SetVarBool("Antenna_"+sLocation, "PowerDisabled", true);
					Entity_SetVarBool("Antenna_"+sLocation, "Active", true);
					Kate_Investigate("Kate", "AntennaLookNode_" + sLocation, "Antenna_" + sLocation, 2);
					Entity_PlayAnimation("Antenna_" + sLocation, "activate", 0.1f, false, true, "AnimationAntennaOn");
					Entity_SetEffectsActive("Antenna_" + sLocation, true, true);
					ImGui_FadeStateFloat("ZeppelinIndicatorDelay", 1, 0.5, eEasing_Linear);
				}
			}
			if (bAntennaActive==false && ImGui_GetStateBool("ForcePowerFocus", false))
			{
				ImGui_SetFocus("Activate");
				ImGui_SetStateBool("ForcePowerFocus", false);
			}
		ImGui_SetModUseInput(true);
	}
 
    //-------------------------------------------------------
	
	void DoRadarIndicator(const tString &in aGfxFile, const cVector3f &in avRadarCenter, const cVector2f &in avSize, const cColor &in aCol, float afAngle, float afZ)
	{
		cImGuiGfx gfx = cImGuiGfx(aGfxFile);
		gfx.mvOffset = cVector3f(-avSize.x*0.5, -avSize.y, 0);
		
		ImGui_SetModColorMul(aCol);
		
		ImGui_SetModRotateCustomPivot(true);
		cVector3f vOffset3 = ImGui_GetCurrentGroupPos();
		
		cVector3f vPos = avRadarCenter;
		vPos.z = afZ;
		ImGui_SetModRotatePivot(cVector2f(vOffset3.x+vPos.x+avSize.x*0.5, 
										  vOffset3.y+vPos.y+avSize.y));
		ImGui_SetModRotateAngle(afAngle);
		ImGui_DoImage(gfx, vPos, avSize);
		ImGui_SetModColorMul(cColor_White);
		
		ImGui_SetModRotateAngle(0);
	}
 
