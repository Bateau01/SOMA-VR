		mbStartAutosaveDone = true;
		Game_AutoSave();
	}

    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 2 Event E *Enter Relay Station*
    /////////////////////////////////////////

	//-------------------------------------------------------
	
	bool CollisionBelowRelayStation(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbStopKateFollowing) return false;
		
		if (mbKateWeldingInProgress) StopKateWelding();
		
		if (alState==1)
		{				
			Kate_Investigate("Kate", "BelowRelayStationWaitNode", "Player", -1);
		}
		else if (Entity_GetCollide("Player", "InsideRelayStation"))
		{
			Kate_Investigate("Kate", "InsideRelayStationWaitNode", "Player", -1);
		}
		else
		{
			Kate_FollowPlayer("Kate");
		}
		return true;
	}

