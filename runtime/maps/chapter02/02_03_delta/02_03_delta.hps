		// Disable area so player can't climb from outside
		Entity_SetActive(asEntity,false);
		
		//CameraAnimation_Begin("EscapePodClimbAnim", "", true);
	}
		
	//-------------------------------------------------------
	
	bool CamAnim_StartExitAnim(const tString &in asEntity, int alDirection)
	{
		CameraAnimation_End();
		
		StartClimbAnimation(0);
		
		//Sound_CreateAtEntity("RiseIntoClimb", "02_03_delta/SFX/pod_crash/rise_into_climbout_position", "Player", 0.0f, false, 1.0f);
		
		Map_AddTimer("Timer_AnimationKateBackOff", 5, "Timer_AnimationKateBackOff");
		
		return true;
	}
	
	//-------------------------------------------------------
	
	void StartClimbAnimation(float afFadeTime)
	{
		Player_SetGravityEnabled(false);
		
		PlayerHands_SetUseCustomPosition(true);
		PlayerHands_SetCustomPositionFromEntity("ClimbAnimationOffset");
		PlayerHands_SetUseCustomRotation(true);
		PlayerHands_SetCustomRotation(cVector3f(0, cMath_Pi, 0));
		PlayerHands_PlayAnimation("event_climb_of_e_vessel_2_3", false, true,  0,"", true,1,-1);
		PlayerHands_SetAnimationOverCallback("HandAnimOver_ClimbedOut");
		Map_AddTimer("Timer_LeavePodMusic", 4, "Timer_LeavePodMusic");
		mbAmbientMusicAllowed = true;

		PlayerHands_AttachCameraToSocket("Socket_Camera", afFadeTime, "CameraAttached", true,true,0.5, cVector3f(0,0,0), 0);
	}
		
		
	void CameraAttached()
	{
		cLux_AddDebugMessage("Start Animation");
		
		Sound_CreateAtEntity("ClimbOut", "02_03_delta/SFX/pod_crash/rise_climb_out_of_pod", "Player");
		Emotion_PlayEventBreath("02_03_delta/SFX/pod_crash/rise_up_animation_vo", 2);
	}
	//-------------------------------------------------------
		
	void HandAnimOver_ClimbedOut(const tString&in asAnim)
	{
		mbClimbedOutOfShuttle = true;
		
		Player_SetGravityEnabled(true);
		Player_Teleport("crash_site");
		Player_SetActive(false);
		Map_AddTimer("HandAnimOver_ActivatePlayer", 0.30, "HandAnimOver_ActivatePlayer");
		
		Kate_FollowPlayer("Kate");
		Map_AddTimer("Timer_RestateObjective", 2, "Timer_RestateObjective");
		Doorway_SetPlayerIsInGroup("EscapePod", false);
		Entity_SetActive("EscapePodLeaveBlocker_*", false);
		
		if (mbReactivateKillzoneAfterClimbAnim)
		{
			Entity_SetActive("KateKillzone", true);
		}
		
		///////////////////////////////////////////////
		// Plays the kate greeting line now if the 
		// player was eager to climb out of shuttle
		// (Lines are set up as Play Once in VoiceHandler)
		if (cScript_GetGlobalVarBool("RescuedKate"))
		{
			Voice_Play("2_SeesKate_Rescued");
		}
		else
		{
			Voice_Play("2_SeesKate_NotRescued");
		}

		Achievement_Unlock(eAchievement_Stranded);
	}
		
	//-------------------------------------------------------
	
	void HandAnimOver_ActivatePlayer(const tString &in asTimer)
	{
		Player_SetActive(true);
	}

	//-------------------------------------------------------
	
	bool DoorwayTrigger_EnterEscapePod(const tString &in asArea, const tString &in asEntity, int alState)
	{
		cLux_AddDebugMessage("DoorwayTrigger_EnterEscapePod");
		if (alState == 1)
		{
			Entity_SetActive("EscapePodClimbTrigger", true);
			Entity_SetActive("EscapePodLeaveBlocker_*", true);		
			
			mbReactivateKillzoneAfterClimbAnim = Entity_IsActive("KateKillzone");
			if (mbReactivateKillzoneAfterClimbAnim)
			{
				Entity_SetActive("KateKillzone", false);
			}
		}
		return true;
	}

	//-------------------------------------------------------
	bool mbHasExitRaftMusicPlayed = false;
	void Timer_LeavePodMusic(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Leave Pod Sound and Ambient Music Start");
		Sound_Stop("RiseIntoClimb", 0.5f);
		
		if(mbHasExitRaftMusicPlayed==false)
		{
			mbHasExitRaftMusicPlayed=true;
			Music_Play("02_03_afterescape", 0.95f, false, eMusicPrio_BigEvent);
			Sound_FadeGlobalVolume(0.65f, 12.0f, eSoundEntryType_WorldClean);
			Map_AddTimer("FadeUp", 20.0f, "FadeUpIntroMusic");
			Map_AddTimer("StartAmbient", cMath_RandRectf(60.f,70.f),"AmbientMusicHandler");
		}
	}


