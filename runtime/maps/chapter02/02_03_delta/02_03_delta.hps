	//-------------------------------------------------------
	
	int mlDeflectSlide = 1;
	bool mbSawDeflectSlideError = false;
	int mlGuiMainCol = 0;
	int mlGuiMainRow = 0;
	
	//-------------------------------------------------------
	
	void OnGuiMainBaseTerminal(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("02_03_delta");
		
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		StationGuiBG_Taskbar();
			
		if (StationGui_DrawAndCheckErrors()) return;
		
		int lActiveApp = StationGui_GetActiveApp(eMainBaseTerminalApp_MainMenu);
		bool bDoBackButton = true;
		
		/////////////////////////
		// States
		switch (lActiveApp)
		{
			case eMainBaseTerminalApp_MainMenu:
				StationGui_AddApp("RobotManual");
				StationGui_AddApp("Messages");
				StationGui_AddApp("AccessLog");
				StationGui_AddApp("ChessGame");
				StationGui_MainMenu();
				bDoBackButton = false;
				break;
			case eMainBaseTerminalApp_RobotManual:
				OnGuiDeflectInfo();
				break;
			case eMainBaseTerminalApp_Messages:
				MainBaseMessages();
				break;
			case eMainBaseTerminalApp_Log:
				MainBaseAccessLog();
				break;
			case eMainBaseTerminalApp_Chess:
				OnGuiChess("ChessStats_MainBase", 1.175);
				break;
		}
		
		StationGui_BackButton(bDoBackButton);
	}
	
	//-------------------------------------------------------
	
	void OnGuiDeflectInfo()
	{		
		for (int i = 1; i <= 4; i++)
		{
			cGuiTextFile file;
			file.mGfx = cImGuiGfx("deltabaseterminal_robot_"+i, eImGuiGfx_Texture);
			file.mGfx.mvUVMax = cVector2f(1, 0.775);
			file.mbHasImage = true;
			file.msTitle = "RobotManual_Name_"+i;
			file.msBody = "RobotManual_Robot_"+i;
			Depth_ImGui_AddTextFile(file);
		}
		cStationGui_TextReaderSettings textReader;
		textReader.msCustomHeader = "RobotManual";
		textReader.mbCorrectImageRatioForUV = true;
		StationGui_TextReaderMulti(textReader);
	}
	
	//-------------------------------------------------------
	
	void MainBaseMessages()
	{		
		Depth_ImGui_AddMail("MainBaseMailName_1", "MainBaseMail_1", "", "", eMailAppEntryType_Inbox);
		Depth_ImGui_AddMail("MainBaseMailName_2", "MainBaseMail_2", "", "", eMailAppEntryType_Inbox);
		Depth_ImGui_AddMail("MainBaseMailName_3", "MainBaseMail_3", "", "", eMailAppEntryType_Inbox);
		Depth_ImGui_AddMail("MainBaseMailName_4", "MainBaseMail_4", "", "", eMailAppEntryType_Inbox);
		StationGui_MailApp("");
	}
	
