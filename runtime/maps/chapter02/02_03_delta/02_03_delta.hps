    //-------------------------------------------------------
	
	bool mbAirlockFull = true;
 
    //-------------------------------------------------------
	
	void OnChangeAkerDoorPanel(const tString &in asEntity, int alState)
	{
		if (alState==-1) return;
		
		SetAkersDoorOpen(alState==1);
	}
 
    //-------------------------------------------------------
	
	void SetAkersDoorOpen(bool abOpen)
	{
		//////////////////////////////////////////////////////////////////////
		// Make sure state is set even when function is called from script
		MovingButton_SetSwitchedOn("AkersBuildingOuterPanel_Outside", abOpen, false);
		
		Map_RemoveTimer("PushAirlockDoor");
		Entity_SetInteractionDisabled("AkersSwingDoor", true);
		if (abOpen)
		{
			SwingDoor_SetLocked("AkersSwingDoor", false, true);
			SwingDoor_SetClosed("AkersSwingDoor", false, true);
			SwingDoor_SetDisableAutoClose("AkersSwingDoor", true);
			TimerPushAirlockDoorOpen("");
		}
		else
		{
			TimerPushAirlockDoorClosed("");
		}
	}
 
    //-------------------------------------------------------
	
	void TimerPushAirlockDoorOpen(const tString &in asTimer)
	{
		if (SwingDoor_GetState("AkersSwingDoor")==1) 
		{
			Entity_SetInteractionDisabled("AkersSwingDoor", false);
			return;
		}
		
		Entity_AddForce("AkersSwingDoor", cVector3f_Back*125, true, true);
		Map_AddTimer("PushAirlockDoor", 0.1, "TimerPushAirlockDoorOpen");
	}
 
    //-------------------------------------------------------
	
	void TimerPushAirlockDoorClosed(const tString &in asTimer)
	{
		if (SwingDoor_GetState("AkersSwingDoor")==-1) 
		{
			Entity_SetInteractionDisabled("AkersSwingDoor", false);
			SwingDoor_SetLocked("AkersSwingDoor", true, true);
			MovingButton_SetSwitchedOn("AkersBuildingOuterPanel_Outside", false, true);
			
			if (SequenceStates_IsActive("SequenceAirlockEmpty"))
				SequenceStates_Resume("SequenceAirlockEmpty");
			
			return;
		}
		
		Entity_AddForce("AkersSwingDoor", cVector3f_Forward*125, true, true);
		Map_AddTimer("PushAirlockDoor", 0.1, "TimerPushAirlockDoorClosed");
	}
 
    //-------------------------------------------------------
	
	void OnChangeActivateAirlock(const tString &in asEntity, int alState)
	{
		if (alState == -1) return;
		
		if(alState==1)
		{
			if(cLux_GetUnderwaterEffectsActive())
			{	
				Sound_CreateAtEntity("AirlockButton_UW", "Entities_Station/doors/tau/buttons/underwater/open", asEntity);
			}
			else
			{
				Sound_CreateAtEntity("AirlockButton", "Entities_Station/doors/tau/buttons/open", asEntity);
			}
		}
		
		if (mbAirlockFull) SequenceAirlockEmpty("");
		else 			  SequenceAirlockFill("");
	}
 
    //-------------------------------------------------------
	
	cSequenceStatesData mAirlockEmptySequence;
		
	void SequenceAirlockEmpty(const tString &in asTimer)
	{
		Sequence_Begin("SequenceAirlockEmpty", mAirlockEmptySequence);
		
		if (Sequence_DoStepAndWait(0.5))
		{
			//slight pause for pacing
			Swimbot_SetSoundsDisabled("Kate", true);
			Swimbot_SetSoundsDisabled("Goya", true);
		}	
		else if (Sequence_DoStepAndPause(0))
		{
			SetAkersDoorOpen(false);
			
			if (SwingDoor_GetState("AkersSwingDoor") == 1)
			{
				Sound_CreateAtEntity("AirlockDoorSweet", "shipwreck/doors/heavy_metal_door/airlock_close_sweetener", "AkersSwingDoor");
			}
			else
			{
				Entity_SetActive("Trigger_AirlockCloseSweetener", true);
			}
		}
		
		else if (Sequence_DoStepAndWait(1))
		{
			Sound_CreateAtEntity("PumpUW", "Entities_OceanBottom/airlock/uw/pump/pump_loop", "Pump_SoundSource", 0.0f, false, 1.0f);
		}
		else if (Sequence_DoStepAndWait(5))
		{
			if (!Entity_GetCollide("Player", "AkersBuildingLiquidArea_Up"))
			{
				Sound_Stop("PumpUW", 0.55f);
				cLux_AddDebugMessage("MovingButton_SetSwitchedOn 1");
				MovingButton_SetSwitchedOn("AirlockActivateButton", false, false);
				Sequence_Stop();
				return;
			}
			mbAirlockFull = false;
			mbIgnoreCameraCollide = true;
			Entity_SetActive("AkersBuildingLiquidArea", true);
			LiquidArea_MoveLinearTo("AkersBuildingLiquidArea","AkersBuildingLiquidArea_Down",0.1, 1, 0.5, false);
			cLux_AddDebugMessage("SequenceAirlockEmpty");
			Map_SetUnderwater(false,false);
			
			//////////////////////////
			///Airlock draining sound
			Depth_Audio_AirlockDrainLeadInUW();
			Map_AddTimer("AirlockDrainUWStopTimer", 5.0f, "AirlockDrainUWStop");
			Map_AddTimer("StopAmbientMusic", 1.0f, "AmbientMusicHandler");
			
			//Map_SetEnvironmentParticleGravityVelocity()
			
			Entity_SetActive("AkersBunkerOccluder_*", false);
			FogArea_SetVisible("AkersBunkerFog_*", false);
		}
		else if (Sequence_DoStepAndWait(8))
		{
			Entity_SetActive("Trigger_MusicBunker_4", true);
			Map_SetUnderwater(false);
			Entity_SetInteractionDisabled("AkersSwingDoor", true);
		}
		else if (Sequence_DoStepAndWait(1))
		{
			OnChangeDoorButton("AkersBuildingInnerPanel_Inside", 1);
			Button_SetSwitchedOn("AkersBuildingInnerPanel_Inside", true, false);
		}
		else
		{
				cLux_AddDebugMessage("MovingButton_SetSwitchedOn 2");
			MovingButton_SetSwitchedOn("AirlockActivateButton", false, true);
		}
		Sequence_End();
	}
	
	
	void AirlockDrainUWStop(const tString &in asTimer)
	{
		//////////////////////////////////////
		//Turn on Akers Bunker Soundscape Area and turn off scuba sounds
		Entity_SetActive("AMB_BunkInt_1", true);
		Entity_SetActive("AMB_Airlock_Air_1", true);
				
		Entity_SetActive("AMB_Airlock_Water_1", false);
		Entity_SetActive("AMB_Global", false);

		Sound_Stop("Pump_Idle_Loop_Underwater", 1.0f);
		Depth_Audio_PlayLeaveWater();
		Sound_Stop("PumpUW", 0.55f);
		Sound_CreateAtEntity("PumpingAirLoop", "Entities_OceanBottom/airlock/air/pump/pump_loop_nointro", "Pump_SoundSource", 0.55f, false, 1.0f);
			
		Depth_Audio_AirlockDrainLoopUWStop();
		Depth_Audio_AirlockDrainLoopAir();
		Map_AddTimer("AirlockDrainingAirStopTimer", 3.0f, "AirlockDrainingAirStop");
	}
	
	void AirlockDrainingAirStop(const tString &in asTimer)
	{
		Depth_Audio_AirlockDrainLoopAirStop();
		Depth_Audio_AirlockDrainLeadOutAir();
		Sound_Stop("PumpingAirLoop", 0.25f);
		Sound_CreateAtEntity("PumpAirLeadOut", "Entities_OceanBottom/airlock/air/pump/pump_end", "Pump_SoundSource", 0.0f, false, 1.0f);
	}
	
    //-------------------------------------------------------
	
	cSequenceStatesData mAirlockFillSequence;
		
	void SequenceAirlockFill(const tString &in asTimer)
	{
		Sequence_Begin("SequenceAirlockFill", mAirlockFillSequence);
		
		if (Sequence_DoStepAndWait(0.5))
		{
				//slight pause for pacing
		}
		else if (Sequence_DoStepAndPause(0.5))
		{
			OnChangeDoorButton("AkersBuildingInnerPanel_Inside", -1);
			Button_SetSwitchedOn("AkersBuildingInnerPanel_Inside", false, false);
			
			if (Entity_GetCollide("AkersBuildingInnerDoor", "AirlockInnerDoorClosedTrigger"))
			{
				SequenceStates_Resume("SequenceAirlockFill");
			}
		}
		else if (Sequence_DoStepAndWait(6))
		{
			if (!Entity_GetCollide("Player", "AkersBuildingLiquidArea_Up"))
			{
				cLux_AddDebugMessage("MovingButton_SetSwitchedOn 3");
				MovingButton_SetSwitchedOn("AirlockActivateButton", false, false);
				Sequence_Stop();
				return;
			}
			mbAirlockFull = true;
			LiquidArea_MoveLinearTo("AkersBuildingLiquidArea","AkersBuildingLiquidArea_Up",0.1, 1, 0.5, false);
			//Map_SetEnvironmentParticleGravityVelocity()
			
			AirlockEffectsFillWithWater();
			Sound_CreateAtEntity("AirlockAirPump", "Entities_OceanBottom/airlock/air/pump/pump_loop", "Pump_SoundSource");
			
			Entity_SetActive("AkersBunkerOccluder_*", true);
			FogArea_SetVisible("AkersBunkerFog_*", true);
		}
		else if (Sequence_DoStepAndWait(7))
		{
			Map_SetUnderwater(true);
			Entity_SetActive("Trigger_MusicBunker_4", false);
			Entity_SetInteractionDisabled("AkersSwingDoor", false);
		}
		else
		{
			mbIgnoreCameraCollide = true;
			Entity_SetActive("AkersBuildingLiquidArea", false);
			cLux_AddDebugMessage("SequenceAirlockFill");
			Map_SetUnderwater(true,false);
			
			Map_AddTimer("StartAmbient", cMath_RandRectf(3.f,6.f),"AmbientMusicHandler");
			
			SetAkersDoorOpen(true);
			Sound_CreateAtEntity("DoorUnlock", "shipwreck/doors/heavy_metal_door/unlock", "AkersSwingDoor");
				cLux_AddDebugMessage("MovingButton_SetSwitchedOn 4");
			MovingButton_SetSwitchedOn("AirlockActivateButton", false, true);
			
			Swimbot_SetSoundsDisabled("Kate", false);
			Swimbot_SetSoundsDisabled("Goya", false);
			BarkMachine_SetActive("Goya", false);
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	bool Trigger_AirlockCloseSweetener(const tString &in asParent, const tString &in asChild, int alState)
	{
		Sound_CreateAtEntity("AirlockLockingSweet", "shipwreck/doors/heavy_metal_door/bulkhead_airlock_door_locking_sweetener", asChild);
		Entity_SetActive("Trigger_AirlockCloseSweetener", false);
		return true;
	}
	
	//-------------------------------------------------------
	//Airlock audio
	void AirlockEffectsFillWithWater()
	{
		Depth_Audio_AirlockFillingLeadInAir();
		Depth_Audio_AirlockFillingLoopAir();
		Map_AddTimer("AirlockFillingAirStopTimer", 6.f, "AirlockFillingAirStop");
	}

	void AirlockFillingAirStop(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Underwater airlock sounds start");
			
		Sound_CreateAtEntity("AirlockFillingLoopUW", "Entities_OceanBottom/airlock/uw/water/filling/loop", "Player", 1.f, false, 1.0f);
		Depth_Audio_AirlockFillingLoopAirStop();
		Depth_Audio_PlayEnterWater();
			
		///////////////////
		//Pump Sounds
		Sound_CreateAtEntity("AirlockFillingPumpLoopUW", "Entities_OceanBottom/airlock/uw/pump/pump_loop_nointro", "Pump_SoundSource", 0.0f, false, 1.0f);
		Sound_Stop("AirlockAirPump", 0.5f);
			
		///////////////////////////////////////
		//Turn off Akers Bunker and airlock dry soundarea, turn on Airlock water soundarea and turn on suit sounds
		Entity_SetActive("AMB_BunkInt_1", false);
		Entity_SetActive("AMB_Airlock_Air_1", false);
			
		Entity_SetActive("AMB_Global", true);
		Entity_SetActive("AMB_Airlock_Water_1", true);
			
		Map_AddTimer("AirlockFillingLoopUWStopTimer", 4.0f, "AirlockFillingLoopUWStop");
	}
		
	void AirlockFillingLoopUWStop(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Underwater airlock sounds stop");
			
		///////////////////
		//Pump Sounds
		Sound_Stop("AirlockFillingLoopUW", 1.25f);			
		Sound_Stop("AirlockFillingPumpLoopUW", 1.25f);
		Sound_CreateAtEntity("AirlockFillingLeadOutUW", "Entities_OceanBottom/airlock/uw/water/filling/end", "Player", 1.f, false, 1.0f);
		Sound_CreateAtEntity("PumpUWLeadOut", "Entities_OceanBottom/airlock/uw/pump/pump_end", "Pump_SoundSource", 0.0f, false, 1.0f);
	}
	//} END EVENT
 
    //-------------------------------------------------------
	
	bool CollisionAirlockInnerDoorClosed(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1 && SequenceStates_IsActive("SequenceAirlockFill"))
			SequenceStates_Resume("SequenceAirlockFill");
			
		return true;
	}
 
    //-------------------------------------------------------
	
	bool CollisionAirlockSurface(const tString &in asParent, const tString &in asChild, int alState)
	{
		return true;
	}
	
	bool mbIgnoreCameraCollide = false;
	void CameraCollide_Airlock(int alState)
	{
		if (mbIgnoreCameraCollide)
		{
			mbIgnoreCameraCollide = false;
			return;
		}
		Map_SetEnvironmentParticlesActive(alState==1);
		if (alState==1) 
			Effect_Screen_Start("water_splash_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 0.1f, 0.7f, 0.7f);
	}
 
    //-------------------------------------------------------
	
	bool CollisionPlayerEnteredAkersBunker(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1) return true;
		bool bEntered = Entity_PlayerIsInFront(asChild);
		
		BarkMachine_SetActive("Goya", !bEntered);
		
		if (bEntered && !mbStopKateFollowing)
		{
			if (mbKateWeldingInProgress) StopKateWelding();
			Kate_Investigate("Kate", "AkerAntennaInvestigationNode", "AntennaTerminal_Peripheral1", -1);
		}
		else if (!mbStopKateFollowing)
		{
			if (mbKateWeldingInProgress) StopKateWelding();
			Kate_FollowPlayer("Kate");
		}
		
		return true;
	}
 
