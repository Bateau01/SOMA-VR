	//-------------------------------------------------------
 
    /////////////////////////////////////////
    // ==============
    // PRELOAD
    // ==============
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	bool PreloadDisabled(bool abCheckScriptDebug, bool abCheckIfPreloading = true)
	{
		if(abCheckScriptDebug && cLux_ScriptDebugOn())
		{
			cLux_AddDebugMessage("PRELOAD DISABLED!"); 
			
			return true;
		}

		if(abCheckIfPreloading == true && Map_IsPreloading() == false)
			return true;
			
		return false;
	}
	
	//-------------------------------------------------------
	
	void Preload(bool abCheckScriptDebug=true)
	{
		if(PreloadDisabled(abCheckScriptDebug, false)) return;
		
		Map_Preload("02_04_theta_outside.hpm", eWorldStreamPriority_Low);
	}

	//-------------------------------------------------------
	
	void PreloadSetPrioNormal(bool abCheckScriptDebug=true)
	{
		if(PreloadDisabled(abCheckScriptDebug)) return;
		
		Map_SetPreloadPriority(eWorldStreamPriority_Normal);
	}
		
	//-------------------------------------------------------
	
	void PreloadDeload(bool abCheckScriptDebug=true)
	{
		if(PreloadDisabled(abCheckScriptDebug)) return;
		
		Map_Deload("transfer2324");
	}
	
	//-------------------------------------------------------
	
	void PreloadChangeOfMap(bool abCheckScriptDebug=true)
	{
		if(PreloadDisabled(abCheckScriptDebug)) 
		{
			PreloadManualChangeMap();
			return;
		}
		
		//PreloadDeload();
		
		Map_AddTimer("FadeGlobal", 0, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	bool mbGlobalCopyCompleted = false;
	void PreloadTimer(const tString &in asTimer)
	{
		////////////////////////////
		//Preload - Change map globals when possible.
		if(asTimer == "FadeGlobal")
		{
			cLux_AddDebugMessage("Map_CopyGlobalSettings");
			if(mbGlobalCopyCompleted)
			{
				Map_AddTimer("FadePreset", 0, "PreloadTimer");
				Map_AddTimer("MapDeload", 2.5, "PreloadTimer");
				Map_AddTimer("ChangeMap", 13.6, "PreloadTimer");
				Map_AddTimer("ChangePrio", 15.6, "PreloadTimer");
				Map_AddTimer("ChangeMapNotReady", 17, "PreloadTimer");
				
				return;
			}
			
			mbGlobalCopyCompleted = Map_CopyGlobalSettings(Map_GetPreloadMap(), 5);
			
			Map_AddTimer("FadeGlobal", 5.5, "PreloadTimer");
		}

		if(asTimer == "FadePreset")
		{
			cLux_AddDebugMessage("Map_FadeEnvironmentParticleColor");
			Map_Preset_Fade("Outside2.4", 7); 
			Map_FadeEnvironmentParticleColor("*", cColor(0.295,0.556,0.59,1.0), 7);
			Map_FadeEnvironmentParticleBrightness("*", 1, 7);
		}

		if(asTimer == "MapDeload")
		{
			///////////////////////////////////////////////
			// Entities will be destroyed, so 
			// remove script dependencies throwing errors
			for (int i = 1; Entity_Exists("LandingPadLamp_"+i); i++)
			{
				Map_RemoveTimer("LandingPadLamp_"+i);
			}
			Map_RemoveTimer("Timer_CheckGoyaMovement");
			
			Map_Deload("transfer_deload");
		}
		
		if(asTimer == "ChangePrio")
		{
			Map_SetPreloadPriority(eWorldStreamPriority_High);
		}
		
		////////////////////////////
		//Preload - Change map when possible
		if(asTimer == "ChangeMap")
		{
			if(Map_IsPreloadCompleted())
			{
				//cLux_SaveScreenshotToFile(tWString("2_3_Audio_Test_1"));
				
				Entity_SetActive("LiftoffBlocker_*", false);
				Entity_SetActive("ZeppelinPlatformRailing_*", false);
				Entity_SetActive("StunRodInnerHatch", false);
				Entity_SetActive("StunRodLockboxButton", false);
				Entity_SetActive("zeppelin_searchlight01_1", false);
				Entity_SetActive("zeppelin_searchlight01_2", false);
				Entity_SetActive("LiftoffLever", false);
				Entity_SetActive("LiftoffButton", false);
				Entity_SetActive("LiftoffLever_Lamp", false);
				Entity_SetActive("LiftoffButton_Lamp", false);
				Entity_SetActive("CathTool", false);
				Entity_SetActive("CathChip_New", false);
				
				cScript_SetGlobalVarBool("TransitionFrom2.3", true); //Starting position of zep is different if transition from regular load.
				
				Description_SetForceFading(true);
				Map_ChangeMap("02_04_theta_outside.hpm", "", "transfer2324", "", "");
				
				//cLux_SetGamePaused(true);
			}
			else Map_AddTimer("ChangeMap", 0.55f, "PreloadTimer");
		}
		
		if(asTimer == "ChangeMapNotReady")
		{
			Description_Add("02_05_theta_inside", "ScanRoom_Legacy_Loading", 10, false);
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
		}
	}
		
	//-------------------------------------------------------

	void PreloadManualChangeMap()
	{
		Map_ChangeMap("02_04_theta_outside.hpm", "PlayerStartArea_1", "", "");
	}
	
