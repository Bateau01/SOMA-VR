	//-------------------------------------------------------
	
	tString msAntennaLocation;
	int mlComChannel = 2;
	bool mbZeppelinCallFailed = false;
	bool mbZeppelinOnRoute = false;
	bool mbZeppelinArrived = false;
	bool mbTriedOpeningTrainDoor = false;
