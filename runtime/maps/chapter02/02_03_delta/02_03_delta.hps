    // Scene 2 Event B *Stress signal sent; Robot dispatched*
    /////////////////////////////////////////

	//-------------------------------------------------------
 
    //-------------------------------------------------------
 
    /////////////////////////////////////////
    // Scene 2 Event C *Push open door, meet robot & climb out (dialog)*
    /////////////////////////////////////////

	//-------------------------------------------------------
	
	bool mbTriedShuttleDoor = false;
	bool mbClimbedOutOfShuttle = false;
	bool mbStartAutosaveDone = false;
	bool mbReactivateKillzoneAfterClimbAnim = false;

	//-------------------------------------------------------
	
	bool CollisionEscapeDoorStuck(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == -1) return true;
		
		if (mbTriedShuttleDoor)
		{
			if (Map_TimeHasPassed("JammedDoor", 0.75))
				Sound_CreateAtEntity("JammedDoor", "Entities_OceanBottom/doors/escape_pod_door/escape_pod_door_close", asParent, 0.0f, false, 1.0f);
		}
		else
		{
			mbTriedShuttleDoor = true;
			//Entity_SetActive("EscapePodDoorBlocker_2", true);
			Sound_CreateAtEntity("JammedDoor", "02_03_delta/SFX/pod_crash/pod_door_jammed_interact", "Player", 0.0f, false, 1.0f);
			//Entity_SetInteractionDisabled("EscapePodDoor", true);
			Voice_Play("2_DoorIsStuck");
			
			if (mbAllowKateWelding)
			{
				Map_AddTimer("PlayKateApproachSound", 2.0f, "KateApproachSound");
				Map_AddTimer("BeginWeldingTimer", 7.0f, "SequenceKateRescue");
			}
				
			mbAllowKateWelding = true;
		}
		
		return true;
	}

	//-------------------------------------------------------
	
	void KateApproachSound(const tString &in asTimer)
	{
		Sound_CreateAtEntity("KateApproach", "02_03_delta/SFX/pod_crash/kate_approach_pod", "Player", 0.0f, false, 1.0f);
		cLux_AddDebugMessage("Kate approach sound triggered");
	}

	//-------------------------------------------------------
	
	cSequenceStatesData mKateRescueSequence;
		
	void SequenceKateRescue(const tString &in asTimer)
	{
		Sequence_Begin("SequenceKateRescue", mKateRescueSequence);
			
		/////////////////////
		// Start welding
		if (Sequence_DoStepAndPause(0))
		{
			Entity_SetActive("WeldingFlare", true);
			Entity_SetEffectsActive("WeldingFlare", true, true);
			ParticleSystem_CreateAtEntityExt("WeldingFlare_PS", "welding_flare.ps", "WeldingFlare", true, cColor(1,0.885,0.613,1), 30);
			Sound_CreateAtEntity("KateWelding", "NPC_Kate/tool/torch", "WeldingFlare", 0.0, true);
			Prop_MoveLinearTo("WeldingFlare", "WeldingFlareTarget_1", 0.5, 0.15, 0.1, true);
			cLux_AddDebugMessage("KateAtCrashSite");
		}
		for (int i = 2; Entity_Exists("WeldingFlareTarget_"+i); i++)
		{
			if (!Sequence_DoStepAndPause(0)) continue;
			
			Prop_MoveLinearTo("WeldingFlare", "WeldingFlareTarget_"+i, 10, 0.15, 0.1, true);
		}
		
		/////////////////////
		// Stop welding
		if (Sequence_DoStepAndWait(1.5))
		{
			Sound_Stop("KateWelding", 0);
			Entity_SetEffectsActive("WeldingFlare", false, true);
			ParticleSystem_Destroy("WeldingFlare_PS");
			LensFlare_SetVisible("WeldingFlare_LensFlare_*", false);
			SwingDoor_SetBlocked("EscapePodDoor", false, true);
			Entity_PlaceAtEntity("Kate", "KateRescuePlayerTarget");
			Agent_FaceEntity("Kate", "KateOutsideEscapePod");
		}
		
		/////////////////////
		// Kate Clamping to door and rip off sound	
		else if (Sequence_DoStepAndWait(1.1))
		{
			Sound_CreateAtEntity("DoorRippedOpen", "02_03_delta/SFX/pod_crash/pod_door_ripped_open", "EscapePodDoor_Grab", 0, false);
		}
		
		/////////////////////
		// Rip door open
		else if (Sequence_DoStepAndPause(0))
		{
			if (Entity_IsInteractedWith("EscapePodDoor"))
			{
				Player_ChangeStateToNormal();
				Player_SetLookSpeedMul(0);
				Player_FadeLookSpeedMulTo(1, 1);
			}
			
			Entity_SetActive("EscapePodDoor_Grab", true);
			Entity_SetActive("EscapePodDoor", false);
			Entity_SetActive("EscapePodDoorBlocker_*", false);
			Entity_PlaceAtEntity("EscapePodDoor_Grab", "EscapePodDoor");
			Entity_AddImpulse("EscapePodDoor_Grab", cVector3f(3, 0, -2.0), true, true); 
			Body_SetCollides("EscapePodDoor_Grab_Body_1", false);
			Entity_SetInteractionDisabled("EscapePodDoor_Grab", true);
			
			Effect_Shake_Start(0.05, 0, 0, 0.5);
			
			Map_AddTimer("DoorOpenFailsafe_Simple", 0.5, "Timer_DoorOpenFailsafe");
			Map_AddTimer("DoorOpenFailsafe_Extreme", 3, "Timer_DoorOpenFailsafe");
		}
		else if (Sequence_DoStepAndWait(0.25))
		{
			Map_RemoveTimer("DoorOpenFailsafe_Simple");
			Map_RemoveTimer("DoorOpenFailsafe_Extreme");
			Joint_Break("EscapePodDoor_Grab_Joint");
		}
		else if (Sequence_DoStepAndWait(0.25))
		{
			Body_SetCollides("EscapePodDoor_Grab_Body_1", true);
			Entity_SetInteractionDisabled("EscapePodDoor_Grab", false);
		}
		
		////////////////////////////////////
		// Kate shows her cute little face
		else if (Sequence_DoStepAndPause(0))
		{
			Entity_SetEffectsActive("Kate", true, true);
			Pathfinder_MoveToNode("Kate", "KateRescueInspectionNode", "PathfinderKateIntroduction");
			Music_Play("01_03_rescuekate", 0.45, false, eMusicPrio_MinorEvent);
			Entity_SetActive("EscapePodClimbTrigger", true);
		}
		else if (Sequence_DoStepAndWait(3.5))
		{
			Kate_LookAt("Kate", "Player");
			CharMover_SetUseMoveStateAnimations("Kate", false);
			Entity_PlayAnimation("Kate", "idle_extra01", 0.1, false, true, "KateGreetingAnimOver");
			Sound_CreateAtEntity("HelpfulKate", "NPC_Kate/talk/katebot_greeting", "Kate", 0, false);
		}
		else if (Sequence_DoStepAndWait(3.25))
		{
			if (PlayerHands_GetAnimationPlaying()==false)
			{
				if (cScript_GetGlobalVarBool("RescuedKate"))
				{
					Voice_Play("2_SeesKate_Rescued");
				}
				else
				{
					Voice_Play("2_SeesKate_NotRescued");
				}
			}
		}
		else if (Sequence_DoStepAndWait(1.5))
		{
			Sound_CreateAtEntity("HelpfulKate", "NPC_Kate/talk/katebot_idle_talk", "Kate", 0, false);
		}
		else if (Sequence_DoStepAndWait(3))
		{
			Pathfinder_MoveToNode("Kate", "KateWaitOutsidePodNode", "");
		}
		else if (Sequence_DoStepAndWait(3))
		{
			if (mbClimbedOutOfShuttle==false) Kate_LookAt("Kate", "Player");
		}
		
		
		Sequence_End();
	}
	
	void Timer_DoorOpenFailsafe(const tString &in asTimer)
	{
		if (asTimer=="DoorOpenFailsafe_Simple")
		{
			cLux_AddDebugMessage("DoorOpenFailsafe_Simple activated");
			Entity_AddImpulse("EscapePodDoor_Grab", cVector3f(3, 0, -2.0), true, true);
			Map_RestartCurrentTimer(0.1);
		}
		else
		{
			cLux_AddDebugMessage("DoorOpenFailsafe_Extreme activated");
			Entity_SetActive("EscapePodDoor_Grab", false);
			SequenceStates_Resume("SequenceKateRescue");
		}
	}

