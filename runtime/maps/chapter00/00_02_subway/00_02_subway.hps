		Material_Preload("00_02_signal_error.mat");
		Material_Preload("00_02_arriving_station_osgoode.mat");
		Material_Preload("00_02_arriving_station_st_patrick.mat");
		Material_Preload("00_02_arriving_station_queens_park.mat");
	}

	//-------------------------------------------------------
	
	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//////////////////////////////////
		// INIT VARIABLES
		mlTrainDistance = 0;
		mlTrainStopCount = 0;
		mfMaxHandleForce = 0;
		mbTrainHasStopped = true;
		mbTrainIsAccelerating = false;
		mbTrainIsStopping = false;		
		mfTrainBounce = 0;
		mfNextTrainBounce = 0;
		mfDebrisForces = 0;
		mlNumUpdates = 0;
		
		
		/////////////////////////
		//SOUND AND MUSIC
		Sound_SetGlobalVolume(0.0f, eSoundEntryType_WorldAll);
		
		/////////////////////////
		//INIT VISUALS
		Effect_Fade_Out(0);
		
		////////////////////////////
		// Start level
		Move_Train(10, 1.1);
		
		Player_Teleport("PlayerStartArea_1",true);
		Player_SetJumpDisabled(true);
		Player_SetCrouchDisabled(true);
		Player_SetStandDisabled(true);
		Player_SetHeadBobMul(0.0f);
		
		mvSavedPitchLimits = Player_GetPitchLimits();
		Player_SetPitchLimits(-40, 20);
		Player_SetYawLimits(-240, -120);
		
		if (EyeTracking_IsActive())
		{
			Player_SetPitchLimits(-30, 20);
			EyeTracking_SetExtendedViewMul(0.7f);
		}
			
		Map_AddTimer("level_begin", 1, "TimerFadeInLevel");
		Map_AddTimer("TimerStartPhoneCall",20.5,"Seq_PhoneCall");
		
		/////////////////
		//INIT PLAYER
		Player_SetFlashlightDisabled(true);		
		Player_StartLookAt("AreaStartLookAt", 4, 4, 4);
		Player_SetMoveSpeedMul(0);
		Player_SetLookSpeedMul(0.7);
		Player_SetFootWear("sneaker");
		Player_SetClothing("dressed");

		Player_SetCrossHairState(eCrossHairState_None);
		
		PlayerHands_SetHandModel_Human();
		
		//Player_SetPitchLimits(cMath_ToDeg(-0.9), cMath_ToDeg(0.7));		

		////////////////////////////////////////
		// Setup Sound
		Map_AddTimer("BumPlayer", cMath_RandRectf(6.0f, 8.0f), "BumLine");
		
		/////////////////////////////////////
		// Entity Setup
		mBaseObj.GetEntityByName("debris_emptybottle").GetBody(0).SetAngularDamping(200);
		Entity_PlayAnimation("subway_girl_2", "erin_subway", 0.1f, true);
		Entity_SetActive("simon_body", false);
		
		////////////////////////////////////////
		// SETUP NPCs
		Entity_AttachToSocket("tablet", "subway_businessman_1", "pad", true);
		Map_GetEntity("subway_bum_1").GetMeshEntity().SetVisible(false);
		
		/////////////////////////////////////////
		// DEBUG, PLAYER GLOBAL VARS
		if(cLux_ScriptDebugOn())
		{
			Effect_Fade_In(0);
		}
		
	}
	
	//-----------------------------------------------------
	
	///////////////////////////////////////////
	// Map Update
	void Update(float afTimeStep)
	{	
		if (mbIntroStarted == false) return;
		
		///////////////////////////////////////////////////////////////////
		// Make train carriages move for realism
		if (mbTrainHasStopped == false)
		{
			Move_Outer_Carriages(afTimeStep);
		}
	}
	
	//-------------------------------------------------------
	
	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
		MainMenu_SetBGPhase(eMainMenuPhase_Initial_To_1_3);
		
		if(cLux_ScriptDebugOn() == false) Game_AutoSave();
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
        mVRPhone.End();
		// Allow player to look around
		Player_SetPitchLimits(mvSavedPitchLimits.x,mvSavedPitchLimits.y);
		Player_SetYawLimits(0, 0);	
		
		Player_SetMoveSpeedMul(1);
		Player_SetLookSpeedMul(1);
		Player_SetStandDisabled(false);
		Player_SetJumpDisabled(false);
		Player_SetCrouchDisabled(false);
		Player_SetHeadBobMul(1.0f);
		
		Player_SetCrouching(false);
		Player_ChangeStateToNormal();
	}

