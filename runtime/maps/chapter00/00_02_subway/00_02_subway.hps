	/////////////////////////////////////////

	//-------------------------------------------------------

	void TimerFadeInLevel(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Fade start");
		
		//////////////////////////
		// Sound
		Sound_FadeGlobalVolume(1.0f, 7.0f, eSoundEntryType_WorldAll);
		Sound_CreateAtEntity("SubwaySweet", "00_01_subway/SFX/subway_sweetener", "Player");
		
		///////////////
		//INIT LEVEL - TRAIN/WALLS
		ConstructTunnelAndTrainRig();
		cLux_GetCurrentMap().GetEntityArrayID("holding_handle_*", eLuxEntityType_LastEnum, "", mvHandles);
		Entity_SetInteractionDisabled("debris_*",false);
		
		//Train_SetCorrectStationWalls();
		
		//////////////////////////
		// Fade in - visuals on timer to sync with music
		Map_AddTimer("VisualsFadeIn", 3.5f, "VisualsFadeIn");
		Player_StopLookAt(0);
		Entity_SetActive("simon_body", true);
		
		////////////////////
		// NPCs
		NPC_StartBehaviour();
		Map_GetEntity("subway_bum_1").GetMeshEntity().SetVisible(true);
		
		///////////////////////
		// Start train bounce
		Map_AddTimer("TrainBounce",1.0,"Timer_TrainBounce");	
		
		mbIntroStarted = true;
			
		if(cLux_ScriptDebugOn()==false)
		{
			Map_Preload("00_03_laboratory.hpm");
			Map_SetPreloadPriority(eWorldStreamPriority_Low);
		}
	}
	
	//-------------------------------------------------------
	
	void VisualsFadeIn(const tString &in asTimer)
	{
		Effect_Fade_In(0.5f);
		Music_FadeVolumeMul(0.45f, 10.0f);
	}
	
	void Timer_StartTrip(const tString &in asTimer)
	{
		Move_Train(0.9, 1.1);
	}
	
	//-------------------------------------------------------
	
	float mfPreloadTimeout = 15.0f;
	void TimerEndLevel(const tString &in asTimer)
	{
		if (Map_IsPreloadCompleted()==false && mfPreloadTimeout > 0)
		{
			cLux_AddDebugMessage("Preloading not completed!");
			const float fPreloadDelay = 5;
			Map_AddTimer("TimerEndLevel", fPreloadDelay, "TimerEndLevel");
			mfPreloadTimeout-=fPreloadDelay;
			Map_SetPreloadPriority(eWorldStreamPriority_High);
			return;
		}
		
		mbTrainDoorsAllowed = false;
		Effect_Fade_Out(2.5);	// fade to black
		mbFadeOutStarted = true;
		
		//Allow graceful fading of music before next level trigger
		Music_Stop(10.0f, eMusicPrio_BgAmb);
		Sound_FadeGlobalVolume(0.0f, 5.0f, eSoundEntryType_World);
		Map_AddTimer("timer_transition",11,"EndLevel");	
	}
	
	//-------------------------------------------------------
	
	void EndLevel(const tString &in asTimer)
	{	
		Map_ChangeMap("00_03_laboratory.hpm","PlayerStartArea_1","","");
		
		//cLuxMap@ pMap = cLux_GetLoadedMap("00_03_laboratory.hpm");
		//cLux_SetSubMap(pMap,eLuxSetSubmapPosition_MoveToStartPos,"PlayerStartArea_1");
	}
	
