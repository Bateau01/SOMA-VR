	//---------------------------------------------------------

    void VRPhoneQ_Tick(const tString &in timer)
    {
        if(mVRPhone.state==0) return;
        // Resume the authored presentation when an unanswered VR save is loaded flat.
        if(mVRPhone.state==1 && !VRPhoneQ_Active())
        {
            mVRPhone.End();
            Entity_SetActive("Cellphone",true);Entity_CallEntityInteract("Cellphone");
            return;
        }

        int result=mVRPhone.Tick(15.0f);
        if(result==1 || result==2 || result==3)
        {
            Sound_Stop("CellphoneRing",0.1f);
            SequenceStates_Resume("Seq_PhoneCall");
            if(result==1)
            {
                mbAnsweredPhone=true;
                Map_AddTimer("FadeVolume",1.0f,"Timer_ConversationAudio");
                bool sent=cScript_GetGlobalVarBool("PlayerSentApartmentEmail");
                Voice_Play(sent ? "Phonecall_EmailSent" : "Phonecall_EmailNotSent",-1,"PhonecallOver",0);
            }
            else if(result==3)
            {
                mbHungUpPhone=true;
                Map_AddTimer("VRPhoneX_End",2.0f,"VRPhoneX_End");
                Map_AddTimer("TimerEndLevel",20.0f,"TimerEndLevel");
                Map_SetPreloadPriority(eWorldStreamPriority_Normal);
            }
            else
            {
                mbIgnoredPhone=true;mVRPhone.End();
                Map_AddTimer("TimerEndLevel",7.5f,"TimerEndLevel");
                Map_SetPreloadPriority(eWorldStreamPriority_Normal);
            }
        }
        if(mVRPhone.state!=0) Map_AddTimer("VRPhoneQ",0.05f,"VRPhoneQ_Tick");
    }
    void VRPhoneX_End(const tString &in timer) { mVRPhone.End(); }
}