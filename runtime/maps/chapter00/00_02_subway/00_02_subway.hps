	//-------------------------------------------------------
	
	bool mbIgnoredPhone = false;
	bool mbAnsweredPhone = false;
	bool mbHungUpPhone = false;
	
	//-------------------------------------------------------
	
	cSequenceStatesData mPhoneCallSequence;
		
	void Seq_PhoneCall(const tString &in asTimer)
	{
		Sequence_Begin("Seq_PhoneCall", mPhoneCallSequence);
			
		if (Sequence_DoStepAndWait(3))
		{
			cLux_AddDebugMessage("Seq_PhoneCall");
			Sound_CreateAtEntity("CellphoneRing", "Entities_Urban/tech/cellphone/ringing_hand", "Player");
		}
		else if (Sequence_DoStepAndWait(0.2))
		{
		}
		else if (Sequence_DoStepAndPause(0.5))
		{
            if(mVRPhone.Begin("")) Map_AddTimer("VRPhoneQ",0.05f,"VRPhoneQ_Tick");
            else
            {
			Entity_SetActive("Cellphone", true);
			Entity_CallEntityInteract("Cellphone");
            }
		}
		else if (Sequence_DoStepAndWait(1))
		{
		}
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	void PhonecallOver(const tString&in asScene, const tString&in asSubject)
	{
        mVRPhone.End();		
		//mbLooping = false;
		//Entity_SetActive("TrainLoopPoint_End", false);
		Map_AddTimer("TimerEndPhoneBeep",0.5,"TimerEndPhoneBeep");
		Map_AddTimer("ResumeVolume", 1.0f, "Timer_ConversationAudio");
		Map_AddTimer("TimerEndLevel", 6.5f, "TimerEndLevel");
	}
	
	//-------------------------------------------------------
	
	void TimerEndPhoneBeep(const tString& in asName)
	{
		Sound_CreateAtEntity("PhoneBeep", "00_01_subway/SFX/phone_beep_action", "Player");
	}
	
	//-------------------------------------------------------
	
	void OnGuiPhone(const tString&in asEntityName, float afTimeStep)
	{
		if (ImGui_IsFirstRun())
		{
			CellPhoneGui_SetClockString("00_02_Time");
			CellPhoneGui_SetReceptionIcons("B");
			CellPhoneGui_StartRinging("jesse", 15.0f);	// Timeout after 12 secs
		}
		
		eCellPhoneGuiAction action = CellPhoneGui_Update();
	
		if (action==eCellPhoneGuiAction_Answered||
			action==eCellPhoneGuiState_Rejected||
			action==eCellPhoneGuiAction_MissedCall)
		{
			// We put away the phone and stop the ringing no matter what
			Sound_Stop("CellphoneRing", 0.1);
			ImGui_AddTimer("PutAwayPhone", 2);
		}
		
		if (action==eCellPhoneGuiState_Rejected)
		{
			mbHungUpPhone = true;
			Map_AddTimer("TimerEndLevel", 20, "TimerEndLevel");
			Map_SetPreloadPriority(eWorldStreamPriority_Normal);
		}
		else if (action==eCellPhoneGuiAction_Answered)
		{
			mbAnsweredPhone = true;
			Terminal_SetShowMouse(asEntityName,false);
			
			Map_AddTimer("FadeVolume", 1.0f, "Timer_ConversationAudio");
			
			bool bMailSent = cScript_GetGlobalVarBool("PlayerSentApartmentEmail");
			tString sSubject = bMailSent ? "Phonecall_EmailSent" :
										   "Phonecall_EmailNotSent";
			Voice_Play(sSubject,-1,"PhonecallOver",0);
		}
		else if (action==eCellPhoneGuiAction_MissedCall)
		{
			mbIgnoredPhone = true;
			SequenceStates_Resume("Seq_PhoneCall");
			Map_AddTimer("TimerEndLevel", 7.5, "TimerEndLevel");
			Map_SetPreloadPriority(eWorldStreamPriority_Normal);
		}
		
		if(ImGui_TimerOver("PutAwayPhone"))
		{
			ImGui_Exit();
			SequenceStates_Resume("Seq_PhoneCall");
		}
	}
	
	//-------------------------------------------------------
	
	void Timer_ConversationAudio(const tString &in asTimer)
	{
		if (asTimer=="FadeVolume")
		{
			Sound_FadeGlobalVolume(0.75f, 4.0f, eSoundEntryType_World);
			Music_FadeVolumeMul(0.85f, 6.0f);
			cLux_AddDebugMessage("Fade audio down");
		}
		else if(asTimer=="ResumeVolume")
		{
			Sound_FadeGlobalVolume(1.f, 3.0f, eSoundEntryType_World);
			Music_FadeVolumeMul(0.45f, 3.0f);
			cLux_AddDebugMessage("Fade audio back up");
		}
	}
	
	void LeaveGui_Phone(const tString&in asEntityName)
	{
		if (mbIgnoredPhone || mbAnsweredPhone || mbHungUpPhone)
			return;
		
		mbHungUpPhone = true;
		Sound_Stop("CellphoneRing", 0.1);
		Sound_Stop("CellphoneRingTone", 0.1);
		SequenceStates_Resume("Seq_PhoneCall");
		Map_AddTimer("TimerEndLevel", 18, "TimerEndLevel");
		Map_SetPreloadPriority(eWorldStreamPriority_Normal);
	}
	
	//-------------------------------------------------------
	//Bum player
	
	int mlBumStage = 1;
	bool mbBumLineAllowed = true;
	bool mbBumRamblingActive = false;
	
	void BumLine(const tString &in asTimer)
	{
		if(mbBumLineAllowed==true && Sound_Exists("BumLine")==false && mlBumStage < 12)
		{
			Sound_CreateAtEntity("BumLine", "00_01_subway/ambience/spot/bum_rambling_"+mlBumStage, "Subway_bum_1");
			mlBumStage++;
			Map_AddTimer("BumPlayer", cMath_RandRectf(3.0f, 5.0f), "BumLine");
		}
		else
		{
			Map_AddTimer("BumPlayer", cMath_RandRectf(3.0f, 5.0f), "BumLine");
		}
	}
		
	//-------------------------------------------------------
	//Stop bum from talking during conversation
	
	void LineStart_Conversation(const tString &in asParent, const tString &in asChild, int alState, bool abStart)
	{
		if(abStart==false)
			return;
			
		mbBumLineAllowed = false;
	}
	
	void LineOver_Conversation(const tString &in asParent, const tString &in asChild, int alState, bool abStart)
	{
		if(abStart)
			return;
			
		mbBumLineAllowed = true;
	}
	
