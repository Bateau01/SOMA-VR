	void Audio_StartLeviathanChaseTunnel()
	{
		Sound_CreateAtEntity("LeviathanTunnelLoop", "04_03_tau_escape/SFX/leviathan_chase/tunnel_loop", "Player", 1.5f, false, 1.0f);
		Sound_FadeGlobalVolume(0.35f, 1.0f, eSoundEntryType_WorldAll);
