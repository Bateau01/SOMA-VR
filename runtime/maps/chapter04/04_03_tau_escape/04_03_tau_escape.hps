	//----------------------------------------------------
	
	bool mbHeartRoomQuakeActive = false;
	void StartHeartRoomQuake()
	{
		if(mbHeartRoomQuakeActive==false)
		{
			mbHeartRoomQuakeActive = true;
			Sound_CreateAtEntity("QuakeStartSweet", "04_03_tau_escape/SFX/wau_heart/quake/quake_start_Sweet", "Player");
			Sound_FadeGlobalVolume(0.35f, 0.25f, eSoundEntryType_WorldClean);
			Map_AddTimer("QuakeStartTimer", 2.0f, "Timer_StartQuakeAudio");
		}
	}
	
	void Timer_StartQuakeAudio(const tString &in asTimer)
	{
		Sound_CreateAtEntity("QuakeLoop", "04_03_tau_escape/SFX/wau_heart/quake/quake_loop", "Player", 2.0f, false, 1.0f);
	}
	
	
	void StopHeartRoomQuake(float afFadeTime=2.0f, bool abFadeBackUp=false)
	{
		if(mbHeartRoomQuakeActive==true)
		{
			mbHeartRoomQuakeActive = false;
			Map_RemoveTimer("QuakeStartTimer");
			Sound_Stop("QuakeLoop", afFadeTime);
			
			if(abFadeBackUp==true)
			{
				Sound_FadeGlobalVolume(1.0f, afFadeTime*2, eSoundEntryType_WorldClean);
			}
			
			if(Sound_Exists("QuakeStartSweet"))
			{
				Sound_Stop("QuakeStartSweet", 2.0f);
			}
		}
	}
				
