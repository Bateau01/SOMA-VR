		cSequenceStatesData mSeqRossNearAlpha;
		void Seq_RossNearAlpha(const tString &in asX)
		{
			Sequence_Begin("Seq_RossNearAlpha", mSeqRossNearAlpha);
			
			if (Sequence_DoStepAndWait(0.5))
			{
				Effect_TimeGlitch_Start(0.5, 1, 0.1, false);
				Player_FadeMoveSpeedMulTo(0.65, 1);
				Effect_VideoDistortion_Start(0.45f, 0.2f, 0.1f, 0.25f);
				
				Entity_SetActive("StopCanyonAmb", false);
				Entity_SetActive("StartCanyonAmb", false);
				
				if (Map_TimerExists("CanyonSweetener"))
				{
					Map_SetTimerPaused("CanyonSweetener", true);
				}
				
				Audio_RossAppear(true, 0.65f, false);
			}
			if (Sequence_DoStepAndWait(4.1))
			{
				Entity_SetActive("RossOutsideAlpha", true);
				BarkMachine_SetActive("RossOutsideAlpha", false);
				Voice_Play("2_RossBanter_1");
				Effect_VideoDistortion_Start(0.45f, 3.0f, 0.1f, 0.015f);
			}
			if (Sequence_DoStepAndWait(2.1))
			{
				Entity_SetActive("RossOutsideAlpha", false);
				Effect_TimeGlitch_Start(0.5, 1, 0.1, false);
				Effect_Shake_Start(0.2, 1.0f, 0.1, 0.1);
				Effect_VideoDistortion_Start(1.0f, 1.0f, 0.1f, 0.1f);
				
				Player_FadeMoveSpeedMulTo(1, 1);
				
				if (Map_TimerExists("CanyonSweetener"))
				{
					Map_SetTimerPaused("CanyonSweetener", false);
				}
			}

			Sequence_End();
		}
		
