		//-------------------------------------------------------
		
		void PhiDoorPanelChangeState(const tString &in asEntity, int alState)
		{
			if(alState == 1)
			{
				SequenceOpenPhiDoor("");
			}
		}

		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceOpenPhiDoor;
		void SequenceOpenPhiDoor(const tString& in asName)
		{
			Sequence_Begin("SequenceOpenPhiDoor", mSequenceOpenPhiDoor);
			
			if (Sequence_DoStepAndWait(1.0f))
			{
				cLux_AddDebugMessage("Opening door.");
			}
			else if (Sequence_DoStepAndWait(0.25f))
			{
				Entity_SetActive("PhiForceArea", true);
				
				Lever_SetAutoMoveEnabled("PhiDoor", true);
				Lever_SetAutoMoveTarget("PhiDoor", 1);
				Sound_CreateAtEntity("PhiDoorOpening", "Entities_OceanBottom/doors/tau_door/open", "PhiDoor");
			}
			else if (Sequence_DoStepAndWait(6.0f))
			{
				ParticleSystem_CreateAtEntity("TauBubbles_1PS", "oneshot_waterbubbles_huge.ps", "PhiBubbles_1", true);
				ParticleSystem_CreateAtEntity("TauBubbles_2PS", "oneshot_waterbubbles_big.ps", "PhiBubbles_2", true);
				ParticleSystem_CreateAtEntity("TauBubbles_3PS", "oneshot_waterbubbles_big.ps", "PhiBubbles_3", true);
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				Entity_SetActive("PhiForceArea",false);
				Map_RemoveTimer("TimerPhiForce");
			}
		}
		
		//-------------------------------------------------------
		
