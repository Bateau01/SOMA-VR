	{
		Music_PlayExt("NPC_generic_darkencounter5", true, 0.85f*cMath_RandRectf(0.55f, 0.95f), 1.0f, cMath_RandRectf(3.f,12.f), 0.0f, eMusicPrio_MinorEvent, true);
		Map_AddTimer("FadeLeviathanAmbienceMusic", cMath_RandRectf(30.0, 40.0f), "FadeLeviathanAmbienceMusic");
	}
	
	void StopLeviathanAmbienceMusic(float afFadeTime=6.0f)
