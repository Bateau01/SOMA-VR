		bool OnCollidePhiForceArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==1)
				Map_AddTimer("TimerPhiForce",0.1f,"TimerPhiForce");
			else
				Map_RemoveTimer("TimerPhiForce");
			return true;
