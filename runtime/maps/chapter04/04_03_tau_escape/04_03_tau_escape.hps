		Music_PlayExt("NPC_creature_attack_brutal", true, 0.45, 1.0f, 2.0f, 0.0f, eMusicPrio_SceneAmb, false);
	}
	
	void Audio_StopLeviathanChaseTunnel()
	{
		Sound_Stop("LeviathanTunnelLoop", 6.0f);
		Sound_FadeGlobalVolume(1.0f, 1.f, eSoundEntryType_WorldAll);
	}
		
