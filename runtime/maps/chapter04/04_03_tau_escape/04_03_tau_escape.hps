	void CanyonSweetenerStart()
	{
		Map_AddTimer("CanyonDistantSweetener", cMath_RandRectf(6.0f, 8.0f), "CanyonDistantSweetener"); 
	}
	
	void CanyonDistantSweetener(const tString &in asTimer)
	{
		Map_AddTimer("CanyonDistantSweetener", cMath_RandRectf(12.0f, 15.0f), "CanyonDistantSweetener");
		
		if(Sound_Exists("CanyonSweetener")==false)
		{
			Sound_CreateAtEntity("CanyonSweetener", "04_03_tau_escape/SFX/canyon_movement/canyon_movement_wau", "Player");
			Sound_FadeGlobalVolume(0.75f, 3.0f, eSoundEntryType_WorldClean);
			Effect_Shake_Start(0.0075f, 3.5f, 1.0f, 3.0f);
			Map_AddTimer("FadeUpCanyonSweetener", 6.0f, "FadeUpCanyonSweetener");
			Map_AddTimer("CanyonBreathing", 2.0f, "CanyonBreathing");
		}
	}
	
	void CanyonBreathing(const tString &in asTimer)
	{
		Depth_Audio_Fear_LowIntensity();
	}
	
	void FadeUpCanyonSweetener(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 9.0f, eSoundEntryType_WorldClean);
	}
	
	void CanyonSweetenerStop()
	{
		Map_RemoveTimer("CanyonDistantSweetener");
	}
	
	bool CanyonSweetenerTrigger(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			CanyonSweetenerStart();
		}
		else
		{
			CanyonSweetenerStop();
		}
		return true;
	}
	
	
	
