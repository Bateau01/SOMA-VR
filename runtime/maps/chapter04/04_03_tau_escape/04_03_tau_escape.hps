	/////////////////////////////////////////
	// ==============
	// MAIN FUNCTIONS
	// ==============
	//{//////////////////////////////////////

	//-------------------------------------------------------

	/*Put any variables that are used in more than one scene here.*/

	//-------------------------------------------------------

	void TimerActivateTerminal(const tString& in asName)
	{
		Terminal_SetGuiActive(asName, true);
	}
	
	//-------------------------------------------------------

	void Update(float afTimeStep)
	{
		HPL3VR_UpdateAlphaTouch(afTimeStep);
		//UpdateWauPullArea(afTimeStep);
		
		UpdateWAUGaze();
	}

	//-------------------------------------------------------
	
	//} END MAIN FUNCTIONS

	/////////////////////////////////////////
	// ==============
	// SCENE 1 *TRAVEL TOWARDS TAU*
	// ==============
	//{//////////////////////////////////////

	//-------------------------------------------------------
	
		/////////////////////////////////////////
		// Scene 1 Basics
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		void TimerSetupTravelTowardsTau(const tString &in asTimer)
		{
			SetupTravelTowardsTau();
		}
		
		//-------------------------------------------------------
		bool mbSmokerSoundPlaying = false;
		void SetupTravelTowardsTau()
		{
			// Setup barrier pieces
			Prop_SetStaticPhysics("Barrier_*",true);
			
			// Open airlock door
			SlideDoor_SetOpenAmount("slidedoor_airlock_1",1.0f,false);
			
			StartTunnelProgressLights();
			
			Map_AddTimer("BeginArkMove", 2.0f, "BeginArkMove");
			
			///////////////////
			// Set up smokers
			for(int i=1;i<=6;i++)
			{
				ParticleSystem_CreateAtEntity("BlackSmoker_Normal_"+i, "04_03_black_smoker_continuous.ps", "BlackSmokerLeak_"+i, false);
				if (mbSmokerSoundPlaying==false)
				{
					Sound_CreateAtEntity("BlackSmoker_Normal_"+i, "04_03_tau_escape/AMB/spot/smokers", "BlackSmokerLeak_"+i);
					mbSmokerSoundPlaying = true;
				}
				
			}
			
			for(int i=1;i<=3;i++)
			{
				ParticleSystem_CreateAtEntity("BlackSmokerBlocker_"+i, "04_03_black_smoker_continuous.ps", "BlackSmokerBlocker_"+i, false);
				Sound_CreateAtEntity("BlackSmokerBlocker_"+i, "04_03_tau_escape/AMB/spot/smokers", "BlackSmokerBlocker_"+i);
			}
			
			/////////////////
			// Particles for airlock
			ParticleSystem_CreateAtEntity("DoorMoveParticles1", "loop_waterdust_medium.ps", "DoorPSMove_1", true);
			
			Entity_StopAnimation("AirlockInnerDoor");
		}
				
		//-------------------------------------------------------
		
		void BeginArkMove(const tString &in asTimer)
		{
			ArkMoveFromAirlock();
		}
				
		//-------------------------------------------------------
		
		bool OnTriggerArkOutOfAirlock(const tString &in asParent, const tString &in asChild, int alState)
		{
			BeginAmbientMusic((cMath_RandRectf(3.0, 6.0f)), 1);
			return false;
		}
		
		//-------------------------------------------------------
		
		//} END Scene 1 Basics
		
		/////////////////////////////////////////
		// Scene 1 Event Wake Up
		//{//////////////////////////////////////

		//-------------------------------------------------------
				
		cSequenceStatesData mSeqWakeUp;
		void Seq_WakeUp(const tString &in asX)
		{
			Sequence_Begin("Seq_WakeUp", mSeqWakeUp);
			 
			if (Sequence_DoStepAndWait(0.25))
			{
				Effect_Fade_Out(0);
				Map_SetUnderwater(true);
				
				Sound_SetGlobalVolume(0.0f, eSoundEntryType_WorldAll);
				Sound_SetGlobalVolume(0.0f, eSoundEntryType_GuiWorld);
			}
			else if (Sequence_DoStepAndWait(6.0))
			{
				Sound_CreateAtEntity("WakeUp", "04_03_tau_escape/SFX/wake_up_sweet", "Player");
			}
			else if (Sequence_DoStepAndWait(5))
			{
				Effect_Fade_In(5);
				
				Sound_FadeGlobalVolume(1.0f, 6.0f, eSoundEntryType_WorldAll);
				Sound_FadeGlobalVolume(1.0f, 6.0f, eSoundEntryType_GuiWorld);
				
				Emotion_StartBackgroundBreath(eBreathType_Normal, 06,1, 6,3, 5);
				
				Effect_ImageTrail_Start(0.5, 0.1f, 6, 2);
				CameraAnimation_Begin("WakeupAnim", "", true);
			}
			else if (Sequence_DoStepAndWait(5))
			{
				Map_AddTimer("SetupTravelTowardsTau", 0.3, "TimerSetupTravelTowardsTau");
			}
			
			Sequence_End();
		}

		
		//-------------------------------------------------------
		
		//} END Scene 1 Basics

		/////////////////////////////////////////
		// Scene 1 Event A *Case Transporter Moves*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		void StartTunnelProgressLights()
		{
			Lamp_SetLit("LampArkProgress_*", false, false);
			Map_AddTimer("TimerCheckTunnelProgressLights", 0.25f, "TimerCheckTunnelProgressLights");
		}
		
		//-------------------------------------------------------
		
		void TimerCheckTunnelProgressLights(const tString&in asTimer)
		{
			tString sLamp;
			bool bLampLit = false;
			cVector3f vArkPos = Map_GetEntity("ARK_4_2").GetPosition();
			for (int i = 4; Entity_Exists("LampArkProgress_"+i);i++)
			{
				sLamp = "LampArkProgress_"+i;
				cVector3f vPos = Map_GetEntity(sLamp).GetPosition();
				if (cMath_Abs(vPos.z-vArkPos.z)<3.0f)
				{
					bLampLit = true;
					Lamp_SetLit(sLamp,true,true);
				}
				else
				{
					Lamp_SetLit(sLamp,false,true);
				}
			}
				
			if (bLampLit)
				Map_AddTimer("TimerCheckTunnelProgressLights", 0.25f, "TimerCheckTunnelProgressLights");
		}

		//-------------------------------------------------------
		
		int mlArkMoveCount=0;
		
		void ArkMoveFromAirlock()
		{
			cLux_AddDebugMessage("Ark begins to move");
			Entity_SetCollide("ArkHolder_4_2", false);
			Entity_AttachToEntity("ArkHolder_4_2", "ARK_4_2", "", true);
			Prop_MoveLinearTo("ARK_4_2", "ArkTarget_1", 0.1f, 0.5f, 0, true, "OnArkReachedPoint");
			Sound_CreateAtEntity("ArkRails", "04_03_tau_escape/SFX/ark/on_rails", "ArkHolder_4_2");
			Map_AddTimer("ArkLoopSound", 16.0, "ArkLoopSoundStart");
		}
		
		void ArkLoopSoundStart(const tString &in asTimer)
		{
			Sound_CreateAtEntity("ArkRailsLoop", "04_03_tau_escape/SFX/ark/motor_loop", "ArkHolder_4_2", 1.0f, false, 1.0f);
			Sound_CreateAtEntity("ArkRailsLoopSweet", "04_03_tau_escape/SFX/ark/rail_ping", "ArkHolder_4_2", 1.0f, false, 1.0f);
		}
		
		bool Collide_ArkStopSound(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_Stop("ArkRailsLoop", 3.0f);
			Sound_Stop("ArkRailsLoopSweet", 3.0f);
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnArkReachedPoint(const tString& in asEntity)
		{
			SequenceStates_Resume("Seq_ArkMoveFromAirlock");
			
			mlArkMoveCount++;
			int lArkMoveCountTestNum=1;
			
			if (mlArkMoveCount==lArkMoveCountTestNum++)
			{
				Prop_MoveLinearTo("ARK_4_2", "ArkTarget_2", 1.0f, 0.75f, 0, false, "OnArkReachedPoint");
			}
			else if (mlArkMoveCount==lArkMoveCountTestNum++)
			{
				Prop_MoveLinearTo("ARK_4_2", "ArkTarget_2_1", 1.0f, 0.95f, 0, false, "OnArkReachedPoint");
			}
			else if (mlArkMoveCount==lArkMoveCountTestNum++)
			{
				Prop_MoveLinearTo("ARK_4_2", "ArkTarget_2_2", 1.0f, 1.15f, 0, false, "OnArkReachedPoint");
			}
			else if (mlArkMoveCount==lArkMoveCountTestNum++)
			{
				Prop_MoveLinearTo("ARK_4_2", "ArkTarget_2_3", 1.0f, 1.55f, 0, false, "OnArkReachedPoint");
			}
			else if (mlArkMoveCount==lArkMoveCountTestNum++)
			{
				Prop_MoveLinearTo("ARK_4_2", "ArkTarget_2_4", 1.0f, 2.15f, 0, false, "OnArkReachedPoint");
			}
			else if (mlArkMoveCount==lArkMoveCountTestNum++)
			{
				Prop_MoveLinearTo("ARK_4_2", "ArkTarget_2_5", 1.0f, 2.75f, 0, false, "OnArkReachedPoint");
			}
			else if (mlArkMoveCount==lArkMoveCountTestNum++)
			{
				Prop_MoveLinearTo("ARK_4_2", "ArkTarget_2_6", 1.0f, 3.15f, 0, false, "OnArkReachedPoint");
			}
			else if (mlArkMoveCount==lArkMoveCountTestNum++)
			{
				Prop_MoveLinearTo("ARK_4_2", "ArkTarget_2_7", 1.0f, 3.75f, 0, false, "OnArkReachedPoint");
			}
			else if (mlArkMoveCount==lArkMoveCountTestNum++)
			{
				Prop_MoveLinearTo("ARK_4_2", "ArkTarget_3", 1.0f,3.95f, 0, false, "OnArkReachedPoint");
			}
			else if (mlArkMoveCount==lArkMoveCountTestNum++)
			{
				Prop_MoveLinearTo("ARK_4_2", "ArkTarget_4", 1.0f,4.5f, 0, false, "OnArkReachedPoint");
			}
			else if (mlArkMoveCount==lArkMoveCountTestNum++)
			{
				Prop_MoveLinearTo("ARK_4_2", "ArkTarget_5", 1.0f,4.5f, 0, false, "OnArkReachedPoint");
			}
			else if (mlArkMoveCount==lArkMoveCountTestNum++)
			{
				Prop_MoveLinearTo("ARK_4_2", "ArkTarget_6", 1.0f,4.5f, 0, false, "OnArkReachedPoint");
			}
			else if (mlArkMoveCount==lArkMoveCountTestNum++)
			{
				Prop_MoveLinearTo("ARK_4_2", "ArkTarget_7", 1.0f,4.5f, 0, false, "OnArkReachedPoint");
			}
		}
		
		//-------------------------------------------------------
		
		//} END Scene 1 Event A
	
	//} END SCENE 1
	
	/////////////////////////////////////////
	// ==============
	// SCENE 2 *JOURNEY TO FINAL ROOM*
	// ==============
	//{//////////////////////////////////////

	//-------------------------------------------------------
	
		/////////////////////////////////////////
		// Event *Ross Talks*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlRossTalksDistortion;
	
		bool RossTalks(const tString &in asCharacter, bool abStartedTalking)
		{
			if(abStartedTalking)
			{
				mlRossTalksDistortion = Effect_VideoDistortion_Start(0.35, -1, 0.5, 0.75, 0.5f);
			}
			else
			{
				Effect_VideoDistortion_FadeOut(mlRossTalksDistortion, 0.75f);
			}
			
						
			return true;	
		}
		
		//-------------------------------------------------------
	
		//} END Event *Ross Talks*
		
		//-------------------------------------------------------
		
		/////////////////////////////////////////
		// Event *Find corpse*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool OnCheckRubbleOverCaveInCorpse(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("CaveInDatamineArea", alState == -1);
			
			return true;
		}	
		//-------------------------------------------------------
		
		//} END *Find corpse*

		/////////////////////////////////////////
		// Event *Trembles*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		int mlTrembleCount=0;
		//-------------------------------------------------------
		
		bool CollideTremble(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (asChild=="TriggerTrembles_1")
			{
				Sound_CreateAtEntity("Tremor01", "04_03_tau_escape/SFX/wau_tunnel_tremor/tremor_01", "Player");
				Sound_FadeGlobalVolume(0.65f, 3.0f, eSoundEntryType_WorldClean);
				Music_FadeVolumeMul(0.65f, 3.0f);
				Map_AddTimer("FadeUpFromTremor", 5.0f, "FadeUpFromTremor");
				Map_AddTimer("ShakeDelayTremor", 0.75f, "ShakeDelayTremor");
			}
			
			else if(asChild=="TriggerTrembles_2")
			{
				Sound_CreateAtEntity("Tremor02", "04_03_tau_escape/SFX/wau_tunnel_tremor/tremor_02", "Player");
				Emotion_StartBackgroundBreath(eBreathType_Normal, 0.6f, 3, 8, 0, 3);
				Sound_FadeGlobalVolume(0.65f, 3.0f, eSoundEntryType_WorldClean);
				Music_FadeVolumeMul(0.65f, 3.0f);
				Map_AddTimer("FadeUpFromTremor", 4.0f, "FadeUpFromTremor");
				Map_AddTimer("ShakeDelayTremor", 0.75f, "ShakeDelayTremor");
			}
			cLux_AddDebugMessage("Tremble triggered at "+asChild);
			
			return false;
		}
		
		void FadeUpFromTremor(const tString &in asTimer)
		{
			Sound_FadeGlobalVolume(1.0f, 6.0f, eSoundEntryType_WorldClean);
			Music_FadeVolumeMul(1.0f, 6.0f);
		}
		
		void ShakeDelayTremor(const tString &in asTimer)
		{
			if(mlTrembleCount==0)
			{
				Effect_Shake_Start(0.017+mlTrembleCount, 1, 0.25, 4);
				Map_AddTimer("Tremor1ShakePart2", 4.25f, "Tremor1ShakePart2");
				Depth_Audio_Fear_MediumIntensity();
			}
			
			if(mlTrembleCount==1)
			{
				Effect_Shake_Start(0.01+mlTrembleCount*0.04f, 1, 2, 4);
			}
			
			mlTrembleCount++;
		}
		
		void Tremor1ShakePart2(const tString &in asTimer)
		{
			Effect_Shake_Start(0.003+mlTrembleCount*0.02, 1, 0.25, 4);
		}
				
		//-------------------------------------------------------
		
		//} END Event *Trembles*
		
		/////////////////////////////////////////
		// Event *Ross shows tunnel entrance*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool Collide_TriggerReachedEndOfTunnel(const tString&in asParent, const tString&in asChild, int alState)
		{
			Entity_SetActive("entrance_block_open_*", true);
			Entity_SetActive("entrance_block_closed_*", false);
			
			Light_SetBrightness("pointlight_tunnel_open_*", 1);
			
			Entity_SetActive("TriggerRossShowsEntrance", true);
			return false;
		}
		
		bool Collide_TriggerRossShowsEntrance(const tString&in asParent, const tString&in asChild, int alState)
		{
			Seq_RossAppears("");
			
			return false;
		}
				
		//-------------------------------------------------------
		
		void BarrierMove(const tString &in asEntity)
		{
			//Move debris out of the way
			Sound_CreateAtEntity("BarrierMove_"+asEntity, "04_03_tau_escape/SFX/barrier_move", "Player");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqRossAppears;
		void Seq_RossAppears(const tString &in asX)
		{
			Sequence_Begin("Seq_RossAppears", mSeqRossAppears);
			
			if (Sequence_DoStepAndWait(0.1))
			{
				Effect_TimeGlitch_Start(0.5, 1, 0.1, false);
				Player_FadeMoveSpeedMulTo(0.65, 1);
				Audio_RossAppear();
				
				Entity_SetActive("TunnelMusicStop", false);
				Map_AddTimer("StopAmbientMusicQuickly", 0.5f, "AmbientMusicHandler");
			}
			if (Sequence_DoStepAndWait(3.1))
			{
				Entity_SetActive("RossAtEntrance", true);
				BarkMachine_SetActive("RossAtEntrance", false);
				Voice_Play("2_FlesherAppears");
				Effect_VideoDistortion_Start(0.45f, 3.0f, 0.1f, 0.5f);
			}
			if (Sequence_DoStepAndWait(2.1))
			{
				Entity_SetActive("RossAtEntrance", false);
				Effect_TimeGlitch_Start(0.5, 1, 0.1, false);
				Effect_Shake_Start(0.2, 1.0f, 0.1, 0.1);
				Effect_VideoDistortion_Start(1.0f, 1.0f, 0.1f, 0.1f);
				
				Player_FadeMoveSpeedMulTo(1, 1);
			}
			Sequence_End();
		}
				
