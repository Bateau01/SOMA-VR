		//-------------------------------------------------------
		
		int mlWAUGazeHeartbeat = -1;
		bool mbWAUGazeHeartbeatActive = false;
		bool mbCanTriggerWAUHeartbeat = true;
		
		void UpdateWAUGaze()
		{
			float fDist = (Map_GetEntity("interactAux_heart").GetPosition() - Player_GetPosition()).Length();
			if (EyeTracking_IsEnvironmentReactive() == true &&
				mbCanTriggerWAUHeartbeat == true &&
				mbWAUGazeHeartbeatActive == false &&
				EyeTracking_IsEntityBeingLookedAt("interactAux_heart") &&
				fDist <= 5.0f)
			{
				mbWAUGazeHeartbeatActive = true;
				
				mlWAUGazeHeartbeat = Emotion_StartHeartbeat(1, 0.8, 1, -1, 1, 1);
				Player_FadeFOVMulTo(0.8f, 0.8f);
				cScript_SetGlobalArgFloat(0, 0.2f);
				cScript_RunGlobalFunc("DistortArea_1", "cScrAreaDistortion", "_Global_SetAddedDistortionAmount");
			}
			
			if ((mbCanTriggerWAUHeartbeat == true && mbWAUGazeHeartbeatActive == true && EyeTracking_IsEntityBeingLookedAt("interactAux_heart") == false) ||
				(mbCanTriggerWAUHeartbeat == false && mlWAUGazeHeartbeat >= 0) ||
				mbWAUGazeHeartbeatActive == true && fDist > 5.0f ||
				mbWAUGazeHeartbeatActive == true && EyeTracking_IsEnvironmentReactive() == false)
			{
				mbWAUGazeHeartbeatActive = false;
				mlWAUGazeHeartbeat = -1;
				
				Emotion_StopHeartbeat(mlWAUGazeHeartbeat);
				Player_FadeFOVMulTo(1.0f, 1.5f);
				cScript_SetGlobalArgFloat(0, 0.0f);
				cScript_RunGlobalFunc("DistortArea_1", "cScrAreaDistortion", "_Global_SetAddedDistortionAmount");
			}
		}
		
		//-------------------------------------------------------
		
		//} END Event Enter Wau room
		
		/////////////////////////////////////////
		// * Event: Put Hand in Wau */
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlPutHandInHeatbeatId;
		
		//-------------------------------------------------------
		

	[nosave] float mfVRAlphaPoll = 0;
	[nosave] bool mbVRAlphaAuthorized = false;
	bool mbVRAlphaStarted = false;
	bool HPL3VR_AlphaEligible()
	{
		iLuxEntity@ pMouth = Map_GetEntity("04_03_wau_monster_mouth_1");
		return !mbVRAlphaStarted && !mbPlayerLostHand && pMouth !is null && pMouth.IsActive() &&
			!pMouth.GetInteractionDisabled() && cLux_GetPlayer().IsActive();
	}
	void HPL3VR_UpdateAlphaTouch(float afTimeStep)
    {
        mfVRAlphaPoll-=afTimeStep;
        if(mfVRAlphaPoll>0) return;
        mfVRAlphaPoll=0.05f; // S26CX: match flower contact polling.
        if(!_HPL3VR_AlphaActive() || !HPL3VR_AlphaEligible()) return;
        iLuxEntity@ entity=Map_GetEntity("04_03_wau_monster_mouth_1");
        if(entity is null) return;
        cLuxProp@ mouth=cLux_ID_Prop(entity.GetID());
        if(mouth is null || mouth.GetMeshEntity() is null) return;
        if((mouth.GetPosition()-cLux_GetPlayer().GetCamera().GetPosition()).Length()>3.0f) return;
        cMeshEntity@ mesh=mouth.GetMeshEntity();
        cBoneState@ root=mesh.GetBoneStateFromName("j_maw_root");
        if(root is null) return;
        cVector3f rim(0);
        for(int i=1;i<=8;i++)
        {
            cBoneState@ lip=mesh.GetBoneStateFromName("j_lip_"+i+"_end");
            if(lip is null) return;
            rim+=lip.GetWorldPosition();
        }
        rim*=0.125f;
        cVector3f axis=rim-root.GetWorldPosition();
        float length=axis.Length();if(length<0.01f) return;
        axis*=1.0f/length;
        // S26DB: j_lip endpoints belong to the inner jaw. The outer fleshy
        // opening in anus_low is farther forward; keep insertion behind it.
        cVector3f target=rim+axis*0.22f;
        cScript_RunGlobalFunc("VRHEAL","Alpha","C");
        iPhysicsBody@ body=mouth.GetMainBody();
        cScript_RunGlobalFunc("VRHEAL","Alpha","D");
        if(body is null) return;
        cScript_RunGlobalFunc("VRHEAL","Alpha",""+target.x+","+target.y+","+target.z+",4,"+axis.x+","+axis.y+","+axis.z);
    }
	void HPL3VR_AlphaCommit()
	{
		if (!_HPL3VR_AlphaActive() || !HPL3VR_AlphaEligible()) return;
		mbVRAlphaAuthorized = true;
		InteractWauHeart("04_03_wau_monster_mouth_1");
		mbVRAlphaAuthorized = false;
	}

		void InteractWauHeart(const tString &in asEntity)
		{
			if (_HPL3VR_AlphaActive()) { if (!mbVRAlphaAuthorized || mbVRAlphaStarted) return; mbVRAlphaStarted = true; }
			Voice_StopAll();
			LeviathanCirclingDomeSweetStop();
			Map_RemoveTimer("RossDemandsSimonDoIt");
			
			Entity_SetInteractionDisabled(asEntity, true);
			mbCanTriggerWAUHeartbeat = false;
			
			Music_Play("04_03_simons_arm", 0.8f, false, eMusicPrio_BigEvent);
			Map_RemoveTimer("FadeUpEnterWauRoom");
			Music_Stop(2.0f, eMusicPrio_BgAmb);
			Map_RemoveTimer("WauHeartRoomAmbientMusic");
			
			if(Sound_Exists("LeviathanKillsRoss_NoHeart"))
			{
				Sound_Stop("LeviathanKillsRoss_NoHeart", 3.0f);
			}
			
			PlayerHands_SetUseCustomPosition(true);
			PlayerHands_SetCustomPositionFromEntity("04_03_wau_monster_mouth_1");
			PlayerHands_SetUseCustomRotation(true);
			PlayerHands_SetCustomRotationFromEntity("04_03_wau_monster_mouth_1");
			
			PlayerHands_PlayAnimation("player_wau_mouth_put_in", false, true, 0,"", false,1,-1);
			PlayerHands_SetAnimationOverCallback("HandAnimOver_PutIn");
			
			PlayerHands_AttachCameraToSocket("Socket_Camera", 1.0f, "CameraAttachFadeDone", false,false,1.0f, 
											cVector3f(0,0,0.1f), 0);
			Player_SetActive(false);
			
			Sound_FadeGlobalVolume(0.35f, 3.0f, eSoundEntryType_WorldClean);
			
			mlPutHandInHeatbeatId = Emotion_StartHeartbeat(1, 0.6, 1);
			
			Map_AddTimer("IncreaseHeartRate", 5, "Timer_IncreaseHeartRate");
			
			Map_AddTimer("FirstRumble", 9.5f, "Timer_FirstRumble");
			
			EyeTracking_SetExtendedViewMul(0.15f);
		}
		
		void CameraAttachFadeDone()
		{
			Entity_PlayAnimation("04_03_wau_monster_mouth_1", "event_wau_mouth_put_in", 0.1f, false);
			
			cLux_AddDebugMessage("Animation Start");
			
			Map_AddTimer("HandInVO", 8.75f, "HandInVO");
		}
		
