		void OnGuiMainTerminal(const tString&in asEntityName, float afTimeStep)
		{
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();
			
			///////////
			// Translation setup
			ImGui_SetTransCategory("04_03_tau_escape");
			
			///////////
			// Data
			cImGuiLabelData label = ImGui_GetDefaultLabel();
			label.mFontAlign = eFontAlign_Left;
			ImGui_SetDefaultLabel(label);
			
			///////////
			// Select Current App
			bool bDrawBackButton = true;
			int lBackApp = eMainComputerTerminalState_MainMenu;
			int lActiveApp = StationGui_GetActiveApp(eMainComputerTerminalState_MainMenu);
			switch(lActiveApp)
			{
			case eMainComputerTerminalState_MainMenu:
				StationGui_AddApp("Status");
				StationGui_AddApp("LogFiles");
				StationGui_AddApp("AccessControl");
				StationGui_MainMenu();
				bDrawBackButton=false;
				break;
				
			case eMainComputerTerminalState_Status:
				OnGuiStatusApp();
				break;
				
			case eMainComputerTerminalState_Logs:
				OnGuiLogsApp();
				break;
				
			case eMainComputerTerminalState_Access:
				bDrawBackButton = OnGuiAccessApp();
				break;
			}
			
			////////////////////////////
			// Back
			ImGui_SetModUISizeHoriExpansion(0, 4);
			if (bDrawBackButton && StationGui_BackButton(true, lBackApp))
			{
			}
			ImGui_SetModUISizeHoriExpansion(0,0);
		}
		
		//-------------------------------------------------------
		
			/////////////////////////////////////////
			// Main Computer: Status
			//{//////////////////////////////////////
			
			//-------------------------------------------------------
			
			void OnGuiStatusApp()
			{
				StationGui_TextReaderSingle("Status", "StatusFileText");
			}
			
			//-------------------------------------------------------
			
			//} END Main Computer: Info
			
			/////////////////////////////////////////
			// Main Computer: Log
			//{//////////////////////////////////////
			
			//-------------------------------------------------------
			
			int mlLogsCurrentImage=1;
			bool mbLogsFirstVisit=true;
			
			void OnGuiLogsApp()
			{
				const int lMaxImages=5;
				
				/////////////////////
				// Voice
				if(mbLogsFirstVisit)
				{
					mbLogsFirstVisit=false;
				}
				
				/////////////////////
				// Data
				cImGuiButtonData buttonData = StationGui_CreateDefaultButtonData();
				buttonData.mbUseTriggeredAndInFocusColor = true;
				buttonData.mColorTriggeredAndInFocus = cColor(0.9, 0.6, 0.1);
				ImGui_SetDefaultButton(buttonData);
						
				cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
				windowData.mColorBase = cColor(0.07f, 0.41f, 0.72f, 1) * (0.4);
				windowData.mColorText = cColor(0.3, 1);
				
				cImGuiLabelData labelData;
				labelData.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
				labelData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.07);
				
				cImGuiTextFrameData textFrame = ImGui_GetDefaultTextFrame();
				textFrame.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
				textFrame.mFontAlign = eFontAlign_Left;
				textFrame.mbUseBackgroundGfx = false;
				textFrame.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.033);
				
				cImGuiGfx gfxImage = cImGuiGfx("oceanbottom/wauheart/wauheart0"+mlLogsCurrentImage, eImGuiGfx_Texture);
				
				/////////////////////
				// Image Picker
				StationGui_DoWindowStart("Images", windowData, ImGui_NrmPos(cVector3f(0.05, 0.05, 2)), ImGui_NrmSize(cVector2f(0.9, 0.9)), false);
					
					/////////////////////
					// Image		
					ImGui_SetAlignment(eImGuiAlign_TopCenter);
					cVector2f vImgSize = ImGui_GetRatioCorrectSizeByNrmHeight(gfxImage, 0.67);
					ImGui_DoImage(gfxImage, ImGui_NrmPos(cVector3f(0.5, 0.05, 2)), vImgSize);
					
					/////////////////////
					// Header
					ImGui_DoLabelExt("LogFileName_"+mlLogsCurrentImage, labelData,
										ImGui_NrmPos(0.5f, 0.005f, 2), -1, 0.65);					

					/////////////////////
					// Text
					ImGui_SetAlignment(eImGuiAlign_TopLeft);
					ImGui_DoTextFrameExt("LogFileText_"+mlLogsCurrentImage,
										0, 0, 0,textFrame, ImGui_NrmPos(0.0f, 0.45, 2), ImGui_NrmSize(0.93, 0.58));
										
					
					
					/////////////////////
					// Left Button
					ImGui_SetModUseInput(mlLogsCurrentImage!=1);					
					ImGui_SetAlignment(eImGuiAlign_BottomLeft);
					if(ImGui_DoButton("Logs_Left", "Previous", ImGui_NrmPos(0.2, 0.9, 2), ImGui_NrmSize(0.2, 0.095f)))
					{
						mlLogsCurrentImage--;
						if(mlLogsCurrentImage<1) mlLogsCurrentImage=lMaxImages;
					}
					
					/////////////////////
					// Right Button
					ImGui_SetModUseInput(mlLogsCurrentImage!=5);					
					ImGui_SetAlignment(eImGuiAlign_BottomRight);
					if(ImGui_DoButton("Logs_Right", "Next", ImGui_NrmPos(0.8, 0.9, 2), ImGui_NrmSize(0.2, 0.095f)))
					{
						mlLogsCurrentImage++;
						if(mlLogsCurrentImage>lMaxImages) mlLogsCurrentImage=1;
					}
					
					ImGui_SetAlignment(eImGuiAlign_TopLeft);
					ImGui_SetModUseInput(true);					
				StationGui_DoWindowEnd();
				
			}
			
			//-------------------------------------------------------
			
			//-------------------------------------------------------
			
			//} Main Computer: Log
			
			/////////////////////////////////////////
			// Main Computer: Access Control
			//{//////////////////////////////////////
			
			//-------------------------------------------------------
			
			int mlAccessControlState=0;
			bool mbAccessControlCountDownStart =false;
			int mlAccessControlEffectSeed=0;
			float mfAccessControlEffectAmount=0.2;
			bool mbAccessControlCompleted=false;
			
			tString msAccessControlRandLetters ="ABCHz89##_:-TX==&%GHJLawktloif?/";
			
			array<float> mvAccessControlGagueVal = {0.1,0.1,0.1};
			
			//-------------------------------------------------------
			bool mbGlitchSoundPlaying = false; 
			bool OnGuiAccessApp()
			{
				///////////////////////////
				// Security Acces Required Screen
				if(mlAccessControlState<=2)
				{
					///////////////////////////
					// Basic properties
					tWString sMessage;
					if(mlAccessControlState<=1)
						sMessage = cLux_Translate("04_03_tau_escape", "AccessErrorMessage");
					else
						sMessage = cLux_Translate("04_03_tau_escape", "ManualAccessGranted");
					
					///////////////////////////
					// Start sequence
					if(mbAccessControlCountDownStart==false)
					{
						Seq_AccessControlBoot("");
						mbAccessControlCountDownStart = true;
					}
					
					///////////////////////////
					// GUI Data
					cImGuiTextFrameData textFrame = ImGui_GetDefaultTextFrame();
					textFrame.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
					textFrame.mFontAlign = eFontAlign_Center;
					textFrame.mbUseBackgroundGfx = false;
					textFrame.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.07);
					
										
					///////////////////////////
					// Effects
					cVector3f vPosOffset=0;
					if(mlAccessControlState==1)
					{
						if(	ImGui_TimerOver("ShakeRun"))
						{
							ImGui_AddTimer("ShakePause", cMath_Max(cMath_RandRectf(0.25, 1)-mfAccessControlEffectAmount, 0.01));	
						}
						
						if(	ImGui_TimerExists("ShakeRun")==false &&
							ImGui_TimerExists("ShakePause")==false)
						{
							ImGui_AddTimer("ShakeRun", cMath_RandRectf(0.15, 0.75));
							if(mbGlitchSoundPlaying==false)
							{
								Sound_CreateAtEntity("RossTerminalGlitch", "04_03_tau_escape/SFX/terminal/glitch_out", "GlitchTerminalSoundSource");
								mbGlitchSoundPlaying = true;
							}
													
						}
						
						if(ImGui_RepeatTimer("LetterSwap", cMath_RandRectf(0.01, 0.2))) mlAccessControlEffectSeed+=30;
						
						if(ImGui_TimerExists("ShakeRun"))
						{
							vPosOffset.x = cMath_RandRectf(-12, 12)*mfAccessControlEffectAmount;
							vPosOffset.y = cMath_RandRectf(-6, 6)*mfAccessControlEffectAmount;
							
							tWString sOldMessage = sMessage;
							sMessage = "";
							
							for(int i=0;i<sOldMessage.length();++i)
							{
								if(cString_SubW(sOldMessage,i,1) == tWString("\n"))
								{
									sMessage += cString_SubW(sOldMessage,i,1);
									continue;
								}
								
								int lRand = cMath_Abs(cMath_FastRandomFloat(mlAccessControlEffectSeed+i))*30;
								
								if(cMath_FastRandomFloat(mlAccessControlEffectSeed+i)>0.5-mfAccessControlEffectAmount)
									sMessage += cString_Sub(msAccessControlRandLetters,lRand,1);
								else
									sMessage += cString_SubW(sOldMessage,i,1);
							}
						}
					}		
					
					///////////////////////////
					// Draw frame
					ImGui_SetTextOverride(sMessage);
					ImGui_DoTextFrameExt("", 0,10,0,textFrame, ImGui_NrmPos(0.1f, 0.35f, 2)+vPosOffset, ImGui_NrmSize(0.8, 0.3));
					ImGui_ClearTextOverride();
					
					return false;
				}
				///////////////////////////
				// Manual Access Screen.
				else if(mlAccessControlState==3)
				{
					///////////////////////////
					// GUI Data
					cImGuiTextFrameData textFrame = ImGui_GetDefaultTextFrame();
					textFrame.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
					textFrame.mFontAlign = eFontAlign_Center;
					textFrame.mbUseBackgroundGfx = false;
					textFrame.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.06);
					
					cImGuiGaugeData gague = StationGui_CreateDefaultGaugeData();
					gague.mOrientation = eImGuiGaugeOrientation_Vert;
					
					cImGuiButtonData buttonData = StationGui_CreateDefaultButtonData();
					buttonData.mbUseTriggeredAndInFocusColor = true;
					buttonData.mColorTriggeredAndInFocus = cColor(0.9, 0.6, 0.1);
					ImGui_SetDefaultButton(buttonData);
					
					///////////////////////////
					// Gagues
					{
						ImGui_SetTransCategory("");
						
						bool bCorrect=true;
						
						for(int i=0; i<3;++i)
						{
							float fVal = mvAccessControlGagueVal[i];
							
							float fOther =0;
							
							float fFinalVal;
							float fWanted;
							
							if(i==0){
								fFinalVal = fVal + mvAccessControlGagueVal[1]*1.0 + mvAccessControlGagueVal[2]*1.5;
								fWanted = 2.1f;
							}
							if(i==1){
								fFinalVal = fVal + mvAccessControlGagueVal[0]*0.5 + mvAccessControlGagueVal[2]*2.5;
								fWanted = 2.5;
								
							}
							if(i==2){
								fFinalVal = fVal + mvAccessControlGagueVal[0]*1.5 + mvAccessControlGagueVal[1]*0.5;
								fWanted = 1.6;
							}
		
							
							float fDist = cMath_Abs(fFinalVal - fWanted);
							float fT = cMath_Easing(eEasing_CubicOut, fDist);
							
							cColor col;
							if(fDist <=0.1)
								col = ImGui_FadeOscillateColor("bar", cColor(0,1,0),cColor(0.6f,1,0.6f), 0.7f);
							else
							{
								col = cColor_Red * fT + cColor_Green *(1-fDist);
								bCorrect = false;
							}
							
							gague.mGfxFill.mColor = col;					
							ImGui_DoGauge(gague, fVal, 
											ImGui_NrmPos(0.15f+i*0.3f, 0.35f, 2), 
											ImGui_NrmSize(0.1, 0.35));
							
					
							if(mbAccessControlCompleted==false)
							{
								bool bDec = ImGui_DoButton("Dec"+i, "-", 
															ImGui_NrmPos(0.1f+i*0.3f, 0.72f, 2),
															ImGui_NrmSize(0.1, 0.1));
								bool bAdd = ImGui_DoButton("Add"+i, "+", 
															ImGui_NrmPos(0.21f+i*0.3f, 0.72f, 2),
															ImGui_NrmSize(0.1, 0.1));
													
								if(bDec) fVal = cMath_IncreaseTo(fVal, 0.1,0.1f);
								if(bAdd) fVal = cMath_IncreaseTo(fVal, 0.1,1.0f);
								
								mvAccessControlGagueVal[i] = fVal;
							}	
						}
						
						if(bCorrect && mbAccessControlCompleted==false)
						{
							mbAccessControlCompleted= true;
							SequenceStates_Resume("Seq_AccessControlBoot");
						}
						
						ImGui_SetTransCategory("04_03_tau_escape");
					}
				
					
					///////////////////////////
					// Draw frame
					ImGui_DoTextFrameExt("ManualAccess", 0,10,0,textFrame, ImGui_NrmPos(0.1f, 0.15f, 2), ImGui_NrmSize(0.8, 0.3));
					
				}
				///////////////////////////
				// Access Granted
				else if(mlAccessControlState==4)
				{
					
					///////////////////////////
					// GUI Data
					cImGuiTextFrameData textFrame = ImGui_GetDefaultTextFrame();
					textFrame.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
					textFrame.mFontAlign = eFontAlign_Center;
					textFrame.mbUseBackgroundGfx = false;
					textFrame.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.08);
					
					///////////////////////////
					// Draw frame
					ImGui_DoTextFrameExt("AccessGranted", 0,10,0,textFrame, ImGui_NrmPos(0.1f, 0.35f, 2), ImGui_NrmSize(0.8, 0.3));
				}
				
				if(mbAccessControlCompleted && mlAccessControlState==3)
					return false;
				else
					return true;
			}
			
			cSequenceStatesData mSeqAccessControlBoot;
			void Seq_AccessControlBoot(const tString &in asX)
			{
				Sequence_Begin("Seq_AccessControlBoot", mSeqAccessControlBoot);
				
				if (Sequence_DoStepAndWait(1.3f))
				{
					Entity_SetActive("TriggerRossExplainsStart", true);
				}
				else if (Sequence_DoStepAndWait(2))
				{
					Effect_VideoDistortion_Start(0.5, 7, 1, 3);
					
					mlAccessControlState=1;
					mfAccessControlEffectAmount=0.2;
				}
				else if (Sequence_DoStepAndWait(2))
				{
					mfAccessControlEffectAmount=0.6;
				}
				else if (Sequence_DoStepAndWait(1))
				{
					mfAccessControlEffectAmount=1.0;
				}
				else if (Sequence_DoStepAndWait(2.5f))
				{
					mlAccessControlState=2;
				}
				/*else if (Sequence_DoStepAndPause(0.1))
				{
					mlAccessControlState=3;
				}*/
				else if (Sequence_DoStepAndWait(1.2f))
				{
					cLux_AddTodoMessage("Sound: Manual Access Completed!");
					SlideDoor_SetClosed("tunnelentry_*", false);
					
				}
				else if (Sequence_DoStepAndWait(3))
				{
					mlAccessControlState=4;
				}
				
				Sequence_End();
			}
			
			//-------------------------------------------------------
			
			//} Main Computer: Log

		//-------------------------------------------------------
		
		//} END Main Computer terminal
		
		

	//-------------------------------------------------------
	
	//} END TERMINALS
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// AUDIO
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
	
	//{Start ambient music player-----------------------------------------------------------
	
	/**
	*Simple ambient music player that fades the ambience randomly whilst playing to stop it from getting repetitive
	**/
	int mlAmbientMusicStage = 0;
	bool mbAmbientMusicPlaying = false;
	
	//-------------------------------------------------------
	
	void BeginAmbientMusic(float afTimer=3.0f, int lAmbientStage=1, bool bStopCurrent=false)
	{
		if(bStopCurrent==true)
		{
			Map_AddTimer("StopAmbientMusicQuickly", afTimer, "AmbientMusicHandler");
			Map_AddTimer("StartAmbient", afTimer*2, "AmbientMusicHandler");
		}
		
		else if(bStopCurrent==false)
		{
			Map_AddTimer("StartAmbient", afTimer, "AmbientMusicHandler");
		}
		mlAmbientMusicStage = lAmbientStage;
		
		cLux_AddDebugMessage("Ambient music starting in "+afTimer);
		cLux_AddDebugMessage("Ambient stage picked is "+mlAmbientMusicStage);
	}
	
	//-------------------------------------------------------
	bool mbAmbientMusicAllowed = true;
	void AmbientMusicHandler(const tString &in asTimer)
	{
		if (asTimer=="StartAmbient" && mbAmbientMusicPlaying==false && mbAmbientMusicAllowed==true)
		{
			cLux_AddDebugMessage("Ambient music triggering");
			
			if(mlAmbientMusicStage==1)
			{
				//Starting Tunnel Ambience
				Music_PlayExt("04_03_startambience", true, 0.65f, 1.0f, cMath_RandRectf(3.f,5.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			
			if(mlAmbientMusicStage==2)
			{
				//Canyon Ambience
				Music_PlayExt("04_03_canyon_ambience", true, 0.45f, 1.0f, cMath_RandRectf(3.f,5.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			
			if(mlAmbientMusicStage==3)
			{
				//Lab Ambience
				Music_PlayExt("04_03_lab_ambience", true, 0.25f, 1.0f, cMath_RandRectf(5.f,10.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			
			
			Music_FadeVolumeMul(1.0f, 3.0f);
			mbAmbientMusicPlaying = true;
			
			//Dynamic fades
			Map_AddTimer("RandomFadeRider", cMath_RandRectf(20.f,40.f), "AmbientMusicFade");
			Map_AddTimer("FadeOut", cMath_RandRectf(60.f,80.f), "AmbientMusicFade");
		}
		
		//Fade Music back up
		else if (asTimer=="AmbientMusicFadeBackIn" && mbAmbientMusicPlaying==true && mbAmbientMusicAllowed==true)
		{
			Map_AddTimer("FadeOut", cMath_RandRectf(60.f,80.f), "AmbientMusicFade");
			
			if(mlAmbientMusicStage==1)
			{
				//Starting Tunnel Ambience
				Music_PlayExt("04_03_startambience", true, 0.65f*cMath_RandRectf(0.95f, 1.35f), 1.0f, cMath_RandRectf(3.f,8.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			
			if(mlAmbientMusicStage==2)
			{
				//Canyon Ambience
				Music_PlayExt("04_03_canyon_ambience", true, 0.45f*cMath_RandRectf(0.95f, 1.35f), 1.0f, cMath_RandRectf(3.f,8.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			
			if(mlAmbientMusicStage==3)
			{
				//Lab Ambience
				Music_PlayExt("04_03_lab_ambience", true, 0.25f*cMath_RandRectf(0.95f, 1.35f), 1.0f, cMath_RandRectf(3.f,8.f), 0.0f, eMusicPrio_BgAmb, true);
			}
		}
		
		//Stop ambient
		else if (asTimer=="StopAmbientMusic" && mbAmbientMusicPlaying==true)
		{
			Music_Stop(4.5f, eMusicPrio_BgAmb);
			Map_RemoveTimer("RandomFadeRider");
			Map_RemoveTimer("FadeOut");
			mbAmbientMusicPlaying = false;
		}
		
		//Stop ambient quickly
		else if (asTimer=="StopAmbientMusicQuickly" && mbAmbientMusicPlaying==true)
		{
			Music_Stop(1.5f, eMusicPrio_BgAmb);
			Map_RemoveTimer("RandomFadeRider");
			Map_RemoveTimer("FadeOut");
			mbAmbientMusicPlaying = false;
		}
	}
	
	void AmbientMusicFade(const tString &in asTimer)
	{
		if(asTimer=="FadeOut")
		{	
			Map_RemoveTimer("RandomFadeRider");
			cLux_AddDebugMessage("Ambient Music Fading Out");
			Music_Stop(cMath_RandRectf(3.f,8.f), eMusicPrio_BgAmb);
			Map_AddTimer("AmbientMusicFadeBackIn", cMath_RandRectf(25.f,45.f), "AmbientMusicHandler");
		}
		
		if(asTimer=="RandomFadeRider" &&  mbAmbientMusicAllowed==true)
		{
			cLux_AddDebugMessage("Ambient Music Fading");
			Map_AddTimer("RandomFadeRider", cMath_RandRectf(10.f,15.f), "AmbientMusicFade");
			
			if(mlAmbientMusicStage==1)
			{
				//Starting Tunnel Ambience
				Music_PlayExt("04_03_startambience", true, 0.65f*cMath_RandRectf(0.95f, 1.35f), 1.0f, cMath_RandRectf(3.f,8.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			
			if(mlAmbientMusicStage==2)
			{
				//Canyon Ambience
				Music_PlayExt("04_03_canyon_ambience", true, 0.45f*cMath_RandRectf(0.75f, 1.35f), 1.0f, cMath_RandRectf(3.f,8.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			
			if(mlAmbientMusicStage==3)
			{
				//Lab Ambience
				Music_PlayExt("04_03_lab_ambience", true, 0.25f*cMath_RandRectf(0.75f, 1.35f), 1.0f, cMath_RandRectf(3.f,8.f), 0.0f, eMusicPrio_BgAmb, true);
			}
		}
	}
	
	//}End ambient music player----------------------------
	
	bool CanyonMusicStart(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Entity_SetActive("CanyonMusic", false);
			Entity_SetActive("ReturnToTunnelMusic", true);
			BeginAmbientMusic(3.0f, 2, true);
		}
		return true;
	}
	
	bool StartingTunnelReturnMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Entity_SetActive("CanyonMusic", true);
			Entity_SetActive("ReturnToTunnelMusic", false);
			BeginAmbientMusic(3.0f, 1, true);
		}
		return true;
	}
		
	//-----------------------------------------------------
	//Enter Lab or Return To Canyon
	
	bool StartCanyonAmb(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Entity_SetActive("StopCanyonAmb", true);
			Entity_SetActive("StartCanyonAmb", false);
			BeginAmbientMusic(3.0f, 2, true);
		}
		return true;
	}
	
	bool StopCanyonAmb(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Map_AddTimer("StopAmbientMusic", 0.25f, "AmbientMusicHandler");
			Entity_SetActive("StopCanyonAmb", false);
			Entity_SetActive("StartCanyonAmb", true);
		}
		return true;
	}
			
	//-----------------------------------------------------
	
	bool LabAmbientMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Entity_SetActive("LabAmbientMusic", false);
			Entity_SetActive("CanyonReturnMusic", true);
			BeginAmbientMusic(3.0f, 3, true);
		}
		return true;
	}
	
	bool ReturnToCanyonMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Entity_SetActive("LabAmbientMusic", true);
			Entity_SetActive("CanyonReturnMusic", false);
			BeginAmbientMusic(3.0f, 2, true);
		}
		return true;
	}
	
	//-----------------------------------------------------
	//Stop Lab Music before Ross conversation
	
	bool StopLabMusicEnd(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Map_AddTimer("StopAmbientMusic", 0.25f, "AmbientMusicHandler");
			Entity_SetActive("StopLabMusicEnd", false);
			Entity_SetActive("StartLabMusicEnd", true);
		}
		return true;
	}
	
	bool StartLabMusicEnd(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			BeginAmbientMusic(3.0f, 3, true);
			Entity_SetActive("StopLabMusicEnd", true);
			Entity_SetActive("StartLabMusicEnd", false);
		}
		return true;
	}
			
	//-----------------------------------------------------
	
	void WauHeartRoomAmbientMusic(const tString &in asTimer)
	{
		Music_PlayExt("04_03_core_ambience", true, 0.7, 1.0f, 8.0f, 0.0f, eMusicPrio_BgAmb, false);
	}
				
	//-----------------------------------------------------
	
	bool StartArkEngineSound(const tString &in asParent, const tString &in asChild, int alState)
	{
		Sound_CreateAtEntity("ArkEngine", "04_03_tau_escape/SFX/ark/motor_loop", "ARK_4_2", 3.0f);
		return false;
	}
		
	//-----------------------------------------------------
	/**
	* Sound for when Ross appears to spook the player
	*/
	void Audio_RossAppear(bool bQuieter=false, float fQuieterVol=1.0f, bool bFadeMusic=true)
	{
		if(bQuieter==false)
		{
			Sound_CreateAtEntity("RossAppear", "04_03_tau_escape/SFX/ross/ross_appear", "Player");
		}
		else if(bQuieter==true)
		{
			Sound_CreateAtEntity("RossAppear", "04_03_tau_escape/SFX/ross/ross_appear", "Player", 0.0f, false, fQuieterVol);
		}
		
		if(Sound_Exists("RossAirlockTexture"))
		{
			Sound_Stop("RossAirlockTexture", 0.5f);
		}
		
		Sound_FadeGlobalVolume(0.5f, 0.05f, eSoundEntryType_WorldAll);
		Map_AddTimer("Timer_AudioRossAppearOver", 3.5f, "Audio_RossAppearOver");
		
		if(bFadeMusic==true)
		{
			Music_FadeVolumeMul(0.25f, 0.05f);
		}
	}
	
	void Audio_RossAppearOver(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_WorldAll);
		Music_FadeVolumeMul(1.0f, 4.0f);
		Depth_Audio_Fear_HighIntensity(12.0f, 20.0f, 0, false, true);
	}
	
	//----------------------------------------------------
	
	/**
	 * Audio function player turning valve to open door
	 */
	
	bool mbWheelClunkSoundPlayed = false;
	bool mbWheelClunkOnMinSoundPlayed = false;
	bool mbWheelClunkOnMaxSoundPlayed = false; 
	bool mbDoorOpenSoundActive = false;
	bool mbDoorClosingSoundActive = false;
	
	//-------------------------------------------------------------
	
	//Stair creaks
	bool mbStairCreak = false;
	bool Trigger_StairCreak(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		cLux_AddDebugMessage("stair creak");
		Sound_CreateAtEntity("StairCreak", "02_02_ms_curie_inside/AMB/spot/creaky_stairs", "Player");
		Entity_SetActive("StairCreak_*", false);
		Map_AddTimer("Timer_ActiveStairCreakArea", cMath_RandRectf(6.0f,12.0f), "Timer_ActiveStairCreakArea");
		
		if(mbStairCreak==false)
		{
			mbStairCreak = true;
			Sound_CreateAtEntity("CurieEXTStairwellCreak", "level_amb_shared_underwater/amb/spots/metal/curie/EXT/stairwell_2D", "Player");
			Map_AddTimer("CurieStairwellCreakMixerFadeUp", 3.0f, "Timer_CurieExteriorCreakFadeUp");
			Sound_FadeGlobalVolume(0.5f, 3.0f, eSoundEntryType_WorldClean);
		}
		
		return true;
	}
	
	void Timer_CurieExteriorCreakFadeUp(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Stairwell creak over - world clean fading back up");
		Sound_FadeGlobalVolume(1.0f, 2.5f, eSoundEntryType_WorldClean);
	}
	
	void Timer_ActiveStairCreakArea(const tString &in asTimer)
	{
		cLux_AddDebugMessage("stair creak areas enabled");
		Entity_SetActive("StairCreak_*", true);
	}
	
	//----------------------------------------------------
	/**
	 * Crawlspace quakes
	 */
	
	bool CrawlspaceTremors(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Map_AddTimer("CrawlspaceTremor", cMath_RandRectf(3.0, 6.0f), "CrawlSpaceTremorEvent");
		}
		else
		{
			Map_RemoveTimer("CrawlspaceTremor");
		}
		return true;
	}
	
	void CrawlSpaceTremorEvent(const tString &in asTimer)
	{
		if(Sound_Exists("CrawlspaceTremorSound")==false)
		{
			Sound_CreateAtEntity("CrawlspaceTremorSound", "04_03_tau_escape/SFX/crawlspace_quake", "Player");
			Sound_FadeGlobalVolume(0.65f, 3.0f);
			Music_FadeVolumeMul(0.65f, 3.0f);
			Map_AddTimer("TremorAudioReturn", 6.0f, "TremorAudioReturn");
			Effect_Shake_Start(cMath_RandRectf(0.015f, 0.018f), cMath_RandRectf(3.0, 5.0f), 2.0f, cMath_RandRectf(2.0, 4.0f));
		}
		
		Map_AddTimer("CrawlspaceTremor", cMath_RandRectf(8.0, 12.0f), "CrawlSpaceTremorEvent");
	}
	
	void TremorAudioReturn(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 5.0f);
		Music_FadeVolumeMul(1.0f, 5.0f);
	}
	
	//----------------------------------------------------
	/**
	 * Audio functions for when Ross talks to Simon in the Hallway before the heart room
	 */
	void Audio_StartRossConversation()
	{
		Sound_CreateAtEntity("RossConversationStart", "04_03_tau_escape/SFX/ross/conversation/tunnel/start", "Player");
		Sound_CreateAtEntity("RossConversationLoop", "04_03_tau_escape/SFX/ross/conversation/tunnel/loop", "Player", 1.5f, false, 0.85f);
		Map_AddTimer("StopAmbientMusicQuickly", 0.5f, "AmbientMusicHandler");
		Sound_FadeGlobalVolume(0.35f, 1.5f, eSoundEntryType_WorldClean);
		Map_AddTimer("Timer_RossConversationMusic", 4.0f, "Timer_RossConversationMusic");
		mbAmbientMusicAllowed = false;
	}
	
	void Audio_StopRossConversation()
	{
		Sound_CreateAtEntity("RossConversationStop", "04_03_tau_escape/SFX/ross/conversation/tunnel/stop", "Player");
		Map_AddTimer("Audio_StopRossConversationLoop", 1.1, "Audio_StopRossConversationLoop");
		Sound_FadeGlobalVolume(1.0f, 5.0f, eSoundEntryType_WorldClean);
		Depth_Audio_Fear_MediumIntensity(8.0f, 15.0f, 1, false, true);
	}
	
	void Audio_StopRossConversationLoop(const tString &in asTimer)
	{
		Sound_Stop("RossConversationLoop", 0.25f);
	}
	
	void Timer_RossConversationMusic(const tString &in asTimer)
	{
		Music_Play("04_03_ross_conversation", 0.75, true, eMusicPrio_MinorEvent);
		Sound_FadeGlobalVolume(1.0f, 4.0f, eSoundEntryType_WorldAll);
	}
	
