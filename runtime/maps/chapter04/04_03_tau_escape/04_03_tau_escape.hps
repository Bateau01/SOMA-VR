	void LeviathanCirclingDomeSweetStart(float afStartTime=4.0f)
	{
		Map_AddTimer("LevCirclingDomeSound", afStartTime, "LevCirclingDomeSound");
	}
	
	void LevCirclingDomeSound(const tString &in asTimer)
	{
		if(Sound_Exists("LevCircle")==false)
		{
			Map_AddTimer("LevCirclingDomeSound", cMath_RandRectf(10.0f, 17.0f), "LevCirclingDomeSound");
			Sound_CreateAtEntity("LevCircle", "04_03_tau_escape/SFX/wau_heart/leviathan_circling_sweet", "Player");
			Emotion_StartBackgroundBreath(eBreathType_Normal, 0.6f, 3, 8, 0, 3);
			Sound_FadeGlobalVolume(0.65f, 3.0f, eSoundEntryType_WorldClean);
			Map_AddTimer("FadeUpFromLevSweet", 3.0, "FadeUpFromLevSweet");
			Effect_Shake_Start(0.005f, 2.0f, 2.0f, 2.0f);
		}
	}
	
	void FadeUpFromLevSweet(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 4.0f, eSoundEntryType_WorldClean);
	}
	
	void LeviathanCirclingDomeSweetStop()
	{
		Map_RemoveTimer("LevCirclingDomeSound");
		Sound_Stop("LevCircle", 4.0f);
	}
	
