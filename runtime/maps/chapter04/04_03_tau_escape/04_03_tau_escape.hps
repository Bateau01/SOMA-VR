float gfPlayerWalkTunnelSpeed=0.55f;	
	
//--------------------------------------------------
 
bool _HPL3VR_AlphaActive()
{
	cScript_SetGlobalReturnBool(false);
	cScript_RunGlobalFunc("MenuHandler","cScrMenuHandler","HPL3VR_GetRuntimeActive");
	return cScript_GetGlobalReturnBool();
}

class cScrMap : iScrMap
{
	//--------------------------------------------

	/////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	
	int mlDoFId;

	//-------------------------------------------------------

	////////////////////////////
	// Set up map environment
	void Setup()
	{
		GetBase().SetDisplayNameEntry("04-03-tau-escape");
		RichPresence_SetCurrent(eRichPresence_SiteAlpha );
		
		mlDoFId = Effect_DoF_Start(0.05, 3.0f, 1.0f, -1);
		Effect_RadialBlur_Start(0.1f,0.1f,0.75f,0.0f);

		Effect_Bloom_FadeBrightPass(0.00001, 0);
		Effect_Bloom_FadeBloomWidth(64, 0);
		Effect_Bloom_FadeBloomTint(0.6, 0.4, 0.4, 0);
		Map_SetUnderwater(true);
		
		///////////////////////////////
		//PRESET 5.1 TRANSITION
		Map_Preset_SetupDepthOfField("Preset5.1", false);
		Map_Preset_SetupColorGrading("Preset5.1", "textures/colorgrading/grading_05_01.dds");
		Map_Preset_SetupFog("Preset5.1", true, 2, 80, 0.9, cColor(0.105f,0.115,0.15f,0.6f), 1.0, false, false);
		Map_Preset_SetupSecondaryFog("Preset5.1", true, 0, 10, 1, cColor(0.105f,0.115,0.15f,0.1f));
		Map_Preset_SetupBloom("Preset5.1", 128, 0.75, 0.5, cColor(1.0, 1.0));
			
		cLux_GetCurrentMap().GetWorld().SetFogUnderwater(true);
		cTerrain@ pTerrain = cLux_GetCurrentMap().GetWorld().GetTerrain();
		if(pTerrain !is null) pTerrain.SetCheapMaterial("sand_flat_abyss.mat", 0.5f);
	}
	
	//-------------------------------------------------------
	
	void PreloadData()
	{
		PlayerHands_PreloadHandModel_DeepSeaMutilated();
		PlayerHands_PreloadHandModel_DeepSea();
		
		OmnitoolGui_Preload();
		StationGui_PreloadDefault();
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			//Add any debug stuff here
			cLux_SetDebugInfoWindowText("Text that should show up when pressing F1");
			Sound_PreloadGroup("04_03_tau_escape/SFX/ark", true);
			Map_AddTimer("SetupTravelTowardsTau", 1.1, "TimerSetupTravelTowardsTau");
		}
		else
		{
			Seq_WakeUp("");
			Sound_PreloadGroup("04_03_tau_escape/SFX/ark", true);
		}
		
		SetupOutdoors();
		SetupPhiDoor();
		//SetupPressure();
		
		Tool_PickUp("CathBoxTool", false, false);
		
		PlayerHands_SetHandModel_DeepSea();
		
		Entity_PlayAnimation("04_03_wau_monster_mouth_1", "wau_idle", 0.1f, true);
		Entity_StopAnimation("ArkHolder_4_2");

		Voice_SetCharacterSpeakingCallback("Flesher", "RossTalks");

		Entity_SetVarString("AirlockControlScreen", "State", "");
		Entity_SetVarColor("AirlockControlScreen", "TextColor", cColor_White);
		Terminal_SetImGuiStateFloat("AirlockControlScreen", "PressureMul", 1);
		Entity_SetVarString("AirlockEntranceControlScreen", "State", "AirlockPanelStatus_Idle");
		Entity_SetVarColor("AirlockEntranceControlScreen", "TextColor", cColor_White);

		//////////////////////////
		//END AIRLOCK
		Entity_StopAnimation("airlock_warning_lamp_*");
		Lamp_SetLit("airlock_warning_lamp_*", false, false);
		ParticleSystem_SetActive("airlock_1_drain_bubbles_oneshot", false);
		ParticleSystem_SetActive("airlock_1_drain_effects_*", false); 
		
		///////////////////////////////////////////////////
		//////Load audio
		Sound_PreloadGroup("Flashback/Level/04_03", true);
		Sound_PreloadGroup("Flashback/Ross/4.3", true);
		Sound_PreloadProject("04_03_tau_escape");	
		
		CathTool_ResetScreen(eCathToolVariant_CathAbyss);
		
		LastOnSoma_SetText("04_03_tau_escape");
		
		EyeTracking_RegisterEntity("interactAux_heart");
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
		MainMenu_SetBGPhase(eMainMenuPhase_3_3_To_End);
		
		if(cLux_ScriptDebugOn()==false)
		{
			Game_AutoSave();	
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		Music_Stop(2,eMusicPrio_BgAmb);
	}

	//-------------------------------------------------------

	////////////////////////////
	// The player has died.
	void OnPlayerKilled(int alRecentDeaths, const tString&in asSource)
	{
		
	}

	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		//OnActionWauPullArea(alAction, abPressed);
		
		if(abPressed==false) return;
		
		if(alAction == eAction_Test1)
		{
			Entity_SetActive("leviathan_2", true);
			Leviathan_SetState_CirclePlayer("leviathan_2");
		}
		if (alAction == eAction_Test2)
		{
			mlTrembleCount++;
			cLux_AddDebugMessage("Tremor amount is "+mlTrembleCount);
		}
		if (alAction == eAction_Test3)
		{
			Player_Teleport("Start_Inside_airlock", true);
			Preload();
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
		}
		if (alAction == eAction_Test3)
		{
			Seq_WakeUp("");
		}
		if (alAction == eAction_Test4)
		{
			//Player_AddHealth(1.0f);
			CanyonSweetenerStart();
		}
		if (alAction == eAction_Test5)
		{
			mbRossDead=true;
			PlayerHands_SetHandModel("character/player/hands/hands_deepsea_mutilated.ent");
			Timer_PlayerLookAtStump("");
		}
		if (alAction == eAction_Test6)
		{
			Player_SetHealth(0.6f);
			Entity_SetActive("TriggerGoNearWauExit", false);
			Entity_SetActive("TriggerPlayerTriesToEscape", false);
			Entity_SetActive("TriggerPlayerEscapeFinalWarning", false);
			Entity_SetActive("TriggerPlayerInExitTunnel", true);
			Entity_SetActive("TriggerLeviathanTunnelHunt", true);
			
			CheckPoint_Setup();
		}
		if (alAction == eAction_Test7)
		{
		    //Effect_DoF_FadeFocus(mlDoFId, 0.05, 10, 2);
			WauSwallowsRossEvent();
		}
		if (alAction == eAction_Test8)
		{
		    Player_SetHealth(1);
		}
		
	}

	//-------------------------------------------------------

	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afY)
	{
		//afY = cLux_DrawDebugText("My Debug value:"+..., afY);
		return afY;
	}
	
