		void Timer_PlayerLookAtStump(const tString&in asTimer)
		{
			Emotion_StopHeartbeat(mlPutHandInHeatbeatId);
			mlPutHandInHeatbeatId = Emotion_StartHeartbeat(0.75, 1.0, 1);
			
					
			PlayerHands_SetUseCustomPosition(false);
			PlayerHands_SetUseCustomRotation(false);
			
			if(mbRossDead)
				Emotion_StartBackgroundBreath(eBreathType_Fear, 1, 2, 15, 0.2, 4);	
			else
				Emotion_StartBackgroundBreath(eBreathType_Fear, 1, 1, 8, 1, 3);
			
						
			PlayerHands_PlayAnimation("event_examine_mutilated_hand", true,true, 0,"",false);
			
			Map_AddTimer("PlayerTakeDownStump", 3.0f, "Timer_PlayerTakeDownStump");
			
			Map_AddTimer("AfterStump", 1.0f, "AfterStump");
			Music_Stop(2.0f, eMusicPrio_BgAmb);
			Sound_FadeGlobalVolume(1.0f, 5.0f, eSoundEntryType_WorldClean);
			
			EyeTracking_SetExtendedViewMul(1.0f);
		}
		
		void Timer_PlayerTakeDownStump(const tString&in asTimer)
		{
			Emotion_StopHeartbeat(mlPutHandInHeatbeatId);
			mlPutHandInHeatbeatId = Emotion_StartHeartbeat(1.0, 0.8, 1, 4);
			
			if(mbRossDead==false)
				PlayerHands_PlayAnimation("event_examine_mutilated_hand_end", false,false, 0.2f,"");
			else
				PlayerHands_PlayAnimation("event_examine_mutilated_hand_end", false,false, 0.2f,"", true, 0.35f);
			
			mbPlayerLostHand = true;
		}
		
		void AfterStump(const tString &in asTimer)
		{
			if(mbRossDead==false)
			{
				Map_AddTimer("StrikeDownAfterHandOff", 0.25f, "Timer_StrikeDownAfterHandOff");
			}
			else
			{
				Map_AddTimer("RecoverAfterHandOff", 6.0f, "Timer_RecoverAfterHandOff");
			}
		}
		
		void Timer_StrikeDownAfterHandOff(const tString&in asTimer)
		{
			Player_FadeMoveSpeedMulTo(0.1, 0.3f);
			Effect_VideoDistortion_Start(1, 1, 1.2f, 0.2);
			Effect_TimeGlitch_Start(1, 1, 1, true);
			
			Sound_SetGlobalVolume(0.0f, eSoundEntryType_WorldClean);
			
			Map_AddTimer("NearDoorDamageFinal", 0.6f, "Timer_NearDoorDamageFinal");
		}
		
		
		void Timer_RecoverAfterHandOff(const tString&in asTimer)
		{
			Emotion_StopHeartbeat(mlPutHandInHeatbeatId);
			Player_FadeMoveSpeedMulTo(1.0f, 6.0f);
			
			StartWauRoomTrembles();
		}
		
		//-------------------------------------------------------
		
		void WauChangesAfterImplant()
		{
			Light_FadeTo("wau_core_light_*", cColor(0.75, 0,0,1), -1, 10);
			
			Entity_PlayAnimation("04_03_wau_monster_mouth_1", "wau_idle_fast", 0.1f, true);	
			
			//Light_FadeTo("PointLight_2", cColor(0.922*0.65f,0.798*0.65f,0.313*0.65f,1), -1, 5);
			
			Entity_SetActive("DistortArea_1_AfterImplant", true);
			Entity_SetActive("DistortArea_1", false);
			Lamp_SetLit("wall_medium_nolight_1", true, true);
			
			Sound_CreateAtEntity("WauGrowing", "04_03_tau_escape/SFX/wau_heart/wau_heart_growing", "Player");
		}
		
		//-------------------------------------------------------
		
		//} END Put Hand in Wau
		
		//-------------------------------------------------------
		
		/////////////////////////////////////////
		// * Event: Wau Room Trembles */
		//{//////////////////////////////////////
		
		bool mbInsideWauRoom=false;
		bool mbWauRoomTremblesStarted=false;
		
		//-------------------------------------------------------
		
		void StartWauRoomTrembles()
		{
			mbWauRoomTremblesStarted = true;
			
			if(mbInsideWauRoom)
			{
				Map_AddTimer("WauRoomTremble", 0.1f, "Timer_WauRoomTremble");
				cLux_AddDebugMessage("Sound: Escalation of the loop starts");
				
				Music_PlayOverlay("04_03_core_collapse_stinger", 0.5f);
				Music_PlayExt("04_03_core_collapse", true, 0.75f, 1.0f, 1.0f, 0.0f, eMusicPrio_BigEvent, false);
			}
		}
		
		//-------------------------------------------------------
		bool mbWauRoomTrembleSound = false;
		void Timer_WauRoomTremble(const tString&in asTimer)
		{
			float fTime = cMath_RandRectf(0.5, 1.5);
			
			if(mbWauRoomTrembleSound==false)
			{
				StartHeartRoomQuake();
				mbWauRoomTrembleSound = true;
			}
			
			Effect_Rumble_Start(cMath_RandRectf(0.3f, 0.5f), fTime, 0.1f, 0.2f);
			Effect_VideoDistortion_Start(1.0f, fTime-0.3f, 0.1, 0.2f, 0.95f);
			Effect_Shake_Start(cMath_RandRectf(0.025, 0.075), fTime+0.1f, 0.1, 2.6, cVector3f(1, 0.4f, 0));
			Map_RestartCurrentTimer(fTime);
		}
		
		//-------------------------------------------------------
		
		bool CollideInsideWauRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbInsideWauRoom = alState==1;
			
			if(mbInsideWauRoom)
			{
				if(mbWauRoomTremblesStarted)
				{
					Map_AddTimer("WauRoomTremble", 0.1f, "Timer_WauRoomTremble");
					cLux_AddDebugMessage("Sound: Escalation of the loop starts");
				}
			}
			else
			{
				if(mbWauRoomTremblesStarted)
				{
					Map_RemoveTimer("WauRoomTremble");
					cLux_AddDebugMessage("Sound: Escalation of the loop fades out");
				}
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END Wau room trembles
		
		//-------------------------------------------------------
		
		/////////////////////////////////////////
		// * Event: Try to escape */
		//{//////////////////////////////////////
		
		bool mbPlayerInsideTunnel=false;
		
		//-------------------------------------------------------
		
		bool OnTriggerPlayerInsideTunnel(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState==1)
				mbPlayerInsideTunnel =true;
			else
				mbPlayerInsideTunnel =false;
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnOpenWauDoor(const tString &in asEntity)
		{
			if(mbRossDead) return;
			
			Voice_Play("3_SimonEscapeAttempt_1", -1, "", 1);
						
			cLux_AddDebugMessage("3_DodgedRoss");
			
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerGoNearWauExit(const tString &in asParent, const tString &in asChild, int alState)
		{
			Effect_TimeGlitch_Start(1, 1, 0.1, false);
			Sound_CreateAtEntity("RossDisappearQuick", "04_03_tau_escape/SFX/ross/ross_disappear_quick", "Player");
			Effect_VideoDistortion_Start(0.55, 4, 0.3, 1);
			Entity_SetActive("Flesher_PushBack", true);
			BarkMachine_SetActive("Flesher_PushBack", false);
			Map_AddTimer("NearDoorFlesherVanish", 3, "Timer_NearDoorFlesherVanish");
			
			// No longer pushing back
			//	Player_AddBodyForce(cVector3f(-100*80,35*80,100*80), false);
			
			Voice_PlayWhenPossible("3_DodgedRoss");
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void Timer_NearDoorFlesherVanish(const tString&in asTimer)
		{
			Effect_TimeGlitch_Start(1, 1, 0.1, false);
			Sound_CreateAtEntity("RossDisappearQuick", "04_03_tau_escape/SFX/ross/ross_disappear_quick", "Player");
			
			Entity_SetActive("Flesher_PushBack", false);
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerPlayerEscapeFinalWarning(const tString &in asParent, const tString &in asChild, int alState)
		{
			Voice_Play("3_SimonEscapeAttempt_4", -1, "", 1);
			
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerPlayerTriesToEscape(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_RemoveTimer("RossDemandsSimonDoIt");
			cLux_AddDebugMessage("3_SimonEscapeAttempt_5_FinalComment");
			Voice_Play("3_SimonEscapeAttempt_5_FinalComment", -1, "", 2);
			
			Player_FadeMoveSpeedMulTo(0.6, 1);
			
			Map_AddTimer("NearDoorDamageFinalFreeze", 1.3f, "Timer_NearDoorDamageFinalFreeze");
						
			return false;
		}
		
		void Timer_NearDoorDamageFinalFreeze(const tString&in asTimer)
		{
			Player_FadeMoveSpeedMulTo(0.1, 0.3f);
			Effect_VideoDistortion_Start(1, 1, 1.2f, 0.2);
			Effect_TimeGlitch_Start(1, 1, 1, true);
			Entity_SetActive("Flesher_StopEscape", true);
			BarkMachine_SetActive("Flesher_StopEscape", false);
			
			Map_AddTimer("NearDoorDamageFinal", 0.6f, "Timer_NearDoorDamageFinal");
		}
		
		void Timer_NearDoorDamageFinal(const tString&in asTimer)
		{
			Effect_Shake_Start(1.0f, 1, 0.1, 1);
			
			Effect_Rumble_Start(1.5, 1, 0, 0.1);
			
			Sound_PlayGui("04_03_tau_escape/SFX/ross/ross_knockout_player", 1.0f);
			
			Effect_Fade_Out(0.1);
			
			Sound_FadeGlobalVolume(0.0f, 0.1f, eSoundEntryType_WorldClean);
			
			Map_AddTimer("NearDoorDamageSwallow", 0.3f, "Timer_NearDoorDamageSwallow");
		}
		
		void Timer_NearDoorDamageSwallow(const tString&in asTimer)
		{
			Player_SetMoveSpeedMul(1.0f);
			Entity_SetActive("Flesher_StopEscape", false);
			Entity_SetActive("Flesher_PushBack",false);
			WauSwallowsRossEvent();
		}
		
		//-------------------------------------------------------
		
		//} END Event Enter 
		
		/////////////////////////////////////////
		// * Event: Wau swallows Ross */
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlImageFadeId;
		bool mbRossDead=false;
		
		//-------------------------------------------------------
		
		void WauSwallowsRossEvent()
		{
			Seq_WauSwallowsRoss("");
			Entity_SetActive("TriggerGoNearWauExit", false);
			Entity_SetActive("TriggerPlayerTriesToEscape", false);
			Entity_SetActive("TriggerPlayerEscapeFinalWarning", false);
			Entity_SetActive("TriggerPlayerInExitTunnel", true);
			Entity_SetActive("TriggerLeviathanTunnelHunt", true);
			
			//Skipping this here so u can stick yourr hand in after death.
			//Entity_SetInteractionDisabled("04_03_wau_monster_mouth_1", true);
			
			Map_RemoveTimer("RossDemandsSimonDoIt");
			
			Effect_DoF_FadeFocus(mlDoFId, 0.05, 3, 5.0f);
			Map_AddTimer("FadeBackIn", 5.0f, "FadeBackInRoss");
			
			mbRossDead =true;
		}
		
		void FadeBackInRoss(const tString &in asTimer)
		{
			Sound_FadeGlobalVolume(1.0f,9.0f, eSoundEntryType_WorldClean);
		}
		
		cSequenceStatesData mSeqWauSwallowsRoss;
		void Seq_WauSwallowsRoss(const tString &in asX)
		{
			Sequence_Begin("Seq_WauSwallowsRoss", mSeqWauSwallowsRoss);
			
			if (Sequence_DoStepAndWait(5))
			{
				mlImageFadeId = Effect_ImageTrail_Start(0.5f, 1.0f, -1, 1.0f);
				Player_AddHealth(-0.5f, 0.5f);
				Player_Teleport("RossTakesDownPlayerPos");
				Player_StartLookAt("Flesher_Final",1,1,1);
				Player_SetCrouching(true, true, true);
				Player_SetCrouchDisabled(true);
				Player_SetMoveSpeedMul(0);
				Player_MoveHeadPos(cVector3f(0,-0.5, 0),1,1,1);
				Light_FadeTo("spotlight_highlight_ross",cColor(0.266,1,0.983,1),-1,1);
				Player_SetJumpDisabled(true);
				Player_SetStandDisabled(true);
			}
			else if (Sequence_DoStepAndWait(3.5))
			{
				Sound_PreloadGroup("04_03_tau_escape/SFX/wau_heart", true);
				
				Entity_SetActive("Flesher_Final", true);
				BarkMachine_SetActive("Flesher_Final", false);
				
				Pathfinder_Track_Add("Flesher_Final", "PathNodeArea_207");
				Pathfinder_Track_Add("Flesher_Final", "PathNodeArea_318");
				Pathfinder_Track_Add("Flesher_Final", "PathNodeArea_319");
				Pathfinder_Track_Add("Flesher_Final", "PathNodeArea_320");
				Pathfinder_Track_Add("Flesher_Final", "PathNodeArea_314");
				Pathfinder_Track_Add("Flesher_Final", "PathNodeArea_316");
				Pathfinder_Track_Start("Flesher_Final");
				
				Player_StopLookAt(1);
				Player_SetLookSpeedMul(0.4f);
				Music_PlayExt("04_03_ross_killyourself", true, 0.7f, 1.0f, 2.0f, 0.0f, eMusicPrio_BigEvent, false);
								
				Effect_Fade_In(2);
				Music_FadeVolumeMul(1.0f, 2.0f);
				Sound_FadeGlobalVolume(1.0f, 2.0f, eSoundEntryType_WorldAll);
				Sound_FadeGlobalVolume(1.0f, 2.0f, eSoundEntryType_GuiWorld);
			}
			else if (Sequence_DoStepAndPause(0.25))
			{
				if (mbPlayerLostHand)
					Voice_Play("3_WauSwallowsRoss_NoArm",-1,"SubjectOver_WauSwallowsRoss_1");
				else
					Voice_Play("3_WauSwallowsRoss_1",-1,"SubjectOver_WauSwallowsRoss_1");
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Effect_Shake_Start(0.085, 1, 1.0, 0.5);
				Music_Stop(1.0f, eMusicPrio_BigEvent);
				cLux_AddDebugMessage("Play Ross animation!");
				CharMover_SetUseMoveStateAnimations("Flesher_Final", false);
				Entity_PlayAnimation("Flesher_Final", "before_death");
			}
			else if (Sequence_DoStepAndWait(0.25f))
			{
				Music_Play("04_03_ross_eaten", 0.7, false, eMusicPrio_BigEvent);
				
				Effect_Shake_Start(0.4, 0.25, 0.05, 0.5);
				Effect_VideoDistortion_Start(1, 2, 0.1, 3);
				
				Entity_SetActive("leviathan_eat", true);
				Entity_PlayAnimation("leviathan_eat", "rush", 0.1, true, true, "");
				Prop_MoveLinearTo("leviathan_eat","Leviathan_Target_EatRoss", 20,25, 0.1, true);
			}
			else if (Sequence_DoStepAndWait(0.25))
			{
				Entity_SetActive("breakthrough_tiles", false);
				//Entity_SetActive("04_03_hearthroom_pedestal_1", false);
				Entity_SetActive("breakthrough_tiles_broken", true);
				Entity_SetActive("breakthrough_hole", true);
				Entity_AddImpulse("breakthrough_tiles_broken", cVector3f(0,2,0), false, false);
				//Entity_SetActive("04_03_hearthroom_pedestal_broken_1", true);
				Entity_SetActive("leviathanholeblocker", true);
				
				ParticleSystem_CreateAtEntity("BreakFloorSmoke", "smoke_cloud_big_oneshot.ps", "Leviathan_BreakGroundPoint", false);
				
				Effect_Shake_Start(0.15, 0.5, 0.1, 0.5);
				Entity_PlayAnimation("leviathan_eat", "attack", 0.1, false, true, "AnimOver_LeviathanAttack");
				Light_FadeTo("spotlight_highlight_ross",cColor(0,0,0,0),-1,1);
				
				cLux_AddTodoMessage("Sound: Leviathan crunches on Ross."); 
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				ParticleSystem_CreateAtEntity("RossBlood", "underwater_cloud_ross_remains_oneshot.ps", "Leviathan_Target_EatRoss", false);
				ParticleSystem_CreateAtEntity("RossBloodTrail", "underwater_cloud_ross_trail_oneshot.ps", "Leviathan_Target_EatRoss", false);
				ParticleSystem_CreateAtEntity("BreakthroughBubbles", "leviathan_breakthrough_bubbles.ps", "Leviathan_breakthrough_bubbles", false);
				ParticleSystem_CreateAtEntity("BreakthroughBubbles", "ross_blood_blobs.ps", "Leviathan_Target_EatRoss", false);
				
				Entity_SetActive("Flesher_Final", false);
				
				Voice_Play("3_WauSwallowsRoss_2",-1,"");
			}
			else if (Sequence_DoStepAndWait(2.25f))
			{
				Prop_MoveLinearTo("leviathan_eat","Leviathan_Target_Down", 5,25, 0.1, true);
				
				Effect_Shake_Start(0.4, 0.25, 0.05, 0.5);
				Effect_VideoDistortion_Start(1, 2, 0.1, 3);	
			}
			else if (Sequence_DoStepAndWait(4))
			{
				Player_FadeLookSpeedMulTo(1.0f, 5.0f);
				
				Player_SetSlowStandupMotion(true);
				Player_SetCrouchDisabled(false);
				Player_SetStandDisabled(false);
				Player_SetCrouching(false);
				Player_FadeMoveSpeedMulTo(0.2, 5);
				Player_MoveHeadPos(cVector3f(0,0,0),1,0.3,1); 
			}
			else if (Sequence_DoStepAndWait(3))
			{
				Player_SetJumpDisabled(false);
				Player_SetSlowStandupMotion(false);
				/*if(mbPlayerLostHand)
					Voice_Play("3_SimonAfterRossDeath_LostHand");
				else
					Voice_Play("3_SimonAfterRossDeath_HasHand");*/
				
				Player_FadeMoveSpeedMulTo(1, 5);
			}
			else if (Sequence_DoStepAndWait(3))
			{
				Effect_ImageTrail_FadeOut(mlImageFadeId, 5.0f);
				if(mbPlayerLostHand==false)
				{
					Music_Play("04_03_after_rosskilled.ogg", 0.75, true, eMusicPrio_BgAmb);
					Effect_Shake_Start(0.075, 1, 0.5, 1);
					
					LeviathanCirclingDomeSweetStart(8.0f);
				}
				
				if(mbPlayerLostHand)
				{
					StartWauRoomTrembles();
				}
			}
			else if (Sequence_DoStepAndWait(0))
			{
				CheckPoint_Setup("");
			}
			
			Sequence_End();
		}
		
		
		void AnimOver_LeviathanAttack(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_PlayAnimation("leviathan_eat", "swim", 0.1, true, true, "AnimOver_LeviathanAttack");
		}
		
		void LineOver_RossKillSimon(const tString &in asScene, const tString &in asSubject, int alLineIndex, bool abStartOfLine)
		{
			if(abStartOfLine==true && asSubject=="3_WauSwallowsRoss_NoArm")
			{
				cLux_AddDebugMessage("Ross Death Sound Start");
				Sound_CreateAtEntity("LeviathanKillsRoss", "04_03_tau_escape/SFX/wau_heart/leviathan_eats_ross_PostHeart", "Player");
				Map_AddTimer("RossDeath", 2.0f, "RossDeathBegin");
				Sound_FadeGlobalVolume(0.65f, 3.0f, eSoundEntryType_WorldClean);
				Map_AddTimer("FadeUpAfterRossEat", 8.0f, "FadeUpAfterRossEat");
			}
			
			if(abStartOfLine==true && asSubject=="3_WauSwallowsRoss_1")
			{
				Sound_CreateAtEntity("LeviathanKillsRoss_NoHeart", "04_03_tau_escape/SFX/wau_heart/leviathan_eats_ross_NoHeart", "Player");
				cLux_AddDebugMessage("Ross Death Sound Start");
				Map_AddTimer("RossDeath", 4.0f, "RossDeathBegin");
				Sound_FadeGlobalVolume(0.65f, 3.0f, eSoundEntryType_WorldClean);
				Map_AddTimer("FadeUpAfterRossEat", 12.0f, "FadeUpAfterRossEat");
			}
			
		}
		
		//-------------------------------------------------------
		
		void FadeUpAfterRossEat(const tString &in asTimer)
		{
			Sound_FadeGlobalVolume(1.0f, 5.0f, eSoundEntryType_WorldClean);
		}
		
		//-------------------------------------------------------
		
		void RossDeathBegin(const tString &in asTimer)
		{
			cLux_AddDebugMessage("Ross Death");
			SequenceStates_Resume("Seq_WauSwallowsRoss");
		}
		
		//-------------------------------------------------------
		
		//} END Event Enter 
		
