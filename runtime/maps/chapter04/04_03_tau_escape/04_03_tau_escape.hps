	/////////////////////////////////////////
	// ==============
	// SCENE 4 *EXIT TUNNEL & REACH TAU*
	// ==============
	//{//////////////////////////////////////

	//-------------------------------------------------------
	
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////

		void SetupOutdoors()
		{
			Lamp_SetLit("LampExtProgress_*", false, false);
			Entity_SetInteractionDisabled("highsecurity_*", true);
		}
		
		//-------------------------------------------------------
		
		//} END General
		
		/////////////////////////////////////////
		// Event *Enter tunnel*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool OnTriggerPlayerInExitTunnel(const tString &in asParent, const tString &in asChild, int alState)
		{
			Preload();
			
			AttackMeter_SetCustomDamageCallback("");
			
			Player_FadeMoveSpeedMulTo(1.0f, 2.0f);
			
			Effect_DoF_FadeFocus(mlDoFId, 0.05, 8, 2);
			
			//Music_Stop(6,eMusicPrio_BgAmb);
			
			Map_RemoveTimer("RossDemandsSimonDoIt");
			
			return false;
		}
		
		//-------------------------------------------------------
		
		//} END Event *Enter Tunnel*
		
		/////////////////////////////////////////
		// Event *Leviathan Hunt*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool OnTriggerLeviathanTunnelHunt(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_LeviathanChaseStart("");
			
			Map_AddTimer("RegenLowHealth", 0.1f, "Timer_RegenLowHealth");
			
			return false;
		}
		
		cSequenceStatesData mSeqLeviathanChaseStart;
		void Seq_LeviathanChaseStart(const tString &in asX)
		{
			Sequence_Begin("Seq_LeviathanChaseStart", mSeqLeviathanChaseStart);
			
			if (Sequence_DoStepAndWait(2.25))
			{
				Music_Stop(2.0f, eMusicPrio_BigEvent);
				Music_Stop(2.0f, eMusicPrio_MinorEvent);
				Music_Stop(2.0f, eMusicPrio_BgAmb);
				StopHeartRoomQuake(0.25f);
				LeviathanCirclingDomeSweetStop();
				
				Sound_PreloadGroup("NPC_Creatures/Foley/Underwater/Leviathan", true);
				Sound_PreloadGroup("NPC_Creatures/Vocalisations/Underwater/Leviathan", true);
				
				cLux_AddDebugMessage("Chase Starts");
				Sound_CreateAtEntity("LevChaseStart", "04_03_tau_escape/SFX/leviathan_chase/tunnel_intro", "Player");
				
				if(Sound_Exists("LeviathanKillsRoss_NoHeart"))
				{
					Sound_Stop("LeviathanKillsRoss_NoHeart", 3.0f);
				}
				
				Effect_Rumble_Start(0.7, 1.5, 0.1, 0.6);
				Effect_Shake_Start(0.5, 0.5, 0.1, 2.0f);
				Player_MoveHeadPos(cVector3f(0, -0.3, 0), 10, 7, 0.05f);
			
				Player_FadeRollTo(35, 30, 20);
				Player_SetMoveSpeedMul(0.65);
			}
			if (Sequence_DoStepAndWait(0.5))
			{
				Effect_Shake_Start(0.4, 0.7, 0.1, 1.0f);
				cLux_AddDebugMessage("Sound: The tunnel shakes and player falls to ground.");
				
				Player_FadeRollTo(90, 30, 20);
				Player_SetMoveSpeedMul(0);
				Player_SetCrouching(true, true, true);
				Player_MoveHeadPos(cVector3f(0, -0.6, 0), 10, 7, 0.05f);
				Player_SetCrouchActionDisabled(true);
				
				Player_StartLookAt("HuntStartLookAt", 3,5,2);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Player_FadeMoveSpeedMulTo(0.5, 1.5);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Player_FadeRollTo(0, 10, 8);
				
				Player_StopLookAt(1);
				Player_SetSlowStandupMotion(true);
				Player_SetCrouching(false);
				Player_MoveHeadPos(cVector3f(0, -0.3, 0), 1, 1, 0.05f);
				
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Player_SetCrouchActionDisabled(false);
				Player_SetSlowStandupMotion(false);
				Player_FadeMoveSpeedMulTo(1, 3);
				cLux_AddTodoMessage("Sound: Lev Sweetener Starts");
				Effect_Shake_Start(0.4, 0.25, 0.1, 1.0f);
				Audio_StartLeviathanChaseTunnel();
				
				Player_MoveHeadPos(cVector3f(0, 0.0, 0), 1, 1, 0.05f);
			
				Entity_SetActive("leviathan_1", true);
				//use random sweeteners until leviathan leaves tunnel, then his barkmachine turns on
				BarkMachine_SetActive("leviathan_1", false);
				Agent_SetSensesActive("leviathan_1", false);
				
				for(int i=1; i<=23; ++i)
					Pathfinder_Track_Add("leviathan_1", "TunnelChase_"+i);
				Pathfinder_Track_Start("leviathan_1");
				
				Leviathan_SetState_FollowTrack("leviathan_1");
				
				Leviathan_SetFollowTrackDeathMeter("leviathan_1", true, 1.0f);
				
				SlideDoor_SetClosed("wauexit_*", true);
				
				//CheckPoint_Setup("");
				
				CharMover_SetWallAvoidanceActive("leviathan_1", false);
			}
			
			Sequence_End();
		}
		
		
		//-------------------------------------------------------
		
		bool OnTriggerLeviathanEndDash(const tString &in asParent, const tString &in asChild, int alState)
		{
			Leviathan_SetSpeed_Hunt("leviathan_1");
			return true;
		}
			
		//-------------------------------------------------------
		
		bool OnPlayerLeaveChaseTunnel(const tString &in asParent, const tString &in asChild, int alState)
		{
			Audio_StopLeviathanChaseTunnel();
			return false;
		}
			
		//-------------------------------------------------------
		
		bool OnTriggerLeviathanOutOfTunnel(const tString &in asParent, const tString &in asChild, int alState)
		{
			//TODO: Change behavior of monster
			//TODO: If player dies in tunnel, make sure tunnel chase music and Audio_StopLeviathanChaseTunnel(); are called
			
			//Stop tunnel chase music and let A.I music take over
			Music_Stop(2.5f, eMusicPrio_SceneAmb);
			LeviathanAmbienceMusic(2.0f);
			
			Sound_CreateAtEntity("LeviathanEscapeTunnel", "04_03_tau_escape/SFX/leviathan_chase/leviathan_escapes_tunnel", "leviathan_1");
			
			Agent_SetSensesActive("leviathan_1", true);
			CharMover_SetWallAvoidanceActive("leviathan_1", true);
			BarkMachine_SetActive("leviathan_1", true);
			
			Pathfinder_Track_Stop("leviathan_1");
			Pathfinder_Track_Clear("leviathan_1");
			
			Leviathan_SetState_CirclePlayer("leviathan_1");
			
			//CheckPoint_Setup("");
			
			//Not used, but just letting be.
			AttackMeter_SetAttackerTeleportPosition("CP_Leviathan_Teleport_Hill_*");
			
			CharMover_SetWallAvoidanceActive("leviathan_1", true);
				
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void Timer_SetupLeviathanAfterKnockdown(const tString &in asTimer)
		{
			if (cLux_GetExplorationModeActive() == false) return;
			
			Player_Teleport("Start_OutOfTunnel");
			Agent_TeleportFeetToEntity("leviathan_1", "CP_Leviathan_Teleport_Hill_15");
			
			OnPlayerLeaveChaseTunnel("", "", 1);			
			OnTriggerLeviathanOutOfTunnel("", "", 1);
			
			cLux_AddDebugMessage("SETTING UP OUT OF TUNNEL!");
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerExitEscapeTunnel(const tString &in asParent, const tString &in asChild, int alState)
		{
			Leviathan_SetSpeed_HuntDash("leviathan_1");
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void Timer_RegenLowHealth(const tString&in asTimer)
		{
			if(Player_GetHealth() < 0.6f)
			{
				Player_AddHealth(0.0125f);
			}
			
			Map_RestartCurrentTimer(10);
		}
		
