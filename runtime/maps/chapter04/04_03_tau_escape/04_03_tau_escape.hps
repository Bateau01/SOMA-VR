		void HandAnimOver_PutIn(const tString&in asAnim)
		{
			//Music_Play("04_03_mindmess.ogg", 0.7, false, eMusicPrio_BigEvent);
			
			Effect_Rumble_Start(1.5, 6, 0, 3);
								
			PlayerHands_SetHandModel("character/player/hands/hands_deepsea_mutilated.ent");
					
			PlayerHands_PlayAnimation("player_wau_mouth_bitten_n_pull_out", false, true, 0,"", true,1,-1);
			PlayerHands_SetAnimationOverCallback("HandAnimOver_PullOut");
			
			Entity_PlayAnimation("04_03_wau_monster_mouth_1", "event_wau_mouth_bitten_n_pull_out", 0.1f, false,
								true, "WauMouth_AnimOver");	
			
			
			Emotion_StopHeartbeat(mlPutHandInHeatbeatId);
			mlPutHandInHeatbeatId = Emotion_StartHeartbeat(0.5, 1.0, 1);
					
			Effect_VideoDistortion_Start(1, 8, 0.1, 2);
			
			Player_SetMaxHealth(0.9f);
			Player_GiveDamage(0.4f, 0.6f, eDamageType_Hit, "");
				
			Map_AddTimer("PullOutBlood", 7.5f, "Timer_PullOutBlood");
		}
		
