		}

		//-------------------------------------------------------
		
		void TimerCheckExtProgressLights(const tString&in asTimer)
		{
			tString sLamp;
			iLuxEntity@ pArk = Map_GetEntity("DummyArk");
			cVector3f vArkPos = pArk.GetPosition();
			vArkPos.z-=0.25f*1.8f;
			pArk.SetPosition(vArkPos);
			
			for (int i = 1; Entity_Exists("LampExtProgress_"+i);i++)
			{
				sLamp = "LampExtProgress_"+i;
				cVector3f vPos = Map_GetEntity(sLamp).GetPosition();
				if (cMath_Abs(vPos.z-vArkPos.z)<3.0f)
				{
					Lamp_SetLit(sLamp,true,true);
				}
				else
				{
					Lamp_SetLit(sLamp,false,true);
				}
			}
				
			if (vArkPos.z>Map_GetEntity("DummyArkTarget").GetPosition().z)
				Map_AddTimer("TimerCheckExtProgressLights", 0.25f, "TimerCheckExtProgressLights");
		}

