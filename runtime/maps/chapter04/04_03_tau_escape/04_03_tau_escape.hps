		//-------------------------------------------------------
		
		bool mbEndAirlockActivated=false;

		//-------------------------------------------------------
		
		void OnChange_EntranceAirlockButton(const tString &in asEntity, int alState)
		{
			////////////////////////////////////////////
			// Using cath on entrance airlock
			Seq_AirlockEntranceDrain("");
			
			Entity_SetActive("ToolArea_AirlockEntrance",false);
			Entity_SetInteractionDisabled("AirlockEntranceControlPanel",true);
			
			Entity_SetActive("block_box_volatile_1", true);
		}
		
		//-------------------------------------------------------
		
		bool CathBox_OnPickUp(const tString &in asTool)
		{
			return true;
		}
		
		bool CathBox_CanBeUsed(const tString &in asTool, const tString &in asEntity)
		{
			if(asEntity=="AirlockEntranceControlPanel")
			{
				if(mbEndAirlockActivated) return false;
				return true;
			}
				
			return false;
		}

		//-------------------------------------------------------
		
		bool CathBox_OnUse(const tString &in asTool, const tString &in asEntity)
		{
			if(asEntity=="AirlockEntranceControlPanel")
			{
				mbEndAirlockActivated = true;
				CathTool_UseOnPanel(asTool, asEntity);
			}

			return false;
		}
		
		//-------------------------------------------------------	
		
		int mlDrainShakeID = -1;
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceEntranceAirlockDrain;
			
		void Seq_AirlockEntranceDrain(const tString &in asTimer)
		{
			Sequence_Begin("Seq_AirlockEntranceDrain", mSequenceEntranceAirlockDrain);
			
			if (Sequence_DoStepAndWait(10))
			{
				cLux_AddDebugMessage("Airlock activated");
				
				FogArea_SetVisible("Airlock1WaterFog", false);
				Entity_SetActive("Airlock1Water", true);
				
				SlideDoor_SetClosed("swingdoor_tau_large_1", true);
				Entity_SetActive("leviathan_1", false);
				Music_FadeVolumeMul(1.0,0.25f);

				Terminal_SetUpdateWhenOutOfView("AirlockEntranceControlScreen", true);
				
				Entity_SetVarString("AirlockEntranceControlScreen", "State", "AirlockPanelStatus_Draining");
			}
			else if (Sequence_DoStepAndWait(2.6))
			{
				PreloadDeload();
				
				//Sound
				cLux_AddDebugMessage("Airlock draining start in 2.5");
				Sound_CreateAtEntity("Intro_AirlockFlushingAlarm", "Entities_OceanBottom/airlock/alarms/draining_alarm", "StartingAirlockAlarmSoundSource", 0, true);
				Map_AddTimer("StartingAirlockAlarm", 1.0f, "StartingAirlockAlarmEmpty");
				
				Music_PlayExt("02_07_entergianthall", false, 0.95f, 1.0f, 0.0f, 0.0f, eMusicPrio_BigEvent, false);
				
				Entity_PlayAnimation("airlock_warning_lamp_entrance", "spin", 0, true, true);
				Lamp_SetLit("airlock_warning_lamp_entrance", true, true);
			}
			else if (Sequence_DoStepAndWait(7))
			{
				StartingAirlockEffectsFlushWater();
				Map_AddEnvironmentParticleClipArea("*", "Airlock1Water");
				LiquidArea_MoveLinearTo("Airlock1Water","Airlock1Water_Target_Drain",0.1, 0.5, 0.5, false);
				Terminal_SetImGuiStateFloat("AirlockEntranceControlScreen", "PressureMul", 1.0f);
				Terminal_FadeImGuiStateFloat("AirlockEntranceControlScreen", "PressureMul", 0.0f, 10);
				Effect_Shake_Start(0.005, 0, 0.1, 5);

				ParticleSystem_SetActive("airlock_1_drain_bubbles_oneshot", true);
				Sound_CreateAtEntity("Intro_AirlockFlushingBubblesSweet", "Entities_OceanBottom/airlock/uw/water/drain/large_bubbles_sweet", "Player", 0, true);
			}
			else if (Sequence_DoStepAndWait(5))
			{
				Effect_Shake_Start(0.0005, 0, 0.1, 5);
				ParticleSystem_Destroy("airlock_1_flood_effects_*");
			}
			else if (Sequence_DoStepAndWait(4))
			{
				mlDrainShakeID = Effect_Shake_Start(0.0025, -1, 1, 3, cVector3f_One, 4);
				ParticleSystem_SetActive("airlock_1_drain_effects_*", true);
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				cLux_AddDebugMessage("Map not underwater");
				Effect_Shake_FadeOut(mlDrainShakeID, 4);
				ParticleSystem_Destroy("airlock_1_drain_effects_3");
				ParticleSystem_Destroy("airlock_1_drain_effects_1");
			}
			else if (Sequence_DoStepAndWait(5))
			{
				ParticleSystem_Destroy("airlock_1_drain_effects_*");
			}
			else if(Sequence_DoStepAndWait(1.0f))
			{
				Entity_StopAnimation("airlock_warning_lamp_entrance");
		        Lamp_SetLit("airlock_warning_lamp_entrance", false, false);
				Map_RemoveTimer("StartingAirlockAlarm");
			}
			else if(Sequence_DoStepAndWait(1.5))
			{
				Light_SetVisible("PointLight_13_(Conflict_Present)", false);
				Light_SetVisible("PointLight_88", false);
				Light_SetVisible("airlock_1_flood_light_*", false);
				Lamp_SetLit("airlock_1_flood_lamp_*", false, false);
				Lamp_SetLit("airlock_1_lamp_*", true, true);
			}
			else if(Sequence_DoStepAndWait(0.0f))
			{
				Map_SetEnvironmentParticlesActive(false);
				PreloadChangeOfMap();
			}
			
			Sequence_End();
		}
			
		//-------------------------------------------------------
			
		void CollideAirLockWater(int alState)
		{
			cLux_AddDebugMessage("COLLIDE WATER AIRLOCK!");
			
			if(alState == -1)
			{
				Effect_DoF_Reset();
				Map_SetUnderwater(false);
				PreloadFadeGlobal();
			}
			else if(alState == 1)
			{
				Map_SetUnderwater(true);
			}
		}

		//-------------------------------------------------------
		
		void StartingAirlockAlarmEmpty(const tString &in asTimer)
		{
			Sound_CreateAtEntity("Intro_AirlockFlushingAlarm", "Entities_OceanBottom/airlock/alarms/draining_alarm", "StartingAirlockAlarmSoundSource", 0, true);
			Map_AddTimer("StartingAirlockAlarm", 1.0f, "StartingAirlockAlarmEmpty");
		}
		
	void StartingAirlockEffectsFlushWater()
	{
		Depth_Audio_AirlockDrainLeadInUW();
		Depth_Audio_AirlockDrainLoopUW();
		Map_AddTimer("StartingAirlockAirlockDrainUWStopTimer", 11.f, "StartingAirlockDrainUWStop");
		
		//Sweetener and mixer
		Sound_CreateAtEntity("StartingDrainingSweetenerUW", "04_02_tau_inside/SFX/airlock_start/draining_sweet_uw", "Player", 2.0f);
		Sound_FadeGlobalVolume(0.7, 3.0f);
	}
 
    //-------------------------------------------------------
	
	void StartingAirlockDrainUWStop(const tString &in asTimer)
	{
		Entity_SetActive("AMB_StartingAirlock_UW", false);
		Entity_SetActive("AMB_StartingAirlock_Air", true);
		Entity_SetActive("AMB_GlobalTunnels", true);
		Sound_Stop("StartingAirlockPumpUW", 0.55f);
		Sound_Stop("StartingDrainingSweetenerUW", 1.0f);
		Depth_Audio_PlayLeaveWater();
		Sound_CreateAtEntity("StartingAirlockPumpingAirLoop", "Entities_OceanBottom/airlock/air/pump/pump_loop_nointro", "PumpsSource_Start", 0.55f, false, 1.0f);
		Depth_Audio_AirlockDrainLoopUWStop();
		Depth_Audio_AirlockDrainLoopAir();
		Map_AddTimer("StartingAirlockDrainingAirStopTimer", 5.0f, "StartingAirlockDrainingAirStop");
		
		//Sweetener
		Sound_CreateAtEntity("StartingAirlockDrainingSweetenerAir", "04_02_tau_inside/SFX/airlock_start/draining_sweet_air", "Player");
		Sound_Stop("StartingAirlockDrainingSweetenerUW", 2.0f);
	}
	 
    //-------------------------------------------------------
	
	void StartingAirlockDrainingAirStop(const tString &in asTimer)
	{
		Depth_Audio_AirlockDrainLoopAirStop();
		Depth_Audio_AirlockDrainLeadOutAir();
		Sound_Stop("StartingAirlockPumpingAirLoop", 0.25f);
		Sound_CreateAtEntity("StartingAirlockPumpAirLeadOut", "Entities_OceanBottom/airlock/air/pump/pump_end", "PumpsSource_Start", 0.0f, false, 1.0f);
		Sound_CreateAtEntity("StartingAirlockPumpAirIdle", "Entities_OceanBottom/airlock/air/pump/idle_loop", "PumpsSource_Start", 0.0f, false, 1.0f);
		Sound_FadeGlobalVolume(1.0, 3.0f);
	}
	 
    //-------------------------------------------------------
	
	void StartingAirlockEffectsFillWithWater()
	{
		Depth_Audio_AirlockFillingLeadInAir();
		Depth_Audio_AirlockFillingLoopAir();
		Map_AddTimer("StartingAirlockFillingAirStopTimer", 10.5f, "StartingAirlockFillingAirStop");
	}
	 
    //-------------------------------------------------------
	
	void StartingAirlockFillingAirStop(const tString &in asTimer)
	{
		Depth_Audio_AirlockFillingLoopAirStop();
		Depth_Audio_AirlockFillingLoopUW();
		
		///////////////////
		//Pump Sounds
		Sound_Stop("StartingAirlockPumpingAirLoop", 0.5f);
		Sound_CreateAtEntity("StartingAirlockPumpUW", "Entities_OceanBottom/airlock/uw/pump/pump_loop_nointro", "PumpsSource_Start", 0.0f, false, 1.0f);
		Map_AddTimer("StartingAirlockFillingLoopUWStopTimer", 5.0f, "StartingAirlockFillingLoopUWStop");
	}
	 
    //-------------------------------------------------------
	
	void StartingAirlockFillingLoopUWStop(const tString &in asTimer)
	{
		Depth_Audio_AirlockFillingLoopUWStop();
		Depth_Audio_AirlockFillingLeadOutUW();
		
		///////////////////
		//Pump Sounds
		Sound_CreateAtEntity("StartingAirlockPumpUWLeadOut", "Entities_OceanBottom/airlock/uw/pump/pump_end", "PumpsSource_Start", 0.0f, false, 1.0f);
		Sound_Stop("StartingAirlockPumpUW", 0.5f);	
	}
	
	//-------------------------------------------------------
 
    /////////////////////////////////////////
    // ==============
    // PRELOAD
    // ==============
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	bool PreloadDisabled(bool abCheckIfPreloading = true)
	{
		if(cLux_ScriptDebugOn())
		{
			cLux_AddDebugMessage("PRELOAD DISABLED!"); 
			
			return true;
		}

		if(abCheckIfPreloading == true && Map_IsPreloading() == false)
			return true;
			
		return false;
	}
	
	//-------------------------------------------------------
	
	void Preload()
	{
		if(PreloadDisabled(false)) return;
		
		Map_Preload("05_01_phi_inside.hpm");
	}
	
	//-------------------------------------------------------
	
	void PreloadDeload()
	{
		if(PreloadDisabled()) return;
		
		Map_Deload("transfer4351");
	}
	
	//-------------------------------------------------------
	
	void PreloadFadeGlobal()
	{
		Map_AddTimer("FadeGlobal", 0.1, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	
	void PreloadChangeOfMap()
	{
		if(PreloadDisabled()) 
		{
			PreloadManualChangeMap();
			return;
		}
		
		Map_AddTimer("ChangeMap", 0, "PreloadTimer");
		Map_AddTimer("ChangeMapNotReady", 5, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	
	bool mbGlobalCopyCompleted = false;
	void PreloadTimer(const tString &in asTimer)
	{
		////////////////////////////
		//Preload - Change map globals when possible.
		if(asTimer == "FadeGlobal")
		{
			if(mbGlobalCopyCompleted)
			{
				Map_Preset_Fade("Preset5.1", 0.1); 
				return;
			}
			
			mbGlobalCopyCompleted = Map_CopyGlobalSettings(Map_GetPreloadMap(), 0.1);
			
			Map_AddTimer("FadeGlobal", 0.2, "PreloadTimer");
		}

		////////////////////////////
		//Preload - Change map when possible
		if(asTimer == "ChangeMap")
		{
			if(Map_IsPreloadCompleted())
			{
				Entity_SetActive("DoorAirlockEntrance_Innerx", false);
				Entity_SetActive("swingdoor_tau_large_1", false);
				Entity_SetActive("airlock_1_flood_lamp_*", false);

				Description_SetForceFading(true);
				cScript_SetGlobalVarBool("PlayerLostHand", mbPlayerLostHand);
				Map_ChangeMap("05_01_phi_inside.hpm", "", "transfer4351", "", "");
			}
			else Map_AddTimer("ChangeMap", 0.6f, "PreloadTimer");
		}
		
		if(asTimer == "ChangeMapNotReady")
		{
			Description_Add("02_05_theta_inside", "ScanRoom_Legacy_Loading", 10, false);
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
		}
	}

	//-------------------------------------------------------
	
	void PreloadManualChangeMap()
	{
		cScript_SetGlobalVarBool("PlayerLostHand", mbPlayerLostHand);
		Map_ChangeMap("05_01_phi_inside.hpm","PlayerStartArea_1" ,"","");
	}
	
	
		//-------------------------------------------------------
		
		//} END *Open Airlock and Enter*

		/////////////////////////////////////////
		// Event D *Walk off path; danger increases*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		//int mlBoundaryDistortionID = -1;
		
		bool OnBoundaryCollision(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (SequenceStates_IsActive("SequenceOutOfBoundsAttack")) return true;
			
			/////////////////////////////
			// Starting to leave path
			if (alState == -1)
			{	
				cLux_AddDebugMessage("Starting to leave path");
			
				Player_FadeMoveSpeedMulTo(0.75f, 10.0f);
				if (!Map_TimerExists("TimerBounds"))
				{
					Map_AddTimer("TimerBounds",5.0f,"TimerBounds");
				}
				return true;
			}
			/////////////////////////////
			// Get back on track
			else
			{
				
			}
			
			if (Map_TimerExists("TimerBounds"))
				Map_RemoveTimer("TimerBounds");
			return true;
		}
		
