		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 3 Event L *Encounter locked up flesher*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void OnChangeMaintenanceButton(const tString &in asEntity, int alState)
		{
			OnChangeDoorButton(asEntity, alState);
		}
		
		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 3 Event M *Use cargo elevator*
		//{///////////////////////////////////////
        
        int mlElevatorSoundControl;
        
        bool ElevatorSoundAreaControl(const tString &in asParent, const tString &in asChild, int alState)
        {
            if (alState != 1) return true;
            
            
            if(asChild=="ElevatorSoundArea_1")
            {
                mlElevatorSoundControl = 1;
            }
            
            if(asChild=="ElevatorSoundArea_2")
            {
                mlElevatorSoundControl = 2;
            }
            
            if(asChild=="ElevatorSoundArea_3")
            {
                mlElevatorSoundControl = 3;
            }
            cLux_AddDebugMessage("Elevator Sound Area is "+mlElevatorSoundControl);
            return true;
        }

		//-------------------------------------------------------
		
		array<tString> mvElevatorEntities;
		int mlCargoElevatorFloor = 1;
		int mlTargetElevatorFloor = 1;
		bool mbElevatorDrained = false;
		tString mElevatorButtonPressed;

		//-------------------------------------------------------
		
		void OnChangeElevatorButton(const tString &in asEntity, int alState)
		{	
			mElevatorButtonPressed = asEntity;	
			if (alState == -1) return;
			
			Sound_CreateAtEntity("ButtonPress", "Entities_Station/object/tau_elevator/button/big_press", asEntity);
			int lPos = Entity_GetVarInt(asEntity, "");
			
			if (lPos== 2 && mbElevatorDrained)
			{
				Map_AddTimer(asEntity, 0.4, "TimerSetMovingButtonOff");
				return;
			}
			
			if (mlCargoElevatorFloor == lPos)
			{
				Depth_Audio_Terminal_Negative(asEntity);
				return;
			}
			
			MoveElevatorToFloor(lPos);
		}

		//-------------------------------------------------------
		
		void OnChange_ElevatorFloorButton(const tString &in asEntity, int alState)
		{
			if (alState == -1) return;
			
			mElevatorButtonPressed = asEntity;
			
			int lPos = Entity_GetVarInt(asEntity, "");
			int lTargetFloor = cString_GetNumericSuffixInt(asEntity);
			
			if (lPos== 2 && mbElevatorDrained)
			{
				return;
			}
			
			if (Entity_GetCollide("Player", "CargoElevatorArea_"+lPos))
			{
				Depth_Audio_Terminal_Negative(asEntity);
				return;
			}
			
			MoveElevatorToFloor(lTargetFloor);
		}

		//-------------------------------------------------------
		
		void MoveElevatorToFloor(int alFloor)
		{
			if (mlCargoElevatorFloor == alFloor)
			{
				return;
			}
			
			mlTargetElevatorFloor = alFloor;
			
			if (Map_TimerExists("Timer_MoveElevator")==false)
			{
				Timer_MoveElevator("Timer_MoveElevator");
				Sound_CreateAtEntity("CallElevator", "Entities_Station/object/tau_elevator/button/call", mElevatorButtonPressed);
				Sound_CreateAtEntity("ElevatorFirstStart", "Entities_Station/object/tau_elevator/motor/first_start", "ElevatorSoundSource");
			}
				
		}

		//-------------------------------------------------------
		
		eElevatorState mElevatorState = eElevatorState_Open;
		bool mbElevatorInMotion = false;
		
		void Timer_MoveElevator(const tString &in asTimer)
		{
			if (mElevatorState==eElevatorState_Opening)
			{
				Map_AddTimer(asTimer, 0.2, "Timer_MoveElevator");
			}
			else if (mElevatorState==eElevatorState_Open)
			{
				Entity_SetActive("CargoElevatorBlockbox_*", true);
				SetCargoElevatorDoorOpen(mlCargoElevatorFloor, false, false);
				Map_AddTimer(asTimer, 0.2, "Timer_MoveElevator");
			}
			else if (mElevatorState==eElevatorState_Closing)
			{
				Map_AddTimer(asTimer, 0.2, "Timer_MoveElevator");
			}
			else if (mElevatorState==eElevatorState_Closed)
			{
				if (mlTargetElevatorFloor > mlCargoElevatorFloor)
				{
					cLux_AddTodoMessage("Sound: Cargo elevator rising from floor no "+mlCargoElevatorFloor);
					if(mbElevatorInMotion==false)
					{
						cLux_AddDebugMessage("Elevator Sound Starting");
						Sound_CreateAtEntity("ElevatorStart", "Entities_Station/object/tau_elevator/motor/start", "ElevatorSoundSource");
						Sound_CreateAtEntity("ElevatorLoop", "Entities_Station/object/tau_elevator/motor/loop", "ElevatorSoundSource", 0, false);
						mbElevatorInMotion = true;
					}
				}
				else
				{
					cLux_AddTodoMessage("Sound: Cargo elevator descending.");
					if(mbElevatorInMotion==false)
					{
						Sound_CreateAtEntity("ElevatorStart", "Entities_Station/object/tau_elevator/motor/start", "ElevatorSoundSource");
						Sound_CreateAtEntity("ElevatorLoop", "Entities_Station/object/tau_elevator/motor/loop", "ElevatorSoundSource", 0, false);
						mbElevatorInMotion = true;
					}
				}
					
				mElevatorState = eElevatorState_Moving;
				
				Map_AddTimer(asTimer, 3.0f, "Timer_MoveElevator");
				int lDir = cMath_Sign(mlTargetElevatorFloor-mlCargoElevatorFloor);
				Prop_MoveLinearTo("ElevatorSoundSource", "ElevatorSoundSource_Target_" + (mlCargoElevatorFloor+lDir), 12, 3, 0.5, true, "");
				
				Map_RemoveTimer("ElevatorCloseCancel_"+mlCargoElevatorFloor);
				
				return;
			}
			else if (mElevatorState == eElevatorState_Moving)
			{
				int lDir = cMath_Sign(mlTargetElevatorFloor-mlCargoElevatorFloor);
				int lNextFloor = mlCargoElevatorFloor+lDir;
				SetElevatorFloor(lNextFloor, lNextFloor==mlTargetElevatorFloor);
				
				if (mlCargoElevatorFloor!=mlTargetElevatorFloor)
				{
					Map_AddTimer(asTimer, 3.0, "Timer_MoveElevator");
					Prop_MoveLinearTo("ElevatorSoundSource", "ElevatorSoundSource_Target_" + (mlCargoElevatorFloor+lDir), 12, 3, 0.5, true, "");
				}
				else
				{
					Entity_SetActive("CargoElevatorBlockbox_*", false);
				}
			}
		}

		//-------------------------------------------------------
		
		void SetElevatorFloor(int alFloor, bool abOpenDoor)
		{
			for (int i = 1; i <= 3; i++)
			{
				SetCargoElevatorDoorOpen(i, false, true, false);
				
				Entity_SetEffectsActive("CargoElevatorFloorLamp_1_"+i, i==alFloor, true);
				Entity_SetEffectsActive("CargoElevatorFloorLamp_2_"+i, i==alFloor && mbElevatorDrained==false, true);
				Entity_SetEffectsActive("CargoElevatorFloorLamp_3_"+i, i==alFloor, true);
			}
			
			////////////////////////////////////////
			// Get all entities in the elevator
			array<iPhysicsBody@> vBodies;
			array<tID> vMovedEntities;
			iLuxEntity@ pArea = Map_GetEntity("CargoElevatorArea_"+mlCargoElevatorFloor, eLuxEntityType_Area);
			cBoundingVolume boundingVolume = pArea.GetBody(0).GetBoundingVolume();
			cLux_GetCurrentMap().GetPhysicsWorld().GetBodiesInAABB(boundingVolume.GetMin(), boundingVolume.GetMax(), vBodies);
			
			for (int i = 0; i < vBodies.length(); i++)
			{
				// Get the entity from the body
				iPhysicsBody @pBody = vBodies[i];
				if(pBody.IsActive()==false) continue;
				iLuxEntity @pEntity = cLux_GetBodyEntity(pBody);
				if(pEntity == null) continue;
				tString sEntityName = pEntity.GetName();
				
				// Skip invalid entities
				if (pBody.GetMass()==0 && sEntityName != "ARK") continue;
				if (Entity_GetVarString(sEntityName, "") == "ElevatorDoor") continue;
				if (Entity_GetCollide(sEntityName, "CargoElevatorArea_"+mlCargoElevatorFloor)==false) continue;
				
				// Check for duplicates so we don't move the same entity multiple times
				bool bDuplicate = false;
				for (int j = 0; j < vMovedEntities.length(); j++)
				{
					if (vMovedEntities[j] == pEntity.GetID())
					{
						bDuplicate = true;
						break;
					}
				}
				if (bDuplicate) continue;
				
				// Move to correct floor
				cVector3f vOffset = Entity_GetDeltaToEntity("CargoElevatorArea_"+mlCargoElevatorFloor, pEntity.GetName());
				Entity_PlaceAtEntity(pEntity.GetName(), "CargoElevatorArea_"+alFloor, vOffset, false);
				vMovedEntities.push_back(pEntity.GetID());
			}
			
			if (abOpenDoor)
			{
				SetCargoElevatorDoorOpen(alFloor, true);
			}
			
			mlCargoElevatorFloor = alFloor;
		}

		//-------------------------------------------------------
		tString sElevatorDoor;
		void SetCargoElevatorDoorOpen(int alFloor, bool abOpen, bool abInstant=false, bool abChangeElevatorState = true)
		{
			tString sDoor = "CargoElevatorDoor_"+alFloor;
			sElevatorDoor = "CargoElevatorDoor_"+alFloor;
			
			bool bCurrentlyOpen = Entity_GetVarBool(sDoor, "Open");
			if (bCurrentlyOpen == abOpen && abInstant==false)
				return;
			
			if (abOpen)
			{
				Entity_SetVarBool(sDoor, "Open", true);
				if (abInstant)
				{
					if (abChangeElevatorState) mElevatorState = eElevatorState_Open;
					Entity_PlayAnimation(sDoor, "opening", 0);
					Entity_SetAnimationRelativeTimePosition(sDoor, "opening", 1);
					SlideDoor_SetClosed(sDoor, false, true);
				}
				else
				{
					Map_AddTimer(sDoor, 0.2, "Timer_DoorOpenTest");
					//Add slight delay to door opening if elevator motor was running to allow for cooldown/pacing
					if(mbElevatorInMotion==true)
					{
						cLux_AddDebugMessage("Elevator stopped");
						Sound_Stop("ElevatorLoop",0.25f);
						Sound_CreateAtEntity("ElevatorStop", "Entities_Station/object/tau_elevator/motor/stop", "ElevatorSoundSource");
						Sound_CreateAtEntity("ElevatorArrive", "Entities_Station/object/tau_elevator/button/arrive", mElevatorButtonPressed); 
						Map_AddTimer("CargoDoorOpening", 1.5f, "TimerCargoElevatorDoorOpening");
						mbElevatorInMotion = false;
					}
					else
					{
						Map_AddTimer("CargoDoorOpening", 0.25f, "TimerCargoElevatorDoorOpening");
					}
				}
			}
			else
			{
				Entity_SetVarBool(sDoor, "Open", false);
				SlideDoor_SetClosed(sDoor, true, abInstant);
				
				if (abInstant)
				{
					if (abChangeElevatorState) mElevatorState = eElevatorState_Closed;
					Entity_PlayAnimation(sDoor, "closing", 0);
					Entity_SetAnimationRelativeTimePosition(sDoor, "closing", 1);
					SlideDoor_SetClosed(sDoor, true, true);
				}
				else
				{					
					if (abChangeElevatorState) mElevatorState = eElevatorState_Closing;
					Map_AddTimer(sDoor, 1.5, "TimerCargoElevatorClose");
					Map_AddTimer("ElevatorCloseCancel_"+alFloor, 4, "Timer_CargoElevatorCloseRetryCheck");
				
					Entity_SetInteractionDisabled("CargoElevatorButton_"+alFloor, true);
					Entity_SetInteractionDisabled("CargoElevatorFloorLamp_"+alFloor+"_"+alFloor, true);
					Map_AddTimer("CargoElevatorButton_"+alFloor, 2, "TimerSetInteractionEnabled");
					Map_AddTimer("CargoElevatorFloorLamp_"+alFloor+"_"+alFloor, 2, "TimerSetInteractionEnabled");
					
                    if(mlElevatorSoundControl == mlCargoElevatorFloor)
                    {
                        Sound_CreateAtEntity("ElevatorOpen_"+sDoor, "Entities_Station/object/tau_elevator/door/close", sDoor);
                    }
                    else if (mlElevatorSoundControl != mlCargoElevatorFloor)
                    {
                        Sound_CreateAtEntity("ElevatorOpen_"+sElevatorDoor, "Entities_Station/object/tau_elevator/door/dist/close", sElevatorDoor);
                        Sound_CreateAtEntity("ElevatorOpenSweet_"+sElevatorDoor, "Entities_Station/object/tau_elevator/door/dist/close_sweet", "CargoElevatorDoor_"+mlElevatorSoundControl);
                    }
				}
			}
		}
		
		//-------------------------------------------------------
		
		void TimerCargoElevatorDoorOpening(const tString &in asTimer)
		{
			mElevatorState = eElevatorState_Opening;
			Entity_PlayAnimation(sElevatorDoor, "opening");
			Map_AddTimer(sElevatorDoor, 1, "TimerCargoElevatorOpen");
					
			Entity_SetInteractionDisabled("CargoElevatorButton_"+mlCargoElevatorFloor, true);
			Entity_SetInteractionDisabled("CargoElevatorFloorLamp_"+mlCargoElevatorFloor+"_"+mlCargoElevatorFloor, true);
			Map_AddTimer("CargoElevatorButton_"+mlCargoElevatorFloor, 2, "TimerSetInteractionEnabled");
			Map_AddTimer("CargoElevatorFloorLamp_"+mlCargoElevatorFloor+"_"+mlCargoElevatorFloor, 2, "TimerSetInteractionEnabled");
			
            if(mlElevatorSoundControl == mlCargoElevatorFloor)
            {
                Sound_CreateAtEntity("ElevatorOpen_"+sElevatorDoor, "Entities_Station/object/tau_elevator/door/open", sElevatorDoor);
            }
            else if (mlElevatorSoundControl != mlCargoElevatorFloor)
            {
                Sound_CreateAtEntity("ElevatorOpen_"+sElevatorDoor, "Entities_Station/object/tau_elevator/door/dist/open", sElevatorDoor);
                Sound_CreateAtEntity("ElevatorOpenSweet_"+sElevatorDoor, "Entities_Station/object/tau_elevator/door/dist/open_sweet", "CargoElevatorDoor_"+mlElevatorSoundControl);
            }
			
		}

		//-------------------------------------------------------
		
		void TimerCargoElevatorOpen(const tString &in asTimer)
		{
			SlideDoor_SetClosed(asTimer, false);
			Map_AddTimer(asTimer, 0.5, "Timer_CargoElevatorOpen_SetState");
		}
		
		void Timer_CargoElevatorOpen_SetState(const tString &in asTimer)
		{
			if (SlideDoor_GetOpenAmount(asTimer) > 0.95)
			{
				mElevatorState = eElevatorState_Open;
				cLux_AddDebugMessage("Timer_CargoElevatorOpen_SetState");
				return;
			}
			Map_AddTimer(asTimer, 0.2, "Timer_CargoElevatorOpen_SetState");
		}

		//-------------------------------------------------------
		
		void TimerCargoElevatorClose(const tString &in asTimer)
		{
			if (SlideDoor_GetOpenAmount(asTimer) > 0.05)
			{
				Map_AddTimer(asTimer, 0.1, "TimerCargoElevatorClose");
				return;
			}
			Entity_PlayAnimation(asTimer, "closing");
			Map_AddTimer(asTimer, 1, "Timer_CargoElevatorClose_SetState");
		}
		
		void Timer_CargoElevatorClose_SetState(const tString &in asTimer)
		{
			mElevatorState = eElevatorState_Closed;
		}
		
		void Timer_CargoElevatorCloseRetryCheck(const tString &in asTimer)
		{
			tString sDoor = "CargoElevatorDoor_" + cString_GetNumericSuffixInt(asTimer);
			
			float fDoorOpenAmount = SlideDoor_GetOpenAmount(sDoor);
			if (fDoorOpenAmount <= 0.05) return;
			
			SlideDoor_SetOpenAmount(sDoor, cMath_Min(fDoorOpenAmount+0.5, 1.0f));
			mElevatorState = eElevatorState_Opening;
			
			Map_AddTimer(sDoor, 2, "Timer_CargoElevatorCloseRetry");
		}
		
		void Timer_CargoElevatorCloseRetry(const tString &in asTimer)
		{
			int alFloor = cString_GetNumericSuffixInt(asTimer);
			SlideDoor_SetClosed(asTimer, true);
			Map_AddTimer("ElevatorCloseCancel_"+alFloor, 4, "Timer_CargoElevatorCloseRetryCheck");
		}
		
		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 3 Event N *Drain wau flowers*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void EnergyDrainedElevator(const tString &in asEntity)
		{			
			Seq_ElevatorFlowerDrained("");
		}

		//-------------------------------------------------------
		
		cSequenceStatesData mElevatorFlowerDrainedSequence;
		void Seq_ElevatorFlowerDrained(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ElevatorFlowerDrained", mElevatorFlowerDrainedSequence);
				
			if (Sequence_DoStepAndWait(4))
			{
				mbElevatorDrained = true;
			}
			else if (Sequence_DoStepAndWait(1))
			{
				ParticleSystem_CreateAtEntity("ElevatorPanelSpark", "elec_spark_physics_oneshot.ps", "ElevatorBreakdownSpark", false);
				Sound_CreateAtEntity("ElevatorPanelSparkSound", "01_02_upsilon_inside_02/sfx/flower_bulb_break", "ElevatorBreakdownSpark");
				
				Entity_SetEffectsActive("CargoElevatorFloorLamp_2_*", false, false);
				Sound_Play("elevator_broken_spot", 1.0f);
				ParticleSystem_SetActive("ElevatorBrokenSmoke_*", true);
			}
			Sequence_End();
		}

		//-------------------------------------------------------
		
		void EnergyDrainedCorpse(const tString &in asEntity)
		{
			Prop_SetStaticPhysics("FlowerCorpse", false);
			Entity_AddForce("FlowerCorpse", 1, false, false);
			Entity_SetInteractionDisabled("FlowerCorpse", false);
			
			Entity_SetActive("ArkCrewMemberProximity_2", false);
			Map_RemoveTimer("ArkCrewMemberProximity_2");
			Voice_Stop("Ivashkin");
			Voice_Play("3_CrewMember_2_Drained");
			
		}

		//-------------------------------------------------------
		
		void InteractDatamineFlowerGuy(const tString &in asEntity)
		{
			Entity_CallEntityInteract("FlowerGuyDatamine");
		}
		
		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 3 Event O *Ross whispers*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		bool Trigger_PlayerInLivingArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Map_AddTimer("Timer_PlayRossWhisper", cMath_RandRectf(5, 20), "Timer_PlayRossWhisper");
			}
			return true;
		}
		
		//-------------------------------------------------------
		bool mbRossWhisperMusic = false;
		void Timer_PlayRossWhisper(const tString &in asTimer)
		{
			if (Entity_GetCollide("Player", "InsideLivingArea")==false)
				return;
				
			if (Voice_AnySceneIsActive())
			{
				Map_AddTimer("Timer_PlayRossWhisper", 2, "Timer_PlayRossWhisper");
				return;
			}
			
			Voice_Play("3_RossWhisper", -1, "VoiceOver_RossWhisper");
			RossSightingSweetSound(true);
			
			if (Voice_AnySceneIsActive())
				Effect_VideoDistortion_Start(0.6, 2, 1,1,0.5f);
		}
		
		void VoiceOver_RossWhisper(const tString&in asScene, const tString&in asSubject)
		{
			Map_AddTimer("Timer_PlayRossWhisper", cMath_RandRectf(20, 30), "Timer_PlayRossWhisper");
			
			if(mbRossWhisperMusic==false)
			{
				Music_Play("03_02_flesherspook04", 0.55, false, eMusicPrio_MinorEvent);
				mbRossWhisperMusic = true;
			}
		}
		
		//} END EVENT
	
	//} END SCENE 3

