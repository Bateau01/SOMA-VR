		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbRossEnterGlitchActivated = false;

		//-------------------------------------------------------
		
		bool Trigger_PlayerInStartCorridor(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				cLux_AddDebugMessage("Cancel entering");
				Map_RemoveTimer("FlesherEntersTimer");
			}
			else
			{
				cLux_AddDebugMessage("Prepare entering");
				Map_AddTimer("FlesherEntersTimer", 3, "TimerFlesherEnters");
			}
			return true;
		}

		//-------------------------------------------------------
		
		void TimerFlesherEnters(const tString &in asTimer)
		{
			cLux_AddDebugMessage("ENTER");
			SlideDoor_SetClosed("AirlockDoor_1", false);
			Entity_SetActive("RossEnterBlocker_*", true);
			Entity_SetActive("FlesherEntersBaseCheck", false);
			Map_AddTimer("Timer_RossEnterGlimpse", 8.0f, "Timer_RossEnterGlimpse");
			
			if (Entity_IsInteractedWith("MapTerminal"))
			{
				Map_AddTimer("MapTerminal", 1, "Timer_TriggerRossEnterGlitch");
				mbRossEnterGlitchActivated = true;
			}
			else
			{
				Terminal_SetEnterCallback("MapTerminal", "OnGuiEnter_RossEnterGlitch");
			}
			
			if (Entity_IsInteractedWith("ReactorControlTerminal"))
			{
				Map_AddTimer("ReactorControlTerminal", 1, "Timer_TriggerRossEnterGlitch");
				mbRossEnterGlitchActivated = true;
			}
			else
			{
				Terminal_SetEnterCallback("ReactorControlTerminal", "OnGuiEnter_RossEnterGlitch");
			}
			
			if(mbFlesherEnterInSight==true)
			{
				Sound_CreateAtEntity("RossEnters", "04_02_tau_inside/SFX/ross_airlock/ross_enters_tau", "Player");
				Map_AddTimer("RossEnterOver", 8.5f, "RossEnterOver");
				Sound_FadeGlobalVolume(0.45f, 2.5f);
				//cSound_FadeHighPassFilter(3000.0f, 0.0f, 5.0f, eSoundEntryType_World);
			}
		}
		
		//-------------------------------------------------------
		
		void Timer_RossEnterGlimpse(const tString &in asTimer)
		{
			if (Entity_GetDeltaToEntity("Player", "FlesherGlimpsePos_AirlockDoor").Length() < 4)
				return;
			
			StartFlesherEncounter("AirlockDoor", 7.5f, 1.5f, true);
		}
		
		//-------------------------------------------------------
		
		void RossEnterOver(const tString &in asTimer)
		{
			Sound_FadeGlobalVolume(1.0f, 5.0f);
			Entity_SetActive("RossEnterBlocker_*", false);
			//cSound_FadeHighPassFilter(0.0f, 0.0f, 5.0f, eSoundEntryType_World);
		}

		//-------------------------------------------------------
		
		void OnGuiEnter_RossEnterGlitch(const tString&in asEntityName)
		{
			if (mbRossEnterGlitchActivated) return;
			
			Map_AddTimer(asEntityName, 1, "Timer_TriggerRossEnterGlitch");
			mbRossEnterGlitchActivated = true;
		}

		//-------------------------------------------------------
		
		void Timer_TriggerRossEnterGlitch(const tString &in asTimer)
		{
			Terminal_SetImGuiStateFloat(asTimer, "TriggerGlitches", 1.25);
		}
		
		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 1 Event H *Squeeze through bulkhead*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		//} END EVENT
		
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 1 Event I *Flesher encounters (dialog)*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void LookAtFlesherSpawnPos(const tString &in asEntity, int alState)
		{
			Entity_SetVarBool(asEntity, "LookedAt", alState==1);
		}

		//-------------------------------------------------------
		
		bool FlesherEncounterAllowed(const tString &in asPos, bool abAllowInView)
		{
			if (Entity_IsActive("Flesher_1") || Map_GetTimerTime("FlesherEncounterDelay")>0)
			{
				cLux_AddDebugMessage("Enocunter allowed in: "+Map_GetTimerTime("FlesherEncounterDelay") );
				return false;
			}
			
			if (abAllowInView==false && Entity_GetVarBool("FlesherGlimpsePos_"+asPos, "LookedAt"))
			{
				cLux_AddDebugMessage("Skipping encounter, player looking at spawn pos.");
				return false;
			}
			
			return true;
		}

		//-------------------------------------------------------
		
		bool StartFlesherEncounter(const tString &in asPos, float afTimeoutTime=7.5f, float afLookAtTime=1.5f, bool abAllowInView=false)
		{
			if (FlesherEncounterAllowed(asPos, abAllowInView)==false) return false;
			
			Entity_SetActive("Flesher_1", true);
			BarkMachine_SetActive("Flesher_1", false);
			
			Pathfinder_Stop("Flesher_1");
			CharMover_StopTurning("Flesher_1");
			
			Entity_PlaceAtEntity("Flesher_1", "FlesherGlimpsePos_"+asPos);
			Agent_FaceEntity("Flesher_1", "FlesherGlimpseLookAt_"+asPos);
			
			cLux_AddDebugMessage("Trying FlesherGlimpsePos_"+asPos);
			
			Entity_SetVarFloat("Flesher_1", "LookAtTime", afLookAtTime);				
			Map_AddTimer("TimeoutFlesherGlimpseTimer", afTimeoutTime, "TimerDeactivateFlesherGlimpse");
			
			return true;
		}

		//-------------------------------------------------------
		
		bool StartFlesherWalkEncounter(const tString &in asPos, float afTimeoutTime=20, float afLookAtTime=1.5f, bool abAllowInView=false)
		{
			if (StartFlesherEncounter(asPos, afTimeoutTime, afLookAtTime, abAllowInView)==false) 
				return false;
			
			TimerUpdateFlesherWalkEvent("Flesher_1");
			
			return true;
		}

		//-------------------------------------------------------
		
		void TimerDeactivateFlesherEncounter(const tString &in asTimer)
		{		
			RossFlesher_Disappear("Flesher_1");
			if (Entity_GetCollide("Player", "RossProximity"))
			{
				Sound_CreateAtEntity("RossDisappear", "04_03_tau_escape/SFX/ross/ross_disappear_quick", "Player");
				Sound_CreateAtEntity("RossDisappearSpook", "level_amb_shared_underwater/amb/spots/scary/eerie_tone_01_oneshot", "Player");
				Sound_FadeGlobalVolume(1.0f, 3.0f);
			}

			Map_AddTimer("FlesherEncounterDelay", 20, "");
			Map_AddTimer("Timer_RossLookAtSoundStop", 0.5, "Timer_RossLookAtSoundStop");
			 
		}
		
		//-------------------------------------------------------
		
		bool RossProximity(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState==1)
			{
				cLux_AddDebugMessage("Prox with Flesher");
			}
			else
			{
				cLux_AddDebugMessage("Not prox with Flesher");
			}
			
			return true;
		}

		//-------------------------------------------------------
		
		bool Trigger_StartFlesherGlimpseOneWay(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1 || Entity_PlayerIsInFront(asChild)==false)
				return true;
			
			return Trigger_StartFlesherGlimpse(asParent, asChild, 1);
		}

		//-------------------------------------------------------

		bool Trigger_StartFlesherGlimpse(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==-1) return true;
			cLux_AddDebugMessage("Trigger_StartFlesherGlimpseOneWay");
			
			tString sPos = Entity_GetVarString(asChild, "");
			if (StartFlesherEncounter(sPos, 7.5, 0.5f)==false) return true;
			
			return false;
		}

		//-------------------------------------------------------
		
		bool Trigger_StartFlesherGlimpse_LivingAreaRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (Trigger_StartFlesherGlimpse(asParent, asChild, alState)==true)
				return true;
				
			
			// Only allow the flesher to appear outside the rooms once.
			Entity_SetActive("FlesherGlimpseTrigger_LivingAreaRoom_*", false);
			
			return false;
		}

		//-------------------------------------------------------
		
		void LookAtFlesherGlimpse(const tString &in asEntity, int alState)
		{
			cLux_AddDebugMessage("LookAtFlesherGlimpse "+alState);
			/**if (Entity_GetCollide("Player", "RossProximity"))
			{
				RossSightingSweetSound(false);
				Sound_FadeGlobalVolume(0.6f, 1.0f);
				Depth_Audio_Fear_LowIntensity();
			}
			**/
			
			if(alState==1)
			{
				RossLookAtSound();
			}
			if(alState != 1)
			{
				Map_AddTimer("RossLookAtOver", 3.0f, "RossLookAtOver");
			}
			
			if (alState != 1 || Map_GetTimerTime("LookAtFlesherGlimpseTimer") > 0)
				return;
			
			float fLookAtTime = Entity_GetVarFloat("Flesher_1", "LookAtTime");
			if (fLookAtTime < 0)
				return;
			
			cLux_AddDebugMessage("Removing in: "+fLookAtTime);
			Map_RemoveTimer("TimeoutFlesherGlimpseTimer");
			Map_AddTimer("LookAtFlesherGlimpseTimer", fLookAtTime, "TimerDeactivateFlesherGlimpse");
		}
		
		//-------------------------------------------------------
		
		void RossLookAtOver(const tString &in asTimer)
		{
			RossLookAtSoundStop();
		}
				
		//-------------------------------------------------------
		
		bool mbRossSweetAllowed = true;
		void RossSightingSweetSound(bool abSoftSweet)
		{
			if(mbRossSweetAllowed==true && abSoftSweet==true)
			{
				//Whisper Sweet here
				Sound_CreateAtEntity("RossFlicker", "04_02_tau_inside/SFX/ross_whisper_sweet", "Player", 0.0f, false, 0.55f);
				Map_AddTimer("RossSweetCooldown", 10.0f, "RossSweetCooldown");
				mbRossSweetAllowed = false;
			}
			
			else if(mbRossSweetAllowed==true && abSoftSweet==false)
			{
				Sound_CreateAtEntity("RossFlicker", "03_02_omicron_inside/SFX/ross_sighting_sweet", "Player", 0.0f, false, 0.55f);
				Map_AddTimer("RossSweetCooldown", 10.0f, "RossSweetCooldown");
				mbRossSweetAllowed = false;
			}
		}
		
		
		void RossSweetCooldown(const tString &in asTimer)
		{
			mbRossSweetAllowed = true;
		}	
	
		//-------------------------------------------------------
		
		bool mbRossLookAtAllowed = true;
		bool mbRossLookAtActive = false;
		void RossLookAtSound()
		{
			if(mbRossLookAtActive==false && mbRossLookAtAllowed==true)
			{
				cLux_AddDebugMessage("RossLookAtLoop_Start");
				Sound_CreateAtEntity("RossLookAtLoop_Start", "03_02_omicron_inside/SFX/ross_sighting_sweet", "Player", 0.0f, false, 0.55f);
				Map_AddTimer("RossLookAtLoop", 0.5f, "RossLookAtLoop");
				mbRossLookAtActive = true;
				mbRossLookAtAllowed = false;
			}
		}
		
		void RossLookAtLoop(const tString &in asTimer)
		{
			cLux_AddDebugMessage("RossLookAtLoop_Loop");
			Sound_CreateAtEntity("RossLookAtLoop", "04_02_tau_inside/SFX/ross_lookat_loop", "Player", 0.0f, false, 0.55f);
		}
		
		void Timer_RossLookAtSoundStop(const tString &in asTimer)
		{
			RossLookAtSoundStop();
		}
		
		void RossLookAtSoundStop()
		{
			if(mbRossLookAtActive==true)
			{
				cLux_AddDebugMessage("RossLookAtSoundStop");
				Sound_Stop("RossLookAtLoop_Start", 0.25f);
				Sound_Stop("RossLookAtLoop", 0.5f);
				Sound_CreateAtEntity("RossLookAtLoop_Stop", "04_02_tau_inside/SFX/ross_lookat_stop", "Player", 0.0f, false, 0.55f);
				Map_AddTimer("RossLookAtCooldown", 3.0f, "RossLookAtCooldown");
				mbRossLookAtActive = false;
			}
		}
		
		void RossLookAtCooldown(const tString &in asTimer)
		{
			mbRossLookAtAllowed = true;
		}
		
		//-------------------------------------------------------
		
		void TimerDeactivateFlesherGlimpse(const tString &in asTimer)
		{
			Map_RemoveTimer("LookAtFlesherGlimpseTimer");
			Map_RemoveTimer("TimeoutFlesherGlimpseTimer");
			
			TimerDeactivateFlesherEncounter(asTimer);
		}

		//-------------------------------------------------------
		
		bool Trigger_StartFlesherWalkEventOneWay(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1 || Entity_PlayerIsInFront(asChild)==false)
				return true;
			
			return Trigger_StartFlesherWalkEvent(asParent, asChild, alState);
		}

		//-------------------------------------------------------

		bool Trigger_StartFlesherWalkEvent(const tString &in asParent, const tString &in asChild, int alState)
		{
			tString sPos = Entity_GetVarString(asChild, "");
			if (StartFlesherWalkEncounter(sPos)==false) return true;
			
			return false;
		}

		//-------------------------------------------------------
		
		void TimerUpdateFlesherWalkEvent(const tString &in asTimer)
		{
			if (Entity_IsActive("Flesher_1")==false)
				return;
				
			Pathfinder_MoveToEntity("Flesher_1", "Player", "");
			Map_AddTimer(asTimer, 1, "TimerUpdateFlesherWalkEvent");
		}

		//-------------------------------------------------------
		
		bool Trigger_TooCloseToRoss(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1 || Entity_IsActive("Flesher_1")==false) return true;
						
			Map_RemoveTimer("TimeoutFlesherWalkEventTimer");
			TimerDeactivateFlesherEncounter("");
			
			return true;
		}
		
		//-------------------------------------------------------
		
		bool Trigger_RossStalking_CommRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == -1) return true;
				
			if (Entity_IsActive("LivingAreaDoor_14"))
			{
				MovingButton_SetSwitchedOn("LivingAreaDoorButton_1_14", true, true);
			}
			
			if (StartFlesherEncounter("CommRoom", 10, 0.5)==false) 
				return true;
			
			return false;
		}
		
		//} END EVENT
		
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 1 Extra Event *Bulkheads*
		//{///////////////////////////////////////

		//-------------------------------------------------------

		void OnChange_BulkheadOpen(const tString &in asEntity, int alState)
		{
			//Entity_SetInteractionDisabled(asEntity, true);
			int lDoorIndex = cString_GetNumericSuffixInt(asEntity);
			tString sDoor = "RadiationBulkhead_"+lDoorIndex;
			
			Entity_PlayAnimation(sDoor, "swingdoor_tau_radiation_open_swing", 0, false, true, "Animation_BulkheadUnlocked");
			
			///////////////////////////////
			// First door, trigger enemy
			if (lDoorIndex==1)
			{
				//Special door sound going to GUIWorld for ducking
				Sound_CreateAtEntity(sDoor+"_Opens", "04_02_tau_inside/SFX/nuclear_bulkhead/open", sDoor);  
				Map_AddTimer("RadiationBulkhead_"+lDoorIndex, 20.0f, "NuclearDoorSwingOpen");
				
				Entity_SetActive("DivingMonster_Stalker", true);
				DeepseaSuit_Wait("DivingMonster_Stalker", 23); //duration of animation
				Map_AddTimer("DivingMonster_Quiet", 0.5f, "DivingSuitMonsterQuiet"); //keep diving suit monster quiet until door opens
				Map_AddTimer("DivingMonster_QuietOver", 23.0f, "DivingSuitMonsterQuiet");
				
				//Diving suit stinger controllers
				Map_AddTimer("DivingMonster_StingerAllowed", 20.0f, "DivingSuitMonsterStinger");
				Map_AddTimer("DivingMonster_StingerCancelled", 50.0f, "DivingSuitMonsterStinger");
				
				Agent_SetSensesActive("DivingMonster_Stalker", false);
				
				Map_AddTimer("StopAmbientMusicQuickly", 1.0f, "AmbientMusicHandler");
				Map_AddTimer("ResetMixer", 5.0f, "ResetMixerNuclearDoor");
				
				
				Sound_FadeGlobalVolume(0.475, 2.0f);
			}
			
			///////////////////////////////
			// Second door, attract enemy
			else
			{
				//Normal Door sound that will be ducked if monster near, slightly quieter
				Sound_CreateAtEntity(sDoor+"_Opens", "04_02_tau_inside/SFX/nuclear_bulkhead/open_world", sDoor);
				Sound_CreateAIEventAtEntity("RadiationBulkhead_"+lDoorIndex, 100, 3);
				Map_AddTimer("RadiationBulkhead_"+lDoorIndex, 20.0f, "NuclearDoorSwingOpen");
			}
		}

		void NuclearDoorSwingOpen(const tString &in asTimer)
		{
			if(asTimer=="RadiationBulkhead_1")
			{
				Sound_CreateAtEntity("DoorSwingingOpen", "04_02_tau_inside/SFX/nuclear_bulkhead/swinging", asTimer);
			}
			
			else
			{
				Sound_CreateAtEntity("DoorSwingingOpen", "04_02_tau_inside/SFX/nuclear_bulkhead/swinging_world", asTimer);
			}
		}
		
		//-------------------------------------------------------
		
		void DivingSuitMonsterQuiet(const tString &in asTimer)
		{
			if(asTimer=="DivingMonster_Quiet")
			{
				Map_AddTimer("DivingMonster_Quiet", 0.15f, "DivingSuitMonsterQuiet"); 
				// if sound exits
				if(Sound_Exists("DivingMonster_Stalker_AnimEvent"))
				{
					Sound_Stop("DivingMonster_Stalker_AnimEvent", 0.05f);
				}
				
				if(Sound_Exists("DivingMonster_Stalker_DivingMonster_Stalker_Bark"))
				{
					Sound_Stop("DivingMonster_Stalker_DivingMonster_Stalker_Bark", 0.05f);
				}
			}
			
			if(asTimer=="DivingMonster_QuietOver")
			{
				Map_RemoveTimer("DivingMonster_Quiet");
			}
		}
		
		//-------------------------------------------------------
		
		bool mbDivingSuitMusicAllowed = false;
		bool mbDivingSuitMusicPlayed = false;
		void DivingSuitMonsterFirstSighting(const tString &in asEntity, int alState)
		{
			if(mbDivingSuitMusicAllowed==true && mbDivingSuitMusicPlayed==false)
			{
				if(Sound_Exists("RossEnters")==false)
				{
					Music_PlayOverlay("NPC_adultflesher_distant1", 0.95f);
					mbDivingSuitMusicPlayed = true;
				}
			}
		}
		
		void DivingSuitMonsterStinger(const tString &in asTimer)
		{
			if(asTimer=="DivingMonster_StingerAllowed")
			{
				mbDivingSuitMusicAllowed = true;
			}
			
			if(asTimer=="DivingMonster_StingerCancelled")
			{
				mbDivingSuitMusicAllowed = false;
			}
		}
		
		//-------------------------------------------------------
		
		void Animation_BulkheadUnlocked(const tString &in asEntityName, const tString &in asAnimName)
		{
			Timer_OpenBulkhead(asEntityName);
			Map_AddTimer(asEntityName+"_Blocker", 3, "TimerDeactivateEntity");
			
			int lDoorIndex = cString_GetNumericSuffixInt(asEntityName);
			Map_AddTimer("RadiationBulkheadPanel_"+lDoorIndex, 1, "TimerLockMovingButton");
			Map_AddTimer("RadiationBulkheadPanel_"+lDoorIndex, 1, "TimerAllowMovingButtonTurnOff");
			
			///////////////////////////////
			// First door, start enemy patrol
			if (lDoorIndex==1)
			{
				Map_AddTimer("DivingMonster_Stalker", 6.25f, "Timer_SetAgentSensesActive");
				Map_AddTimer("timer_deactivateblocker", 6.25f, "TimerDeactivateFirstBulkheadBlocker");
			}
		}
		
		void TimerDeactivateFirstBulkheadBlocker(const tString &in asTimer)
		{
			cLux_AddDebugMessage("BULK HEAD BLOCKER OFF");
			Entity_SetActive("Blocker_SuitMonster",false);
		}
		
		//-------------------------------------------------------
		
		void ResetMixerNuclearDoor(const tString &in asTimer)
		{
			Sound_FadeGlobalVolume(1.0f, 5.0f);
		}

		//-------------------------------------------------------
		
		void Timer_OpenBulkhead(const tString &in asTimer)
		{
			SwingDoor_SetLocked(asTimer, false, true);
			SwingDoor_PushOpen(asTimer, 0.02, 90,0.2);
		}

		//-------------------------------------------------------
		
		//} END EVENT
		
