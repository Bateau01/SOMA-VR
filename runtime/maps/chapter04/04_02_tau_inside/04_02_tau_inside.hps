		// Scene 3 Event F *Find To-Be-Flesher Pad (text & dialog)*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void OnGuiToBeFlesher(const tString&in asEntityName, float afTimeStep)
		{	
			ImGui_SetTransCategory("04_02_tau_inside");	
			
			StationGuiBG_Backdrop();
			StationGuiBG_Scanlines();
			StationGuiBG_DatapadTaskbar();
			
			int lActiveApp = StationGui_GetActiveApp(eToBeFlesherPadState_MainMenu);
			bool bBackButton = true;
			
			cStationGui_AudioPlaybackSettings audioSettings;
			audioSettings.mlBarCount=12;
			
			switch (lActiveApp)
			{
				case eToBeFlesherPadState_MainMenu:
				StationGui_AddApp("ToBeFlesherPadApp_Diary", true, eToBeFlesherPadState_Diary);
				StationGui_AddApp("ToBeFlesherPadApp_Recordings", true, eToBeFlesherPadState_Recordings);
				StationGui_MainMenu();
				bBackButton = false;
				break;
				
				case eToBeFlesherPadState_Diary:
				Depth_ImGui_AddTextFile("ToBeFlesherPadFileName_1", "ToBeFlesherPadFile_1");
				Depth_ImGui_AddTextFile("ToBeFlesherPadFileName_2", "ToBeFlesherPadFile_2");
				Depth_ImGui_AddTextFile("ToBeFlesherPadFileName_3", "ToBeFlesherPadFile_3");
				Depth_ImGui_AddTextFile("ToBeFlesherPadFileName_4", "ToBeFlesherPadFile_4");
				StationGui_DatapadMultiReader();
				break;
				
				case eToBeFlesherPadState_Recordings:
				Depth_ImGui_AddAudioFile_Voice("ToBeFlesherPadRecording_1", "RossRecording_1");
				Depth_ImGui_AddAudioFile_Voice("ToBeFlesherPadRecording_2", "RossRecording_2");
				Depth_ImGui_AddAudioFile_Voice("ToBeFlesherPadRecording_3", "RossRecording_3");
				Depth_ImGui_AddAudioFile_Voice("ToBeFlesherPadRecording_4", "RossRecording_4");
				Depth_ImGui_AddAudioFile_Voice("ToBeFlesherPadRecording_5", "RossRecording_5");
				StationGui_AudioPlaybackApp(audioSettings);
				break;
			}
			
			if (StationGui_DatapadBackButton(bBackButton) && lActiveApp==eToBeFlesherPadState_Recordings)
			{
				Depth_ImGui_StopAudioFilePlayback(ImGui_GetName(), true);
			}
		}

		//-------------------------------------------------------
		
		void OnLeaveToBeFlesher(const tString&in asEntityName)
		{
			OnLeave_HandheldTerminal("");
			// S26CK: the VR handheld GUI lives on the physical source.
            cScript_SetGlobalReturnBool(false);
            cScript_RunGlobalFunc("MenuHandler","cScrMenuHandler","HPL3VR_GetRuntimeActive");
            if(cScript_GetGlobalReturnBool())Depth_ImGui_StopAudioFilePlayback(asEntityName,true);
            else Depth_ImGui_StopAudioFilePlayback(asEntityName+"_open",true);
		}

		//-------------------------------------------------------
		
		void OnLeave_HandheldTerminal(const tString&in asEntityName)
		{
			if (Player_ToolIsInInventory("ARK"))
			{
				Player_UnequipTool();
				Player_EquipTool("ARK");
			}
		}
		
