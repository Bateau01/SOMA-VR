	//------------------------------------------------------
	//Airlock water spot - if door is open we hear water lapping by the door to ease the transition between the areas	
	
	void AirlockStartingSpotUpdate(const tString &in asTimer)
	{
		Map_AddTimer("AirlockSpotUpdate", 1.0f, "AirlockStartingSpotUpdate");
		
		// S26AQ: the former local flag was recreated on every poll and could
		// not remember playback. Preserve the authored audible condition directly.
		if (SlideDoor_GetOpenAmount("AirlockDoor_1") > 0.05 || mbPlayerInStartingAirlock)
		{
			Sound_Play("startairlockwaterspot", 1.0f);
		}
		else
		{	
			Sound_Stop("startairlockwaterspot", 1.0f);
		}
	}
	//Draining airlock - start of map
    //-------------------------------------------------------
	void SetupStartingAirlockSound()
	{
		Sound_CreateAtEntity("PumpUW", "Entities_OceanBottom/airlock/uw/pump/idle_loop", "PumpsSource_Start");
	}
	
	void AirlockEffectsFlushWater()
	{
		Depth_Audio_AirlockDrainLeadInUW();
		Depth_Audio_AirlockDrainLoopUW();
		Map_AddTimer("AirlockDrainUWStopTimer", 10.f, "AirlockDrainUWStop");
		
		//Sweetener and mixer
		Sound_CreateAtEntity("DrainingSweetenerUW", "04_02_tau_inside/SFX/airlock_start/draining_sweet_uw", "Player", 2.0f);
		Sound_FadeGlobalVolume(0.7, 3.0f);
