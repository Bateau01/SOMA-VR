		void OnGuiScreenGibberish(float afIntensity)
		{
			// Static overlay
			if (ImGui_RepeatTimer("StaticIndex", 0.1))
			{
				ImGui_SetStateInt("StaticImageIndex", cMath_RandRectl(0, 1));
				ImGui_SetStateInt("AnimationRotation", cMath_RandRectl(0, 1));
			}
			ImGui_SetModColorMul(gStationGuiColor_Normal*cColor(0.4*afIntensity, 0.8));
			ImGui_SetModRotateAngle(ImGui_GetStateInt("AnimationRotation", 0)*180);
			ImGui_DoImage(cImGuiGfx("static_"+ImGui_GetStateInt("StaticImageIndex", 0)), cVector3f_Forward, ImGui_NrmSizeGroup(1));
			
			// Weird image
			if (ImGui_RepeatTimer("ImageIndex", 0.14))
			{
				ImGui_SetStateInt("GibberishImageIndex", cMath_RandRectl(0, 2));
			}
			ImGui_SetModColorMul(cColor(0.4*afIntensity, 1));
			ImGui_SetModRotateAngle(ImGui_GetStateInt("AnimationRotation", 0)*180);
			ImGui_DoImage(cImGuiGfx("leechgibberish_"+ImGui_GetStateInt("GibberishImageIndex", 0)), 0, ImGui_NrmSizeGroup(1));
			ImGui_ResetModifiers();
		}
		
		//} END TERMINALS GENERAL
