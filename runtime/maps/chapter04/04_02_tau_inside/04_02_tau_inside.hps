	/////////////////////////////////////////
	// ==============
	// SCENE 2 *TURN OFF REACTOR & ENTER LIVING AREA*
	// ==============
	//{///////////////////////////////////////

	//-------------------------------------------------------
	
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 2 General
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void SetupTurnOffReactor()
		{
			float fFactor = 1.8f;
			Prop_RotateToSpeed("ReactorBall", 0.3, -0.5*fFactor, false, "");
			Prop_RotateToSpeed("ReactorRing_1", 0.3, 2*fFactor, false, "");
			Prop_RotateToSpeed("ReactorRing_2", 0.3, -3*fFactor, false, "");
			Prop_RotateToSpeed("ReactorRing_3", 0.3, -4*fFactor, false, "");
			
			IrradianceSet_FadeIn("reactor", 0);
			
			Entity_StopAnimation("LivingAreaBulkhead_*");
			
			Terminal_SetImGuiStateInt("ReactorControlTerminal", "CurrentRoom", eIntercomRoom_ReactorControl);
			
			Sound_CreateAtEntity("ReactorOn", "Entities_Station/machines/turbine/turbine_on", "ReactorRing_1");
			
			Light_SetVisible("InfirmaryDoorSparks_*", false);
			
			Entity_StopAnimation("ReactorKey_Inserted_*");
			
			MovingButton_SetSwitchedOn("ChaseEndDoorButton_1_1", true, true);
		}

		//-------------------------------------------------------
		
		void OnGuiBulkheadPanel(const tString&in asEntityName, float afTimeStep)
		{
			cImGuiTextFrameData text = ImGui_GetDefaultTextFrame();
			text.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
			text.mFontAlign = eFontAlign_Center;
			text.mbUseBackgroundGfx = false;
			text.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.1);
			
			ImGui_SetTransCategory("04_02_tau_inside");
			
			if (mbRadiationActive)
			{
				StationGui_BigStatusMessage_Old("RadioactivityMsg");
			}
			else
			{
				StationGui_BigStatusMessage_Old("BulkheadStatus_Open", gStationGuiColor_Highlight);
			}
		}
		
		void TurnOffReactor(bool abEffects)
		{					
			// Turn off reactor
			if (abEffects)
			{
				float fFactor = 0.8f;
				Prop_RotateToSpeed("ReactorBall", 0.15, -0.5*fFactor, false, "");
				Prop_RotateToSpeed("ReactorRing_1", 0.15, 2*fFactor, false, "");
				Prop_RotateToSpeed("ReactorRing_2", 0.15, -3*fFactor, false, "");
				Prop_RotateToSpeed("ReactorRing_3", 0.15, -4*fFactor, false, "");
				Sound_CreateAtEntity("ReactorSlowdown", "03_02_omicron_inside/SFX/power_room/shutdown", "ReactorRing_1");
				Seq_RadiactivePurge("");
			}
			else
			{
				Prop_StopMovement("ReactorRing_*");
				Prop_StopMovement("ReactorBall");
				Lamp_SetLit("StartAreaWarningLight_*", false, false);
				Sound_Stop("airlocklightmotor_*",0.25f);
				Prop_StopMovement("StartAreaWarningLight_*");
				mbRadiationActive = false;
			}
			Entity_SetEffectsActive("ReactorBall", false, abEffects);
			cLux_AddTodoMessage("Sound: Reactor slows down.");
			Sound_Fade("ReactorOn", 0.5, 15);
			//Sound_Stop("ReactorOn", abEffects ? 3 : 0);
			
			// Turn off reactor room lights
			Lamp_SetLit("ReactorRoomLamp_*", false, abEffects);
			Entity_SetEffectsActive("ReactorRoomIllum_*", false, abEffects);
			IrradianceSet_FadeInSingleProbe("Reactor", "reactor_dark", abEffects ? 1 : 0);
			
			// Change lighting elsewhere
			Lamp_SetLit("StartCorridorLamp_*", false, abEffects);
			Lamp_SetLit("StartCorridorLamp_36", true, false);
			Lamp_SetFlickerActive("StartCorridorLamp_36", true);
			Light_SetBrightness("BulkheadLight_*", 0.5f);
			
			// Disable reactor puzzle
			Terminal_SetGuiActive("ReactorKeyStatus_*", false, abEffects ? 1 : 0);
			
			// Disable stalking monster
			Agent_SetAutoDisableWhenOutOfSightActive("DivingMonster_Stalker", true, 5);
		}

		//-------------------------------------------------------
		
		cSequenceStatesData mRadiactivePurgeSequence;
			
		void Seq_RadiactivePurge(const tString &in asTimer)
		{
			Sequence_Begin("Seq_RadiactivePurge", mRadiactivePurgeSequence);
				
			if (Sequence_DoStepAndWait(3))
			{
				mbDecontaminationActive	= true;
			}	
			if (Sequence_DoStepAndWait(25))
			{
				cLux_AddTodoMessage("Sound: Radiactive dust cleanup starts");
				cLux_AddTodoMessage("Sound: Crackling dies down");
				Timer_DustCleanupAnnouncementRepeat("Timer_DustCleanupAnnouncementRepeat");
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Map_RemoveTimer("Timer_DustCleanupAnnouncementRepeat");
				
				//Turn off light and sounds
				Lamp_SetLit("StartAreaWarningLight_*", false, false);
				for (int i = 1; Entity_Exists("StartAreaWarningLight_"+i); i++)
				{
					iLuxEntity@ pSpinningLamp = Map_GetEntity("StartAreaWarningLight_"+i, eLuxEntityType_Prop);
					cVector3f vRotateAxis = cMath_MatrixInverse(pSpinningLamp.GetMatrix()).GetForward();
					Prop_RotateToSpeed("StartAreaWarningLight_"+i, 10, 0, vRotateAxis, true, "");
				}
				
				Terminal_SetGuiActive("RadiationWarningTerminal_*", false, 1);
				
				mbRadiationActive = false;
				mbDecontaminationActive	= false;
				
				Entity_SetActive("RadioactiveDoorProximity", true);
			}
			Sequence_End();
		}

		//-------------------------------------------------------
		
		void Timer_DustCleanupAnnouncementRepeat(const tString &in asTimer)
		{
			Voice_Play("2_RadioactiveCleanup");
			Map_AddTimer(asTimer, 10, "Timer_DustCleanupAnnouncementRepeat");
		}

		//-------------------------------------------------------
		
		bool Trigger_CloseToRadioactiveDoor(const tString &in asParent, const tString &in asChild, int alState)
		{
			AnimationDoor_SetOpen("LivingAreaBulkhead_1_Closed", "LivingAreaBulkhead_1_Open", true, true, "", "swingdoor_tau_large_door_swing");
			return false;
		}

		//-------------------------------------------------------
		
		void OnGui_RadiactivityWarning(const tString&in asEntityName, float afTimeStep)
		{
			
			ImGui_SetTransCategory("04_02_tau_inside");
			
			//StationGuiBG_Backdrop();
			StationGuiBG_Scanlines();
			
			StationGui_BigStatusMessage_Old("RadioactivityMsg", gStationGuiColor_Warning, 2.25, true);
		}
		
