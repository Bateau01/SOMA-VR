		{
			// will add post beta
			//Sound_CreateAtEntity("AirlockProblemSound","01_02_upsilon_inside_02/special/collapse_sequence/collapse_impact_0"+mlMoan+"_moan","Player");
			mlMoan = mlMoan==3 ? 2 : 3;
			Map_AddTimer(asTimer, 10, "TimerMoanHack");
		}

		//-------------------------------------------------------
		bool mbFinalPipePulled = false;
		void OnChangeAirlockPipe(const tString &in asEntity, int alState)
		{
			if (alState != 1) return;
			
			if(asEntity == "AirlockPipe_3") Entity_SetActive("pouring_med_tileable_non_static_2", true);
			
			//Map_RemoveTimer("4_AirlockStopped");
			//Map_AddTimer("4_AirlockPipePulled", 0.5, "TimerPlayVoice");
			//Map_AddTimer("4_AirlockPipePulled", 0.15, "TimerVoiceMixer");
			
			ParticleSystem_Destroy(asEntity+"_Spray");
			if (mlPipePulledCount==0) ParticleSystem_SetActive(asEntity+"_stream", true);
			if (mlPipePulledCount<=1) ParticleSystem_SetActive(asEntity+"_splash", true);
			Sound_Stop(asEntity+"_Spray", 0.5f);
			
			if (mlPipePulledCount==1) 
			{
				ParticleSystem_Destroy("AirlockPipe_*_Spray");
				ParticleSystem_Destroy("AirlockPipe_*_stream");
				Map_AddTimer("AirlockPipe_*_splash", 2, "TimerDestroyParticles");
			}
			
			//Pull sound fx
			Sound_FadeGlobalVolume(0.75f, 0.25);
			Map_AddTimer("ResetMixer", 0.5f, "ResetMixerPipePulled");
			Sound_CreateAtEntity(asEntity+"Pulled", "04_02_tau_inside/SFX/airlock_end_flood/pipe_break", asEntity, 0.0f, false, 1.0f);
			Sound_CreateAtEntity(asEntity+"_Flow", "04_02_tau_inside/SFX/airlock_end_flood/pipe_water_flow", asEntity, 0.25f);
			
			
			mlPipePulledCount++;
			Terminal_FadeImGuiStateFloat("AirlockControlScreen", "PressureMul", 0.333*float(mlPipePulledCount), 2);
			
			float fAcc = 0.1;
			float fSpeed = 0.5;
			float fSlowDown= 0.5;
			
			Player_ChangeStateToNormal();
			Player_SetLookSpeedMul(0);
			Player_FadeLookSpeedMulTo(1, 1);
			
			if(mlPipePulledCount==1)
			{
				Sound_CreateAtEntity("WaterGushingSweetener", "04_02_tau_inside/SFX/airlock_end_flood/water_gushing_sweetener", "Player", 3.0f);
				Sound_FadeGlobalVolume(0.7,3.0f);
			}
			else if(mlPipePulledCount==2)
			{
				//Audio breaks if player can crouch during sequence - resets at end of level trigger
				Player_SetCrouchDisabled(true);
				Player_SetCrouching(false);
			}
			
			if (mlPipePulledCount==3)
			{
				Effect_Rumble_Start(1, 1.25, 0, 1.25);
				mbFinalPipePulled = true;
				fAcc = 1;
				fSpeed = 3;
				fSlowDown = 0.25;
				
				Seq_PlayerCollapse("");
			}
			else
			{
				if (Sound_Exists("Airlock2WaterFlush")==false)
				{
					//Sound_CreateAtEntity("Airlock2WaterFlush", "01_02_upsilon_inside_02/special/collapse_sequence/water_flooding_loop", "Player", 0.5, false);
				}
						
				DoPressureEffect(0.5*float(mlPipePulledCount));		 
				Effect_Shake_Start(0.04, 0, 0, 1);
				Effect_Rumble_Start(0.75, 1.25, 0, 1.25);
				Effect_Shake_FadeOut(mlAirlock2Shake, 1);
				mlAirlock2Shake = Effect_Shake_Start(0.005+0.0025*float(mlPipePulledCount), -1, 5, 0, 1, 15);
				
				Player_AddBodyForceAwayFromEntity(asEntity, 19200);
				
			}
			
			LiquidArea_MoveLinearTo("Airlock2Water","Airlock2Water_Target_"+mlPipePulledCount,fAcc, fSpeed, fSlowDown, false);
		}
		
		void ResetMixerPipePulled(const tString &in asTimer)
		{
			if(mbFinalPipePulled==false)
			{
				Sound_FadeGlobalVolume(1.0f, 0.5f);
			}
			
		}
		//-------------------------------------------------------
		
		cSequenceStatesData mPlayerCollapseSequence;
			
		void Seq_PlayerCollapse(const tString &in asTimer)
		{
			Sequence_Begin("Seq_PlayerCollapse", mPlayerCollapseSequence);
				
			if (Sequence_DoStepAndWait(0.3))
			{
				Map_RemoveTimer("TimerMoanHack");
				Sound_CreateAtEntity("EndHit", "04_02_tau_inside/SFX/airlock_end_flood/end_hit", "Player", 0.0f, false);
				Sound_FadeGlobalVolume(0.0f, 0.05f);
				
				Effect_Screen_Start("water_splash_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 0.4f, 0.2f, 0.6f); 
				PreloadFadeGlobal();
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Effect_DoF_Start(1.5f, 3.0f, 0.5, 1.0); //Unsure, this does not seem to match 4.3 but can't find any other values in 4.3.
				Entity_SetActive("pouring_med_tileable_non_static_*", false);
				
				Effect_Screen_Start("water_plunge_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 0.15f, 1.f, 3.f);
				ParticleSystem_CreateAtEntity("PlayerPlungePS", "loop_waterbubbles_small_plunge.ps", "player", true);
				
				if (Player_GetCrouching())
				{
					Player_MoveHeadPos(cVector3f_Down * 0.3f, 2, 4, 0.2f);
				}
				else
				{
					Player_MoveHeadPos(cVector3f_Down * 0.5f, 2, 4, 0.2f);
				}
				Player_SetActive(false);
				Player_StartLookAt("ARK", 1, 1, 3);
				Sound_Stop("WaterGushingSweetener", 0.25f);
				Sound_Stop("AirlockProblemSound", 0.25f);
				Sound_Stop("AirlockPipe_1_Spray", 0.25f);
				Sound_Stop("AirlockPipe_2_Spray", 0.25f);
				Sound_Stop("AirlockPipe_3_Spray", 0.25f);
				Sound_Stop("AirlockPipe_1_Flow", 0.25f);
				Sound_Stop("AirlockPipe_2_Flow", 0.25f);
				Sound_Stop("AirlockPipe_3_Flow", 0.25f);
				
				Sound_Stop("WaterFillsRoom", 2);
			}
			else if (Sequence_DoStepAndWait(0.3))
			{
				Effect_Fade_Out(0.3);
			}
			else if (Sequence_DoStepAndWait(8))
			{
				//8 seconds to allow sound to fade out for graceful transition
				Player_MoveHeadPos(cVector3f_Zero, 1, 1, 0.1);
				Player_StopLookAt(1);
				Effect_Shake_FadeOut(mlAirlock2Shake, 0);
				ParticleSystem_Destroy("PlayerPlungePS");
			}
			else
			{
				Player_SetStandDisabled(false);
				Player_SetCrouchDisabled(false);
				Player_SetActive(true);
				if (cLux_ScriptDebugOn()==false)
				{
					PreloadChangeOfMap();
				}
				else
					cLux_AddDebugMessage("LEVEL ENDED");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void DoPressureEffect(float afMul)
		{
			const float fDoFMax = 6;
			float fBurstEnd = fDoFMax - afMul*(fDoFMax-0.5f);
			float fBurstStart = cMath_Max(0.1f, fBurstEnd-1.0f);
			if (mlDofID!=-1)
				Effect_DoF_FadeOut(mlDofID,0.5f);
			mlDofID = Effect_DoF_Start(0.0f, fBurstStart, 1.0f, 0.25f);
			Effect_DoF_FadeFocus(mlDofID, 0.0f , fBurstEnd, 2.5f);
			Effect_ChromaticAberration_StartAnim(5.0f, afMul*0.01f, 0.2f, cVector2f_Zero);
			
			float fBurstTime = 0.5;
			float fFovMul = 1.0f-afMul*0.6f;
			Player_FadeFOVMulTo(fFovMul, (1.0f-fFovMul)/fBurstTime);
			cLux_AddDebugMessage("fFovMul "+fFovMul);
			Map_AddTimer("TimerEndPressureEffectBurst",fBurstTime,"TimerEndPressureEffectBurst");
			
			Map_RemoveTimer("EndPressureEffectPulse_Start");
			Map_RemoveTimer("EndPressureEffectPulse_End");
			mfRadialBlurMin = 1.0f-afMul*0.8;
			mfRadialBlurMax = 1.0f-afMul*0.4;
			if (mlEndRadialBlurID == -1)
			{
				mlEndRadialBlurID = Effect_RadialBlur_Start(0.1, 0.25, mfRadialBlurMin, 1);
				Map_AddTimer("EndPressureEffectPulse_End",1,"Timer_EndPressureEffectPulse");
			}
			else
			{
				Timer_EndPressureEffectPulse("EndPressureEffectPulse_Start");
			}
		}
		
		void TimerEndPressureEffectBurst(const tString& in asName)
		{
			Player_FadeFOVMulTo(1.0f, 0.4);
		}
		
		void Timer_EndPressureEffectPulse(const tString &in asTimer)
		{
			if (asTimer == "EndPressureEffectPulse_Start")
			{
				Effect_RadialBlur_FadeStartDistance(mlEndRadialBlurID, mfRadialBlurMin, 1);
				Map_AddTimer("EndPressureEffectPulse_End",1,"Timer_EndPressureEffectPulse");
			}
			else
			{
				Effect_RadialBlur_FadeStartDistance(mlEndRadialBlurID, mfRadialBlurMax, 1);
				Map_AddTimer("EndPressureEffectPulse_Start",1,"Timer_EndPressureEffectPulse");
			}
		}
		
		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 5 Extra Event *Hear Leviathan roar*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		cSequenceStatesData mDiveRoomLeviathanSequence;
			
		void Seq_DiveRoomLeviathan(const tString &in asTimer)
		{
			Sequence_Begin("Seq_DiveRoomLeviathan", mDiveRoomLeviathanSequence);
				
			if (Sequence_DoStepAndWait(1))
			{
				cLux_AddTodoMessage("Sound: Leviathan swims by outside, making the building rumble slightly.");
				Effect_Shake_Start(0.01, 0, 3, 4);
				Effect_Rumble_Start(0.4, 6, 2, 4);
				Sound_CreateAtEntity("LeviathanDiveRoomQuake", "04_02_tau_inside/SFX/leviathan_tremors/divearea", "LeviathanRoarSoundSource", 0.0f);
				Sound_FadeGlobalVolume(0.0f, 1.5f);
			}	
			if (Sequence_DoStepAndWait(1))
			{
				Lamp_SetFlickerActive("DiveRoomLamp_*", true);
				Map_AddTimer("DiveRoomLocker_1", 0.05, "Timer_DiveRoomLeviathanLockerPush");
				Map_AddTimer("DiveRoomLocker_2", 0, "Timer_DiveRoomLeviathanLockerPush");
				Map_AddTimer("DiveRoomLocker_3", 0.1, "Timer_DiveRoomLeviathanLockerPush");
				Map_AddTimer("DiveRoomLocker_4", 0.2, "Timer_DiveRoomLeviathanLockerPush");
			}
			else if (Sequence_DoStepAndWait(4))
			{
				Depth_Audio_Fear_MediumIntensity(8.0f, 15.0f, 1, true, true);
			}
			else
			{
				Sound_FadeGlobalVolume(1.0f, 4.0f);
				Lamp_SetFlickerActive("DiveRoomLamp_*", false);
				Map_AddTimer("DiveRoomLocker_1", 1, "Timer_DiveRoomLeviathanStopLockerShake");
				Map_AddTimer("DiveRoomLocker_2", 0, "Timer_DiveRoomLeviathanStopLockerShake");
				Map_AddTimer("DiveRoomLocker_3", 1.5, "Timer_DiveRoomLeviathanStopLockerShake");
				Map_AddTimer("DiveRoomLocker_4", 2.2, "Timer_DiveRoomLeviathanStopLockerShake");
			}
			Sequence_End();
		}
		
		bool Trigger_DiveRoomLeviathan(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_DiveRoomLeviathan("");
			return false;
		}
		
		void Timer_DiveRoomLeviathanLockerPush(const tString &in asTimer)
		{
			int lOpenState = SwingDoor_GetState(asTimer);
			
			float fMin = -0.175f;
			float fMax = 0.175f;
			if (lOpenState ==-1) fMin = 0;
			if (lOpenState == 1) fMax = 0;
			SwingDoor_PushOpen(asTimer, cMath_RandRectf(fMin, fMax), 1);
			Map_AddTimer(asTimer, cMath_RandRectf(0.1, 0.3), "Timer_DiveRoomLeviathanLockerPush");
		}
		
		void Timer_DiveRoomLeviathanStopLockerShake(const tString &in asTimer)
		{
			Map_RemoveTimer(asTimer);
		}
		
		//} END EVENT
	
	//} END SCENE 5

