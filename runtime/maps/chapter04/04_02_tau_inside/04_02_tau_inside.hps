	//-------------------------------------------------------
	//Controls bathroom light flickers to stop from leaking out
	bool BathroomFlickerController(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Lamp_SetFlickerActive("fluorescent_tube_slidedoor_medium_45", true);
