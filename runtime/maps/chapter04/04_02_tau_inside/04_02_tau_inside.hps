		//-------------------------------------------------------
		
		void OpenKeyLocker()
		{			
			Entity_SetInteractionDisabled("KeyLockerDoor", true);
			SwingDoor_SetDisableAutoClose("KeyLockerDoor", true);
			SwingDoor_SetBlocked("KeyLockerDoor", false, true);
			SwingDoor_SetClosed("KeyLockerDoor", false, true);
			
			cLux_AddTodoMessage("Sound: Sound of reactor key locker opening to attract player attention.");
			
			Lamp_SetLit("KeyLockerLamp_Unlocked", true, true);
			Lamp_SetLit("KeyLockerLamp_Locked", false, true);
		
			TimerOpenKeyLocker("KeyLockerDoor");
		}

		//-------------------------------------------------------
		
		void TimerOpenKeyLocker(const tString &in asTimer)
		{
			if (SwingDoor_GetState(asTimer)==1)
			{
				Entity_SetInteractionDisabled(asTimer, false);
				return;
			}
			
			Entity_AddForce(asTimer, cVector3f_Forward*4, true, true);
			Map_AddTimer(asTimer, 0.1, "TimerOpenKeyLocker");
		}
		
