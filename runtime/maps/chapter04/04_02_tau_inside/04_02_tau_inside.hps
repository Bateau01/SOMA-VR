	//Music
	
	//---------------------------------------------------------------------
	
	/**
	*Simple ambient music player that fades the ambience randomly whilst playing to stop it from getting repetitive
	**/
	
	bool mbAmbientMusicPlaying = false;
	int mlAmbientStage = 1;
	void AmbientMusicHandler(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Ambient Music Playing is "+mbAmbientMusicPlaying);
		if (asTimer=="StartAmbient" && mbAmbientMusicPlaying==false)
		{
			cLux_AddDebugMessage("Ambient music triggering");
			Music_PlayExt("04_02_ambience"+mlAmbientStage, true, 0.45f, 1.0f, cMath_RandRectf(3.f,5.f), 0.0f, eMusicPrio_BgAmb, true);
			Music_FadeVolumeMul(1.0f, 3.0f);
			mbAmbientMusicPlaying = true;
			
			//Dynamic fades
			Map_AddTimer("RandomFadeRider", cMath_RandRectf(15.f,30.f), "AmbientMusicFade");
			Map_AddTimer("FadeOut", cMath_RandRectf(35.f,65.f), "AmbientMusicFade");
			Map_RemoveTimer("StopAmbientMusic");
			Map_RemoveTimer("StopAmbientMusicQuickly");
		}
		
		//Fade Music back up
		else if (asTimer=="AmbientMusicFadeBackIn" && mbAmbientMusicPlaying==true)
		{
			Music_PlayExt("04_02_ambience"+mlAmbientStage, true, 0.45f, 1.0f, cMath_RandRectf(3.f,5.f), 0.0f, eMusicPrio_BgAmb, true);
			Map_AddTimer("FadeOut", cMath_RandRectf(35.f,65.f), "AmbientMusicFade");
		}
		else if (asTimer=="StopAmbientMusic" && mbAmbientMusicPlaying==true)
		{
			Music_Stop(4.5f, eMusicPrio_BgAmb);
			Map_RemoveTimer("RandomFadeRider");
			Map_RemoveTimer("FadeOut");
			Map_RemoveTimer("StartAmbient");
			Music_FadeVolumeMul(1.0f,1.0f);
			mbAmbientMusicPlaying = false;
		}
		  else if (asTimer=="StopAmbientMusicQuickly" && mbAmbientMusicPlaying==true)
		{
			cLux_AddDebugMessage("Stop Ambient Music Quickly Triggered");
			Music_Stop(1.5f, eMusicPrio_BgAmb);
			Map_RemoveTimer("StartAmbient");
			Map_RemoveTimer("RandomFadeRider");
			Map_RemoveTimer("FadeOut");
			Music_FadeVolumeMul(1.0f,1.0f);
			mbAmbientMusicPlaying = false;
		}
	}
	
	void AmbientMusicFade(const tString &in asTimer)
	{
		if(asTimer=="FadeOut")
		{	
			Map_RemoveTimer("RandomFadeRider");
			cLux_AddDebugMessage("Ambient Music Fading Out");
			Music_PlayExt("04_02_ambience"+mlAmbientStage, true, 0.0f, 1.0f, cMath_RandRectf(12.f,15.f), 0.0f, eMusicPrio_BgAmb, true);
			Map_AddTimer("AmbientMusicFadeBackIn", cMath_RandRectf(25.f,35.f), "AmbientMusicHandler");
		}
		if(asTimer=="RandomFadeRider")
		{
			cLux_AddDebugMessage("Ambient Music Fading");
			Map_AddTimer("RandomFadeRider", cMath_RandRectf(10.f,15.f), "AmbientMusicFade");
			Music_PlayExt("04_02_ambience"+mlAmbientStage, true, 0.45f*cMath_RandRectf(0.75f, 1.2f), 1.0f, cMath_RandRectf(5.f,8.f), 0.0f, eMusicPrio_BgAmb, true);
		}
	}
		
	//-------------------------------------------------------
	
	bool Trigger_OpeningMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		Map_AddTimer("StartAmbient",cMath_RandRectf(2, 5),"AmbientMusicHandler");
		cLux_AddDebugMessage("Ambient music opening area triggered");
		return false;
	}
	
	bool mbLivingAreaOpenMusicPiecePlayed = false;
	bool Trigger_LivingAreaMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			if(mbLivingAreaOpenMusicPiecePlayed == false)
			{
				Music_Play("04_02_livingquarters", 0.95f, false, eMusicPrio_BigEvent);
				Map_AddTimer("LivingArea_FridgeCompressor_SoundStart", cMath_RandRectf(30, 45), "LivingArea_FridgeCompressor_SoundStart");
				mbLivingAreaOpenMusicPiecePlayed = true;
				mlAmbientStage++;
				Sound_FadeGlobalVolume(0.85, 3.0f);
				Map_AddTimer("ResetMixer", 5.0f, "LivingAreaMixerReset");
			}
			Map_AddTimer("StartAmbient",cMath_RandRectf(5, 10),"AmbientMusicHandler");
		}
		else
		{
			Map_AddTimer("StopAmbientMusic", 1.0f, "AmbientMusicHandler");
		}
		return true;
	}

