		//-------------------------------------------------------
		bool mbIvashkinMusicPlayed = false;
		bool Trigger_ArkCrewMemberProx(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_RemoveTimer(asChild);
			if (alState == 1)
			{
				Map_AddTimer(asChild, cMath_RandRectf(4, 6), "TimerPlayArkCrewMemberVoice");
				Map_AddTimer("IvashkinBreathingStart", 1.0f, "IvashkinBreathing");
				
				if(mbIvashkinMusicPlayed==false)
				{
					Music_Play("03_02_photos", 1.0f, false, eMusicPrio_BigEvent);
					mbIvashkinMusicPlayed = true;
				}
			}
			else
			{
				Sound_Stop("IvashkinBreathing", 3.0f);
				Map_RemoveTimer("IvashkinBreathingStart");
			}
			return true;
		}

		//-------------------------------------------------------
		
		void TimerPlayArkCrewMemberVoice(const tString &in asTimer)
		{
			Sound_Stop("IvashkinBreathing", 1.0f);
			Map_AddTimer("IvashkinBreathingStart", 2.0f, "IvashkinBreathing");
			int lMemberId = cString_GetNumericSuffixInt(asTimer);
			if (Entity_GetCollide("Player", "ArkCrewMemberProximity_"+lMemberId))
			{
				Voice_Play("3_CrewMember_"+lMemberId, -1, "VoiceArkCrewMember");
			}
		}
		
		void IvashkinBreathing(const tString &in asTimer)
		{
			Sound_CreateAtEntity("IvashkinBreathing", "04_02_tau_inside/SFX/ivashkin/breathing", "IvashkinVoiceSource");
		}

		//-------------------------------------------------------
		
		void VoiceArkCrewMember(const tString&in asScene, const tString&in asSubject)
		{
			int lMemberId = cString_GetNumericSuffixInt(asSubject);
			Map_AddTimer("ArkCrewMemberProximity_"+lMemberId, cMath_RandRectf(4, 6), "TimerPlayArkCrewMemberVoice");
		}

		//-------------------------------------------------------
		
		void OnChangeIvashkinDoorButton(const tString &in asEntity, int alState)
		{
			OnChangeDoorButton(asEntity, alState);
			if (alState==1)
			{
				Map_RemoveTimer("Timer_DeactivateIvashkin");
				Entity_SetActive("Ivashkin", true);
			}
			else
			{
				Map_AddTimer("Timer_DeactivateIvashkin", 3, "Timer_DeactivateIvashkin");
			}
		}
		
		void Timer_DeactivateIvashkin(const tString &in asTimer)
		{
			Entity_SetActive("Ivashkin", false);
		}
		
		bool Doorway_ApproachingDiveRoom(const tString &in asArea, const tString &in asEntity, int alState)
		{
			if (alState==1)
			{
				Entity_SetActive("Ivashkin", false);
			}
			else
			{
				Entity_SetActive("Ivashkin", MovingButton_IsSwitchedOn("LivingAreaDoorButton_1_7"));
			}
			return true;
		}

