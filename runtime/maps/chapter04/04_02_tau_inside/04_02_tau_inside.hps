		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 5 Event C *Put ARK on Cargo Transporter*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		int mlArkCollisionCount = 0;
		int mlArkMisalignedCount = 0;
		bool mbArkAttached = false;
		bool mbArkInElevator = false;

		//-------------------------------------------------------
		
		bool CanUse_ARK(const tString &in asTool, const tString &in asEntity)
		{
			return asEntity=="ArkPlacementArea" || 
				   asEntity == "CargoElevatorArea_1" || 
				   asEntity == "CargoElevatorArea_2" || 
				   asEntity == "CargoElevatorArea_3";
				   
		}
		

		//-------------------------------------------------------
		
		bool OnUse_ARK(const tString &in asTool, const tString &in asEntity)
		{
            // S26CT: VR pickup makes the authored static ARK dynamic for
            // carrying. Return it to the stock placed state BEFORE the native
            // elevator overlap scan; otherwise its own body is counted as an
            // obstruction and disabling collision lets it fall through the lift.
            cScript_SetGlobalReturnBool(false);
            cScript_RunGlobalFunc("MenuHandler", "cScrMenuHandler", "HPL3VR_GetRuntimeActive");
            if(cScript_GetGlobalReturnBool())
            {
                Prop_SetStaticPhysics("ARK", true);
                LogNewLine("S26CT ARK: restored authored static placement at "+asEntity);
            }
			Entity_SetActive("ARK", true);
			//Prop_SetStaticPhysics("ARK", false);
			Entity_SetInteractionDisabled("ARK", false);
			Tool_SetHighlightActive("ARK", true);
			Entity_SetInteractionDisabled("CargoElevatorArea_*", true);
			Entity_SetActive("AirlockControlPanel_ToolArea", true);
			
			cLux_AddDebugMessage("Placing at "+asEntity);
			
			if (asEntity == "ArkPlacementArea")
				OnUse_ARK_Airlock();
			else
				OnUse_ARK_Elevator(asEntity);
				
			
			return true;
		}

		//-------------------------------------------------------
		
		void OnUse_ARK_Airlock()
		{
			Entity_PlaceAtEntity("ARK", "ArkAirlockPos", cVector3f_Up*0.0625, true);
			Sound_CreateAtEntity("PlaceARKTable", "04_02_tau_inside/SFX/robot_arm/table/put_down", "Player");
			//Voice_Play("4_DropArkInAirlock");
		}

		//-------------------------------------------------------
		
		void GetBodiesCollidingWithArk(array<iPhysicsBody@> &out avOutVector)
		{
			iLuxEntity@ pArk = Map_GetEntity("ARK", eLuxEntityType_Prop);
			cBoundingVolume boundingVolume = pArk.GetBody(0).GetBoundingVolume();
			cLux_GetCurrentMap().GetPhysicsWorld().GetBodiesInAABB(boundingVolume.GetMin(), boundingVolume.GetMax(), avOutVector);
		}
		
		// Checks is the specified body is a dynamic body that needs 
		// some physics hacking to work together with the ark in the elevator 
		bool IsValidElevatorArkCollisionBody(iPhysicsBody@ apBody)
		{
			if(apBody.IsActive()==false) return false;
			if(apBody.GetMass()==0) return false;
			
			iLuxEntity @pEntity = cLux_GetBodyEntity(apBody);
			if(pEntity == null) return false;
			
			return true;
		}

		//-------------------------------------------------------
		
		void OnUse_ARK_Elevator(const tString &in asEntity)
		{
			mbArkInElevator = true;
			Entity_PlaceAtEntity("ARK", asEntity, cVector3f(0, -0.375, -0.25), true);
			Sound_CreateAtEntity("PlaceARKElevator", "04_02_tau_inside/SFX/ark_elevator/put_down", "Player");
			
			////////////////////////////////////////
			// Get all entities colliding with Ark
			array<iPhysicsBody@> vBodies;
			iLuxEntity@ pArk = Map_GetEntity("ARK", eLuxEntityType_Prop);
			GetBodiesCollidingWithArk(vBodies);
			
			bool bDisableCollision = false;
			float fPushOffset = 0.2;
			for (int i = 0; i < vBodies.length(); i++)
			{				
				// Get the entity from the body
				iPhysicsBody @pBody = vBodies[i];
				if (IsValidElevatorArkCollisionBody(pBody)==false)
					continue;
				
				pBody.AddImpulse(cMath_Vector3Normalize(pBody.GetWorldPosition()-pArk.GetBody(0).GetWorldPosition())*5);
				Map_AddTimer(pBody.GetName(), fPushOffset, "Timer_CheckAndPushArkIntersection");
				fPushOffset+=0.05;
				mlArkCollisionCount++;
				
				bDisableCollision = true;
			}
			
			if (bDisableCollision)
			{
				pArk.GetBody(0).SetCollide(false);
                // S26AO: this is a duration marker polled by the push timers below.
                // HPL supports an empty callback; the old callback name had no definition.
                Map_AddTimer("ArkCollisionCheckTimeout", 3, "");
				cLux_AddDebugMessage("Disabled ARK collision");
			}
		}
		
		///////////////////////////
		// Pushes away an entity that has been detected as colliding 
		// with the ark when it was placed in elevator
		void Timer_CheckAndPushArkIntersection(const tString &in asTimer)
		{
			if (mlArkCollisionCount==0) return;
			if (cLux_GetCurrentMap()==null || cLux_GetCurrentMap().GetPhysicsWorld() == null) return;
			
			iLuxEntity@ pArk = Map_GetEntity("ARK", eLuxEntityType_Prop);
			
			iPhysicsBody @pBody = cLux_GetCurrentMap().GetPhysicsWorld().GetBody(asTimer);
			
			// Push the body away from the ARK
			if (pBody!=null && pArk.IsActive())
			{
				iLuxEntity @pEntity = cLux_GetBodyEntity(pBody);
				if (Entity_GetCollide(pEntity.GetName(), "ARK"))
				{
					pBody.AddImpulse(cMath_Vector3Normalize(pBody.GetWorldPosition()-pArk.GetBody(0).GetWorldPosition())*5);
					
					if (Map_TimerExists("ArkCollisionCheckTimeout"))
					{
						Map_AddTimer(asTimer, 0.25, "Timer_CheckAndPushArkIntersection");
						return;
					}
				}
			}
			
			// Either no longer colliding or the timeout timer has passed, so stop pushing
			mlArkCollisionCount--;
			if (mlArkCollisionCount==0 || Map_TimerExists("ArkCollisionCheckTimeout")==false)
			{				
				mlArkCollisionCount=0;
				pArk.GetBody(0).SetCollide(true);
			}
		}

		//-------------------------------------------------------
			
		void OnArkElevatorRemoval()
		{
			mbArkInElevator = false;
			
			////////////////////////////////////////
			// Get all entities colliding with Ark
			array<iPhysicsBody@> vBodies;
			iLuxEntity@ pArk = Map_GetEntity("ARK", eLuxEntityType_Prop);
			GetBodiesCollidingWithArk(vBodies);
			
			bool bDisableCollision = false;
			float fPushOffset = 0.2;
			for (int i = 0; i < vBodies.length(); i++)
			{				
				// Get the entity from the body
				iPhysicsBody @pBody = vBodies[i];
				if (IsValidElevatorArkCollisionBody(pBody)==false)
					continue;
					
				pBody.AddForce(0.1);
			}
		}

		//-------------------------------------------------------
		
		bool Trigger_ArkInPosition(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==-1) return true;
			
			if (mlArkMisalignedCount == 0)
			{
				AlignArk();
			}
			return true;
		}

		//-------------------------------------------------------
		
		bool Trigger_ArkMisaligned(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlArkMisalignedCount+=alState;
			
			if (mlArkMisalignedCount==0 && Entity_GetCollide("ARK", "ArkHolderArea"))
			{
				AlignArk();
			}
			
			return true;
		}

		//-------------------------------------------------------
		
		void AlignArk()
		{
			cScript_SetGlobalReturnBool(false);
			cScript_RunGlobalFunc("MenuHandler","cScrMenuHandler","HPL3VR_GetRuntimeActive");
            // S26BI: entering the holder volume is not an authored Tool use.
            // A physical owned ARK overlaps this volume before the placement
            // transaction can run. Let that transaction release ownership after
            // CanUse_ARK/OnUse_ARK; never consume it from this alignment callback.
            if (cScript_GetGlobalReturnBool() && Player_ToolIsInInventory("ARK")) return;

			if (Entity_IsInteractedWith("ARK"))
			{
				Player_ChangeStateToNormal();
				Player_SetLookSpeedMul(0);
				Player_FadeLookSpeedMulTo(1, 1);
			}
			
			iLuxEntity@ pArk = Map_GetEntity("ARK");
			float fRightX = cMath_MatrixInverse(pArk.GetMatrix()).GetRight().x;
			
			cLux_AddDebugMessage("fRightX "+fRightX);
			
			tString sStrickyArea = "ArkStickyArea_1";
			if (fRightX > 0)
				sStrickyArea = "ArkStickyArea_2";
			
			Entity_SetActive(sStrickyArea, true);
			StickyArea_AttachEntity(sStrickyArea, "ARK", "");
		}

		//-------------------------------------------------------
		
		void OnChangeArkHolderButton(const tString &in asEntity, int alState)
		{
			if (alState == -1) return;
			
			if (Button_IsSwitchedOn("AirlockControlPanel"))
			{
				cLux_AddTodoMessage("Sound: Error sound");
				Sound_CreateAtEntity("ArkLiftError", "Entities_Station/tech/terminal_beeps/terminal_computer_denied", asEntity);
				Map_AddTimer(asEntity, 0.3, "TimerSetMovingButtonOff");
				return;
			}
			
			Seq_LowerARKHolder("");
		}

		//-------------------------------------------------------
		
		cSequenceStatesData mLowerARKHolderSequence;
			
		void Seq_LowerARKHolder(const tString &in asTimer)
		{
			Sequence_Begin("Seq_LowerARKHolder", mLowerARKHolderSequence);
				
			if (Sequence_DoStepAndWait(2.5))
			{
				Entity_SetVarString("AirlockControlScreen", "State", "Attaching");
				Entity_PlayAnimation("ArkHolder", "down", 0, false, false);
				Entity_PlayAnimation("ArkHolderCable", "cable_down", 0, false, false);
				
				if(mbArkAttached==true)
				{
					Sound_CreateAtEntity("ArkLowerEmpty", "04_02_tau_inside/SFX/robot_arm/cargo_arm_lower_empty", "ArkHolder");
				}
				else if(mbArkAttached==false)
				{
					Sound_CreateAtEntity("ArkLowerFull", "04_02_tau_inside/SFX/robot_arm/cargo_arm_lower_full", "ArkHolder");
				}
			}
			
			else if (Sequence_DoStepAndWait(2.5))
			{
				////////////////////////
				// Detach ARK
				if (mbArkAttached)
				{
					Sound_CreateAtEntity("DetachArk", "04_02_tau_inside/SFX/robot_arm/ark_detach", "ARK");
					mbArkAttached = false;
					Entity_RemoveEntityAttachment("ARK");
					Entity_SetInteractionDisabled("ARK", false);
					Tool_SetHighlightActive("ARK", true);
				}
				
				////////////////////////
				// Attach ARK
				else if (Entity_GetCollide("ARK", "ArkHolderArea") && Entity_IsActive("ARK") && mlArkMisalignedCount == 0)
				{
					mbArkAttached = true;		
					Entity_AttachToSocket("ARK", "ArkHolder", "Claw", false, false);
					Entity_SetInteractionDisabled("ARK", true);
					Tool_SetHighlightActive("ARK", false);
					Sound_CreateAtEntity("AttachArk", "04_02_tau_inside/SFX/robot_arm/ark_attach", "ARK");
					
					Entity_SetVarString("AirlockControlScreen", "State", "CargoDetected");
				}
				
				////////////////////////
				// ARK misaligned error
				else
				{
					cLux_AddTodoMessage("Sound: Error sound");
					Sound_CreateAtEntity("ArkLiftError", "Entities_Station/tech/terminal_beeps/terminal_computer_denied", "ArkHolder");
				}
				Entity_PlayAnimation("ArkHolder", "up", 0, false, false);
				Entity_PlayAnimation("ArkHolderCable", "cable_up", 0, false, false);
				
				if(mbArkAttached==true)
				{
					Sound_CreateAtEntity("ArkRaiseEmpty", "04_02_tau_inside/SFX/robot_arm/cargo_arm_raise_empty", "ArkHolder");
				}
				else if(mbArkAttached==false)
				{
					Sound_CreateAtEntity("ArkRaiseFull", "04_02_tau_inside/SFX/robot_arm/cargo_arm_raise_full", "ArkHolder");
				}
			}
			else if (Sequence_DoStepAndWait(0))
			{
				MovingButton_SetSwitchedOn("ArkHolderButton", false, true);
				
				if (!mbArkAttached) Entity_SetVarString("AirlockControlScreen", "State", "Waiting");
			}
			Sequence_End();
		}
		
		//} END EVENT

