class cScrMap : iScrMap
{
	//--------------------------------------------

	/////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{///////////////////////////////////////

	//-------------------------------------------------------

	////////////////////////////
	// Set up map environment
	void Setup()
	{
		Effect_Bloom_FadeBrightPass(0.75f, 0.001);
		Effect_Bloom_FadeBloomWidth(128, 0.001);
		Effect_Bloom_FadeBloomFalloff(0.5f, 0.001);
		Effect_Bloom_FadeBloomTint(1, 1, 1, 0.001);

		/////////////////////////
		//4.3 Preset for transition
		Map_Preset_SetupBloom("Preset4.3", 64, 0.00001, 1, cColor(0.6,0.4,0.4,0));
		Map_Preset_SetupColorGrading("Preset4.3", "textures/colorgrading/grading_04_01.dds");
		Light_SetVisible("EndLight_*", false);
		
		GetBase().SetDisplayNameEntry("04-02-tau-inside");
		RichPresence_SetCurrent(eRichPresence_SiteTau );
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		CathTool_ResetScreen(eCathToolVariant_CathAbyss);
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			//Add any debug stuff here
			
			cLux_SetDebugInfoWindowText("Text that should show up when pressing F1");
		}
		
		//Audio setup
		Sound_PreloadProject("04_02_tau_inside");
		Sound_PreloadGroup("Flashback/Ross/4.2", true);
		Sound_PreloadGroup("Flashback/Level/04_02", true);
		Sound_PreloadGroup("Entities_Station/doors/tau/auto_door", true);
		
		Prop_SetAllowMapTransfer("ArkHolder", false);
		Prop_SetAllowMapTransfer("Ark", false);
		
		Map_SetUnderwater(false);	
		SetupEnterSiteAndExplore();
		SetupTurnOffReactor();
		SetupExploreLivingArea();
		SetupFindArkAndLastHuman();
		SetupUseAirlock();
		
		//Entity setup	
		Entity_StopAnimation("swingdoor_tau_large_*");
		Entity_SetInteractionDisabled("tv_community_room_distortion_1", true);
		
		//Particle setup
		ParticleSystem_SetActive("door_spray_*", false);
		ParticleSystem_SetActive("pipe_spray_*", false);
		ParticleSystem_SetActive("AirlockPipe_*", false);
		
		PlayerHands_SetHandModel_DeepSea();
		
		Map_AddTimer("AirlockSpotUpdate", 1.0f, "AirlockStartingSpotUpdate");
		
		if(cLux_ScriptDebugOn()==false)
		{
			Seq_Intro("");
		}
		else
		{

		}
		
		/////////////////////////
		// Eye tracking
		EyeTracking_RegisterEntity("Ivashkin", true, true, true, 15.0f, 4.0f);
		
		LastOnSoma_SetText("04_02_tau_inside_1");
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
		// S26P: this map's entity metadata names InteractArk,
		// but no such callback exists. Remove only this stale generic interaction
		// hook in VR. The separate Pickup/Use/CanBeUsed callbacks still own the story.
		cScript_SetGlobalReturnBool(false);
		cScript_RunGlobalFunc("MenuHandler","cScrMenuHandler","HPL3VR_GetRuntimeActive");
		if(cScript_GetGlobalReturnBool()) Entity_SetPlayerInteractCallback("ARK","",false);

		MainMenu_SetBGPhase(eMainMenuPhase_3_3_To_End);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
	}

	//-------------------------------------------------------

	////////////////////////////
	// The player has died.
	void OnPlayerKilled(int alRecentDeaths, const tString&in asSource)
	{
	}

	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test1)
		{
			Effect_DoF_Reset();
			mlDofID = -1;
			
			cLuxClosestEntityData pData;
			if (!cLux_GetClosestEntity(cLux_GetPlayer().GetCamera().GetPosition(),cLux_GetPlayer().GetCamera().GetForward(),100, 0, false, pData))
			{
				cLux_AddDebugMessage(""+pData.mpBody.GetName());
				return;
			}
			cLux_AddDebugMessage(""+pData.mpBody.GetName());
				
			tString sEntity = pData.mpEntity.GetName();
			
			SlideDoor_SetClosed(sEntity, SlideDoor_GetOpenAmount(sEntity)>0.5);
			MovingButton_SetLocked(sEntity, !MovingButton_IsLocked(sEntity), true);
			Lamp_SetLit(sEntity, !Lamp_GetLit(sEntity), true);
		}
		
		if(alAction == eAction_Test2)
		{
			Entity_SetActive("DivingMonster_Stalker", true);
			Agent_SetSensesActive("DivingMonster_Stalker", true);
			//NPC_SetMainAnimation("Lindwall", "dying_scared", false, "", 0.3);
			
		}
		
		if(alAction == eAction_Test3)
		{
			Entity_SetActive("Lindwall", true);
		}
		
		if(alAction == eAction_Test4)
		{
			Player_MoveHeadPos(cVector3f_Down*0.25, 1, 1, 0.1);
		}
		
		if(alAction == eAction_Test5)
		{
			ParticleSystem_CreateAtEntity("ElevatorPanelSpark", "elec_spark_physics_oneshot.ps", "ElevatorBreakdownSpark", false);
			Sound_CreateAtEntity("ElevatorPanelSparkSound", "01_02_upsilon_inside_02/sfx/flower_bulb_break", "ElevatorBreakdownSpark");
		}
		
		if(alAction == eAction_Test6)
		{
			OnChange_AirlockControlPanel("", 1);
		}
		if(alAction == eAction_Test7)
		{
			//Tool_PickUp("ARK", true, true);
			
			Entity_SetActive("DivingMonster_Stalker", true);
			
			Pathfinder_Track_Clear("DivingMonster_Stalker");
			Pathfinder_Track_Add("DivingMonster_Stalker", "PathNodeArea_315");
			Pathfinder_Track_Start("DivingMonster_Stalker");
			
		}
		if(alAction == eAction_Test8)
		{
			//Player_Teleport("StartInEndAirlock");
			//Preload();
			//Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
		//OnChangeUnlockARK("", 1);
			//Tool_PickUp("ARK", true, true);
			
			Player_SetHealth(1);
			
		//	Map_AddTimer("LivingArea_FridgeCompressor_SoundStart", 1.0f, "LivingArea_FridgeCompressor_SoundStart");
		}
		
		 if(alAction == eAction_Test9)
		{ 
			
			Visibility_SetAreaActive("machineworkshop", false); 
			Visibility_SetAreaActive("chase02", false);
			Visibility_SetAreaActive("chase_outside", false);
			Visibility_SetAreaActive("maze_after_2nd_door", false);
			Visibility_SetAreaActive("chase01", false);
			Visibility_SetAreaActive("biolab", false);
			Visibility_SetAreaActive("maze_middle01", false);
			Visibility_SetAreaActive("maze_middle02", false);
			Visibility_SetAreaActive("maze_biolab_window", false);
			Visibility_SetAreaActive("maze_biolab_corridor", false);
			Visibility_SetAreaActive("reactor_control", false);
			Visibility_SetAreaActive("window_surprise", false);
			Visibility_SetAreaActive("maze_reactor", false);
			Visibility_SetAreaActive("maze_window", false);
			Visibility_SetAreaActive("machineworkshop_corridor02", false);
			Visibility_SetAreaActive("starting_airlock", false);
			Visibility_SetAreaActive("startcorridor", false);
			
			Visibility_SetAreaActive("chase_ladder", false);
			Visibility_SetMainActive(false);
		}
		
	}
	

