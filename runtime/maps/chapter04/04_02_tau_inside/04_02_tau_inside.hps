	/////////////////////////////////////////
	// ==============
	// SCENE 4 *FIND ARK AND LAST HUMAN*
	// ==============
	//{///////////////////////////////////////

	//-------------------------------------------------------
	
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 4 General
		//{///////////////////////////////////////

		//-------------------------------------------------------
	
		int mlLindwallTalkCount = 0;
		bool mbInsideInfirmary = false;
		bool mbLifeSupportActive = true;

		//-------------------------------------------------------
		
		void SetupFindArkAndLastHuman()
		{
			Terminal_SetImGuiStateInt("InfirmaryTerminal", "CurrentRoom", eIntercomRoom_Infirmary);
			Entity_SetVarBool("ARK", "Attached", true);
			
			Entity_PlayAnimation("Lindwall", "idle", 0, true);
		}
		
		//} END GENERAL

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 4 Event A *Enter infirmary (dialog)*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbHasEnteredInfirmary = false;
		bool mbHasActivatedHeartbeat = false;

		//-------------------------------------------------------
		
		bool Doorway_ApproachingInfirmary(const tString &in asArea, const tString &in asEntity, int alState)
		{
			Entity_SetActive("Lindwall", alState==1);
			
			if (alState==1)
			{
				Entity_SetActive("Ivashkin", false);
			}
			else
			{
				Entity_SetActive("Ivashkin", MovingButton_IsSwitchedOn("LivingAreaDoorButton_1_7"));
			}
			
			if (mbHasActivatedHeartbeat==false) Timer_LifeSupportBeat("");
			mbHasActivatedHeartbeat = true;
			
			return true;
		}

		//-------------------------------------------------------
		
		bool Trigger_EnterInfirmary(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mbLastHumanDead)
				return true;
				
			HeadTracker_SetActive("Lindwall", alState == 1);
			Voice_SetSource("Lindwall", "Lindwall", 2, 12, true, -1, 22000,400,eLuxVoiceSourceFreqencyFlag_LowPass);
			if (alState == 1)
			{
				Map_RemoveTimer("TimerLeftInfirmary");
				Map_AddTimer("TimerEnterInfirmary", 1, "TimerEnterInfirmary");
				
				if (!mbHasEnteredInfirmary)
				{
					Music_Play("04_02_lasthuman.ogg", 0.55, false, eMusicPrio_BigEvent);
					mbHasEnteredInfirmary = true;
				}
			}
			else
			{
				Map_RemoveTimer("TimerEnterInfirmary");
				Map_AddTimer("TimerLeftInfirmary", 0.5, "TimerLeftInfirmary");
			}
			return true;
		}

		//-------------------------------------------------------
		
		void TimerEnterInfirmary(const tString &in asTimer)
		{
			mbInsideInfirmary = true;
			Voice_PlayWhenPossible("4_EnterInfirmary", "", 3, 0.5, "", -1);
			
			Map_AddTimer("Timer_LindwallIdleTalk", 5, "Timer_LindwallIdleTalk");
		}

		//-------------------------------------------------------
		
		void TimerLeftInfirmary(const tString &in asTimer)
		{
			mbInsideInfirmary = false;
			AbortIdleTalk();
			
			if (Map_TimeHasPassed("LeftInfirmaryComment", 5) == false)
				return;

			if (mlLindwallTalkCount == 0)
				Voice_PlayWhenPossible("4_LeftInfirmary_NoTalk", "", 3, 0.5, "", -1);
			else
				Voice_PlayWhenPossible("4_LeftInfirmary_Talked", "", 3, 0.5, "", -1);
		}

		//-------------------------------------------------------
		
		void Timer_LindwallIdleTalk(const tString &in asTimer)
		{
			if (mbLifeSupportActive==false) return;
			
			cLux_AddDebugMessage("Queued");
			
			Voice_PlayWhenPossible("4_LastHumanIdle_NoTalk", "VoiceCondition_LindwallIdleTalk", -1, 5, "VoiceOver_LindwallIdleTalk", -2);
			Voice_PlayWhenPossible("4_LastHumanIdle_Talked", "VoiceCondition_LindwallIdleTalk", -1, 5, "VoiceOver_LindwallIdleTalk", -2);
		}

		//-------------------------------------------------------
		
		bool VoiceCondition_LindwallIdleTalk(const tString &in asSubject)
		{
			if (mbLifeSupportActive==false) return false;
			if (mbInsideInfirmary==false) return false;
			if (asSubject == "4_LastHumanIdle_NoTalk" && mlLindwallTalkCount != 0)
				return false;
			if (asSubject == "4_LastHumanIdle_Talked" && mlLindwallTalkCount == 0)
				return false;
			
			return true;
		}

		//-------------------------------------------------------
		
		void AbortIdleTalk()
		{
			Map_RemoveTimer("Timer_LindwallIdleTalk");
			Voice_AbortIfQueued("4_LastHumanIdle_NoTalk");
			Voice_AbortIfQueued("4_LastHumanIdle_Talked");
		}

		//-------------------------------------------------------
		
		void VoiceOver_LindwallIdleTalk(const tString&in asScene, const tString&in asSubject)
		{
			float fMin = 5;
			float fMax = 12;
			if (mlLindwallTalkCount > 0)
			{
				fMin = 12;
				fMax = 18;
			}
			
			Map_AddTimer("Timer_LindwallIdleTalk", cMath_RandRectf(fMin, fMax), "Timer_LindwallIdleTalk");
		}
		
		//} END EVENT

