		//-------------------------------------------------------
		bool voice_3_InteractInfirmaryDoorPanel = false;
		void TimerPlayVoice(const tString &in asTimer)
		{
			if(asTimer=="3_InteractInfirmaryDoorPanel" && voice_3_InteractInfirmaryDoorPanel== false)
			{
				Sound_CreateAtEntity("InfirmaryDoorPanelLindwallLine", "Flashback/Level/04_02/Lindwall_InteractInfirmaryDoorPanel/sfx", "LivingAreaDoorButton_1_9");
				Map_AddTimer("LindwallInfirmaryDoorPanelVoiceDelay", 0.21f, "LindwallInfirmaryDoorPanelVoice");
				Map_AddTimer("LindwallInfirmaryDoorPanelStingMusic", 4.0f, "LindwallInfirmaryDoorPanelStingMusic");
				Sound_FadeGlobalVolume(0.65f, 2.0f);
				Map_AddTimer("ResetMixer", 4.0f, "LivingAreaMixerReset");
				voice_3_InteractInfirmaryDoorPanel = true;
			}
			else
			{
				Voice_Play(asTimer);
			}
		}
		
		//-------------------------------------------------------
		
		void LindwallInfirmaryDoorPanelVoice(const tString &in asTimer)
		{
			Voice_SetSource("Lindwall", "LivingAreaDoorButton_1_9", 2, 8, true, -1, 400, 1500, eLuxVoiceSourceFreqencyFlag_HighPass);
			Voice_Play("3_InteractInfirmaryDoorPanel");
		}
		
		//-------------------------------------------------------
		
		void TimerSetInteractionEnabled(const tString &in asTimer)
		{
			Entity_SetInteractionDisabled(asTimer, false);
		}
		
		//-------------------------------------------------------
		
		void TimerFlesherChasePlayer(const tString &in asTimer)
		{
			if (Entity_IsActive(asTimer)==false)
				return;
				
			Flesher_HuntPlayer(asTimer);
			Agent_RevealPlayerPosition(asTimer);
			Map_AddTimer(asTimer, 1, "TimerFlesherChasePlayer");
		}
		
		//-------------------------------------------------------
		
		void TimerDiverChasePlayer(const tString &in asTimer)
		{
			if (Entity_IsActive(asTimer)==false)
				return;
				
			InfectedRobot_ForceHuntState(asTimer);
			Agent_RevealPlayerPosition(asTimer);
			Map_AddTimer(asTimer, 1, "TimerDiverChasePlayer");
		}

		//-------------------------------------------------------
		
		void Timer_SetAgentSensesActive(const tString &in asTimer)
		{
			cLux_AddDebugMessage("SENSES ACTIVE!!!");
			Agent_SetSensesActive(asTimer, true);
		}
		
		//-------------------------------------------------------
		
		void TimerCheckARKEquip(const tString &in asTimer)
		{
			// S26N: physical ownership/stowing replaces the stock HUD auto-equip.
			// Keep the timer alive so a save reopened in flatscreen resumes stock behavior.
			cScript_SetGlobalReturnBool(false);
			cScript_RunGlobalFunc("MenuHandler", "cScrMenuHandler", "HPL3VR_GetRuntimeActive");
			if (cScript_GetGlobalReturnBool())
			{
				Map_AddTimer("timer_checkARKEquip", 1.0f, "TimerCheckARKEquip");
				return;
			}
			if (Player_ToolIsInInventory("ARK"))
			{
				//Map_SetInteractionWhiteListActive(true,false);
				Map_AddTimer("timer_checkARKEquip",0.2f,"TimerCheckARKEquip");
			}
			else
			{
				Map_AddTimer("timer_checkARKEquip",1.0f,"TimerCheckARKEquip");
				//Map_SetInteractionWhiteListActive(false,false);
			}
				
			int lPlayerState = cLux_GetPlayer().GetCurrentStateId();	
			if (lPlayerState== ePlayerState_Terminal)
			{
				Player_UnequipTool(false);
			}
			else
			{
				Player_EquipTool("ARK");
			}
		}
		//-------------------------------------------------------
		
		//} End generic timers
		
