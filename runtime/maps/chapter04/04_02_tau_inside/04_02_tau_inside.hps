		void Timer_LindwallAnim(const tString &in asTimer)
		{
			NPC_PlayExtraAnimation("Lindwall", "idle_talk_deep_breath", 0.3);
		}
		
		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 4 Event C *Kill Last Human (dialog)*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		int mlKillLastHumanLine = 0;
		bool mbLastHumanDead = false;
		bool mbPlayedLastHumanDeathMusic = false;
		
		float mfHeartBeatPulseStart = 1;
		float mfHeartBeatPulseTarget = 0;
		float mfHeartBeatPulseFadeTime = 1.0f;
		
		float mfHeartBeatTimeStart = 1.5f;
		float mfHeartBeatTimeTarget = 1.5f;
		float mfHeartBeatTimeFadeTime = 1.0f;

		//-------------------------------------------------------
		bool abDisableDialogSoundAllowed = true;
		void OnGuiLifeSupport(const tString&in asEntityName, float afTimeStep)
		{
			cImGuiLabelData label = ImGui_GetDefaultLabel();
			label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
			label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.075);
			label.mFontAlign = eFontAlign_Left;
			
			cImGuiButtonData disableButton = StationGui_CreateDefaultButtonData();
			disableButton.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.1);
			disableButton.mbClipText = false;
			
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();
			
			ImGui_SetTransCategory("04_02_tau_inside");
			
			bool bLifeSupportActive = ImGui_GetStateBool("LifeSupportActive", true);
						
			if (ImGui_GetStateBool("ShowDisableDialog", false))
			{
				cGuiDialogBoxSettings box = StationGui_CreateDefaultDialogBox();
				box.mType = eGuiDialogBoxType_OKCancel;
				box.mvSize = ImGui_NrmSize(0.875, 0.6);
				box.mWindow.mFont.mvSize = 48;
				box.mTextFrame.mFont.mvSize = 48;
				box.mButton.mvDefaultSize *= 1.5;
				box.mButton.mFont.mvSize *= 1.5;
				eGuiDialogCode returnCode = Depth_ImGui_DialogBox("LifeSupportTerminal_TurnOffHeader", "LifeSupportTerminal_TurnOffWarning", box);
				if(abDisableDialogSoundAllowed == true)
				{
					Sound_CreateAtEntity("WarningDialogue", "Entities_Station/tech/life_support/machine_off_beep", ImGui_GetName(), 0.0f, false, 1.0f);
					Sound_CreateAtEntity("ForwardDialogue", "Entities_Station/tech/terminal_beeps/pathOS_comp/pathOS_comp_ forward", ImGui_GetName(), 0.0f, false, 1.0f);
					abDisableDialogSoundAllowed = false;	
				}

				
				if (returnCode == eGuiDialogCode_Cancel)
				{
					Sound_CreateAtEntity("WarningCancelFeedback", "Entities_Station/tech/terminal_beeps/terminal_negative", ImGui_GetName(), 0.0f, false, 1.0f);
					Sound_Stop("WarningDialogue", 0.25f);
					ImGui_SetStateBool("ShowDisableDialog", false);
					abDisableDialogSoundAllowed = true;
				}
				else if (returnCode == eGuiDialogCode_OK)
				{
					Sound_CreateAtEntity("WarningOKFeedback", "Entities_Station/tech/life_support/confirm_beep", ImGui_GetName(), 0.0f, false, 1.0f);
					Sound_Stop("WarningDialogue", 0.25f);
					ImGui_SetStateBool("ShowDisableDialog", false);
					ImGui_SetStateBool("LifeSupportActive", false);
					abDisableDialogSoundAllowed = true;
					
					Seq_LifeSupportDisabled("");
					Entity_SetInteractionDisabled("Lindwall_Interact",true);
					
				}
				return;
			}
			
			ImGui_DoWindowStart("", StationGui_CreateDefaultWindowData(), 
								ImGui_NrmPos(cVector3f(0.05, 0.05, 1)), ImGui_NrmSize(cVector2f(0.9, 0.9)));

				// Resize and reposition for translation
				float fLabelLength = GetFontLengthW(label.mFont, 1, "LifeSupportTerminal_Label");
				ImGui_ResizeFontToFit("LifeSupportTerminalStatus_Inactive", label.mFont, ImGui_GetCurrentGroupSize().x*0.915-fLabelLength);
				ImGui_ResizeFontToFit("LifeSupportTerminalStatus_Active", label.mFont, ImGui_GetCurrentGroupSize().x*0.915-fLabelLength);
				
				ImGui_DoLabelExt("LifeSupportTerminal_Label", label, ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 1)), -1);
				ImGui_SetModColorMul(bLifeSupportActive ? cColor_Green : cColor_Red);
				tString sStatus = bLifeSupportActive ? "Active" : "Inactive";
				ImGui_DoLabelExt("LifeSupportTerminalStatus_"+sStatus, label, ImGui_NrmPosGroup(0.065, 0.05, 1)+cVector3f_Right*fLabelLength, -1);
				ImGui_SetModColorMul(cColor_White);
				
				float fThickAdd = GetLifeSupportPulseValue()*0.019;
				ImGui_DoImage(cImGuiGfx(""), ImGui_NrmPosGroup(cVector3f(0.05, 0.3-fThickAdd*0.5f, 2)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.006+fThickAdd)));
				
				float fButtonTextLength = GetFontLengthW(disableButton.mFont, 1, "LifeSupportTerminal_TurnOffButton");
				ImGui_SetAlignment(eImGuiAlign_TopCenter);
				ImGui_SetModUseInput(bLifeSupportActive);
				if (ImGui_DoButtonExt("DisableButton", "LifeSupportTerminal_TurnOffButton", disableButton,
							   ImGui_NrmPosGroup(cVector3f(0.5, 0.6, 2)), ImGui_NrmSizeGroup(0.075, 0.2)+cVector2f(fButtonTextLength, 0)))
				{
					ImGui_SetStateBool("ShowDisableDialog", true);
				}
				ImGui_SetModUseInput(true);
				ImGui_SetAlignment(eImGuiAlign_TopLeft);
				
			ImGui_DoWindowEnd();
		}
		
		float GetLifeSupportPulseValue()
		{
			if (Map_TimerExists("Timer_LifeSupportPulse")==false)
				return mfHeartBeatPulseTarget;
			
			float fFract = 1.0f-(Map_GetTimerTime("Timer_LifeSupportPulse")/mfHeartBeatPulseFadeTime);
			return cMath_InterpolateLinear(mfHeartBeatPulseStart, mfHeartBeatPulseTarget, fFract);
		}
		
		void FadeLifeSupportPulse(float afTarget, float afTime)
		{
			mfHeartBeatPulseStart = GetLifeSupportPulseValue();
			mfHeartBeatPulseFadeTime = afTime;
			mfHeartBeatPulseTarget = afTarget;
			
			Map_RemoveTimer("Timer_LifeSupportPulse");
			Map_AddTimer("Timer_LifeSupportPulse", afTime, "");
		}
		
		void Timer_LifeSupportBeat(const tString &in asTimer)
		{
			if (asTimer == "Timer_LifeSupportBeat_On")
			{
				float fTime = 0.125;
				Map_AddTimer("Timer_LifeSupportBeat_Off", fTime, "Timer_LifeSupportBeat");
				FadeLifeSupportPulse(1, fTime);
				
				if(mbInfirmarySoundEnabler == true)
				{
					Sound_CreateAtEntity("HeartBeatBeep", "Entities_Station/tech/life_support/heart_beep", "LifeSupportTerminal");
				}
			}
			else
			{
				float fTime = 0.125;
				FadeLifeSupportPulse(0, fTime);
				
				Map_AddTimer("Timer_LifeSupportBeat_On", GetLifeSupportBeatTimeValue(), "Timer_LifeSupportBeat");
			}
		}

		//-------------------------------------------------------
		
		float GetLifeSupportBeatTimeValue()
		{
			if (Map_TimerExists("Timer_LifeSupportBeatTimeFade")==false)
				return mfHeartBeatTimeTarget;
			
			float fFract = 1.0f-(Map_GetTimerTime("Timer_LifeSupportBeatTimeFade")/mfHeartBeatTimeFadeTime);
			return cMath_InterpolateLinear(mfHeartBeatTimeStart, mfHeartBeatTimeTarget, fFract);
		}
		
		void FadeLifeSupportBeatTime(float afTarget, float afTime)
		{
			mfHeartBeatTimeStart = GetLifeSupportBeatTimeValue();
			mfHeartBeatTimeFadeTime = afTime;
			mfHeartBeatTimeTarget = afTarget;
			
			Map_RemoveTimer("Timer_LifeSupportBeatTimeFade");
			Map_AddTimer("Timer_LifeSupportBeatTimeFade", afTime, "");
		}

		//-------------------------------------------------------
		
		void StartFlatline()
		{
			//////////////////////////////////
			// Initialize flatline state
			Map_RemoveTimer("Timer_LifeSupportBeat_On");
			Map_RemoveTimer("Timer_LifeSupportBeat_Off");
			FadeLifeSupportPulse(0, 0.125);
			if(mbInfirmarySoundEnabler == true)
			{
				//flat line
				//add flatline check to infirmary sound enabler
			}
		}

		//-------------------------------------------------------
		
		cSequenceStatesData mLifeSupportDisabledSequence;
			
		void Seq_LifeSupportDisabled(const tString &in asTimer)
		{
			Sequence_Begin("Seq_LifeSupportDisabled", mLifeSupportDisabledSequence);
			
			if (Sequence_DoStepAndPause(0))
			{
				Entity_SetInteractionDisabled("ArkUnlockButton", false);
				
				
				mbLifeSupportActive = false;
				AbortIdleTalk();
				
				if(mbLifeSupportMachineSoundActive == true)
				{
					Sound_CreateAtEntity("LifeSupportIdleOff", "Entities_Station/tech/life_support/machine_off", "LifeSupportSoundSource");
					Sound_Stop("LifeSupportIdle", 0.25f);
					mbLifeSupportMachineSoundActive = false;
				}
				
				HeadTracker_SetActive("Lindwall", false);
				Entity_SetInteractionDisabled("Lindwall_Interact", true);
				Entity_RemoveCollideCallback("Player", "InsideInfirmary");
				if (mlLindwallTalkCount > 0)
				{
					Voice_Stop("Lindwall");
					Voice_Play("4_KillLastHuman_Start", -1, "VoiceLastHumanDeathTalk");
					Entity_AddCollideCallback("Player", "InsideInfirmary", "Trigger_InfirmaryLastHumanDeath");
					Entity_SetVarBool("InsideInfirmary", "IgnoreEnterCallback", true);
					
					NPC_SetMainAnimation("Lindwall", "dying_calm", true, "", 0.3);
				}
				else
				{
					Entity_SetInteractionDisabled("ArkUnlockButton", true);
					Map_AddTimer("Timer_UnlockArk", 2, "Timer_UnlockArk");
					
					VoiceLastHumanDeathTalk("", "");
					
					NPC_SetMainAnimation("Lindwall", "dying_scared", true, "", 0.3);
				}
			}
			
			///////////////
			// Final line 
			else if (Sequence_DoStepAndPause(0))
			{
				bool bPlayerInsideInfirmary = Entity_GetCollide("Player", "InsideInfirmary");
				
				if (bPlayerInsideInfirmary==false || mlLindwallTalkCount==0)
				{
					cLux_AddDebugMessage("mlLindwallTalkCount==0");
					SequenceStates_Resume("Seq_LifeSupportDisabled");
				}
				else
				{
					Voice_Stop("Lindwall");
					Voice_Play("4_KillLastHuman_End_Staying", -1, "VoiceLastHumanDies");
					
					if (!mbPlayedLastHumanDeathMusic)
					{
						mbPlayedLastHumanDeathMusic = true;
						Map_AddTimer("LastHumanDeathMusic", 11.5f, "LastHumanDeathMusic");
					}
				}
			}

			
			///////////////////////////////
			// Last human death animation
			else if (Sequence_DoStepAndPause(0))
			{
				bool bPlayerInsideInfirmary = Entity_GetCollide("Player", "InsideInfirmary");
				
				tString sEmotion = "scared";
				if (bPlayerInsideInfirmary  && mlLindwallTalkCount>0)
					sEmotion = "calm";

				NPC_SetMainAnimation("Lindwall", "", true, "", 0);
				Entity_PlayAnimation("Lindwall", "dying_final_"+sEmotion, 3, false, true, "AnimationLastHumanDead");
				Entity_RemoveCollideCallback("Player", "InsideInfirmary");
			}
			
			///////////////////////////////
			// Last human is totally dead
			else
			{
				mbLastHumanDead = true;
				
				if(mlAmbientStage < 3)
				{
					mlAmbientStage++;
				}
				
				Entity_SetCustomInteractIcon("Lindwall_Interact", eCrossHairState_Datamine);
				Entity_SetPlayerInteractCallback("Lindwall_Interact", "DatamineLastHuman", true);
				Entity_SetInteractionDisabled("Lindwall_Interact", false);
				
				cLux_AddDebugMessage("Last human is totally dead");
				StartFlatline();
				
				bool bPlayerInsideInfirmary = Entity_GetCollide("Player", "InsideInfirmary");
								
				if (!mbPlayedLastHumanDeathMusic && bPlayerInsideInfirmary && mlLindwallTalkCount > 0)
				{
					mbPlayedLastHumanDeathMusic = true;
				}
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void LastHumanDeathMusic(const tString &in asTimer)
		{
			if(Entity_GetCollide("Player", "InsideInfirmary")==true)
			{
				Music_Play("04_02_lasthuman_dead.ogg", 0.95, false, eMusicPrio_BigEvent);
			}
		}

		//-------------------------------------------------------
		
		void AnimationLastHumanDead(const tString &in asEntityName, const tString &in asAnimName)
		{
			SequenceStates_Resume("Seq_LifeSupportDisabled");
		}

		//-------------------------------------------------------
		
		void VoiceLastHumanDies(const tString&in asScene, const tString&in asSubject)
		{
			SequenceStates_Resume("Seq_LifeSupportDisabled");
		}

		//-------------------------------------------------------
		
		void VoiceLastHumanDeathTalk(const tString&in asScene, const tString&in asSubject)
		{		
			Map_AddTimer("LastHumanDeathTalkTimer", 1.2f, "TimerLastHumanDeathTalk");
		}
		
		void TimerLastHumanDeathTalk(const tString &in asTimer)
		{
			if (mbLastHumanDead) return;
			
			
			
			tString sSubject = "4_KillLastHuman_Left";
			bool bPlayerInside = Entity_GetCollide("Player", "InsideInfirmary");
			if (bPlayerInside && mlLindwallTalkCount>0)
				sSubject = "4_KillLastHuman_Staying";
			
			int lLine = Voice_GetSubjectLineNumber(sSubject);
			cLux_AddDebugMessage(sSubject+""+lLine +" vs " +mlKillLastHumanLine);
			
			if (Voice_GetSubjectLineNumber(sSubject)<=mlKillLastHumanLine)
			{
				SequenceStates_Resume("Seq_LifeSupportDisabled");
				return;
			}
			
			Voice_Stop("Lindwall");
			Voice_Play(sSubject, mlKillLastHumanLine, "VoiceLastHumanDeathTalk");
			
			IncLastHumanLine();
		}

		//-------------------------------------------------------
		
		void IncLastHumanLine()
		{
			// Decrease heart rate as the dialog progresses
			if (mlKillLastHumanLine%3==0)
			{
				int lStep = mlKillLastHumanLine/3;
				float fTarget = 1.4f+float(lStep)*0.5f;
				fTarget = cMath_Max(0.2, fTarget);
				FadeLifeSupportBeatTime(fTarget, 12);
				//Terminal_FadeImGuiStateFloat("LifeSupportTerminal", "HeartBeatTime", fTarget, 12, eEasing_Linear);
			}
			
			mlKillLastHumanLine++;
			cLux_AddDebugMessage("mlKillLastHumanLine "+mlKillLastHumanLine);
		}

		//-------------------------------------------------------
		
		bool Trigger_InfirmaryLastHumanDeath(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				if (Entity_GetVarBool(asChild, "IgnoreEnterCallback"))
					return true;
				
				Map_RemoveTimer("TimerLeftInfirmary");
				Map_AddTimer("TimerEnterInfirmary", 1, "TimerEnterInfirmary_LastHumanDeath");
			}
			else
			{
				Map_RemoveTimer("TimerEnterInfirmary");
				Map_AddTimer("TimerLeftInfirmary", 1, "TimerLeftInfirmary_LastHumanDeath");
				
				Entity_SetVarBool(asChild, "IgnoreEnterCallback", false);
			}
			
			return true;
		}

		//-------------------------------------------------------
		
		void TimerEnterInfirmary_LastHumanDeath(const tString &in asTimer)
		{
			mbInsideInfirmary = true;
			
			// Just kill immediately if the player returns right at the end
			if (mlKillLastHumanLine > 9)
			{
				cLux_AddDebugMessage("InstaKill");
				SequenceStates_Resume("Seq_LifeSupportDisabled");
				Voice_Stop("Lindwall");
				Map_RemoveTimer("LastHumanDeathTalkTimer");
				
				Entity_RemoveCollideCallback("Player", "InsideInfirmary");
				return;
			}
					
			NPC_SetMainAnimation("Lindwall", "dying_calm", true, "", 1);
			
			// Lindwall comments on player returning
			if (Map_TimeHasPassed("ReEnterInfirmary", 8))
			{
				Voice_Stop("Lindwall");
				Voice_Play("4_KillLastHuman_ReEnter", -1, "VoiceLastHumanDeathTalk", 1);
				Map_RemoveTimer("LastHumanDeathTalkTimer");
			}
			
			// Next line should be one that makes some sense to start with
			while (mlKillLastHumanLine != 1 && mlKillLastHumanLine != 3 && 
				   mlKillLastHumanLine != 8 && mlKillLastHumanLine != 9)
			{
				IncLastHumanLine();
			}
		}

		//-------------------------------------------------------
		
		void TimerLeftInfirmary_LastHumanDeath(const tString &in asTimer)
		{
			mbInsideInfirmary = false;
			NPC_SetMainAnimation("Lindwall", "dying_scared", true, "", 1);
		}
		
		//} END EVENT
		
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 4 Event D *Sit down on bed*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void InteractSitOnBed(const tString &in asEntity)
		{
			for (int i = 3; Entity_Exists("SitOnBedAnim_"+i); i++)
			{
				Entity_AttachToEntity("SitOnBedAnim_"+i, "SitOnBedAnim_2", "", false);
			}
			
			cVector3f vPlayerOffset = Entity_GetDeltaToEntity(asEntity, "Player");
			cVector3f vCamAnimOffset = Entity_GetDeltaToEntity(asEntity, "SitOnBedAnim_2");
			vCamAnimOffset.z = cMath_Clamp(vPlayerOffset.z, -1, 1);
			
			Entity_PlaceAtEntity("SitOnBedAnim_2", asEntity, vCamAnimOffset);
			
			CameraAnimation_Begin("SitOnBedAnim", "", true);
			Sound_CreateAtEntity("SitOnBedAnim", "04_02_tau_inside/SFX/foley/infirmary_bed_sit", "Player");
		}
		
		bool StandUpAnim(const tString &in asEntity, int alDirection)
		{
			cLux_AddDebugMessage("Stand anim direction "+alDirection);
			if(alDirection==1)
			{
				Sound_CreateAtEntity("StandFromBedAnim", "04_02_tau_inside/SFX/foley/infirmary_bed_stand", "Player");
			}
			else
			{
				Sound_Stop("StandFromBedAnim", 0.25f);
			}
			return true;
		}
		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 4 Event E *Get the ARK and Take it to Diving Room #2 (dialog)*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void OnGuiArkTerminal(const tString&in asEntityName, float afTimeStep)
		{					
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();
			
			ImGui_SetTransCategory("04_02_tau_inside");
			
			bool bARKAttached = Entity_GetVarBool("ARK", "Attached");
			
			tString sStatus = bARKAttached ? "Active" : "Paused";
			StationGui_BigStatusMessage_Old("ARKTerminal_"+sStatus, bARKAttached ? gStationGuiColor_Highlight : gStationGuiColor_Warning, 1.75);
		}

		//-------------------------------------------------------
		
		bool mbLastOnSomaTextSet = false;
        // S26CV: pickup is still inside the authored placement volume. Reuse
        // the physical-key-item exit gate; a timer alone permits instant re-use.
        void VR_ArmArkPickupExitGate()
        {
            cScript_SetGlobalReturnBool(false);
            cScript_RunGlobalFunc("MenuHandler", "cScrMenuHandler", "HPL3VR_GetRuntimeActive");
            if(!cScript_GetGlobalReturnBool()) return;
            array<tString> areas={"CargoElevatorArea_1", "CargoElevatorArea_2", "CargoElevatorArea_3", "ArkPlacementArea"};
            for(uint i=0;i<areas.length();++i)
            {
                if(!Entity_GetCollide("ARK",areas[i])) continue;
                Entity_SetVarString("ARK","VRReturnSlot","");
                Entity_SetVarString("ARK","VRReturnArea",areas[i]);
                return;
            }
        }

		bool OnPickup_ARK(const tString &in asTool)
		{
            VR_ArmArkPickupExitGate();
			if(mbLastOnSomaTextSet==false)
			{
				LastOnSoma_SetText("04_02_tau_inside_2");
				mbLastOnSomaTextSet = true;
			}
			Entity_SetActive("AirlockControlPanel_ToolArea", false);
			Entity_SetInteractionDisabled("CargoElevatorArea_*", false);
			
			PickUpArkSound();
			
			//SetupARKInteraction();
			Map_AddTimer("timer_checkARKEquip",0.2f,"TimerCheckARKEquip");
			
			if (mbArkInElevator)
			{
				OnArkElevatorRemoval();
			}
			
			
			if (mbLastHumanDead || mlLindwallTalkCount <= 0) return true;
			
			if (mbLifeSupportActive)
			{
				//Entity_SetInteractionDisabled("Lindwall_Interact", true);
				//Entity_SetInteractionDisabled("LifeSupportTerminal", true);
				Map_AddTimer("4_DetachArk_TalkedNoKill", 0.25, "TimerLastHumanArkReaction");
			}
			else if (mlKillLastHumanLine<=7)
			{
				Map_RemoveTimer("LastHumanDeathTalkTimer");
				Map_AddTimer("4_DetachArk_TalkedKill", 0.5, "TimerLastHumanArkReaction");
			}
			
			
			return true;
		}
		
		
		
		void PickUpArkSound()
		{
			if(Entity_GetCollide("Player", "PlayerAirlockCollider"))
			{
				Sound_CreateAtEntity("PickUpArkTable", "04_02_tau_inside/SFX/robot_arm/table/pick_up", "Player");
			}
			
			if(Entity_GetCollide("Player", "ArkClampArea"))
			{
				Sound_CreateAtEntity("PickUpArkLindwall", "04_02_tau_inside/SFX/lindwall_ark/pick_up", "Player");
			}
			
			if(Entity_GetCollide("Player", "ArkElevatorAreaUpStairs"))
			{
				Sound_CreateAtEntity("PickUpArkElevator", "04_02_tau_inside/SFX/ark_elevator/pick_up", "Player");
			}
		
			if(Entity_GetCollide("Player", "ArkElevatorAreaDownstairs"))
			{
				Sound_CreateAtEntity("PickUpArkElevator", "04_02_tau_inside/SFX/ark_elevator/pick_up", "Player");
			}
		}

		//-------------------------------------------------------
		
		void TimerLastHumanArkReaction(const tString &in asTimer)
		{
			if (mbLifeSupportActive)
				Voice_PlayWhenPossible(asTimer, "VoiceCondition_ArkReaction", 7, 5, "VoiceLastHumanArkReaction");
			else
				Voice_PlayWhenPossible(asTimer, "", 7, 5, "VoiceLastHumanDeathTalk", 2);
		}
		
		bool VoiceCondition_ArkReaction(const tString &in asSubject)
		{
			if (mbLifeSupportActive == false)
			{
				Voice_Play(asSubject, -1, "VoiceLastHumanDeathTalk", 2);
				return false;
			}
			return true;
		}

		//-------------------------------------------------------
		
		void VoiceLastHumanArkReaction(const tString&in asScene, const tString&in asSubject)
		{
			Entity_SetInteractionDisabled("Lindwall_Interact", false);
			//Entity_SetInteractionDisabled("LifeSupportTerminal", false);
		}

		//-------------------------------------------------------
		
		void Interact_Ladder(const tString &in asEntity)
		{
			if (Player_ToolIsInInventory("ARK"))
			{
				Voice_Play("4_ClimbLadderWithARK");
				return;
			}
			
			// TEMP SOLUTION TO PLAYER BODY STILL BEING "IN WATER" AFTER CLIMBING UP LADDER
			if (asEntity == "LadderArea_6_Interact")
			{
				if (Entity_GetCollide("Player", "Airlock2Water"))
				{
					cLuxLiquidArea@ pLiquidArea = cLux_ToLiquidArea(Map_GetEntity("Airlock2Water"));
					cLux_GetPlayer().RemoveUsedLiquidArea(pLiquidArea);
				}
			}
			// TEMP
			
			Entity_CallEntityInteract(Entity_GetVarString(asEntity, ""));
		}
		
		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 4 Event F *Interact with Infirmary Terminal*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void EnterInfirmaryTerminal(const tString&in asEntityName)
		{
			if (mlKillLastHumanLine>0)
				return;
			Voice_PlayWhenPossible("4_InfirmaryTerminal_NotTalked", "VoiceCondition_InfirmaryTerminalComment", 10, 1);
			Voice_PlayWhenPossible("4_InfirmaryTerminal_Talked", "VoiceCondition_InfirmaryTerminalComment", 10, 1);
				
			Terminal_SetEnterCallback("InfirmaryTerminal", "");
		}

		//-------------------------------------------------------
		
		bool VoiceCondition_InfirmaryTerminalComment(const tString &in asSubject)
		{
			if (mlKillLastHumanLine>0) 
				return false;
			if (Entity_IsInteractedWith("InfirmaryTerminal")==false)
			{
				cLux_AddDebugMessage("Entity_IsInteractedWith");
				return false;
			}
			if (asSubject=="4_InfirmaryTerminal_NotTalked" && mlLindwallTalkCount!=0)
				return false;
			if (asSubject=="4_InfirmaryTerminal_Talked" && mlLindwallTalkCount==0)
				return false;
			return true;
		}
		
		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 4 Event G *Datamine Last Human*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void DatamineLastHuman(const tString &in asEntity)
		{
			Voice_Play("4_TryDataminingLindwall");
		}
		
		//} END EVENT
	
	//} END SCENE 1

