		//-------------------------------------------------------
	
		void SetupExploreLivingArea()
		{
			Voice_SetSource("Lindwall", "Lindwall", 2, 50, true);
			HeadTracker_SetAngleOffset("Lindwall", -20);
			
			Entity_StopAnimation("LivingAreaDoor_*");
			Entity_StopAnimation("CargoElevatorDoor_*");
			SetCargoElevatorDoorOpen(1, true, true);
			
			SetupDoorPanels("LivingAreaDoorPanel_*");
			SetupDoorPanels("AirlockDoorPanel_*");
			
			ParticleSystem_SetActive("ElevatorBrokenSmoke_*", false);
			
			SetupDoorButtonConnections("LivingAreaDoor");
			
			Entity_SetInteractionDisabled("CargoElevatorArea_1", true);
			Entity_SetInteractionDisabled("CargoElevatorArea_2", true);
			Entity_SetInteractionDisabled("CargoElevatorArea_3", true);
		}

		//-------------------------------------------------------
		
		void OnGuiLivingAreaDoorStatus(const tString&in asEntityName, float afTimeStep)
		{
			cImGuiTextFrameData text = ImGui_GetDefaultTextFrame();
			text.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
			text.mFontAlign = eFontAlign_Center;
			text.mbUseBackgroundGfx = false;
			
			ImGui_SetTransCategory("04_02_tau_inside");
			
			tString sButton = Entity_GetVarString(asEntityName, "Button");
			
			// Sanity check
			if (sButton=="")
			{
				ImGui_SetTransCategory("");
				text.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.19);
				ImGui_DoTextFrameExt("Panel-Door connection error", 0, 0, 0, text, ImGui_NrmPosGroup(cVector3f(0, 0.15, 0)), ImGui_NrmSizeGroup(1));
				return;
			}
			
			if (MovingButton_IsLocked(sButton))
			{
				text.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.19);
				ImGui_DoTextFrameExt("LivingAreaDoorStatus_Locked", 0, 0, 0, text, ImGui_NrmPosGroup(cVector3f(0, 0.35, 0)), ImGui_NrmSizeGroup(1));
			}
			else
			{
				text.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.19);
				ImGui_DoTextFrameExt("LivingAreaDoorStatus_Unlocked", 0, 0, 0, text, ImGui_NrmPosGroup(cVector3f(0, 0.4, 0)), ImGui_NrmSizeGroup(1));
			}
		}

