		void Timer_StartDivingMonsterDeathPatrol(const tString &in asTimer)
		{
			Pathfinder_Track_Clear("DivingMonster_Chase_Slow");
			Pathfinder_Track_Add("DivingMonster_Chase_Slow", "PathNodeArea_136");
			Pathfinder_Track_Add("DivingMonster_Chase_Slow", "PathNodeArea_45");
			Pathfinder_Track_Start("DivingMonster_Chase_Slow", true);
			Agent_SetSensesActive("DivingMonster_Chase_Slow", true);
		}
		
