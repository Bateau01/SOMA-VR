	//Broken airlock - spot control
    //-------------------------------------------------------
	void Timer_ExitAirlockDoorSpotHandler(const tString &in asTimer)
	{
		Audio_BrokenAirlockSpotHandler();
	}

	//-----------------------------------
	bool mbAirlockBrokenSpotsActive = false;
	void Audio_BrokenAirlockSpotHandler()
	{
		bool bSpotControl = false;
		//////////////////////////////////
		// Check if player is inside areas
		if (Entity_GetCollide("player","AirlockSpotControl_PreAirlockSpace")) bSpotControl = true;
		
		if (Entity_GetCollide("player","AirlockSpotControl_PreAirlockSpace_Ladder") && 
		Button_IsSwitchedOn("LivingAreaDoorButton_2_12")) bSpotControl = true;
		
		if (Entity_GetCollide("player","AirlockSpotControl_AirlockSpace") && 
		Button_IsSwitchedOn("AirlockDoorButton_1_2")) bSpotControl = true;

		if (bSpotControl == true && mbAirlockBrokenSpotsActive == false)
		{
			//Start sound
			Sound_CreateAtEntity("DivingRoomPipeArea_3_1", "04_02_tau_inside/SFX/airlock_end_break/water/spray", "DivingRoomPipeArea_1_1", 3.0f, true, 1.0f);
			Sound_CreateAtEntity("DivingRoomPipeArea_3_2", "04_02_tau_inside/SFX/airlock_end_break/water/spray", "DivingRoomPipeArea_1_2", 3.0f, true, 1.0f);
			Sound_CreateAtEntity("DivingRoomPipe_2_Water", "04_02_tau_inside/SFX/airlock_end_break/water/spray", "DivingRoomPipeArea_2", 3.0f, true, 1.0f);
			
			Sound_CreateAtEntity("DivingRoomPipeWaterSplatArea_1", "04_02_tau_inside/SFX/airlock_end_break/water/splat", "DivingRoomPipeWaterSplatArea_1", 1.0f, true, 1.0f);
			Sound_CreateAtEntity("DivingRoomPipeWaterSplatArea_2", "04_02_tau_inside/SFX/airlock_end_break/water/splat", "DivingRoomPipeWaterSplatArea_2", 1.0f, true, 1.0f);
			Sound_CreateAtEntity("DivingRoomPipeWaterSplatArea_3", "04_02_tau_inside/SFX/airlock_end_break/water/splat", "DivingRoomPipeWaterSplatArea_3", 1.0f, true, 1.0f);
			
			mbAirlockBrokenSpotsActive = true;
			cLux_AddDebugMessage("Airlock spots active");
		}
		else if(bSpotControl == false && mbAirlockBrokenSpotsActive == true)
		{
			Sound_Stop("DivingRoomPipeArea_3_1", 1.0f);
			Sound_Stop("DivingRoomPipeArea_3_2", 1.0f);
			Sound_Stop("DivingRoomPipe_2_Water", 1.0f);
			
			Sound_Stop("DivingRoomPipeWaterSplatArea_1", 1.0f);
			Sound_Stop("DivingRoomPipeWaterSplatArea_2", 1.0f);
			Sound_Stop("DivingRoomPipeWaterSplatArea_3", 1.0f);
			
			mbAirlockBrokenSpotsActive = false;
			cLux_AddDebugMessage("Airlock spots inactive");
		}
		else if (mbAirlockBrokenSpotsActive == true)
		{
			cLux_AddDebugMessage("Airlock spots already active");
		}
		Map_AddTimer("Timer_ExitAirlockDoorHandler", 1.5f, "Timer_ExitAirlockDoorSpotHandler");
	}
	
