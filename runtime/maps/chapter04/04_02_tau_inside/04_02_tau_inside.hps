		/////////////////////////////////////////
		// Scene 1 Extra Event *Leviathan glimpse*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		int mlLeviathanShakeID = -1;

		//-------------------------------------------------------
		
		void LookAt_LeviathanGlimpse(const tString &in asEntity, int alState)
		{
			Seq_LeviathanGlimpse("");
		}

		//-------------------------------------------------------
		
		cSequenceStatesData mLeviathanGlimpseSequence;
			
		void Seq_LeviathanGlimpse(const tString &in asTimer)
		{
			Sequence_Begin("Seq_LeviathanGlimpse", mLeviathanGlimpseSequence);
				
			if (Sequence_DoStepAndWait(0.8))
			{
				Player_FadeMoveSpeedMulTo(0.75, 0.5);
				Sound_CreateAtEntity("LeviathanDrone", "04_02_tau_inside/SFX/leviathan_tremors/window_sighting", "Player");
				
				Map_AddTimer("LeviathanWindowDustPS_1", 0.5, "Timer_LeviathanWindowDust");
				Map_AddTimer("LeviathanWindowDustPS_2", 1, "Timer_LeviathanWindowDust");
				Map_AddTimer("LeviathanWindowDustPS_3", 1.75, "Timer_LeviathanWindowDust");
				Map_AddTimer("LeviathanWindowDustPS_4", 1.25, "Timer_LeviathanWindowDust");
				Map_AddTimer("LeviathanWindowDustPS_5", 2, "Timer_LeviathanWindowDust");
				Map_AddTimer("LeviathanWindowDustPS_6", 0.25, "Timer_LeviathanWindowDust");
				Map_AddTimer("LeviathanWindowDustPS_7", 0.6, "Timer_LeviathanWindowDust");
			}
			else if (Sequence_DoStepAndWait(0.15))
			{
				mlLeviathanShakeID = Effect_Shake_Start(0.025, -1, 2, 0);
				Effect_Shake_SetSourceEntity(mlLeviathanShakeID, "Leviathan", 3, 30);
			}
			else if (Sequence_DoStepAndWait(0.15))
			{
				Lamp_SetFlickerActive("LeviathanWindowLamp", true);
			}
			else if (Sequence_DoStepAndWait(0.1))
			{
				Entity_SetActive("Leviathan", true);
				CharMover_SetWallAvoidanceActive("Leviathan", false);
				Pathfinder_MoveToNode("Leviathan", "LeviathanTarget");
				Sound_FadeGlobalVolume(0.35f, 2.0f);
				
				Player_FadeMoveSpeedMulTo(1, 0.5);
			}
			else if (Sequence_DoStepAndWait(3.9))
			{
				Leviathan_SetSpeed_Hunt("Leviathan");
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Lamp_SetFlickerActive("LeviathanWindowLamp", false);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Sound_FadeGlobalVolume(1.0f, 6.0f);
				Entity_SetActive("Leviathan", false);
				Effect_Shake_FadeOut(mlLeviathanShakeID, 3);
				Music_Play("04_02_reactorroom", 0.7f, false, eMusicPrio_BigEvent);
			}
			Sequence_End();
		}

		//-------------------------------------------------------
		
		void Timer_LeviathanWindowDust(const tString &in asTimer)
		{
			ParticleSystem_CreateAtEntityExt(asTimer+"_Particle", "04_02_dust_falling_corridor", asTimer, false, cColor(1,1,1,0.4), 0.5);
		}
		
		//} END EVENT
		
