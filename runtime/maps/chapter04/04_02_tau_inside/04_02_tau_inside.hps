		//-------------------------------------------------------
		
		bool mbUsingTalkAnimation = false;
		
		//-------------------------------------------------------
		
		void TimerLindwallTalkAnimation(const tString &in asTimer)
		{
			if (mbLifeSupportActive) return;
			
			/*if (Voice_CharacterIsSpeaking("Lindwall"))
			{
				if (!mbUsingTalkAnimation)
					NPC_SetMainAnimation("Lindwall","idle_talk");
					
				mbUsingTalkAnimation = true;
			}
			else
			{
				if (mbUsingTalkAnimation)
					NPC_SetMainAnimation("Lindwall","idle");
					
				mbUsingTalkAnimation = false;
			}*/
			
			Map_AddTimer("timer_lindwalltalkanim",0.1f,"TimerLindwallTalkAnimation");
		}
		
		//------------------------------------------------------------
		
		void InteractLindwall(const tString &in asEntity)
		{
			bool bRepeatingLine = true;
			if (Voice_SubjectExists("4_TalkToLastHuman_"+(mlLindwallTalkCount+1)))
			{
				mlLindwallTalkCount++;
				bRepeatingLine = false;
			}
				
			if (bRepeatingLine)
			{
				Dialog_StartConversation("Lindwall", "Lindwall", 0.5,cVector3f_Up );
			}
			else
			{
				Player_MoveHeadPos(cVector3f_Down*0.25, 1, 1, 0.1);
				Dialog_StartConversation_PosBased("Lindwall", "Lindwall", "LindwallConvArea", "head1");
			}
			Dialog_Begin();
				Dialog_AddBranchAndSubject("4_TalkToLastHuman_"+mlLindwallTalkCount, "", "SubjectLindwallConvoDone");
			Dialog_End();
			
			Entity_SetInteractionDisabled("Lindwall_Interact", true);
			cLux_AddDebugMessage("InteractLindwall 2");
			
			if (mbLifeSupportActive && bRepeatingLine==false)
			{
				NPC_SetMainAnimation("Lindwall","idle_talk", true, "", 0);
				HeadTracker_SetActive("Lindwall",true);
				HeadTracker_SetTargetEntity("Lindwall", "LindwallConvHeadTarget");
				HeadTracker_SetAngleOffset("Lindwall", 0);
			}
			//TimerLindwallTalkAnimation("");
		}
		
		//------------------------------------------------------------
		
		void SubjectLindwallConvoDone(const tString &in asSubject, bool abStartOfSubject)
		{
			if (abStartOfSubject) return;
			
			Entity_SetInteractionDisabled("Lindwall_Interact", false);
			Player_MoveHeadPos(0, 1, 1, 0.1);
			
			if (mbLifeSupportActive)
			{
				NPC_SetMainAnimation("Lindwall","idle", true, "", 0);
				HeadTracker_SetActive("Lindwall",true);
				HeadTracker_SetTargetEntity("Lindwall", "Player");
				HeadTracker_SetAngleOffset("Lindwall", -20);
			}
			
			Achievement_Unlock(eAchievement_LastHuman);
		}

		//-------------------------------------------------------
		bool mbLindwallPressingButton = false;
		void LineOver_UnlockARK(const tString &in asScene, const tString &in asSubject, int alLineIndex, bool abStart)
		{
			if (abStart==false)
			{
				Map_AddTimer("idle_talk_deep_breath", 1, "Timer_LindwallAnim");
				return;
			}
			
			NPC_PlayExtraAnimation("Lindwall", "idle_talk_press_button", 0.15);
			Map_AddTimer("Timer_UnlockArk", 2.25, "Timer_UnlockArk");
			mbLindwallPressingButton = true;
		}

		//-------------------------------------------------------
		
		void Timer_UnlockArk(const tString &in asTimer)
		{
			Button_SetSwitchedOn("ArkUnlockButton", false, true);
			mbLindwallPressingButton = false;
		}

		//-------------------------------------------------------
		
		void OnChangeUnlockARK(const tString &in asEntity, int alState)
		{
			Entity_SetVarBool("ARK", "Attached", false);
			//Prop_SetStaticPhysics("ARK", false);
			Entity_SetInteractionDisabled("ARK", false);
			Tool_SetHighlightActive("ARK", true);
			
			if(mbLindwallPressingButton==false)
			{
				Sound_CreateAtEntity("ArkUnlockButton", "04_02_tau_inside/SFX/lindwall_ark/ark_release_beep", "ArkUnlockButton");
			}
			
			Map_RemoveTimer("ArkButton_FadeOut");
			Map_RemoveTimer("ArkButton_FadeIn");
			Entity_FadeEffectBaseColor("ArkUnlockButton", cColor_White, 0.3);
			
			Map_AddTimer("ArkClampRelease", 1.5f, "ArkClampRelease");
		}
		
		void ArkClampRelease(const tString &in asTimer)
		{
			Entity_PlayAnimation("ArkClamp_*", "opening", 0, false, false, "");
			
			// Check if the infection in the storage should spread
			if (MovingButton_IsLocked("LivingAreaDoorButton_1_3")==false)
			{
				Entity_SetActive("StorageInfection_*", true);
				MovingButton_SetSwitchedOn("LivingAreaDoorButton_1_3", true, false);
				MovingButton_SetDisabled("LivingAreaDoorButton_1_3", true, false);
				MovingButton_SetSwitchedOn("LivingAreaDoorButton_2_3", true, false);
				MovingButton_SetDisabled("LivingAreaDoorButton_2_3", true, false);
				Terminal_SetGuiActive("LivingAreaDoorPanel_1_3", false);
				Terminal_SetGuiActive("LivingAreaDoorPanel_2_3", false);
			}
		}

		//-------------------------------------------------------
		
		void LineCallback_LastHuman_Anim(const tString &in asScene, const tString &in asSubject, int alLineIndex, bool abStart)
		{
			if (asSubject=="4_TalkToLastHuman_1")
			{
				if (alLineIndex==1)
				{
					if (abStart==false) return;
					NPC_PlayExtraAnimation("Lindwall", "idle_talk_expression_smile", 0.3);
				}
				if (alLineIndex==9)
				{
					if (abStart==false) return;
					NPC_PlayExtraAnimation("Lindwall", "idle_talk_expression_surprised", 0.3);
				}
				if (alLineIndex==11)
				{
					if (abStart==false) return;
					NPC_PlayExtraAnimation("Lindwall", "idle_talk_expression_surprised", 0.3);
				}
				if (alLineIndex==13)
				{
					if (abStart==false) return;
					NPC_PlayExtraAnimation("Lindwall", "idle_talk_expression_skeptical", 0.3);
				}
				if (alLineIndex==17)
				{
					if (abStart==false) return;
					NPC_PlayExtraAnimation("Lindwall", "idle_talk_expression_point_at_player", 0.3);
				}
				if (alLineIndex==21)
				{
					if (abStart==false) return;
					NPC_PlayExtraAnimation("Lindwall", "idle_talk_expression_emphasize", 0.3);
				}
				if (alLineIndex==25)
				{
					if (abStart==false) return;
					NPC_PlayExtraAnimation("Lindwall", "idle_talk_expression_show_self", 0.3);
				}
			}
		}

