		/////////////////////////////////////////
		// Scene 5 Event D *Close Airlock, Flush water by breaking pipe*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		int mlPipePulledCount = 0; 
		int mlEndRadialBlurID = -1;
		float mfRadialBlurMin = 0;
		float mfRadialBlurMax = 0;

		//-------------------------------------------------------
		
		bool CanUseCathTool(const tString &in asTool, const tString &in asEntity)
		{
			return asEntity=="AirlockControlPanel";
		}

		//-------------------------------------------------------
		
		bool OnUseCathTool(const tString &in asTool, const tString &in asEntity)
		{			
			if (mbArkAttached == false)
			{								
				OmniPanel_AccessDenied(asEntity, "04_02_tau_inside", "AirlockPanelStatus_ArkError");
			}
			else
			{
				Entity_SetActive("AirlockExitBlocker", true);
			}
			
			CathTool_UseOnPanel(asTool, asEntity);
			return false;
		}

		//-------------------------------------------------------
		
		void OnChange_AirlockControlPanel(const tString &in asEntity, int alState)
		{
			Entity_SetActive("AirlockControlPanel_ToolArea", false);
			Seq_ActivateEndAirlock("");
		}

		//-------------------------------------------------------
		
		void TimerStopAirlockPanelError(const tString &in asTimer)
		{
			Entity_SetVarString("AirlockControlScreen", "State", "Waiting");
			Entity_SetVarColor("AirlockControlScreen", "TextColor", cColor_White);
			Entity_SetInteractionDisabled("AirlockControlPanel_Interact", false);
		}

		//-------------------------------------------------------
		
		cSequenceStatesData mActivateEndAirlockSequence;
			
		void Seq_ActivateEndAirlock(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ActivateEndAirlock", mActivateEndAirlockSequence);
				
			if (Sequence_DoStepAndWait(1))
			{
				MovingButton_SetSwitchedOn("AirlockDoorButton_1_2", false, true);
				Terminal_SetGuiActive("AirlockDoorPanel_2_2", false, 0.5);
				MovingButton_SetLocked("AirlockDoorButton_2_2", true);
				Sound_Stop("DivingRoomPipe_*_Water", 1);
				
				Map_AddTimer("StopAmbientMusicQuickly", 1.0f, "AmbientMusicHandler");
				
				StationGui_SetActiveApp("AirlockControlScreen", eAirlockTerminalState_PressureDiff);
				Entity_SetVarString("AirlockControlScreen", "State", "Filling");
				Terminal_SetImGuiStateColor("AirlockControlScreen", "TextColor", cColor_White);
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				Sound_CreateAtEntity("BrokenPump", "04_02_tau_inside/SFX/airlock_end_flood/broken_pump_start", "AirlockExitPumpSource", 0.0f, false, 1.0f);
				Sound_FadeGlobalVolume(0.5, 3.0f);
				Sound_Stop("AirlockExitPumpIdleAir", 0.5f);
			}
			else if (Sequence_DoStepAndWait(3))
			{
				PreloadDeload();
				
				//fill with water here
				LiquidArea_MoveLinearTo("Airlock2Water","Airlock2Water_Target_1",0.1, 0.025, 0.25, false);
				Terminal_FadeImGuiStateFloat("AirlockControlScreen", "PressureMul", 0.075f, 14);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Sound_CreateAtEntity("AirlockCreaks", "04_02_tau_inside/SFX/airlock_end_flood/airlock_creaks", "Player", 0.0f, false, 1.0f);
				Effect_Shake_Start(0.01, 0, 1, 3);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Effect_Shake_Start(0.01, 0, 0.1, 1);
				Terminal_FadeImGuiStateFloat("AirlockControlScreen", "PressureMul", 0.1f, 1);
				Lamp_SetFlickerActive("Airlock2Lamp_*", true);
			}
			else if (Sequence_DoStepAndWait(1.2))
			{
				Effect_Shake_Start(0.01, 0, 0.1, 1);
				Terminal_FadeImGuiStateFloat("AirlockControlScreen", "PressureMul", 0.125f, 1.2);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Effect_Shake_Start(0.01, 0, 3, 5);				
				Entity_SetVarString("AirlockControlScreen", "State", "Malfunction");
				Terminal_SetImGuiStateColor("AirlockControlScreen", "TextColor", cColor_Red);
				
				LiquidArea_StopMovement("Airlock2Water");
				
				Lamp_SetFlickerActive("Airlock2Lamp_1", false);
				
				//Audio
				Sound_FadeGlobalVolume(0.4f, 8.0f);
				Sound_CreateAtEntity("AirlockExitTerminalAlarm", "04_02_tau_inside/SFX/airlock_end_flood/airlock_door_alarm", "AirlockExitTerminalAlarm");
				Map_AddTimer("AirlockExitTerminalAlarm", 1.6f, "AirlockExitTerminalAlarm");
				cLux_AddTodoMessage("Sound: Airlock flooding malfunction, airlock feels unstable.");
			}
			else if (Sequence_DoStepAndWait(0.1))
			{
				Effect_Shake_Start(0.01, 0, 0.1, 1);
			}
			else if (Sequence_DoStepAndWait(1.8))
			{
				Entity_SetActive("Airlock2Girder_1_Normal", false);
				Entity_SetActive("Airlock2Girder_1_Bent", true);
			}
			else if (Sequence_DoStepAndWait(0.1))
			{
				Effect_Shake_Start(0.01, 0, 0.1, 1);
			}
			else if (Sequence_DoStepAndWait(1.8))
			{
				Entity_SetActive("Airlock2Girder_2_Normal", false);
				Entity_SetActive("Airlock2Girder_2_Bent", true);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				mlAirlock2Shake = Effect_Shake_Start(0.005, -1, 5, 0, 1, 15);
				TimerMoanHack("TimerMoanHack");
				//Map_AddTimer("4_AirlockStopped", 4.0, "TimerPlayVoice");
				//Map_AddTimer("4_AirlockStopped", 3.0, "TimerVoiceMixer");
				Sound_FadeGlobalVolume(1.0f, 2.0f);
				
				for (int i = 1; Entity_Exists("AirlockPipe_"+i); i++)
				{
					Entity_PlayAnimation("AirlockPipe_"+i, "rattle", 0.2, true);
					Entity_SetInteractionDisabled("AirlockPipe_"+i, false);
					ParticleSystem_CreateAtEntity("AirlockPipe_"+i+"_Spray", "04_02_pipe_spray_4.ps", "AirlockPipe_"+i+"_PSArea", true);
					
					Sound_CreateAtEntity("AirlockPipe_"+i+"_Spray", "04_02_tau_inside/SFX/airlock_end_flood/pipe_water_pressure", "AirlockPipe_"+i+"_PSArea", 0.25f);
				}
			}
			else
			{
				Map_RemoveTimer("AirlockExitTerminalAlarm");
				Entity_SetVarString("AirlockControlScreen", "State", "Collapse");
			}
			Sequence_End();
		}
		
		void AirlockExitTerminalAlarm(const tString &in asTimer)
		{
			Sound_CreateAtEntity("AirlockExitTerminalAlarm", "04_02_tau_inside/SFX/airlock_end_flood/airlock_door_alarm", "AirlockExitTerminalAlarm");
			Map_AddTimer("AirlockExitTerminalAlarm", 1.6f, "AirlockExitTerminalAlarm");
		}


		//-------------------------------------------------------
		
		//////////////////////////////////////
		// This is just a hack to get continuous moaning sounds, should be fixed by Sam later on.
