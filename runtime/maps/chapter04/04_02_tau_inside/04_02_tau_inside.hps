		int mlFlesherMaxCheatPos = -1;

		//-------------------------------------------------------
		
		bool Trigger_ChaseFlesherAppears(const tString &in asParent, const tString &in asChild, int alState)
		{
			//Seq_StartChase("");
			return false;
		}

		//-------------------------------------------------------
		
		cSequenceStatesData mStartChaseSequence;
			
		void Seq_StartChase(const tString &in asTimer)
		{
			Sequence_Begin("Seq_StartChase", mStartChaseSequence);
				
			if (Sequence_DoStepAndWait(0.5))
			{
				cLux_AddDebugMessage("Seq_StartChase_1");
				Effect_VideoDistortion_Start(0.4, 1, 0.5, 3);
				//Voice_Play("2_StartChase");
			}
			else if (Sequence_DoStepAndPause(0))
			{
				cLux_AddDebugMessage("Seq_StartChase_2");
				tString sFlesher = "DivingMonster_Chase_Fast";
				if (Player_GetHealth() < 100)
					sFlesher = "DivingMonster_Chase_Slow";
					
				cLux_AddTodoMessage("Sound: Flesher appears.");
				Sound_CreateAtEntity("FlesherAppears", "flesher/vocalisations/screech", sFlesher);
				
				Map_AddTimer("TimerAutoStartChase", 4, "TimerAutoStartChase");
				Entity_SetActive("StartChaseTrigger_*", true);
				
				Entity_SetActive(sFlesher, true);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				cLux_AddDebugMessage("Seq_StartChase_3");
				tString sFlesher = "DivingMonster_Chase_Fast";
				if (Entity_IsActive(sFlesher)==false)
					sFlesher = "DivingMonster_Chase_Slow";
				
				Agent_SetViewRangeMul(sFlesher, 15);
				Agent_SetSensesActive(sFlesher, true);
				TimerDiverChasePlayer(sFlesher);
			}
			Sequence_End();
		}

		//-------------------------------------------------------

		bool Trigger_StartChase(const tString &in asParent, const tString &in asChild, int alState)
		{
/*			cLux_AddDebugMessage("Trigger_StartChase");
			Entity_SetActive("StartChaseTrigger_*", false);
			Map_RemoveTimer("TimerAutoStartChase");
			SequenceStates_Resume("Seq_StartChase");*/
			return false;
		}
		
		void TimerAutoStartChase(const tString &in asTimer)
		{
			cLux_AddDebugMessage("TimerAutoStartChase");
			Entity_SetActive("StartChaseTrigger_*", false);
			SequenceStates_Resume("Seq_StartChase");
		}

		//-------------------------------------------------------
		
		bool Trigger_FlesherChaseCheat(const tString &in asParent, const tString &in asChild, int alState)
		{
			int lIndex = cString_GetNumericSuffixInt(asChild);
			if (mlFlesherMaxCheatPos >= lIndex)
				return false;
				
			mlFlesherMaxCheatPos = lIndex;
			Entity_PlaceAtEntity("DivingMonster_Chase_*", asChild+"_Pos");
			Agent_FaceEntity("DivingMonster_Chase_*", asChild+"_LookAt");
			return false;
		}

		//-------------------------------------------------------
		
		bool Trigger_FlesherPassedCheatPos(const tString &in asParent, const tString &in asChild, int alState)
		{
			int lIndex = Entity_GetVarInt(asParent, "");
			if (mlFlesherMaxCheatPos >= lIndex)
				return false;
				
			mlFlesherMaxCheatPos = lIndex;
			
			return false;
		}

		//-------------------------------------------------------
		
		bool Trigger_ChaseEnd(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetInteractionDisabled("ChaseLadder", true);
			
			Agent_SetAutoDisableWhenOutOfSightActive("DivingMonster_Chase_Slow", true, 5);
			Agent_SetAutoDisableWhenOutOfSightActive("DivingMonster_Chase_Fast", true, 5);
			
			return false;
		}

		//-------------------------------------------------------
		
		void OnChangeChaseButton(const tString &in asEntity, int alState)
		{			
			if (alState == 1)
			{
				OnChangeDoorButton(asEntity, alState);
				return;
			}			
				
			Entity_SetInteractionDisabled(asEntity, true);
			Map_AddTimer(asEntity, 2, "TimerSetInteractionEnabled");
			
			if (alState==-1)
				Map_AddTimer(asEntity, 2, "TimerChaseDoorClosed");
			
			Entity_SetActive("CloseToEndChase", true);
			
			if (asEntity == "ChaseEndDoorButton_1_1")
				Lamp_SetLit("ChaseEndControl_Lamp", false, true);
		}

		//-------------------------------------------------------
		
		void TimerChaseDoorClosed(const tString &in asTimer)
		{
			bool bStopFlesher = true;
			tString sFlesher = "DivingMonster_Chase_Fast";
			if (Entity_IsActive(sFlesher)==false)
				sFlesher = "DivingMonster_Chase_Slow";
				
			Entity_SetInteractionDisabled(asTimer, false);
			MovingButton_SetLocked(asTimer, true);
			
			if (asTimer == "ChaseEndDoorButton_1_1")
				bStopFlesher = (Entity_GetCollide(sFlesher, "ChaseMidSection"))==false;
			else
				bStopFlesher = (Entity_GetCollide(sFlesher, "ChaseEndSection"))==false;
			
			if (bStopFlesher)
			{
				Entity_SetActive(sFlesher, false);
			}
		}

		//-------------------------------------------------------
		
		bool Trigger_FlesherAtLadder(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Trigger_FlesherAtLadder");
			if (Entity_GetCollide("Player", asParent))
			{
				cLux_AddDebugMessage("KILL");
				AttackMeter_AutoDamage(0.3, 1, true);
			}
			else
			{
				cLux_AddDebugMessage("STOP");
				Trigger_StopChaseFlesher("", "", 1);
			}
			return false;
		}

		//-------------------------------------------------------
		
		bool Trigger_StopChaseFlesher(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Stop the chase.");
			Agent_SetSensesActive("DivingMonster_Chase_*", false);
			Pathfinder_Stop("DivingMonster_Chase_Slow");
			Pathfinder_Stop("DivingMonster_Chase_Fast");
			Map_RemoveTimer("DivingMonster_Chase_Slow");
			Map_RemoveTimer("DivingMonster_Chase_Fast");
			InfectedRobot_ForceIdleState("DivingMonster_Chase_*");
			return false;
		}

