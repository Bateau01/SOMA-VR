	//-------------------------------------------------------
	
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 5 General
		//{///////////////////////////////////////

		//-------------------------------------------------------
	
		int mlAirlock2Shake = -1;

		//-------------------------------------------------------
		
		void SetupUseAirlock()
		{
			Tool_PickUp("CathTool", false, false);
			
			Entity_SetVarString("AirlockControlScreen", "State", "Waiting");
			Entity_SetVarColor("AirlockControlScreen", "TextColor", cColor_White);
			
			Entity_StopAnimation("AirlockDoor_*");
			
			Entity_PlayAnimation("ArkHolderCable", "cable_idle", 0, false, false);
			
			Entity_SetEffectBaseColor("AirlockDoorWarningLamp_2", cColor(0.161,0.027,0.027,1));
			Entity_SetEffectBaseColor("AirlockDoorWarningLamp_3", cColor(0.161,0.027,0.027,1));
			
			ParticleSystem_AttachToEntity("AirlockPipe_1_splash", "Airlock2Water");
			ParticleSystem_AttachToEntity("AirlockPipe_2_splash", "Airlock2Water");
			ParticleSystem_AttachToEntity("AirlockPipe_3_splash", "Airlock2Water");
		}
		
		//} END GENERAL

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 5 Event A *Find Catherine's Pad*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void OnGuiCatherinePad(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("04_02_tau_inside");
			ImGui_SetStateVector3f("Pos_1", cVector3f(0.375, 0.21, 0.2));
			ImGui_SetStateVector3f("Pos_2", cVector3f(0.675, 0.325, 0.2));
			ImGui_SetStateVector3f("Pos_3", cVector3f(0.7, 0.35, 0.2));
			ImGui_SetStateVector3f("Pos_4", cVector3f(0.9, 0.5, 0.2));
			ImGui_SetStateVector3f("Pos_5", cVector3f(0.675, 0.85, 0.2));
			OnGuiCrewTabletApp("CatherinePadLogin", "cathtablet_photo", "CatherinePadFile", 5);
		}
		
		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 5 Event B *Interact with airlock door*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void OnChangeAirlockDoorButton(const tString &in asEntity, int alState)
		{			
			Seq_OpenAirlockDoor("");
			
			Entity_SetConnectionStateChangeCallback(asEntity, "OnChangeDoorButton");
		}

		//-------------------------------------------------------
		
		cSequenceStatesData mOpenAirlockDoorSequence;
			
		void Seq_OpenAirlockDoor(const tString &in asTimer)
		{
			Sequence_Begin("Seq_OpenAirlockDoor", mOpenAirlockDoorSequence);
				
			if (Sequence_DoStepAndWait(2))
			{
				//SetDoorButtonsLocked("AirlockDoor_2", true);
				Entity_SetInteractionDisabled("AirlockDoorButton_1_2", true);
					
				cLux_AddTodoMessage("Sound: Pumping water from airlock.");
				Sound_CreateAtEntity("PumpBreakStart", "04_02_tau_inside/SFX/airlock_end_break/broken_motor", "AirlockBrokenPumpSource");
				Sound_CreateAtEntity("PumpBreakStartMoan", "04_02_tau_inside/SFX/airlock_end_break/broken_wronks", "AirlockBrokenPumpSource");
				Sound_FadeGlobalVolume(0.55f, 5.0f);
				
				Entity_SetVarString("AirlockDoorPanel_1_2", "CustomMessage", "AirlockDoorStatus_Flushing");
				Entity_SetVarString("AirlockDoorPanel_2_2", "CustomMessage", "AirlockDoorStatus_Flushing");
			}
			else if (Sequence_DoStepAndWait(2))
			{
				mlAirlock2Shake = Effect_Shake_Start(0.0012, -1, 0.5, 0);
				Effect_Shake_SetSourceEntity(mlAirlock2Shake, "AirlockDoor_2", 1, 10);
			}
			else if (Sequence_DoStepAndWait(4))
			{
				Sound_CreateAtEntity("PumpBreak", "04_02_tau_inside/SFX/airlock_end_break/broken_motor_break", "AirlockBrokenPumpSource");
			}
			else if (Sequence_DoStepAndWait(1))
			{
				int lEffectID = Effect_Shake_Start(0.01, 0.5, 0.1, 0.5);
				Effect_Rumble_Start(0.5, 1.25, 0, 0.75);
				Effect_Shake_SetSourceEntity(lEffectID, "AirlockDoor_2", 2, 15);
				
				Entity_SetVarString("AirlockDoorPanel_1_2", "CustomMessage", "AirlockDoorStatus_Error");
				Entity_SetVarString("AirlockDoorPanel_2_2", "CustomMessage", "AirlockDoorStatus_Error");
				
				Effect_Shake_FadeOut(mlAirlock2Shake, 0.5);
				mlAirlock2Shake = Effect_Shake_Start(0.005, -1, 0.5, 0);
				Effect_Shake_SetSourceEntity(mlAirlock2Shake, "AirlockDoor_2", 4, 20);
			}
			else if (Sequence_DoStepAndWait(3))
			{
				Sound_CreateAtEntity("Airlock2Alarm", "04_02_tau_inside/SFX/airlock_end_break/broken_alarm", "AirlockDoorWarningLamp_1", 0, true);
				Map_AddTimer("Airlock2DoorAlarm", 1.6f, "Airlock2DoorAlarmSound");
				Map_AddTimer("Airlock2Alarm", 1.0f, "Airlock2AlarmSound");
				Depth_Audio_Fear_MediumIntensity(8.0f, 15.0f, 1, false, true);
				Sound_CreateAtEntity("pipe_break_01", "04_02_tau_inside/SFX/airlock_end_break/pipe_break_01", "DivingRoomPipeArea_3_1", 1.0f, true, 1.0f);
				Sound_CreateAtEntity("pipe_break_02", "04_02_tau_inside/SFX/airlock_end_break/pipe_break_02", "DivingRoomPipeArea_3_2", 1.0f, true, 1.0f);
				
				
				Lamp_SetLit("AirlockDoorWarningLamp_1", true, true);
				Lamp_SetLit("AirlockDoorWarningLamp_2", true, true);
				Map_AddTimer("AirlockDoorWarningLamp_3", 0.5, "TimerSetLampLit");
				
				iLuxEntity@ pSpinningLamp = Map_GetEntity("AirlockDoorWarningLamp_1", eLuxEntityType_Prop);
				cVector3f vRotateAxis = cMath_MatrixInverse(pSpinningLamp.GetMatrix()).GetForward();
				Prop_RotateToSpeed("AirlockDoorWarningLamp_1", 10, 7.5, vRotateAxis, true, "");
				
				Lamp_SetFlickerActive("DiveRoomLamp_*", true);
				Map_AddTimer("DiveRoomLamp_1", 3, "TimerSetLampUnlit");
				Map_AddTimer("DiveRoomLamp_2", 4.5, "TimerSetLampUnlit");
				Map_AddTimer("DiveRoomLamp_3", 3.25, "TimerSetLampUnlit");
				Map_AddTimer("DiveRoomLamp_4", 5, "TimerSetLampUnlit");
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				LiquidArea_MoveLinearTo("Airlock2Water","Airlock2Water_Target_DivingRoom",0.1, 0.125, 0.25, false);
				Effect_Shake_Start(0.02, 3, 0.1, 2);
				
				//ParticleSystem_CreateAtEntity(Entity_GetVarString("DiveRoomDoorFoamArea_1", ""), "spray_foam_continous_nowarmup.ps", "DiveRoomDoorFoamArea_1", true);
				//ParticleSystem_CreateAtEntity(Entity_GetVarString("DiveRoomDoorFoamArea_2", ""), "spray_foam_continous_nowarmup.ps", "DiveRoomDoorFoamArea_2", true);
				ParticleSystem_SetActive("door_spray_1", true);
				ParticleSystem_SetActive("door_spray_2", true);
				ParticleSystem_CreateAtEntity(Entity_GetVarString("DiveRoomDoorFoamArea_3", ""), "04_02_airlock_door_leak_foam1.ps", "DiveRoomDoorFoamArea_3", true);
				
				Sound_CreateAtEntity("DoorBreach", "04_02_tau_inside/SFX/airlock_end_break/door_breach", "AirlockBrokenPumpSource");
				Sound_FadeGlobalVolume(1.0f, 5.0f);
				
				//Turn off old sound areas and activate new ones with flooded sound
				Entity_SetActive("AMB_TightLadderSpace_PreFlood", false);
				Entity_SetActive("AMB_Airlock_PreExitSpace_PreFlood", false);
				Entity_SetActive("AMB_Airlock_Exit_Air_PreFlood", false);
				
				Entity_SetActive("AMB_TightLadderSpace_Flooded", true);
				Entity_SetActive("AMB_TightLadderSpace_Flooded_1", true);
				Entity_SetActive("AMB_Airlock_PreExitSpace_Flooded", true);
				Entity_SetActive("AMB_Airlock_Exit_Air_Flooded", true);
				Entity_SetActive("Trigger_UnstableMoans", true);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				ParticleSystem_CreateAtEntity("DivingRoomPipe_1_Water1", "spray_cone_big.ps", "DivingRoomPipeArea_1_1", true);
				ParticleSystem_CreateAtEntity("DivingRoomPipe_1_Water2", "spray_cone_med.ps", "DivingRoomPipeArea_1_2", true);
				ParticleSystem_SetActive("door_spray_3", true);

				
				Sound_CreateAtEntity("DivingRoomPipeArea_3_1", "04_02_tau_inside/SFX/airlock_end_break/water/spray", "DivingRoomPipeArea_1_1", 1.0f, true, 1.0f);
				Sound_CreateAtEntity("DivingRoomPipeArea_3_2", "04_02_tau_inside/SFX/airlock_end_break/water/spray", "DivingRoomPipeArea_1_2", 1.0f, true, 1.0f);
				Sound_CreateAtEntity("DivingRoomPipeWaterSplatArea_1", "04_02_tau_inside/SFX/airlock_end_break/water/splat", "DivingRoomPipeWaterSplatArea_1", 1.0f, true, 1.0f);
				Sound_CreateAtEntity("DivingRoomPipeWaterSplatArea_2", "04_02_tau_inside/SFX/airlock_end_break/water/splat", "DivingRoomPipeWaterSplatArea_2", 1.0f, true, 1.0f);
				Sound_CreateAtEntity("DivingRoomPipeWaterSplatArea_3", "04_02_tau_inside/SFX/airlock_end_break/water/splat", "DivingRoomPipeWaterSplatArea_3", 1.0f, true, 1.0f);
				mbAirlockBrokenSpotsActive = true;
				
				Sound_CreateAtEntity("ElectrifyTerminal", "04_02_tau_inside/SFX/airlock_end_break/terminal_electrified", "DiveRoomSparks_1");
			}
			else if (Sequence_DoStepAndWait(1))
			{
				ParticleSystem_CreateAtEntity("DivingRoomPipe_2_Water", "spray_cone_med.ps", "DivingRoomPipeArea_2", true);
				ParticleSystem_SetActive("door_spray_4", true);
				
				Sound_CreateAtEntity("pipe_break_03", "04_02_tau_inside/SFX/airlock_end_break/pipe_break_03", "DivingRoomPipeArea_2", 1.0f, true, 1.0f);
				Sound_CreateAtEntity("DivingRoomPipe_2_Water", "04_02_tau_inside/SFX/airlock_end_break/water/spray", "DivingRoomPipeArea_2", 1.0f, true, 1.0f);
				
				Timer_DiveRoomSpark("DiveRoomSparks_1");
				float fDelay = 0.125;
				for (int i = 2; Entity_Exists("DiveRoomSparks_"+i); i++)
				{
					Map_AddTimer("DiveRoomSparks_"+i, fDelay, "Timer_DiveRoomSpark");
					fDelay += 0.125;
				}
				Map_AddTimer("DiveRoomControlPanel_1", fDelay, "TimerSetLampUnlit");
				Map_AddTimer("DiveRoomControlPanel_2", fDelay+0.25, "Timer_SetEntityEffectsInactive");
				Map_AddTimer("DiveRoomControlPanel_3", fDelay+0.5, "TimerSetLampUnlit");
				Sound_Stop("crt_sound", 1.0f);
			}
			else if (Sequence_DoStepAndWait(3))
			{
				ParticleSystem_CreateAtEntity("DivingRoomPipe_3_Water1", "spray_cone_big.ps", "DivingRoomPipeArea_3_1", true);
				ParticleSystem_CreateAtEntity("DivingRoomPipe_3_Water2", "spray_cone_med.ps", "DivingRoomPipeArea_3_2", true);
				ParticleSystem_SetActive("pipe_spray_*", true);
				
				//Add area for water spray
				Entity_SetActive("AirlockSpotControl_PreAirlockSpace", true);
				Entity_SetActive("AirlockSpotControl_AirlockSpace", true);
				Entity_SetActive("AirlockSpotControl_PreAirlockSpace_Ladder", true);
				Map_AddTimer("Timer_ExitAirlockDoorHandler", 1.5f, "Timer_ExitAirlockDoorSpotHandler");
				
			}
			else if (Sequence_DoStepAndWait(0.3))
			{
				Lamp_SetFlickerActive("AirlockDoorWarningLamp_3", false);
				Entity_FadeEffectBaseColor("AirlockDoorWarningLamp_3", cColor(1), 0.3);
				ParticleSystem_Destroy("door_spray_2");

			}
			else if (Sequence_DoStepAndWait(0.75))
			{
				Lamp_SetLit("AirlockDoorWarningLamp_3", false, false);
				ParticleSystem_Destroy("door_spray_1");
				ParticleSystem_Destroy("door_spray_3");
			}
			else if (Sequence_DoStepAndWait(4))
			{
			    ParticleSystem_Destroy("door_spray_4");
			}
			else if (Sequence_DoStepAndWait(0.25))
			{
				ParticleSystem_Destroy(Entity_GetVarString("DiveRoomDoorFoamArea_3", ""));

			}
			else if (Sequence_DoStepAndWait(3))
			{
				Effect_Shake_FadeOut(mlAirlock2Shake, 0.5);
				Sound_Stop("Airlock2Pumping", 0.5f);
				
				MovingButton_SetSwitchedOn("AirlockDoorButton_2_2", false, false);
				Entity_Connect("Airlock2_MuttonConnect1", "AirlockDoorButton_1_2", "AirlockDoor_2", false, 0);
				Entity_Connect("Airlock2_MuttonConnect2", "AirlockDoorButton_1_2", "AirlockDoorButton_2_2", false, 0);
			}
			else if (Sequence_DoStepAndWait(1))
			{				
				MovingButton_SetSwitchedOn("AirlockDoorButton_2_2", true, true);
				
				Lamp_SetLit("AirlockDoorWarningLamp_1", false, true);
				Lamp_SetLit("AirlockDoorWarningLamp_2", false, true);
				Entity_SetVarString("AirlockDoorPanel_1_2", "CustomMessage", "");
				Entity_SetVarString("AirlockDoorPanel_2_2", "CustomMessage", "");
				//SetDoorButtonsLocked("AirlockDoor_2", false);
				
				Map_RemoveTimer("Airlock2Alarm");
				Map_RemoveTimer("Airlock2DoorAlarm");
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Entity_SetInteractionDisabled("AirlockDoorButton_1_2", false);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				ParticleSystem_SetActive("door_spray_5", true);
				ParticleSystem_SetActive("door_spray_6", true);
		    }
			Sequence_End();
		}
		
		void Airlock2AlarmSound(const tString &in asTimer)
		{
			Sound_CreateAtEntity("Airlock2Alarm", "04_02_tau_inside/SFX/airlock_end_break/broken_alarm", "AirlockDoorWarningLamp_1", 0, true);
			Map_AddTimer("Airlock2Alarm", 1.0f, "Airlock2AlarmSound");
		}
		
		void Airlock2DoorAlarmSound(const tString &in asTimer)
		{
			Sound_CreateAtEntity("Airlock2DoorAlarm", "04_02_tau_inside/SFX/airlock_end_flood/airlock_door_alarm", "Airlock2DoorAlarmSoundSource", 0, true);
			Map_AddTimer("Airlock2DoorAlarm", 1.6f, "Airlock2DoorAlarmSound");
		}

		//-------------------------------------------------------
		
		void OnGuiAirlock2DoorStatus(const tString&in asEntityName, float afTimeStep)
		{
			tString sCustomMessage = Entity_GetVarString(asEntityName, "CustomMessage");
			if (sCustomMessage == "AirlockDoorStatus_Error")
			{			
				ImGui_SetTransCategory("04_02_tau_inside");
				
				if (!ImGui_TimerExists("ShowErrorTimer") || ImGui_TimerOver("ShowErrorTimer"))
				{
					ImGui_SetStateBool("ShowError", !ImGui_GetStateBool("ShowError", true));
					ImGui_AddTimer("ShowErrorTimer", 0.8);
				}
				
				if (ImGui_GetStateBool("ShowError", true))
					return;
			}
				
			if (sCustomMessage != "")
			{
				cImGuiTextFrameData text = ImGui_GetDefaultTextFrame();
				text.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
				text.mFontAlign = eFontAlign_Center;
				text.mbUseBackgroundGfx = false;
				text.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.19);
				
				ImGui_DoTextFrameExt(sCustomMessage, 0, 0, 0, text, ImGui_NrmPosGroup(cVector3f(0, 0.35, 0)), ImGui_NrmSizeGroup(1));
				return;
			}
			
			OnGuiLivingAreaDoorStatus(asEntityName, afTimeStep);
		}

		//-------------------------------------------------------
		
		bool Trigger_AttachToWaterSurface(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_AttachToEntity(asParent, asChild, "", false);
