		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void OnGuiDiveRoomTerminal(const tString&in asEntityName, float afTimeStep)
		{						
			ImGui_SetTransCategory("04_02_tau_inside");
			
			StationGuiBG_Backdrop();
			StationGuiBG_Taskbar("tau");
			StationGuiBG_Scanlines();
			
			cStationGui_TextReaderSettings settings;
			
			if (StationGui_DrawAndCheckErrors()) return;
			
			bool bDrawBackButton = true;
			int lBackApp = eDivingRoomTerminalState_MainMenu;
			int lActiveApp = StationGui_GetActiveApp(eDivingRoomTerminalState_MainMenu);
			switch (lActiveApp)
			{	
				case eDivingRoomTerminalState_MainMenu:
				StationGui_AddApp("DivingRoomTerminalApp_SuitStatus");
				StationGui_AddApp("DivingRoomTerminalApp_AccessLog");
				StationGui_AddApp("DivingRoomTerminalApp_Tracking");
				StationGui_MainMenu();
				bDrawBackButton = false;
				break;
				
				case eDivingRoomTerminalState_SuitStatus:
				settings.mvTextFontSize = ImGui_NrmSizeKeepRatio(0.045);
				ImGui_GroupBegin(ImGui_NrmPosGroup(0.25, 0.2, 0), ImGui_NrmSizeGroup(0.5, 0.6));
					StationGui_TextReaderSingle("DivingRoomTerminalApp_SuitStatus", "DivingRoomTerminal_SuitStatus", settings);
				ImGui_GroupEnd();
				break;
				
				case eDivingRoomTerminalState_AccessLogs:
				StationGui_TextReaderSingle("DivingRoomTerminalApp_AccessLog", "DivingRoomTerminal_AccessLog");
				break;
				
				case eDivingRoomTerminalState_Tracking:		
					ImGui_DoWindowStart("DivingRoomTerminalApp_Tracking", StationGui_CreateDefaultWindowData(), ImGui_NrmPos(cVector3f(0.025, 0.025, 1.5)), ImGui_NrmSize(cVector2f(0.95, 0.8)));
						
						//////////////////
						// Map
						ImGui_GroupBegin(ImGui_NrmPosGroup(cVector3f(0, 0, 0)), ImGui_NrmSizeGroup(cVector2f_One));
							ImGui_DoImageCorrectAspect(cImGuiGfx("divesuittracker_map", eImGuiGfx_Texture), ImGui_NrmPosGroup(cVector3f(0, 0, 0.05)), ImGui_NrmSizeGroup(1));
							ImGui_SetModColorMul(cColor_Red*ImGui_FadeOscillateFloat("DotColor", 1, 0.5, 1));
							ImGui_DoImageCorrectAspect(cImGuiGfx("divesuittracker_dots", eImGuiGfx_Texture), ImGui_NrmPosGroup(cVector3f(0, 0, 0.1)), ImGui_NrmSizeGroup(1));
							ImGui_SetModColorMul(cColor_White);
						ImGui_GroupEnd();
					ImGui_DoWindowEnd();
				break;
			}
			
			StationGui_BackButton(bDrawBackButton, lBackApp);
		}
		
		//} END DIVING ROOM TERMINAL

