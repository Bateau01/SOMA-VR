		eRossUnlockGlitchState mRossUnlockGlitchState = eRossUnlockGlitchState_None;
		
		//-------------------------------------------------------
		// Comm Room Dialler Audio Handler
		
		bool mbCommRoomDiallerRoomSoundActive = false;		
		void CommRoomDiallerRoomSound(const tString asEntity)
		{
			if(mbCommRoomDiallerRoomSoundActive==false)
			{
				Sound_CreateAtEntity("TauDialler_Base_Start_"+asEntity, "Entities_Station/tech/terminal_beeps/tau_station_dialler/bases/tau_dial_bases_start", asEntity);
				Map_AddTimer(asEntity, 0.025f, "CommRoomDiallerLoopSound");
				
				mbCommRoomDiallerRoomSoundActive = true;
			}
		}
		
		void CommRoomDiallerRoomSoundStop(const tString asEntity, bool abDisconnectSound)
		{
			if(mbCommRoomDiallerRoomSoundActive==true)
			{
				Sound_Stop("TauDialler_Base_Start_"+asEntity, 0.25f);
				Sound_Stop("TauDialler_Base_Loop_"+asEntity, 0.25f);
				Map_RemoveTimer(asEntity);
				mbCommRoomDiallerRoomSoundActive = false;
			}
			
			if(abDisconnectSound)
			{
				Sound_CreateAtEntity("TauDialler_Base_Disconnect_"+asEntity, "Entities_Station/tech/terminal_beeps/tau_station_dialler/bases/tau_dial_bases_disconnect", asEntity);
			}
		}
		
		void CommRoomDiallerLoopSound(const tString &in asTimer)
		{
			Sound_CreateAtEntity("TauDialler_Base_Loop_"+asTimer, "Entities_Station/tech/terminal_beeps/tau_station_dialler/bases/tau_dial_bases_loop", asTimer);
		}

		//-------------------------------------------------------
		
		void OnGuiActivateGlitch(float afTime)
		{
			ImGui_StopTimer("GlitchActive");
			ImGui_AddTimer("GlitchActive", afTime);
		}

		//-------------------------------------------------------
		
		bool OnGuiGlitchActive()
		{
			return ImGui_TimerExists("GlitchActive");
		}

		//-------------------------------------------------------
		
		void OnGuiGlitchStart()
		{
			float fActivateGlitches = ImGui_GetStateFloat("TriggerGlitches", -1);
			if (fActivateGlitches>0)
			{
				OnGuiActivateGlitch(fActivateGlitches);
				ImGui_SetStateFloat("TriggerGlitches", -1);
			}
			
			cVector3f vOffset = cVector3f_Zero;
			if (ImGui_TimerExists("GlitchActive")==false)
			{
				mRossUnlockGlitchState = eRossUnlockGlitchState_None;
			}
			else if (ImGui_TimerExists("GlitchActive") && (ImGui_TimerOver("GlitchSwitch") || ImGui_TimerExists("GlitchSwitch")==false))
			{
				mRossUnlockGlitchState = eRossUnlockGlitchState(cMath_RandRectl(eRossUnlockGlitchState_None, eRossUnlockGlitchState_LastEnum));
				if (mRossUnlockGlitchState == eRossUnlockGlitchState_Offset)
					ImGui_SetStateVector3f("Offset", cMath_RandRectVector3f(cVector3f(-0.5, -0.5, 0), cVector3f(0.5, 0.5, 0)));
				ImGui_AddTimer("GlitchSwitch", cMath_RandRectf(0.025, 0.1f));		
			
				Sound_CreateAtEntity("StatusTerminalGlitch", "03_01_omicron_outside/Gameplay/wau_glitch/wau_glitch_burst", ImGui_GetName());
			}
			if (mRossUnlockGlitchState == eRossUnlockGlitchState_NoRender) return;
			if (mRossUnlockGlitchState == eRossUnlockGlitchState_Offset)
				vOffset = ImGui_GetStateVector3f("Offset", cVector3f_Zero);
				
			
			ImGui_GroupBegin(ImGui_NrmPos(cVector3f(0, 0, 1)+vOffset), ImGui_NrmSize(1, 1));
		}
		
		void OnGuiGlitchEnd()
		{
			ImGui_GroupEnd();
		}

		//-------------------------------------------------------
		
		void OnGuiCommRoomTerminal(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("04_02_tau_inside");
			
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();		
			StationGuiBG_Taskbar("tau");
			
			/////////////////
			// Handle glitches
			OnGuiGlitchStart();
			
			///////////
			// Data
			cImGuiLabelData label = ImGui_GetDefaultLabel();
			label.mFontAlign = eFontAlign_Left;
			ImGui_SetDefaultLabel(label);
			
			if (StationGui_DrawAndCheckErrors())
				return;
			
			bool bDrawBackButton = true;
			int lBackApp = eCommRoomTerminalState_MainMenu;
			int lActiveApp = StationGui_GetActiveApp();
			switch (lActiveApp)
			{	
				case eCommRoomTerminalState_MainMenu:
				StationGui_AddApp("CommRoomTerminalApp_Transmission");
				StationGui_AddApp("CommRoomTerminalApp_CommLogs");
				StationGui_AddApp("DoorControlApp_Name");
				StationGui_AddApp("CommRoomTerminalApp_PhiStatus");
				StationGui_MainMenu();
				bDrawBackButton=false;
				break;
				
				case eCommRoomTerminalState_Transmission:
				OnGuiCommRoomTerminal_Transmission();
				break;
				
				case eCommRoomTerminalState_CommLogs:
				StationGui_TextReaderSingle("CommRoomTerminalApp_CommLogs", "CommRoomTerminal_CommLogs");
				break;
				
				case eCommRoomTerminalState_Doors:
				OnGuiDoorLockApp();
				break;
				
				case eCommRoomTerminalState_Doors_Password:
				bDrawBackButton = OnGuiDoorLockApp_Password();
				lBackApp = eCommRoomTerminalState_Doors;
				break;
				
				case eCommRoomTerminalState_PhiStatus:
				OnGuiCommRoomTerminal_PhiStatus();
				break;
			}
			
			if (StationGui_BackButton(bDrawBackButton, lBackApp))
			{
				StationGui_SetNumpadInput("");
				if (lActiveApp == eCommRoomTerminalState_Transmission)
				{
					if (Sound_Exists(ImGui_GetName()+"RadioStaticBases"))
					{
						//Sound_Stop(ImGui_GetName()+"RadioStaticBases", 0.5);
						//Sound_CreateAtEntity(ImGui_GetName()+"RadioStaticBasesStop", 
						//					 "Entities_Station/tech/terminal_beeps/tau_station_dialler/bases/tau_dial_bases_disconnect", 
						//					 ImGui_GetName(), 0.0, true);
					}
					ImGui_SetStateBool("ContactActive", false);
				}
			}
			OnGuiGlitchEnd();
		}
		
		//-------------------------------------------------------
		
		void OnGuiCommRoomTerminal_Transmission()
		{
			cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
			windowData.mColorText = cColor(1, 1);
			
			cImGuiButtonData button = StationGui_CreateToggleButtonData();
			button.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.05);
			
			cImGuiLabelData label = ImGui_GetDefaultLabel();
			label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
			label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.05);
			label.mFontAlign = eFontAlign_Center;
				
			bool bContactActive = ImGui_GetStateBool("ContactActive", false);
		
			/////////////////////////
			// Room listing
			ImGui_GroupBegin(ImGui_NrmPosGroup(cVector3f(0.025, 0.025, 1)), ImGui_NrmSizeGroup(cVector2f(0.95, 0.8)));
				
				ImGui_SetModUseInput(bContactActive==false);
				ImGui_DoWindowStart("CommRoomTerminalApp_Transmission", windowData, ImGui_NrmPosGroup(cVector3f(0, 0, 0)), ImGui_NrmSizeGroup(cVector2f(0.35, 1)));
					for (int i = 1; i < eCommRoomChannel_LastEnum; i++)
					{
						ImGui_AddItemString("CommRoomTerminal_Transmission_"+i);
					}
					int lPrevSelection = ImGui_GetStateInt("TransmissionSelection", -1);
					int lSelectedFile = ImGui_DoMultiToggleExt("FileSelection", lPrevSelection, 1, 
															   ImGui_NrmSizeGroup(cVector2f(0, 0.02)), button, ImGui_NrmPosGroup(cVector3f(0.05, 0.025, 1)), 
															   ImGui_NrmSizeGroup(cVector2f(0.9, 0.95)));
					
					ImGui_SetStateInt("TransmissionSelection", lSelectedFile);
					
					lSelectedFile++;

					
					///////////////////////////////////
					// Check if one of the land lines
					bool bLandLine = (lSelectedFile == eCommRoomChannel_Lisbon || lSelectedFile == eCommRoomChannel_Cadiz);
					if (ImGui_PrevUpdated())
					{
						if (bLandLine)
						{
							StationGui_SetError("CommRoomTerminal_LandLineError");
							ImGui_SetStateInt("TransmissionSelection", lPrevSelection==-1 ? -2 : -1);
						}
					}
					
				ImGui_DoWindowEnd();
				ImGui_SetModUseInput(true);
				
				ImGui_DoWindowStart("", windowData, ImGui_NrmPosGroup(cVector3f(0.45, 0.0, 3)), ImGui_NrmSizeGroup(cVector2f(0.55, 0.45)));
					
					if (lSelectedFile > 0 && bLandLine==false)
					{
						ImGui_DoLabelExt("CommRoomTerminal_Transmission_"+lSelectedFile, label, 
										  ImGui_NrmPosGroup(cVector3f(0.0, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(1, -1)), 1);
						
						ImGui_SetModColorMul(gStationGuiColor_Warning);
						ImGui_DoLabelExt("ReactorControlTerminal_Offline", label, ImGui_NrmPosGroup(cVector3f(0.0, 0.3, 1)), ImGui_NrmSizeGroup(cVector2f(1, -1)), 1);
						ImGui_SetModColorMul(cColor_White);
					}
					
					ImGui_SetModUISizeVertExpansion(2, 6);
					ImGui_SetModUseInput(lSelectedFile > 0 && bLandLine==false);
					button.mbClipText = false;
					ImGui_ResizeFontToFit(bContactActive ? "IntercomApp_Hangup" : "IntercomApp_Call", button.mFont, ImGui_GetCurrentGroupSize().x*0.45);
					if (ImGui_DoButtonExt("CallHangupRadio", bContactActive ? "IntercomApp_Hangup" : "IntercomApp_Call", button, 
										  ImGui_NrmPosGroup(cVector3f(0.25, 0.575, 1)), ImGui_NrmSizeGroup(cVector2f(0.5, 0.25))))
					{	
						if (bContactActive)
						{
							CommRoomDiallerRoomSoundStop("CommRoomTerminalSoundSource", true);
							ImGui_SetStateBool("ContactActive", false);
						}
						else
						{
							CommRoomDiallerRoomSound("CommRoomTerminalSoundSource");
							ImGui_SetStateBool("ContactActive", true);
						}
					}
					ImGui_SetModUseInput(true);
					ImGui_SetModUISizeVertExpansion(0, 0);
					
				ImGui_DoWindowEnd();
					
			ImGui_GroupEnd();
		}
		
		//-------------------------------------------------------
		
		void OnGuiCommRoomTerminal_PhiStatus()
		{
			cStationGui_TextReaderSettings textReader;
			
			
			for (int i = 1; i <= 3; i++)
			{
				cGuiTextFile file;
				file.mGfx = cImGuiGfx("taucommroom_phipic_"+i);
				file.mbHasImage = true;
				file.msTitle = "CommRoomTerminal_PhiArea_"+i;
				file.msBody = "CommRoomTerminal_PhiAreaInfo_"+i;
				Depth_ImGui_AddTextFile(file);
			}
			StationGui_TextReaderMulti(textReader);
		}
		
		//} END COMM ROOM TERMINAL
		
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Terminal *Infirmary*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		bool mbAllowLoadingSound = true;
		bool mbAllowGrantedSound = true;
		void OnGuiInfirmaryTerminal(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("04_02_tau_inside");
			
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();
			StationGuiBG_Taskbar("tau");
			
			/////////////////
			// Handle glitches
			OnGuiGlitchStart();
			
			///////////
			// Data
			cImGuiLabelData label = ImGui_GetDefaultLabel();
			label.mFontAlign = eFontAlign_Left;
			ImGui_SetDefaultLabel(label);
			
			cStationGui_DataRestorationSettings restoration;
			restoration.mbAutoUpdateOutOfView = true;
			
			if (StationGui_DrawAndCheckErrors())
				return;
			
			bool bDrawBackButton = true;
			int lBackApp = eInfirmaryTerminalState_MainMenu;
			int lActiveApp = StationGui_GetActiveApp(eInfirmaryTerminalState_MainMenu);
			switch (lActiveApp)
			{	
				case eInfirmaryTerminalState_MainMenu:
				StationGui_AddApp("IntercomApp_Label");
				StationGui_AddApp("DoorControlApp_Name");
				StationGui_AddApp("InfirmaryTerminalApp_Photos", true, eInfirmaryTerminalState_Media_Photos);
				StationGui_AddApp("InfirmaryTerminalApp_Docs", true, eInfirmaryTerminalState_Documents);
				StationGui_MainMenu();
				bDrawBackButton=false;
				break;
				
				case eInfirmaryTerminalState_Intercom:
				OnGuiIntercomApp();
				break;
				
				case eInfirmaryTerminalState_Doors:
				OnGuiDoorLockApp();
				break;
				
				case eInfirmaryTerminalState_Doors_Password:
				bDrawBackButton = OnGuiDoorLockApp_Password();
				lBackApp = eInfirmaryTerminalState_Doors;
				break;
				
				case eInfirmaryTerminalState_Media_Menu:
				break;
				
				case eInfirmaryTerminalState_Media_Photos:
				Depth_ImGui_AddPhotoFile("tau_infirmaryfoto00", eImGuiGfx_Texture);
				Depth_ImGui_AddPhotoFile("tau_infirmaryfoto01", eImGuiGfx_Texture);
				Depth_ImGui_AddPhotoFile("tau_infirmaryfoto02", eImGuiGfx_Texture);
				Depth_ImGui_AddPhotoFile("tau_infirmaryfoto03", eImGuiGfx_Texture);
				Depth_ImGui_AddPhotoFile("tau_infirmaryfoto04", eImGuiGfx_Texture);
				StationGui_PhotoViewer();
				break;
				
				case eInfirmaryTerminalState_Documents:
				{
					int lRestoredFiles = 0;
					if (StationGui_DataRestoration(3, 3.286, lRestoredFiles, restoration) == false)
					{
						//
						ImGui_SetModColorMul(cColor(1, 0.5));
						ImGui_SetModUseInput(false);
						
						int lRestoreState = ImGui_GetStateInt("DataRestorationState", 0);
						if (lRestoreState == 0)
						{
						}
						else if (lRestoreState == 1)
						{
							//Loading Bar
							if(mbAllowLoadingSound==true)
							{
								Sound_CreateAtEntity("LindwallDataRestore", "04_02_tau_inside/SFX/lindwall_data_restore", "InfirmaryTerminal");
								mbAllowLoadingSound = false;
							}
						}
						else if (lRestoreState == 2)
						{
							//confirmation
						}
					}
				

					for (int i = 1; i <= lRestoredFiles; i++)
					{
						Depth_ImGui_AddTextFile("InfirmaryTerminalFileName_"+i, "InfirmaryTerminalFile_"+i);
					}

					cStationGui_TextReaderSettings readerSettings;
					readerSettings.msCustomHeader = "InfirmaryTerminalApp_Docs";

					StationGui_TextReaderMulti(readerSettings);
			
					ImGui_SetModColorMul(cColor_White);
					ImGui_SetModUseInput(true);
				}
				break;
			}
			
			if (StationGui_BackButton(bDrawBackButton, lBackApp))
			{
				if (lActiveApp == eReactorControlTerminalState_Intercom)
				{
					if (Sound_Exists(ImGui_GetName()+"IntercomDialTone"))
					{
						Sound_Stop(ImGui_GetName()+"IntercomDialTone", 0.5);
						Sound_CreateAtEntity(ImGui_GetName()+"IntercomDialToneStop", 
											 "Entities_Station/tech/terminal_beeps/tau_station_dialler/rooms/tau_dial_rooms_disconnect", ImGui_GetName());
					}
					ImGui_SetStateBool("ContactActive", false);
					IntercomHangUp(0, ImGui_GetName());
				}
			}
			
			OnGuiGlitchEnd();
		}
		
		//} END INFIRMARY TERMINAL
		
		//-------------------------------------------------------

		/////////////////////////////////////////
		// Terminal *End Airlock*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void OnGuiAirlockControlScreen(const tString&in asEntityName, float afTimeStep)
		{
			//////////////////////
			// Data
			cImGuiTextFrameData text = StationGui_CreateDefaultTextFrameData();
			text.mFontAlign = eFontAlign_Center;
			text.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.08);
			ImGui_SetDefaultTextFrame(text);
			
			ImGui_SetTransCategory("04_02_tau_inside");
			
			StationGuiBG_Backdrop();
			StationGuiBG_Scanlines();
			StationGuiBG_Taskbar("tau");
			
			if (StationGui_DrawAndCheckErrors()) return;
			
			int lActiveApp = StationGui_GetActiveApp(eAirlockTerminalState_Cargo);
			switch (lActiveApp)
			{	
				case eAirlockTerminalState_Cargo:
				OnGuiAirlockControlScreen_Cargo();
				break;
				
				case eAirlockTerminalState_PressureDiff:
				{
					tString sState = Entity_GetVarString(ImGui_GetName(), "State");
					StationGui_AirlockPressure("AirlockPanelStatus_"+sState, ImGui_GetStateFloat("PressureMul", 0), sState=="Collapse");
				}
				break;
			}
		}

		//-------------------------------------------------------
		
		void OnGuiAirlockControlScreen_Cargo()
		{
			//////////////////////
			// Data
			cImGuiWindowData window = StationGui_CreateDefaultWindowData();
			window.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.07);
			
			cImGuiTextFrameData text = ImGui_GetDefaultTextFrame();
			text.mFont.mvSize = 40;
			
			cImGuiButtonData button = StationGui_CreateDefaultButtonData();
			button.mbClipText = false;
			
			tString sState = Entity_GetVarString(ImGui_GetName(), "State");
			
			ImGui_DoWindowStart("AirlockPanelStatusHeader", window, 
								ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.25)));
			ImGui_SetModColorMul(ImGui_GetStateColor("TextColor", cColor_White));
			if (sState=="Attaching")
			{
				tWString sDots = Depth_ImGui_Effect_AnimatedDots();
				ImGui_SetTextOverride(sDots);
				ImGui_DoTextFrame("", 0, 0, 0, ImGui_NrmPosGroup(cVector3f(0, 0.25, 0)), ImGui_NrmSizeGroup(1));
			}
			else
			{
				ImGui_DoTextFrame("AirlockPanelStatus_"+sState, 0, 0, 0, ImGui_NrmPosGroup(cVector3f(0, 0.25, 0)), ImGui_NrmSizeGroup(1));
			}
			ImGui_DoWindowEnd();
			
			ImGui_SetModUseInput(SequenceStates_IsActive("Seq_LowerARKHolder")==false);
			
			cVector2f vFontSize = button.mFont.mvSize;
			ImGui_ResizeFontToFit(mbArkAttached ? "AirlockPanelDetachCargo" : "AirlockPanelAttachCargo", button.mFont, ImGui_GetCurrentGroupSize().x*0.25);
			if (ImGui_DoButtonExt("AttachCargoButton", mbArkAttached ? "AirlockPanelDetachCargo" : "AirlockPanelAttachCargo", button, 
							  ImGui_NrmPosGroup(cVector3f(0.675, 0.35, 1)), ImGui_NrmSizeGroup(cVector2f(0.275, 0.125))))
			{
				Seq_LowerARKHolder("");
			}
			ImGui_SetModUseInput(true);
			
			ImGui_DoWindowStart("AirlockPanelCargoHeader", window, 
								ImGui_NrmPosGroup(cVector3f(0.05, 0.35, 1)), ImGui_NrmSizeGroup(cVector2f(0.6, 0.5)));
			text.mFontAlign = eFontAlign_Left;
			ImGui_DoTextFrameExt("AirlockPanelCargoData", ImGui_NrmSizeGroup(cVector2f(0.05, 0.05)), 0, 0, text, ImGui_NrmPosGroup(cVector3f(0, 0, 0)), ImGui_NrmSizeGroup(1));
			ImGui_DoWindowEnd();
			
			button.mFont.mvSize = vFontSize;
			ImGui_ResizeFontToFit("AirlockPanelChangeCargo", button.mFont, ImGui_GetCurrentGroupSize().x*0.25);
			if (ImGui_DoButtonExt("ChangeCargoButton", "AirlockPanelChangeCargo", button, 
							  ImGui_NrmPosGroup(cVector3f(0.675, 0.675, 1)), ImGui_NrmSizeGroup(cVector2f(0.275, 0.125))))
			{
				StationGui_SetError("ChangeCargoButtonError");
			}
			
			return;
		}
		
		//} END END AIRLOCK TERMINAL
	
