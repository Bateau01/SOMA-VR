		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void OnChangeDoorButton(const tString &in asEntity, int alState)
		{				
			Entity_SetInteractionDisabled(asEntity, true);
			Map_AddTimer(asEntity, 2, "TimerSetInteractionEnabled");
		}

		//-------------------------------------------------------
		
		void SetupDoorPanels(const tString &in asEntity)
		{
			array<iLuxEntity@> vPanels;
			Map_GetEntityArray(asEntity, vPanels, eLuxEntityType_Prop);
			
			for (int i = 0; i < vPanels.length(); i++)
			{
				iLuxEntity@ pEntity = vPanels[i];
				tString sName = pEntity.GetName();
				tString sSearch = "Panel";
				int lPanelPos = cString_GetFirstStringPos(sName, sSearch);
				
				//Setup connected button
				tString sButton = sName;
				sButton.resize(lPanelPos);
				sButton = sButton + "Button" + cString_Sub(sName, lPanelPos+sSearch.length());
				
				if (Entity_Exists(sButton))
					pEntity.SetVarString("Button", sButton);
			}
		}

		//-------------------------------------------------------
		
		void SetDoorButtonsLocked(const tString &in asDoor, bool abState, bool abEffects=true)
		{
			int lDoorIndex = cString_GetNumericSuffixInt(asDoor);
			tString sDoorPrefix = asDoor;
			sDoorPrefix.resize(sDoorPrefix.length()-(""+lDoorIndex).length()-1);
			
			if (Entity_Exists(sDoorPrefix+"Button_1_"+lDoorIndex))
				MovingButton_SetLocked(sDoorPrefix+"Button_1_"+lDoorIndex, abState, abEffects);
			if (Entity_Exists(sDoorPrefix+"Button_2_"+lDoorIndex))
				MovingButton_SetLocked(sDoorPrefix+"Button_2_"+lDoorIndex, abState, abEffects);
		}

		//-------------------------------------------------------
		
		void SetupDoorButtonConnections(const tString& in asPrefix)
		{
			array<iLuxEntity@> pEntities;
			Map_GetEntityArray(asPrefix+"_*", pEntities);
			for (int i = 0; i < pEntities.length(); i++)
			{
				int lIndex = cString_GetNumericSuffixInt(pEntities[i].GetName());
				SetupDoorButtonConnection(asPrefix, lIndex);
			}
		}

		//-------------------------------------------------------
		
		void OnDoorButtonStateChange(const tString &in asEntity, int alState)
		{
			Entity_SetInteractionDisabled(asEntity,true);
			Map_AddTimer(asEntity,10.0f,"TimerEnableButton");
		}
		
		//-------------------------------------------------------
		
		void TimerEnableButton(const tString& in asEntity)
		{
			Entity_SetInteractionDisabled(asEntity,false);
		}

		//-------------------------------------------------------

		void SetupDoorButtonConnection(const tString& in asPrefix, int alIndex)
		{
			tString sDoorName = asPrefix+"_"+alIndex;
			tString sButton1Name = asPrefix+"Button_1_"+alIndex;
			tString sButton2Name = asPrefix+"Button_2_"+alIndex;
			
			Entity_Connect(sDoorName+sButton1Name, sDoorName, sButton1Name, false, 0);
			Entity_Connect(sDoorName+sButton2Name, sDoorName, sButton2Name, false, 0);
			
			Entity_Connect(sButton1Name+sDoorName, sButton1Name, sDoorName, false, 0);
			Entity_Connect(sButton1Name+sButton2Name, sButton1Name, sButton2Name, false, 0);
			
			Entity_Connect(sButton2Name+sDoorName, sButton2Name, sDoorName, false, 0);
			Entity_Connect(sButton2Name+sButton1Name, sButton2Name, sButton1Name, false, 0);
		}

		//-------------------------------------------------------
		
		//} End Door buttons
	
	//} END MAIN FUNCTIONS
	
