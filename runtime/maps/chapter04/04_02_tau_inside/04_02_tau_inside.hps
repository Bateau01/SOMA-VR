	void TimerVoiceMixer(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Voice mixer triggered "+asTimer);
		if(asTimer=="4_AirlockStopped")
		{
			Sound_FadeGlobalVolume(0.5, 1.0f);
			Map_AddTimer("ResetMixer", 2.5f, "TimerVoiceMixer");
