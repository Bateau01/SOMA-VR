	//-------------------------------------------------------
	//Infimary sound state - to control life support beep leaking/not leaking
	
	//Check if player is in ladder area pre-infirmary
	bool mbInfirmaryLadderArea = false;
	bool Trigger_LadderInfirmarySoundState(const tString &in asParent, const tString &in asChild, int alState)
	{
		mbInfirmaryLadderArea = alState == 1 ? true : false;
		InfirmarySoundEnabler();
		cLux_AddDebugMessage("PlayerInsideLadderArea "+mbInfirmaryLadderArea);
		return true;
	}
	
	//Check if player is inside infirmary
	bool mbPlayerInsideInfirmarySound = false;
	bool Trigger_infirmaryRoomSoundState(const tString &in asParent, const tString &in asChild, int alState)
	{
		mbPlayerInsideInfirmarySound = alState == 1 ? true : false;
		InfirmarySoundEnabler();
		cLux_AddDebugMessage("PlayerInsideInfirmarySound "+mbPlayerInsideInfirmarySound);
		return true;
	}
	
	//Check if infirmary door is open
	void InfirmaryDoorButtonUpdate(const tString &in asTimer)
	{
		Map_AddTimer("InfirmaryDoorUpdate", 1.5f, "InfirmaryDoorButtonUpdate");
		// S26AQ: assign the state instead of discarding a comparison. Recompute
		// audibility on an actual change, without recreating the loop every poll.
		bool bDoorOpen = Button_IsSwitchedOn("LivingAreaDoorButton_1_9");
		if (mbInfimaryDoorOpen != bDoorOpen)
		{
			mbInfimaryDoorOpen = bDoorOpen;
			InfirmarySoundEnabler();
		}
	}
	
	//Allow the sound to play/leak if the player is in the infirmary or the door is open and they're in the ladder area
	bool mbLifeSupportMachineSoundActive = true;
	bool mbInfirmarySoundEnabler = false;
	bool mbInfimaryDoorOpen = false;	
	void InfirmarySoundEnabler()
	{
		if(mbPlayerInsideInfirmarySound == true || mbInfimaryDoorOpen == true && mbInfirmaryLadderArea == true)
		{
			mbInfirmarySoundEnabler = true;
			if(mbLifeSupportMachineSoundActive == true && mbLifeSupportActive == true)
			{
				Sound_CreateAtEntity("LifeSupportIdle", "Entities_Station/tech/life_support/machine_idle", "LifeSupportSoundSource");
			}
		}
		else
		{
			mbInfirmarySoundEnabler = false;
			Sound_Stop("LifeSupportIdle", 1.0f);
		}
	}
	
	//-------------------------------------------------------
	//Living area rumbles
	
	/**
	 * This rumble trigger checks if the area is in a pod or in the living space and then fades between the two
	 * as the player transitions, keeping the rumble underneath intact
	 */
	 
	bool Audio_RumbleController_Timer(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Map_AddTimer("LivingAreaRumbleTimer", cMath_RandRectf(10, 25),"LivingAreaRumbles");
			cLux_AddDebugMessage("Rumble Timer Triggered");
		}
		else
		{
			Map_RemoveTimer("LivingAreaRumbleTimer");
			cLux_AddDebugMessage("Rumble Timer Disabled");
			Sound_Stop("RumbleGroan", 5.0f);
			Sound_Stop("RumbleGroanPod", 5.0f);
			Sound_Stop("RumbleGroanLivingArea", 5.0f);
		}
		return true;
	}
		
	//-------------------------------------------------------
	
	bool mbRumbGroanLivingHub = false;
	bool mbRumbleGroanPod = false;
	void LivingAreaRumbles(const tString &in asTimer)
	{
		Map_RemoveTimer("LivingAreaRumbleTimer");
		Map_AddTimer("LivingAreaRumbleTimer", cMath_RandRectf(15, 25),"LivingAreaRumbles");
		
		if(mbRumbGroanLivingHub==true || mbRumbleGroanPod==true)
		{
			//Play rumble sound and choose correct rattle to play
			Sound_CreateAtEntity("RumbleGroan", "04_02_tau_inside/AMB/spot/room_rumble/rumble", "Player");
			cLux_AddDebugMessage("Rumble Triggered");
			
			if(mbRumbleGroanPod==true)
			{
				Sound_CreateAtEntity("RumbleGroanPod", "04_02_tau_inside/AMB/spot/room_rumble/pod", "Player");
				Sound_CreateAtEntity("RumbleGroanLivingArea", "04_02_tau_inside/AMB/spot/room_rumble/living_area", "Player", 0.0f, false, 0.0f);
			}
			else if (mbRumbGroanLivingHub==true)
			{
				Sound_CreateAtEntity("RumbleGroanLivingArea", "04_02_tau_inside/AMB/spot/room_rumble/living_area", "Player");
				Sound_CreateAtEntity("RumbleGroanPod", "04_02_tau_inside/AMB/spot/room_rumble/pod", "Player", 0.0f, false, 0.0f);
			}
		}
	}
	
	//If entering living area and pod rumble playing, fade gracefully into living area rumble
	bool Audio_RumbleController_LivingArea(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			mbRumbGroanLivingHub = true;
			Sound_Fade("RumbleGroanPod", 0.0f, 2.0f);
			Sound_Fade("RumbleGroanLivingArea", 0.0f, 1.0f);
		}
		else
		{
			mbRumbGroanLivingHub = false;
		}
		return true;
	}
	
	//If entering pod area and living area rumble playing, fade gracefully into pod area rumble
	bool Audio_RumbleController_PodArea(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			mbRumbleGroanPod = true;
			Sound_Fade("RumbleGroanPod", 1.0f, 1.0f);
			Sound_Fade("RumbleGroanLivingArea", 0.0f, 2.0f);
		}
		else
		{
			mbRumbleGroanPod = false;
		}
		return true;
	}
	
	//-------------------------------------------------------


	//Living area fridge compressor
	bool mbFridgeCompressorSoundActive = false;
	void LivingArea_FridgeCompressor_SoundStart(const tString &in asTimer)
	{
		if(mbFridgeCompressorSoundActive == false)
		{
			Map_RemoveTimer("LivingArea_FridgeCompressor_SoundStart");
			Sound_CreateAtEntity("CompressorStart", "Entities_Station/object/sliding_fridge/compressor/start", "FridgeCompSoundSource", 0.0f, true, 1.0f);
			Sound_CreateAtEntity("CompressorLoop", "Entities_Station/object/sliding_fridge/compressor/loop", "FridgeCompSoundSource", 1.0f, true, 1.0f);
			Map_AddTimer("LivingArea_FridgeCompressor_SoundStop", cMath_RandRectf(18, 30), "LivingArea_FridgeCompressor_SoundStop");
			mbFridgeCompressorSoundActive = true;
		}
	}
	
	void LivingArea_FridgeCompressor_SoundStop(const tString &in asTimer)
	{
		if(mbFridgeCompressorSoundActive == true)
		{
			Map_RemoveTimer("LivingArea_FridgeCompressor_SoundStop");
			Sound_CreateAtEntity("CompressorStop", "Entities_Station/object/sliding_fridge/compressor/stop", "FridgeCompSoundSource", 0.0f, true, 1.0f);
			Sound_Stop("CompressorLoop", 1.0f);
			Map_AddTimer("LivingArea_FridgeCompressor_SoundStart", cMath_RandRectf(30, 45), "LivingArea_FridgeCompressor_SoundStart");
			mbFridgeCompressorSoundActive = false;
		}

	}
		
	//-------------------------------------------------------

	bool Trigger_Audio_UnstableMoans(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Map_AddTimer("UnstableAirlockDivingAreaMoans", cMath_RandRectf(12, 22), "UnstableDivingAreaMoans");
			cLux_AddDebugMessage("Airlock shaking start");
		}
		else
		{
			Map_RemoveTimer("UnstableAirlockDivingAreaMoans");
			cLux_AddDebugMessage("Airlock shaking stop");
		}
		return true;
	}
	
	void UnstableDivingAreaMoans(const tString &in asTimer)
	{
		Sound_CreateAtEntity("AirlockAreaMoans", "04_02_tau_inside/AMB/spot/tunnel_rumble_oneshot", "Player");
		Sound_FadeGlobalVolume(0.5f,3.0f);
		Effect_Shake_Start(0.01,3.0f,4.0f,2.0f);
		Map_AddTimer("AirlockShakeResetMixer", 3.0f, "AirlockShakeResetMixer");
		Map_AddTimer("UnstableAirlockDivingAreaMoans", cMath_RandRectf(10, 20), "UnstableDivingAreaMoans");
	}
	
	void AirlockShakeResetMixer(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f,3.0f);
	}
			
	//-------------------------------------------------------

	void Audio_AirlockVoiceDucking(const tString &in asScene, const tString&in asSubject, int alLineIndex, bool abStartOfLine)
	{
		Sound_FadeGlobalVolume(0.5, 1.5f);
		Map_AddTimer("ResetMixer", 1.5f, "TimerVoiceMixer");
	}
			
	//-------------------------------------------------------

	void Audio_LevelEnd()
	{
		Sound_FadeGlobalVolume(0.0f, 0.025f, eSoundEntryType_World);
		Sound_FadeGlobalVolume(0.0f, 0.025f, eSoundEntryType_GuiWorld);
	}
	
	//-------------------------------------------------------

	//} END AUDIO
	
	/////////////////////////////////////////
	// ==============
	// SCENE 1 *ENTER SITE & EXPLORE*
	// ==============
	//{///////////////////////////////////////

	//-------------------------------------------------------
	
	//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 1 General
		//{///////////////////////////////////////
		
		bool mbPlayerInStartingAirlock = false;
		bool PlayerAirlockState(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbPlayerInStartingAirlock = alState == 1 ? true : false;
			return true;
		}

		//-------------------------------------------------------
	
		void SetupEnterSiteAndExplore()
		{			
			Entity_StopAnimation("StartCorridorDoor_*");
			
			Flesher_SetDistortionEffectMul("Flesher_1", 0.25);
				
			for (int i = 1; Entity_Exists("StartAreaWarningLight_"+i); i++)
			{
				iLuxEntity@ pSpinningLamp = Map_GetEntity("StartAreaWarningLight_"+i, eLuxEntityType_Prop);
				cVector3f vRotateAxis = cMath_MatrixInverse(pSpinningLamp.GetMatrix()).GetForward();
				Prop_RotateToSpeed("StartAreaWarningLight_"+i, 10, 7.5, vRotateAxis, true, "");
				Sound_Play("airlocklightmotor_*", 0.5f);
			}
			
			SetupDoorButtonConnections("StartCorridorDoor");
			Map_AddTimer("InfirmaryDoorUpdate", 1.5f, "InfirmaryDoorButtonUpdate");
			
			Leviathan_InitSilent("Leviathan");

			Entity_SetInteractionDisabled("maintenance_robot_part_shoulderaxis_1", true);
			Entity_SetInteractionDisabled("KeyLockerDoor_1", true);
			Entity_SetInteractionDisabled("KeyLockerDoor", true);
		}

		//-------------------------------------------------------
		
		void EnergyDrainedCorridor(const tString &in asEntity)
		{
			Lamp_SetFlickerActive("CorridorWauFlowerLamp", true);
			Map_AddTimer("CorridorWauFlowerLamp", 3, "TimerSetLampUnlit");
			Map_AddTimer("StartCorridorLamp_49", 3, "TimerSetLampUnlit");
			
		}

		//-------------------------------------------------------
		
		void EnergyDrained_ControlRoom(const tString &in asEntity)
		{
			Map_AddTimer("ControlRoomWauFlower_Drain_1", 0.75, "Timer_SetEntityEffectsInactive");
			Map_AddTimer("ControlRoomWauFlower_Drain_2", 1, "Timer_SetEntityEffectsInactive");
			Map_AddTimer("ControlRoomWauFlower_Drain_3", 1.4, "TimerSetLampUnlit");
			
		}
		
		//} END GENERAL

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 1 Event A *Drain and exit airlock*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		cSequenceStatesData mIntroSequence;
			
		void Seq_Intro(const tString &in asTimer)
		{
			Sequence_Begin("Seq_Intro", mIntroSequence);
				
			if (Sequence_DoStepAndWait(3.0))
			{
				//Allow sound for door to load in to keep it in sync
				Sound_PreloadGroup("Entities_Station/doors/tau", true);
				Sound_PreloadGroup("04_02_tau_inside/sfx/nuclear_bulkhead", true);
			}
			else
			{
				SlideDoor_SetClosed("AirlockDoor_1", false);
				
				//Delay intro comment so it's not drowned out by door opening
				Map_AddTimer("1_IntroComment", 3, "TimerPlayVoice");
			}
			
			Sequence_End();
		}

		//} END EVENT

		//-------------------------------------------------------

		/////////////////////////////////////////
		// Scene 1 Event B *Airlock fills up & drains*
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		bool Trigger_FlesherEntersAirlock(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_FlesherEntersAirlock("");
			return false;
		}

		//-------------------------------------------------------
		
		cSequenceStatesData mFlesherEntersAirlockSequence;
			
		void Seq_FlesherEntersAirlock(const tString &in asTimer)
		{
			Sequence_Begin("Seq_FlesherEntersAirlock", mFlesherEntersAirlockSequence);
				
			if (Sequence_DoStepAndWait(2))
			{
				SlideDoor_SetClosed("AirlockDoor_1", true);
			}
			else if (Sequence_DoStepAndWait(11))
			{
				
				Map_AddTimer("StopAmbientMusicQuickly", 1.0f, "AmbientMusicHandler");
				Entity_SetActive("Trigger_FlesherFlushMixer", true);
				Sound_CreateAtEntity("FlesherEnters_Fill", "04_02_tau_inside/SFX/ross_airlock/airlock_fill", "FlesherAirlockSoundSrc");
				Sound_CreateAtEntity("RossEnters_Alarm", "04_02_tau_inside/SFX/ross_airlock/ross_enters_alarm", "Player", 0, true);
				Map_AddTimer("RossEnters_Alarm", 2.2f, "RossEnters_Alarm");
			}
			else if (Sequence_DoStepAndWait(8))
			{
				Sound_CreateAtEntity("FlesherEnters_OuterDoor", "04_02_tau_inside/SFX/ross_airlock/airlock_open", "FlesherAirlockSoundSrc");
			}
			else if (Sequence_DoStepAndWait(15))
			{
				Map_RemoveTimer("RossEnters_Alarm");
				Sound_CreateAtEntity("FlesherEnters_Flush", "04_02_tau_inside/SFX/ross_airlock/airlock_drain", "FlesherAirlockSoundSrc");
				if(mbFlesherEnterInSight==true)
				{
					Sound_CreateAtEntity("FlesherEnters_Clunk", "04_02_tau_inside/SFX/ross_airlock/entry_clunk", "Player");
				}
			}
			else if (Sequence_DoStepAndWait(3))
			{
				if(mbPlayerInFlesherAirlockMixerArea==true)
				{
					Sound_FadeGlobalVolume(1.0f,3.0f);
				}
				
				Entity_SetActive("Trigger_FlesherFlushMixer", false);
			}
			else
			{
				Entity_SetActive("FlesherEntersBaseCheck", true);
				
				if (Entity_GetCollide("Player", "FlesherEntersBaseCheck")==false)
					Trigger_PlayerInStartCorridor("", "", -1);
			}
			Sequence_End();
		}
				
		//-------------------------------------------------------
		bool mbWarningVoicePlayed = false;
		void RossEnters_Alarm(const tString &in asTimer)
		{
			if(mbWarningVoicePlayed)
			{
				Sound_CreateAtEntity("RossEnters_Alarm", "04_02_tau_inside/SFX/ross_airlock/ross_enters_alarm", "Player", 0, true);
				Map_AddTimer("RossEnters_Alarm", 2.2f, "RossEnters_Alarm");
			}
			
			else if(mbWarningVoicePlayed==false)
			{
				Voice_Play("AirlockDepressurising");
				mbWarningVoicePlayed = true;
				Sound_CreateAtEntity("RossEnters_Alarm", "04_02_tau_inside/SFX/ross_airlock/ross_enters_alarm", "Player", 0, true, 0.65f);
				Map_AddTimer("RossEnters_Alarm", 2.2f, "RossEnters_Alarm");
				if(mbPlayerInFlesherAirlockMixerArea==false)
				{
					Sound_FadeGlobalVolume(0.75f, 2.0f, eSoundEntryType_World);
					Map_AddTimer("DepressureMixerReturn", 4.0f, "DepressureMixerReturn");
				}
			}
		}
		
		void DepressureMixerReturn(const tString &in asTimer)
		{
			Sound_FadeGlobalVolume(1.0f, 4.0f, eSoundEntryType_World);
		}
		
		//-------------------------------------------------------
		//Checks if player is in corridor where they can see the airlock door - if so, play ross spooky sound when he enters
		
		bool mbFlesherEnterInSight = false;
		bool Trigger_FlesherCorridorControl(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState==1)
			{
				mbFlesherEnterInSight = true;
			}
			else
			{
				mbFlesherEnterInSight = false;
			}
			return true;
		}

