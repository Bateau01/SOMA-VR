		cDoorLockAppButton DoDoorLockButton(int alIndex)
		{
			cDoorLockAppButton lock("DoorControlAppRoom_"+alIndex);
			lock.mvButtons.push_back("LivingAreaDoorButton_1_"+alIndex);
			lock.mvButtons.push_back("LivingAreaDoorButton_2_"+alIndex);
			lock.mButtonType = eStationGui_DoorLockAppButtonType_MovingButton;
			lock.msFocusText = "DoorControlAppRoom_"+alIndex;
			return lock;
		}

		//-------------------------------------------------------
		
		bool DoorLockApp_RossCabin()
		{
			if (mbRossShouldEnterDoorCode)
			{
				OnGuiActivateGlitch(1.2f);
				ImGui_AddTimer("CorrectCodeAll_End", 0.25f);
			}
			mbRossShouldEnterDoorCode = true;
			Depth_Audio_Terminal_Negative(ImGui_GetName());
			
			if (ImGui_GetName()=="CommRoomTerminal")
				StationGui_SetActiveApp(eCommRoomTerminalState_Doors_Password);
			else
				StationGui_SetActiveApp(eInfirmaryTerminalState_Doors_Password);
			return true;
		}

		//-------------------------------------------------------
		
		bool OnGuiDoorLockApp_Password()
		{					
			bool bGlitchActive = OnGuiGlitchActive() || ImGui_TimerExists("CorrectCodeAll_End");
			if (bGlitchActive) ImGui_SetModUseInput(false);
			bool bCodeEntered = StationGui_Numpad("", bGlitchActive ? 5 : 4); //setting to 5 if glitching as a hack to disable the OK button
			ImGui_SetModUseInput(true);
			
			// Ross corrects the code
			tString sCode = StationGui_GetNumpadInput();
			tString sCorrectCode = cString_Sub(gsRossPassword, 0, sCode.length());
			
			if (ImGui_TimerOver("CorrectCodeAll_End"))
			{
				sCorrectCode = cString_Sub(gsRossPassword, 0, cMath_Min(sCode.length()+1, gsRossPassword.length()));
				StationGui_SetNumpadInput(sCorrectCode);
				
				if (sCorrectCode != gsRossPassword)
					ImGui_AddTimer("CorrectCodeAll_End", 0.25f);
			}
			
			if (bGlitchActive==false && sCode != sCorrectCode)
			{
				mbRossShouldEnterDoorCode = false;
				OnGuiActivateGlitch(0.75);
				bGlitchActive = true;
				ImGui_AddTimer("CorrectCode", 0.65f);
			}
			if (ImGui_TimerOver("CorrectCode"))
			{
				StationGui_SetNumpadInput(sCorrectCode);
			}
			
			if (bCodeEntered)
			{
				tString sCode = StationGui_GetNumpadInput();
				
				if (sCode == gsRossPassword)
				{
					mbRossRoomUnlocked = true;
					SetDoorButtonsLocked("LivingAreaDoor_4", false, true);
					Depth_Audio_Terminal_Confirm(ImGui_GetName());
					
					// Deactivate password prompt on both terminals
					if (StationGui_GetActiveApp("CommRoomTerminal")==eCommRoomTerminalState_Doors_Password)
						StationGui_SetActiveApp("CommRoomTerminal", eCommRoomTerminalState_Doors);
					if (StationGui_GetActiveApp("InfirmaryTerminal")==eInfirmaryTerminalState_Doors_Password)
						StationGui_SetActiveApp("InfirmaryTerminal", eInfirmaryTerminalState_Doors);
				}
				else
				{	
					Depth_Audio_Terminal_Negative(ImGui_GetName());
					StationGui_SetNumpadInput("");
				}
			}
			return bGlitchActive==false;
		}
		
