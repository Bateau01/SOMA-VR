		/////////////////////////////////////////
		// Terminal *Reactor Control*
		//{///////////////////////////////////////

		//-------------------------------------------------------

		bool mbDecontaminationReady = false;
		bool mbCalledLastHuman = false;

		//-------------------------------------------------------

		void OnGuiReactorControlTerminal(const tString&in asEntityName, float afTimeStep)
		{	
			ImGui_SetTransCategory("04_02_tau_inside");
			
			StationGuiBG_Backdrop();
			StationGuiBG_Taskbar("tau");
			StationGuiBG_Scanlines();
			
			/////////////////
			// Handle glitches
			OnGuiGlitchStart();
			
			if (StationGui_DrawAndCheckErrors()) return;
			
			cStationGui_TextReaderSettings reader;
			
			bool bDrawBackButton = true;
			int lBackApp = eReactorControlTerminalState_MainMenu;
			int lActiveApp = StationGui_GetActiveApp(eReactorControlTerminalState_MainMenu);
			
			switch (lActiveApp)
			{	
				case eReactorControlTerminalState_MainMenu:
				StationGui_AddApp("ReactorControlTerminalApp_PowerInfo");
				StationGui_AddApp("ReactorControlTerminalApp_AccessHistory");
				StationGui_AddApp("IntercomApp_Label");
				StationGui_AddApp("ReactorControlTerminalApp_ReactorHistory", true, eReactorControlTerminalState_ReactorAccess_History);
				StationGui_AddApp("ReactorControlTerminalApp_Map", true, eReactorControlTerminalState_Map);
				StationGui_MainMenu();
				bDrawBackButton = false;
				break;
				
				case eReactorControlTerminalState_ReactorAccess_History:
				OnGuiReactorControlTerminal_History();
				
				break;
				case eReactorControlTerminalState_SitePower:
				OnGuiReactorControlTerminal_SitePower();
				break;
				
				case eReactorControlTerminalState_AccessHistory:
				reader.mvTextFontSize = ImGui_NrmSizeKeepRatio(0.045);
				ImGui_GroupBegin(ImGui_NrmPosGroup(0.275, 0.125, 0), ImGui_NrmSizeGroup(0.45, 0.75));
					StationGui_TextReaderSingle("ReactorControlTerminalApp_AccessHistory", "ReactorControlTerminal_AccessHistory", reader);
				ImGui_GroupEnd();
				break;
				
				case eReactorControlTerminalState_Intercom:
				OnGuiIntercomApp();
				break;
				
				case eReactorControlTerminalState_Map:
				OnGuiMapApp(cVector3f(0.775, 0.525, 1), cVector2f(530, 530));
				break;
			}
			
			OnGuiGlitchEnd();
			
			if (StationGui_BackButton(bDrawBackButton, lBackApp))
			{
				if (lActiveApp == eReactorControlTerminalState_Intercom)
				{
					if (Sound_Exists(ImGui_GetName()+"IntercomDialTone"))
					{
						Sound_Stop(ImGui_GetName()+"IntercomDialTone", 0.5);
						Sound_CreateAtEntity(ImGui_GetName()+"IntercomDialToneStop", 
											 "Entities_Station/tech/terminal_beeps/tau_station_dialler/rooms/tau_dial_rooms_disconnect", 
											 ImGui_GetName(), 0.0, true);
					}
					ImGui_SetStateBool("ContactActive", false);
					IntercomHangUp(0, ImGui_GetName());
				}
				if (lActiveApp == eReactorControlTerminalState_ReactorAccess_History)
				{
					StationGui_ResetGraph();
				}
			}
		}

		//-------------------------------------------------------

		void OnGuiReactorControlTerminal_History()
		{
			cStationGui_GraphSettings settings;
			settings.mfGraphicsSizeMul = 1.2;
			settings.mvNrmGraphicsOffset = cVector3f(0, -0.05, 0);
			
			cColor overlayColor = ImGui_FadeOscillateColor("Linecol", cColor_Green, cColor_Green*0.75, 2);
			Depth_ImGui_AddGraphOverlay(cImGuiGfx("reactorcontrolterminal_outputhistory_1"), overlayColor);
			StationGui_Graph(cImGuiGfx("reactorcontrolterminal_outputhistory_bg"), "ReactorControlTerminalApp_ReactorHistory", settings);
		}

		//-------------------------------------------------------

		void OnGuiReactorControlTerminal_SitePower()
		{
			cImGuiLabelData label = ImGui_GetDefaultLabel();
			label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
			label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.055);
			
			cImGuiTextFrameData text = ImGui_GetDefaultTextFrame();
			text.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
			text.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.055);
			text.mFontAlign = eFontAlign_Center;
			text.mbUseBackgroundGfx = false;
			
			ImGui_DoWindowStart("ReactorControlTerminalApp_PowerInfo", StationGui_CreateDefaultWindowData(), ImGui_NrmPos(cVector3f(0.06, 0.06, 1)), ImGui_NrmSize(cVector2f(0.88, 0.7)));

				float fPowerIntensity = mbRadiationActive ? 1 : 1.5f;
			
				cVector2f vFontSize = label.mFont.mvSize;
				ImGui_ResizeFontToFit("ReactorControlTerminal_EffectLabel", label.mFont, ImGui_GetCurrentGroupSize().x*0.475);
				float fEffect = GetReactorValue("Effect", 650, 710, 2)*fPowerIntensity;
				ReactorStatusText("ReactorControlTerminal_EffectLabel", int(fEffect)+" kW", "", mbRadiationActive ? cColor_Red : cColor_Green, 0.2, label);
				
				label.mFont.mvSize = vFontSize;
				ImGui_ResizeFontToFit("ReactorControlTerminal_VoltageLabel", label.mFont, ImGui_GetCurrentGroupSize().x*0.475);
				float fVoltage = GetReactorValue("Voltage", 687, 693, 2)*fPowerIntensity;
				ReactorStatusText("ReactorControlTerminal_VoltageLabel", int(fVoltage)+" V", "", mbRadiationActive ? cColor_Red : cColor_Green, 0.3, label);
				
				label.mFont.mvSize = vFontSize;
				ImGui_ResizeFontToFit("ReactorControlTerminal_BackupPowerLabel", label.mFont, ImGui_GetCurrentGroupSize().x*0.475);
				ReactorStatusText("ReactorControlTerminal_BackupPowerLabel", "ReactorControlTerminal_Offline", "04_02_tau_inside", cColor_Red, 0.5, label);
			ImGui_DoWindowEnd();
		}

		//-------------------------------------------------------
		
		float GetReactorValue(const tString &in asName, float afMin, float afMax, float afFreqMul=4.0f)
		{
			float fCurrentVal = ImGui_GetStateFloat(asName+"_signal_0", afMin);
			if (fCurrentVal > afMax)
				ImGui_SetStateFloat(asName+"_signal_0", afMax);
				
			else if (fCurrentVal < afMin)
				ImGui_SetStateFloat(asName+"_signal_0", afMin);
				
			return Depth_ImGui_GetOscillatingSignalValue(asName, 0, eEasing_Linear, afMin, afMax, afFreqMul);
		}

		//-------------------------------------------------------
		
		void ReactorStatusText(const tString &in asLabel, const tString &in asStatus, 
							   const tString &in asLangCat, const cColor &in aStatusColor, float afY,
							   cImGuiLabelData &in aLabelData)
		{
			aLabelData.mFontAlign = eFontAlign_Right;
			ImGui_DoLabelExt(asLabel, aLabelData, ImGui_NrmPosGroup(cVector3f(0, afY, 1)), ImGui_NrmSizeGroup(0.5, -1));
			ImGui_SetModColorMul(aStatusColor);
			
			tString sPrevLangCat = ImGui_GetTransCategory();
			ImGui_SetTransCategory(asLangCat);
			aLabelData.mFontAlign = eFontAlign_Left;
			ImGui_DoLabelExt(asStatus, aLabelData, ImGui_NrmPosGroup(cVector3f(0.55, afY, 1)), -1);
			
			ImGui_SetTransCategory(sPrevLangCat);
			ImGui_SetModColorMul(cColor_White);
		}
		
		//} END REACTOR CONTROL TERMINAL

