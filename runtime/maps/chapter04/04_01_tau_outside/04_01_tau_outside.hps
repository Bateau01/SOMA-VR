			Light_SetVisible("PointLight_76",false);
			Light_SetVisible("PointLight_78",false);
			Light_SetVisible("PointLight_79",false);
			ParticleSystem_SetColor("ParticleSystem_12",cColor(0.5,0.5,0.5));
			ParticleSystem_SetColor("ParticleSystem_13",cColor(0.5,0.5,0.5));
			ParticleSystem_SetColor("ParticleSystem_14",cColor(0.5,0.5,0.5));
			mbSmokerPower = false;
