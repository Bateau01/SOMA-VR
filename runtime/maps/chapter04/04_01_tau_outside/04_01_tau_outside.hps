		/////////////////////////////////////////
		// Scene 3 Event H * Find Cave Tunnel *
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlCaveDistortionID = -1;
		
		
		//-------------------------------------------------------
		
		bool OnTriggerInsideCave(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==1)
			{
				cLux_AddDebugMessage("Enter cave.");
				
				Swarm_SetPlayerIsInBuilding("swarm_1", true);
				
				SetStormFollowingPlayer(false);
				mlCaveDistortionID = Effect_VideoDistortion_Start(0.1f, -1.0f, 3.0f, 3.0f);
				
				StartSpiders();
				
				if (cLux_GetExplorationModeActive() == false || Entity_IsActive("angler_fish_1") == false) return true;
				Map_AddTimer("AnglerfishLeaveTimer", 5.f, "Timer_AnglerfishLeave");
			}
			else 
			{
				cLux_AddDebugMessage("Exit cave.");
				
				EndSpiders();
				
				Swarm_SetPlayerIsInBuilding("swarm_1", false);
				
				SetStormFollowingPlayer(true);
				Effect_VideoDistortion_FadeOut(mlCaveDistortionID, 3.0f);
				
				if (cLux_GetExplorationModeActive() == false || Entity_IsActive("angler_fish_1") == false) return true;
				Map_RemoveTimer("AnglerfishLeaveTimer");
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void Timer_AnglerfishLeave(const tString &in asTimer)
		{
			Anglerfish_ForceLeave("angler_fish_1");
		}
		
		//-------------------------------------------------------
		int lSpiderIndex = 1;
		 
		void StartSpiders()
		{
			Entity_SetActive("cave_spider_animated_*", true);
			Map_AddTimer("TimerSpiderChange",0.5,"TimerSpiderChange");
		}
		
		//-------------------------------------------------------
		
		void TimerSpiderChange(const tString& in asName)
		{
			// Change a bunch of spiders
			int lIdle;
			for (int i=1;i<=20;i++)
			{
				int lSpider = (lSpiderIndex+i*13) % 227;
				if (Entity_Exists("cave_spider_animated_"+lSpider))
				{
					lIdle = cMath_RandRectl(1,3);
					Entity_PlayAnimation("cave_spider_animated_"+lSpider, "idle_"+lIdle, 0.1, true);
				}
			}
			
			lSpiderIndex+=11;
			
			Map_RestartCurrentTimer();
		}
		
		//-------------------------------------------------------
		
		void EndSpiders()
		{
			Map_RemoveTimer("TimerSpiderChange");
			Entity_SetActive("cave_spider_animated_*", false);
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerDeeperInsideCave(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==1)
			{
				cLux_AddDebugMessage("Deeper in cave.");
				FadeStormMapParams(false);
			}
			else 
			{
				cLux_AddDebugMessage("Leaving deeper cave.");
				FadeStormMapParams(true);
			}
			return true;
		}

		//-------------------------------------------------------
		
		bool OnTriggerStormCaveEntrance(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLuxArea@ pArea = cLux_ID_Area(m_idPSArea);
			pArea.SetPosition(Map_GetEntity("StormParticleAreaCaveEntrance").GetPosition());
			return true;
		}

		//-------------------------------------------------------

		bool OnTriggerStormCaveExit(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLuxArea@ pArea = cLux_ID_Area(m_idPSArea);
			pArea.SetPosition(Map_GetEntity("StormParticleAreaCaveExit").GetPosition());
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END Find Cave Tunnel
				
		/////////////////////////////////////////
		// Scene 3 Event I * Angler Fish Bait *
		//{//////////////////////////////////////
	
		//-------------------------------------------------------
		
		bool mbAnglerFishActive=false;

		//-------------------------------------------------------
		
		bool OnTriggerStartAnglerFish(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Start angler fish");
			
			Entity_SetActive("angler_fish_1", true);
			Agent_SetAutoDisableWhenOutOfSightActive("angler_fish_1", true, 20.0f);
			AttackMeter_SetAttackerTeleportPosition("LanterFishTeleport*");
			Agent_SetAutoDisableCallback("angler_fish_1", "AnglerFisherDisabled");
			
			Music_Stop(8.0f, eMusicPrio_BgAmb); //Cave ambient should be stopped now!
			
			mbAnglerFishActive = true;
			
			return false;
		}
		
		void AnglerFisherDisabled(const tString&in asEntityName)
		{
			cLux_AddDebugMessage("Angler fish is gone!");
			
			mbAnglerFishActive = false;
			
			if(mbUsingInsideCaveAudio && mbCaveMusicActive==false)
			{
				Music_PlayExt("04_01_stormstart", true, 0.45f, 1.0f, 8.0f, 0.0f, eMusicPrio_BgAmb, true);
				mbCaveMusicActive = true;
			}
				
			
			
			AttackMeter_SetAttackerTeleportPosition("");
		}
		
		//-------------------------------------------------------
		
		bool OnCaveFarDoor(const tString &in asArea, const tString &in asEntity, int alState)
		{
			if (alState==1)
			{
				// In
				Entity_SetActive("LightBot",true);
			}
			else
			{
				// Out
				Entity_SetActive("LightBot",false);
			}
			return true;
		}	
				
