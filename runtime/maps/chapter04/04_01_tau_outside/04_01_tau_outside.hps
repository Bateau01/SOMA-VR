			Sound_Fade("StormAudio_Stage2", 0.35f, 1.5f);

			//Start timer for thunder again, fade up storm on release
			Map_AddTimer("StormAudio_Stage2_ThunderSweetenerRelease", 2.5f, "StormAudio_Stage2_Sweeteners");
			Map_AddTimer("StormAudio_Stage2_ThunderSweetener", cMath_RandRectf(20.0f,30.0f), "StormAudio_Stage2_Sweeteners");
		}
		
		//Releases
		if(asTimer == "StormAudio_Stage2_ThunderSweetenerRelease")
		{
			cLux_AddDebugMessage("Thunder Release");
			Sound_Fade("StormAudio_Stage2", 1.0f, 3.0f);
		}
	}
			
	//-------------------------------------------------------
	
	bool mbUsingInsideCaveAudio=false;
	bool mbCaveMusicActive = false;
	bool StormAudio_CaveTrigger(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState==1)
			{
			
			mbUsingInsideCaveAudio = true;
				
			//turn on ambient area
			Entity_SetActive("AMB_Cave", true);
			
			//Fade audio and start drone
			Sound_FadeGlobalVolume(0.65f, 8.0f, eSoundEntryType_WorldClean);
			
			if(mbAnglerFishActive==false && mbCaveMusicActive==false)
			{
				Music_PlayExt("04_01_stormstart", true, 0.45f, 1.0f, 8.0f, 0.0f, eMusicPrio_BgAmb, true);
				mbCaveMusicActive=true;
			}
				
			
			//Set storm ambient areas active
			cLux_AddDebugMessage("Entered Cave");
			if (mlStormAudioStage==1)
			{
				//Stage 1 shut off
				Sound_Fade("StormAudio_Stage1", 0.0f, 6.0f);
				Map_RemoveTimer("StormAudio_Stage1_ThunderSweetener");
				Sound_Stop("StormAudio_Stage1_Thunder", 6.0f);
			}
			
			if (mlStormAudioStage==2)
			{		
				//Stage 2 shut off
				Sound_Fade("StormAudio_Stage2", 0.0f, 6.0f);
				Map_RemoveTimer("StormAudio_Stage2_ThunderSweetener");
				Sound_Stop("StormAudio_Stage2_Thunder", 6.0f);
			}
		}
		
		if (alState==-1)
		{
			mbUsingInsideCaveAudio = false;
			
			//turn on ambient area
			Entity_SetActive("AMB_Cave", false);
			
			//Resume storm audio and disable cave ambient areas
			cLux_AddDebugMessage("Exited Cave");
			Sound_FadeGlobalVolume(1.0f, 4.0f, eSoundEntryType_WorldClean);
			Music_Stop(5.0f, eMusicPrio_BgAmb);
			mbCaveMusicActive = false;
			
			if (mlStormAudioStage==1)
			{
				Sound_Fade("StormAudio_Stage1", 1.0f, 1.5f);
				Map_AddTimer("StormAudio_Stage1_ThunderSweetener", cMath_RandRectf(20.0f,30.0f), "StormAudio_Stage1_Sweeteners");
				Entity_SetActive("AMB_Observatory", false);
				Entity_SetActive("AMB_SmokerPlant", false);
			}
			else if (mlStormAudioStage==2)
			{
				Sound_Fade("StormAudio_Stage2", 1.0f, 1.5f);
				Map_AddTimer("StormAudio_Stage2_ThunderSweetener", cMath_RandRectf(20.0f,30.0f), "StormAudio_Stage2_Sweeteners");
				Entity_SetActive("AMB_Observatory", false);
				Entity_SetActive("AMB_SmokerPlant", false);
			}
		}
		return true;
	}
				
	//-------------------------------------------------------
	
	//} END AUDIO
	
	/////////////////////////////////////////
	// ==============
	// Music
	// ==============
	//{//////////////////////////////////////
				
	//-------------------------------------------------------
	
	bool mbVillageAmbientMusicPlaying = false;
	
	void StartVillageMusicAmbient(const tString &in asTimer)
	{
		Music_PlayExt("04_01_elevatorlanding", false, 0.25f, 1.0f, 0.0f, 1.5f, eMusicPrio_BigEvent, false);
		Music_PlayExt("04_01_village", true, 0.25f, 1.0f, 0.0f, 0.0f, eMusicPrio_BgAmb, true);
		mbVillageAmbientMusicPlaying = true;
		cLux_AddDebugMessage("Trigger Village Music");
	}
		
	//-------------------------------------------------------
	
	bool StopVillageAmbientMusicTrigger(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbVillageAmbientMusicPlaying==true)
		{
			StopAmbientMusic(5.0f);
			mbVillageAmbientMusicPlaying = false;
			Map_RemoveTimer("FadeUpMusicRossBody");
		}
		return false;
	}
	
	
	bool StopVillageAmbient(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbVillageAmbientMusicPlaying==true)
		{
			StopAmbientMusic(5.0f);
			mbVillageAmbientMusicPlaying = false;
			Map_RemoveTimer("FadeUpMusicRossBody");
		}
		return false;
	}
	//-------------------------------------------------------
	
	void StopAmbientMusic(float afAmbientMusicFadeTime)
	{
		Music_Stop(afAmbientMusicFadeTime, eMusicPrio_BgAmb);
		cLux_AddDebugMessage("Ambient Music Stopping");
	}
			
	//-------------------------------------------------------
	
	bool mbMarkersMusicPlayed = false;
	
	void ActivateMarkersMusic(const tString &in asTimer)
	{
		if (mbMarkersMusicPlayed==false)
		{
			Music_PlayExt("04_01_activatemarkers", false, 0.75f, 1.0f, 0.0f, 0.0f, eMusicPrio_BigEvent, false);
			mbMarkersMusicPlayed = true;
		}
		
		if (mbMarkersMusicPlayed==true)
		{
			cLux_AddDebugMessage("Music already triggered");
		}
	}
			
	//-------------------------------------------------------
	
	bool OnTriggerTauApproachMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		Music_PlayExt("04_01_tauarrive", false, 1.0f, 1.0f, 0.0f, 0.0f, eMusicPrio_BgAmb, true);
		Sound_FadeGlobalVolume(0.65f, 7.0f, eSoundEntryType_WorldClean);
		Map_AddTimer("ReturnMixMusic", 16.0f, "ReturnMixMusic");
		return false;
	}
	
	void ReturnMixMusic(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 20.0f, eSoundEntryType_WorldClean);
	}
	
	//-------------------------------------------------------
	
	bool mbLightBotMusicActive = false;
	void LightBotMusic(const tString &in asTimer)
	{
		if(mbLightBotMusicActive==false)
		{
			Music_PlayExt("04_01_last_walk", true, 0.75f, 1.0f, 0.0f, 0.0f, eMusicPrio_BgAmb, false);
			mbLightBotMusicActive = true;
		}
	}
	
	void LightBotMusicStop()
	{
		Music_Stop(4.0f, eMusicPrio_BgAmb);
		mbLightBotMusicActive = false;
	}
	
	//-------------------------------------------------------
	
	//}END Music
}