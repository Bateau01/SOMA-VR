		void OnGuiElevatorStart(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("03_03_omicron_descent");
			
			ImGui_GroupBegin(cVector3f_Zero, ImGui_GetSize());
			
			cImGuiLabelData label;
			label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Medium));
			label.mFont.mvSize = cVector2f(50, 50);
			label.mFontAlign = eFontAlign_Center;

			ImGui_SetModColorMul(gStationGuiColor_Highlight);
			ImGui_DoLabelExt("GUIStartKnob1", label, 	ImGui_NrmPos( cVector3f(0.0f, 0.00f, 0)), 
												ImGui_NrmSize( cVector2f(1.0f,0.2f) ),1.0f); 
			ImGui_SetModColorMul(gStationGuiColor_Normal);
			ImGui_DoLabelExt("GUIStartKnob1_0", label, 	ImGui_NrmPos( cVector3f(0.0f, 0.09f, 0)), 
												ImGui_NrmSize( cVector2f(1.0f,0.2f) ),1.0f); 
											
			ImGui_SetModColorMul(gStationGuiColor_Highlight);
			ImGui_DoLabelExt("GUIStartKnob2", label, 	ImGui_NrmPos( cVector3f(0.0f, 0.35f, 0)), 
												ImGui_NrmSize( cVector2f(1.0f,0.2f) ),1.0f); 
			ImGui_SetModColorMul(gStationGuiColor_Normal);
			ImGui_DoLabelExt("GUIStartKnob2_0", label, 	ImGui_NrmPos( cVector3f(0.0f, 0.44f, 0)), 
												ImGui_NrmSize( cVector2f(1.0f,0.2f) ),1.0f);
												
			ImGui_ResetModifiers();
			
			ImGui_GroupEnd();
		}
		
