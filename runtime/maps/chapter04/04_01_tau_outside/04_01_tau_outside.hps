		}
		
		//-------------------------------------------------------
		
		void OnChangeSmokerPowerLever(const tString &in asEntity, int alState)
		{
			if (alState==1)
			{
				Lamp_SetLit("SmokerPowerIndicator", false, true);
				
				if (mbLightBotPowered)
				{
					Sound_CreateAtEntity("SmokerPlantLightSwitch", "Entities_OceanBottom/objects/theta_door_open/cylinder/lever_end", "BotStartUpSoundSrc");
				}
				
				
				else if (!mbLightBotPowered)
				{
					Entity_SetEffectsActive("LightBot",true,true);
					Entity_PlayAnimation("LightBot","Idle",0.5f,true);
					mbLightBotPowered = true;
					Sound_CreateAtEntity("LightBotWakeUp", "04_01_tau_outside/SFX/lightbot_generator_on", "BotStartUpSoundSrc");
				}
			}
			else if (alState==-1)
			{
				Lamp_SetLit("SmokerPowerIndicator", true, true);
				
				Sound_CreateAtEntity("SmokerPlantLightSwitch", "Entities_OceanBottom/objects/theta_door_open/cylinder/cylinder_pull_end", "BotStartUpSoundSrc");
			}
			Lever_SetAutoMoveTarget("SmokerPowerLever",alState);
		}
		
