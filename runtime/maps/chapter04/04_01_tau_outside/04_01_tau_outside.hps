		}
			
				
		//-------------------------------------------------------

		bool mbLightBotIdleBeepsAllowed = true;
		void StartLightbotIdleSounds()
		{
			//remove possible old instance of timer
			Map_RemoveTimer("LightbotIdleBeeps");
			Map_AddTimer("LightbotIdleBeeps", cMath_RandRectf(7.0f,12.0f), "LightbotIdleBeeps");
			mbLightBotIdleBeepsAllowed = true;
		}

		void LightbotIdleBeeps(const tString &in asTimer)
		{
			Map_AddTimer("LightbotIdleBeeps", cMath_RandRectf(6.0f,8.0f), "LightbotIdleBeeps");

			if(mbLightBotIdleBeepsAllowed==true && mbLeviathanAttackStarted==false)
			{
				Sound_CreateAtEntity("LightBotIdle", "NPC_Kate/lightbot/talk/idle_talk", "LightBot");
			}
		}

		void StopLightbotIdleBeeps()
		{
			mbLightBotIdleBeepsAllowed = false;
			Map_RemoveTimer("LightbotIdleBeeps");

			if(Sound_Exists("LightBotIdle"))
			{
				Sound_Stop("LightBotIdle", 0.25f);
			}
		}
	
		//-------------------------------------------------------
		// Light bot proximity area used to control music and ducking during events
		bool LightBotProximity(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState==1)
			{
				cLux_AddDebugMessage("Within Prox of Lightbot");
			}
			else
			{
				cLux_AddDebugMessage("Left Prox of Lightbot");
			}
			return true;
		}
		
