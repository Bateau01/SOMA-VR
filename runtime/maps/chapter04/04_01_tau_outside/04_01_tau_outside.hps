		/////////////////////////////////////////
		// Scene 2 * Enter buildings *
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool OnTriggerInsideStartBuilding(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==1)
			{
				Swarm_SetPlayerIsInBuilding("swarm_1", true);
				
				if(mlStormStrength>0)
				{
					StormAudio_EnterBuildings();
					
					cLux_AddDebugMessage("Building is "+asChild);
					
					SetStormFollowingPlayer(false);
					FadeStormMapParams(false);
				}
			}
			else
			{
				Swarm_SetPlayerIsInBuilding("swarm_1", false);
				
				if(mlStormStrength>0)
				{
					StormAudio_ExitBuildings();
					
					SetStormFollowingPlayer(true);
					FadeStormMapParams(true);
				}
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END ENable the Swarm
		
	
