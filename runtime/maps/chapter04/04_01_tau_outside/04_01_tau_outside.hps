	//First thunder sweetener
	bool Audio_TriggerFirstThunder(const tString &in asParent, const tString &in asChild, int alState)
	{
		StormAudio_ExitElevator();
		Map_AddTimer("VillageMusicStart", 1.5f, "StartVillageMusicAmbient");
		Map_AddTimer("StormAudio_Stage0_ThunderSweetener", cMath_RandRectf(20.0f,30.0f), "StormAudio_Stage0_Sweeteners");
		return false;
	}
		
	void StormAudio_ExitElevator()
	{
		cLux_AddDebugMessage("Storm sound - Exit Elevator triggered");
		Sound_CreateAtEntity("ThunderExitElevator", "04_01_tau_outside/SFX/storm/sweeteners/exit_elevator", "Player", 0.0f, false, 1.0f);
		Sound_FadeGlobalVolume(0.65f, 3.0f, eSoundEntryType_WorldClean);
		Map_AddTimer("FadeUpExitElevator", 3.0f, "FadeUpExitElevator");
	}
	
	//-------------------------------------------------------
	
	void FadeUpExitElevator(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 6.0f, eSoundEntryType_WorldClean);
	}

	//-------------------------------------------------------
	bool mbIsStormAudioPlaying = false;
	int mlStormAudioStage = 0;
	
	void StormAudioHandler(float afStormFadeTime, float afStormVolume, int StormStage=1)
	{
		//Stage 1 functions
		if(StormStage==1)
		{
			//Remove stage 0 bits
			if(mlStormAudioStage==0)
			{
				//Stop stage 0 sounds and timers		
				Map_RemoveTimer("StormAudio_Stage0_ThunderSweetener");
				Sound_Stop("StormAudio_Stage0_Thunder", 6.0f);
			}
			
			//Check if storm is active, if not, then begin
			if (mbIsStormAudioPlaying==false)
			{
				//Storm starts sweetener goes here
				cLux_AddDebugMessage("Storm Sounds Phase 1 Triggered");
				
				Sound_CreateAtEntity("Stage1Sweetener", "04_01_tau_outside/SFX/storm/sweeteners/stage1", "Player", 0.0f, false, 1.0f);
				
				Sound_CreateAtEntity("StormAudio_Stage1", "04_01_tau_outside/AMB/storm/stage_1", "Player", afStormFadeTime, true, 1.0f);
				Sound_CreateAtEntity("StormAudio_Stage2", "04_01_tau_outside/AMB/storm/stage_2", "Player", afStormFadeTime, true, 0.0f);
				Map_AddTimer("StormAudio_Stage1_ThunderSweetener", cMath_RandRectf(20.0f,30.0f), "StormAudio_Stage1_Sweeteners");
				Entity_SetActive("AMB_Global", false);
				
				//Update vars
				mlStormAudioStage = 1;
				mbIsStormAudioPlaying = true;
			}
			
			if (mbIsStormAudioPlaying==true)
			{
				cLux_AddDebugMessage("Storm Sounds Phase 1 Triggered");
				
				Sound_Fade("StormAudio_Stage1", 1.0f, afStormFadeTime);
				Map_AddTimer("StormAudio_Stage1_ThunderSweetener", cMath_RandRectf(20.0f,30.0f), "StormAudio_Stage1_Sweeteners");
				Entity_SetActive("AMB_Global", false);
				
				//Stop stage 2 bits if active
				if(mlStormAudioStage==2)
				{
					Sound_Fade("StormAudio_Stage2", 0.0f, afStormFadeTime);
							
					//Stage stage 2 sounds and timers
					Map_RemoveTimer("StormAudio_Stage2_WindGustSweetener");
					Sound_Stop("StormAudio_Stage2_WindGust", 3.0f);
				
					Map_RemoveTimer("StormAudio_Stage2_ThunderSweetener");
					Sound_Stop("StormAudio_Stage2_Thunder", 6.0f);
				}
				
				//Update Vars
				mlStormAudioStage = 1;
			}

		}
		
		//Stage 1 going into Stage 2
		if(StormStage==2)
		{
			//Stop Stage 0 sounds and timers
			if(mlStormAudioStage==0)
			{
				//Stop stage 0 sounds and timers		
				Map_RemoveTimer("StormAudio_Stage0_ThunderSweetener");
				Sound_Stop("StormAudio_Stage0_Thunder", 6.0f);
			}
			
			//Stop stage 1 sounds and timers
			if(mlStormAudioStage==1)
			{
				cLux_AddDebugMessage("Storm Audio Transition to Stage 2 Triggered");
				
				Sound_Fade("StormAudio_Stage1", 0.0f, afStormFadeTime);
		
				Map_RemoveTimer("StormAudio_Stage1_WindGustSweetener");
				Sound_Stop("StormAudio_Stage1_WindGust", 3.0f);
		
				Map_RemoveTimer("StormAudio_Stage1_ThunderSweetener");
				Sound_Stop("StormAudio_Stage1_Thunder", 6.0f);
			}
			
			
			if(mbIsStormAudioPlaying==false)
			{
				Sound_CreateAtEntity("StormAudio_Stage1", "04_01_tau_outside/AMB/storm/stage_1", "Player", afStormFadeTime, true, 0.0f);
				Sound_CreateAtEntity("StormAudio_Stage2", "04_01_tau_outside/AMB/storm/stage_2", "Player", afStormFadeTime, true, afStormVolume);
				Map_AddTimer("StormAudio_Stage2_ThunderSweetener", cMath_RandRectf(20.0f,30.0f), "StormAudio_Stage2_Sweeteners");
			}
			
			if(mbIsStormAudioPlaying==true)
			{
				Sound_Fade("StormAudio_Stage2", 1.0f, afStormFadeTime);
				Map_AddTimer("StormAudio_Stage2_ThunderSweetener", cMath_RandRectf(20.0f,30.0f), "StormAudio_Stage2_Sweeteners");
			}
			
			mlStormAudioStage = 2;
			mbIsStormAudioPlaying = true;
		}
	}
			
	//-------------------------------------------------------
	
	void StormAudio_Stop(float afStormFadeTime, float afStormVolume)
	{
		if(mlStormAudioStage==1)
		{
			Sound_Stop("StormAudio_Stage1", afStormFadeTime);
			Map_RemoveTimer("StormAudio_Stage1_WindGustSweetener");
			Sound_Stop("StormAudio_Stage1_WindGust", 3.0f);
		
			Map_RemoveTimer("StormAudio_Stage1_ThunderSweetener");
			Sound_Stop("StormAudio_Stage1_Thunder", 6.0f);
		}
		
		if(mlStormAudioStage==2)
		{
			Sound_Stop("StormAudio_Stage2", afStormFadeTime);
							
			//Stage stage 2 sounds and timers
			Map_RemoveTimer("StormAudio_Stage2_WindGustSweetener");
			Sound_Stop("StormAudio_Stage2_WindGust", 3.0f);
				
			Map_RemoveTimer("StormAudio_Stage2_ThunderSweetener");
			Sound_Stop("StormAudio_Stage2_Thunder", 6.0f);
		}
		
		mlStormAudioStage = 0;
		mbIsStormAudioPlaying = false;
	}
			
			
	//-------------------------------------------------------
	
	void StormAudio_EnterBuildings(float afStormFadeTime=3.0f, float afStormVolume=0.0f)
	{
		//activate soundscape areas for buildings
		Entity_SetActive("AMB_Observatory", true);
		Entity_SetActive("AMB_SmokerPlant", true);
		Entity_SetActive("AMB_Container_*", true);
		cLux_AddDebugMessage("Entered building - ducking storm");
		
		if(mbEnterTau==false)
		{
			//Start muffled thunder
			Map_AddTimer("StormAudio_Stage0_ThunderSweetener", cMath_RandRectf(20.0f,30.0f), "StormAudio_Stage0_Sweeteners");
		}
		
		if (mlStormAudioStage==1)
		{
			//Stage 1 shut off
			Sound_Fade("StormAudio_Stage1", afStormVolume, afStormFadeTime);
			Map_RemoveTimer("StormAudio_Stage1_WindGustSweetener");
			Sound_Stop("StormAudio_Stage1_WindGust", 3.0f);
			
			Map_RemoveTimer("StormAudio_Stage1_ThunderSweetener");
			Map_RemoveTimer("StormAudio_Stage1_ThunderSweetenerRelease");
			Sound_Stop("StormAudio_Stage1_Thunder", 6.0f);
		}
		
		if (mlStormAudioStage==2)
		{		
			//Stage 2 shut off
			Sound_Fade("StormAudio_Stage1", afStormVolume, afStormFadeTime);
			Sound_Fade("StormAudio_Stage2", afStormVolume, afStormFadeTime);
			Map_RemoveTimer("StormAudio_Stage2_ThunderSweetener");
			Map_RemoveTimer("StormAudio_Stage2_ThunderSweetenerRelease");
			Sound_Stop("StormAudio_Stage2_Thunder", 6.0f);
		}
	}
			
	//-------------------------------------------------------
	
	void StormAudio_ExitBuildings(float afStormFadeTime=1.0f, float afStormVolume=1.0f)
	{
		Map_RemoveTimer("StormAudio_Stage0_ThunderSweetener");
		Sound_Stop("StormAudio_Stage0_Thunder", 7.0f);
		
		cLux_AddDebugMessage("Building exit - "+mlStormStrength);
		if (mlStormAudioStage==1)
		{
			Sound_Fade("StormAudio_Stage1", afStormVolume, afStormFadeTime);
			Map_AddTimer("StormAudio_Stage1_ThunderSweetener", cMath_RandRectf(20.0f,30.0f), "StormAudio_Stage1_Sweeteners");

		}
		else if (mlStormAudioStage==2)
		{
			Sound_Fade("StormAudio_Stage2", afStormVolume, afStormFadeTime);
			Map_AddTimer("StormAudio_Stage2_ThunderSweetener", cMath_RandRectf(20.0f,30.0f), "StormAudio_Stage2_Sweeteners");
		}
		
		Entity_SetActive("AMB_Observatory", false);
		Entity_SetActive("AMB_SmokerPlant", false);
		Entity_SetActive("AMB_Container_*", false);
	}
			
	//-------------------------------------------------------
	
	void StormAudio_Stage0_Sweeteners(const tString &in asTimer)
	{
		if(asTimer == "StormAudio_Stage0_ThunderSweetener")
		{
			//Trigger thunder and duck storm 
			cLux_AddDebugMessage("Stage 0 Thunder triggered");
			Sound_CreateAtEntity("StormAudio_Stage0_Thunder", "04_01_tau_outside/AMB/storm/thunder/stage_0", "Player", 0.0f, false, 1.0f);

			//Start timer for thunder again, fade up storm on release
			Map_AddTimer("StormAudio_Stage0_ThunderSweetenerRelease", 2.5f, "StormAudio_Stage0_Sweeteners");
			Map_AddTimer("StormAudio_Stage0_ThunderSweetener", cMath_RandRectf(25.0f,35.0f), "StormAudio_Stage0_Sweeteners");
		}
		
		if(asTimer == "StormAudio_Stage0_ThunderSweetenerRelease")
		{
			//Bring volume back up
			cLux_AddDebugMessage("Thunder Release");
		}
	}
			
	//-------------------------------------------------------
	
	void StormAudio_Stage1_Sweeteners(const tString &in asTimer)
