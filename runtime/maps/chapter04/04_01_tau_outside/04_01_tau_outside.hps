const float gfElevatorTargetY = 250.414f;
const float gfElevatorSlowdownY = 281.6f;
const float gfElevatorMaxSpeed = 10.00f;
const float gfFakeSpeedScale = 15.0f/gfElevatorMaxSpeed;
const float gfElevatorTalkPart2Y = 450.0f;

const float gfDepthDisplayStart = 115.0f;	// Depth we're starting at
const float gfStationDepth = 4109.0f;		// Depth station is at
const float gfDepthDisplayHeight = 4400.0f;  // Total height of the display

// Probes
const float gfProbe1Depth = 400.0f;
const float gfProbe2Depth = 1700.0f;
const float gfProbe3Depth = 2900.0f;

// Zones
const float gfZone1 = 200.0f;
const float gfZone2 = 1000.0f;
const float gfZone3 = 3000.0f;

const float gfDofMax = 3.0f;

const float gFlesherShadowFadeTime = 1.0f;
// Random ranges
const cVector2f gvFlesherShadowAppearTimes = cVector2f(45.0f,60.0f);
const cVector2f gvFlesherShadowLingerTimes = cVector2f(15.0f,20.0f);
const cVector2f gfFlesherShadowDistances = cVector2f(9.0f,14.0f);
const float gFlesherShadowVanishDistance = 8.0f;
const float gFlesherShadowCloseVanishDistance = 3.5f;

const float gfFogNormal = 45.0f;
const float gfFogStorm1 = 40.0f;
const float gfFogStorm2 = 35.0f;
const float gfFogStorm3 = 25.0f;

const float gfParticleAlpha = 0.75f;

