		Pathfinder_Track_Clear("leviathan_2");
		Pathfinder_Track_Add("leviathan_2", "PathNodeArea_11");
		Pathfinder_Track_Add("leviathan_2", "PathNodeArea_12");
		Pathfinder_Track_Start("leviathan_2", false, 0.5f, "Leviathan1_OnReachedCallPoint");
		
		//Sound
		Map_AddTimer("LeviathanSighting1Mixer", 4.0f, "LeviathanSightingMixer");
		Sound_CreateAtEntity("LeviathanSighting1", "04_01_tau_outside/SFX/leviathan_sighting_001", "leviathan_2");
	}
	
