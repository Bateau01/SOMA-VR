		ImGui_PreloadImage("ossymbol_graph", eImGuiGfx_Texture);
		ImGui_PreloadImage("observatory_graph1", eImGuiGfx_Texture);
		ImGui_PreloadImage("observatory_graph2", eImGuiGfx_Texture);
		ImGui_PreloadImage("observatory_graph3", eImGuiGfx_Texture);
		ImGui_PreloadImage("observatory_graphs_squid", eImGuiGfx_Texture);
