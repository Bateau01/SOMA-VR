		//-------------------------------------------------------
		bool mbLightBotPastAttackPoint = false;
		bool mbPlayerPastAttackPoint = false;
		
		bool OnTriggerLeviathanAttack(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (msLightBotDest!="Tau")
			{
				cLux_AddDebugMessage("Bot not on its way to Tau");
				return true;
			}
				
			if (asChild=="Player")
				mbPlayerPastAttackPoint = (alState==1);
			if (asChild=="LightBot")
				mbLightBotPastAttackPoint = (alState==1);
				
			// Only attack if both the player & the bot are in the right area.
			if (mbLightBotPastAttackPoint&&mbPlayerPastAttackPoint)
			{
				cLux_AddDebugMessage("Bot and player past attack point - attacking.");
				StartLeviathanAttack();
				return false;
			}
			
			cLux_AddDebugMessage("Bot:"+mbLightBotPastAttackPoint+" player:"+mbPlayerPastAttackPoint);
			return true;
		}

		//-------------------------------------------------------

		void StartLeviathanAttack()
		{
			mbLeviathanAttackStarted = true;
			Leviathan_SetLightBrightness("leviathan_3",10.0f);
			Entity_SetActive("leviathan_3",true);
			
			LightBot_StopFlicker();
			
			//disable barks as we have specific event sfx
			BarkMachine_SetActive("leviathan_3", false);
			
			Leviathan_SetSpeed_Hunt("leviathan_3");
			Pathfinder_Track_Clear("leviathan_3");
			for (int i=1;i<=5;++i)
				Pathfinder_Track_Add("leviathan_3","LevAttackNode_"+i);
			Pathfinder_Track_Start("leviathan_3",false,0.25f,"OnLevAttackHitEndOfTrack");
		}
		
		//-------------------------------------------------------
		
		bool mbMoveLightBot = false;
		bool mbLeviathanAttackStarted = false;
		
		void OnLevAttackHitEndOfTrack(const tString& in asEntityName)
		{
			cLux_AddDebugMessage("Lev hit end of track.");
			
			Leviathan_SetSpeed_HuntDash("leviathan_3");
			Pathfinder_Track_Clear("leviathan_3");
			Leviathan_SetState_CirclePlayer("leviathan_3");
			CharMover_MoveToEntity("leviathan_3","LightBot");
			
			Pathfinder_Stop("LightBot");
			Pathfinder_Track_Clear("LightBot");

			CharMover_MoveToEntity("LightBot","leviathan_3");
			
			//Lightbot attack sounds
			LightBotMusicStop();
			Sound_CreateAtEntity("LeviathanEatEvent", "04_01_tau_outside/SFX/lev_eat_lightbot", "leviathan_3");
			if (Entity_GetCollide("Player", "LightBotProx"))
			{
				Sound_FadeGlobalVolume(0.5f, 3.0f, eSoundEntryType_WorldClean);
				Map_AddTimer("FadeUpLightBotAttack", 8.0f, "FadeUpLightBotAttack");
			}
			
			Effect_VideoDistortion_Start(0.5f,5.0f,1.0f,1.0f);
			
			mbMoveLightBot = true;
		}
				
		//-------------------------------------------------------
		
		void FadeUpLightBotAttack(const tString &in asTimer)
		{
			Sound_FadeGlobalVolume(1.0f, 5.0f, eSoundEntryType_WorldClean);
		}
		
		//-------------------------------------------------------
		
		void UpdateLightBot(float afTimeStep)
		{
			if (!mbMoveLightBot)
				return;
				
			cVector3f vTarget = Map_GetEntity("LevCollision").GetPosition();
			cVector3f vMove = vTarget-Map_GetEntity("LightBot").GetPosition();
			vMove.Normalize();
			vMove*=3.0f*afTimeStep;
			
			Map_GetEntity("LightBot").SetPosition(Map_GetEntity("LightBot").GetPosition()+vMove);
		}

		//-------------------------------------------------------
		
		bool OnLevHitsPlayer(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==-1)
			{
				Map_RemoveTimer("TimerForceAwayFromLev");
			}
			else
			{
				if (Map_TimeHasPassed("LevPush",0.05f))
				{
					TimerForceAwayFromLev("");
				}
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void TimerForceAwayFromLev(const tString& in asName)
		{	
			Map_RemoveTimer("TimerForceAwayFromLev");
			Player_AddBodyForceAwayFromEntity("LevCollision_1",3000.0f,true, 1.5f);
			Map_AddTimer("TimerForceAwayFromLev",0.05f,"TimerForceAwayFromLev");
		}

		//-------------------------------------------------------

		bool OnLevHitsLightBot(const tString &in asParent, const tString &in asChild, int alState)
		{
			//Sound
			if (Entity_GetCollide("Player", "LightBotProx"))
			{
				Music_Play("02_01_fleshervehicle", 0.65f, false, eMusicPrio_BigEvent);
				Map_AddTimer("FearBreathing", 1.5f, "FearBreathingLightbot");
			}
			
			StopLightbotIdleBeeps();
			Sound_CreateAtEntity("LightbotScream", "NPC_Kate/lightbot/talk/death", "LightBot");

			mbMoveLightBot = false;
			Map_RemoveTimer("TimerMoveLightBotToLev");
			CharMover_PlayAnimation("leviathan_3","attack",0.5f);
			Entity_AttachToSocket("LightBot","leviathan_3","Mouth",true,true);
			
			Pathfinder_Track_Clear("leviathan_3");
			for (int i=6;i<=11;++i)
				Pathfinder_Track_Add("leviathan_3","LevAttackNode_"+i);
			Pathfinder_Track_Start("leviathan_3",false,0.25f,"OnLevHitEndOfTrack");
			
			Effect_VideoDistortion_Start(1.0f,1.0f,0.0f,4.0f);
			Effect_Shake_Start(0.25f,1.0f,0.0f,1.0f);
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void FearBreathingLightbot(const tString &in asTimer)
		{
			Depth_Audio_Fear_MediumIntensity();
		}

