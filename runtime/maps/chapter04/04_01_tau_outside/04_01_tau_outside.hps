	//-------------------------------------------------------
	
	void StormAudio_Stage2_Sweeteners(const tString &in asTimer)
	{
		//Sweeteners
		//Thunder
		if(asTimer == "StormAudio_Stage2_ThunderSweetener")
		{
			//Trigger thunder and duck storm 
			cLux_AddDebugMessage("Stage 2 Thunder Triggered");
