	//-------------------------------------------------------
	
	void Setup()
	{
		GetBase().SetDisplayNameEntry("04-01-tau-outside");
		RichPresence_SetCurrent(eRichPresence_PathtoTau );
						
		mlDofID = Effect_DoF_Start(1.5f, gfDofMax, 0.5, 0.0);

		Effect_Bloom_FadeBrightPass(0.00001, 0);
		Effect_Bloom_FadeBloomWidth(64, 0);
		Effect_Bloom_FadeBloomTint(0.6, 0.4, 0.4, 0);
		Map_SetUnderwater(true);
		Map_FadeFogEnd(gfFogNormal, 0.0f);
		Effect_RadialBlur_SetDirect(0.1, 0.75, 0.1);
		
		cLux_GetCurrentMap().GetWorld().SetFogUnderwater(true);
		
		/////////////////////////////////////////////////
		//Preset 4.2 for transition
		Map_Preset_SetupColorGrading("Preset4.2", "textures/colorgrading/grading_default.dds");
		Map_Preset_SetupBloom("Preset4.2", 128, 0.75, 0.5, cColor(1,1,1,1));
		cTerrain@ pTerrain = cLux_GetCurrentMap().GetWorld().GetTerrain();
		if(pTerrain !is null) pTerrain.SetCheapMaterial("sand_flat_abyss.mat", 0.5f);
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		CathTool_ResetScreen(eCathToolVariant_CathAbyss);
		
		//////////////////////////////////////////
		// Player setup
		//	Player_SetAmbientLight_Outdoors();
		// Want everything to be a bit murky
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			//Add any debug stuff here
			cLux_SetDebugInfoWindowText("Text that should show up when pressing F1");
		}
		Map_SetUnderwater(true);
		
		PlayerHands_SetHandModel_DeepSea();
		
		
		//Map setup
		SetupStorm();
		SetupElevator();
		SetupSpots();
		SetupSmokerPlant();
		SetupTauDoor();
		SetupObservatory();
		SetupJellies();
		SetupFlesherShadow();
		SetupLightBot();
		
		//Entity setup
		Entity_SetInteractionDisabled("vent_grating_1", true);
		
		if(cLux_ScriptDebugOn())
		{
			OpenElevatorDoor();
		}
		else
		{
			Sound_SetGlobalVolume(0.0f);
		
			StartElevator();
			StartWakeup();
		}
		
		Light_SetVisible("Debug_1",false);
		
		//Sound setup
		Sound_PreloadProject("04_01_tau_outside");
		Sound_PreloadGroup("03_03_omicron_descent/SFX/elevator", true);
		Sound_PreloadGroup("Flashback/Level/04_01", true);
		
		/////////////////////////
		// Eye tracking
		EyeTracking_RegisterEntity("BlackboxDiver", true, false, true, 15.0f, 4.0f);

		LastOnSoma_SetText("04_01_tau_outside_1");
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
        // S26BC: physical surface -> exact native tool-use target; refreshed on save entry.
        Entity_SetVarString("LiftExitPanel", "VRUseTarget", "Elevator");
        Entity_SetVarString("LiftExitPanel", "VRUseGateArea", "LiftExitPanelToolArea");

		MainMenu_SetBGPhase(eMainMenuPhase_3_3_To_End);
		Player_SetFlashlightEnvParticleMul(16);
		Map_SetUnderwater(true);
		Game_AutoSave();
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
	}

	//-------------------------------------------------------

	bool mbDebugLightOn = false;

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test1)
		{
			SetStormStrength((mlStormStrength+1)%4, 1, 1);
			cLux_AddDebugMessage("Storm strength set to:"+mlStormStrength);
		}
		else if (alAction == eAction_Test2)
		{
			cLux_AddDebugMessage("Storm strength is:"+mlStormStrength);
		}
		else if (alAction == eAction_Test3)
		{
			Entity_SetActive("LightBot_Deactivated",false);
			Entity_SetActive("LightBot",true);
			mbLightBotPowered = true;
			SendBotToTau();
		}
		else if (alAction == eAction_Test4)
		{
			Entity_SetActive("LightBot",true);
			mbLightBotPowered = true;
			Entity_PlaceAtEntity("LightBot", "lightTest", cVector3f_Zero, true);
			StartLeviathanAttack();
		}
		else if (alAction == eAction_Test5)
		{
			Entity_SetActive("LightBot",true);
			mbLightBotPowered = true;
			TimerSendBotToTau("");
		}
		else if (alAction == eAction_Test6)
		{
			OnLampLeverStateChanged("",1);
		}
		else if (alAction == eAction_Test7)
		{
			mbDebugLightOn = !mbDebugLightOn;
			Light_SetVisible("Debug_1",mbDebugLightOn);
		}
		else if (alAction == eAction_Test8)
		{
			mbKeepFlesherClose = true;
			StartFlesherShadow(3.0f, 5.0f, false);
		}
		else if (alAction == eAction_Test9)
		{
			Entity_CallEntityInteract("CathTool");
			Preload();
		}
		else if (alAction == eAction_Test0)
		{
			LightBot_StartFlicker();
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afY)
	{
		//afY = cLux_DrawDebugText("Warning Counter:"+mfWarningCounter, afY);
		return afY;
	}
	
	//-------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		UpdateStorm(afTimeStep);
		UpdateElevator(afTimeStep);
		UpdateFlesherShadow(afTimeStep);
		UpdateLightBot(afTimeStep);
	}

	//-------------------------------------------------------
	
	//} END MAIN CALLBACKS

	/////////////////////////////////////////
	// ==============
	// MAIN FUNCTIONS
	// ==============
	//{//////////////////////////////////////

	//-------------------------------------------------------
	
	tID m_idPSArea;
	int mlStormScreenEffectID = -1;
	bool mbUpdatePSAreaPos = true;

	//-------------------------------------------------------
	
	void SetStormStrength(int alStrength, float afVisualsFadeTime, float afSoundFadeTime)
	{
		if (mlStormStrength == alStrength) return;
		
		if (alStrength>3)
			return;
		
		cLux_AddDebugMessage("SetStormStrength: " + alStrength);
		
		switch (alStrength)
		{
			case 0:
			SetStormStrengthVisuals("", "", cVector3f_Zero, gfFogNormal , afVisualsFadeTime);
			SetStormStrengthSounds(0, afSoundFadeTime, 1);
			SetStormStrengthMarkerAnimations("idle", afSoundFadeTime);
			Player_FadeRunSpeedMulTo(1, 10);
			StopStrongCurrents();
			break;
			
			case 1:
			SetStormStrengthVisuals("tau_storm_min.ps", "tau_storm_dirt_min.ps", gvCurrentDir*2.5f,
				gfFogStorm1, afVisualsFadeTime);
			SetStormStrengthSounds(1, afSoundFadeTime, 1);
			SetStormStrengthMarkerAnimations("idle", afSoundFadeTime);
			Player_FadeRunSpeedMulTo(0.8, 10);
			StopStrongCurrents();
			
			break;
			
			case 2:
			SetStormStrengthVisuals("tau_storm_med.ps", "tau_storm_dirt_med.ps", gvCurrentDir*3.5f,
				gfFogStorm2, afVisualsFadeTime);
			SetStormStrengthSounds(2, afSoundFadeTime, 0.75);
			SetStormStrengthMarkerAnimations("bending_med", afSoundFadeTime);
			Player_FadeRunSpeedMulTo(0.6, 10);
			
			if (mlStormStrength < 2) StartStrongCurrents(afSoundFadeTime*0.5);
			
			break;
			
			case 3:
			SetStormStrengthVisuals("tau_storm_max.ps", "tau_storm_dirt_max.ps", gvCurrentDir*4.5f,
				gfFogStorm3, afVisualsFadeTime);
			SetStormStrengthSounds(2, afSoundFadeTime, 1);
			SetStormStrengthMarkerAnimations("bending_max", afSoundFadeTime);
			Player_FadeRunSpeedMulTo(0.4, 10);
			
			if (mlStormStrength < 2) StartStrongCurrents(afSoundFadeTime*0.5);
			
			break;
		}
		
		mlStormStrength = alStrength;
		UpdateStormScreenEffect();
	}
	
	//-------------------------------------------------------
	
	void UpdateStorm(float afTimeStep)
	{
		if (!mbUpdatePSAreaPos)
		{
			return;
		}
		
		// Move storm particle area to player pos.
		cLuxArea@ pArea = cLux_ID_Area(m_idPSArea);
		if (pArea !is null)
		{
			cVector3f vDelta = (Player_GetPosition() - pArea.GetPosition());
			pArea.SetPosition(pArea.GetPosition() + vDelta*3*afTimeStep);
		}
	}
	
	//-------------------------------------------------------
	
	void UpdateStormScreenEffect()
	{
		if (mlStormStrength == 3)
		{
			if (mlStormScreenEffectID == -1)
			{
				mlStormScreenEffectID = Effect_Screen_Start("storm_refraction.mat", cVector2f(0.5, 0.5), 
										cVector2f(1.8, 1.8));
				Effect_Screen_FadeAlpha(mlStormScreenEffectID, 1.0f, 0.4f);
			}
		}
		else
		{
			FadeStormScreenEffect();
		}
	}
	
	//-------------------------------------------------------
	
	void FadeStormScreenEffect()
	{
		if (mlStormScreenEffectID != -1)
		{
			Effect_Screen_FadeOut(mlStormScreenEffectID,0.4f);
			mlStormScreenEffectID = -1;
		}	
	}

	//-------------------------------------------------------
	
	cVector3f mvStormParticleVel=cVector3f_Zero;
	float mfStormFogEnd=gfFogNormal;
	tString msStormParticles;
	tString msStormDirt;
	
	void SetStormStrengthVisuals(const tString &in asStormParticles, const tString &in asStormDirt, 
		const cVector3f avParticleVelocity, float afFogEnd, float afFadeTime)
	{
		msStormParticles = asStormParticles;
		msStormDirt = asStormDirt;
		
		if (mlStormStrength != 0) 
		{
			ParticleSystem_Destroy("Storm");
			ParticleSystem_Destroy("StormDirt");
		}
		if (asStormParticles != "") 
		{
			ParticleSystem_CreateAtEntityExt("Storm", asStormParticles, "StormParticleArea", 
				true, cColor_White, gfParticleAlpha, true, 0.3, 0.75);
			ParticleSystem_CreateAtEntityExt("StormDirt", asStormDirt, "Camera", 
				true, cColor_White, gfParticleAlpha, false, 0, 0);
		}
		Map_FadeFogEnd(afFogEnd, afFadeTime);
		Map_FadeEnvironmentParticleWindVelocity(avParticleVelocity, afFadeTime);
		
		mvStormParticleVel = avParticleVelocity;
		mfStormFogEnd = afFogEnd;
	}

	//-------------------------------------------------------
	
	void SetStormStrengthSounds(int alStormSoundIndex, float afSoundFadeTime, float afStormFadeVolume)
	{
		Sound_Fade("Storm_" + alStormSoundIndex, afStormFadeVolume, afSoundFadeTime);
		for (int i = 0; i < 3; i++)
		{
			if (alStormSoundIndex != i) Sound_Fade("Storm_" + i, 0, afSoundFadeTime);
		}
	}

	//--------------------------- ----------------------------
	
	void SetStormStrengthMarkerAnimations(const tString &in asAnim, float afAnimFadeTime)
	{
		Entity_PlayAnimation("path_marker_tau_*", asAnim, afAnimFadeTime, true);
	}

	//-------------------------------------------------------

	void SetStormFollowingPlayer(bool abValue)
	{
		mbUpdatePSAreaPos = abValue;
		if (!abValue)
		{
			StopStrongCurrents();
			FadeStormScreenEffect();
			ParticleSystem_Destroy("StormDirt");
		}
		else
		{
			if (mlStormStrength>2)
			{
				ParticleSystem_CreateAtEntityExt("StormDirt", msStormDirt, "Camera", 
					true, cColor_White, 1, false, 0, 0);
			}
			if (mlStormStrength>1) 
			{
				 StartStrongCurrents(0.5f);
			}
			UpdateStormScreenEffect();
		}
	}
	
	//-------------------------------------------------------
	
	void FadeStormMapParams(bool abValue)
	{
		if (!abValue)
		{
			Map_FadeFogEnd(gfFogNormal, 3.0f);
			Map_FadeEnvironmentParticleWindVelocity(cVector3f_Zero, 3.0f);
		}
		else
		{
			Map_FadeFogEnd(mfStormFogEnd, 1.0f);
			Map_FadeEnvironmentParticleWindVelocity(mvStormParticleVel, 1.0f);
		}
	}
	
	//-------------------------------------------------------
	
	void GhostPropVanish(const tString& in asEntity)
	{
		Map_RemoveTimer("GhostPropCancelDistortion");
		Prop_SetActiveAndFade(asEntity, false, 2.0f);
		Effect_VideoDistortion_SetDirectAmount(cMath_RandRectf(0.8f,1.0f));
		Map_AddTimer("GhostPropCancelDistortion", 2.1f, "GhostPropCancelDistortion");
	}
	
	//-------------------------------------------------------
	
	void GhostPropAppear(const tString& in asEntity)
	{
		Map_RemoveTimer("GhostPropCancelDistortion");
		Effect_VideoDistortion_SetDirectAmount(cMath_RandRectf(0.6f,0.8f));
		Prop_SetActiveAndFade(asEntity, true, 2.0f);
		Map_AddTimer("GhostPropCancelDistortion", 2.1f, "GhostPropCancelDistortion");
	}
	
	//-------------------------------------------------------
	
	void GhostPropCancelDistortion(const tString &in asTimer)
	{
		Effect_VideoDistortion_SetDirectAmount(0.0f);
	}
		
	//-------------------------------------------------------
	
	//} END MAIN FUNCTIONS

	/////////////////////////////////////////
	// Generic timers
	//{//////////////////////////////////////

	//-------------------------------------------------------
	
	void TimerSetLampLit(const tString &in asTimer)
	{
		Lamp_SetLit(asTimer, true, true);
		Sound_CreateAtEntity("LightOn_"+asTimer, "04_01_tau_outside/SFX/guide_lights/guide_lights_on", asTimer);
	}

	//-------------------------------------------------------
	
	void TimerSetLampUnlit(const tString &in asTimer)
	{
		Lamp_SetLit(asTimer, false, true);
	}

	//-------------------------------------------------------
	
	void TimerFadeLightToBlack(const tString &in asTimer)
	{
		Light_FadeTo(asTimer, cColor(0), -1, 0.2);
	}
	
	//-------------------------------------------------------
	
	void TimerTurnOnEffects(const tString &in asTimer)
	{
		Entity_SetEffectsActive(asTimer, true, false);
	}
	
	//-------------------------------------------------------
	
	void TimerTurnOffEffects(const tString &in asTimer)
	{
		Entity_SetEffectsActive(asTimer, false, false);
	}
	
	//-------------------------------------------------------
	
	void TimerEnableInteraction(const tString &in asTimer)
	{
		Entity_SetInteractionDisabled(asTimer, false);
	}
	
	//-------------------------------------------------------
	
	void TimerSetActive(const tString &in asTimer)
	{
		Entity_SetActive(asTimer, true);
	}
	
	//-------------------------------------------------------
	
	void TimerSetInactive(const tString &in asTimer)
	{
		Entity_SetActive(asTimer, false);
	}

	//-------------------------------------------------------
	
	//} END Generic Timers

	/////////////////////////////////////////
	// ==============
	// SCENE 1 *ELEVATOR LOWERS*
	// ==============
	//{//////////////////////////////////////

	//-------------------------------------------------------
	
		/////////////////////////////////////////
		// Elevator Setup
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
	
		float mfSwayTimer = 0.0f;
		float mfElevatorSpeed = 0.0f;
		float mfElevatorAccel = 0.0f;
		float mfElevatorTargetSpeed = 0.0f;
		float mfElevatorDepth = 0.0f;
		float mfElevatorStartY = 0.0f;
		cVector3f mvElevatorStartPos;
		bool mbElevatorRunning = false;
		int mlShakeID = -1;
		bool mbSway;
		int mlSeat = 1;
		float mfActualDepth = 0.0f;
		
		//-------------------------------------------------------
		
		void SetupElevator()
		{
			// Set in previous level
			mlSeat = cScript_GetGlobalVarInt("ElevatorSeat");
			// Debug
			if (mlSeat==0)
				mlSeat=1;
			
			Entity_FadeEffectBaseColor("CathSocket", cColor(0,1,0,1), 0.1f);
			CathTool_Insert("CathTool", "CathSocket", false);
			Entity_AttachToEntity("CathTool","Elevator","",false,false);
				
			Slide_SetSlideAmount("Slider1", 0.0f);
			Slide_SetSlideAmount("Slider2", 0.0f);
			
			// To fix a physics bug, we're swapping out ElevatorCageDoor for RepElevatorCageDoor
			// when we hit the bottom.
			SwingDoor_SetBlocked("RepElevatorCageDoor", true, false);
			Entity_SetActive("RepElevatorCageDoor", false);
			
			SwingDoor_SetBlocked("ElevatorCageDoor", true, false);
			Prop_SetStaticPhysics("ElevatorCageDoor", true);
			
			mbElevatorRunning = false;
			mvElevatorStartPos = Map_GetEntity("Elevator").GetPosition();
			mfElevatorStartY = mvElevatorStartPos.y;

			Entity_AttachToEntity("DescentCameraAnim*", "Elevator", "", false, false);
			Entity_AttachToEntity("SeatCameraAnim*", "Elevator", "", false, false);
			
			Voice_SetSource("Catherine", "CathSocket", 6, 24, true, 20);
			
			Entity_PlayAnimation("seat_restraint_*", "chair_03_03_idle_restraint",0.0f,true,false,"");
			Entity_PlayAnimation("SeatedHands", "chair_03_03_idle",0.0f,true,false,"");
		}
		
		//-------------------------------------------------------
		
		void StartElevator()
		{
			mbSway = true;
			FadeElevatorSpeed(gfElevatorMaxSpeed, gfElevatorMaxSpeed);
			CameraAnimation_Begin("DescentCameraAnim"+mlSeat, "", true);
			CameraAnimationNode_SetInteractiveMovement("SeatCameraAnim*", false);
			
			Map_AddTimer("TimerStartCathChat", 10.0f, "TimerStartCathChat");
			
			ElevatorAudio_Start();
			ElevatorAudio_DockingAlarm_Start();
		}
		
		//-------------------------------------------------------
		
		void TimerStartCathChat(const tString& in asName)
		{
			Voice_Play("DescentPart1");
		}
		
		//-------------------------------------------------------
		
		void FadeElevatorSpeed(float afTargetSpeed, float afAccel)
		{
			mfElevatorTargetSpeed = afTargetSpeed;
			mfElevatorAccel = afAccel;
		}
		
		//-------------------------------------------------------
		
		void UpdateElevator(float afTimeStep)
		{
			/////////////////////////
			// Update status
			if ((mfElevatorAccel==0.0f) && (mfElevatorSpeed==0.0f))
			{
				if (mbElevatorRunning)
				{
					mbElevatorRunning = false;
							
					// Detach player from elevator to avoid head bob etc.
					Entity_RemoveEntityAttachment("player");
					Effect_Sway_FadeOut(1.0f);

					if (mlShakeID!=-1)
					{
						Effect_Shake_FadeOut(mlShakeID, 0.5f);
						mlShakeID = -1;
					}
				}
			}
			else 
			{
				if (!mbElevatorRunning)
				{
					mbElevatorRunning = true;
					
					// Attach player to elevator to avoid head bob etc.
					Entity_AttachToEntity("player","Elevator","",false,false);
				}
			}
			
			if (mbSway)
				UpdateSway(afTimeStep);
				
			if (!mbElevatorRunning)
				return;
			
			/////////////////////////
			// Update speeds
			mfElevatorSpeed+=mfElevatorAccel*afTimeStep;
			if (mfElevatorAccel>0.0f)
			{
				if (mfElevatorSpeed>mfElevatorTargetSpeed)
				{
					mfElevatorSpeed = mfElevatorTargetSpeed;
					mfElevatorAccel = 0.0f;
				}
			}
			else if (mfElevatorAccel<0.0f)
			{
				if (mfElevatorSpeed<mfElevatorTargetSpeed)
				{
					mfElevatorSpeed = mfElevatorTargetSpeed;
					mfElevatorAccel = 0.0f;
				}
			}
			
			/////////////////////////
			// Update logical elevator position
			mfElevatorDepth += mfElevatorSpeed*afTimeStep;	// Virtual position, inc loops
			mfActualDepth = gfStationDepth - (Map_GetEntity("Elevator").GetPosition().y - gfElevatorTargetY);
					
			/////////////////////////
			// Figure out physical position
			float fElevatorY = mfElevatorStartY-mfElevatorDepth;
				
			/////////////////////////
			// Update physical position
			cLuxProp@ pElevator = Map_GetProp("Elevator");
			cVector3f vPos = pElevator.GetPosition();
			
			if ( (vPos.y>gfElevatorSlowdownY) && (fElevatorY<=gfElevatorSlowdownY) )
			{
				// Brake elevator
				FadeElevatorSpeed(0.5f, -1.7f);
				cLux_AddDebugMessage("ElevatorSlowDown");
				
				// Elevator dock sound triggered early for buildup
				Sound_CreateAtEntity("ElevatorDock", "04_01_tau_outside/SFX/elevator/elevator_dock", "Player", 0.0f, false, 0.65f);
			}
			else if ( (vPos.y>gfElevatorTalkPart2Y) && (fElevatorY<=gfElevatorTalkPart2Y) )
			{
				Voice_PlayWhenPossible("DescentPart2");
			}
			else if (vPos.y<gfElevatorTargetY)
			{
				mfElevatorSpeed=0.0f;
				mfElevatorTargetSpeed=0.0f;
				mfElevatorAccel=0.0f;
				fElevatorY = gfElevatorTargetY;
				mbSway = false;
				SequenceElevatorHitGround("");
			}
			
			vPos.y=fElevatorY;
			pElevator.SetPosition(vPos);
			
			UpdatePressureEffects();
		}
		
		//-------------------------------------------------------
		
		float mfLastPressure;
		
		void UpdatePressureEffects()
		{
			float fPressure = cMath_Clamp(1.0f-mfElevatorDepth/(mfElevatorStartY-gfElevatorTargetY), 0.0f, 1.0f)*0.75f;

			int lOldPress = cMath_Easing(eEasing_CubicIn, mfLastPressure, 0.0f, 1.0f)*20.0f;
			int lCurrPress = cMath_Easing(eEasing_CubicIn, fPressure, 0.0f, 1.0f)*20.0f;
			
			if (lOldPress!=lCurrPress)
			{
				//////////////////////////////////////////
				// Blurriness
				float fBurstEnd = gfDofMax - fPressure*(gfDofMax-0.5f);
				float fBurstStart = cMath_Max(0.1f, fBurstEnd-1.0f);
				if (mlDofID!=-1)
					Effect_DoF_FadeOut(mlDofID,1.0f);
				mlDofID = Effect_DoF_Start(0.0f, fBurstStart, 1.0f, 0.25f);
				Effect_DoF_FadeFocus(mlDofID, 0.0f , fBurstEnd, 5.0f);
				Effect_ChromaticAberration_StartAnim(5.0f, fPressure*0.01f, 0.2f, cVector2f_Zero);
			}
			
			if (lOldPress!=lCurrPress)
			{
				//////////////////////////////////////////
				// Shaking
				// Okay, shaking isn't a pressure effect, but seems a good place to do this
				if (mlShakeID!=-1)
					Effect_Shake_FadeOut(mlShakeID,1.0f);
				mlShakeID = Effect_Shake_Start(fPressure*0.01f, 1000.0f, 1.0f, 1.0f,
							cVector3f(0.2,1,0.2), mfElevatorSpeed*0.5f);
			}
			
			mfLastPressure = fPressure;
		}

		//-------------------------------------------------------

		void UpdateSway(float afTimeStep)
		{
			float fSwaySpeed = mfElevatorSpeed/gfElevatorMaxSpeed;
			mfSwayTimer+=afTimeStep*(10.0f+5.0f*fSwaySpeed);
			float fSwaySize = 0.03f-fSwaySpeed*0.02f;
			float fSwayRate = 1.0f+fSwaySpeed*1.5f;
			
			Effect_Sway_SetDirect(fSwaySize, fSwayRate, mfSwayTimer, 
									1.0f, 0.25f, 1.0f, 0.0f);
									
			cLuxProp@ pElevator = Map_GetProp("Elevator");
			cVector3f vPos = mvElevatorStartPos;
			vPos.y = pElevator.GetPosition().y;
			cVector3f vOffs = Effect_Sway_GetOffset()*0.5f;
			vPos.x+=vOffs.x;
			vPos.z+=vOffs.z;
			pElevator.SetPosition(vPos);
		}
		
		//-------------------------------------------------------
		
		//} END Elevator setup

		/////////////////////////////////////////
		// Scene 1 Event A *Wake Up*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		void StartWakeup()
		{
			SequenceWakeup("");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceWakeup;
		void SequenceWakeup(const tString& in asName)
		{
			Sequence_Begin("SequenceWakeup", mSequenceWakeup);
			if (Sequence_DoStepAndWait(3.0f))
			{
				//Lil bit of pacing
				Wake_SetAsleep(true);
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				
				Sound_PlayGui("04_01_tau_outside/SFX/wake_up_sweet", 1.0f, eSoundEntryType_Gui);
				Sound_FadeGlobalVolume(1.0f, 15.0f);
			}
			else if (Sequence_DoStepAndWait(3.0f))
			{
				Effect_Fade_In(0.0f);
				Wake_StartWakeup(5.0f);
				cLux_AddDebugMessage("Level Start");
			}

			Sequence_End();
		}

		//-------------------------------------------------------
		
		//} END Wake-up

		/////////////////////////////////////////
		// Scene 1 Event B *Elevator slows down & hits bottom*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceHitGround;
		void SequenceElevatorHitGround(const tString& in asName)
		{
			Sequence_Begin("SequenceElevatorHitGround", mSequenceHitGround);
			
			if (Sequence_DoStepAndWait(0.5f))
			{
				ElevatorAudio_Stop(0.05f);
				Map_AddTimer("ElevatorAudio_DockingAlarmStopTimer", 0.5f, "ElevatorAudio_DockingAlarmStopSound");
							
				cLux_AddDebugMessage("Hit ground.");
				if (mlShakeID!=-1)
					Effect_Shake_FadeOut(mlShakeID,1.0f);
				mlShakeID=-1;
				Effect_Shake_Start(0.05f, 0.2f, 0.1f, 0.1f );
				Effect_Rumble_Start(0.9f,0.7f);
			}
			else if (Sequence_DoStepAndWait(0.1f))
			{
				// Flicker lights to cover a couple of changes
				SwitchElevatorLights(false,false);
				
				// Swap to non-static version because of broken physics
				Entity_SetActive("ElevatorCageDoor",false);
				Entity_SetActive("RepElevatorCageDoor",true);
				
				ParticleSystem_SetActive("Elevator_ParticleSystem_1", false);
				ParticleSystem_SetVisible("Elevator_ParticleSystem_1",false);
			}
			else if (Sequence_DoStepAndWait(5.0f))
			{
				SwitchElevatorLights(true,false);
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				OpenRestraints();
				PlayPlayerRestraintsOpening();
				TurnOffElevatorControls();
				Button_SetDisabled("LiftExitPanel", false);
				Button_SetLocked("LiftExitPanel",false);
				Entity_SetActive("LiftExitPanelToolArea",true);
				Prop_SetStaticPhysics("LiftExitPanel",false);
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				CameraAnimationNode_SetInteractiveMovement("DescentCameraAnim"+mlSeat+"_1", true);
				CameraAnimationNode_SetInteractiveMovement("SeatCameraAnim*", true);
				
				CathTool_AllowDetach("CathTool");
				Entity_SetEffectsActive("CathTool", true, false);
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void TurnOffElevatorControls()
		{
			Lamp_SetLit("ControlsLightGood", false, true);
			Lamp_SetLit("ControlsLightBad", true, true);
			Terminal_SetGuiActive("TerminalElevatorMain", false, 0.5f);
			Terminal_SetGuiActive("TerminalElevatorDepth*", false, 0.7f);
			Terminal_SetGuiActive("TerminalElevatorStart", false, 1.0f);
			Entity_FadeEffectBaseColor("Slider*", cColor(0,0,0,0), 0.8f);
			
			Entity_FadeEffectBaseColor("CathSocket", cColor(1,0,0,1), 0.1f);
		}
		
		//-------------------------------------------------------
		
		void OpenRestraints()
		{
			//////////////////
			//Small buffer timer to allow for sound of mechanism whirring away
			Map_AddTimer("RestraintsOpenTimer", 0.3f, "OpenRestraintsAction");
			Map_AddTimer("Raise", 0.0f, "ShoulderRestraintAudio");
			Sound_CreateAtEntity("SeatedHands", "03_03_omicron_descent/SFX/elevator/shoulder_restraint/handanim/raise", "Player");
			cLux_AddDebugMessage("[Elevator] Opening restraints...");
		}
		
		//-------------------------------------------------------
		
		void OpenRestraintsAction(const tString& in asTimer)
		{
			Entity_PlayAnimation("seat_restraint_*", "chair_03_03_leave_restraint",0.3f,false,false,"OnSeatOpened");
		}
		
		//-------------------------------------------------------
		
		void OnSeatOpened(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_PlayAnimation(asEntityName, "chair_03_03_idle_up_restraint",0.3f,true,false,"");
		}
		
		//-------------------------------------------------------
		
		void PlayPlayerRestraintsOpening()
		{
			Entity_SetActive("SeatedHands",true);
			Entity_PlayAnimation("SeatedHands", "chair_03_03_leave",0.3f,false,false,"OnPlayerRestraintsOpened");
		}

		//-------------------------------------------------------

		void OnPlayerRestraintsOpened(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_SetActive("SeatedHands",false);
		}
		
		//-------------------------------------------------------
		
		bool PickupCathTool(const tString &in asTool)
		{
			Lamp_SetLit("ControlsLightBad",false,true);
			Entity_SetEffectsActive("TerminalElevatorStart",false,true);
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnGotUp(const tString &in asEntity, int alDirection)
		{
			cLux_AddDebugMessage("Got Up");
			Entity_SetActive("SimonLegs",false);
			mlSeat = -1;
			return true;
		}
		
		//-------------------------------------------------------
		
		void SwitchElevatorLights(bool abOn, bool abEffects)
		{
			Lamp_SetLit("CageSpot*",abOn,abEffects);
			
			Terminal_SetGuiActive("TerminalElevatorStart",abOn);
			Terminal_SetGuiActive("TerminalElevatorMain",abOn);
			Terminal_SetGuiActive("TerminalElevatorDepth*",abOn);
			Entity_SetEffectsActive("CathSocket", abOn, abEffects);
			Entity_SetEffectsActive("CathTool", abOn, abEffects);
			
			Lamp_SetLit("ControlsLightGood", abOn, abEffects);
		}
		
		//-------------------------------------------------------
		
		//} END Elevator slow down and hit bottom

