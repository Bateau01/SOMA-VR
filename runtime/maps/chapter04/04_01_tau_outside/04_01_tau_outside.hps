		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		void SetupSmokerPlant()
		{
			Entity_SetVarFloat("SmokerPowerLever", "JointFixMaxDist", 2.0f);
			
			for(int i=41;i<=52;++i)
			{
				Lamp_SetLit("path_marker_tau_"+i, false , false);
			}
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerEnterSmokerPlant(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==1)
			{
				cLux_AddDebugMessage("Enter smoker plant.");
				
				Swarm_SetPlayerIsInBuilding("swarm_1", true);
				
				StormAudio_EnterBuildings();
			}
			else
			{
				cLux_AddDebugMessage("Exit smoker plant.");
				
				Swarm_SetPlayerIsInBuilding("swarm_1", false);
				
				StormAudio_ExitBuildings();
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnSmokerPlantSuppressStorm(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==1)
			{
				SetStormStrength(1, 0.25, 0.25);
				OnTriggerSuppressStorm(asParent,asChild,alState);
			}
			else
			{
				OnTriggerSuppressStorm(asParent,asChild,alState);
				SetStormStrength(2, 0.25, 0.25);
			}
			return true;
		}
		
