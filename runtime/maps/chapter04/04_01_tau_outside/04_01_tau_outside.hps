		//-------------------------------------------------------
		
		bool mbTauDoorOpened = false;
		
		//-------------------------------------------------------
		
		void SetupTauDoor()
		{
			Lever_SetAutoMoveEnabled("TauDoor", true);
			Lever_SetAutoMoveTarget("TauDoor", -1);
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerNearTau(const tString &in asParent, const tString &in asChild, int alState)
		{
			for (int i=1;i<=10;i++)
			{
				Map_AddTimer("TauLamp_"+i, 0.1f*i, "TimerSetLampLit");
			}
			return false;
		}

		//-------------------------------------------------------
	
		void OnTauDoorPanelChangeState(const tString &in asEntity, int alState)
		{
			if (alState!=1)
				return;
			
			Sound_CreateAtEntity("ButtonPressed", "Entities_Station/doors/tau/buttons/underwater/open", asEntity);
			
			if (!mbTauDoorOpened)
			{
				cLux_AddDebugMessage("Tau panel");
				SequenceOpenTauDoor("");
				mbTauDoorOpened = true;
			}
		}

		//-------------------------------------------------------

		bool OnUseCathTool(const tString &in asTool, const tString &in asEntity)
		{
			if (asEntity=="TauAirLockPanel")
			{
				CathTool_UseOnPanel(asTool,"TauAirLockPanel");
			}
			else if (asEntity=="Elevator")
			{
				CathTool_UseOnPanel(asTool,"LiftExitPanel");
			}
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnChangeElevatorPanel(const tString &in asEntity, int alState)
		{
			Entity_SetActive("LiftExitPanelToolArea", false);
			OpenElevatorDoor();
		}
		
		//-------------------------------------------------------
		
		void OnChangeTauAirlockPanel(const tString &in asEntity, int alState)
		{
			Entity_SetActive("ToolAreaTauAirLockPanel", false);
			Seq_Outro("Seq_Outro");
		}
				
		//-------------------------------------------------------
		
		bool CanUseCathTool(const tString &in asTool, const tString &in asEntity)
		{
			if (asEntity=="Elevator")
			{
				return true;
			}
			else
			{
				return CathTool_CanUse(asTool, asEntity);
			}
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceOpenTauDoor;
		void SequenceOpenTauDoor(const tString& in asName)
		{
			Sequence_Begin("SequenceOpenTauDoor", mSequenceOpenTauDoor);
			
			if (Sequence_DoStepAndWait(1.0f))
			{
				cLux_AddDebugMessage("Opening door.");
			}
			else if (Sequence_DoStepAndWait(0.25f))
			{
				Entity_SetActive("TauForceArea", true);
				
				Lever_SetAutoMoveEnabled("TauDoor", true);
				Lever_SetAutoMoveTarget("TauDoor", 1);
				
				Sound_CreateAtEntity("TauDoorOpen", "Entities_OceanBottom/doors/tau_door/open_louder", "TauDoor");
				
				Light_SetVisible("SpotLight_11", false);
				Light_FadeTo("SpotLight_11", cColor(0,0,0,0), -1.0f, 1.0f);
			}
			else if (Sequence_DoStepAndWait(6.0f))
			{
				ParticleSystem_CreateAtEntity("TauBubbles_1PS", "oneshot_waterbubbles_huge.ps", "TauBubbles_1", true);
				ParticleSystem_CreateAtEntity("TauBubbles_2PS", "oneshot_waterbubbles_big.ps", "TauBubbles_2", true);
				ParticleSystem_CreateAtEntity("TauBubbles_3PS", "oneshot_waterbubbles_big.ps", "TauBubbles_3", true);
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				Entity_SetActive("TauForceArea",false);
				Map_RemoveTimer("TimerTauForce");
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollideTauForceArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==1)
				Map_AddTimer("TimerTauForce",0.1f,"TimerTauForce");
			else
				Map_RemoveTimer("TimerTauForce");
			return true;
		}
		
		//-------------------------------------------------------
		
		void TimerTauForce(const tString& in asName)
		{
			Player_AddBodyForceAwayFromEntity("TriggerExitTau",10000.0f);
			Map_RestartCurrentTimer();
		}

		//-------------------------------------------------------

		bool OnTriggerExitLevel(const tString &in asParent, const tString &in asChild, int alState)
		{
			//Disabled for new transition
			return false;
			
			Map_AddTimer("Timer_ExitLevel", 8, "Timer_ExitLevel");
			
			Music_Stop(8.0f, eMusicPrio_BgAmb);		
			Effect_Fade_Out(3.0f);
			return false;
		}
		
		//-------------------------------------------------------
		
		void Timer_ExitLevel(const tString &in asTimer)
		{
			Map_ChangeMap("04_02_tau_inside.hpm", "PlayerStartArea_1", "", "");
		}
		
		//-------------------------------------------------------

		bool OnTriggerExitTau(const tString &in asParent, const tString &in asChild, int alState)
		{
			StormAudio_ExitBuildings();
			SetStormFollowingPlayer(true);
			FadeStormMapParams(true);
			return true;
		}

		//-------------------------------------------------------
		bool mbEnterTau = false;
		bool OnTriggerEnterTau(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState==1)
			{
				mbEnterTau = true;
			}
			else
			{
				mbEnterTau = false;
			}
			
			StormAudio_EnterBuildings(1.5f, 0.0f);
			SetStormFollowingPlayer(false);
			FadeStormMapParams(false);
			
			return true;
		}
		
