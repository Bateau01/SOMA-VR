			//Start timer for thunder again, fade up storm on release
			Map_AddTimer("StormAudio_Stage1_ThunderSweetenerRelease", 3.5f, "StormAudio_Stage1_Sweeteners");
			Map_AddTimer("StormAudio_Stage1_ThunderSweetener", cMath_RandRectf(20.0f,30.0f), "StormAudio_Stage1_Sweeteners");
		}
		
		//Releases
		if(asTimer == "StormAudio_Stage1_ThunderSweetenerRelease")
		{
			cLux_AddDebugMessage("Thunder Release");
			Sound_Fade("StormAudio_Stage1", 1.0f, 6.0f);
