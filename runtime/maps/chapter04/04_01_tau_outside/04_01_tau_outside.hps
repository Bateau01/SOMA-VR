		void SetupSpots()
		{
			Entity_SetVarFloat("SpotLever", "JointFixMaxDist", 2.0f);
			Lever_SetAutoMoveEnabled("SpotLever", true);
			Lever_SetAutoMoveTarget("SpotLever",-1);
		}
		
		//-------------------------------------------------------
		
		void OnChangeSpotLever(const tString &in asEntity, int alState)
		{
			cLux_AddDebugMessage("Spot lever change:"+alState);

			if (alState==1)
			{
				Sound_CreateAtEntity("SpotlightOn", "04_01_tau_outside/SFX/spotlight_on", "SpotlightSoundSrc");
				cLux_AddDebugMessage("Lamps come on");
				
				Lamp_SetLit("BaseLamp_*", true, true);
				
				Lever_SetStuckState(asEntity,1,true);
				Lever_SetInteractionDisablesStuck(asEntity,true);
				
				Lamp_SetLit("BaseLampsIndicator",false,true);
			}				
			else if (alState==-1)
			{
				Sound_CreateAtEntity("SpotlightOff", "04_01_tau_outside/SFX/spotlight_on", "SpotlightSoundSrc");
				cLux_AddDebugMessage("Lamps go off");
				
				Lamp_SetLit("BaseLamp_*", false, true);
				Lamp_SetLit("BaseLampsIndicator",true,true);
			}
		}
		
