		//-------------------------------------------------------
		// Flesher Shadows
		//-------------------------------------------------------

		bool mbFlesherShadowActive = false;
		float mfFlesherShadowFader = 0.0f;
		
		void SetupFlesherShadow()
		{
			mbFlesherShadowActive = false;
			
			Map_AddTimer("TimerFlesherShadow", cMath_RandRectf(gvFlesherShadowAppearTimes.x, gvFlesherShadowAppearTimes.y), "TimerFlesherShadow");
		}
		
		//-------------------------------------------------------
		
		void TimerFlesherShadow(const tString& in asName)
		{
			if (mlStormStrength==3)
				StartFlesherShadow(cMath_RandRectf(gvFlesherShadowLingerTimes.x,gvFlesherShadowLingerTimes.y), cMath_RandRectf(gfFlesherShadowDistances.x,gfFlesherShadowDistances.y));
			
			Map_AddTimer("TimerFlesherShadow", cMath_RandRectf(gvFlesherShadowAppearTimes.x, gvFlesherShadowAppearTimes.y), "TimerFlesherShadow");
		}
		
		//-------------------------------------------------------
		
		float mfFlesherTimeArg;
		int mlFlesherDistortion=-1;
		
		void StartFlesherShadow(float afTime, float afDist, bool abShowTheWay=true)
		{
			if (mbFlesherShadowActive)	// Already started - ignore
				return;
				
			if (mbUpdatePSAreaPos==false)	// We're indoors - don't do anything
				return;
				
			iLuxEntity@ pFlesher = Map_GetEntity("FlesherShadow");
			iLuxEntity@ pBillboard = Map_GetEntity("FlesherShadowBillboard");
			
			cVector3f vPlayerPos = Player_GetPosition();
			
			// Place the shadow somewhere within the direction of Tau.
			cVector3f vDir;

			if (abShowTheWay)
				vDir = Map_GetEntity("TauTarget").GetPosition()-Player_GetPosition();
			else
				vDir = cLux_GetPlayer().GetCamera().GetForward();
			vDir.y=0.0f;
			vDir.Normalize();
			cMatrixf matRot = cMath_MatrixRotateY(cMath_ToRad(cMath_RandRectf(-5.0f,5.0f)));
			vDir = cMath_MatrixMul(matRot, vDir);

			cVector3f vFlesherPos = vPlayerPos+vDir*afDist;
			// 'Glow' goes a little bit behind the flesher
			cVector3f vBillboardPos = vPlayerPos+vDir*(afDist+0.1f); 
			
			pFlesher.SetPosition(vFlesherPos);
			pFlesher.GetMeshEntity().SetVisible(true);
		
			// Rotate flesher to face player.
			float fYaw=0;
			float fLength=0;
			cVector2f vDir2D = cVector2f(vDir.x,vDir.z);
			cMath_GetAngleFromVector(vDir2D, fYaw,fLength);
			cLuxProp@ pProp = cLux_ToProp(pFlesher);
			cMatrixf mat = cMath_MatrixRotateY(-fYaw);
			mat.SetTranslation(pProp.GetPosition());
			pProp.SetMatrix(mat);
			
			pBillboard.SetPosition(vBillboardPos);
			
			mbFlesherShadowActive = true;
			mfFlesherTimeArg = afTime;	// Just passing to the ground callback
		
			// Don't activate yet - check distance to ground first.
			mBaseObj.GetClosestBody("OnFlesherShadowGroundCallback", vFlesherPos, cVector3f(0,-1.0f,0), 10.0f);
		}
		
		//-------------------------------------------------------
		
		void OnFlesherShadowGroundCallback(bool abSuccessful, float afDistance, const cVector3f&in avNormal, iPhysicsBody@ apBody)
		{
			if (!abSuccessful)
			{
				// Probably spawned under the ground - forget it.
				mbFlesherShadowActive = false;
				return;
			}

			// Adjust entities to sit on the ground
			iLuxEntity@ pFlesher = Map_GetEntity("FlesherShadow");
			cVector3f vPos = pFlesher.GetPosition();
			vPos.y-=afDistance;
			pFlesher.SetPosition(vPos);
			
			iLuxEntity@ pBillboard = Map_GetEntity("FlesherShadowBillboard");
			vPos = pBillboard.GetPosition();
			vPos.y-=afDistance;
			pBillboard.SetPosition(vPos);
			
			// Dissolve in
			Prop_SetActiveAndFade("FlesherShadow",true,gFlesherShadowFadeTime);
			pBillboard.SetActive(true);

			// Start the billboard fade
			mfFlesherShadowFader = 1.0f;
			Billboard_SetBrightness("FlesherShadowBillboard_Billboard_1", 0.0f);
			
			//Sweetener sound
			RossSightingSweetSound();
			
			// Distortion
			Effect_VideoDistortion_Start(1, 0.75, 0.0, 0.5);
			mlFlesherDistortion = Effect_VideoDistortion_Start(0.5f,100.0f,0.1f,0.5f);
			
			// And start the vanish timer.
			Map_AddTimer("TimerStopFlesherShadow", mfFlesherTimeArg, "TimerStopFlesherShadow");
		}
		
		//-------------------------------------------------------
		
		bool mbRossSweetAllowed = true;
		void RossSightingSweetSound()
		{
			if(mbRossSweetAllowed==true && mbLeavingPath==false)
			{
				if (Entity_GetCollide("Player", "RossProximity"))
				{
					Sound_CreateAtEntity("RossFlicker", "03_02_omicron_inside/SFX/ross_sighting_sweet", "Player");
					Map_AddTimer("RossSweetCooldown", 10.0f, "RossSweetCooldown");
					mbRossSweetAllowed = false;
				}
			}
		}
		
		void RossSweetCooldown(const tString &in asTimer)
		{
			mbRossSweetAllowed = true;
		}
		
		//-------------------------------------------------------
		
		void UpdateFlesherShadow(float afTimeStep)
		{
			if (!mbFlesherShadowActive)	// Nothing to do
				return;
				
			iLuxEntity@ pFlesher = Map_GetEntity("FlesherShadow");
			
			float fFlesherDistance = 0.0f;
			if (mfFlesherShadowFader>=0.0f)
			{
				// Check how close the player is
				fFlesherDistance= (pFlesher.GetPosition()-Player_GetPosition()).Length();

				if (fFlesherDistance<gFlesherShadowVanishDistance&&!mbKeepFlesherClose)	// Too close - vanish!
				{
					Map_RemoveTimer("TimerStopFlesherShadow");
					TimerStopFlesherShadow("");
				}
				else if (fFlesherDistance<gFlesherShadowCloseVanishDistance&&mbKeepFlesherClose)
				{
					Map_RemoveTimer("TimerStopFlesherShadow");
					TimerStopFlesherShadow("");
				}
			}
				
			// Fade the brightness of the billboard
			float fBrightness = 0.05f;
			if (mfFlesherShadowFader>0.0f)	// Fading in
			{
				mfFlesherShadowFader-=(afTimeStep/gFlesherShadowFadeTime);
				if (mfFlesherShadowFader<0.0f)
				{
					mfFlesherShadowFader=0.0f;
				}
				fBrightness = (1.0f-mfFlesherShadowFader)*fBrightness;
			}
			else if (mfFlesherShadowFader<0.0f)	// Fading out
			{
				mfFlesherShadowFader+=(afTimeStep/gFlesherShadowFadeTime);
				if (mfFlesherShadowFader>0.0f)
				{
					mfFlesherShadowFader=0.0f;
					OnFlesherShadowVanished();
					return;
				}
				fBrightness = -mfFlesherShadowFader*fBrightness;
			}
			
			Billboard_SetBrightness("FlesherShadowBillboard_Billboard_1", fBrightness);
			
			///////////////////////////////////
			// Bright flash & flicker
			if (mfFlesherShadowFader>=0.0f)
			{
				float fTime = Map_GetTimerTime("TimerStopFlesherShadow");
				float fFlashAmount = cMath_Sin(fTime*3.0f)*cMath_Sin(fTime*7.0f);
				float fFlickerAmount = cMath_Sin(fTime*37.0f)*cMath_Sin(fTime*71.0f);
				Entity_SetEffectBaseColor("FlesherShadow", cColor(1,1) + cColor(15,1) * fFlashAmount);
				pFlesher.GetMeshEntity().SetVisible(fFlickerAmount<0.75f);
			}
		}
		
		//-------------------------------------------------------
		
		void TimerStopFlesherShadow(const tString& in asTimer)
		{
			if (mfFlesherShadowFader==0.0f)
			{
				mfFlesherShadowFader = -1.0f;	// Starts the billboard fade out
				// Fade the shadow himself
				Prop_SetActiveAndFade("FlesherShadow",false,gFlesherShadowFadeTime);
			}
		}
		
		//-------------------------------------------------------
		
		void OnFlesherShadowVanished()
		{
			// All gone
			mbFlesherShadowActive = false;
			Entity_SetActive("FlesherShadow", false);
			Entity_SetActive("FlesherShadowBillboard", false);
			Effect_VideoDistortion_Start(1, 0.75, 0.0, 0.5);
			Effect_VideoDistortion_FadeOut(mlFlesherDistortion,4.0f);
			Effect_Shake_Start(0.2, 0, 0.3, 1);
		}

		//-------------------------------------------------------
		
		//} END Flesher Hallucinations
		
