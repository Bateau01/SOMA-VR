		/////////////////////////////////////////
		// Scene 3 Event C * Find Animal Observatory *
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbObsLightsOn = false;
		bool mbObsLeverEnabled = false;
		
		void SetupObservatory()
		{
			mbObsLightsOn = true;
			//ParticleSystem_SetVisible("FishLamp8PS_*", false);
			//Entity_SetActive("TriggerBrokenLever", false);
			
			Lamp_SetLit("ObsLamp_1", true, true);
			Lamp_SetLit("ObsLamp_2", true, true);
			Lamp_SetLit("FishLamp_8", true, true);
			Lamp_SetLit("BaitLamp_*",true, true);
			ParticleSystem_SetVisible("FishLamp8PS_*", true);
			Lamp_SetLit("ObsInteriorLamp_*", true, false);
			Lamp_SetLit("ObsPowerIndicator", false, true);
			
			Map_AddTimer("TimerEnableObsLever",1.0f,"TimerEnableObsLever");
		}
		
		//-------------------------------------------------------
		
		void TimerEnableObsLever(const tString& in asName)
		{
			mbObsLeverEnabled = true;
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerNearObservatory(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==1)
			{
				cLux_AddDebugMessage("Near observatory.");
			}
			else
			{
				cLux_AddDebugMessage("Away from observatory.");
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnObsLampLeverStateChange(const tString &in asEntity, int alState)
		{
			if (!mbObsLeverEnabled)
				return;

			if (alState==0)
				return;
				
			SetObsLightState(alState==-1);
				
			if (alState==1)
			{
				Entity_SetActive("ObsLampLever", false);
				Entity_SetActive("ObsLampLeverBroken", true);
				
				if (Entity_IsInteractedWith(asEntity))
				{
					Player_ChangeStateToNormal();
					Entity_CallEntityInteract("ObsLampLeverBroken");
				}
				else
				{
					Body_AddImpulse("ObsLampLeverBroken_Body_1", cVector3f(-1000.0f,-1000.0f, 1000.0f) , true);
				}
				
				Sound_CreateAtEntity("LeverBreak", "Entities_OceanBottom/objects/emergency_panel/emergency_panel_break", asEntity);
				ParticleSystem_CreateAtEntityExt("BreakPS1", "elec_spark_oneshot.ps", asEntity, false, cColor_White);
				ParticleSystem_CreateAtEntityExt("BreakPS2", "oneshot_waterbubbles_small.ps", asEntity, false, cColor_White);
				Lamp_SetLit("ObsPowerIndicator", false, true);
			}
		}
		
		//-------------------------------------------------------
		
		bool OnEnterObservatory(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==1)
				return true;
				
			Swarm_SetPlayerIsInBuilding("swarm_1", true);
				
			Entity_SetActive("TriggerEnterObs_*", false);
			Entity_SetActive("TriggerLeaveObs_*", true);
			cLux_AddDebugMessage("Enter observatory.");
			StormAudio_EnterBuildings();
			
			// Destroy the player's personal storm and start up some static ones
			ParticleSystem_Destroy("Storm");
			ParticleSystem_CreateAtEntityExt("ObsStorm1", "tau_storm_min.ps", "ObsStorm_1", true, 
				cColor_White, 1, true, 0.3, 0.75);
			ParticleSystem_CreateAtEntityExt("ObsStorm2", "tau_storm_min.ps", "ObsStorm_2", true, 
				cColor_White, 1, true, 0.3, 0.75);
			ParticleSystem_CreateAtEntityExt("ObsStorm3", "tau_storm_min.ps", "ObsStorm_3", true, 
				cColor_White, 1, true, 0.3, 0.75);
			Map_FadeEnvironmentParticleWindVelocity(cVector3f_Zero, 3.0f);	

			ParticleSystem_Destroy("StormDirt");
			return true;
		}

		//-------------------------------------------------------

		bool OnLeaveObservatory(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==1)
				return true;
				
			Swarm_SetPlayerIsInBuilding("swarm_1", false);
			
			Entity_SetActive("TriggerEnterObs_*", true);
			Entity_SetActive("TriggerLeaveObs_*", false);
			cLux_AddDebugMessage("Leave observatory.");
			StormAudio_ExitBuildings(0.5f, 1.0f);
			
			// Switch back to the player's personal storm
			ParticleSystem_CreateAtEntityExt("Storm", "tau_storm_min.ps", "StormParticleArea", true,
				cColor_White, 1, true, 0.3, 0.75);
			ParticleSystem_Destroy("ObsStorm*");
			Map_FadeEnvironmentParticleWindVelocity(gvCurrentDir*2.5f, 1.0f);
			
			ParticleSystem_CreateAtEntityExt("StormDirt", msStormDirt, "Camera", 
				true, cColor_White, 1, false, 0, 0);
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnDrainedObsFlower(const tString &in asEntity)
		{
			Lever_SetStuckState("ObsLampLever",-1,true);
			SetObsLightState(false);
			Lamp_SetLit("path_marker_tau_12",false,false);
			Lamp_SetLit("path_marker_tau_13",false,false);
			Lamp_SetLit("path_marker_tau_14",false,false);
		}
		
		//-------------------------------------------------------
		
		void SetObsLightState(bool abState)
		{
			mbObsLightsOn = abState;
			Lamp_SetLit("ObsLamp_1", mbObsLightsOn, true);
			Lamp_SetLit("ObsLamp_2", mbObsLightsOn, true);
			Lamp_SetLit("FishLamp_8", mbObsLightsOn, true);
			Lamp_SetLit("BaitLamp_*",mbObsLightsOn, true);
			ParticleSystem_SetVisible("FishLamp8PS_*", mbObsLightsOn);
			Lamp_SetLit("ObsInteriorLamp_*", mbObsLightsOn, false);
			Lamp_SetLit("ObsPowerIndicator", !mbObsLightsOn, true);
			Entity_SetEffectsActive("FishLampSign_8",false,false);
		}

		//-------------------------------------------------------
		
		//} END Find Animal Observatory

