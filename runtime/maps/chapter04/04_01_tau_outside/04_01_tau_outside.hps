		}
		
		//-------------------------------------------------------
		
		void SendBotToTau()
		{
			Map_AddTimer("TimerSendBotToTau", 1.0f, "TimerSendBotToTau" );
		}
		
		//-------------------------------------------------------
		
		void TimerSendBotToTau(const tString& in asName)
		{
			LightbotSetsOffSound();
			StartLightbotIdleSounds();
			
			msLightBotDest = "Tau";
			
			Pathfinder_Track_Clear("LightBot");
			for (int i=44;i<=60;++i)
				Pathfinder_Track_Add("LightBot","LightNode_"+i);
			Pathfinder_Track_Start("LightBot",false,1.0f,"OnLightBotHitEndOfTrack");
			
			Map_AddTimer("LightBotMusic", 5.0f, "LightBotMusic");
			LightBot_StartFlicker();
		}
		
		//-------------------------------------------------------
		
		bool mbLightBotFlickering = false;
		bool mbLightBotEffectsOn = true;
		
		//-------------------------------------------------------
		
		void LightBot_StartFlicker()
		{
			Map_AddTimer("TimerLightBotFlicker",cMath_RandRectf(10.0f,20.0f),"TimerLightBotFlicker");
		}
		
		//-------------------------------------------------------
		
		void LightBot_StopFlicker()
		{
			Map_RemoveTimer("TimerLightBotFlicker");
			Map_RemoveTimer("TimerLightBotDoFlicker");
			Entity_SetEffectsActive("LightBot",true,false);
			mbLightBotFlickering = false;
			mbLightBotEffectsOn = true;
		}
		
		//-------------------------------------------------------
		
		void TimerLightBotFlicker(const tString& in asName)
		{
			if (mbLightBotFlickering)
			{
				mbLightBotFlickering = false;
				mbLightBotEffectsOn = true;
				Map_RestartCurrentTimer(cMath_RandRectf(10.0f,20.0f));
				Entity_SetEffectsActive("LightBot",true,false);
				Map_RemoveTimer("TimerLightBotDoFlicker");
			}
			else
			{
				mbLightBotFlickering = true;
				Map_RestartCurrentTimer(cMath_RandRectf(2.0f,5.0f));
				Entity_SetEffectsActive("LightBot",false,false);
				mbLightBotEffectsOn = false;
				Map_AddTimer("TimerLightBotDoFlicker",cMath_RandRectf(0.05f,0.5f), "TimerLightBotDoFlicker");
			}
		}
		
		//-------------------------------------------------------
		
		void TimerLightBotDoFlicker(const tString& in asName)
		{
			mbLightBotEffectsOn = !mbLightBotEffectsOn;
			Entity_SetEffectsActive("LightBot",mbLightBotEffectsOn,false);
			Map_RestartCurrentTimer(cMath_RandRectf(0.05f,0.5f));
		}
		
		//-------------------------------------------------------
		
		void SendBotToObservatory()
		{
			Map_AddTimer("TimerSendBotToObservatory", 1.0f, "TimerSendBotToObservatory" );
		}
		
		//-------------------------------------------------------
		
		void TimerSendBotToObservatory(const tString& in asName)
		{
			LightbotSetsOffSound();
			StartLightbotIdleSounds();
			
			msLightBotDest = "Observatory";
				
			Pathfinder_Track_Clear("LightBot");
			for (int i=44;i>=10;--i)
				Pathfinder_Track_Add("LightBot","LightNode_"+i);
			Pathfinder_Track_Start("LightBot",false,1.0f,"OnLightBotHitEndOfTrack");
		}
		
