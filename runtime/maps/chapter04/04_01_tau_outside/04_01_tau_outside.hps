	// SCENE 3 *JOURNEY TO TAU*
	// ==============
	//{//////////////////////////////////////

	//-------------------------------------------------------
		
		/////////////////////////////////////////
		// Storm Setup
		//{//////////////////////////////////////
		
		//-------------------------------------------------------

		void SetupStorm()
		{
			m_idPSArea = Map_GetEntityID("StormParticleArea", eLuxEntityType_Area);
					
			for (int i = 1; i <= 24; i++)
			{
				Lamp_SetLit("path_marker_tau_"+i, false, false);
			}
			
			////////////////////////////////////////////////////////////////////////////////////////
			// Preloading sound entities to avoid starting the same looping sound multiple times
			//Sound_CreateAtEntity("Storm_0", "02_04_theta_outside/amb/background/stage1_calm", "Player", 0, false, 1);
			//Sound_CreateAtEntity("Storm_1", "02_04_theta_outside/amb/background/stage2_begin", "Player", 0, false, 0);
			//Sound_CreateAtEntity("Storm_2", "02_04_theta_outside/amb/background/stage3_intense", "Player", 0, false, 0);
			
			SetStormStrength(0, 0.5f, 0.5f);
		}

		//-------------------------------------------------------
		
		//} END Storm Setup
		
		/////////////////////////////////////////
		// Scene 3 Event A * Lanterns turn on; begin the trek *
		//{//////////////////////////////////////
		
		int mlNearestMarker = 1;
		bool mbLampTrailLit=false;
		
		void OnLampLeverStateChanged(const tString &in asEntity, int alState)	
		{
			if (alState==1)
			{		
				Map_AddTimer("TimerBrightenMarker",10.0f,"TimerBrightenMarker");
				StopAmbientMusic(3.0f);
				Map_AddTimer("MarkersMusic", 1.5f, "ActivateMarkersMusic");
				for (int i = 1; i <= 26; i++)
				{
					if (i>=25)
						Map_AddTimer("path_marker_tau_"+(i+46), i*0.75f, "TimerSetLampLit");
					else
						Map_AddTimer("path_marker_tau_"+i, i*0.75f, "TimerSetLampLit");
				}
				Lamp_SetLit("MarkerLampsIndicator",false,true);
				
				Lever_SetStuckState(asEntity, 1, true);
				
				if(mbLampTrailLit==false)
				{
					Sound_CreateAtEntity("LightSwitchSweet", "04_01_tau_outside/SFX/guide_lights/guide_lights_on_sweet", "Player");
				}
				
				mbLampTrailLit = true;
			}
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerStartLamps(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==1)
			{
				cLux_AddDebugMessage("Activate light timer.");
				if (!Map_TimerExists("TimerCheckLamps"))
				{
					Map_AddTimer("TimerCheckLamps", 1.0f, "TimerCheckLamps");
				}
			}
			return true;
		}
		
		//-------------------------------------------------------

		void TimerCheckLamps(const tString& in asName)
		{
			cVector3f vPos = Player_GetPosition();
			iLuxEntity@ pPrevLamp = Map_GetEntity("path_marker_tau_"+(mlNearestMarker-1));
			iLuxEntity@ pCurrLamp = Map_GetEntity("path_marker_tau_"+(mlNearestMarker));
			iLuxEntity@ pNextLamp = Map_GetEntity("path_marker_tau_"+(mlNearestMarker+1));
			
			float fPrev = 1000.0f;
			if (pPrevLamp!=null)
				fPrev = (vPos-pPrevLamp.GetPosition()).SqrLength();
			float fCurr = 1000.0f;
			if (pCurrLamp!=null)
				fCurr = (vPos-pCurrLamp.GetPosition()).SqrLength();
			float fNext = 1000.0f;
			if (pNextLamp!=null)
				fNext = (vPos-pNextLamp.GetPosition()).SqrLength();
			
			int lNearestLamp = mlNearestMarker;

			if (fNext<fCurr && fNext<=fPrev)
			{
				lNearestLamp = mlNearestMarker+1;
			}
			else if (fPrev<fCurr && fPrev<fNext)
			{
				lNearestLamp = mlNearestMarker-1;
			}
			
			if (lNearestLamp != mlNearestMarker)
			{
				Map_RemoveTimer("TimerBrightenMarker");
				Map_AddTimer("TimerBrightenMarker",10.0f,"TimerBrightenMarker");

				mlNearestMarker = lNearestLamp;
				
				tString sMarker = "path_marker_tau_"+(mlNearestMarker);
				Entity_FadeEffectBaseColor(sMarker, cColor(1.0f,1.0f,1.0f,1.0f), 5.0f);
			}

			Map_AddTimer("TimerCheckLamps", 1.0f, "TimerCheckLamps");
		}
		
		//-------------------------------------------------------
		
		void TimerBrightenMarker(const tString& in asName)
		{
			tString sMarker = "path_marker_tau_"+(mlNearestMarker+1);
			Entity_FadeEffectBaseColor(sMarker, cColor(2.0f,2.0f,2.0f,1.0f), 5.0f);
		}
		
		//-------------------------------------------------------
		
		int mlStormStrengthAtCheckpoint = 0;
		
		bool CollisionCheckpoint(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == -1) return true;
			
			int lIdx = cString_GetNumericSuffixInt(asChild, 1);
			
			msPlayerSpawnPos = "CheckPoint_"+lIdx;

			cLux_AddDebugMessage("SpawnPos: " + msPlayerSpawnPos);		
			
			mlStormStrengthAtCheckpoint = mlStormStrength;
			
			//If the player does not turn on lights and dies at a later checkpoint (but not too far off) respawn at start!
			if(mbLampTrailLit==false && lIdx<=5) return true;
			
			/////////////////
			// Start preloading
			if(asChild == "CheckpointTrigger_8")
				Preload();
			
			return true;
		}

		//-------------------------------------------------------

		int mlStormStrength = 0;

		//-------------------------------------------------------
		
		bool CollisionIncreaseStormStrength(const tString &in asParent, const tString &in asChild, int alState)
		{
			/////////////////////////////
			// Check if the storm is strong enough already
			int lColliderID = cString_GetNumericSuffixInt(asParent);
			
			cLux_AddDebugMessage("Increase Storm Strength:"+asParent+","+lColliderID);

			float fSoundFadeTime;
			float fFogFadeTime;
			
			int lNewStrength = lColliderID;
			if (alState==-1)
				lNewStrength = lColliderID-1;
			
			switch (lNewStrength)
			{
				case 0:
					fSoundFadeTime = 60;
					fFogFadeTime = 60;
					cLux_AddDebugMessage("Storm Case 0 triggered");
				break;
				
				case 1:
					StormAudioHandler(8.0f, 1.0f, 1);
					fSoundFadeTime = 60;
					fFogFadeTime = 60;
					cLux_AddDebugMessage("Storm Case 1 triggered");
				break;
				
				case 2:
					StormAudioHandler(8.0f, 1.0f, 2);
					fSoundFadeTime = 100;
					fFogFadeTime = 100;
					cLux_AddDebugMessage("Storm Case 2 triggered");
				break;
				
				case 3:
					fSoundFadeTime = 200;
					fFogFadeTime = 100;
					cLux_AddDebugMessage("Storm Case 3 triggered");
				break;
			}
			
			SetStormStrength(lNewStrength, fFogFadeTime, fSoundFadeTime);
			
			return true;
		}

		//-------------------------------------------------------
		
		void TimerStrongCurrents(const tString &in asTimer)
		{
			if (asTimer == "StrongCurrentsPush")
			{
				Map_AddTimer("StrongCurrentsPush", 0.1, "TimerStrongCurrents");
				
				// Calculate how much the player is moving against the current
				cVector3f vPlayerDir = Player_GetVelocity();
				vPlayerDir.y = 0;
				float fCurrentDot = cMath_Vector3Dot(cMath_Vector3Normalize(vPlayerDir), gvCurrentDir);
				
				if (fCurrentDot < 0)
				{
					Player_SetMoveSpeedMul(1+fCurrentDot*0.3); // Slow down a bit if moving against storm
				}
				else
				{
					Player_SetMoveSpeedMul(1);
				}
			}
			else if (asTimer == "ActivateStrongCurrents")
			{
				float fCurrentDuration = cMath_RandRectf(4, 8);
				
				/////////////////////
				// Effects
				ParticleSystem_CreateAtEntityExt("StrongCurrents", "tau_storm_current.ps", "StormParticleArea", true, cColor_White, 1, false, 0.3, 0.75);
				
				Effect_Shake_Start(0.01, fCurrentDuration*0.5, fCurrentDuration*0.5, 3, cVector3f(1, 1, 0), 20);
				
				Map_AddTimer("StopStrongCurrents", fCurrentDuration, "TimerStrongCurrents");
				Map_AddTimer("StrongCurrentsPush", 0.1, "TimerStrongCurrents");
			}
			else
			{			
				ParticleSystem_Destroy("StrongCurrents");
				
				Player_StopLookAt(0.2);
				Player_SetMoveSpeedMul(1);
				
				Map_RemoveTimer("StrongCurrentsPush");
				Map_AddTimer("ActivateStrongCurrents", cMath_RandRectf(20, 45), "TimerStrongCurrents");
			}
		}

		//-------------------------------------------------------
		
		void StartStrongCurrents(float afDelay)
		{
			Map_AddTimer("ActivateStrongCurrents", afDelay, "TimerStrongCurrents");
		}

		//-------------------------------------------------------
		
		void StopStrongCurrents()
		{
			if (Map_GetTimerTime("StopStrongCurrents") > 0) 
				TimerStrongCurrents("StopStrongCurrents");
			Map_RemoveTimer("StrongCurrentsPush");
			Map_RemoveTimer("ActivateStrongCurrents");
			Map_RemoveTimer("StopStrongCurrents");
		}

		//-------------------------------------------------------
		
		int mlPathBoundaryCount = 0;
		int mlInBoundaryStormStrength = 0;
		bool mbLeavingPath = false;
		//-------------------------------------------------------

		bool CollisionPathBoundaries(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (SequenceStates_IsActive("Sequence_Lost"))
				return true;
				
			mlPathBoundaryCount += alState;
			cLux_AddDebugMessage("CollisionPathBoundaries:"+asChild+" :" + alState);
			cLux_AddDebugMessage("mlPathBoundaryCount " + mlPathBoundaryCount);
			
			/////////////////////////////
			// Starting to leave path
			if (alState == 1 && mlPathBoundaryCount == 1)
			{	
				cLux_AddDebugMessage("Entering boundary area - Starting to leave path");
				
				mbLeavingPath = true;
				
				////////////////////////////
				// Increase storm strength
				mlInBoundaryStormStrength = mlStormStrength;
				if (mlStormStrength < 2)
				{
					SetStormStrength(mlStormStrength+1, 20, 20);
				}
				
				Map_AddTimer("TimerBoundaryLost", 5.0f, "TimerBoundaryLost");
			}
			
			if (alState == 1 || mlPathBoundaryCount != 0) return true;
			
			cLux_AddDebugMessage("Leaving boundary area - Returning to path");
			mbLeavingPath =false;
			Map_RemoveTimer("TimerBoundaryLost");
			SetStormStrength(mlInBoundaryStormStrength, 10, 10);
			
			return true;
		}

		//-------------------------------------------------------
		
		void TimerIncreaseStormStrength(const tString &in asTimer)
		{
			SetStormStrength(mlStormStrength+1, 20, 20);
		}

		//-------------------------------------------------------
		
		void TimerBoundaryLost(const tString& in asName)
		{
			Sequence_Lost("");
		}
		
		//-------------------------------------------------------
		
		bool mbKeepFlesherClose = false;
		int mlLostDistortion = -1;
		
		cSequenceStatesData mSeqLost;
		void Sequence_Lost(const tString& in asSeq)
		{
			Sequence_Begin("Sequence_Lost", mSeqLost);
			
			if (Sequence_DoStepAndWait(5.0f))
			{
				cLux_AddDebugMessage("Start damage.");
				mlLostDistortion = Effect_VideoDistortion_Start(0.5f,6.5f,0.1f,0.5f);
				AttackMeter_AutoDamage(5.0f,0.1f,false);
				Map_FadeFogEnd(5.0f,3.0f);
				mbLeavingPath = false;
				
				Sound_CreateAtEntity("NearDeath", "04_01_tau_outside/SFX/near_death", "Player");
				Sound_FadeGlobalVolume(0.35f, 3.0f, eSoundEntryType_WorldClean);
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{

			}
			else if (Sequence_DoStepAndWait(10.0f))
			{
				cLux_AddDebugMessage("Teleport.");
				Player_Teleport(msPlayerSpawnPos,true);
				StartFlesherShadow(10.0f,4.0f,false);
				mbKeepFlesherClose = true;
				Map_FadeFogEnd(mfStormFogEnd,0.01f);
				SetStormStrength(mlStormStrengthAtCheckpoint, 2, 2);
				Effect_VideoDistortion_FadeOut(mlLostDistortion,1.0f);
				mlLostDistortion=-1;
				Map_AddTimer("RossWakeUpSound", 3.0f, "RossWakeUpSound");
				
			}
			else if (Sequence_DoStepAndWait(0))
			{
				mlPathBoundaryCount=0;
				mbKeepFlesherClose = false;
			}
			Sequence_End();
		}
		
		bool mbRossWakeUpMusic = false;
		void RossWakeUpSound(const tString &in asTimer)
		{
			Sound_CreateAtEntity("RossDeathSweet", "04_01_tau_outside/SFX/ross_death_wake_sweet", "Player");
			
			if(mbRossWakeUpMusic==false)
			{
				mbRossWakeUpMusic = true;
				Music_Play("03_02_voices01", 0.75f, false, eMusicPrio_BigEvent);
				Depth_Audio_Fear_MediumIntensity();
			}
		}
		
		//-------------------------------------------------------
		
		//} END Lanterns turn on; begin the trek
		
		/////////////////////////////////////////
		// Scene 3 * Swarm Control *
		//{//////////////////////////////////////
		
		tString msPlayerSpawnPos="CheckPoint_1";
		
		//-------------------------------------------------------
		
		bool OnTriggerEnableSwarm(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Swarm is active!");
			Entity_SetActive("swarm_1", true);
			
			AttackMeter_SetAfterDamageCallback("AfterSwarmKnockDown");
			
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerDisableSwarm(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Swarm is deactivating!");
			Swarm_StartDeactivation("swarm_1");		
			Swarm_RetreatTowards("swarm_1", "AgentRepelArea_Observatory_Exit_4", 20.0f);
			return false;
		}
		
		//-------------------------------------------------------
		
		void AfterSwarmKnockDown(const tString& in asSource)
		{
			cLux_AddDebugMessage("AfterSwarmKnockDown");
			Player_Teleport(msPlayerSpawnPos, false);
			if (Player_GetHealth()>0.57f)
				Player_SetHealth(0.57f);
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerMakeSwarmDeadlier(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Increased swarm build-up speed!");
			
			Swarm_SetBuildUpSpeedMul("swarm_1", 10);
			
			return false;
		}
		
