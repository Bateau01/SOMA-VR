		/////////////////////////////////////////
		// Terminal * Depth Terminals In Elevator *
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		void OnGuiElevatorDepth(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("03_03_omicron_descent");
		
			cImGuiLabelData label;
			label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Medium));
			label.mFont.mvSize = cVector2f(32, 32);
			
			ImGui_GroupBegin(cVector3f_Zero, ImGui_GetSize());
			
			///////////////////
			// Background
			ImGui_DoImage(cImGuiGfx("03_03_depth", eImGuiGfx_Texture), 
				ImGui_NrmPosGroup(cVector3f_Zero), ImGui_NrmSizeGroupKeepRatio(cVector2f_One));
			
			///////////////////
			// Lift Wire
			cColor cableColor = cColor(0.5f,0.5f,0.5f, 0.5f);
			ImGui_DrawLine(ImGui_NrmSizeGroup(cVector2f(0.5f,0.0f)), ImGui_NrmSizeGroup(cVector2f(0.5f,1.0f)), 0.5f, 1.0f, cableColor);
			
			///////////////////
			// Lift
			float fProgress = mfActualDepth/gfDepthDisplayHeight; 
			
			cImGuiGfx imLift("03_03_elevator", eImGuiGfx_Texture);
			ImGui_DoImage(imLift, ImGui_NrmPosGroup(cVector3f(0.5f,fProgress+0.025f,1.0f)) - cVector3f(8.0f,16.0f,0.0f), cVector2f(16.0f,32.0f));
				
			/////////////////
			// Probes
			float fProbe1 = (gfProbe1Depth+gfDepthDisplayStart)/gfDepthDisplayHeight; 
			float fProbe2 = (gfProbe2Depth+gfDepthDisplayStart)/gfDepthDisplayHeight; 
			float fProbe3 = (gfProbe3Depth+gfDepthDisplayStart)/gfDepthDisplayHeight; 
			
			cColor probeLineColor = cColor(0.5f,0.0f,0.0f);
			ImGui_DrawLine(ImGui_NrmSizeGroup(cVector2f(0.0f,fProbe1)), ImGui_NrmSizeGroup(cVector2f(1.0f,fProbe1)), 0.5f, 1.0f, probeLineColor);
			ImGui_DrawLine(ImGui_NrmSizeGroup(cVector2f(0.0f,fProbe2)), ImGui_NrmSizeGroup(cVector2f(1.0f,fProbe2)), 0.5f, 1.0f, probeLineColor);
			ImGui_DrawLine(ImGui_NrmSizeGroup(cVector2f(0.0f,fProbe3)), ImGui_NrmSizeGroup(cVector2f(1.0f,fProbe3)), 0.5f, 1.0f, probeLineColor);
			
			cImGuiGfx imProbe("03_03_probe", eImGuiGfx_Texture);
			ImGui_SetModColorMul(cColor(1.0f,0.25f,0.25f));
			ImGui_DoImage(imProbe, ImGui_NrmPosGroup(cVector3f(0.25f,fProbe1,1.0f)) - cVector3f(16.0f,16.0f,0.0f), cVector2f(32.0f,32.0f));
			ImGui_DoImage(imProbe, ImGui_NrmPosGroup(cVector3f(0.25f,fProbe2,1.0f)) - cVector3f(16.0f,16.0f,0.0f), cVector2f(32.0f,32.0f));
			ImGui_DoImage(imProbe, ImGui_NrmPosGroup(cVector3f(0.25f,fProbe3,1.0f)) - cVector3f(16.0f,16.0f,0.0f), cVector2f(32.0f,32.0f));
			ImGui_ResetModifiers();
			
			/////////////////
			// Zones
			float fZone1 = (gfZone1+gfDepthDisplayStart)/gfDepthDisplayHeight; 
			float fZone2 = (gfZone2+gfDepthDisplayStart)/gfDepthDisplayHeight; 
			float fZone3 = (gfZone3+gfDepthDisplayStart)/gfDepthDisplayHeight; 
			
			cColor zoneLineColor = cColor(0.25f,0.25f,1.0f);
			ImGui_DrawLine(ImGui_NrmSizeGroup(cVector2f(0.0f,fZone1)), ImGui_NrmSizeGroup(cVector2f(1.0f,fZone1)), 0.5f, 1.0f, zoneLineColor);
			ImGui_DrawLine(ImGui_NrmSizeGroup(cVector2f(0.0f,fZone2)), ImGui_NrmSizeGroup(cVector2f(1.0f,fZone2)), 0.5f, 1.0f, zoneLineColor);
			ImGui_DrawLine(ImGui_NrmSizeGroup(cVector2f(0.0f,fZone3)), ImGui_NrmSizeGroup(cVector2f(1.0f,fZone3)), 0.5f, 1.0f, zoneLineColor);
			
			/////////////////
			// Ground
			cColor groundLineColor = cColor(0.5f,1.0f,0.0f);
			float fGroundLine = (gfStationDepth+gfDepthDisplayStart)/gfDepthDisplayHeight+0.025f;
			ImGui_DrawLine(ImGui_NrmSizeGroup(cVector2f(0.0f,fGroundLine)), ImGui_NrmSizeGroup(cVector2f(1.0f,fGroundLine)), 0.5f, 1.0f, groundLineColor);
		
			///////////////////
			// Display
			tString sDepth = ""+mfActualDepth;
			int lDotPos = cString_GetLastCharPos(sDepth, '.');
			sDepth = cString_Sub(sDepth, 0, lDotPos+3);
			
			float fPressure = ((1000.0f*9.81f*mfActualDepth)/101300.0f)+1.0f;	// Atmospheres
			tString sPressure = ""+fPressure;
			lDotPos = cString_GetLastCharPos(sPressure, '.');
			sPressure = cString_Sub(sPressure, 0, lDotPos+3);
			
			tString sSpeed = ""+(mfElevatorSpeed*gfFakeSpeedScale); // Cheat speed scale
			lDotPos = cString_GetLastCharPos(sSpeed, '.');
			sSpeed = cString_Sub(sSpeed, 0, lDotPos+3);
				
			tWString sDepthLabel = ImGui_Translate("DepthGUI_Depth");
			ImGui_ResizeFontToFit(sDepthLabel, label.mFont, ImGui_GetCurrentGroupSize().x-100);
			sDepthLabel = cString_ReplaceStringToW(sDepthLabel, tWString("%f"), tWString(sDepth));
					
			tWString sPressureLabel = ImGui_Translate("DepthGUI_Pressure");
			ImGui_ResizeFontToFit(sPressureLabel, label.mFont, ImGui_GetCurrentGroupSize().x-100);
			sPressureLabel = cString_ReplaceStringToW(sPressureLabel, tWString("%f"), tWString(sPressure));
			
			tWString sSpeedLabel = ImGui_Translate("DepthGUI_Speed");
			ImGui_ResizeFontToFit(sSpeedLabel, label.mFont, ImGui_GetCurrentGroupSize().x-100);
			sSpeedLabel = cString_ReplaceStringToW(sSpeedLabel, tWString("%f"), tWString(sSpeed));
			
			ImGui_SetTransCategory("");
		
			ImGui_SetTextOverride(sDepthLabel);
			ImGui_DoLabelExt("", label, ImGui_NrmPosGroup(cVector3f(0.1f,0.82f,0.0f)), 
				cVector2f_MinusOne, 1);
			ImGui_SetTextOverride(sPressureLabel);
			ImGui_DoLabelExt("", label, ImGui_NrmPosGroup(cVector3f(0.1f,0.87f,0.0f)), 
				cVector2f_MinusOne, 1);
			ImGui_SetTextOverride(sSpeedLabel);
			ImGui_DoLabelExt("", label, ImGui_NrmPosGroup(cVector3f(0.1f,0.92f,0.0f)), 
				cVector2f_MinusOne, 1);
			ImGui_ClearTextOverride();
			
			ImGui_GroupEnd();
		}
		
		//-------------------------------------------------------
		
		//} END Depth Terminals In Elevator

		/////////////////////////////////////////
		// Terminal * Main Terminal In Elevator *
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		void OnGuiElevatorMain(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("04_01_tau_outside");
					
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();
			
			cStationGui_BigStatusMessageSettings statusMessage;
			
			if (mbElevatorRunning)
			{
				statusMessage.mbBlinking = true;
				statusMessage.mfBlinkTime = 0.5;
				
				StationGui_BigStatusMessage("DepthApproachDock", statusMessage);
			}
			else
			{
				statusMessage.mColor = gStationGuiColor_Highlight;
				StationGui_BigStatusMessage("DepthArrived", statusMessage);
			}
		}
		
		//-------------------------------------------------------
		
		//} END Main Terminal In Elevator

		/////////////////////////////////////////
		// Terminal * Smashed Elevator Panel *
		//{//////////////////////////////////////

		//-------------------------------------------------------

		void OnGuiSmashedElevatorPanel(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("04_01_tau_outside");
					
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();
			
			cStationGui_BigStatusMessageSettings statusMessage;
			statusMessage.mfTextSizeMul = 1.25;
			
			statusMessage.mColor = ImGui_FadeOscillateColor("FlashColor", cColor(1.0f, 0.0f, 0.0f, 0.0f), 
				cColor(1.0f, 0.0f, 0.0f, 1.0f), 1.0f);
			
			StationGui_BigStatusMessage("SmashedElevatorPanel", statusMessage);
		}

		//-------------------------------------------------------
		
		//} END Main Terminal In Elevator

		/////////////////////////////////////////
		// Terminal * Observatory *
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		void OnGuiObservatory(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("04_01_tau_outside");
			
			StationGuiBG_Backdrop();
			StationGuiBG_Scanlines();
			StationGuiBG_Taskbar("tau");
			
			bool bBackVisible = true;
			
			switch(StationGui_GetActiveApp())
			{
				case -1:
					StationGui_AddApp("ObsMenuInventory", true, true);
					StationGui_AddApp("ObsMenuLogs", true, true);
					StationGui_AddApp("ObsMenuStats", true, true);
					StationGui_MainMenu();
					bBackVisible = false;
					break;
				case 0:
					ObservatoryGuiInventory();
					break;
				case 1:
					ObservatoryLogs();
					break;
				case 2:
					ObservatoryGuiStats(afTimeStep);
					break;
			}
			
			StationGui_BackButton(bBackVisible);
		}
		
		//-------------------------------------------------------
		
		void ObservatoryGuiInventory()
		{
			StationGui_TextReaderSingle("04_01_tau_outside", "ObsInventory");
			return;
		}
		
		//-------------------------------------------------------
		
		void ObservatoryLogs()
		{
			cStationGui_TextReaderSettings settings;
			settings.msCustomHeader = "ObsLogsTitle";
			settings.mbCorrectImageRatioForUV = true;
			
			AddObservatoryTextFile(1);
			AddObservatoryTextFile(2);
			AddObservatoryTextFile(3);
			StationGui_TextReaderMulti(settings);
		}
		
		void AddObservatoryTextFile(int aIndex)
		{
			cImGuiGfx gfx = cImGuiGfx("observatory_log_"+aIndex, eImGuiGfx_Texture);
			gfx.mvUVMax = cVector2f(0.732, 0.58);
			Depth_ImGui_AddTextFile("ObsLogsTitle_"+aIndex, "ObsLogsEntry_"+aIndex, gfx);
		}
		
		//-------------------------------------------------------
		
		void ObservatoryGuiStats(float afTimeStep)
		{
			ImGui_SetTransCategory("04_01_tau_outside");
					
			cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
			windowData.mColorText = cColor(1, 1);
		
			cImGuiButtonData button = StationGui_CreateToggleButtonData();
			button.mFont.mvSize = cVector2f(39.0f);
		
			ImGui_GroupBegin(ImGui_NrmPos(cVector3f(0.025, 0.025, 1)), ImGui_NrmSize(cVector2f(0.95, 0.95)));
			
			/////////////////////////
			// File listing
			ImGui_DoWindowStart("ObsStatsTitle", windowData, ImGui_NrmPosGroup(cVector3f(0, 0, 0)), ImGui_NrmSizeGroup(cVector2f(0.35, 0.8)));
			
			ImGui_AddItemString("ObsStatsBtn1");
			ImGui_AddItemString("ObsStatsBtn2");
			ImGui_AddItemString("ObsStatsBtn3");
			
			int lSelectedFile = ImGui_DoMultiToggleExt("FileSelection", -1, 1, 
				ImGui_NrmSizeGroup(cVector2f(0, 0.02)), button, ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 1)), 
				ImGui_NrmSizeGroup(cVector2f(0.9, cMath_Min(1.f, 0.135*3))));
			lSelectedFile++;
			
			int lLastFile = ImGui_GetStateInt("LastFile",0);
			float fGraphTimer = ImGui_GetStateFloat("GraphTimer",0.0f);
			fGraphTimer+=afTimeStep;
			if (lLastFile!=lSelectedFile)
			{
				fGraphTimer=0.0f;
				ImGui_SetStateInt("LastFile",lSelectedFile);
			}
			ImGui_SetStateFloat("GraphTimer",fGraphTimer);
			
			ImGui_DoImage(cImGuiGfx("ossymbol_graph"), 
				ImGui_NrmPos(0.025f, 0.525f, 2.0f), ImGui_NrmSize(0.12f,0.14f) );
			
			ImGui_DoWindowEnd();
				
			/////////////////////////
			// File contents
			if (lSelectedFile > 0)
			{
				ImGui_DoWindowStart("ObsStatsBtn"+lSelectedFile, windowData, 				
						ImGui_NrmPosGroup(cVector3f(0.36, 0, 0)), ImGui_NrmSizeGroup(cVector2f(0.64, 0.8)));
				
				cImGuiLabelData label;
				label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Medium));
				label.mFont.mvSize = cVector2f(38, 38);
				label.mFontAlign = eFontAlign_Left;
			
				ImGui_DoLabelExt("ObsStatsTitle"+lSelectedFile, label, 
					ImGui_NrmPosGroup(cVector3f(0.05f,0.0f,5.0f)), 
					ImGui_NrmSizeGroup(cVector2f(1.0f,0.1f)), 1);
				
				ImGui_DoLabelExt("ObsStatsSubtitle"+lSelectedFile, label, 
					ImGui_NrmPosGroup(cVector3f(0.1f,0.05f,5.0f)), 
					ImGui_NrmSizeGroup(cVector2f(1.0f,0.1f)), 0.7f);
				
				ImGui_GroupBegin(ImGui_NrmPosGroup(0,0.275f,0), ImGui_NrmSizeGroup(1, 0.65));
				
					//Graph images
					ImGui_GroupBegin(ImGui_NrmPosGroup(0.0375f, 0.105f, 4.0f), ImGui_NrmSizeGroup(1.175,0.9));
					
						float fShowProgress;
						
						if (fGraphTimer<1.0f)
							fShowProgress = cMath_Clamp( (fGraphTimer-0.5f)/0.5f, 0.0f, 1.0f);
						else
							fShowProgress = 1;
						
						cImGuiGfx graph = cImGuiGfx("observatory_graph"+lSelectedFile, eImGuiGfx_Texture);
						graph.mvUVMax = cVector2f(fShowProgress, 1);
						ImGui_DoImage(graph, ImGui_NrmPosGroup(0, 0, 0), ImGui_NrmSizeGroup(fShowProgress,1) );
						
						if (fGraphTimer<0.5f)
							fShowProgress = cMath_Clamp( fGraphTimer/0.5f, 0.0f, 1.0f);
						else
							fShowProgress = 1;
						
						cImGuiGfx grid = cImGuiGfx("observatory_grid", eImGuiGfx_Texture);
						grid.mvUVMax = cVector2f(fShowProgress, 1);
						ImGui_DoImage(grid, ImGui_NrmPosGroup(0, 0, 4), ImGui_NrmSizeGroup(fShowProgress,1) );
						
					ImGui_GroupEnd();
					
					//Graph labels
					ImGui_GroupBegin(ImGui_NrmPosGroup(0.06f,0.85f,5.0f), ImGui_NrmSizeGroup(0.88, 0.21));
						ImGui_DoLabelExt("ObsStatsYear1", label, ImGui_NrmPosGroup(cVector3f(0,0.79f,5.0f)), 
							ImGui_NrmSizeGroup(cVector2f(0.25f,0.1f)), 0.8f);
						label.mFontAlign = eFontAlign_Center;
						ImGui_DoLabelExt("ObsStatsYear2", label, ImGui_NrmPosGroup(cVector3f(0.1125f,0.79f,5.0f)), 
							ImGui_NrmSizeGroup(cVector2f(0.25f,0.1f)), 0.8f);
						ImGui_DoLabelExt("ObsStatsYear3", label, ImGui_NrmPosGroup(cVector3f(0.315f,0.79f,5.0f)), 
							ImGui_NrmSizeGroup(cVector2f(0.25f,0.1f)), 0.8f);
						ImGui_DoLabelExt("ObsStatsYear4", label, ImGui_NrmPosGroup(cVector3f(0.5375f,0.79f,5.0f)), 
							ImGui_NrmSizeGroup(cVector2f(0.25f,0.1f)), 0.8f);
						label.mFontAlign = eFontAlign_Right;
						ImGui_DoLabelExt("ObsStatsYear5", label, ImGui_NrmPosGroup(cVector3f(0.675f,0.79f,5.0f)), 
							ImGui_NrmSizeGroup(cVector2f(0.25f,0.1f)), 0.8f);
					ImGui_GroupEnd();
					
									
					ImGui_SetTransCategory("");
					label.mFontAlign = eFontAlign_Center;
					ImGui_DoLabelExt("pop. size", label, ImGui_NrmPosGroup(0,0,5.0f), 
						ImGui_NrmSizeGroup(0.25f,0.1f), 0.8f);
					ImGui_ResetModifiers();
				
				ImGui_GroupEnd();
				
				cImGuiGfx icon = cImGuiGfx("observatory_icon"+lSelectedFile, eImGuiGfx_Texture);
				ImGui_DoImage(icon, ImGui_NrmPosGroup(cVector3f(0.5f, 0.09f, 8.0f)), ImGui_GetRatioCorrectSizeByNrmWidth(icon, 0.45f) );
				
				ImGui_DoWindowEnd();
			}
			
			ImGui_GroupEnd();
		}
		
		//-------------------------------------------------------
		
		//} END Main Terminal In Elevator

		/////////////////////////////////////////
		// Terminal * Log *
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		void OnGuiLog(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("04_01_tau_outside");
			
			StationGuiBG_Backdrop();
			StationGuiBG_Scanlines();			
			StationGuiBG_Taskbar("omicron");
			
			bool bBackButtonEnabled = true;
			int lActiveApp = StationGui_GetActiveApp(-1);
			
			cStationGui_TextReaderSettings settings;
			settings.msCustomHeader = "LogTerminalTitle";
			settings.mbDrawAppIcon = false;
			settings.mfFileListButtonHeight = 0.125;
			
			switch(lActiveApp)
			{
				case -1:
					StationGui_AddApp("LogMenuSignIn", false, true);
					StationGui_AddApp("LogMenuReader", true, 0);
					StationGui_MainMenu();
					bBackButtonEnabled = false;
					break;
				case 0:
					for (int i = 1; i <= 6; i++)
						Depth_ImGui_AddTextFile("LogTitle_"+i, "LogEntry_"+i);
					StationGui_TextReaderMulti(settings);
					break;
			}
			
			StationGui_BackButton(bBackButtonEnabled);
		}

		//-------------------------------------------------------
		
		//} END LOG

		/////////////////////////////////////////
		// Terminal * STORM *
		//{//////////////////////////////////////
		
		void OnGuiStorm(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_GroupBegin(cVector3f_Zero, ImGui_GetSize());
			
			/////////////////////
			// Map		
			ImGui_DoImage(cImGuiGfx("abyssmap", eImGuiGfx_Texture), 
				ImGui_NrmPosGroup(0,0,1), ImGui_NrmSizeGroup(cVector2f(1,1)) );
				
			float fScale = ImGui_GetStateFloat("ScaleTime");
			fScale+=afTimeStep;
			if (fScale>1.0f)
				fScale-=1.0f;
			ImGui_SetStateFloat("ScaleTime",fScale);
			
			fScale*=0.05f;
			fScale-=0.025f;
			
			ImGui_DoImage(cImGuiGfx("abyssmap_arrows", eImGuiGfx_Texture), 
				ImGui_NrmPosGroup(-fScale/3.0f,-fScale/3.0f,2.0f), ImGui_NrmSizeGroup(cVector2f(1.0f+fScale,1.0f+fScale)) );
				
			ImGui_GroupEnd();
		}

		//-------------------------------------------------------
		
		//} END STORM
		
		/////////////////////////////////////////
		// Terminal * Light Bot *
		//{//////////////////////////////////////

		//-------------------------------------------------------
		void OnGuiLightBot(const tString&in asEntityName, float afTimeStep)
		{
			if (!mbSmokerPower)
			{
				float fFlicker = cMath_RandRectf(0.0f,1.0f);
				if (fFlicker<=0.1f)
					return;
			}
			if (!mbLightBotPowered)
			{
				OnGuiUnpowered(asEntityName,afTimeStep);
				return;
			}
			
			ImGui_SetTransCategory("04_01_tau_outside");
			
			StationGuiBG_Backdrop();
			StationGuiBG_Scanlines();
			StationGuiBG_Taskbar("tau");
			
			if (StationGui_DrawAndCheckErrors())
				return;
			
			cStationGui_BigStatusMessageSettings statusMessage;
			statusMessage.mColor = gStationGuiColor_Highlight;
			
			bool bBackEnabled = true;
			int lActiveApp = StationGui_GetActiveApp(-1);
			switch(lActiveApp)
			{
				case -1:
				{
					StationGui_AddApp("BotMenuControl", true, true);
					StationGui_AddApp("BotMenuStatus", true, true);
					StationGui_MainMenu();
					bBackEnabled = false;
					break;
				}
				case 0:
				{
					OnGuiLightBotMap(asEntityName, afTimeStep);
					break;
				}
				case 1:
				{
					StationGui_BigStatusMessage("BotStatusEntry", statusMessage);
					break;
				}
			}
			
			StationGui_BackButton(bBackEnabled);
		}
		
		bool mbSendingBot = false;
		
		void OnGuiLightBotMap(const tString&in asEntityName, float afTimeStep)
		{				
			if (mbSendingBot)
			{
				if (StationGui_LoadingWindow("Loading","","",5.0f,true))
				{
					mbSendingBot=false;
					SendBotToTau();
					Map_AddTimer("TimerExitGui",1.0f,"TimerExitGui");
				}
				return;
			}
			
			ImGui_GroupBegin(cVector3f_Zero, ImGui_GetSize());
		
			////////////////////
			// Map		
			ImGui_DoImage(cImGuiGfx("lightbotmap", eImGuiGfx_Texture), 
				ImGui_NrmPosGroup(0.2,0,1), ImGui_NrmSizeGroup(cVector2f(1,1)) );
				
			ImGui_GroupEnd();
			
			cImGuiButtonData button = StationGui_CreateDefaultButtonData();
			cVector2f vFontSize = button.mFont.mvSize = cVector2f(35,35);
			button.mbClipText = false;
			cVector2f vButtonSize = ImGui_NrmSizeGroup(0.275, 0.1);
			
			ImGui_SetModUseInput(true);
			button.mFont.mvSize = vFontSize;
			ImGui_ResizeFontToFit("BotObservatory", button.mFont, vButtonSize.x-24);
			bool bPressed = ImGui_DoButtonExt("BotObservatory", "BotObservatory", button, ImGui_NrmPosGroup(0.05, 0.2, 4), vButtonSize);
			ImGui_ResetModifiers();
			if (bPressed)
			{
				//SendBotToObservatory();
				StationGui_SetError("BotMenuBroken");
				//Map_AddTimer("TimerExitGui",1.0f,"TimerExitGui");
			}
			
			ImGui_SetModUseInput(true);
			button.mFont.mvSize = vFontSize;
			ImGui_ResizeFontToFit("BotElevator", button.mFont, vButtonSize.x-24);
			bPressed = ImGui_DoButtonExt("BotElevator", "BotElevator", button, ImGui_NrmPosGroup(0.05, 0.35, 4), vButtonSize);
			ImGui_ResetModifiers();
			if (bPressed)
			{
				StationGui_SetError("BotMenuBroken");
			}
			
			ImGui_SetModUseInput(msLightBotDest=="");
			ImGui_ResizeFontToFit("BotTau", button.mFont, vButtonSize.x-24);
			bPressed = ImGui_DoButtonExt("BotTau", "BotTau", button, ImGui_NrmPosGroup(0.05, 0.5, 4), vButtonSize);
			if (bPressed)
			{
				if (mbLeviathanAttackStarted)
					StationGui_SetError("BotStatusEntry");
				else
				{
					mbSendingBot=true;
				}
			}
			
			ImGui_SetModUseInput(msLightBotDest!="");
			button.mFont.mvSize = vFontSize;
			ImGui_ResizeFontToFit("BotRecall", button.mFont, vButtonSize.x-24);
			bPressed = ImGui_DoButtonExt("BotRecall", "BotRecall", button, ImGui_NrmPosGroup(0.05, 0.65, 4), vButtonSize);
			if (bPressed)
			{
				if (mbLeviathanAttackStarted)
					StationGui_SetError("BotStatusEntry");
				else
				{
					RecallBot();
					Map_AddTimer("TimerExitGui",1.0f,"TimerExitGui");
					//ImGui_Exit();
				}
			}
		}
		
		//-------------------------------------------------------
		
		void TimerExitGui(const tString& in asName)
		{
			ImGui_Exit();
		}
		
		//-------------------------------------------------------
		
		void OnGuiSmokerPlant(const tString&in asEntityName, float afTimeStep)
		{
			if (!mbLightBotPowered)
			{
				OnGuiUnpowered(asEntityName,afTimeStep);
				return;
			}
			ImGui_SetTransCategory("");
			
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();
			
			cImGuiWindowData window = StationGui_CreateDefaultWindowData();
			ImGui_DoWindowStart("Status", window, ImGui_NrmPosGroup(cVector3f(0.1, 0.1, 3)), ImGui_NrmSizeGroup(cVector2f(0.8, 0.8)));
			
				DoStatusGaugesHorizontal(5, cVector3f(0.1, 0.1, 1), cVector2f(0.75, 0.525));
				DoStatusGaugesVertical(4, cVector3f(0.55, 0.7, 1), cVector2f(0.2, 0.19), 0.6, 0.3, 0.9);
				DoRandomNumbers(3, 2, cVector3f(0.15, 0.7, 1), cVector2f(0.1, 0.1), 2, 10, 99);
				
			ImGui_DoWindowEnd();
		}

		//-------------------------------------------------------
		
		void DoStatusGaugesHorizontal(int alCount, const cVector3f &in avNrmPos, const cVector2f &in avNrmSize, float afThicknessMul = 0.8, float afMinValue = 0.5, 
									  float afMaxValue = 1.0f, const cColor &in aFillColor = cColor(-1), const tString &in asPrefix = "Horizontal")
		{
			cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
			cVector2f vSize = ImGui_NrmSizeGroup(avNrmSize);
			vSize.y = (vSize.y/alCount) * afThicknessMul;
			cVector3f vOffsetPos = cVector3f(0, avNrmSize.y/alCount, 0);
			
			for (int i = 0; i < alCount; i++)
			{
				float fValue =  Depth_ImGui_GetOscillatingSignalValue(asPrefix, i, eEasing_QuadInOut, 0.0f, 1.0f);
			
				if (aFillColor.r==-1)
					gauge.mGfxFill.mColor = gStationGuiColor_Warning * (cMath_Clamp((0.5f-fValue)*2.0f,0.0,1.0f)) +
											gStationGuiColor_Highlight * (0.5f-cMath_Abs(0.5f-fValue))*2.0f + 
											cColor_White * (cMath_Clamp((fValue-0.5f)*2.0f,0.0f,1.0f));
				else
					gauge.mGfxFill.mColor = aFillColor;
				
				ImGui_DoGauge(gauge, afMinValue+fValue*(afMaxValue-afMinValue), ImGui_NrmPosGroup(avNrmPos + vOffsetPos*i), vSize);
			}
		}
		
		//-------------------------------------------------------
		
		void DoStatusGaugesVertical(int alCount, const cVector3f &in avNrmPos, const cVector2f &in avNrmSize, float afThicknessMul = 0.8, float afMinValue = 0.75, 
									float afMaxValue = 1.0f, const cColor &in aFillColor = cColor(-1), const tString &in asPrefix = "Vertical")
		{
			cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
			gauge.mOrientation = eImGuiGaugeOrientation_Vert;
			cVector2f vSize = ImGui_NrmSizeGroup(avNrmSize);
			vSize.x = (vSize.x/alCount) * afThicknessMul;
			cVector3f vOffsetPos = cVector3f(avNrmSize.x/alCount, 0, 0);
			
			for (int i = 0; i < alCount; i++)
			{
				float fValue =  Depth_ImGui_GetOscillatingSignalValue(asPrefix, i, eEasing_QuadInOut, 0.0f, 1.0f);
			
				if (aFillColor.r==-1)
					gauge.mGfxFill.mColor = gStationGuiColor_Warning * (cMath_Clamp((0.5f-fValue)*2.0f,0.0,1.0f)) +
											gStationGuiColor_Highlight * (0.5f-cMath_Abs(0.5f-fValue))*2.0f + 
											cColor_White * (cMath_Clamp((fValue-0.5f)*2.0f,0.0f,1.0f));
				else
					gauge.mGfxFill.mColor = aFillColor;
					
				ImGui_DoGauge(gauge, afMinValue+fValue*(afMaxValue-afMinValue), ImGui_NrmPosGroup(avNrmPos + vOffsetPos*i), vSize);
				
			}
		}

		//-------------------------------------------------------
		
		void DoRandomNumbers(int alColumns, int alRows, const cVector3f &in avNrmPos, const cVector2f &in avSpacing, int alFontSize = 2, 
							 int alMinValue = 100, int alMaxValue = 999, const tString &in asPrefix = "Number")
		{		
			for (int i = 0; i < alRows*alColumns; i++)
			{
				ImGui_DoLabel("" + int(Depth_ImGui_GetOscillatingSignalValue(asPrefix, i, eEasing_QuadInOut, alMinValue, alMaxValue)), 
							  ImGui_NrmPosGroup(avNrmPos + cVector3f(avSpacing.x*(i%alColumns), avSpacing.y*(i/alColumns), 0)), cVector2f_MinusOne, alFontSize);
			}
		}
	
