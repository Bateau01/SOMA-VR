				cLux_AddDebugMessage("Near containers.");
			}	
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerInsideContainer(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState==1)
			{
				StormAudio_EnterBuildings();

				Swarm_SetPlayerIsInBuilding("swarm_1", true);
			}
			else
			{
				StormAudio_ExitBuildings(0.5f);
				
				Swarm_SetPlayerIsInBuilding("swarm_1", false);
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnTriggerSuppressStorm(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState==1)
			{
				cLux_AddDebugMessage("Suppress storm.");
				SetStormFollowingPlayer(false);
				FadeStormMapParams(false);
			}
			else
			{
				cLux_AddDebugMessage("Restart storm.");
				SetStormFollowingPlayer(true);
				FadeStormMapParams(true);
			}
			
			return true;
		}

