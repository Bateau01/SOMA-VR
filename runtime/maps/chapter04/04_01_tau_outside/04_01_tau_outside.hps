	//-------------------------------------------------------

	/////////////////////////////////////////
	// END AIRLOCK DRAINING
	//{///////////////////////////////////////

	//-------------------------------------------------------
	
	cSequenceStatesData mOutroSequence;
		
	void Seq_Outro(const tString &in asTimer)
	{
		Sequence_Begin("Seq_Outro", mOutroSequence);
		
		if (Sequence_DoStepAndWait(9))
		{
			SlideDoor_SetClosed("swingdoor_tau_large_x1", true, false);
			Entity_SetActive("BlockExitTau",true);
			
			Entity_SetActive("Airlock1Water", true);
			FogArea_SetVisible("FogArea_1", false);
		}
		
		if (Sequence_DoStepAndWait(1))
		{
			PreloadDeload();
		}
		
		if (Sequence_DoStepAndWait(3.5))
		{
			Prop_RotateToSpeed("AirlockWarningLamp", 10, 7.5, cVector3f(0, 1, 0), true, "");

			Sound_CreateAtEntity("Intro_AirlockFlushingAlarm", "Entities_OceanBottom/airlock/alarms/draining_alarm", "AirlockWarningLamp", 0, true);
			Map_AddTimer("AirlockAlarm", 1.0f, "AirlockAlarmEmpty");
		}
		
		else if (Sequence_DoStepAndWait(15))
		{
			Sound_Stop("airlock_bubbles_*", 3);
			ParticleSystem_Destroy("Airlock1UWParticles_*");
			
			LiquidArea_MoveLinearTo("Airlock1Water","Airlock1Water_Target",0.1, 0.5, 0.5, false);

			AirlockEffectsFlushWater();
		}
		
		else if (Sequence_DoStepAndWait(6))
		{
			Prop_RotateToSpeed("AirlockWarningLamp", 5, 0, cVector3f(0, 1, 0), true, "");
			Lamp_SetLit("AirlockWarningLamp", false, true);
			Map_RemoveTimer("AirlockAlarm");
			Sound_FadeGlobalVolume(1.0, 3.0f);
		}
		
		else if (Sequence_DoStepAndWait(0))
		{
			PreloadChangeOfMap();
		}
		
		Sequence_End();
	}
			
	//-------------------------------------------------------
	
	void AirlockAlarmEmpty(const tString &in asTimer)
	{
		Sound_CreateAtEntity("Intro_AirlockFlushingAlarm", "Entities_OceanBottom/airlock/alarms/draining_alarm", "AirlockWarningLamp", 0, true);
		Map_AddTimer("AirlockAlarm", 1.0f, "AirlockAlarmEmpty");
	}
	
	//-------------------------------------------------------
	
	void CollideLiquidAirlock(int alState)
	{
		cLux_AddDebugMessage("WATER CAM COLLISION!");
		
		if(alState == 1)
		{
			Map_SetUnderwater(true);
			Map_SetEnvironmentParticlesActive(true);
			
			Depth_Audio_PlayEnterWater();
			
			Entity_SetActive("AMB_AirlockStart_UW", true);
			Entity_SetActive("AMB_AirlockStart_Air", false);
			
			Light_SetBrightness("AirlockWarningLight", 0.5);
		}
		else
		{
			Effect_DoF_Reset();
			
			PreloadFadeGlobal();
			
			Map_SetUnderwater(false);
			Map_SetEnvironmentParticlesActive(false);
			
			Depth_Audio_PlayLeaveWater();
			
			Entity_SetActive("AMB_AirlockStart_UW", false);
			Entity_SetActive("AMB_AirlockStart_Air", true);
			
			Light_SetBrightness("AirlockWarningLight", 1);
		}
	}
	
	//-------------------------------------------------------

	void AirlockEffectsFlushWater()
	{
		Depth_Audio_AirlockDrainLeadInUW();
		Depth_Audio_AirlockDrainLoopUW();
		Map_AddTimer("AirlockDrainUWStopTimer", 10.f, "AirlockDrainUWStop");
		
		//Sweetener and mixer
		Sound_CreateAtEntity("DrainingSweetenerUW", "04_02_tau_inside/SFX/airlock_start/draining_sweet_uw", "Player", 2.0f);
		Sound_FadeGlobalVolume(0.7, 3.0f);
	}
 
	//-------------------------------------------------------
	
	void AirlockDrainUWStop(const tString &in asTimer)
	{
		Sound_Stop("PumpUW", 0.55f);
		Sound_CreateAtEntity("PumpingAirLoop", "Entities_OceanBottom/airlock/air/pump/pump_loop_nointro", "PumpsSource_Start", 0.55f, false, 1.0f);
		
		Depth_Audio_AirlockDrainLoopUWStop();
		Depth_Audio_AirlockDrainLoopAir();
		
		Map_AddTimer("AirlockDrainingAirStopTimer", 5.0f, "AirlockDrainingAirStop");
		Map_AddTimer("AirlockSpotUpdate", 1.0f, "AirlockStartingSpotUpdate");
		
		//Sweetener
		Sound_CreateAtEntity("DrainingSweetenerAir", "04_02_tau_inside/SFX/airlock_start/draining_sweet_air", "Player");
		Sound_Stop("DrainingSweetenerUW", 2.0f);
	}
	 
	//-------------------------------------------------------
	
	void AirlockDrainingAirStop(const tString &in asTimer)
	{
		Depth_Audio_AirlockDrainLoopAirStop();
		Depth_Audio_AirlockDrainLeadOutAir();
		
		Sound_Stop("PumpingAirLoop", 0.25f);
		
		Sound_CreateAtEntity("PumpAirLeadOut", "Entities_OceanBottom/airlock/air/pump/pump_end", "PumpsSource_Start", 0.0f, false, 1.0f);
		Sound_CreateAtEntity("PumpAirIdle", "Entities_OceanBottom/airlock/air/pump/idle_loop", "PumpsSource_Start", 0.0f, false, 1.0f);
	}
	
	void AirlockStartingSpotUpdate(const tString &in asTimer)
	{
		Sound_Play("startairlockwaterspot", 1.0f);
	}
	
	//-------------------------------------------------------
		
	void SetDoorButtonsLocked(const tString &in asDoor, bool abState, bool abEffects=true)
	{
		int lDoorIndex = cString_GetNumericSuffixInt(asDoor);
		tString sDoorPrefix = asDoor;
		sDoorPrefix.resize(sDoorPrefix.length()-(""+lDoorIndex).length()-1);
		
		if (Entity_Exists(sDoorPrefix+"Button_1_"+lDoorIndex))
			MovingButton_SetLocked(sDoorPrefix+"Button_1_"+lDoorIndex, abState, abEffects);
		if (Entity_Exists(sDoorPrefix+"Button_2_"+lDoorIndex))
			MovingButton_SetLocked(sDoorPrefix+"Button_2_"+lDoorIndex, abState, abEffects);
	}
	
	//-------------------------------------------------------
		
	void OnGuiLivingAreaDoorStatus(const tString&in asEntityName, float afTimeStep)
	{
		cImGuiTextFrameData text = ImGui_GetDefaultTextFrame();
		text.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
		text.mFontAlign = eFontAlign_Center;
		text.mbUseBackgroundGfx = false;
		
		ImGui_SetTransCategory("04_02_tau_inside");
		
		tString sButton = Entity_GetVarString(asEntityName, "Button");
		
		// Sanity check
		if (sButton=="")
		{
			ImGui_SetTransCategory("");
			text.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.19);
			ImGui_DoTextFrameExt("Panel-Door connection error", 0, 0, 0, text, ImGui_NrmPosGroup(cVector3f(0, 0.15, 0)), ImGui_NrmSizeGroup(1));
			return;
		}
		
		if (MovingButton_IsLocked(sButton))
		{
			text.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.19);
			ImGui_DoTextFrameExt("LivingAreaDoorStatus_Locked", 0, 0, 0, text, ImGui_NrmPosGroup(cVector3f(0, 0.35, 0)), ImGui_NrmSizeGroup(1));
		}
		else
		{
			text.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.19);
			ImGui_DoTextFrameExt("LivingAreaDoorStatus_Unlocked", 0, 0, 0, text, ImGui_NrmPosGroup(cVector3f(0, 0.4, 0)), ImGui_NrmSizeGroup(1));
		}
	}
	
	//-------------------------------------------------------
 
    /////////////////////////////////////////
    // ==============
    // PRELOAD
    // ==============
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	bool PreloadDisabled(bool abCheckIfPreloading = true)
	{
		if(cLux_ScriptDebugOn())
		{
			cLux_AddDebugMessage("PRELOAD DISABLED!"); 
			
			return true;
		}

		if(abCheckIfPreloading == true && Map_IsPreloading() == false)
			return true;
			
		return false;
	}
	
	//-------------------------------------------------------
	
	void Preload()
	{
		if(PreloadDisabled(false)) return;
		
		cLux_AddDebugMessage("Start preloading.");
		Map_Preload("04_02_tau_inside.hpm");
	}
	
	//-------------------------------------------------------
	
	void PreloadDeload()
	{
		if(PreloadDisabled()) return;
		
		Map_Deload("transfer4142");
	}
	
	//-------------------------------------------------------
	
	void PreloadFadeGlobal()
	{
		Map_AddTimer("FadeGlobal", 0, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	
	void PreloadChangeOfMap()
	{
		if(PreloadDisabled()) 
		{
			PreloadManualChangeMap();
			return;
		}
		
		Map_AddTimer("ChangeMap", 0, "PreloadTimer");
		Map_AddTimer("ChangeMapNotReady", 5, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	
	bool mbGlobalCopyCompleted = false;
	void PreloadTimer(const tString &in asTimer)
	{
		////////////////////////////
		//Preload - Change map globals when possible.
		if(asTimer == "FadeGlobal")
		{
			if(mbGlobalCopyCompleted)
			{
				Map_Preset_Fade("Preset4.2", 0.1); 
				return;
			}
			
			mbGlobalCopyCompleted = Map_CopyGlobalSettings(Map_GetPreloadMap(), 0.1);
			
			Map_AddTimer("FadeGlobal", 0.2, "PreloadTimer");
		}

		////////////////////////////
		//Preload - Change map when possible
		if(asTimer == "ChangeMap")
		{
			if(Map_IsPreloadCompleted())
			{
				Entity_SetActive("swingdoor_tau_large_x1", false);
				
				Description_SetForceFading(true);
				Map_ChangeMap("04_02_tau_inside.hpm", "", "transfer4142", "", "");
			}
			else Map_AddTimer("ChangeMap", 0.6f, "PreloadTimer");
		}
		
		if(asTimer == "ChangeMapNotReady")
		{
			Description_Add("02_05_theta_inside", "ScanRoom_Legacy_Loading", 10, false);
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
		}
	}
	
	//-------------------------------------------------------
	
	void PreloadManualChangeMap()
	{
		Map_ChangeMap("04_02_tau_inside.hpm", "PlayerStartArea_1", "", "");
	}
	
	
