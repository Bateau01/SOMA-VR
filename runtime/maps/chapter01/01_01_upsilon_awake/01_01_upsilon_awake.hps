		{
			Music_PlayExt("01_01_aquarium_ambience", true, 0.75, 1.0f, cMath_RandRectf(5, 8), 0.0f, eMusicPrio_BgAmb, true);
		}
		else
		{
			Music_Stop(cMath_RandRectf(5, 8), eMusicPrio_BgAmb);
		}
		return true;
	}
		
	//--------------------------------------------------------------------	
	
	bool mbDatamineCompleteMusicTriggered = false;
	void DatamineCompleteMusic(const tString &in asEntity)
	{
		if(mbDatamineCompleteMusicTriggered == false)
		{
			Music_Stop(5.0f, eMusicPrio_MinorEvent);
			Music_Play("01_01_awaken", 0.45f, false, eMusicPrio_BigEvent);
			
			Map_AddTimer("StopAmbientMusicQuickly",1.0f, "AmbientMusicHandler");
			//ambient start timer slightly delayed to stop from "stopambientmusicquickly" call from killing the timer
			Map_AddTimer("StartAmbientTimerPostDatamine", 3.0f, "StartAmbientTimerPostDatamine");
			Map_RemoveTimer("LeaveStartRoomMusic");
			
			mbIsLightsOnMusicPlaying = false;
			mbDatamineCompleteMusicTriggered = true;
			
			cLux_AddDebugMessage("Ambient Music State is "+mbAmbientMusicPlaying);
			
		}
	}
	
