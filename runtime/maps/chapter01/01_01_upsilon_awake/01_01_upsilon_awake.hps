	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceDoorDrained;
	void SequenceDoorDrained(const tString &in asName)
	{
		Sequence_Begin("SequenceDoorDrained", mSequenceDoorDrained);
		
		tString sLampName = "";
		
		if (Sequence_DoStepAndWait(1.0f))
		{
			Entity_CallEntityInteract("exithatch_panel_locked");
		
			//Delay for sound 
			
			// activate blue robot light entity
			//Entity_SetActive("GlimpseRobot_FinalHatch",true);
			//Entity_SetEffectsActive("GlimpseRobot_FinalHatch",false,false);
		}
		else if (Sequence_DoStepAndWait(1.0f))
		{
			Entity_SetActive("exithatch_panel_locked",false);
			Entity_SetActive("exithatch_panel",true);
			
			Sound_CreateAtEntity("talkingdoordeathsweet","01_01_upsilon_awake/sfx/talking_door/death_sweet","TalkingDoorVoiceSource");
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			sLampName = "electrical_lamp_small_64";
			Lamp_SetLit(sLampName,false,true);
			Sound_CreateAtEntity("talkingdoordeath","01_01_upsilon_awake/sfx/talking_door/death","TalkingDoorVoiceSource");
			
			Lamp_SetLit("SentientDoor_Speaker_*",false,true);
			
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			sLampName = "electrical_lamp_small_66";
			Lamp_SetLit(sLampName,false,true);
			
			Entity_SetEffectsActive("GlimpseRobot_FinalHatch",true,true);
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			sLampName = "electrical_lamp_small_65";
			Lamp_SetLit(sLampName,false,true);
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			sLampName = "electrical_lamp_small_62";
			Lamp_SetLit(sLampName,false,true);
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			sLampName = "electrical_lamp_small_63";
			Lamp_SetLit(sLampName,false,true);
			Lamp_SetLit("SentientDoor_Speaker_2",false,true);
			
			
		}
		else if (Sequence_DoStepAndWait(1.5f))
		{
			//Entity_CallEntityInteract("exithatch_panel_locked");		
		
			
		}
		else if (Sequence_DoStepAndWait(3.0f))
		{
		
		}
		else if (Sequence_DoStepAndWait(0.5f))
		{	
			//Entity_SetEffectsActive("GlimpseRobot_FinalHatch",false,true);
			//Prop_MoveLinearTo("GlimpseRobot_FinalHatch","GlimpseRobot_FinalHatch_1",2.0f,10.0f,0.1f,true,"");
		}
		Sequence_End();
	}
	
