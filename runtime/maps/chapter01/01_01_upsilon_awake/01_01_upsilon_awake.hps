	//{///////////////////////////////////////

	//-------------------------------------------------------
	
	bool mbInfectedRobotAwakened = false;
	
	//-------------------------------------------------------

	/////////////////////////////////////////
	// Scene 2 *Enter Hall - Power Down*
	/////////////////////////////////////////

	//-------------------------------------------------------
	bool mbPowerDownSoundsPlayed = false;
	//-------------------------------------------------------
	
	bool Trigger_EnterHall(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		/////////////////////////////////////////
		// Power goes out suddenly
		Lamp_SetLit("lamp_dynamic_*",false,true);
		Entity_SetEffectsActive("tech_dynamic_*",false,true);
		
		TechroomLightsOff();
		mbBlackoutOccurred = true;
		
		Map_AddTimer("", 2.0f, "Timer_HintSneak");
		
		//Button_SetSwitchedOn("panel_techroom_power",false,true);
		//Button_SetDisabled("panel_techroom_power",true,true);
		Player_SetAmbientLight_Indoors(true);
		LensFlare_SetVisible("LensFlare_5",false);
		
		//////////////////////////////////////////
		// Sounds and music
		if (mbPowerDownSoundsPlayed == false)
		{
			Sound_CreateAtEntity("LightsOutEvent", "01_01_upsilon_awake/sfx/lights_out_event", "Player");
			Sound_PreloadGroup("Player/UI", true);
			Depth_Audio_Fear_MediumIntensity();
			Entity_SetActive("AMB_HallSpace_1", false);
			Entity_SetActive("AMB_HallSpace_NoGenerator", true);
			
			Map_AddTimer("PostLightsOutMusic", 0.5f, "PostLightsOutMusic");
			Map_AddTimer("StopAmbientMusicQuickly", 1.0f, "AmbientMusicHandler");
			Sound_Stop("generator_1", 0.15f);
			Sound_Stop("generator_2", 0.15f);
			mbAmbientSecondStage = true;
			mbPowerDownSoundsPlayed = true;
		}
		
		return false;
	}
	
	void Timer_HintSneak(const tString &in asTimer)
	{
		Hint_ShowHint("Hints", "HintSneak", true);
	}
	
