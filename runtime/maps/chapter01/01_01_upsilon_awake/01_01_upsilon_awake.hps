	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// Scene 1 - Break Window (and get hint)
	//////////////////////////////////////////
	
	//-------------------------------------------------------
	
	int mlWindowBreaks = 0;
	
	//--------------------------------------------------------
	
	void OnBreakWindow(const tString &in asEntity)
	{
		++mlWindowBreaks;
		cLux_AddDebugMessage("breaks : " + mlWindowBreaks);
		if (mlWindowBreaks == 1)
		{
			
			Entity_SetActive("tech_room_window_1",false);
			Entity_SetActive("tech_room_window_indestructable",true);
			ParticleSystem_CreateAtEntity("01_01_break_window_damaged","01_01_break_window_damaged.ps","WindowCrackEffectArea",false);
			
			DebugMyParticle("01_01_break_window_damaged", "tech_room_window_indestructable");
			
			Map_AddTimer("timer_swapwindow",0.75f,"TimerSwapWindow");
			Sound_CreateAtEntity("WindowCrack", "01_01_upsilon_awake/sfx/window_smash/glass_crack", "WindowSoundSource");
			OpeningWindowSmashMusic();
			
			
		}
		if (mlWindowBreaks == 2)
		{
			Entity_SetActive("tech_room_window_2",false);
			Entity_SetActive("tech_room_window_3",true);
			ParticleSystem_CreateAtEntity("01_01_break_window","01_01_break_window.ps","WindowCrackEffectArea",false);
			Sound_CreateAtEntity("WindowCrack", "01_01_upsilon_awake/sfx/window_smash/glass_smash", "WindowSoundSource");
			Entity_SetActive("AreaJumpHint",true);
		}
	}
	
	//--------------------------------------------------------
	
	void TimerSwapWindow(const tString &in asTimer)
	{
		Entity_SetActive("tech_room_window_indestructable",false);
		Entity_SetActive("tech_room_window_2",true);
		
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaJumpHint(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		Hint_ShowHint("Hints","HintJump",true);
		return true;
	}
	
