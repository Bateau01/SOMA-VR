		{
			Entity_SetActive("AreaLookAtRoom",false);
			Entity_SetActive("AreaStartCollapse_*",false);
			//Player_FadeMoveSpeedMulTo(1.0f,1.0f);
			//CameraAnimation_Begin("CollapseAnim","",true);
			//SequenceCollapse("");
			SequenceReactToEnvironment("");
			Voice_Play("1B_PowerOn_BeforeCollapse",-1,"OnCommentEnvironment");
			
		}
	}
	
