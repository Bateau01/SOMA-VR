	bool CollideAreaEnterTunnel(const tString &in asParent, const tString &in asChild, int alState)
	{
		
		Sound_FadeGlobalVolume(0.85f, 3.0f, eSoundEntryType_WorldAll);
		Music_Play("01_01_reveal", 0.4f, false, eMusicPrio_BigEvent);
		
		Map_AddTimer("MusicAquariumActive", 32.0f, "SetAquariumMusicActive");
		Map_AddTimer("FadeUpReveal", 12.0f, "FadeUpReveal");
		//Map_AddTimer("CloseAquariumDoor", 3.0f, "CloseAquariumDoor");
		mbPlayerEnteredTunnel = true;
		
		DisableScreenEffects();
		
			
		return false;
	}
		
