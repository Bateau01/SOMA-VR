	//-------------------------------------------------------
	
	void SetupVentSpooks()
	{
		//////////////////////////////////////
		// The vent that the construct escapes through
		Entity_SetActive("robot_escape_hatch_closed",true);
		Entity_SetActive("robot_escape_hatch_item_*",false);
		Entity_PlayAnimation("robot_escape_hatch_closed","closed_state",0.0f,true);
		
		/////////////////////////////////////
		// Turn off lights for the overhead vent event
		//Light_SetVisible("LightVentFlicker",false);
		Light_SetVisible("LightVentFlicker_2",false);
		
		////////////////////////////////////
		//Disable sparks unless player enters area to stop sound from leaking
		Light_SetFlickerActive("PointLight_247", false);
		Light_SetFlickerActive("PointLight_243", false);
		
	}
	
	bool Trigger_RobotBehindStorageDoor(const tString &in asParent, const tString &in asChild, int alState)
	{
		Sound_CreateAtEntity("RobotBehindDoor", "01_01_upsilon_awake/sfx/construct_behind_door", "RobotBehindDoorSoundSource");
		return false;
	}
	
	//-------------------------------------------------------
	
	void StartRoomDoorStateChange(const tString &in asEntity, int alState)
	{
		if(alState == 1)
		{
			Music_Stop(3.0f, eMusicPrio_MinorEvent);
			Map_AddTimer("EndLightsOnMusicShort", 1.0f, "EndLightsOnMusic");
			Map_RemoveTimer("EndLightsOnMusic");
		}
		cLux_AddDebugMessage("Start door state is "+alState);
	}
	
	///////////////////////////////////
	// Leaving the Tech Room
	bool CollideAreaLeaveTechRoom(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		//Slight delay for players to get bearings
		Map_AddTimer("LeaveStartRoomStinger", 1.0f, "LeaveStartRoomStinger");
		Map_AddTimer("LeaveStartRoomMusicOver", cMath_RandRectf(33.5f,36.0f), "LeaveStartRoomMusic");
		
		/////////////////////////////////
		// Activate necessary areas
		//Entity_SetActive("AreaGlimpseFenceEvent",true);
		
		/////////////////////////
		// Start Preload early
		cLux_AddDebugMessage("Preloading begins here");
		Preload();
		
		return false;
	}
	
	void LeaveStartRoomStinger(const tString &in asTimer)
	{
		Music_Play("02_08_thetastart", 0.4f, false, eMusicPrio_BigEvent);
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////
	// Sounds in maintenance hatch
	/////////////////////////////////
	
	//-------------------------------------------------------
	
	bool CollideAreaSpookVent(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbInfectedRobotReleased == false) return true;
		
		cLux_AddDebugMessage("SOUND: Something crawling in the vent..");
		
		Entity_SetActive("GlimpseMaintenanceVentBroken_Start",true);
		Sound_CreateAtEntity("sfx_ventcrawl","01_01_upsilon_awake/sfx/construct_vent/construct_vent","sfx_ventcrawler");
		
		
		Prop_AlignRotation("GlimpseMaintenanceVentBroken_Start","GlimpseMaintenanceVentBroken_Mid",2.0f,2.0f,0.0f,false,"");
		Map_AddTimer("timer_ventlight",2.0f,"TimerVentLightDisappear");
	
		
		return false;
	}
	
	//-------------------------------------------------------
	
	void TimerVentLightDisappear(const tString &in asTimer)
	{
		Prop_AlignRotation("GlimpseMaintenanceVentBroken_Start","GlimpseMaintenanceVentBroken_End",2.0f,2.0f,0.0f,false,"");	
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////
	// Collapsing Vent Event
	////////////////////////////////
	
	//-------------------------------------------------------
	bool mbVentScareAllowed = false;
	bool mbVentCanHurt = true;
	//-------------------------------------------------------
	
	bool BackAreaSparksHandler(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState == 1)
		{
			Light_SetFlickerActive("PointLight_247", true);
			Light_SetFlickerActive("PointLight_243", true);
			Sound_Stop("sparks_area_1", 1.0f);
			cLux_AddDebugMessage("back area sparks active");
		}
		else
		{
			Light_SetFlickerActive("PointLight_247", false);
			Light_SetFlickerActive("PointLight_243", false);
			Sound_Play("sparks_area_1", 1.0f);
			cLux_AddDebugMessage("back area sparks disabled");
		}
		return true;
	}
		
	//-------------------------------------------------------
	
	bool CollideAreaVentScare(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState < 1) return true;
		if (mbVentScareAllowed == false) return true;
		
		cLux_AddTodoMessage("SCRIPT: Some event here to make this less monotonous");
		
		////////////////////////////////
		// Begin Shaking
		//Effect_Shake_Start(0.0125f,3.0f,0.0f,1.0f);
		
		ParticleSystem_CreateAtEntity("ps_ventdust_1","dust_falling_fast_small_oneshot.ps","VentEffectArea",true);
			
		Sound_CreateAtEntity("VentScare","01_01_upsilon_awake/sfx/vent_scare/vent_scare_event","AreaVentSoundSource",0.0f,false,1.0f);
		Map_AddTimer("StopAmbientMusicQuickly", 1.0f, "AmbientMusicHandler");
		Lamp_SetFlickerActive("Lamp_Hallway_OutsideKitchen",true);
		
		///////////////////////////////
		// Activate blue lights
		Entity_SetActive("GlimpseMaintenanceVent_Start",true);
		
		Light_SetVisible("LightVentFlicker",true);
		Light_SetVisible("LightVentFlicker_2",true);
		
		//Map_AddTimer("timer_GlimpseMaintenanceVent",2.75f,"TimerSearchWithRobotLights");
		Map_AddTimer("timer_ventfall",1.25f,"TimerVentFall");
		Map_AddTimer("timer_GlimpseMaintenanceVent",2.75f,"SequenceSearchLight");
		
		////////////////////////////////
		// Disable all areas related to this scare
		Entity_SetActive("AreaVentScare*",false);
		return false;
	}
	
	//-------------------------------------------------------
	
	void TimerRemoveRobotLights(const tString &in asTimer)
	{
		//Entity_SetActive("GlimpseMaintenanceVent_Start",false);
		Entity_SetActive("AreaRemoveVentLights",false);
		Prop_MoveLinearTo("GlimpseMaintenanceVent_Start", "GlimpseMaintenanceVent_End", 5, 2, 0, true);

		Light_FadeTo("LightVentFlicker",cColor(0,0,0,0),0.0f,1.5f);
		Light_FadeTo("LightVentFlicker_2",cColor(0,0,0,0),0.0f,1.5f);
		
		Prop_AlignRotation("GlimpseMaintenanceVent_Lower","GlimpseMaintenanceVent_Lower_Left",5,2,0,false,"");
		Prop_MoveLinearTo("GlimpseMaintenanceVent_Lower", "GlimpseMaintenanceVent_End", 5, 2, 0, true);
		
		///////////////////////////////////////
		// Also fade out the lights from the robot
		Entity_SetEffectsActive("GlimpseMaintenanceVent_Start",false,true);
		Entity_SetEffectsActive("GlimpseMaintenanceVent_Lower",false,true);
	}
	
	//-------------------------------------------------------
	
	void TimerVentFall(const tString &in asTimer)
	{
		Effect_Shake_Start(0.05f,0.75f,0.0f,0.25f);
		Prop_SetStaticPhysics("hatch_scare_1",false);
		ParticleSystem_CreateAtEntity("steam_fast_loop_vent","steam_fast_loop.ps","VentEffectArea",true);
		ParticleSystem_CreateAtEntity("steam_fast_loop_vent","steam_fast_loop.ps","VentEffectArea_1",true);
		Sound_Play("vent_scare_steam_*", 1.0f);
		Map_AddTimer("timer_removeventhurt",0.75f,"RemoveVentDamage");
		
		//Audio
		Map_AddTimer("VentScareMusic", 2.0f, "VentScareMusic");
		Sound_FadeGlobalVolume(0.25, 0.1);
		Map_AddTimer("FadeUpAfterVent", 5.0f, "FadeUpAfterVent");
	}
	
	void FadeUpAfterVent (const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 11.0f);
	}
	
	void VentScareMusic (const tString &in asTimer)
	{
		Music_Play("01_01_doorscare", 0.65f, false, eMusicPrio_BigEvent);
		Depth_Audio_Fear_MediumIntensity(12.0f, 20.0f, 5, false, true);
		Map_AddTimer("PostVentScareMusic", 6.0f, "PostVentScareMusic");
	}
	
	void PostVentScareMusic (const tString &in asTimer)
	{
		Map_AddTimer("StartAmbient", cMath_RandRectf(5.0f,8.0f), "AmbientMusicHandler");
		Music_Play("NPC_construct_react3", 0.45f, false, eMusicPrio_BigEvent);
		Entity_SetActive("AreaPostVentScareSound", true);
	}
	
	bool PostVentScareSound(const tString &in asParent, const tString &in asChild, int alState)
	{
		Sound_CreateAtEntity("PostVentScare","01_01_upsilon_awake/sfx/vent_scare/vent_scare_post_movement","AreaVentSoundSource",0.0f,false,1.0f);
		return false;
	}
	//-------------------------------------------------------
	
	cSequenceStatesData mSearchlightSequence;
	void SequenceSearchLight(const tString &in asName)
	{
		Sequence_Begin("SequenceSearchLight", mSearchlightSequence);


		if (Sequence_DoStepAndWait(0.1f))
		{
			Prop_MoveLinearTo("GlimpseMaintenanceVent_Start", "GlimpseMaintenanceVent_Search_1", 5, 2, 0, true);
			Entity_SetActive("GlimpseMaintenanceVent_Lower",true);
		}
		else if (Sequence_DoStepAndWait(1.0f))
		{
			Prop_AlignRotation("GlimpseMaintenanceVent_Lower","GlimpseMaintenanceVent_Lower_Left",5,2,0,false,"");
		}
		else if (Sequence_DoStepAndWait(0.75f))
		{
			Prop_MoveLinearTo("GlimpseMaintenanceVent_Start", "GlimpseMaintenanceVent_Search_2", 5, 2, 0, true);
		}
		else if (Sequence_DoStepAndWait(1.0f))
		{
			Prop_AlignRotation("GlimpseMaintenanceVent_Lower","GlimpseMaintenanceVent_Lower_Right",5,2,0,false,"");
		}
		else if (Sequence_DoStepAndWait(0.75f))
		{
			CollideAreaRemoveVentLights("","",1);
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	void RemoveVentDamage(const tString &in asTimer)
	{
		////////////////////////////
		// Disable area attached to vent so it no longer hurts the player when falling
		mbVentCanHurt = false;
		Entity_SetActive("AreaVentHurtPlayer",false);
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaVentHurtPlayer(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1 && mbVentCanHurt && mbVentScareAllowed)
		{
			Player_GiveDamage(0.1f,0.1,eDamageType_Hit,"hatch_scare_1");
			return false;
		}
		
		return true;
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaRemoveVentLights(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		///////////////////////////////////////////////
		// Robot automatically retreats if the player gets too close so we dont see the trick
		Map_RemoveTimer("timer_GlimpseMaintenanceVent");
		
		Map_AddTimer("GlimpseMaintenanceVent",0.1f,"TimerRemoveRobotLights");
		return false;
	}
	
	//-------------------------------------------------------
	
	//////////////////////////////////
	// Items fall off the shelves in robot repair
	/////////////////////////////////
	
	//-------------------------------------------------------
	
	bool CollideAreaSetupShelfScare(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
		{
			Entity_SetActive("AreaLookatShelfScare*",true);
			return false;
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	void AreaLookatShelfScare_OnPlayerLookAt(const tString &in asEntity, int alState)
	{
		Entity_SetActive("AreaLookatShelfScare*",false);
		
		/////////////////////////////
		// Add forces to nearby grab objects
		
		Entity_AddImpulseFromEntity("maintenance_robot_part_arm_upper_5","ForceAreaShelfScare_2",50.0f,true);
		Entity_AddImpulseFromEntity("maintenance_robot_part_arm_upper_4","ForceAreaShelfScare_2",50.0f,true);
		Entity_AddImpulseFromEntity("maintenance_robot_part_head_2","ForceAreaShelfScare_2",50.0f,true);
		Entity_AddImpulseFromEntity("maintenance_robot_part_head_1","ForceAreaShelfScare_2",50.0f,true);
		
		Entity_AddImpulseFromEntity("maintenance_robot_part_arm_lower_2","ForceAreaShelfScare_1",50.0f,true);
		Entity_AddImpulseFromEntity("cable_roll_7","ForceAreaShelfScare_1",50.0f,true);
		Entity_AddImpulseFromEntity("blowtorch_3","ForceAreaShelfScare_1",50.0f,true);
		
		
	}
	
