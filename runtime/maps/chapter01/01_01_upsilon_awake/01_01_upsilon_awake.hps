	//-------------------------------------------------------
	
	bool mbFencesBroken = false;
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// Robot breaks down fences when player has returned to tech room
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	void RobotBreaksFences()
	{
		////////////////////////////
		// Prevent this from running multiple times (it can be triggered in a few ways)
		if (mbFencesBroken) return;
		mbFencesBroken = true;
		
		Entity_SetActive("RobotLights_Fences",true);
		Entity_SetEffectsActive("RobotLights_Fences",false,false);
		
		
		
		SequenceFenceBreak("");
	}
	
	
	
	//-------------------------------------------------------
	
	cSequenceStatesData mFenceBreakSequence;
	
	void SequenceFenceBreak(const tString &in asName)
	{
		Sequence_Begin("SequenceFenceBreak", mFenceBreakSequence);

		if (Sequence_DoStepAndWait(0.5f))
		{
			//cLux_AddTodoMessage("SOUND: Robot monster is breaking down the fence doors! (May happen in a few locations)");
			Sound_CreateAtEntity("sfx_fencesmash","01_01_upsilon_awake/sfx/fence_smash/construct_fence_smash","AreaDoorPoundEffect");
			Map_AddTimer("StopAmbientMusicQuickly",1.0f, "AmbientMusicHandler");
			Entity_SetEffectsActive("RobotLights_Fences",true,true);
			Entity_SetActive("fencedoor_breakdown_*",false);
			Entity_SetActive("fencedoor_busted_*",true);
		}
		else if (Sequence_DoStepAndWait(0.5f))
		{
			Sound_FadeGlobalVolume(0.65f, 0.1f);
		}
		else if (Sequence_DoStepAndWait(5.0f))
		{
			Prop_AlignRotation("RobotLights_Fences", "RobotLights_Fences_End",0.5,0.5,0.25f,true);
			Prop_MoveLinearTo("RobotLights_Fences", "RobotLights_Fences_End", 1, 1, 0.25, true, "");	
			Sound_FadeGlobalVolume(1.0f, 4.0f);
			Music_Play("01_01_construct_smashing_about", 0.45f, false, eMusicPrio_BigEvent);
		}
		else if (Sequence_DoStepAndWait(1.0f))
		{
			Entity_SetEffectsActive("RobotLights_Fences",false,true);
			Entity_SetActive("DoorSmashMusicStinger_*", true);
			Map_AddTimer("StartAmbient", cMath_RandRectf(3.0f,8.0f), "AmbientMusicHandler");
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// PRELOADING
	/////////////////////////////////////////

	//-------------------------------------------------------

	bool PreloadDisabled(bool abCheckIfPreloading = true)
	{
		if(cLux_ScriptDebugOn())
		{
			cLux_AddDebugMessage("PRELOAD DISABLED!"); 
			
			return true;
		}
		
		if(abCheckIfPreloading && Map_IsPreloading() == false)
			return true;
			
		return false;
	}
	
	//-------------------------------------------------------
	
	//////////////////////
	//Begin preload.
	void Preload()
	{
		if(PreloadDisabled(false))
		{
			cLux_AddDebugMessage("Preload is disabled");
			return;	
		}
		
		Map_Preload("01_02_upsilon_inside.hpm");
	}
	
	//-------------------------------------------------------
	
	//////////////////////
	//Change preload prio to high
	void PreloadPriorityHigh()
	{
		if(PreloadDisabled()) return;
		
		Map_SetPreloadPriority(eWorldStreamPriority_High);
	}
		
	//-------------------------------------------------------
	
	//////////////////////
	//Deload rest of level except end room and maintenence access
	void PreloadPreDeload()
	{
		if(PreloadDisabled()) return;
		
		Map_Deload("PreTransfer0102");
	}
			
	//-------------------------------------------------------
	
	////////////////////////
	//Fade presets and begin final deload and fade of globals from next level.
	void PreloadBeginChangeOfMap()
	{
		if(PreloadDisabled()) 
		{
			PreloadManualChangeMap();
			return;
		}
		
		//////////////////////
		// Prevent the player from jumping out from vent while level is unloading
		Entity_CreateAtEntity("VentBlocker","block_box_static.ent","ClimbArea_1",false);
		
		Map_Preset_Fade("Inside1_2", 2);
		Map_AddTimer("PrioChange", 2, "PreloadTimer");
		Map_AddTimer("FadeGlobal", 2.1, "PreloadTimer");
		Map_AddTimer("ChangeMap", 5, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	bool mbGlobalCopyCompleted = false;
	
	void PreloadTimer(const tString &in asTimer)
	{
		////////////////////////////
		//Preload - Deload all but last area and up stream prio further.
		if(asTimer == "PrioChange") Map_Deload("Transfer0102");
		
		////////////////////////////
		//Preload - Change map globals when possible.
		if(asTimer == "FadeGlobal")
		{
			if(mbGlobalCopyCompleted) return;
			
			mbGlobalCopyCompleted = Map_CopyGlobalSettings(Map_GetPreloadMap(), 0.5);
			
			Map_AddTimer("FadeGlobal", 0.6, "PreloadTimer");
		}
		
		////////////////////////////
		//Preload - Change map when possible
		if(asTimer == "ChangeMap")
		{
			if(Map_IsPreloadCompleted())
			{
				Description_SetForceFading(true);
				Map_ChangeMap("01_02_upsilon_inside.hpm", "", "Transfer0102", "", "");
			}
			else Map_AddTimer("ChangeMap", 0.5f, "PreloadTimer");
		}
		
	}
	
	//-------------------------------------------------------
	
	///////////////////
	//Lock player if he gets this far. Either because slow computer or loaded a saved game or ran here very fast or a combination.
	void PreloadLastResort()
	{
		if(PreloadDisabled())
		{
			cLux_AddDebugMessage("LOADING USING NO TRANSITION AT LOCATION WHERE TRANSITION WOULD AT THE LATEST NORMALY OCCUR3."); 
			
			PreloadManualChangeMap();
			
			return;
		}
		
		if(Map_IsPreloadCompleted()) return;
		
		Player_SetMoveSpeedMul(0);
		Description_Add("02_05_theta_inside", "ScanRoom_Legacy_Loading", 20, false);
		
		Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
	}
	
	//-------------------------------------------------------
	
	//////////////////////
	//Manually load next level if preload fails,  preload disabled.
	void PreloadManualChangeMap()
	{
		Map_ChangeMap("01_02_upsilon_inside.hpm", "PlayerStartArea_1", "", "");
	}
	
	//-------------------------------------------------------

	//} END PRELOADING
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// ==============
	// TERMINALS
	// ==============
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	//-------------------------------------------------------

	/////////////////////////////////////////
	// Terminal *TECH ROOM TERMINAL*
	//{//////////////////////////////////////

	//-------------------------------------------------------

	bool mbTerminalsUnlocked = false;
	bool mbOrientationVideoPlaying = false;
	int mlOrientationSlide = 1;
	int mlOrientationGraphic = 0;

	//-------------------------------------------------------

	void TechTerminal_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("01_01_upsilon_awake");
		
		///////////////
		// Data
		cImGuiButtonData buttonData = StationGui_CreateDefaultButtonData();
		ImGui_SetDefaultButton(buttonData);
		
		cImGuiLabelData labelData;
		labelData.mFont.mvSize = cVector2f(20);
		ImGui_SetDefaultLabel(labelData);
		
		cImGuiTextFrameData textFrame = ImGui_GetDefaultTextFrame();
		textFrame.mColorBase = cColor(0,0,0,0);
		ImGui_SetDefaultTextFrame(textFrame);
		
		///////////////
		// Ornaments
		StationGuiBG_Backdrop("background/background_logo_pathosstation", cVector2f(0.05, 0.05), 0.75);
		StationGuiBG_Scanlines();
		
		////////////////////////////////
		// Terminal locked message
		if (mbTerminalsUnlocked == false && mbOmniToolInserted == false)
		{
			StationGui_BigStatusMessage_Old("TechTermLocked", gStationGuiColor_Warning, 0.875);
			return;
		}
		
		////////////////////////////////
		// Show loading bar for configuration chip
		if (mbOmniToolInserted == true && ImGui_GetStateBool("Unlocked",false) == false)
		{
			if (StationGui_LoadingWindow("ScanningWindow", "ScanningWindow", "ScanningTool", 7.0f, true))
			{
				ImGui_SetStateBool("Unlocked", true);
				mbTerminalsUnlocked = true;
				
				///////////////////////////////////
				// Onboard Jane Quips
				cLux_AddDebugMessage("Jane Quip");
				Voice_SetSource("HelperJane","cath_terminal_1",1.0f,12.0f,true);
				Voice_Play("HelperJanePlugin");
			}
			return;
		}
		
		if (StationGui_DrawAndCheckErrors()) return;
		
		tString sSystemStatusButtonText = "SystemStatus";
		tString sSuitStatusButtonText = "SuitStatusButton";		
		/*if (mbRobotDestroyedTechRoom)
		{
			sSystemStatusButtonText = "CorruptSystemStatus";
			sSuitStatusButtonText = "CorruptSuitStatus";
		}*/
		
		bool bBackButtonEnabled = true;
		int lBackState = eTechTerminalState_MainMenu;
		int lActiveApp = StationGui_GetActiveApp(eTechTerminalState_MainMenu);
		int lSecuritySelection = -1;
		switch(lActiveApp)
		{
			
			case eTechTerminalState_MainMenu:
			StationGui_AddApp(sSystemStatusButtonText, true, eTechTerminalState_SystemStatus);
			StationGui_AddApp("CorruptWauButton", true, eTechTerminalState_WauText);
			StationGui_AddApp("OmniToolButton", true, eTechTerminalState_OmniToolMain);
			StationGui_AddApp(sSuitStatusButtonText, true, eTechTerminalState_SuitStatus);
			StationGui_MainMenu();
			
			bBackButtonEnabled = false;
			break;
			
			case eTechTerminalState_SystemStatus:
			StationGui_TextReaderSingle(sSystemStatusButtonText, "TechTermSystemStatus");
			break;
			
			case eTechTerminalState_WauText:
			StationGui_TextReaderSingle("CorruptWauButton", "UikadsScanas");
			break;
			
			case eTechTerminalState_OmniToolMain:
			StationGui_AddApp("ButtonToolChipSetup", true, eTechTerminalState_OmniToolChipSetup);
			StationGui_AddApp("ButtonBrainChipSetup", true, eTechTerminalState_OmniToolBrainSetup);
			StationGui_AddApp("ButtonChipContainer_Open", ImGui_GetStateBool("ChipContainerClosed", true), false);
			StationGui_AddApp("ButtonOrientationVideo", true, eTechTerminalState_OmniToolOrientationVideo);
			lSecuritySelection = StationGui_MainMenu();
			if (lSecuritySelection==2)
			{
				ImGui_SetStateBool("ChipContainerClosed", false);
				
				/////////////////////////////////////
				// Security chip door should open now
				Map_AddTimer("timer_openchipcontainer",1.05f,"TimerOpenChipContainer");
				Sound_CreateAtEntity("ChipDoorOpen", "01_01_upsilon_awake/sfx/omnitool/chip_door_open", "ChipContainer_Door");
			}
			else if (lSecuritySelection==3)
			{
				BeginOrientationSlideShow();
				ImGui_SetStateInt("CurrentSlide",1);
				ImGui_SetStateFloat("SlideTimer", 0.0f);
			}
			
			break;
			
			case eTechTerminalState_OmniToolChipSetup:
			TechRoomTerminalOmniToolRegularSetup();
			lBackState = eTechTerminalState_OmniToolMain;
			break;
			
			case eTechTerminalState_OmniToolChipInstalling:
			TechRoomTerminalInstallChip();
			bBackButtonEnabled = false;
			break;
			
			case eTechTerminalState_OmniToolBrainSetup:
			TechRoomTerminalOmniToolBrainSetup();
			lBackState = eTechTerminalState_OmniToolMain;
			break;
			
			case eTechTerminalState_SuitStatus:
			StationGui_TextReaderSingle(sSystemStatusButtonText, "SuitStatus");
			break;
			
			case eTechTerminalState_OmniToolOrientationVideo:
			TechRoomTerminalOrientationVideo(afTimeStep);
			lBackState = eTechTerminalState_OmniToolMain;
			break;
		}
		
		StationGuiBG_Taskbar("upsilon");
		if (StationGui_BackButton(bBackButtonEnabled, lBackState))
		{
			mbOrientationVideoPlaying = false;
			Sound_CreateAtEntity("OrientationVideoLoopStop", "01_01_upsilon_awake/sfx/omnitool_orientation/stop", "OrientationVideoSoundSource");
			Sound_Stop("OrientationVideoLoop", 0.25f);
			Sound_Stop("OrientationVideoFoley", 0.25f);
			Voice_Stop(Voice_GetSubjectSceneName("OrientationVideo_1"));
		}
	}
	
	//-------------------------------------------------------
	
	void TechRoomTerminalOmniToolRegularSetup()
	{
		cImGuiTextFrameData textData;
		textData.mFont.mvSize = cVector2f(20);
		textData.mColorBase.a = 0;
		
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		ImGui_DoWindowStart("ButtonToolChipSetup", window, ImGui_NrmPosGroup(0.05, 0.02, 1), ImGui_NrmSizeGroup(0.9, 0.775));
		
		cImGuiTextFrameData frame = StationGui_CreateDefaultTextFrameData();
		
		///////////////////////////////////
		// Display Status of Omni Tool
		tString sOmniToolStatus = mbOmniToolInserted ? "Inserted" : "NotInserted";
		if (mbOmniToolInserted)
			sOmniToolStatus += mbConfigChipInserted ? "WithChip" : "WithoutChip";
		ImGui_DoTextFrameExt("OmniTool"+sOmniToolStatus, cVector2f(3,3), 3.0f, 0, frame, ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.8f)));

		//////////////////////////////////
		// Display Status of Config Chip
		tString sConfigChipStatus = (mbConfigChipInserted&&mbOmniToolInserted) ? "Inserted" : "NotInserted";
		ImGui_DoTextFrameExt("ConfigChip"+sConfigChipStatus, 0, 0, 0, frame, ImGui_NrmPosGroup(cVector3f(0.05, 0.8, 1)), ImGui_NrmSizeGroup(cVector2f(0.5, 1)));		

		//////////////////////////////////
		// Configuration/Install button is greyed out until both components are inserted (above)
		ImGui_SetModUseInput(mbOmniToolInserted && mbConfigChipInserted && mbToolChipAnnounced);
		
		if (ImGui_DoButton("ButtonConfigure","ButtonConfigure", ImGui_NrmPos(cVector3f(0.55, 0.55, 2)), ImGui_NrmSize(cVector2f(0.3, 0.125))))
		{
			cLux_AddTodoMessage("SOUND: BEGIN OMNITOOL CONFIGURATION HERE");
			Sound_PlayGui("Entities_Station/tech/terminal_beeps/terminal_forward",1.0);
			Sound_CreateAtEntity("OmnitoolConfig", "01_01_upsilon_awake/sfx/omnitool/chip_calibrate", "OmniPluggedInSoundSource");
			StationGui_SetActiveApp(eTechTerminalState_OmniToolChipInstalling);
		}
		
		ImGui_SetModUseInput(true);
		
		ImGui_DoWindowEnd();
	}
	
	//-------------------------------------------------------
	
	void TechRoomTerminalOmniToolBrainSetup()
	{
		cImGuiTextFrameData textData;
		textData.mFont.mvSize = cVector2f(20);
		textData.mColorBase.a = 0;
		
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		ImGui_DoWindowStart("ButtonBrainChipSetup", window, ImGui_NrmPosGroup(0.05, 0.02, 1), ImGui_NrmSizeGroup(0.9, 0.775));
		
		cImGuiTextFrameData frame = StationGui_CreateDefaultTextFrameData();	
		
		///////////////////////////////////
		// Display Status of Omni Tool
		tString sOmniToolStatus = mbOmniToolInserted ? "Inserted" : "NotInserted";
		ImGui_DoTextFrameExt("OmniToolBrain"+sOmniToolStatus, cVector2f(3,3), 3.0f, 0, frame, ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.8f)));

		//////////////////////////////////
		// Display Status of Brain Chip
		ImGui_DoTextFrameExt("BrainChip", 0, 0, 0, frame, ImGui_NrmPosGroup(cVector3f(0.05, 0.8, 1)), ImGui_NrmSizeGroup(cVector2f(0.5, 1)));
		
		//////////////////////////////////
		// Configure button ALWAYS greyed out for the brain setup!
		ImGui_SetModUseInput(false);
		ImGui_DoButton("ButtonConfigure","ButtonConfigure", ImGui_NrmPos(cVector3f(0.55, 0.55, 2)), ImGui_NrmSize(cVector2f(0.3, 0.125)));
		ImGui_SetModUseInput(true);
		
		ImGui_DoWindowEnd();
	}
	
	//-------------------------------------------------------
	
	void TechRoomTerminalInstallChip()
	{
		float fProgress = Depth_ImGui_GetLoadingValue("ConfiguringWindow");
		
		////////////////////////////////
		// Show result for configuration chip
		if (fProgress >= 1.0f)
		{
			//cLux_AddTodoMessage("SOUND: END OMNITOOL CONFIGURATION HERE!! (Avoid re-entry with a bool etc as usual - i.e mbSoundPlayed");
			
			StationGui_DialogBox_Start("", "ConfigChipComplete");
			StationGui_DialogBox_End();	
			
			if (ImGui_GetStateBool("ChipEjected",false) == false)
			{
				CathTool_AllowDetach("OmniTool_Configured");
				ImGui_SetStateBool("ChipEjected",true);
				
				///////////////////////////////////
				// Onboard Jane Quips
				cLux_AddDebugMessage("Jane Quip");
				Voice_SetSource("HelperJane","cath_terminal_1",1.0f,12.0f,true);
				Voice_Play("HelperJaneUpdateToolChip");
			}
			
			if (mbOmniToolInserted==false)
			{
				StationGui_SetActiveApp(eTechTerminalState_OmniToolMain);
			}
		}
		
		////////////////////////////////
		// Show loading bar for configuration chip
		else
		{
			StationGui_LoadingWindow("ConfiguringWindow", "ConfiguringWindow", "ConfiguringTool", 5.0f, false);
		}
	}
	
	
	//---------------------------------------------------------
	
	void TechRoomTerminalOrientationVideo(float afTimeStep)
	{
		int lSlide = mlOrientationSlide;
		
		ImGui_DoImage(cImGuiGfx("omnivideo0"+mlOrientationGraphic, eImGuiGfx_Texture), ImGui_NrmPos(0, 0, 2), ImGui_NrmSizeGroup(1, 1.275));
		
		/*if (lSlide > 5)
		{
			//lSlide = 1;
			ImGui_SetStateInt("State",eTechTerminalState_OmniToolMain);
			return;
		}
		
		
		if (lSlide > 0)
		{
			
		}*/
		
		ImGui_SetStateInt("CurrentSlide",lSlide);
	}
	
	//-------------------------------------------------------
	
	void BeginOrientationSlideShow()
	{
		//////////////////////////////
		// Kick off the slide show
		mbOrientationVideoPlaying = true;
		mlOrientationSlide = 1;
		mlOrientationGraphic = 0;
		Sound_CreateAtEntity("OrientationVideoLoopStart", "01_01_upsilon_awake/sfx/omnitool_orientation/start", "OrientationVideoSoundSource");
		Sound_CreateAtEntity("OrientationVideoLoop", "01_01_upsilon_awake/sfx/omnitool_orientation/noise_loop", "OrientationVideoSoundSource");
		Sound_CreateAtEntity("OrientationVideoFoley", "01_01_upsilon_awake/sfx/omnitool_orientation/foley_loop", "OrientationVideoSoundSource");
		Voice_Stop(Voice_GetSubjectSceneName("OrientationVideo_1"));
		Voice_Play("OrientationVideo_1",-1,"NextOrientationSlide");
	}
	
	//-------------------------------------------------------
	
	void NextOrientationSlide(const tString&in asScene, const tString&in asSubject)
	{
		
		
		//////////////////////////////
		// Cycle through each part of the orientation slideshow
		if (mbOrientationVideoPlaying)
		{
			mlOrientationSlide++;
			cLux_AddTodoMessage(":SlideShow:" + mlOrientationSlide);
			if (mlOrientationSlide <= 5)
			{
				Map_AddTimer("timer_nextslide",1.0f,"TimerNextSlide");
			}
		}
	}
	
	//-------------------------------------------------------
	
	void TimerNextSlide(const tString &in asTimer)
	{
		if (mbOrientationVideoPlaying)
		{
			Voice_Play("OrientationVideo_"+mlOrientationSlide,-1,"NextOrientationSlide");
		}
	}
	
	//-------------------------------------------------------
	
	void NextOrientationGraphic(const tString &in asScene, const tString &in asSubject, int alLineIndex, bool abStartOfLine)
	{
		if (abStartOfLine == false) return;
		mlOrientationGraphic++;
	}
	
	//-------------------------------------------------------
	
	void TechRoomTerminalSuitStatus()
	{
		ImGui_GroupBegin(ImGui_NrmPos(cVector3f(0.25, 0.15, 1)), ImGui_NrmSize(cVector2f(0.5, 0.7)));
		ImGui_SetTransCategory("01_01_upsilon_awake");
		
		cImGuiTextFrameData textData;
		textData.mFont.mvSize = cVector2f(20);
		textData.mColorBase.a = 0;
		ImGui_DoTextFrameExt("SuitStatus",cVector2f_Zero,4.0f,0,textData, ImGui_NrmPosGroup(cVector3f(0.05, 0.15, 1)), ImGui_NrmSizeGroup(cVector2f(0.8, 0.8)));
		
		ImGui_GroupEnd();
	}
	
	//-------------------------------------------------------
	
	//} END TECH ROOM TERMINAL

	//-------------------------------------------------------

	/////////////////////////////////////////
	// Terminal *PILOT CHAIR TERMINAL*
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbWauTextSoundPlayed = false;
	
	//-------------------------------------------------------
	
	void StartWauTextSound()
	{
		if (mbWauTextSoundPlayed) return;
		
		Sound_CreateAtEntity("WauText", "01_01_upsilon_awake/amb/spot/scrolling_text_terminal", "ScanChairTerminalSoundSource");
		mbWauTextSoundPlayed = true;
	}
	
	//-------------------------------------------------------
	
	void StopWauTextSound()
	{
		if (!mbWauTextSoundPlayed) return;
		
		Sound_Stop("WauText", 0.15f);
		mbWauTextSoundPlayed = false;
	}
	
	//-------------------------------------------------------
	
	void PilotTerminal_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("01_01_upsilon_awake");
		
		StationGuiBG_Backdrop("background/background_logo_pathOS", cVector2f(0.01, 0.45));
		StationGuiBG_Scanlines();
		
		//////////////////////////////////////
		// Terminals must be unlocked with the omnitool first
		if (mbTerminalsUnlocked == false)
		{
			StationGui_BigStatusMessage_Old("PilotTermLocked", gStationGuiColor_Warning, 0.75);	
			return;
		}
		
		/*if (mbRobotDestroyedTechRoom)
		{
			return;
		}*/
		
		if (StationGui_DrawAndCheckErrors()) return;
		
		bool bBackButtonEnabled = true;
		int lBackState = ePilotTerminalState_MainMenu;
		int lActiveApp = StationGui_GetActiveApp(ePilotTerminalState_MainMenu);
		int lMainMenuSelection;
		switch(lActiveApp)
		{
			case ePilotTerminalState_MainMenu:		
				StationGui_AddApp("PilotControls", true, ePilotTerminalState_Controls);
				StationGui_AddApp("PilotReports", true, ePilotTerminalState_Reports);
				StationGui_MainMenu();
				
				StopWauTextSound();
				bBackButtonEnabled = false;
			break;
			
			case ePilotTerminalState_Controls:
				StationGui_AddApp("PilotControlStatus", true, ePilotTerminalState_WauText); 			//1. status	- show some creepy wau text
				StationGui_AddApp("PilotControlConnect", true, false); 									//2. connect to robot - error message
				StationGui_AddApp("PilotControlPilotStatus", true, false); 								//3. pilot status - no user in place message
				StationGui_AddApp("PilotControlNeocortex", true, false); 								//4. neocortex connection - no user in place message
				StationGui_AddApp("PilotControlConnectStatus", true, false); 							//5. connection status - error message
				lMainMenuSelection = StationGui_MainMenu();
				if (lMainMenuSelection == 1 || lMainMenuSelection == 4)
				{
					StationGui_SetError("PilotError");
				}
				else if (lMainMenuSelection > 0)
				{
					StationGui_SetError("PilotNoUser");
				}
				StopWauTextSound();
			break;
			
			case ePilotTerminalState_Reports:
				////////////////////
				// Reports
				// 1. text - carl feels dizzy during a mission controlling a robot
				// 2. text - a report written by amy that people are starting to refuse to use the pilot seats
				Depth_ImGui_AddTextFile("PilotTerminalFileName_1", "PilotTerminalFile_1");
				Depth_ImGui_AddTextFile("PilotTerminalFileName_2", "PilotTerminalFile_2");
				StationGui_TextReaderMulti();
			break;
			
			case ePilotTerminalState_WauText:
				PilotTerminalWauButton(afTimeStep);
				lBackState = ePilotTerminalState_Controls;
				StartWauTextSound();
			break;
		}
		
		StationGuiBG_Taskbar("upsilon");
		StationGui_BackButton(bBackButtonEnabled, lBackState);
	}
	
	//-------------------------------------------------------
	
	
	
	void PilotTerminalWauButton(float afTimeStep)
	{		
		//////////////////////////////
		// Widget data
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		
		cImGuiTextFrameData textData = StationGui_CreateDefaultTextFrameData();
		textData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
		
		//////////////////
		// Draw static
		int lStaticFrames = ImGui_GetStateInt("Static",0);
		if (lStaticFrames > 0)
		{
			ImGui_DoImage(cImGuiGfx("station/static/static_0"), ImGui_NrmPos(cVector3f(-0.5+cMath_RandRectf(-0.05f,0.05f),-0.2+cMath_RandRectf(-0.05f,0.05f),7.0)),ImGui_NrmSize(cVector2f(2.0,2.0)));
			--lStaticFrames;
		}
		
		//////////////////
		// Text
		ImGui_DoWindowStart("PilotControlStatus", window, ImGui_NrmPosGroup(0.05, 0.02, 1), ImGui_NrmSizeGroup(0.9, 0.775));
			float fOffs = Depth_ImGui_GetScrollValue("MonitorGibberish");
			float fOverlap = ImGui_DoTextFrameExt("MonitorGibberish_1", ImGui_NrmSizeGroup(cVector2f(0.075, 0.05)), 5, int(fOffs), textData, 
													ImGui_NrmPosGroup(cVector3f(0, 0, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			
			if (fOverlap>0.0f)
			{
				fOffs += afTimeStep*10;
				
				if (fOffs>58)
				{
					lStaticFrames = 10;
					fOffs = 0;
					
					PlayStaticAudioBurst();
				}
				
				Depth_ImGui_SetScrollValue("MonitorGibberish", fOffs);
			}
		ImGui_DoWindowEnd();
		
		ImGui_SetStateInt("Static",lStaticFrames);
	}
	
	//-------------------------------------------------------
	
	void PlayStaticAudioBurst()
	{
		cLux_AddTodoMessage("SOUND: Static burst happens here");
	}

