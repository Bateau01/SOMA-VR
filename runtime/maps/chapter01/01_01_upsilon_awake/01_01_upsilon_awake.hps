	//-------------------------------------------------------
	
	cSequenceStatesData mReactToEnvironmentSequenceStates;
	void SequenceReactToEnvironment(const tString &in asName)
	{
		Sequence_Begin("SequenceReactToEnvironment", mReactToEnvironmentSequenceStates);
		
		if (Sequence_DoStepAndWait(1.5f))
		{
			//Voice_Play("1B_PowerOn_BeforeCollapse");
			
