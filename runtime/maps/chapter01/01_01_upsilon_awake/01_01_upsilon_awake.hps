	//{------------------------------------------------------
	
	bool mbRealChipTaken = false;
	
	//-------------------------------------------------------
	
	void SetupToolChips()
	{

	}
	
	//-------------------------------------------------------
	
	void AreaInsertOmniTool_TechRoom_OnPlayerLookAt(const tString &in asEntity, int alState)
	{
		////////////////////////////
		// Switch on the Omnitool area if player is looking at correct slot
		if (alState > -1)
		{
			Entity_SetActive("ToolAreaOmniTool",true);
			Entity_SetActive("ToolAreaConfigChip",false);
		}
	}
	
	//-------------------------------------------------------
	
	void AreaInsertConfigChip_OnPlayerLookAt(const tString &in asEntity, int alState)
	{
		///////////////////////////////
		// Switch on the Config Chip area if player is looking at correct slot 
		if (alState > -1)
		{
			Entity_SetActive("ToolAreaOmniTool",false);
			Entity_SetActive("ToolAreaConfigChip",true);
		}
	}
	
	//-------------------------------------------------------
	
	void AreaGetToolChip_OnPlayerInteract(const tString &in asEntity)
	{
		if (mbRealChipTaken)
		{
			Entity_SetActive("AreaGetToolChip*",false);
			return;
		}
		
		////////////////////////////
		// Disable appropriate chip
		tString sChipName = Entity_GetVarString(asEntity,"");
		Entity_SetActive(sChipName,false);
		
		////////////////////////////////
		// Give player the tool and disable chip interaction areas
		Entity_CallEntityInteract("ConfigChipTool");
		Entity_SetActive("ConfigChipTool",false);
		Entity_SetInteractionDisabled("securitychip_broken_*",false);
		Entity_SetActive("AreaGetToolChip*",false);
		
		mbRealChipTaken = true;
	}
	
	// H5756X_VR_UPSILON_PHYSICAL_TRAY_SELECTION
	void OnInteractChip(const tString &in asEntity)
	{
		// Stock leaves this prop callback empty and uses AreaGetToolChip_1..4.
		// In VR the hand is already physically interacting with the exact visible
		// securitychip_broken_* prop, so ask PlayerToolHandler whether this authored
		// story stage may use that prop as presentation carrier. With no live VR
		// runtime the helper returns false and this function remains stock-empty.
		if (mbRealChipTaken) return;
		cScript_SetGlobalArgString(0, asEntity);
		cScript_SetGlobalReturnBool(false);
		cScript_RunGlobalFunc("PlayerToolHandler", "", "_Global_VRUpsilonSelectPhysicalToolChipCarrier");
		if (!cScript_GetGlobalReturnBool()) return;

		// Exact vanilla AreaGetToolChip_OnPlayerInteract logical transaction, except
		// the selected visible prop stays active because it is the object in the VR hand.
		Entity_CallEntityInteract("ConfigChipTool");
		Entity_SetActive("ConfigChipTool", false);
		Entity_SetInteractionDisabled("securitychip_broken_*", false);
		Entity_SetActive("AreaGetToolChip*", false);
		mbRealChipTaken = true;
	}
	
	bool ConfigChipTool_OnPickUp(const tString &in asTool)
	{
		////////////////////////////
		// Player picks up Config Chip
		cLux_AddTodoMessage("SCRIPT: Anything to happen when config chip is picked up");
		Sound_CreateAtEntity("PickupChip", "01_01_upsilon_awake/sfx/omnitool/chip_pickup", "Player");
		return true;
	}
	
	//-------------------------------------------------------
	
	bool ConfigChipTool_CanBeUsed(const tString &in asTool, const tString &in asEntity)
	{
		////////////////////////////
		// Player is looking at config chip slot to insert it
		if (asEntity == "AreaInsertConfigChip") return true;
		return false;
	}
	
	//-------------------------------------------------------
	
	bool ConfigChipTool_OnUse(const tString &in asTool, const tString &in asEntity)
	{
		////////////////////////////
		// Player tries to insert the config chip
		if (asEntity == "AreaInsertConfigChip")
		{
			PlaceConfigChipInSlot();
			return true;
		}

		return false;
	}
	
	//-------------------------------------------------------
	
	void PlaceConfigChipInSlot()
	{
		///////////////////////////////
		// Player inserts the chip in to the socket
		cLux_AddTodoMessage("SCRIPT: Juice up the inserting a bit");
		Entity_SetActive("ConfigChipToolInserted",true);
		Entity_SetActive("AreaInsertConfigChip",false);
		mbConfigChipInserted = true;
		
		/////////////////////////////
		// Sound and movement effect
		Sound_CreateAtEntity("InsertChip", "01_01_upsilon_awake/sfx/omnitool/chip_insert", "ConfigChipToolInserted");
		Map_AddTimer("timer_slidechip",1.0f,"TimerSlideInChip");
	}
	
	//-------------------------------------------------------
	
	void TimerSlideInChip(const tString &in asTimer)
	{
		Prop_MoveLinearTo("ConfigChipToolInserted","ConfigChipTarget",0.1f,2.0f,0.01f,true,"OnChipInserted");
		
	}
	
	//-------------------------------------------------------
	
	void OnChipInserted(const tString& in asPropName)
	{
		cLux_AddDebugMessage("Chip Inserted!");
		
		Map_AddTimer("timer_chipswitch",0.75f,"TimerChipSwitch");
		//CathTool_AllowDetach("OmniTool_NotConfigured");
		

	}
	
	//-------------------------------------------------------
	
	void TimerChipSwitch(const tString &in asTimer)
	{
		Entity_SetActive("ConfigChipToolInserted",false);
		Entity_SetActive("OmniTool_NotConfigured",false);
		CathTool_Insert("OmniTool_Configured","cath_terminal_1",false);
		CathTool_SetChipBroken(false);
		
		Map_AddTimer("timer_janeconfig",0.35f,"TimerJaneChip");
		
		LastOnSoma_SetText("01_01_upsilon_awake_3");
	}
	
	//-------------------------------------------------------
	
	bool mbToolChipAnnounced = false;
	void TimerJaneChip(const tString &in asTimer)
	{
		///////////////////////////////////
		// Onboard Jane Quips
		cLux_AddDebugMessage("Jane Quip");
		Voice_SetSource("HelperJane","cath_terminal_1",1.0f,12.0f,true);
		Voice_Play("HelperJanePlugToolChipFound");
		mbToolChipAnnounced = true;
	}
	
	//-------------------------------------------------------
	bool mbFirstTimeOmniLoad = false;
	void PlaceOmniToolInTerminal()
	{
		////////////////////////////////////
		// Plug in to the socket
		mbOmnitoolPlacedOnce = true;
		mbOmniToolInserted = true;
		mbTerminalsUnlocked = true;
		Entity_SetActive("AreaInsertOmniTool_TechRoom",false);
		CathTool_Insert("OmniTool_NotConfigured","cath_terminal_1");
		
		///////////////////////////////////
		// Enable door pounding event to be possible
		Entity_SetActive("AreaDoorPound",true);
		
		if(mbFirstTimeOmniLoad == false)
		{
			Sound_CreateAtEntity("OmniFirstLoad", "01_01_upsilon_awake/sfx/omnitool/omni_firstload", "OmniPluggedInSoundSource");
			mbFirstTimeOmniLoad = true;
		}
	}
	
	
	//-------------------------------------------------------
	
	void TimerOpenChipContainer(const tString &in asTimer)
	{
		////////////////////////////////////
		// Open security chip door
		SlideDoor_SetClosed("ChipContainer_Door",false,false);
		
		////////////////////////////////////
		// Enable tool area for chip to be inserted
		Entity_SetActive("ToolAreaOmniTool",false);
		Entity_SetActive("ToolAreaConfigChip",true);
		
		////////////////////////////////////
		// Enable target area for chip tool to be used on once acquired
		Entity_SetActive("AreaInsertOmniTool_TechRoom",false);
		Entity_SetActive("AreaInsertConfigChip",true);
		
		///////////////////////////////////
		// Enable custom interaction areas on tool chips
		Entity_SetActive("AreaGetToolChip_*",true);
		Entity_SetInteractionDisabled("securitychip_broken_*",true);
	}
	
	//-------------------------------------------------------
	
	bool OmniTool_Configured_OnPickUp(const tString &in asTool)
	{
		/////////////////////////////////
		// Player picks up the fully configured OmniTool
		mbOmniToolInserted = false;
		mbOmniToolConfigured = true;
		Entity_SetActive("ConfigChipToolInserted",false);
		
		mbThrowBoxesAllowed = true;
		
		// Omnitool stays on screen a bit longer than usual so player can read the chip graphic
		Map_AddTimer("timer_unequipomnitool",3.89f,"TimerUnequipOmnitool");
		
		return true;
	}
	
