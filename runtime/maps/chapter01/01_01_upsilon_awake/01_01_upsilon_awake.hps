	//Kitchen area fridge compressor
	bool mbFridgeCompressorSoundActive = false;
	void LivingArea_FridgeCompressor_SoundStart(const tString &in asTimer)
	{
		if(mbFridgeCompressorSoundActive == false)
		{
			Map_RemoveTimer("LivingArea_FridgeCompressor_SoundStart");
			Sound_CreateAtEntity("CompressorStart", "Entities_Station/object/sliding_fridge/compressor/start", "FridgeCompSoundSource", 0.0f, true, 1.0f);
			Sound_CreateAtEntity("CompressorLoop", "Entities_Station/object/sliding_fridge/compressor/loop", "FridgeCompSoundSource", 1.0f, true, 1.0f);
			Map_AddTimer("LivingArea_FridgeCompressor_SoundStop", cMath_RandRectf(18, 30), "LivingArea_FridgeCompressor_SoundStop");
			mbFridgeCompressorSoundActive = true;
		}
	}
	
	void LivingArea_FridgeCompressor_SoundStop(const tString &in asTimer)
	{
		if(mbFridgeCompressorSoundActive == true)
		{
			Map_RemoveTimer("LivingArea_FridgeCompressor_SoundStop");
			Sound_CreateAtEntity("CompressorStop", "Entities_Station/object/sliding_fridge/compressor/stop", "FridgeCompSoundSource", 0.0f, true, 1.0f);
			Sound_Stop("CompressorLoop", 1.0f);
			Map_AddTimer("LivingArea_FridgeCompressor_SoundStart", cMath_RandRectf(30, 45), "LivingArea_FridgeCompressor_SoundStart");
			mbFridgeCompressorSoundActive = false;
		}

	}
	
	//---------------------------------------------------------------------
	
	//Aquarium Spot logic
	bool mbIsPlayerInAquarium = false;
	bool Trigger_IsPlayerInAquarium(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			mbIsPlayerInAquarium = true;
		}
		else 
		{
			mbIsPlayerInAquarium = false;
		}
		cLux_AddDebugMessage("Player is in aquarium is "+mbIsPlayerInAquarium);
		return true;
	}
	
	//-------------------------------------------------------
	
	bool AquariumFrontDoorState(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1 && mbIsPlayerInAquarium == false)
		{
			Sound_Stop("aquarium_water_1", 3.0f);
		}
		else if(mbIsPlayerInAquarium == false)
		{
			Sound_Play("aquarium_water_1", 3.0f);
		}
		return true;
	}
		
