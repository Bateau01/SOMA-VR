	/////////////////////////////////////////
	// Scene 2 Event C *Datamine semi-infected maintenance robot*
	//{//////////////////////////////////////

	//-------------------------------------------------------
	
	void DatamineArea_SemiInfectedRobot_SubjectOver(const tString &in asScene, const tString &in asSubject)
	{
		OnDiscoverDatamining();
		Map_AddTimer("timer_robotescape",3.5f,"TimerRobotEscape");
		//SlideDoor_SetClosed("robot_storage_door", false, true);
		Entity_SetActive("AreaReleaseRobot", true);
	}
	
	//-------------------------------------------------------
	
	void TimerRobotEscape(const tString &in asTimer)
	{
		ReleaseInfectedRobot();
	}
	
	//}
	
	//-------------------------------------------------------

	/////////////////////////////////////////
	// Scene 2 Event D *Turn on lights & awaken infected maintenance robot*
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	
	void SetupHangingRobot()
	{	
		Entity_StopAnimation("infected_robot_hanging_1");
		Entity_SetActive("infectedrobot_hanging_1",true);
		
		Entity_SetActive("construct_oil_*",false);
		Entity_SetActive("sealedwall_door_broken",false);
		Entity_SetActive("sealedwall_door",true);
		
		//flicker gets set to active when entering room to stop sound from leaking through walls
		Light_SetFlickerActive("PointLight_279", false);
	}	
	
	//-------------------------------------------------------
	
	bool CollideAreaRobotTwitches(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbInfectedRobotReleased) return false;
		if (mbKilledByRobot) return false;
		if (EyeTracking_IsActive()) return true;
		
		//////////////////////////////////////////
		// Robot twitches slightly - is it alive??
		if (alState == 1)
		{	
			RobotTwitch();
			return false;
		}
		
		return true;
	}
	
	//-------------------------------------------------------
	
	void RobotTwitch()
	{
		if (mbInfectedRobotTwitched == true) return;
		mbInfectedRobotTwitched = true;
		
		cLux_AddTodoMessage("SCRIPT: NEED ANIMATION FOR ROBOT HANGING TO REMOVE ENTITY SWAP AND POP");
		tString sAnimName = "twitch";
		
		Entity_SetActive("infectedrobot_hanging_1",true);
		Entity_SetEffectsActive("infectedrobot_hanging_1",true,true);
		cLux_AddTodoMessage("SCRIPT/ART: Make robot twitch!!");
		Sound_CreateAtEntity("RobotTwitch","01_01_upsilon_awake/sfx/construct_twitch_scare", "infectedrobot_hanging_1");
		Entity_PlayAnimation("infectedrobot_hanging_1",sAnimName,0.1f,true,false,"");
		Map_AddTimer("timer_notwitching",0.75f,"TimerStopRobotTwitching");
		Music_Play("NPC_robotheadgirl_scare2", 0.85f, false, eMusicPrio_BigEvent);
	}
	
	//-------------------------------------------------------
	
	void TimerStopRobotTwitching(const tString &in asTimer)
	{
		Entity_SetEffectsActive("infectedrobot_hanging_1",false,true);
		tString sAnimName = "idle";
		Entity_PlayAnimation("infectedrobot_hanging_1",sAnimName,0.1f,true,false,"");
		Depth_Audio_Fear_MediumIntensity();
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaReleaseRobot(const tString &in asParent, const tString &in asChild, int alState)
	{
		ReleaseInfectedRobot();
		
		/*if (alState == 1 && mbKilledByRobot == false)
		{
			Entity_PlaceAtEntity("infected_robot", "AreaRobotSpawn_Maintenance",cVector3f_Zero,true);
			Entity_SetActive("infected_robot",true);
			Entity_SetActive("AreaLeaveMaintenance",true);
			ReleaseInfectedRobot();
			return false;
		}*/
		
		return false;
	}
	
	bool CollideAreaLeaveMaintenance(const tString &in asParent, const tString &in asChild, int alState)
	{
		Map_AddTimer("", 1.0f, "Timer_ShowLeanHint");
		
		return false;
	}
	
	void Timer_ShowLeanHint(const tString &in asTimer)
	{
		Hint_ShowHint("Hints", "HintLean", true);
	}
	
	//-------------------------------------------------------
	
	//} END SCENE 2 EVENT D
	
	//-------------------------------------------------------

	/////////////////////////////////////////
	// Scene 2 Event E *Infected Robot Encounters*
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	int mlFootstepCount = 0;
	float mfFootstepVolume = 1.0f;
	//-------------------------------------------------------
	
	void SetupInfectedRobot()
	{
		///////////////////////////
		// Idle still animation
		tString sAnimName = "idle";
		Entity_PlayAnimation("infectedrobot_hanging_1",sAnimName,0.1f,true,false,"");
		Entity_SetEffectsActive("infectedrobot_hanging_1",false,false);
	}
	
	//-------------------------------------------------------
	
	void ReleaseInfectedRobot()
	{
		if (mbInfectedRobotReleased) return;
		
		cLux_AddDebugMessage("Cosas are happening");
		
		/////////////////////////////////////////
		// Release the robot from the tech room
		mbInfectedRobotReleased = true;
		cLux_AddTodoMessage("SOUND: Infected robot leaves the tech room...");
		Entity_SetActive("infectedrobot_hanging_*",false);
		Entity_SetActive("blockbox_hanging_robo*",false);
		Entity_SetActive("DistortionArea_HangingRobot",false);
		
		/*///////////////////////////
		// Infected robot may kill suit man
		Entity_SetActive("AreaRobotKillsSuitMan",true);
		*/
		
		////////////////////////////////
		// Should the door be busted?
		if (SlideDoor_GetOpenAmount("robot_storage_door") <= 0.1f)
		{
			Entity_SetActive("robot_storage_door",false);
			Entity_SetActive("robot_storage_door_smashed",true);
			Button_SetDisabled("robot_storage_doorpanel_*",true,true);
		}
		
		///////////////////////////
		// Associated sounds
		Sound_CreateAtEntity("DoorSmash", "01_01_upsilon_awake/sfx/door_smash/door_smash", "DoorSmashSoundSource");
		Entity_SetActive("Trigger_SmashedDoorMusic", true);
		Entity_SetActive("AreaEndRobotScare_1", true);
		Sound_FadeGlobalVolume(0.35f, 0.1f, eSoundEntryType_WorldAll);
		Map_AddTimer("FadeUpFromSmash", 1.0f, "FadeUpFromSmash");
		Map_AddTimer("DoorSmashPostLoop", 0.5f, "DoorSmashPostLoop");
		Map_AddTimer("ConstructDoorSmashMusic", 1.0f, "ConstructDoorSmashMusic");
		Depth_Audio_Fear_MediumIntensity();
		Area_MoveLinearTo("RunningSoundSource","RunningSoundSource_Target",2.2f,5.0f);
		Map_AddTimer("StopAmbientMusicQuickly", 1.0f, "AmbientMusicHandler");
		
		//////////////////////////
		// Activate the oil and maintenance hatch
		Entity_SetActive("construct_oil_*",true);
		Entity_SetActive("robot_escape_hatch_closed",false);
		Entity_SetActive("robot_escape_hatch_item_1",true);
		Entity_SetActive("robot_escape_hatch_item_2",true);
		Entity_SetActive("robot_escape_hatch_item_3",true);
		
		///////////////////////////
		// And the broken door!
		Entity_SetActive("sealedwall_door_broken",true);
		Entity_SetActive("sealedwall_door",false);
		
		/////////////////////////////////////////////
		// Disabling the door seal as the robot has kicked it out of the way on his frantic escape
		Entity_SetActive("OpenDoorSeal_RobotRoom",false);
		
		/////////////////////////////////////////////
		// Enable lean hint area
		Entity_SetActive("AreaLeaveMaintenance",true);	
		
		/////////////////////////////////////////////
		// Effects
		Effect_Shake_Start(0.05f,0.2f,0.0f,0.2f);
	}
	
	//-------------------------------------------------------
	
	void FadeUpFromSmash(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 2.0f, eSoundEntryType_WorldAll);
	}
	
	bool mbDoorSmashLoopSoundActive = false;
	void DoorSmashPostLoop(const tString &in asTimer)
	{
		Sound_CreateAtEntity("DoorSmashPostLoop", "01_01_upsilon_awake/sfx/door_smash/door_smash_loop", "DoorSmashLoopEndSoundSource");
		mbDoorSmashLoopSoundActive = true;
	}
		
	//-------------------------------------------------------
	
	bool Trigger_EndRobotLoop(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbDoorSmashLoopSoundActive == false) return false;
		
		Sound_Stop("DoorSmashPostLoop", 1.0f);
		Sound_CreateAtEntity("DoorSmashPostLoopEnd", "01_01_upsilon_awake/sfx/door_smash/door_smash_end", "DoorSmashLoopEndSoundSource");
		Depth_Audio_Fear_MediumIntensity();
		mbDoorSmashLoopSoundActive = false;
		cLux_AddDebugMessage("Loop stopping");
		ConstructDoorSmashMusicEnd();
		return true;
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////////
	// ENCOUNTER *OMNITOOL STORAGE ROBOT*
	//{/////////////////////////////////////
	
	//-------------------------------------------------------
	bool mbStorageRobotAttacked = false;
	bool mbStorageSealRemoved = false;
	bool mbStorageRobotDeparted = false;
	//-------------------------------------------------------
	
	bool CollideAreaStorageDoorScare(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		/////////////////////////
		// Build up sequence for robot trying to get out
		StorageDoorSequence("");
		
		return false;
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mStorageDoorSequence;
	void StorageDoorSequence(const tString &in asName)
	{
		Sequence_Begin("StorageDoorSequence", mStorageDoorSequence);

		if (Sequence_DoStepAndWait(1.25f))
		{
			/////////////////////////
			// Create particles at door
			ParticleSystem_CreateAtEntity("ps_dustbang_2","01_01_door_storage_scare.ps","AreaOmnistorageDoorEffect",true);
			
			
			//////////////////////////////////////
			// Panel registers an error...
			SlideDoor_SetOpenAmount("storageroom_door",0.05f,false);
			Entity_CallEntityInteract("storageroom_doorpanel_2");
			
			Effect_Shake_Start(0.1f,0.1f,0.0f,0.0f);
		}
		else if (Sequence_DoStepAndWait(1.25f))
		{
			cLux_AddDebugMessage("Close the door");
			
			Depth_Audio_Fear_HighIntensity(5.0f,8.0f,3,true,true);
			Sound_FadeGlobalVolume(1.0f, 5.0f);
			
			/////////////////////////
			// Door closes
			Entity_CallEntityInteract("storageroom_doorpanel_2");
			SlideDoor_SetClosed("storageroom_door",true,false);
			Effect_Shake_Start(0.1f,0.1f,0.0f,0.0f);
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaBeginStorageScare(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		cLux_AddDebugMessage("Approaching Door");
		
		////////////////////////////////////
		// Player goes near the storage door... we hear robot sounds, a timer is started..
		
		StorageScareBuildupMusic();
		StorageBuildupSequence("");
		
		
		return false;
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaStorageScareMixer(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			cLux_AddDebugMessage("Enter Storage Mixer");
			Sound_FadeGlobalVolume(0.45, 2.0f);
		}
		else
		{
			cLux_AddDebugMessage("Exit Storage Mixer");
			Sound_FadeGlobalVolume(1.0, 2.0f);
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaDoorInteraction(const tString &in asParent, const tString &in asChild, int alState)
	{
		/////////////////////////////////////
		// Restrict ability to interact with the doorpanel unless the player is on the steps
		bool bPanelDisabled = alState == 1 ? false : true;
		Entity_SetInteractionDisabled("storageroom_doorpanel_2",bPanelDisabled);
		Entity_SetInteractionDisabled("HandleDoorSeal_OmnitoolStorage",bPanelDisabled);
		
		
		
		return true;
	}
	
	//-------------------------------------------------------

	bool mbStorageEventActive = false;
	cSequenceStatesData mStorageBuildupSequence;
	void StorageBuildupSequence(const tString &in asName)
	{
		Sequence_Begin("StorageBuildupSequence", mStorageBuildupSequence);

		///////////////////////////////////////////////////////////////////////////////
		// IMPORTANT : SEQUENCE MUST NOT LAST LONGER THAN THE ROBOT DEPARTURE SOUNDS //
		///////////////////////////////////////////////////////////////////////////////
		
		if (Sequence_DoStepAndWait(.45f))
		{
			/////////////////////////
			// Create particles at door
			Sound_CreateAtEntity("RobotCommotionBehindDoor", "01_01_upsilon_awake/sfx/storage_room/suit_diver_kill", "StorageRoomRobotSoundSource");
			Map_AddTimer("SuitDiverKillMusic", 15.0f, "SuitDiverKillMusic");
			mbStorageEventActive = true;
			Map_AddTimer("SuitDiverMusic", 1.0f, "SuitDiverMusic");
			Map_AddTimer("timer_storagerobotdepart",15.0f,"TimerStorageRobotDeparture");
			Music_Stop(0.25f, eMusicPrio_BigEvent);
			
			Sound_FadeGlobalVolume(0.05f, 0.20f);
			Sound_PreloadGroup("Player/UI", true);
			Map_AddTimer("StorageRoomAttackFadeUp1", 5.0f, "StorageRoomAttackFadeUp_1");
			Map_AddTimer("StorageRoomAttackFadeUp2", 15.0f, "StorageRoomAttackFadeUp_2");
			ParticleSystem_CreateAtEntity("ps_dustbang_2","01_01_door_storage_scare.ps","AreaOmnistorageDoorEffect",true);
			
			//////////////////////////////////////
			// Panel registers an error...
			SlideDoor_SetOpenAmount("storageroom_door",0.05f,false);
			Entity_CallEntityInteract("storageroom_doorpanel_2");
			
			Effect_Shake_Start(0.1f,0.1f,0.0f,0.0f);
		}
		else if (Sequence_DoStepAndWait(1.25f))
		{
			cLux_AddDebugMessage("Close the door");
			Sound_FadeGlobalVolume(1.0f, 5.0f);
			
			/////////////////////////
			// Door closes
			Entity_CallEntityInteract("storageroom_doorpanel_2");
			SlideDoor_SetClosed("storageroom_door",true,false);
			Effect_Shake_Start(0.1f,0.1f,0.0f,0.0f);
		}
		
		Sequence_End();
	}
			
	//-------------------------------------------------------
	
	void SuitDiverKillMusic(const tString &in asTimer)
	{
		if(mbStorageScareSoundControl==true)
		{
			Music_Play("01_01_door_smashed", 0.35f, false, eMusicPrio_BigEvent);
		}
	}
	
	void SuitDiverMusic(const tString &in asTimer)
	{
		Music_Play("01_01_construct_smashing_about", 0.45f, false, eMusicPrio_BigEvent);
	}
	
	void StorageRoomAttackFadeUp_1(const tString &in asTimer)
	{
		if(mbStorageScareSoundControl==true)
		{
			Sound_FadeGlobalVolume(0.65f, 5.0f);
		}
	}
	
	void StorageRoomAttackFadeUp_2(const tString &in asTimer)
	{
		if(mbStorageScareSoundControl==true)
		{
			Sound_FadeGlobalVolume(1.0f, 5.0f);
		}
	}
		
	//-------------------------------------------------------
	
	bool mbStorageScareSoundControl = false;
	bool CollideStorageScareSoundControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			if(mbStorageEventActive==true)
			{
				Sound_FadeGlobalVolume(0.65f, 3.0f);
			}
			
			mbStorageScareSoundControl = true;
		}
		else
		{
			if(mbStorageEventActive==true)
			{
				Sound_FadeGlobalVolume(1.0f, 3.0f);
			}
			
			mbStorageScareSoundControl = false;
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	void storageroom_doorpanel_2_OnConnectionStateChange(const tString &in asEntity, int alState)
	{
		if (alState == 1 && mbStorageSealRemoved && mbStorageRobotDeparted == false)
		{
			///////////////////////////////////////
			// Temporarily disable buttons
			Button_SetDisabled("storageroom_doorpanel*",true,true);
			Map_AddTimer("timer_activatestoragebuttons",6.0f,"TimerEnableStorageButtons");
			
			///////////////////////////////////////
			// Robot attacks
			Entity_SetActive("maintenance_infected_1",true);
			Entity_PlaceAtEntity("maintenance_infected_1","maintenance_infected_2",cVector3f_Zero,true);
			
			Map_AddTimer("timer_robotattack",0.05f,"TimerPerformRobotAttack");
		
			Player_SetMoveSpeedMul(0.0f);
		}
	}
	
	//----------------------------------------------
	
	void TimerPerformRobotAttack(const tString &in asTimer)
	{
			mbStorageEventActive = false;
			
			////////////////////////////////////
			// Force a lookat here (just this once!)
			Player_StartLookAt("maintenance_infected_1",2.0f,2.0f,10.0f);
			
			//////////////////////////////////////
			// Sounds and music
			Music_FadeVolumeMul(1.0f, 0.5f);
			Sound_CreateAtEntity("ConstructAttack", "01_01_upsilon_awake/sfx/storage_room/attack", "Player");
			Map_AddTimer("StopRobotSounds", 0.05f, "StopRobotSounds");
			Map_AddTimer("StopRobotSoundsTimer", 5.0f, "StopRobotSoundsTimer");
			Sound_Stop("RobotStorage", 1.0f);
			Sound_Stop("RobotCommotionBehindDoor", 2.0f);
			Map_AddTimer("FadeOutConstructAttack", 1.0f, "FadeOutConstructAttack");
			Music_PlayExt("01_01_robot_attack_event", false, 0.55f, 1.0f, 0.0f, 0.0f, eMusicPrio_OverrideAll, false);
			
			////////////////////////////////////////
			// Set attack meter settings and enable the robot
			Agent_SetSensesActive("maintenance_infected_1",true);
			InfectedRobot_ForceHuntState("maintenance_infected_1");
			mbStorageRobotAttacked = true;
			
			AttackMeter_SetAfterDamageCallback("PlayerHitByRobot");
			Map_RemoveTimer("StorageRoomAttackFadeUp1");
			Map_RemoveTimer("StorageRoomAttackFadeUp2");
			Entity_SetEffectsActive("GlimpseRobot_Storage",false,true);
			
			Effect_Shake_Start(0.1f,0.5f,0.0f,0.5f);
			Player_FadeMoveSpeedMulTo(1.0f,3.0f);
			
			Entity_AddImpulseFromEntity("DoorSeal_OmnitoolStorage","storageroom_door",50.0f,true);
	}
	
	//----------------------------------------------
	
	void StopRobotSounds(const tString &in asTimer)
	{
		Map_AddTimer("StopRobotSounds", 0.01f, "StopRobotSounds");
        
        if(Sound_Exists("maintenance_infected_1_AnimEvent"))
        {
            Sound_Stop("maintenance_infected_1_AnimEvent", 0.01f);
        }
        
        if(Sound_Exists("maintenance_infected_1_maintenance_infected_1_Bark"))
        {
            Sound_Stop("maintenance_infected_1_maintenance_infected_1_Bark", 0.01f);
        }
	}
	
	//----------------------------------------------
	
	void StopRobotSoundsTimer(const tString &in asTimer)
	{
		Map_RemoveTimer("StopRobotSounds");
	}
	
	//----------------------------------------------
	
	void FadeOutConstructAttack(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(0.0f, 0.05f, eSoundEntryType_WorldAll);
		Sound_FadeGlobalVolume(0.0f, 0.05f, eSoundEntryType_GuiWorld);
		Map_AddTimer("FadeUpConstructAttack", 3.0f, "FadeUpConstructAttack");
	}
	
	//----------------------------------------------
	
	void FadeUpConstructAttack(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 4.0f, eSoundEntryType_WorldAll);
		Sound_FadeGlobalVolume(1.0f, 4.0f, eSoundEntryType_GuiWorld);
	}
	
	//-------------------------------------------------------
	
	void PlayerHitByRobot(const tString& in asSource)
	{
		if (asSource == "maintenance_infected_1")
		{
			cLux_AddDebugMessage("The robot got you!");
			
			
			Map_RemoveTimer("timer_activatestoragebuttons");
			TimerEnableStorageButtons("");
			
			Player_StopLookAt(99.0f);
			Player_StartLookAt("RobotDeathLookat",99.0f,99.0f,99.0f);
			Map_AddTimer("timer_robotdeath",3.0f,"TimerPostRobotDeath");
			
			////////////////////////////////
			// Make sure gate is busted open again!
			SwingDoor_SetOpenAmount("swingdoor_fencing_round_7",1.0f);
			
			Sound_PlayGui("Player/UI/blackout_hit", 1.0f, eSoundEntryType_Gui);
			
			Map_AddTimer("AfterRobotAttackHealing", 20, "Timer_AfterRobotAttackHealing");
		}
	}
	
	void Timer_AfterRobotAttackHealing(const tString&in asTimer)
	{
		Player_AddHealth(0.0025);

		if(Player_GetHealth() < 0.6)
			Map_RestartCurrentTimer(1);
	}
	
	//-------------------------------------------------------
	
	void TimerPostRobotDeath(const tString &in asTimer)
	{
		Entity_SetActive("maintenance_infected_1",false);
		Entity_SetActive("maintenance_infected_2",false);
		mbStorageRobotDeparted = true;
		Entity_SetActive("DistortionArea_StorageRobot",false);
		
		Player_StopLookAt(99.0f);
	}
	
	//-------------------------------------------------------
	
	void TimerEnableStorageButtons(const tString &in asTimer)
	{
		Button_SetDisabled("storageroom_doorpanel*",false,true);
	}
	
	//-------------------------------------------------------
	
	void OnRemoveStorageSeal()
	{
		mbStorageSealRemoved = true;
		Map_AddTimer("timer_activatestoragebuttons",6.0f,"TimerEnableStorageButtons");
	}
	
	//-------------------------------------------------------
	
	void TimerStorageScare(const tString &in asTimer)
	{
		///////////////////////////////////////
		// Temporarily disable buttons
		Button_SetSwitchedOn("storageroom_doorpanel_2",true,true);
		SlideDoor_SetClosed("storageroom_door",false,false);
		
		Button_SetDisabled("storageroom_doorpanel*",true,true);
			
		///////////////////////////////////////
		// Robot attacks
		Entity_SetActive("maintenance_infected_1",true);
		Entity_PlaceAtEntity("maintenance_infected_1","maintenance_infected_2",cVector3f_Zero,true);
		
		
		Map_AddTimer("timer_robotattack",0.05f,"TimerPerformRobotAttack");
	}
	
	//-------------------------------------------------------
	
	void TimerStorageRobotDeparture(const tString &in asTimer)
	{
		mbStorageEventActive = false;
		Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_WorldAll);
		if (mbStorageRobotAttacked) return;
		
		Entity_SetActive("maintenance_infected_1", false);
		mbStorageRobotDeparted = true;
		Entity_SetEffectsActive("GlimpseRobot_Storage",false,true);
		Entity_SetActive("DistortionArea_StorageRobot",false);
	}
	
	//-------------------------------------------------------
	
	//}-end omnitool storage encounter----------------------
	
	
	//-------------------------------------------------------
	
	////////////////////////////////////////
	// Robot throws boxes around
	////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbThrowBoxesAllowed = false;
	
	//-------------------------------------------------------
	
	bool Trigger_PrepareBoxScare(const tString &in asParent, const tString &in asChild, int alState)
	{
		//////////////////////////////////////
		// When player is approaching this scare, if it can happen - prepare necessary elements
		if (alState != 1) return true;
		if (mbThrowBoxesAllowed == false) return true;
		
		cLux_AddDebugMessage("Enabling box scare areas");
		Entity_SetActive("AreaRobotGlimpseStorageEvent",true);
		Entity_SetActive("AreaRobotGlimpseStorageEvent_1",true);
		Entity_SetActive("GlimpseRobot_BehindFenceStorage_Start",true);
		
		return true;
	}
	
	//-------------------------------------------------------
	
	bool Trigger_DeactivateBoxScare(const tString &in asParent, const tString &in asChild, int alState)
	{
		//////////////////////////////////////
		// If player goes back down the hall towards tech room, disable elements of this scare else it looks weird
		if (alState != 1) return true;
		if (mbThrowBoxesAllowed == false) return true;
		
		cLux_AddDebugMessage("Disabling box scare areas");
		Entity_SetActive("AreaRobotGlimpseStorageEvent",false);
		Entity_SetActive("AreaRobotGlimpseStorageEvent_1",false);
		Entity_SetActive("GlimpseRobot_BehindFenceStorage_Start",false);
		
		return true;
	}
	
	//-------------------------------------------------------
	
	bool Trigger_DisableBoxEvent(const tString &in asParent, const tString &in asChild, int alState)
	{
		////////////////////////////////////////////
		// If the player passes over this trigger, it will no longer make sense for the box scare to occur, so completely disable it
		if (mbThrowBoxesAllowed == false) return true;
		if (alState != 1) return true;
		
		Entity_SetActive("Trigger_DisableBoxEvent",false);
		Entity_SetActive("Trigger_DeactivateBoxScare",false);
		Entity_SetActive("Trigger_PrepareBoxScare",false);
		mbThrowBoxesAllowed = false;
		
		return false;
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaRobotGlimpseStorageEvent(const tString &in asParent, const tString &in asChild, int alState)
	{
		//////////////////////////////////////
		// Throw boxes when we move past a certain point
		if (alState != 1) return true;
		if (!mbThrowBoxesAllowed) return true;
		
		Entity_SetActive("debris_robotscare_*",true);
		
		Prop_MoveLinearTo("GlimpseRobot_BehindFenceStorage_Start", "GlimpseRobot_BehindFenceStorage_End", 5, 2, 0, true);
		Prop_AlignRotation("GlimpseRobot_BehindFenceStorage_Start","GlimpseRobot_BehindFenceStorage_End",5,2,0,false,"");
		Map_AddTimer("timer_fadeboxscare",5.0f,"TimerFadeBoxScare");
		
		Sound_CreateAtEntity("HallScare", "01_01_upsilon_awake/sfx/hall_scare", "AreaRobotDebris", 0.0f, false, 1.0f);
		Map_AddTimer("StopAmbientMusicQuickly", 1.0f, "AmbientMusicHandler");
		Sound_FadeGlobalVolume(0.65f, 0.25f);
		
		Map_AddTimer("FadeUpAfterHallScare", 2.0f, "FadeUpAfterHallScare");
		Map_AddTimer("HallScareMusic", 5.0f, "HallScareMusic");
		
		Prop_SetStaticPhysics("debris_robotscare*",false);
		Entity_AddImpulseFromEntity("debris_robotscare_1","AreaRobotDebris",10.0f,false);
		Entity_AddImpulseFromEntity("debris_robotscare_2","AreaRobotDebris",8.0f,false);
		
		Entity_SetActive("AreaRobotGlimpseStorageEvent*",false);
		
		mbThrowBoxesAllowed = false;
		return false;
	}
	
	//-------------------------------------------------------
	
	void AreaRobotGlimpseStorageEvent_1_OnPlayerLookAt(const tString &in asEntity, int alState)
	{
		//////////////////////////////////////
		// Lookat trigger for the box scare (preferable behaviour)
		if (alState != 1) return;
		if (!mbThrowBoxesAllowed) return;
		
		CollideAreaRobotGlimpseStorageEvent("","",1);
		Entity_SetActive("AreaRobotGlimpseStorageEvent*",false);
	}
	
	//-------------------------------------------------------
		
	void TimerFadeBoxScare(const tString &in asTimer)
	{
		Entity_SetEffectsActive("GlimpseRobot_BehindFenceStorage_Start",false,true);
	}
	
	//-------------------------------------------------------
	
	void FadeUpAfterHallScare(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 7.0f);
	}
	
	void HallScareMusic(const tString &in asTimer)
	{
		Music_Play("03_02_machinehead", 0.45f, false, eMusicPrio_MinorEvent);
		Map_AddTimer("StartAmbient", cMath_RandRectf(9.0f,14.0f), "AmbientMusicHandler");
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////////
	// When returning to tech room with omnitool, we hear the robot moving around
	////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool CollideAreaHearFootsteps(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		mfFootstepVolume = 1.0f;
		Area_MoveLinearTo("RunningSoundSource_TechRoom","RunningSoundSource_TechRoomTarget",2.2f,5.0f);
		Map_AddTimer("RunningSoundSource_TechRoom", 0.2f, "TimerTempStopFootSteps");
		
		return false;
	}
	
