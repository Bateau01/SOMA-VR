	{
		if (alState == 1)
		{
			cLux_AddDebugMessage("SCRIPT: Dialog, notice the water");
			//Voice_Play("3A_EnterTunnel");
			return false;
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	
	cSequenceStatesData mFloodTunnelSequenceStates;
	void SequenceFloodTunnel(const tString &in asName)
	{
		Sequence_Begin("SequenceFloodTunnel", mFloodTunnelSequenceStates);
			
		if (Sequence_DoStepAndWait(1.5f))
		{	
			///////////////////////////
			// Close the door and play breach sounds
			SlideDoor_SetClosed("SlideDoorObsTunnelFar",true,false);
			
			cLux_AddTodoMessage("SCRIPT: The tunnel begins to breach... water should begin coming in");
			Sound_PlayGui("01_02_upsilon_inside_02/special/collapse_sequence/collapse_impact_01_debris",1.0f);
		}
		else if (Sequence_DoStepAndWait(1.75f))
		{
			cLux_AddTodoMessage("SCRIPT: The tunnel begins to breach... second phase");
			Sound_PlayGui("01_02_upsilon_inside_02/special/collapse_sequence/collapse_impact_04_shake",1.0f);
		}
		else if (Sequence_DoStepAndWait(0.0f))
		{
			//////////////////////////////
			// Water comes in and moves along the tunnel
			cLux_AddTodoMessage("SCRIPT: The tunnel finally breaches");
			Sound_PlayGui("01_02_upsilon_inside_02/special/collapse_sequence/collapse_final",1.0f);
		
			Prop_SetActiveAndFade("SideWaterSheet_*", true, 1.0f);
			ParticleSystem_CreateAtEntity("SideFloodPS1","tunnel_flood.ps","SideFloodPS_1",true);
			ParticleSystem_CreateAtEntity("SideFloodPS2","tunnel_flood.ps","SideFloodPS_2",true);
			ParticleSystem_CreateAtEntity("SideFloodPS3","tunnel_flood.ps","SideFloodPS_3",true);
			ParticleSystem_CreateAtEntity("SideFloodPS1B","splash_continous_foam_waterfall_large.ps","SideFloodPS_1",true);
			ParticleSystem_CreateAtEntity("SideFloodPS2B","splash_continous_foam_waterfall_large.ps","SideFloodPS_2",true);
			ParticleSystem_CreateAtEntity("SideFloodPS3B","splash_continous_foam_waterfall_large.ps","SideFloodPS_3",true);
			Area_MoveLinearTo("SideFloodArea", "SideFloodTarget", 15.0f, 15.0f, 0.0f, false);
			
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	bool OnFloodHalfway(const tString &in asParent, const tString &in asChild, int alState)
	{
		////////////////////////////////////
		// Flood has now reached the door and water is rising
		cLux_AddTodoMessage("SOUND: Water is now rising past the door window");
		
		Entity_SetActive("LiquidPool",true);
		LiquidArea_MoveLinearTo("LiquidPool", "LiquidPoolTarget", 5.15f, 1.15f, 0.5f, false);
		Entity_SetActive("water_window",true);		
		
		Map_AddTimer("timer_spawn_froth",0.1f,"TimerCreateWindowFroth");
		Map_AddTimer("timer_clear_froth",3.25f+cMath_RandRectf(-0.5f,0.5f),"TimerClearWindowFroth");
		
		
		return false;
	}
	
	//-------------------------------------------------------
	
	bool OnFloodComplete(const tString &in asParent, const tString &in asChild, int alState)
	{
		Prop_SetActiveAndFade("SideWaterSheet_*", false, 1.0f);
		Entity_SetActive("SideFloodWaterArea_*",true);
		ParticleSystem_Destroy("SideFloodPS1");
		ParticleSystem_Destroy("SideFloodPS2");
		ParticleSystem_Destroy("SideFloodPS3");
		ParticleSystem_Destroy("SideFloodPS1B");
		ParticleSystem_Destroy("SideFloodPS2B");
		ParticleSystem_Destroy("SideFloodPS3B");
		
		ParticleSystem_CreateAtEntity("WindowBubblePS","loop_waterbubbles_large_cloud.ps","WindowBubbleArea",true);
	
		return false;
	}
	
	//-------------------------------------------------------
	
	int mlDestroyFrothParticle = 1;
	int mlSpawnFrothParticle = 1;
	
	void TimerCreateWindowFroth(const tString &in asTimer)
	{
		ParticleSystem_CreateAtEntity("WindowFoamPS"+mlSpawnFrothParticle,"tunnel_flood.ps","WindowArea_"+mlSpawnFrothParticle,true);
		++mlSpawnFrothParticle;
		if (mlSpawnFrothParticle <= 14)
		{
			Map_AddTimer("timer_spawn_froth",cMath_RandRectf(0.1f,0.2f),"TimerCreateWindowFroth");
		}
	}
	
	void TimerClearWindowFroth(const tString &in asTimer)
	{
		float fRndMod = mlDestroyFrothParticle * 0.025f;
		ParticleSystem_Destroy("WindowFoamPS"+mlDestroyFrothParticle);
		++mlDestroyFrothParticle;
		if (mlDestroyFrothParticle <= 14)
		{
			Map_AddTimer("timer_clear_froth",cMath_RandRectf(0.4f,0.75f)-fRndMod,"TimerClearWindowFroth");
		}
	}
	
