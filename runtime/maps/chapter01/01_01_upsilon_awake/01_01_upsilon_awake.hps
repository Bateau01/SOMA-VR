	//-------------------------------------------------------
	
	void wau_flower_talkingdoor_Callback(const tString &in asEntity)
	{
		////////////////////////////////
		// Draining the wau flower here will swap out the door for a physics one and disable the panels
		Button_SetDisabled("StorageDoor_Control_4",true,true);
		Button_SetDisabled("StorageDoor_Control_2",true,true);
		Entity_SetInteractionDisabled("StorageDoor_Control_4",true);
		Entity_SetInteractionDisabled("StorageDoor_Control_2",true);
		Entity_SetInteractionDisabled("SentientDoor",false);

		//////////////////////////////////////
		// Disable the doors ability to talk - it's dead now
		Map_RemoveTimer("timer_talkingdoor");
		mbDoorDrained = true;
		
		
		
		//////////////////////////////////////
		// Activate the players ambient light (This will help with mood in the dark section)
		cLux_AddTodoMessage("SCRIPT: Activate players ambient light to help with mood in dark section coming up..");
		Player_SetAmbientLight_None(false);
		
		Entity_SetActive("DistortionArea_SentientDoor",false);
		
		//////////////////////////////
		// Lights begin going out sequentially
		cLux_AddDebugMessage("Flicker the lights.");
		Lamp_SetFlickerActive("Lamp_WauFlowerEffects",true);
		Map_AddTimer("timer_stopflicker",5.0f,"TimerStopFlickering");
		SequenceDoorDrained("");
		
		//////////////////////////////
		// Boxlight by fence should fade
		Light_FadeTo("BoxLight_Pipe_Maintenance_2",cColor(0,0,0,0),0,3.0f);
		
		///////////////////////////////
		// Disable steam particles and sounds
		ParticleSystem_Destroy("ParticleSystem_69");
		ParticleSystem_Destroy("ParticleSystem_56");
		ParticleSystem_Destroy("ParticleSystem_67");
		Sound_Fade("talkingdoor_steam*",0.0f,3.0f);
	}
	
