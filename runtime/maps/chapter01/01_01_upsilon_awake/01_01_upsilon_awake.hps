	//-------------------------------------------------------
	
	bool CollideHatchOpen(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
		{
			cLux_AddDebugMessage("Aux area active");
			Entity_SetActive("AuxAreaPowerboxLever",true);
		}
		else
		{
			cLux_AddDebugMessage("Aux area inactive");
			Entity_SetActive("AuxAreaPowerboxLever",false);
		}
		return true;
	}
	
