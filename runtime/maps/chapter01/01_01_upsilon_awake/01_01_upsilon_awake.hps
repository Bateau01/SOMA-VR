	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// Scene 1 - Electric Puddle
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool CollideAreaHurtPlayerElectric(const tString &in asParent, const tString &in asChild, int alState)
	{
		cLux_AddDebugMessage("OUCH");
		
		
		if (alState == 1)
		{
			Map_AddTimer("Timer_electrocuteplayer",0.1f,"TimerElectrocutePlayer");
			Depth_Audio_PlayerTakeDamage();
			Depth_Audio_SimonHurt_Damage();
			
		}
		
		if (alState == -1)
		{
			Map_RemoveTimer("Timer_electrocuteplayer");
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	void TimerElectrocutePlayer(const tString &in asTimer)
	{
		if (Entity_GetCollide("Player","AreaHurtPlayerElectric"))
		{
			Player_GiveDamage(0.05f,0.1,eDamageType_Electricity,"AreaHurtPlayerElectric");
			if (mbPlayerHurt == false)
			{
				mbPlayerHurt = true;
				Map_AddTimer("timer_electrocuted",1.0f,"TimerSimonElectrocuted");
			
			}
		}
	
		Map_AddTimer("Timer_electrocuteplayer",cMath_RandRectf(0.75f,1.25f),"TimerElectrocutePlayer");
	}
	
