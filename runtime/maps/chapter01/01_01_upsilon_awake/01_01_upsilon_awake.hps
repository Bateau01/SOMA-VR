	void HatchClimb_1_OnPlayerInteract(const tString &in asEntity)
	{
		////////////////////////
		// Let the player climb if they're on the correct side of the vent, using a camera animation
		if (Entity_GetCollide("Player","HatchClimbtestArea"))
		{
			Entity_SetActive("HatchClimbtestArea",false);
			Entity_SetActive("HatchClimb_1",false);
			CameraAnimation_Begin("ClimbAnim","",true);
			mbPlayerEscaped = true;
		}
	}
	
