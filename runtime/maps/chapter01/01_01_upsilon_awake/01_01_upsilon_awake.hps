	//-------------------------------------------------------
	
	bool CollideAreaInfectedRobotSounds(const tString &in asParent, const tString &in asChild, int alState)	
	{
		if (alState != 1) return true;
		if (mbRobotInVentsDone) return false;
		
		cLux_AddTodoMessage("SOUND: The robot is ahead...");
		Sound_CreateAtEntity("GlimpseMaintenance", "01_02_upsilon_inside_02/sfx/vent/construct/flee", "HatchClimbtestArea_Alt", 0.0f, false, 1.0f);
		Prop_MoveLinearTo("GlimpseMaintenance3_Start", "GlimpseMaintenance3_Target", 4, 1, 0, true, "GlimpseDissapearFinal");
		Prop_AlignRotation("GlimpseMaintenance3_Start","GlimpseMaintenance3_Target",1,1,0,false,"");
		mbRobotInVentsDone = true;
		
		return false;
	}
	
