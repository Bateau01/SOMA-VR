		PreloadBeginChangeOfMap();
		
		return true;
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// Scene 3 - Alternate route to maintenance hatch
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbRobotInVentsDone = false;
	
	//-------------------------------------------------------
	
	bool CollideAreaTunnelDoorBang(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		if (mbDoorDrained) return false;
		
		////////////////////////////////////
		// Set up some apprehension to enter this door by hinting at something on the other side (We see lights of a monster in 1.2..)
		SequenceTunnelDoorBang("");	

		return false;
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mTunnelDoorBangSequenceStates;
	
	void SequenceTunnelDoorBang(const tString &in asName)
	{
		Sequence_Begin("SequenceTunnelDoorBang", mTunnelDoorBangSequenceStates);
		
		if (Sequence_DoStepAndWait(0.75f))
		{
			
			cLux_AddTodoMessage("SOUND: Something banging on that door..");
			Entity_PlaceAtEntity("GlimpseMaintenance","GlimpseMaintenanceStart",cVector3f_Zero,true);
			Entity_SetActive("GlimpseMaintenance",true);
			Light_SetVisible("Spotlight_RobotFlicker",true);
			
			
			
			/////////////////////////
			// Start with door bang..
			Sound_CreateAtEntity("snd_doorbang1","physics/metal/robust/impact","Player",0.0f,false,1.0f);
			ParticleSystem_CreateAtEntity("ps_dustbang_1","dust_falling_impact.ps","AreaEffectDoorBang_1",true);
			Effect_Shake_Start(0.15f,0.15f,0.1f,0.1f);
			
		}
		else if (Sequence_DoStepAndWait(1.25f))
		{
			cLux_AddTodoMessage("SOUND: This thing is really pissed off!");
			
			Depth_Audio_Fear_HighIntensity(5.0f,8.0f,3,true,true);
			
			/////////////////////////
			// On second bang the door opens slightly
			Sound_CreateAtEntity("snd_doorbang1","physics/metal/robust/impact","Player",0.0f,false,1.0f);
			ParticleSystem_CreateAtEntity("ps_dustbang_2","dust_falling_impact.ps","AreaEffectDoorBang_2",true);
			
			
			//////////////////////////////////////
			// Panel registers an error...
			SlideDoor_SetOpenAmount("TunnelDoor",0.05f,false);
			Entity_CallEntityInteract("TunnelDoor_Panel_1");
			
			///////////////////////////
			// Place a robot
			Entity_SetActive("infected_robot",true);
			Entity_PlaceAtEntity("infected_robot","AreaRobotGlimpseSpawn",cVector3f_Zero,true);
			Agent_SetSensesActive("infected_robot",false);
		}
		else if (Sequence_DoStepAndWait(1.25f))
		{
			//////////////////////////////////////
			// Panel registers an error... door opens a little bit more
			Entity_CallEntityInteract("TunnelDoor_Panel_1");
			SlideDoor_SetOpenAmount("TunnelDoor",0.0f,false);
		}
		else if (Sequence_DoStepAndWait(1.25f))
		{
			//////////////////////////////////////
			// Panel registers an error... door opens a little bit more
			Entity_CallEntityInteract("TunnelDoor_Panel_1");
			SlideDoor_SetOpenAmount("TunnelDoor",0.125f,false);
		}
		else if (Sequence_DoStepAndWait(0.75f))
		{
			cLux_AddTodoMessage("SOUND: There's something on the other side moving away... probably coming to get you later..");
			
			/////////////////////////
			// The enemy on the other side gives up..
			Light_SetVisible("Spotlight_RobotFlicker",false);
			Prop_MoveLinearTo("GlimpseMaintenance", "GlimpseMaintenanceTarget", 5, 2, 0, true);
			Sound_CreateAtEntity("GlimpseMaintenance", "01_02_upsilon_inside_02/sfx/vent/construct/flee", "GlimpseMaintenance", 0.0f, false, 1.0f);
		}
		else if (Sequence_DoStepAndWait(0.75f))
		{
			cLux_AddTodoMessage("4");
			//////////////////////////////////////
			// Panel corrects the error
			Entity_CallEntityInteract("TunnelDoor_Panel_1");
			SlideDoor_SetOpenAmount("TunnelDoor",0.0f,false);
		}
		else if (Sequence_DoStepAndWait(0.75f))
		{
			cLux_AddTodoMessage("5");
			
			//////////////////////////////////////
			// Remove the glimpse of the light now
			Entity_SetActive("GlimpseMaintenance",false);
			Entity_SetActive("infected_robot",false);
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaGlimpseRunAway(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		///////////////////////////////
		// Glimpse of robot lights retreating building up to 1.2
		Prop_MoveLinearTo("GlimpseMaintenance", "GlimpseMaintenance2_Target", 5, 1, 0, true, "GlimpseDissapear");
		Prop_AlignRotation("GlimpseMaintenance","GlimpseMaintenance2_Target",5,2,0,false,"GlimpseDissapear");
		
		return false;
	}
	
