	//-------------------------------------------------------
	
	void DisableScreenEffects()
	{
		///////////////////////////
		// Clear lingering effects
		Effect_ImageTrail_FadeOut(mlImageTrailID, 5.0f);
		Effect_ImageTrail_FadeOut(mlCurrentImageTrailEffectID, 5.0f);
		Effect_DoF_FadeOut(mlDoFEffectID, 5.0f);
	}
	
