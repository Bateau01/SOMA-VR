//--------------------------------------------------
	
class cScrMap : iScrMap
{
	//--------------------------------------------

	/////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{//////////////////////////////////////

	//-------------------------------------------------------

	////////////////////////////
	// Set up map environment
	void Setup()
	{
						
		///////////////////////////////
		// Setup presets
		{
			// Settings from 1.2 used for transition
			//Map_Preset_SetupColorGrading("Inside1_2", "textures/colorgrading/grading_01_02.dds");
		}
		
		GetBase().SetDisplayNameEntry("01-01-upsilon-awake");
		
		Entity_SetVarBool("AreaInsertOmniTool_TechRoom", "IsOmniSlot", true);
		Entity_SetVarBool("AreaInsertOmniTool_ObsTunnel", "IsOmniPanel", true);
		
		Effect_Bloom_FadeBrightPass(0.75f, 2);
		Effect_Bloom_FadeBloomWidth(128, 2);
		Effect_Bloom_FadeBloomFalloff(0.5f, 2);
		Effect_Bloom_FadeBloomTint(1, 1, 1, 2);
		
		CathTool_ResetScreen(eCathToolVariant_HelperJane);
		CathTool_SetChipBroken(true);
	}
	
	//-------------------------------------------------------

	void PreloadData()
	{
		/////////////////
		// Preload gui
		StationGui_PreloadDefault();
		OmnitoolGui_Preload();
		
		ImGui_PreloadImage("omnivideo01.dds", eImGuiGfx_Texture);
		ImGui_PreloadImage("omnivideo02.dds", eImGuiGfx_Texture);
		ImGui_PreloadImage("omnivideo03.dds", eImGuiGfx_Texture);
		ImGui_PreloadImage("omnivideo04.dds", eImGuiGfx_Texture);
		ImGui_PreloadImage("omnivideo05.dds", eImGuiGfx_Texture);
		ImGui_PreloadImage("omnivideo06.dds", eImGuiGfx_Texture);
		ImGui_PreloadImage("omnivideo07.dds", eImGuiGfx_Texture);
		
		ImGui_PreloadImage("background/background_logo_pathOS");
		ImGui_PreloadImage("stationV2/background/background_logo_pathOS_small");
		ImGui_PreloadImage("background/background_logo_pathosstation");
		ImGui_PreloadImage("station/scanlines/standard_tileable");
		ImGui_PreloadImage("station/static/static_0");

		///////////////
		// Preload particles
		ParticleSystem_Preload("01_01_break_window_damaged.ps");
		ParticleSystem_Preload("01_01_break_window.ps");
		ParticleSystem_Preload("dust_falling_fast_small_oneshot.ps");
		ParticleSystem_Preload("steam_fast_loop.ps");
		ParticleSystem_Preload("01_01_door_storage_scare.ps");
		ParticleSystem_Preload("tunnel_flood.ps");
		ParticleSystem_Preload("splash_continous_foam_waterfall_large.ps");
		ParticleSystem_Preload("loop_waterbubbles_large_cloud.ps");
		ParticleSystem_Preload("dust_falling_impact.ps");

		///////////////
		// Player hands
		PlayerHands_PreloadHandModel_Human();
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		Player_SetClothing("default");
		Player_SetFootWear("default");
		bool bDoIntro = true;
		Effect_Fade_Out(0);
		////////////////////
		//Audio
		Sound_SetGlobalVolume(0.0f, eSoundEntryType_WorldAll);
		Sound_SetGlobalVolume(0.0f, eSoundEntryType_GuiWorld);
		Sound_PreloadProject("01_01_upsilon_awake");
		Sound_PreloadGroup("Flashback/Level/01_01", true);
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			//Add any debug stuff here
			
			cLux_SetDebugInfoWindowText("Text that should show up when pressing F1");
			bDoIntro = false;
			Effect_Fade_In(1);
			Sound_FadeGlobalVolume(1.0f, 1.0f);
			Sound_FadeGlobalVolume(1.0f, 1.0f, eSoundEntryType_GuiAll);
		}
		
		Player_SetAmbientLight_None(true);
		
		
		//////////////////////////////
		// Setup various conditions for the robot
		//SetupTechRoomWreck();
		SetupHangingRobot();
		SetupExitHatch();
		SetupDoorMonster();
		SetupVentSpooks();
		SetupInfectedRobot();
		SetupDoorSeals();
		SetupToolChips();
		
		ParticleSystem_SetVisible("PS_techroom*",false);
		
		Entity_SetActive("tech_dynamic_6", false);
		
		if (bDoIntro) Map_AddTimer("timer_kickoffintro",0.01,"TimerKickoffIntro");
		
		PlayerEnergy_SetFlowerSwallows(false);
		Player_SetFlashlightDisabled(true);
		PlayerHands_SetHandModel_Human();
		
		// Turn off cath area effects for darkness
		Entity_SetActive("cath_terminal_1",false);
		Entity_SetActive("omnislot_inside_left_light_1",false);
		Entity_SetActive("omnislot_inside_right_light_1",false);
		Entity_SetActive("maintenance_infected_1",false);
		
		//Player_SetHealth(0.9f);
		
		LastOnSoma_SetText("01_01_upsilon_awake_1");
		
		/////////////////////////
		// Eye tracking
		EyeTracking_RegisterEntity("blockbox_hanging_robot_1");
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map

	// S26AQ: this legacy Trigger has no handler and no independent climb action.
	// Retire only its false VR prompt; collision/story areas and working climbs stay active.
	void VR_RemoveUnusedClimbPrompt()
	{
		cScript_SetGlobalReturnBool(false);
		cScript_RunGlobalFunc("MenuHandler", "cScrMenuHandler", "HPL3VR_GetRuntimeActive");
		if (!cScript_GetGlobalReturnBool()) return;
		cLuxMap@ pMap = cLux_GetCurrentMap();
		if (pMap is null || pMap.ScriptMethodExists("void HatchClimb_2_OnPlayerInteract(const tString &in)")) return;
		Entity_SetPlayerInteractCallback("HatchClimb_2", "", false);
	}

	void OnEnter()
	{
        // S26BC: physical surface -> exact native tool-use target; refreshed on save entry.
        Entity_SetVarString("AreaInsertOmniTool_ObsTunnel", "VRUseTarget", "ObservationTunnelTerm");

		VR_RemoveUnusedClimbPrompt();
		MainMenu_SetBGPhase(eMainMenuPhase_Initial_To_1_3);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		if(mlImageTrailID>=0)
		{
			cLux_AddDebugMessage("FadeOutImageTrail!");
			Effect_ImageTrail_FadeOut(mlImageTrailID,10.0f);
			mlImageTrailID=-1;
		}
	}

	//-------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		////////////////////////////
		// Activate hanging robot scare on gaze
		if (mbInfectedRobotReleased == false &&
			mbInfectedRobotTwitched == false &&
			EyeTracking_IsEnvironmentReactive() &&
			EyeTracking_IsEntityBeingLookedAt("blockbox_hanging_robot_1"))
		{
			float fDist = (Map_GetEntity("blockbox_hanging_robot_1").GetPosition() - Player_GetPosition()).Length();
			if (fDist > 4.0f) return;
			RobotTwitch();
		}
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// The player has died.
	void OnPlayerKilled(int alRecentDeaths, const tString&in asSource)
	{
		cLux_AddTodoMessage("SCRIPT: Conditions for player having died.. SOURCE: " + asSource);
		
		if (asSource == "infected_robot")
		{
			mbKilledByRobot = true;
		}
		
	}

	//-------------------------------------------------------
	
	void DebugMyParticle(const tString &in asPSName, const tString &in asEntityName)
	{
		array<cParticleSystem@> vParticleSystems;
		Map_GetParticleSystemArray(asPSName, vParticleSystems);
		
		if(vParticleSystems.length() == 0)
		{
			Error("Could not find particle system "+asPSName+" for ParticleSystem_SetBrightness.");
			return;
		}
			
		for(uint i=0; i<vParticleSystems.length(); ++i)
		{
			cParticleSystem@ pPS = vParticleSystems[i];
			cLux_AddDebugMessage(""+asPSName + " has coord : " + pPS.GetWorldPosition());
		}
		
		iLuxEntity@ pEntity = cLux_GetCurrentMap().GetEntityByName(asEntityName, eLuxEntityType_LastEnum, "");
		if (pEntity is null)
		{
			Error("could not find entity " + asEntityName);
			return;
		}
		cLux_AddDebugMessage(""+asEntityName + " has coord : " + pEntity.GetPosition());
	}


	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test1)
		{
			
			/*cLuxClosestEntityData pData;
			if (!cLux_GetClosestEntity(cLux_GetPlayer().GetCamera().GetPosition(),cLux_GetPlayer().GetCamera().GetForward(),100, 0, false, pData))
				return;
				
			tString sEntity = pData.mpEntity.GetName();

			Button_SetLocked(sEntity, !Button_IsLocked(sEntity), true);
			Lamp_SetLit(sEntity, !Lamp_GetLit(sEntity), true);
			SlideDoor_SetClosed(sEntity, false, false);*/
			
			
			ReleaseInfectedRobot();
			//Entity_PlaceAtEntity("box_spare_fuses_1","ClimbArea_1");
			//Effect_ToneMapping_FadeWhiteCut(3.5, 10);
		}
		
		if(alAction == eAction_Test2)
		{
			Entity_CallEntityInteract("OmniTool");
			//SequenceFenceBreak("");
			//Sound_CreateAtEntity("RobotBehindDoor", "01_01_upsilon_awake/sfx/construct_behind_door", "RobotBehindDoorSoundSource");
			//Lamp_SetLit("lamp_dynamic_*",true,true);
			//Player_SetAmbientLight_None(true);
			//Map_AddTimer("timer_openchipcontainer",1.05f,"TimerOpenChipContainer");
			//Sound_CreateAtEntity("ChipDoorOpen", "01_01_upsilon_awake/sfx/omnitool/chip_door_open", "ChipContainer_Door");
		}
		
		if (alAction == eAction_Test3)
		{
			Entity_CallEntityInteract("OmniTool_Configured");
			mbOmniToolConfigured = true;
			
		}
		
		if (alAction == eAction_Test4)
		{
			RobotBreaksFences();
		}
		
		if (alAction == eAction_Test5)
		{
			//Map_AddTimer("timer_doorbang",1.5f,"TimerRobotPoundsOnDoor");
			//ReleaseInfectedRobot();
			Map_AddTimer("OpenAquariumDoor", 2.0f, "OpenAquariumDoor");
		}
		if (alAction == eAction_Test6)
		{
			Player_EquipTool("OmniTool");	
		}
		if (alAction == eAction_Test7)
		{
			Player_UnequipTool();
		}
		if (alAction == eAction_Test8)
		{
			Map_ChangeMap("01_02_upsilon_inside.hpm", "machine_room", "", "");
		}
		
	}

