	//-------------------------------------------------------
	
	bool OmniTool_CanBeUsed(const tString &in asTool, const tString &in asEntity)
	{
		if (asEntity == "AreaInsertOmniTool_TechRoom") return true;
		if (asEntity == "ObservationTunnelTerm") return true;
		if (asEntity == "ObservationTunnelTerm_1") return true;
		
		return false;
	}
	
	//-------------------------------------------------------
	
	bool OmniTool_OnUse(const tString &in asTool, const tString &in asEntity)
	{
		//////////////////////////////////////
		// Placing tool in to the configuration terminal
		if (asEntity == "AreaInsertOmniTool_TechRoom")
		{
			PlaceOmniToolInTerminal();
			return true;
		}
		
		////////////////////////////////////////////
		// Player tries to open door with wrong omnitool
		if (asEntity == "ObservationTunnelTerm")
		{
			cLux_AddTodoMessage("SCRIPT: Player cannot open this yet! Give feedback!!");
			CathTool_UseOnPanel("OmniTool","ObservationTunnelTerm");
			OmniPanel_AccessDenied("ObservationTunnelTerm");
			//Voice_Play("2K_OmniToolNotConfigured");
			return false;
		}
		
		return false;
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaOmniToolPopup(const tString &in asParent, const tString &in asChild, int alState)
	{
		////////////////////////////////////
		// When omnitool pops up for the first time
		if (alState != 1) return true;
		if (Player_ToolIsInInventory("OmniTool") == false && Player_ToolIsInInventory("OmniTool_Configured") == false) return true;
		Sound_CreateAtEntity("OmnitoolDetect", "01_01_upsilon_awake/sfx/omnitool/omni_door_detect", "AreaInsertOmniTool_ObsTunnel");
		
		/*if (mbOmniToolConfigured == false)
			Voice_Play("ReactingToOmnitool");*/
			
		return false;
	}
	
