	//--------------------------------------------------------------------	
	
	bool StartRoomMusic_OmnitoolPickedUp(const tString &in asParent, const tString &in asChild, int alState)
	{

		if (alState == 1)
		{
			Map_AddTimer("StopAmbientMusicQuickly", 1.0f, "AmbientMusicHandler");	
		}

		else if (alState == -1)
		{
			Map_AddTimer("StartAmbient", 1.0f, "AmbientMusicHandler");
		}
		return true;
	}
	
