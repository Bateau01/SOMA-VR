	bool CollideStartCollapse(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
		{
			SequenceReactToEnvironment("");
			Entity_SetActive("AreaStartCollapse_*",false);
			Entity_SetActive("AreaLookAtRoom",false);
			Voice_Play("1B_PowerOn_BeforeCollapse");
		}
		
		return true;
	}
	
