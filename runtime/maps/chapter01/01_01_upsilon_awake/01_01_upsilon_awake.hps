	/////////////////////////////////////////
	// Scene 3 Event G *Press door button (dialog)*
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	bool mbPlayerZappedByDoor = false;
	tString msTargetShockPoint = "";
	tString msOffendingPanel = "";
	
	//-------------------------------------------------------
	
	void StorageDoor_Control_4_OnPlayerInteract(const tString &in asEntity)
	{
		if (mbDoorDrained) return;
		

		
		///////////////////////////////////////
		// When player interacts with the panel they will receive damage
		//if (mbPlayerZappedByDoor == false)
		//{
			//mbPlayerZappedByDoor = true;
			
			cLux_AddDebugMessage("Bang! from:"+asEntity);
			cLux_AddTodoMessage("SOUND: Player gets zapped!");
			
			Depth_Audio_PlayerTakeDamage();
			Depth_Audio_SimonHurt_Damage();
			
			Player_AddBodyForceAwayFromEntity(asEntity,20000.0f);
			Player_GiveDamage(0.4f,0.5f,eDamageType_Electricity,asEntity);
			
			
			if (mbPlayerHurt == false)
			{
				mbPlayerHurt = true;
				Map_AddTimer("timer_electrocuted",1.0f,"TimerSimonElectrocuted");
			
			}
			
			msOffendingPanel = asEntity;
			if (msOffendingPanel == "exithatch_panel_locked")
				msTargetShockPoint = "Area_DoorZap_1";
			if (msOffendingPanel == "StorageDoor_Control_4")
				msTargetShockPoint = "Area_DoorZap_2";
				
			
				
			//SequencePanelZap("");
		//}
		
		
		Voice_StopAll();
		Voice_Play("3G_TalkingDoorButton");
			
		Map_RemoveTimer("timer_talkingdoor");
		Map_AddTimer("timer_talkingdoor",cMath_RandRectf(6.0f,12.0f),"TimerTalkingDoor");
		
	}
	
	//-------------------------------------------------------
		
	cSequenceStatesData mPanelZapSequence;
			
	void SequencePanelZap(const tString &in asTimer)
	{
		Sequence_Begin("SequencePanelZap", mPanelZapSequence);
			
		if (Sequence_DoStepAndWait(0.5))
		{
			///////////////////////////
			// Apply electric damage effect
			Depth_Audio_PlayerTakeDamage();
			Player_GiveDamage(0.05f, 0.1, eDamageType_Electricity, msOffendingPanel);
		
			//////////////////////////
			// Move to position
			Entity_PlaceAtEntity("Player", msTargetShockPoint);
			
			//////////////////////////
			// Get position for players head
			cVector3f vCamTarget = Player_GetCrouching() ? cVector3f_Down*0.7 : cVector3f_Down*1.5;
			vCamTarget = vCamTarget + cVector3f_Back*0.5f;
			Player_MoveHeadPos(vCamTarget, 9, 5, 0.1);
			
			//////////////////////////
			// Roll camera and reduce input speeds
			Player_FadeRollTo(75, 4, 360);
			Player_SetMoveSpeedMul(0.3);
			Player_SetLookSpeedMul(0.1);
			Player_MoveForward(-50.0f);
			
			//////////////////
			// Screen Effects
			Effect_Shake_Start(0.1, 0.1, 0, 0.4);
			Effect_VideoDistortion_Start(0.3, 0.5, 0.5,0.5,1.0f);
		}
		else if (Sequence_DoStepAndWait(1))
		{
			//////////////////////////
			// On the ground unable to move too much
			Player_SetMoveSpeedMul(0);
			Player_SetLookSpeedMul(0.05);
			
		}
		else if (Sequence_DoStepAndWait(1))
		{
			//////////////////////////////////
			// Player stands up
			Player_FadeLookSpeedMulTo(1, 1);
			Player_FadeMoveSpeedMulTo(0.3, 1);
			
			Player_FadeRollTo(0, 1.5, 270);
			Player_SetCrouching(false, false);
			Player_MoveHeadPos(cVector3f_Down*0.5, 4.5, 5, 0.2);
		}
		else if (Sequence_DoStepAndWait(2))
		{
			Player_FadeMoveSpeedMulTo(1, 1);
			Player_MoveHeadPos(cVector3f_Zero, 4.5, 5, 0.1);
		}
		else if (Sequence_DoStepAndWait(5))
		{
			Voice_StopAll();
			Voice_Play("3G_TalkingDoorButton");
		
			Map_RemoveTimer("timer_talkingdoor");
			Map_AddTimer("timer_talkingdoor",cMath_RandRectf(6.0f,12.0f),"TimerTalkingDoor");
		}

		Sequence_End();
	}
	
