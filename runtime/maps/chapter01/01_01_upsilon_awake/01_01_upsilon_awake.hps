	/////////////////////////////////////////
	// Scene 2 Event K *Pick up Omni Tool*
	/////////////////////////////////////////

	//{------------------------------------------------------
	
	//-------------------------------------------------------
	bool mbOmniToolPickUpMusic = false;
	bool mbOmniToolPickedUp = false;
	bool OmniTool_OnPickUp(const tString &in asTool)
	{
		cLux_AddTodoMessage("SCRIPT: Anything to happen when Omnitool is picked up");
		
		if(mbOmniToolPickUpMusic == false)
		{
            if(Sound_Exists("RemoveCathtoolNonunderwater"))
            {
                Sound_Stop("RemoveCathtoolNonunderwater",0.1f);
            }
			
			Map_AddTimer("StopOmnitoolPopoutSound", 0.01, "StopOmnitoolPopoutSound");
			Map_AddTimer("StopOmnitoolPopoutSound", 2.0f, "StopOmnitoolPopoutSound_TimerStop");
			Sound_CreateAtEntity("PickUpOmnitool", "01_01_upsilon_awake/sfx/omnitool/pickup_desk", "Player");
			Map_AddTimer("OmniPickupMusic", 0.45f, "OmniPickupMusic");
			Entity_SetActive("AreaStartRoomMusicHandler", true);
			mbOmniToolPickUpMusic = true;
		}
		
		
		mbOmniToolPickedUp = true;
		///////////////////////////////
		// Enable footsteps area outside tech room
		Entity_SetActive("AreaHearFootsteps",true);
		Entity_SetActive("AreaOmniToolPopup",true);
		
		//////////////////////////////
		// Enable the broken door event
		Entity_SetActive("AreaBreakFences",true);
		
		mbVentScareAllowed = true;
		
		Map_AddTimer("timer_removeomnitool",5.0f,"TimerRemoveOmnitoolPickupArea");
		Map_AddTimer("timer_showinventoryhint", 5.0f, "Timer_ShowInventoryHint");
		
		LastOnSoma_SetText("01_01_upsilon_awake_2");
		
		return true;
	}
		
