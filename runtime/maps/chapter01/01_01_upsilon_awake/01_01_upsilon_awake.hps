	/////////////////////////////////////////
	// Scene 2 Event H *Turn on power/light - Window pounding starts*
	/////////////////////////////////////////

	//{------------------------------------------------------
	
	/*variables for this scene only*/
	
	//-------------------------------------------------------
	
	bool CollideAreaCrackWindow(const tString &in asParent, const tString &in asChild, int alState)
	{
		///////////////////////////////
		// Cracks begin to appear in the window..
		if (alState == 1)
		{
			SequenceWindowCrack("");
			return false;
		}
		return true;
	}
	
	//------------------------------------------------------
	
	cSequenceStatesData mWindowCrackSequenceState;
	
	void SequenceWindowCrack(const tString &in asName)
	{
		Sequence_Begin("SequenceWindowCrack", mWindowCrackSequenceState);

		/* Time is set in the UserVar property of each glass pane as opposed to directly
		 * in script to allow it to be editted from within the editor by an artist */
		 
		if (Sequence_DoStepAndWait(2.5f))
		{
			// Some delay before glass starts cracking if you need room for juice
			cLux_AddTodoMessage("SOUND: Glass is about to crack..");
		}
		else if (Sequence_DoStepAndWait(Entity_GetVarFloat("observation_window_0","")))
		{
			Entity_SetActive("observation_window_*",false);
			Entity_SetActive("observation_window_1",true);
			cLux_AddTodoMessage("SOUND: Cracks on the window.. phase 1");
			Sound_CreateAtEntity("snd_cracking","level_02_02/events/cabin_window/hit_hammer_break","observation_window_1",0.0f,false,1.0f);			
		}
		else if (Sequence_DoStepAndWait(Entity_GetVarFloat("observation_window_1","")))
		{
			Entity_SetActive("observation_window_*",false);
			Entity_SetActive("observation_window_2",true);
			cLux_AddTodoMessage("SOUND: Cracks on the window.. phase 2");
			Sound_CreateAtEntity("snd_cracking","level_02_02/events/cabin_window/hit_hammer_break","observation_window_2",0.0f,false,1.0f);			
		}
		else if (Sequence_DoStepAndWait(Entity_GetVarFloat("observation_window_2","")))
		{
			Entity_SetActive("observation_window_*",false);
			Entity_SetActive("observation_window_3",true);
			cLux_AddTodoMessage("SOUND: Cracks on the window.. phase 2");
			Sound_CreateAtEntity("snd_cracking","level_02_02/events/cabin_window/hit_hammer_break","observation_window_3",0.0f,false,1.0f);			
		}
		
		Sequence_End();
	}
	
	//}------------------------------------------------------

	/////////////////////////////////////////
	// Scene 2 Event H *Turn on central corridor light*
	/////////////////////////////////////////

	//{------------------------------------------------------
	
	/* REMOVED */
	
	//}------------------------------------------------------

	/////////////////////////////////////////
	// Scene 2 Event I *Find suit robot, try to talk to it*
	/////////////////////////////////////////

	//{------------------------------------------------------
	
	bool mbPlayerInStorageRoom = false;			// Player in the room with him
	bool mbRobotCriedForHelp = false;			// Has he cried out when player leaves room at least once?
	
	//-------------------------------------------------------
	
	
	bool CollideAreaStorage(const tString &in asParent, const tString &in asChild, int alState)
	{
		//////////////////////////////////////////////////
		// Set up conditions when player enters storage
		if (alState == 1)
			EnterStorage();

		/////////////////////////////////////////////////
		// Set up conditions when player exits storage
		if (alState == -1)
			ExitStorage();
		
		return true;
	}
	
	//-------------------------------------------------------
	bool mbEnterStorageMusicPlayed = false;
	void EnterStorage()
	{
		mbPlayerInStorageRoom = true;
		
		if(mbPlayerOpenedAquarium == false)
		{
			Map_AddTimer("StopAmbientMusic", 1.0f, "AmbientMusicHandler");
		}
		if(mbEnterStorageMusicPlayed==false)
		{
			Music_Play("02_04_graveyard", 0.9f, false, eMusicPrio_MinorEvent);
			mbEnterStorageMusicPlayed = true;
		}
	}
	
	//-------------------------------------------------------
	
	void ExitStorage()
	{
		mbPlayerInStorageRoom = false;
		cLux_AddDebugMessage("Simon leaves storage..");
		
		if(mbPlayerOpenedAquarium == false && mbOmniToolPickedUp == true)
		{
			Map_AddTimer("StartAmbient", 1.0f, "AmbientMusicHandler");
		}
		
		/////////////////////////////////////
		// Robot calls out for help
		if (mbRobotCriedForHelp == false)
		{
			//cLux_AddDebugMessage("Robot calls out to Simon");
			//Voice_StopAll();
			//Voice_Play("2I_SuitRobotCallsOut");
			mbRobotCriedForHelp = true;
		}
	}
		
	//}------------------------------------------------------

