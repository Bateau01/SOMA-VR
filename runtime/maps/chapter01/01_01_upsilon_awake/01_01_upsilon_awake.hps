	//-------------------------------------------------------
	
	void SetupDoorMonster()
	{
		Light_SetBrightness("BoxLight_SentientDoorRoom_LightsOut",0.0f);
		Map_AddTimer("timer_doorblink",cMath_RandRectf(1.5f,2.5f),"TimerDoorCameraBlinking");
		Sound_CreateAtEntity("talkingdoornoise", "01_01_upsilon_awake/sfx/talking_door/noise", "TalkingDoorVoiceSource");
		
		Lamp_SetLit("SentientDoor_Speaker_*",false,true);
		
		Voice_SetCharacterSpeakingCallback("TalkingDoor","TalkingDoorSpeakingCallback");
		
	}
	
	//-------------------------------------------------------
	
	bool TalkingDoorSpeakingCallback(const tString &in asCharacter, bool abStartedTalking)
	{
		if (mbDoorDrained) return false;
		
		Lamp_SetLit("SentientDoor_Speaker_*",abStartedTalking,true);
		Lamp_SetFlickerActive("SentientDoor_Speaker_*",abStartedTalking);
		return true;
	}
	
	//-------------------------------------------------------
	
	void TimerDoorBreathing(const tString &in asTimer)
	{
		if (mbDoorDrained) return;
		
		Sound_CreateAtEntity("TalkingDoorRoomBreath", "01_01_upsilon_awake/sfx/talking_door/room_breathing", "Player");
		Map_AddTimer("timer_doorbreath",7.0f,"TimerDoorBreathing");
		
		Lamp_SetLit("Lamp_WauFlowerEffects",false,true);
		Map_AddTimer("timer_doorbreathout",0.6f,"TimerDoorExhale");
		
	}
	
	//-------------------------------------------------------
	
	void TimerDoorExhale(const tString &in asTimer)
	{
		if (mbDoorDrained) return;
		
		Lamp_SetLit("Lamp_WauFlowerEffects",true,true);
	}
	
	//-------------------------------------------------------
	
	void TimerDoorCameraBlinking(const tString &in asTimer)
	{
		
		Entity_SetEffectsActive("camera_surveillance_headtrack_*",mbBlinkingEffectsActive,true);
		mbBlinkingEffectsActive = !mbBlinkingEffectsActive;
		
		///////////////////////////////
		// Light should not be off for too long, as this is more like a blink!
		if (mbBlinkingEffectsActive)
			Map_AddTimer("timer_doorblink",cMath_RandRectf(0.75f,1.25f),"TimerDoorCameraBlinking");
		else
			Map_AddTimer("timer_doorblink",cMath_RandRectf(2.75f,4.5f),"TimerDoorCameraBlinking");
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaTalkingDoor(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		//////////////////////////////////
		// Player approaches sentient door and it begins talking
		Map_AddTimer("timer_talkingdoor",0.25f,"TimerTalkingDoor");
		return false;
	}
	
	//-------------------------------------------------------
	
	bool mbTalkingDoorMusic = false;
	void TimerTalkingDoor(const tString &in asTimer)
	{
		if (mbDoorDrained) return;
		
		//First time hearing the talking door
		if(mbTalkingDoorMusic==false)
		{
			Map_AddTimer("TalkingDoorMusic_Sting", 2.0f, "TalkingDoorMusic_Sting");
			mbTalkingDoorMusic = true;
		}
		
		/////////////////////////////////
		// Talking door begs for help
		if (mbDoorTrappedPlayer == false)
		{
			Voice_Play("3F_TalkingDoor");
			Map_AddTimer("timer_talkingdoor",cMath_RandRectf(6.0f,12.0f),"TimerTalkingDoor");
		}
		
		/////////////////////////////////
		// Talking door has trapped player and just weeps
		if (mbDoorTrappedPlayer == true)
		{
			Voice_Play("3F_TalkingDoorWeeps");
			Map_AddTimer("timer_talkingdoor",cMath_RandRectf(6.0f,12.0f),"TimerTalkingDoor");
		}
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaTalkingDoorCloses(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		//////////////////////////////////////
		// The door closes, angry and screaming at the player
		Map_RemoveTimer("timer_talkingdoor");
		Voice_StopAll();
		
		Voice_Play("3F_TalkingDoorCloses");
		SlideDoor_SetClosed("SentientDoor",true,false);
		
		Lamp_SetFlickerActive("Lamp_SentientDoorRoom",true);
		Map_AddTimer("timer_sentientdoorlights",0.5f,"TimerSentientDoorLights");
		Map_AddTimer("TalkingDoorMusic", 0.15f, "TalkingDoorMusic");
		//////////////////////////////
		// Fade the light in this room so things aren't completely dark
		Light_SetBrightness("BoxLight_SentientDoorRoom_LightsOut",0.8f);
		
		//turn off ext sparks and turn on interior ones to stop sound from leaking through
		Light_SetFlickerActive("PointLight_storage_wau_flower_3", true);
		Light_SetFlickerActive("PointLight_storage_wau_flower_2", true);
		Light_SetFlickerActive("PointLight_storage_wau_flower_1", false);
		
		//////////////////////////////////////////
		// Disable overhead particles
		ParticleSystem_Destroy("ParticleSystem_55");
		
		PreloadPriorityHigh();
		
		///////////////////////////////////////////////////
		// Disable oxymeter outside the room and start our breathing effect
		Entity_SetActive("lifesupport_oxymixer_2",false);
		Map_AddTimer("timer_doorbreath",1.0f,"TimerDoorBreathing");
			
		return false;
	}
	
	//-------------------------------------------------------
	
	void TimerSentientDoorLights(const tString &in asTimer)
	{
		/////////////////////////////////
		// Talking door goes crazy, lights go out
		Lamp_SetFlickerActive("Lamp_SentientDoorRoom",false);
		Lamp_SetLit("Lamp_SentientDoorRoom",false,true);
		Player_SetAmbientLight_Indoors(true);
		Sound_CreateAtEntity("TalkingDoorClose", "01_01_upsilon_awake/sfx/talking_door_close_sweetener", "Player");

		////////////////////////////////
		// Talking door will begin weeping again
		mbDoorTrappedPlayer = true;
		Map_AddTimer("timer_talkingdoor",cMath_RandRectf(6.0f,12.0f),"TimerTalkingDoor");
		
		PreloadPreDeload();
	}
	
