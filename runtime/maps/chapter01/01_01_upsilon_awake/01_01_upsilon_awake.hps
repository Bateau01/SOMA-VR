		Map_AddTimer("timer_kitchenflower",4.0f,"TimerDrainKitchenLights");
	}
	
	void TimerDrainKitchenLights(const tString &in asTimer)
	{
		Lamp_SetLit("Lamp_Hallway_InsideKitchen",false,true);
		Lamp_SetLit("Lamp_Hallway_OutsideKitchen",false,true);
	}

