	bool CollideAreaBreakFences(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		// Skipping techroom broken door for beta
		cLux_AddTodoMessage("SOUND: Smash the door, tear the fences. Smash the door, tear the fences");
		
		/*Entity_SetActive("techroomwreck_door_busted",true);
		Entity_SetActive("techroom_door",false);
