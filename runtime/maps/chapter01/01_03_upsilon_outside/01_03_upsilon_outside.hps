const cColor gCommRoomFogColor = cColor(0.126,0.152,0.146,0.376);
const cColor gOceanFogColor = cColor(0.009,0.028,0.035,1);

class cScrMap : iScrMap
{
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// MAIN CALLBACKS
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	//-------------------------------------------------------
	
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		GetBase().SetDisplayNameEntry("01-03-upsilon-outside");
				
		///////////////////////////////
		// Setup presets
		{
			/////////////////////////////
			//1.4 Map presets to fade to when transition
			Map_Preset_SetupColorGrading("Level1.4", "textures/colorgrading/grading_01_04.dds");
			//Map_Preset_SetupToneMapping("Level1.4", 0.5f, 0.0f, 3.5f);
			//Map_Preset_SetupDirLight("Level1.4", false, cColor(0,0,0,0), 0, cVector3f(0,0,0), cColor(0,0,0,0), cColor(0,0,0,0));
		}
		
		Entity_SetVarBool("AirlockPanelArea_1", "IsOmniPanel", true);
		
		CathTool_ResetScreen(eCathToolVariant_HelperJane);
		cTerrain@ pTerrain = cLux_GetCurrentMap().GetWorld().GetTerrain();
		if(pTerrain !is null) pTerrain.SetCheapMaterial("sand_wavy.mat", 0.5f);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{		
		OmnitoolGui_Preload();

		PlayerHands_PreloadHandModel_Diving();
		PlayerHands_PreloadHandModel_Human();
		
		ParticleSystem_Preload("01_03_loop_bubbles_swoosh.ps");
		ParticleSystem_Preload("01_03_oneshot_bubbles_player.ps");
		ParticleSystem_Preload("drops_med_continuous_short.ps");
		ParticleSystem_Preload("elec_spark_oneshot.ps");
		ParticleSystem_Preload("loop_waterbubbles_large_cloud.ps");
		ParticleSystem_Preload("oneshot_waterbubbles_big.ps");
	}
	
	//-------------------------------------------------------
	
	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		
		/////////////////////////////////////////////////
		// Audio setup
		Sound_SetGlobalVolume(0.0f, eSoundEntryType_WorldAll);
		Sound_PreloadProject("01_03_upsilon_outside");
		Sound_PreloadGroup("Flashback/Level/01_03", true);
		Sound_CreateAtEntity("TrapAlarm", "01_03_upsilon_outside/katebot/katebot_help", "InfectedKate_AI", 0.0f, false, 1.0f);

		//--------------------------------------------------------------

		Map_SetUnderwater(true);
		
		SetupTaintedPumpStation();
		SetupSignalTowerArea();
		SetupExitDoor();
		SetupStuckKate();
		
		//SetupEndOfLevelWelding
		{
			Entity_SetEffectsActive("BunkerWeldingFlare", false, false);
			LensFlare_SetVisible("BunkerWeldingFlare_LensFlare_*", false);
		}
		
		bool bDoIntro = true;
		
		//////////////////////////////////////////
		// Player setup
		Player_SetAmbientLight_Outdoors();
		
		PlayerHands_SetHandModel_Diving();
		
		Player_SetFlashlightOnOffCallback("Flashlight_FirstTime");
		Entity_SetInteractionDisabled("LaunchSiteDoor", true);
		
		///////////////////////////////////////////////////
		//Airlock sound
		Sound_CreateAtEntity("Pump_Idle_Loop_Underwater", "Entities_OceanBottom/airlock/uw/pump/idle_loop", "Pump_SoundSource", 1.0f, false, 1.0f);
		
		ParticleSystem_SetActive("airlock_drain_leak_*", false);
		ParticleSystem_SetActive("airlock_drain_droplets_*", false);
		ParticleSystem_SetActive("airlock_drain_droplets2_*", false);
		
		Lamp_SetLit("lamp_room_1_*", false, false);
		
		//----DEBUG----//
		if(cLux_ScriptDebugOn())
		{
		//	OpenFinalDoor();
			//Preload();
			Entity_SetActive("CathTool", true);
			
			bDoIntro = false;
			Sound_FadeGlobalVolume(1.0f, 1.0f);
			/////////////////////////
			// Debug AI
			//mbPlayerAtCharger = true;
			//KateCopyChargeEvent("", "", 1);
		}
		
		if (bDoIntro)
			SequenceIntro("");
		
		LastOnSoma_SetText("01_03_upsilon_outside_1");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
        // S26BC: physical surface -> exact native tool-use target; refreshed on save entry.
        Entity_SetVarString("AirlockPanel_1", "VRUseTarget", "AirlockPanelArea_1");

		MainMenu_SetBGPhase(eMainMenuPhase_1_3_To_2_4);
		
		cLux_GetCurrentMap().GetWorld().SetFogUnderwater(true);
		
		float fFadeTime = 0.0;
		Effect_Bloom_FadeBrightPass(0.00001, fFadeTime); //sets pixels over 127 (255 * 0.5) to add to bloom
		Effect_Bloom_FadeBloomWidth(160, fFadeTime); //sets 128 pixels in bloom width, looks best within 32 - 512 pixels.
		Effect_Bloom_FadeBloomTint(0.3, 0.3, 0.3, fFadeTime); //sets red tint to bloom
		
		Effect_DoF_Start(0.05, 12, 1.0f, 3);
		
		//iTexture@ pSkybox = cResources_CreateTextureCubeMap("grayscale_gradient_1_4_fog.dds",false);
		cLux_GetCurrentMap().GetWorld().SetFogSkyboxTexture(null);

		Tool_PickUp("CathTool", false, false); 
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		Music_Stop(1.0f, eMusicPrio_BgAmb);
	}
	
	//-------------------------------------------------------
	
	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afY)
	{
		bool bHidden = cLux_GetPlayer().GetVisibilityMaxRange()>0 || cLux_GetPlayer().GetVisibilityRangeMul()<1;
		afY = cLux_DrawDebugText("Hidden: "+bHidden, afY);
		return afY;
	}
	
	//-------------------------------------------------------
	
	void OnGui(float afTimeStep)
	{
		if(cLux_ScriptDebugOn()==false) return;	
		
		ImGui_LayoutBegin(eImGuiLayout_XY, cVector3f(500, 0,0), cVector2f(400,0));
		
		ImGui_LayoutEnd();
	}
	
	//-------------------------------------------------------
	
	void OnAction(int alAction, bool abPressed)
	{
		if(abPressed==false)
			return;
			
		if (alAction == eAction_Test1)
		{					
			Entity_SetActive("BunkerWeldingFlare", true);
			Entity_SetEffectsActive("BunkerWeldingFlare", true, true);
			LensFlare_SetVisible("BunkerWeldingFlare_LensFlare_*", true);
		}
			
		if (alAction == eAction_Test2)
		{
			Button_SetSwitchedOn("AirlockPanel_1", true, false);
			//Terminal_ForceCacheUpdate("AirlockPanel_1");
		}
		
		if (alAction == eAction_Test3)
		{			
			Entity_SetActive("InfectedKate_AI", true);
			Entity_SetEffectsActive("InfectedKate_AI", true, true);
			Entity_PlaceAtEntity("InfectedKate_AI", "Player", cVector3f_Up*2);
			
			mbFinalDoorOpened = true;
			
			Kate_Investigate("InfectedKate_AI", "BunkerWeldingPos", "BunkerWeldingFlare", -1, "KateAtPanel_LaunchSite");
			
			Map_RemoveTimer("auto_weld");
			Entity_SetActive("LaunchSiteEntranceProximity", false);
			
			Entity_SetPlayerInteractCallback("LaunchSiteDoor", "", false);
		}
		if (alAction == eAction_Test4)
		{	
			cParticleSystemIterator@ pIt = cLux_GetCurrentMap().GetWorld().GetParticleSystemIterator();
			
			cLux_AddDebugMessage("------- PS BEGIN ----------");
			while(pIt.HasNext())
			{
				cParticleSystem@ pPS = pIt.Next();
				
				if(cString_GetLastStringPos(pPS.GetName(),"InfectedKate")>=0)
				{
					//pPS.SetActive(true);
					
					cLux_AddDebugMessage("Name: "+pPS.GetName());					
				}
			}
			cLux_AddDebugMessage("------- END ----------");
		}
		if (alAction == eAction_Test5)
		{
			cLux_AddDebugMessage("PRELOAD");
			Preload();
		}
		if (alAction == eAction_Test6)
		{
			iCharacterBody@ body = cLux_ToAgent(Map_GetEntity("InfectedKate_AI")).GetCharBody();
			body.SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag("-player"));
			//Entity_SetCollideCharacter("InfectedKate_AI", false);
			//cLux_AddDebugMessage(.GetName());
			//cLux_ToAgent(Map_GetEntity("InfectedKate_AI")).GetCharBody().SetCollideCharacter(false);
		}
		if (alAction == eAction_Test7)
		{
			iCharacterBody@ body = cLux_ToAgent(Map_GetEntity("InfectedKate_AI")).GetCharBody();
			body.SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag("+player"));
		}
	}
	
	void Flashlight_FirstTime(bool abLit)
	{	
		cLux_AddDebugMessage("You discovered the flashlight!");
		
		Map_AddTimer("Timer_PlayFlashlightDiscoveryLine", 1, "Timer_PlayFlashlightDiscoveryLine");
						
		cScript_SetGlobalVarBool("PlayerActivatedFlashlight", true);
		
		Player_SetFlashlightOnOffCallback("");
	}
		
	void Timer_PlayFlashlightDiscoveryLine(const tString &in asTimer)
	{
		Voice_PlayWhenPossible("GetFlashlightUnderwater", "", 15.0f, 2.0f, "Flashlight_OnCommentOver");
	}
	
	void Flashlight_OnCommentOver(const tString&in asScene, const tString&in asSubject)
	{
		Map_AddTimer("", 2.0f, "Timer_ShowFlashlightHint");
	}
	
	void Timer_ShowFlashlightHint(const tString &in asTimer)
	{
		Hint_ShowInfo("Hints","HintFlashlight", true, 1.5f, false);
	}
	
	//-------------------------------------------------------
	
/*	void Update(float afTimeStep)
	{
		
	}*/
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// 1 EMERGE FROM COMM ROOM
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// 1 INTRO
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	cSequenceStatesData mIntroSequence;
	
	void SequenceIntro(const tString &in asTimer)
	{
		Sequence_Begin("SequenceIntro", mIntroSequence);
		
		//SETUP DURING BLACK
		if (Sequence_DoStepAndWait(2.5f))
		{
			cScript_SetGlobalArgInt(0,0);
			cScript_RunGlobalFunc("PlayerHandsHandler","","HPL3VR_SetSceneOverride");
			Player_SetFlashlightDisabled(true);
			Effect_Fade_Out(0);
			Effect_ImageTrail_Start(1.5, 0.2, 10, 2);
			
			////////////////////
			// Set fog color
			Map_FadeFogColor(gOceanFogColor,0);
		}
		if (Sequence_DoStepAndWait(5.508f))
		{
			Sound_CreateAtEntity("IntroDRONE", "01_03_upsilon_outside/SFX/intro/sequence/drone", "Player");
			Sound_CreateAtEntity("IntroSFX", "01_03_upsilon_outside/SFX/intro/sequence/sfx", "Player");
		}
		
		//BEGIN INTRO DURING BLACK
		if (Sequence_DoStepAndWait(0.5f))
		{
			ParticleSystem_CreateAtEntityExt("bubblyBubbles", "loop_waterbubbles_large_cloud.ps", "PSCamBubbles", true, cColor(0.512,0.789,0.724, 1));
			ParticleSystem_CreateAtEntityExt("bubblyFlow", "01_03_loop_bubbles_swoosh.ps", "PSIntroFlow", true, cColor(0.512,0.789,0.724, 1));
			
			CameraAnimation_Begin("AnimIntro", "", true);
			CameraAnimation_SetAttachedEntity("PSCamBubbles", false, false, false);
			Entity_SetActive("AMB_INT_DomeRoom", true);
			////////////////////
			// Play music
			//TODO: Have some other type of music (need to check and work with end of 1.2) 
			//Think it works fine if the music ends and then no music plays until you are closer 
			//to the semi scary bot.
			//Music_Play("01_03_intro", 0.45f, false, eMusicPrio_BigEvent);
		}
		
		//FADE IN SCENE
		else if (Sequence_DoStepAndWait(1.5))
		{		
			//Insta fade
			Effect_Fade_In(0.0f);
			Player_StartLookAt("AreaLookAtIntro", 1, 1, 1);
			Sound_CreateAtEntity("IntroFoley", "01_03_upsilon_outside/SFX/intro/sequence/foley", "Player");
		}
		
		//REMOVE PARTICLES (Not all) FROM INTRO AND STOP SHORT LOOK AT
		else if (Sequence_DoStepAndWait(0.5))
		{	
			ParticleSystem_Destroy("bubblyBubbles");
		}
		else if (Sequence_DoStepAndWait(0.75))
		{	
			ParticleSystem_Destroy("bubblyFlow");
			Player_StopLookAt(1);
		}
	
		//REST OF EVENT DURING INTRO OUR CALLBACKS FROM CAM ANIMATION. FOUND BELOW.
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	//TRIGGERS AS PLAYER IS ON BACK LOOKING UP
	bool IntroEnd(const tString &in asEntity, int alDirection)
	{
		//Fade up audio
		Sound_FadeGlobalVolume(1.0f, 5.0f);
		
		cLux_AddTodoMessage("Sound: Player on ground thud.");
		CameraAnimation_Begin("AnimIntroGettingUp", "", true);
		
		//Needs tweak but particle editor crashing too much at the moment
		ParticleSystem_CreateAtEntityExt("bubblyBubbles02", "01_03_oneshot_bubbles_player.ps", "PSCamBubbles", true, cColor(0.512,0.789,0.724, 1));
		
		return true;
	}
	
	//-------------------------------------------------------
	
	//HALF WAY UP AFTER LYING ON BACK
	bool IntroComment(const tString &in asEntity, int alDirection)
	{
		ParticleSystem_Destroy("bubblyBubbles02");
		
		cLux_AddTodoMessage("Sound: Player getting up.");
		
		Dialog_Begin();
			Dialog_AddBranch("Intro");
				Dialog_AddSubject("Intro_Breath");
				Dialog_AddPause(3);
				Dialog_AddSubject("LeftCommRoom");
		Dialog_End();

		return true;
	}
	
	//-------------------------------------------------------
	
	void LineOver_ShowPlayerHands(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStartOfLine)
	{
		if(abStartOfLine) return;
		Seq_ShowPlayerHands("");
	}
	
	cSequenceStatesData mShowPlayerHandsSequence;
	bool mbDistortionSweet = false;
	void Seq_ShowPlayerHands(const tString &in asTimer)
	{
		Sequence_Begin("Seq_ShowPlayerHands", mShowPlayerHandsSequence);
			
		if (Sequence_DoStepAndWait(0.15))
		{
			PlayerHands_SetHandModel_Human();
			PlayerHands_SetUseCustomPosition(false);
			PlayerHands_SetUseCustomRotation(false);
			PlayerHands_PlayAnimation("event_look_at_hands_1_3");
			
			cLux_AddDebugMessage("PLAY HAND ANIMATION!");
			
			Player_SetCrouchDisabled(false);
			
			Emotion_StartHeartbeat(0.6,1.0f,1, 15);
			Emotion_StartBackgroundBreath(eBreathType_Fear, 1, 1, 1.25, 0.5, 0.2);
			
			Effect_VideoDistortion_Start(0.4, 0.25, 0.0, 0.2);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Sound_PlayGui("01_03_upsilon_outside/SFX/intro/looks_at_hands",1.0f, eSoundEntryType_Gui);
		}
		
		///////////////////
		// First flicker
		SeqStep_ShowPlayerHands_StartDistortion(0.35);
		if (SeqStep_ShowPlayerHands_SetHandModel(0.2, "Diving"))
			Effect_Rumble_Start(0.4, 0.44);
		SeqStep_ShowPlayerHands_SetHandModel(0.03, "Human");
		SeqStep_ShowPlayerHands_SetHandModel(0.06, "Diving");
		
		if (Sequence_DoStepAndWait(0.01))
		{
			Depth_Audio_SimonGasp();
		}
		SeqStep_ShowPlayerHands_SetHandModel(0.1, "Human");
		SeqStep_ShowPlayerHands_StopDistortion(0.65);
		
		///////////////////
		// Second flicker
		SeqStep_ShowPlayerHands_StartDistortion(0.25);
		if (SeqStep_ShowPlayerHands_SetHandModel(0.05, "Diving"))
			Effect_Rumble_Start(0.4, 0.9);
		SeqStep_ShowPlayerHands_SetHandModel(0.075, "Human");
		SeqStep_ShowPlayerHands_SetHandModel(0.06, "Diving");
		SeqStep_ShowPlayerHands_SetHandModel(0.05, "Human");
		SeqStep_ShowPlayerHands_SetHandModel(0.2, "Diving");
		SeqStep_ShowPlayerHands_SetHandModel(0.1, "Human");
		SeqStep_ShowPlayerHands_StopDistortion(0.15);
		
		///////////////////
		// Third flicker
		SeqStep_ShowPlayerHands_StartDistortion(0.1);
		SeqStep_ShowPlayerHands_SetHandModel(0.15, "Diving");
		if (Sequence_DoStepAndWait(0.01))
		{
			Depth_Audio_SimonGasp(2);
		}
		SeqStep_ShowPlayerHands_StopDistortion(3);
		
		if (Sequence_DoStepAndWait(0.01))
		{
			cLux_AddDebugMessage("Breathe");
			Emotion_StartBackgroundBreath(eBreathType_Fear, 1, 1, 1, 0.25, 10);
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	bool SeqStep_ShowPlayerHands_StartDistortion(float afDelay)
	{
		if (Sequence_DoStepAndWait(afDelay))
		{
			cLux_AddDebugMessage("SeqStep_ShowPlayerHands_StartDistortion");
			Effect_VideoDistortion_Start(1, -1, 0.0, 0, 0.8);
			
			if(mbDistortionSweet==false)
			{
				mbDistortionSweet = true;
				Sound_CreateAtEntity("DistortionSweet", "01_03_upsilon_outside/SFX/hand_glitch", "Player");
			}
			
			return true;
		}
		return false;
	}
	
	//-------------------------------------------------------
	
	bool SeqStep_ShowPlayerHands_StopDistortion(float afDelay)
	{
		if (Sequence_DoStepAndWait(afDelay))
		{
			cLux_AddDebugMessage("SeqStep_ShowPlayerHands_StopDistortion");
			Effect_VideoDistortion_FadeOut(-1, 0.2);
			return true;
		}
		return false;
	}
	
	//-------------------------------------------------------
	
	bool SeqStep_ShowPlayerHands_SetHandModel(float afDelay, const tString &in asModel)
	{
		if (Sequence_DoStepAndWait(afDelay))
		{
			Effect_Fade_Out(0.04);
			Map_AddTimer("Timer_SetHandModelFadeIn", 0.025, "Timer_SetHandModelFadeIn");
			
			cAnimationState@ pAnimState = PlayerHands_GetCurrentAnimationState();
			
			if (asModel == "Human")
				PlayerHands_SetHandModel_Human();
			else
				PlayerHands_SetHandModel_Diving();
		
			if (pAnimState !is null)
			{
				PlayerHands_PlayAnimation(pAnimState.GetName(), pAnimState.IsLooping(), false, 0, "", true, pAnimState.GetSpeed(), pAnimState.GetRelativeTimePosition());
			}
			return true;
		}
		return false;
	}
	
	void Timer_SetHandModelFadeIn(const tString &in asTimer)
	{
		Effect_Fade_In(0.025);
	}
	
	//-------------------------------------------------------

	//STANDING BUT LOOKING DOWN, SOON AFTER FULLY STANDING AND INTRO OVER.
	bool IntroHands(const tString &in asEntity, int alDirection)
	{
		Music_PlayExt("01_03_wakeupintro", false, 0.45f, 1.0f, 3.0f, 1.0f, eMusicPrio_MinorEvent, false);

		return true;
	}

	//-------------------------------------------------------
	
	bool IntroOver(const tString &in asEntity, int alDirection)
	{
		cScript_SetGlobalArgInt(0,-1);
		cScript_RunGlobalFunc("PlayerHandsHandler","","HPL3VR_SetSceneOverride");

		Player_SetFlashlightDisabled(false);
		return true;
	}

	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// 1A PLAYER CLIMBS OUT OF WINDOW
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbFirstTimeClimb = false;
	bool mbSimonObjectiveLineSaid =false;
	
	void AreaClimbHole_OnPlayerInteract(const tString &in asEntity)
	{		
		Entity_AttachToEntity("ExitStartAnimation_2", "ExitStartAnimation_1", "", true);
		CameraAnimation_Begin("ExitStartAnimation", "", false);
		//PlayerHands_PlayAnimation("event_climb_of_dome_start_1_3", false, false, 0,"", false,1,-1);
		
		Sound_CreateAtEntity("PreClimb", "01_03_upsilon_outside/SFX/intro/player_preclimbout", "Player");
		Sound_CreateAtEntity("PreClimbVO", "01_03_upsilon_outside/SFX/intro/player_preclimbout_vo", "Player");
				
		/////////////////////////////////
		// Disable area so player can't climb from outside
		Entity_SetActive(asEntity,false);	
	}
		
	//-------------------------------------------------------
	
	bool CamAnim_ClimbJump(const tString &in asEntity, int alDirection)
	{
		
		return true;
	}
		
	//-------------------------------------------------------
	
	bool CamAnim_StartExitAnim(const tString &in asEntity, int alDirection)
	{
		CameraAnimation_End();
		cLux_AddDebugMessage("Animation start");
		Player_SetGravityEnabled(false);
		
		Sound_Stop("PreClimb", 0.25f);
		Sound_Stop("PreClimbVO", 0.25f);
		
		Sound_CreateAtEntity("ClimbAnim", "01_03_upsilon_outside/SFX/intro/player_climbout_building", "Player");
		Emotion_PlayEventBreath("01_03_upsilon_outside/SFX/intro/player_climbout_building_vo", 2);
		
		PlayerHands_SetUseCustomPosition(true);
		PlayerHands_SetCustomPositionFromEntity("ClimbAnimationOffset");
		PlayerHands_SetUseCustomRotation(true);
		PlayerHands_SetCustomRotation(cVector3f(0, cMath_PiDiv2, 0));
		PlayerHands_PlayAnimation("event_climb_of_dome_1_3", false, true, 0,"", true,1,-1);
		PlayerHands_SetAnimationOverCallback("HandAnimOver_ClimbedOut");
		
		PlayerHands_AttachCameraToSocket("Socket_Camera", 0, "", true,true,3, 
										cVector3f(0,0,0), 0);
												
		Map_AddTimer("Timer_DomeClimbSound", 6.5, "Timer_DomeClimbSound");
		
		return true;
	}
		
	//-------------------------------------------------------
	
	void Timer_DomeClimbSound(const tString &in asTimer)
	{		
		//Check if player has already climbed out window before, 
		//if so, don't retrigger music
		if (mbFirstTimeClimb==false)
		{
			cLux_AddDebugMessage("First time climb out - triggering music");
			Music_Stop(6.0f, eMusicPrio_BgAmb);
			Music_Stop(4.0f, eMusicPrio_MinorEvent);
			Map_AddTimer("FirstExitMusic",5.5f, "ExitingDomeMusic");
			mbFirstTimeClimb = true;
			return;
		}

		cLux_AddDebugMessage("Player has already climbed out - not triggering music");
	}
		
	//-------------------------------------------------------
		
	void HandAnimOver_ClimbedOut(const tString&in asAnim)
	{
		Player_SetGravityEnabled(true);
		Player_Teleport("PlayerStart_DomeExit");
		Player_SetActive(false);
		Map_AddTimer("HandAnimOver_ActivatePlayer", 1.75, "HandAnimOver_ActivatePlayer");
		
		if(mbSimonObjectiveLineSaid==false)
		{
			Map_AddTimer("ExitHoleVoice", 18, "SimonUnderwaterComment");
			mbSimonObjectiveLineSaid = true;
		}
	}
		
	//-------------------------------------------------------
	
	void HandAnimOver_ActivatePlayer(const tString &in asTimer)
	{
		Player_SetActive(true);
	}
		
	//-------------------------------------------------------
	
	bool CollideHoleArea(const tString &in asParent, const tString &in asChild, int alState)
	{
		/////////////////////////////////
		// When near the hole activate the climbable area
		// When leaving it - disable it!
		cLux_AddDebugMessage("CollideHoleArea");
		bool bClimbActive = alState == 1 ? true : false;
		Entity_SetActive("AreaClimbHole",bClimbActive);
		
		///////////////////////////////////
		// Always preserve this trigger in case the player comes back inside
		return true;
	}
	
