	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	void SetupStuckKate()
	{
		Entity_SetAnimationPaused("InfectedKate_Static", "idle", true);
	}
	
	//-------------------------------------------------------
	
	void InteractKateRock(const tString &in asEntity)
	{
		Prop_SetStaticPhysics("InfectedKateRock_1", false);
		Prop_SetStaticPhysics("InfectedKateRock_2", false);
	}
	
	//-------------------------------------------------------
	
	bool CollisionInfectedKateRockMoved(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1 || Entity_GetCollide(asParent, "InfectedKateRock_1") || 
			Entity_GetCollide(asParent, "InfectedKateRock_2") || 
			Entity_GetCollide(asParent, "InfectedKateRock_3"))
			return true;
		
		SequenceInfectedKateRescued("");
		
		Entity_SetActive(asParent, false);
		
		return false;
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mInfectedKateRescuedSequence;
		
	void SequenceInfectedKateRescued(const tString &in asTimer)
	{
		Sequence_Begin("SequenceInfectedKateRescued", mInfectedKateRescuedSequence);
		
		if (Sequence_DoStepAndWait(1.f))
		{
			Lamp_SetLit("PowerBox_Lamp", false, true);
			Entity_SetInteractionDisabled("PowerCable_*", true);
			Entity_SetActive("PowerCable_*_Aux", false);
			
			ParticleSystem_Destroy("KateInfected_Bubbles_1");
			ParticleSystem_Destroy("KateInfected_Bubbles_2");
		}
		
		else if (Sequence_DoStepAndWait(0.5))
		{		
			Prop_MoveLinearTo("InfectedKate_Static", "InfectedKateRiseTarget", 1, 1, 0.2, true);
			Prop_AlignRotation("InfectedKate_Static", "InfectedKateRiseTarget", 1, 0.25, 0.2, false);
			Entity_SetAnimationPaused("InfectedKate_Static", "idle", false);
			Map_AddTimer("KateMusic", 0.25f, "TriggerKateMusic");
			Sound_CreateAtEntity("RescueKateRise", "01_03_upsilon_outside/SFX/kate_rescue_rise", "InfectedKate_Static");
		}
		
		else if (Sequence_DoStepAndWait(2.5f))
		{
			Entity_PlayAnimation("InfectedKate_Static", "idle_extra01", 0.1, false, true, "AnimationKateGreeting");
		}
		
		else if (Sequence_DoStepAndPause(0))
		{
			//Kate rises up and says thanks
			Sound_CreateAtEntity("SavedInfectedKate", "01_03_upsilon_outside/katebot/katebot_powerup", "InfectedKate_AI", 0, false);
			Sound_Stop("TrapAlarm", 0.1);
			Lamp_SetLit("InfectedKate_Static", false, true);
		}
	
		// Toggle to AI controlled Kate.
		else if (Sequence_DoStepAndWait(0.1f))
		{
			Entity_SetActive("InfectedKate_Static", false);
			Entity_SetActive("InfectedKate_AI", true);
			Entity_SetEffectsActive("InfectedKate_AI", true, true);
			Entity_StopAnimation("InfectedKate_AI");
			
			mbKateRescued = true;
			cScript_SetGlobalVarBool("RescuedKate", true);
			
			cLux_AddTodoMessage("Sound: Kate Copy reacting to being saved.");
		}
		
		// Activate AI
		else if (Sequence_DoStepAndWait(0))
		{
			if (mlPowerCableCount==0)
				StopKateFollowing();
			else
				Kate_FollowPlayer("InfectedKate_AI");
		}
	
		Sequence_End();
	}

	//-------------------------------------------------------
	
	void AnimationKateGreeting(const tString &in asEntityName, const tString &in asAnimName)
	{
		SequenceStates_Resume("SequenceInfectedKateRescued");
	}

