		/////////////////////////////////////////////////////
		// Draw fuse lineup
		cImGuiGfx fuseValidGfx("station/fusebox/fuse_active");
		fuseValidGfx.mColor = gStationGuiColor_Highlight;
		cImGuiGfx fuseInvalidGfx("station/fusebox/fuse_broken");
		fuseInvalidGfx.mColor = gStationGuiColor_Warning2 * ImGui_FadeOscillateColor("BrokenFuseAlpha", cColor_White, cColor(1,0), 0.5f);
		ImGui_LayoutBegin(eImGuiLayout_X, ImGui_NrmPos(cVector3f(0.2f, 0.35f, 1.0f)), ImGui_NrmSize(cVector2f(0.7f, 0.8f)), cVector2f(80.0f, 0.0f));
		{
			ImGui_DoImage(fuseValidGfx);
			ImGui_DoImage(fuseValidGfx);
			ImGui_DoImage(fuseValidGfx);
