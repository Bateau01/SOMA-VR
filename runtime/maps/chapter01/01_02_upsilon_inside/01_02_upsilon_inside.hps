	/////////////////////////////////////////
	// MACHINE ROOM
	/////////////////////////////////////////
	
	void SetupMachineRoom()
	{		
		Entity_PlayAnimation("robot_arm_idle", "idle", 0.1f, true, false);
		Entity_PlayAnimation("robot_arm_broken", "broken_idle", 0.1f, true, false);
		Entity_PlayAnimation("robot_arm_welding", "welding", 0.1f, true, false);
		Entity_PlayAnimation("robot_arm_broken_on_belt", "broken_on_belt", 0.1f, true, false);
		Entity_PlayAnimation("CarlConstruct", "idle", 0.1f, true, false);
		Entity_SetEffectsActive("robot_arm_welding", false, false);
		Entity_SetEffectsActive("robot_arm_broken_on_belt_1", false, false);
		Entity_AttachToSocket("WeldPSAttachArea", "robot_arm_welding", "WeldFlame", true);
		Sound_CreateAtEntity("RobotArmIdle", "Entities_Station/tech/robot_arm/robot_arm_idle", "robot_arm_welding", 0, false);
		Sound_CreateAtEntity("RobotArmBroken", "Entities_Station/tech/robot_arm/robot_arm_broken_idle", "RobotArmPSArea_1", 0, false);
		Voice_SetSource("CarlConstruct", "CarlConstructSource", 5, 40, true, 30);
		Voice_SetCharacterSpeakingCallback("CarlConstruct", "OnCarlSpeaking");
		Lamp_SetLit("CarlLamp",false,false);
	    Lamp_SetLit("warning_light_machine_room_*", false, false);
		Entity_PlayAnimation("warning_light_machine_room_*", "spin", 0.1f, false, false);
		Entity_FadeEffectBaseColor("carl_burn_effects", cColor(0), 1);
		ParticleSystem_SetActive("carl_burn_smoke", false);
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaUpstairs(const tString &in asParent, const tString &in asChild, int alState)
	{		
		if (alState == 1)
		{
			ActivateMachineRoom();
			cLux_AddDebugMessage("Player Upstairs");
		}
		else
		{
			KillMachineRoom();
			cLux_AddDebugMessage("Player Not Upstairs");
		}
		return true;
	}

	//-------------------------------------------------------
	
	void ActivateMachineRoom()
	{
		if (mbAssemblyActive==true)
		{
			RobotArmActivationUpstairsEnter();
		}
		if (mbAssemblyActive==false)
		{
			KillMachineRoom();
		}
	}
	
	//-------------------------------------------------------
	
	void KillMachineRoom()
	{
		Entity_PlayAnimation("robot_arm_broken", "idle", 0.1f, true, false);
		Entity_PlayAnimation("robot_arm_welding", "weld_to_idle", 0.1f, false, false, "RobotArmAnimationOver");
		Entity_StopAnimation("robot_arm_broken_on_belt");
		
		Entity_SetActive("robot_arm_broken_on_belt", false);
		Entity_SetActive("robot_arm_broken_on_belt_1", true);
		  
		Entity_SetEffectsActive("robot_arm_broken", false, false);
			
		Sound_Stop("RobotArmBroken", 0.0f);
		Sound_Stop("RobotArmIdle", 0.0f);
	}
	
	//-------------------------------------------------------
	
	bool mbCarlCanHearPlayer = false;
	bool mbCarlCanSeePlayer = false;
	bool mbHeardCarl = false;
	bool mbCarlHasSeenPlayer = false;
	bool mbPlayerReturnedToCarl = false;
	bool mbPlayerBeenGoneFromCarlAWhile = false;
	bool mbCarlDrained = false;
	bool mbCarlDead = false;
	bool mbCarlBeingTortured = false;
	bool mbCarlBeingDrained = false;
	bool mbPlayerSawDeadCarl = false;
	bool mbCarlPlayingSpecialAnimation = false;
	
	int mlCarlTalkCount=0;
	eCarlState mCarlState = eCarlState_Normal;
	
	bool TriggerCarlCanHearPlayer(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState==1)
		{
			cLux_AddDebugMessage("Carl can hear player");
			mbCarlCanHearPlayer = true;
			StartCarlSpeakTimer();
		}
		else if (alState == -1)
		{
			cLux_AddDebugMessage("Carl can't hear player any more");
			mbCarlCanHearPlayer = false;
			StopCarlSpeakTimer();
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	void StartCarlSpeakTimer(bool abImmediate = false)
	{
		if (mbCarlDead)	// Carl's dead - no point in speaking!
			return;
			
		if (!mbCarlCanHearPlayer)	// Carl won't bother if he can't hear the player
			return;
			
		Map_RemoveTimer("CarlConstructSpeakTimer");
		
		float fDelay = 0.0f;
		
		if (abImmediate)
		{
			fDelay = 0.1f;
		}
		else if (!mbHeardCarl)
		{
			// Haven't heard Carl before, so delay should be really short
			fDelay = 0.2f;
		}
		else if (mbCarlBeingTortured)
		{
			// Carl being tortured
			fDelay = cMath_RandRectf(0.5f,3.0f);
		}
		else if (mbCarlCanSeePlayer)
		{
			// Player standing right next to Carl
			fDelay = cMath_RandRectf(4.0f,8.0f);
		}
		else
		{
			// Carl calling for player
			fDelay = cMath_RandRectf(5.0f,15.0f);
		}
		
		cLux_AddDebugMessage("Starting carl timer:"+fDelay);
		Map_AddTimer("CarlConstructSpeakTimer", fDelay, "TimerCarlTrySpeak");
	}
	
	//-------------------------------------------------------
	
	void StopCarlSpeakTimer()
	{
		Map_RemoveTimer("CarlConstructSpeakTimer");
	}
	
	//-------------------------------------------------------
	
	void RestartCarlSpeakTimer(bool abImmediate = false)
	{
		StartCarlSpeakTimer(abImmediate);
	}
	
	//-------------------------------------------------------
	
	bool mbCarlPlayedNeutralGreetingLine = false;
	bool mbCarlAlternateTorture = false;
	
	void TimerCarlTrySpeak(const tString &in asTimer)
	{
		if(mbPlayerInDome==false)
		{
			if (Voice_AnySceneIsActive())
			{
				cLux_AddDebugMessage("Carl tries to speak but someone is already speaking.");
				RestartCarlSpeakTimer();
				return;
			}
			
			tString sSubject="";
			float fRange = 40.0f;
			
			if (!mbHeardCarl)
			{
				// Very first line, played when Simon steps into the room.
				sSubject = "4E_CarlConstructPlea_1";
			}
			else if (mbCarlBeingDrained && mCarlState == eCarlState_Normal)
			{
				// Carl being drained from normal
				sSubject = "4L_CarlConstructDrain_NoTorture";
			} 
			else if (mbCarlBeingDrained && mCarlState == eCarlState_Tortured)
			{
				// Carl being drained from tortured
				sSubject = "4L_CarlConstructDrain_Tortured";
			}
			else if (mbCarlBeingTortured)
			{
				// Carl screams and sobs alternately.
				mbCarlAlternateTorture = !mbCarlAlternateTorture;
				if (mbCarlAlternateTorture)
					sSubject = "4E_CarlConstructTorture";
				else
					sSubject = "4E_CarlConstructBroken";
				fRange = 70.0f;
			}
			else if (mCarlState == eCarlState_Broken)
			{
				// Carl can't talk any more. :(
				sSubject = "4E_CarlConstructDeathSob";
			}
			else if (!mbCarlCanSeePlayer && mCarlState == eCarlState_Tortured)
			{
				// Player's left Carl alone after torturing him
				sSubject = "CarlConstructSimonLeaves_PostTorture";
			}
			else if (mbCarlCanSeePlayer && mCarlState == eCarlState_Tortured)
			{
				// Player's nearby after Carl was tortured
				sSubject = "4E_CarlConstructSimonBack_PostTorture";
			}
			else if (mbCarlCanSeePlayer && mbPlayerReturnedToCarl)
			{
				// Player's returned after being away for a bit
				sSubject = "4E_CarlConstructSimonBack";
			}
			else if (mbCarlCanSeePlayer)
			{
				// Carl can see the player, before being tortured or talked to
				if (!mbCarlPlayedNeutralGreetingLine)
				{
					sSubject = "4E_CarlConstructVisible_1";
					mbCarlPlayedNeutralGreetingLine = true;
				}
				else
				{
					sSubject = "4E_CarlConstructVisible_2";
				}
			}
			else
			{
				// Neutral calling for Simon
				sSubject = "4E_CarlConstructPlea_2";
			}
		
			mbHeardCarl = true;
			
			cLux_AddDebugMessage("Carl tries to speak:"+sSubject);
			
			if (sSubject=="" || PlayCarlConstructVoice(sSubject, true) == false)
			{
				OnCarlConstructSpeakDone("","");
			}
		}
	}
	
	//-------------------------------------------------------
	
	void OnCarlConstructSpeakDone(const tString&in asScene, const tString&in asSubject)
	{			
		StopCarlSpeakVisuals();
		StartCarlSpeakTimer();
	}
	
	//-------------------------------------------------------
	
	bool TriggerCarlCanSeePlayer(const tString &in asParent, const tString &in asChild, int alState)
	{
		mbCarlCanSeePlayer = (alState==1);
		
		if (mbCarlCanSeePlayer)
			mbCarlHasSeenPlayer = true;
			
		if (alState==1)
		{
			cLux_AddDebugMessage("Carl can see player.");
			Map_RemoveTimer("TimerCarlMissesPlayer");
			if (mbPlayerBeenGoneFromCarlAWhile)
			{
				mbPlayerReturnedToCarl = true;
			}
			mbPlayerBeenGoneFromCarlAWhile = false;
			RestartCarlSpeakTimer(true);
		}
		else
		{
			cLux_AddDebugMessage("Carl can't see player anymore.");
			Map_AddTimer("TimerCarlMissesPlayer", 15.0f, "TimerCarlMissesPlayer");		
			RestartCarlSpeakTimer(false);
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	void TimerCarlMissesPlayer(const tString &in asTimer)
	{
		mbPlayerBeenGoneFromCarlAWhile = true;
	}
	
	//-------------------------------------------------------
	
	bool PlayCarlConstructVoice(const tString &in asSubject, bool abStopCurrent, const tString &in asCallback = "OnCarlConstructSpeakDone", int alPrio=0)
	{
		if (abStopCurrent)
			Voice_Stop("CarlConstruct");
		
		Voice_Play(asSubject, -1, asCallback, alPrio);
		
		if (Voice_SceneIsActive("CarlConstruct"))
			return true;
			
		return false;
	}
		
	//-------------------------------------------------------
	
	bool OnCarlSpeaking(const tString &in asCharacter, bool abStartedTalking)
	{
		if (abStartedTalking)
		{
			StartCarlSpeakVisuals();
		}
		else
		{
			StopCarlSpeakVisuals();
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	void StartCarlSpeakVisuals()
	{
		Lamp_SetLit("CarlLamp",true,true);
		
		if (mbCarlPlayingSpecialAnimation)
			return;
			
		tString sAnim = "uneasy";
		if (mCarlState == eCarlState_Tortured || mCarlState == eCarlState_Broken)
		{
			sAnim="angry";
		}
		Entity_PlayAnimation("CarlConstruct", sAnim, 0.1f, true, true);
	}
	
	//-------------------------------------------------------
	
	void StopCarlSpeakVisuals()
	{
		Lamp_SetLit("CarlLamp",false,true);
		tString sAnim = "idle";
		if (mbCarlBeingTortured)
			sAnim = "spasms";
		else if (mCarlState!=eCarlState_Normal)
			sAnim = "uneasy";
			
		if (mbCarlDead)
			Entity_SetAnimationPaused("CarlConstruct", "idle", true);
		else if (mbCarlPlayingSpecialAnimation == false)
			Entity_PlayAnimation("CarlConstruct", sAnim, 0.5f, true, true);
	}
	
	//-------------------------------------------------------
	
	void LineOver_CarlAnim(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStart)
	{
		tString sAnim = "";
		float fDelay = 0;
		
		if (asSubject == "4E_CarlConstructTalk_2")
		{
			if (abStart)
			{
				sAnim = "tap_head";
				fDelay = 0.75;
			}
		}
		
		else if (asSubject == "4E_CarlConstructTalk_3" && abStart)
		{
			if (alLineIndex==1)
			{
				sAnim = "arm_wave";
				Map_AddTimer("hand_shake", 1.5, "Timer_StartCarlAnim");
				fDelay = 5;
			}
			else
			{
				sAnim = "get_up";
				fDelay = 0;
			}
		}
		
		else if (asSubject == "4E_CarlConstructTalk_6")
		{
			Audio_Duck_ReturnToNormal_3s(asScene, asSubject, alLineIndex, abStart);
/*			if (abStart)
			{
				sAnim = "tap_head";
				fDelay = 2.25;
			}*/
		}
		
		else if (asSubject == "4E_CarlConstructTalk_PostTorture_3")
		{
			Audio_Duck_ReturnToNormal_3s(asScene, asSubject, alLineIndex, abStart);
			if (abStart)
			{
				sAnim = "arm_slam";
				fDelay = 1.4;
			}
		}
		
		else if (asSubject == "4E_CarlConstructTalk_PostTorture_4")
		{
			if (abStart)
			{
				sAnim = "arm_slam";
				fDelay = 4;
			}
		}
		
		if (sAnim == "") return;
		
		Map_AddTimer(sAnim, fDelay, "Timer_StartCarlAnim");
	}
	
	void Timer_StartCarlAnim(const tString &in asTimer)
	{
		mbCarlPlayingSpecialAnimation = true;
		NPC_PlayExtraAnimation("CarlConstruct", asTimer, 0.3, "AnimationCarlSpecialAnimOver");
	}
	
	void AnimationCarlSpecialAnimOver(const tString &in asEntityName, const tString &in asAnimName)
	{
		mbCarlPlayingSpecialAnimation = false;
		OnCarlSpeaking("CarlConstruct", Voice_CharacterIsSpeaking("CarlConstruct"));
	}
	
	//-------------------------------------------------------
	
	void InteractCarlConstruct(const tString &in asEntity)
	{
		cLux_AddDebugMessage("Interact with Carl");
		mlCarlTalkCount++;
		
		tString sSubject="4E_CarlConstructTalk_";
		if (mCarlState == eCarlState_Broken)
			sSubject += "PostBreakingPoint_";
		if (mCarlState == eCarlState_Tortured)
			sSubject += "PostTorture_";

		bool bUseConversation = true;

		if (Voice_SubjectExists(sSubject+mlCarlTalkCount))
		{
			sSubject = sSubject+mlCarlTalkCount;
		}
		else
		{
			bUseConversation = false;
			sSubject = sSubject+"EndOfSubjects";
		}
		
		Entity_SetInteractionDisabled("CarlConstruct_Talk", true);
		if (bUseConversation)
			Dialog_StartConversation_PosBased("CarlConstruct", "CarlConstruct", "CarlConversationArea","head");
		Dialog_Begin("CarlConstructConversation");
			Dialog_AddBranchAndSubject(sSubject, "", "OnCarlConversationDone");
		Dialog_End();
	}
	
	//-------------------------------------------------------
	
	void OnCarlConversationDone(const tString&in asSubject, bool abStartOfSubject)
	{		
		if (abStartOfSubject) return;
		
		Entity_SetInteractionDisabled("CarlConstruct_Talk", false);
		mbPlayerReturnedToCarl = false;
		OnCarlConstructSpeakDone("", "");
	}
	
	//-------------------------------------------------------
	bool mbCarlTorturedCooldownSound = false;
	bool mbCarlTortureMusicPlayed = false;
	
	void StartCarlTorture()
	{
		mbCarlBeingTortured = true;
		if (mCarlState == eCarlState_Normal)
			Map_AddTimer("TimerCarlBrokenByTorture", 30.0f, "TimerCarlBrokenByTorture");
			
		if (mCarlState != eCarlState_Broken)
			mCarlState++;		
					
		Entity_SetActive("CarlConstruct_Talk", false);
		
		Entity_PlayAnimation("CarlConstruct", "angry", 0.1f, true, true);
		Map_AddTimer("TimerCarlTortureSparks", cMath_RandRectf(0.3f,0.6f), "TimerCarlTortureSparks");
		RestartCarlSpeakTimer(true);
		
		ParticleSystem_CreateAtEntity("TortureSparksPSStart_1", "elec_spark_oneshot.ps", "TortureSpark_1", false);
		ParticleSystem_CreateAtEntity("TortureSparksPSStart_3", "elec_spark_oneshot.ps", "TortureSpark_3", false);
		ParticleSystem_CreateAtEntity("TortureSparksPSStart_4", "elec_spark_oneshot.ps", "TortureSpark_4", false);
		ParticleSystem_CreateAtEntity("TortureSparksPSStart_5", "elec_spark_oneshot.ps", "TortureSpark_5", false);
		ParticleSystem_CreateAtEntity("TortureSparksPSStart_6", "elec_spark_lightning_oneshot_small.ps", "TortureSpark_6", false);
		
		int lShake = Effect_Shake_Start(0.08, 0, 0, 0.4);
		Effect_Shake_SetSourceEntity(lShake, "CarlConstruct", 3, 10);
	}
	
	//-------------------------------------------------------
	bool mbInCommRoom = false;
	void StopCarlTorture()
	{
		if(mbCarlBeingTortured==true)
		{
			mbCarlBeingTortured = false;
			
			//Play sizzling sound if carl tortured for length of time
			if (mbCarlTorturedCooldownSound == true)
			{
				Sound_CreateAtEntity("CarlTortureCooldownLoop", "01_02_upsilon_inside_02/sfx/carl_torture_event/cooldown_loop", "TortureSoundSource");
				Map_AddTimer("CarlTortureCoolDownLoopStop", 10.0f, "CarlTortureCoolSoundFade");
			}
			
			Map_RemoveTimer("TimerCarlTortureSparks");
			
			if (mCarlState == eCarlState_Tortured||mCarlState==eCarlState_Broken)
				Entity_PlayAnimation("CarlConstruct", "uneasy", 0.1f, true, true);
			else
				Entity_PlayAnimation("CarlConstruct", "idle", 0.1f, true, true);
			Map_RemoveTimer("TimerCarlBrokenByTorture");
			
			Entity_SetActive("CarlConstruct_Talk", true);
			if (mCarlState==eCarlState_Tortured)
			{
				if (mlCarlTalkCount>0)
					mlCarlTalkCount=1;	// Skip first subject in tortured talk if first subject of non-torture has been played.
			}
			if(mbInCommRoom==false)
			{
				RestartCarlSpeakTimer(true);
			}
		}
	}
	
	//-------------------------------------------------------
	
	bool Trigger_InCommRoom(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			mbInCommRoom = true;
		}
		else
		{
			mbInCommRoom = false;
		}
		return true;
	}
	
	//-------------------------------------------------------
	void PlayCarlTortureMusic(const tString& in asTimer)
	{
		if(mbCarlTortureMusicPlayed == false)
		{
			mbCarlTortureMusicPlayed = true;
			//Music_Play("01_02_torturecarl", 0.35f, false, eMusicPrio_BigEvent);
		}
	}
	
	void EnableCarlCooldownBool(const tString& in asTimer)
	{
		cLux_AddDebugMessage("Carl Cooldown = true");
		mbCarlTorturedCooldownSound = true;
		Map_AddTimer("CarlCooldownBoolReset", 5.0f, "ResetCarlCooldownBool");
	}
	void ResetCarlCooldownBool(const tString& in asTimer)
	{
		cLux_AddDebugMessage("Carl Cooldown = false");
		mbCarlTorturedCooldownSound = false;
	}
	
	void CarlTortureCoolSoundFade(const tString& in asTimer)
	{
		Sound_Stop("CarlTortureCooldownLoop", 15.0f);
	}
	
	//-------------------------------------------------------
	
	int mlTortureSparksID = 0;
	
	void TimerCarlTortureSparks(const tString& in asTimer)
	{
		mlTortureSparksID++;
		ParticleSystem_CreateAtEntity("TortureSparksPS"+mlTortureSparksID, "elec_spark_oneshot.ps", "TortureSpark_"+cMath_RandRectl(1,5), false);
		ParticleSystem_CreateAtEntity("TortureSparksPS"+mlTortureSparksID, "elec_spark_lightning_oneshot_small.ps", "TortureSpark_6", false);
		Map_AddTimer("TimerCarlTortureSparks", cMath_RandRectf(0.3f,0.6f), "TimerCarlTortureSparks");
	}
	
	//-------------------------------------------------------
	
	void TimerCarlBrokenByTorture(const tString &in asTimer)
	{
		mCarlState = eCarlState_Broken;
	}
	
	//-------------------------------------------------------
	
	int mlCarlDrainedTimes = 0;	
	void OnDrainingCarlWauFlower(const tString &in asEntity)
	{			
		mbCarlBeingDrained = true;
		RestartCarlSpeakTimer(true);
	}
	
	//-------------------------------------------------------
	
	void OnDrainCarlWauFlower(const tString &in asEntity)
	{
		mbCarlDrained = true;
		mbCarlBeingDrained = false;
		KillCarl(true);
	}
	
	//-------------------------------------------------------
	
	void KillCarl(bool abEffects)
	{
		Entity_SetActive("TriggerCarlCanSeePlayer", false);
		Entity_SetActive("TriggerCarlCanHearPlayer", false);
		Lamp_SetLit("CarlLamp", false, true);		
		Entity_SetInteractionDisabled("CarlConstruct_Talk", true);
		Entity_SetEffectsActive("CarlConstruct", false, true);
		Entity_PlayAnimation("CarlConstruct", "idle");
		Entity_SetAnimationPaused("CarlConstruct", "idle", true);
		HeadTracker_SetActive("CarlConstruct", false);
		
		Voice_Stop("CarlConstruct");
		StopCarlSpeakTimer();
		
		mbCarlCanSeePlayer = false;
		mbCarlCanHearPlayer = false;
		mbCarlDead = true;
		mCarlState = eCarlState_Dead;
		
		if (abEffects)
			cLux_AddTodoMessage("Script: More juice!");
	}
	
	//-------------------------------------------------------
	
	bool Trigger_SeeDeadCarl(const tString &in asParent, const tString &in asChild, int alState)
	{
		mbPlayerSawDeadCarl = true;
		return false;
	}
	
	//-------------------------------------------------------
	
	bool mbAssemblyActive = true;
	void OnGuiMachineRoomRobotTerminal(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("01_02_upsilon_inside");
		
		/////////////////////////////////////////////////
		// Background
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop("background_logo_pathosstation", cVector2f(0.6, 0.675), 0.375);
			
		///////////////////////////////////////////////////////////
		// Sequence is inactive, all robot arms offline
		if(mbAssemblyActive==false)
			DoRobotArmDisplay(false, "MachineRoomRobotTerminalButtonOff", gStationGuiColor_Warning);
		
		/////////////////////////////////////////////////////////////////
		// Draw robot arm according to which display is calling this	
		else if(asEntityName == "WorkingMonitor_1") // Robot arm 1 is offline
			DoRobotArmDisplay(false, "MachineRoomRobotTerminalButtonOff", gStationGuiColor_Disabled);
		
		else if(asEntityName == "WorkingMonitor_2" || asEntityName == "WorkingMonitor_4") // Robot arms 2 and 4 are online but malfunctioning
			DoRobotArmDisplay(true, "MachineRoomRobotTerminalButtonWarning", gStationGuiColor_Warning);
		
		else // Robot arm 3 is online
			DoRobotArmDisplay(true, "MachineRoomRobotTerminalButtonOn", gStationGuiColor_Highlight);
	}
				
	//-------------------------------------------------------
	
	void DoRobotArmDisplay(bool abOn, const tString &in asText, const cColor &in aColor)
	{
		cImGuiLabelData labelData;
		labelData.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
		labelData.mFont.mvSize = cVector2f(48, 48);
		
		cImGuiGfx roboArmGfx;
		roboArmGfx.mMaterial = eGuiMaterial_Alpha;
		
		cVector3f vTextPos;
		
		if (abOn)
		{
			roboArmGfx.SetFile("station/assemblybelt/roboarm_on");
			vTextPos = ImGui_NrmPos(cVector3f(0.35f, 0.485f, 1.0f));
		}
		else
		{
			roboArmGfx.SetFile("station/assemblybelt/roboarm_off");
			vTextPos = ImGui_NrmPos(cVector3f(0.425f, 0.485f, 1.0f));
		}
		
		ImGui_SetModColorMul(aColor);
		ImGui_DoImage(roboArmGfx, ImGui_NrmPos(cVector3f(0.04,0.01,1)), ImGui_GetRatioCorrectSizeByNrmHeight(roboArmGfx, 0.875));
		ImGui_ResizeFontToFit(ImGui_Translate(asText), labelData.mFont, ImGui_GetSize().x*0.95-vTextPos.x, 1.4);
		ImGui_DoLabelExt(asText, labelData, vTextPos, cVector2f_MinusOne, 1.4f);
		ImGui_ResetModifiers();
	}
	
	//-------------------------------------------------------
	
	void RobotArmAnimationOver(const tString &in asEntityName, const tString &in asAnimName)
	{
		if(asAnimName == "idle_to_weld")
		{
			Entity_PlayAnimation("robot_arm_welding", "welding", 0.1f, true, false);
			//TimerSpawnRobotArmSpark("active");
		}
		else if(asAnimName == "weld_to_idle")
		{
			Entity_PlayAnimation("robot_arm_welding", "idle", 0.1f, true, false);
		}
	}
	
