	//-------------------------------------------------------
		
	void OnAction(int alAction, bool abPressed)
	{
		if(abPressed==false) return;

		if(alAction == eAction_Test1)
		{
			cLuxClosestEntityData pData;
			if (!cLux_GetClosestEntity(cLux_GetPlayer().GetCamera().GetPosition(),cLux_GetPlayer().GetCamera().GetForward(),100, 0, false, pData))
				return;
				
			tString sEntity = pData.mpEntity.GetName();

			Button_SetLocked(sEntity, !Button_IsLocked(sEntity), true);
			Lamp_SetLit(sEntity, !Lamp_GetLit(sEntity), true);
			SlideDoor_SetClosed(sEntity, false);
		}

		if(alAction == eAction_Test2)
		{
			//SetHubFloorPowerOn(!Lamp_GetLit("HubRoomLamp_5"));
			Seq_EnterHubRoom("");
			Collide_TriggerStopLowerSounds("player", "Trigger_StopLowerSounds", 1);
		}
		if(alAction == eAction_Test3)
		{
			cMeshEntityIterator@ pIt = cLux_GetCurrentMap().GetWorld().GetStaticMeshEntityIterator();
			int lCount = 0;
			while (pIt.HasNext())
			{
				cMeshEntity@ mesh = pIt.Next();
				lCount++;
				tString sName = mesh.GetName();
				if (cString_GetFirstStringPos(sName, "Mesh") != -1) cLux_AddDebugMessage("Found: "+sName);
				//if (lCount % 10 == 0) cLux_AddDebugMessage("Found: "+sName);
			}
			cLux_AddDebugMessage("This many: "+lCount);
		}
		
		if(alAction == eAction_Test4)
		{				
			Map_AddTimer("CommRoomConvo_ActiveCheck", 2, "Timer_CommRoomConvoEndFailsafe");
		}
		
		if(alAction == eAction_Test5)
		{
			SequenceGeneratorTurnedOn("");
			//Effect_Rumble_Start(0.6, 0.3f);	
		}
		
		if (alAction == eAction_Test6)
		{
		    Entity_SetActive("TransformerBot", true);
			
			Pathfinder_Track_Clear("TransformerBot");
			Pathfinder_Track_Add("TransformerBot", "PathNodeArea_60", 1, 4);
			Pathfinder_Track_Add("TransformerBot", "PathNodeArea_46", 1, 4);
			Pathfinder_Track_Add("TransformerBot", "PathNodeArea_18", 1, 4);
			Pathfinder_Track_Add("TransformerBot", "PathNodeArea_63", 1, 4);
			Pathfinder_Track_Start("TransformerBot", true, 0.5f, "");
			
			//SequenceFloodCommRoom("");
			//GeneratorRoomBlackout();
			//Sound_CreateAtEntity("radio_connect_scan", "01_02_upsilon_inside_02/special/radio_pannel/connect", "radio_panel_sound", 0, false);
		}
		
		if (alAction == eAction_Test7)
		{
			Entity_SetActive("VentRobot", true);
			
			
			Agent_SetSensesActive("VentRobot", false);
			CharMover_PlayAnimation("VentRobot", "01_02_appearance", 0, false, true, "AnimOver_VentRobotEnters");
			Sound_CreateAtEntity("VentRobotEmerges", "NPC_Creatures/Foley/InWorld/Construct/long_falloff/upsilon_stairs_emerge", "VentRobot");
			Sound_FadeGlobalVolume(0.7f, 3.0f);
			Map_AddTimer("VentRobotEmergeFadeUp", 4.0f, "VentRobotEmergeFadeUp");
			
			//Entity_SetActive("AgentRepelArea_Floor_3", true);
			Entity_SetActive("AgentRepelArea_Floor_2*", false);
			Entity_SetActive("StairSteamDamageArea", false);
			//ActivateVentRobotPath();
			//Agent_SetSensesActive("VentRobot",true);
			SetHubFloorPowerOn(false);
			
			Seq_UnlockCommRoomDoor("");
		}
		
		if (alAction == eAction_Test8)
		{
			//ParticleSystem_CreateAtEntityExt("CommRoomStream", "stream_flood_end_splash.ps", "LevelExit_LookAt", false, cColor(0.8,1,0.8,1), 1, false);
			Player_SetHealth(0.45);
		}
		
		if (alAction == eAction_Test9)
		{
			//ParticleSystem_Destroy("CommRoomStream");
			
			/*Entity_SetActive("VentRobot_Test", true);
			
			Pathfinder_Track_Clear("VentRobot_Test");
			Pathfinder_Track_Add("VentRobot_Test", "PathNodeArea_493");
			Pathfinder_Track_Start("VentRobot_Test", false,1.5f);
			
			Entity_SetActive("AgentRepelArea_Floor_2_2", false);*/
			
			Preload();
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
		}
		
	}
	
		
