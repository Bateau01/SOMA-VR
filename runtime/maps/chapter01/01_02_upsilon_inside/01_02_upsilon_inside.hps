	/////////////////////////////////////////
	// ELECTRIC DOORS
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	
	void SetupElectricDoors()
	{
		Entity_SetEffectsActive("BrokenDoorControl*", false, false);
		ParticleSystem_SetVisible("ControlRoomDoorLightParticles", false);
		
		/////////////////////////////////
		// Door buttons
		// Setting up callbacks here to avoid dependency problems at startup
		Entity_SetConnectionStateChangeCallback("ElectricsDoor_Control_1", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("ElectricsDoor_Control_2", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("StorageDoor_Control_1", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("StorageDoor_Control_2", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("MachineRoomDoor_Control_1", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("MachineRoomDoor_Control_2", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("NorthDoorControl_1", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("NorthDoorControl_2", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("ReactorFlowDoorControl_1", "StateChangeElectricDoorButton");
		Entity_SetConnectionStateChangeCallback("ReactorFlowDoorControl_2", "StateChangeElectricDoorButton");
		
		// Connecting buttons with the one on the other side of the door they open
		Entity_SetVarString("ElectricsDoor_Control_1", "OtherButton", "ElectricsDoor_Control_2");
		Entity_SetVarString("ElectricsDoor_Control_2", "OtherButton", "ElectricsDoor_Control_1");
		Entity_SetVarString("StorageDoor_Control_1", "OtherButton", "StorageDoor_Control_2");
		Entity_SetVarString("StorageDoor_Control_2", "OtherButton", "StorageDoor_Control_1");
		Entity_SetVarString("MachineRoomDoor_Control_1", "OtherButton", "MachineRoomDoor_Control_2");
		Entity_SetVarString("MachineRoomDoor_Control_2", "OtherButton", "MachineRoomDoor_Control_1");
		Entity_SetVarString("NorthDoorControl_1", "OtherButton", "NorthDoorControl_2");
		Entity_SetVarString("NorthDoorControl_2", "OtherButton", "NorthDoorControl_1");
		Entity_SetVarString("ReactorFlowDoorControl_1", "OtherButton", "ReactorFlowDoorControl_2");
		Entity_SetVarString("ReactorFlowDoorControl_2", "OtherButton", "ReactorFlowDoorControl_1");
	}
	
	//-------------------------------------------------------
	
	void StateChangeElectricDoorButton(const tString &in asEntity, int alState)
	{
		// If one button changes state, so should the one on the other side of the door.
		Button_SetSwitchedOn(Entity_GetVarString(asEntity, "OtherButton"), alState == 1, false);
	}
	
	//-------------------------------------------------------
	
	void OnInteractAirlock(const tString &in asEntity)
	{
		Button_SetDisabled("Airlock_Control", true, true);
		Map_AddTimer("SequenceAirlockFail",0.1f,"SequenceAirlockFail");
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceAirlockFail;
	void SequenceAirlockFail(const tString& in asTimer)
	{
		Sequence_Begin("SequenceAirlockFail", mSequenceAirlockFail);
		
		if (Sequence_DoStepAndWait(0.1f))
		{
			SlideDoor_SetOpenAmount("slidedoor_airlock_1",0.01,false);
			ParticleSystem_CreateAtEntity("AirlockSparks", "elec_spark_oneshot.ps", "Airlock_Control", true);
			Sound_CreateAtEntity("AirlockFail", "01_02_upsilon_inside_02/sfx/bulkhead_broken/bulkhead_fail", "AirlockDoorSoundSource");
			Map_AddTimer("AirlockFailAlarm", 1.5f, "AirlockFailAlarm");
			
			Sound_CreateAIEventAtEntity("Airlock_Control", 30, 2);
			
			//Disable interaction for 4 seconds to stop player spamming event
			Entity_SetInteractionDisabled("Airlock_Control", true);
			Map_AddTimer("AirlockFailInteract", 3.0f, "AirlockFailInteract");
		}
		else if (Sequence_DoStepAndWait(0.1f))
		{
			ParticleSystem_CreateAtEntity("AirlockSparks", "elec_spark_oneshot.ps", "AirlockPS_1", true);
		}
		else if (Sequence_DoStepAndWait(0.2f))
		{
			ParticleSystem_CreateAtEntity("AirlockSparks", "elec_spark_oneshot.ps", "AirlockPS_2", true);
		}
		else if (Sequence_DoStepAndWait(0.15f))
		{
			ParticleSystem_CreateAtEntity("AirlockSparks", "elec_spark_oneshot.ps", "AirlockPS_3", true);
		}
		else if (Sequence_DoStepAndWait(0.1f))
		{
			SlideDoor_SetOpenAmount("slidedoor_airlock_1",0.00,false);
			ParticleSystem_CreateAtEntity("AirlockSparks", "elec_spark_oneshot.ps", "AirlockPS_4", true);
		}
		else if (Sequence_DoStepAndWait(0.15f))
		{
			ParticleSystem_CreateAtEntity("AirlockSparks", "elec_spark_oneshot.ps", "AirlockPS_5", true);
		}
	
		Sequence_End();
	}
	
	void AirlockFailAlarm(const tString& in asTimer)
	{
		Sound_CreateAtEntity("AirlockFailAlarm", "01_02_upsilon_inside_02/sfx/bulkhead_broken/bulkhead_alarm", "AirlockAlarmSoundSource");
	}
	
	void AirlockFailInteract(const tString& in asTimer)
	{
		Entity_SetInteractionDisabled("Airlock_Control", false);
	}
	
