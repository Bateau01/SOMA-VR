	//North door drip control

	void Timer_DripSoundControl(const tString &in asTimer)
	{
		Map_AddTimer("Timer_DripSoundControl", 0.25f, "Timer_DripSoundControl");

		if(SlideDoor_GetOpenAmount("NorthDoor") > 0.5)
		{
			if(Sound_Exists("DripsBackCorridor")==false)
			{
				Sound_CreateAtEntity("DripsBackCorridor", "level_amb_shared_interior/amb/spot/water/water_dripping_light_generic_floor_S", "BackCorridorDripSoundSrc");
				cLux_AddDebugMessage("Drip sounds on");
			}
		}
		else if(SlideDoor_GetOpenAmount("NorthDoor") < 0.5)
		{
			if(Sound_Exists("DripsBackCorridor")==true)
			{
				Sound_Stop("DripsBackCorridor", 1.0f);
				cLux_AddDebugMessage("Drip sounds off");
			}

		}
	}

	bool DripSoundControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Map_AddTimer("Timer_DripSoundControl", 0.25f, "Timer_DripSoundControl");
		}

		else
		{
			Map_RemoveTimer("Timer_DripSoundControl");
		}
		return true;
	}

