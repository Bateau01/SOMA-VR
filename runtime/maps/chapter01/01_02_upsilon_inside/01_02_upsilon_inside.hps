	/////////////////////////////////////////
	// HUB ROOM
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	
		bool mbCommRoomPoweredOn = false;
		
		void Interact_DeskLampNoSound(const tString &in asEntity)
		{
			Sound_CreateAtEntity(asEntity+"_OnOff", "Entities_Urban/lamp/generic_INT/switch_on_off", asEntity);
		}
		
		//-------------------------------------------------------
	
		/////////////////////////////////////////
		// Hub room: setup
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		void SetupHubRoom()
		{
			Lamp_SetLit("EmergencyHubRoomLamp_*", true, true);
			Lamp_SetLit("HubRoomLamp_*", true, true);
			Lamp_SetLit("HubRoomMonitor_*", true, true);
			Lamp_SetLit("CommRoomDoor_lamp_*", false, false);
			
			SwingDoor_SetOpenAmount("swingdoor_fence_airlock", 0.2f);
			
			Entity_SetEffectBaseColor("DeskLamp*",cColor(0,0,0));
			
			SetHubFloorLighting(false);
			
			Lamp_SetLit("reactor_flow_room_lamp_*", false, false);
			LensFlare_SetVisible("reactor_flow_room_flare", false);
			
			ParticleSystem_SetActive("LampBreakSparks_*", false);
			ParticleSystem_SetActive("spark_wauflower_hub_*", false);
		}
		
		//-------------------------------------------------------
		
		//} END Hub room: setup
		
		/////////////////////////////////////////
		// Hub room: lower floor sounds 
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		bool mbLowerSoundsActive = true;
		bool Collide_TriggerStopLowerSounds(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==-1)
				return true;
			
			Map_RemoveTimer("SteamSoundControl");
			mbLowerSoundsActive = false;
			cLux_AddDebugMessage("Collide_TriggerStopLowerSounds "+asChild);
				
			cLux_AddDebugMessage("stop lower sounds");
			Entity_SetActive("CarlConstruct", true);
			Sound_Fade("TransformerSizzleLoop", 0.0f, 1.0f);
			Sound_Fade("SteamSoundLoopInitial", 0.0f, 2.0f);
			if (mTransformerState==eTransformerState_Broken)
			{
				Light_SetVisible("TransformerElectricity_*",false);
			}
			if (mbPipeBroken)
			{
				Sound_Stop("PipeGeneratorSteamLoop1",1.0f);
				Sound_Stop("PipeGeneratorSteamLoop2",1.0f);
			}
			
			return true;
		}

		//-------------------------------------------------------

		bool Collide_TriggerStartLowerSounds(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==-1)
				return true;
				
			cLux_AddDebugMessage("Collide_TriggerStartLowerSounds "+asChild);
			mbLowerSoundsActive = true;
			cLux_AddDebugMessage("start lower sounds");
			Sound_Fade("TransformerSizzleLoop", 1.0f, 1.0f);
			Sound_Fade("SteamSoundLoopInitial", 1.0f, 2.0f);
			Entity_SetActive("CarlConstruct", false);
			if (mTransformerState==eTransformerState_Broken)
			{
				Light_SetVisible("TransformerElectricity_*",true);
			}
			if (mbPipeBroken)
			{
				Sound_Stop("PipeStairsSteamLoop1",0.0f);
				Sound_CreateAtEntity("PipeStairsSteamLoop1", "Entities_Station/special/01_02_pipe_medium/break_steam", "StairsRoomPipe_1_PSArea", 1.0f, false);
				Sound_Stop("PipeStairsSteamLoop2",0.0f);
				Sound_CreateAtEntity("PipeStairsSteamLoop2", "Entities_Station/special/01_02_pipe_medium/break_steam", "StairsRoomPipe_2_PSArea", 1.0f, false);
			}
			
				
			return true;
		}
		
		//} END Hub room: lower floor sounds 


		/////////////////////////////////////////
		// Hub room: power up 
		//{//////////////////////////////////////
	
		//-------------------------------------------------------
		
		bool Trigger_TopOfStairs(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_EnterHubRoom("");
			Sound_PreloadGroup("NPC_Creatures/Foley/InWorld/Carl_Construct", true);
			return false;
		}
		
		//-------------------------------------------------------
		bool mbHubRoomPowerUp = false;
		cSequenceStatesData mSeqEnterHubRoom;
		void Seq_EnterHubRoom(const tString& in asName)
		{
			Sequence_Begin("Seq_EnterHubRoom", mSeqEnterHubRoom);
			if (Sequence_DoStepAndWait(3.0f))
			{
				
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				// Start up lights
				SetHubFloorLighting(true,true);
				Sound_CreateAtEntity("LightsOn", "01_02_upsilon_inside_02/sfx/hubroom_lightson", "HubRoomLightsOnSoundSource");
				Map_AddTimer("StartAmbient", cMath_RandRectf(5.0f,8.0f), "AmbientMusicHandler");
				mbHubRoomPowerUp = true;
			}
			else if (Sequence_DoStepAndWait(3.0f))
			{
				//ActivateMachineRoom();
			}
			else if (Sequence_DoStepAndWait(5.0f))
			{
				// Start up Carl - hub space
				Voice_SetSource("CarlConstruct", "CarlConstructSource", 1.5, 25, true, 25, 600.0f, 2500, eLuxVoiceSourceFreqencyFlag_HighPass);
				Voice_Play("4A_CarlIntroductionShout", -1, "VoiceCarlShout");
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				// Shut off bot downstairs
				InfectedRobot_ForceIdleState("TransformerBot");
			}
			Sequence_End();
		}

		//-------------------------------------------------------
		
		void VoiceCarlShout(const tString&in asScene, const tString&in asSubject)
		{
			Voice_SetSource("CarlConstruct", "CarlConstructSource", 1.5, 25, true, 25, 8000, 300, eLuxVoiceSourceFreqencyFlag_LowPass);
		}

		//-------------------------------------------------------
		//2 different Carl falloff settings dependant on where player is
		bool TriggerCarlSourceRobotRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState==1)
			{
				Voice_SetSource("CarlConstruct", "CarlConstructSource", 1.5, 25, true, 25, 125.0f, 500, eLuxVoiceSourceFreqencyFlag_HighPass);
				cLux_AddDebugMessage("Carl voice settings changed - robot room");
			}
			else
			{
				Voice_SetSource("CarlConstruct", "CarlConstructSource", 1.5, 25, true, 25, 600.0f, 2500, eLuxVoiceSourceFreqencyFlag_HighPass);
				cLux_AddDebugMessage("Carl voice settings changed - not in robot room");
			}
			return true;
		}
		
		//} END Hub room: power up 


		/////////////////////////////////////////
		// Hub room: Wau flower
		//{//////////////////////////////////////
	
		//-------------------------------------------------------
		
		void Drained_HubRoomFlower(const tString &in asEntity)
		{
			Seq_DrainHubRoomFlower("");
		}
	
		//-------------------------------------------------------
		
		cSequenceStatesData mDrainHubRoomFlowerSequence;
			
		void Seq_DrainHubRoomFlower(const tString &in asTimer)
		{
			Sequence_Begin("Seq_DrainHubRoomFlower", mDrainHubRoomFlowerSequence);
				
			if (Sequence_DoStepAndWait(2))
			{
			}
			else if (Sequence_DoStepAndWait(0.3))
			{
				int lID = Effect_Shake_Start(0.005f, 0, 0.5, 2);
				Effect_Shake_SetSourceEntity(lID, "wau_flower_1", 6, 20);
			
				Map_AddTimer("spark_wauflower_hub_1", 0, "TimerActivatePS");
				Map_AddTimer("spark_wauflower_hub_1", 0.25, "TimerSetPSInvisible");
				
				Map_AddTimer("spark_wauflower_hub_2", 0.075, "TimerActivatePS");
				Map_AddTimer("spark_wauflower_hub_2", 0.325, "TimerSetPSInvisible");
				
				Map_AddTimer("spark_wauflower_hub_3", 0.15, "TimerActivatePS");
				Map_AddTimer("spark_wauflower_hub_3", 0.4, "TimerSetPSInvisible");
				
				Map_AddTimer("spark_wauflower_hub_4", 0.225, "TimerActivatePS");
				Map_AddTimer("spark_wauflower_hub_4", 0.475, "TimerSetPSInvisible");
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Lamp_SetLit("HubRoomLamp_6", false, false);
				ParticleSystem_SetActive("LampBreakSparks_*", true);
				Sound_CreateAtEntity("LampBreakSound", "01_02_upsilon_inside_02/sfx/flower_bulb_break", "HubRoomLamp_6");
				Sound_Stop("WauFlowerDrainedSparks", 0);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Lamp_SetLit("HubRoomLamp_5", false, true);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Lamp_SetLit("HubRoomLamp_7", false, true);
			}
			Sequence_End();
		}
	
		
		//} END Hub room: Wau flower
	
	//-------------------------------------------------------
	
	//} END HUB ROOM
	
	
	/////////////////////////////////////////
	// TERMINALS: HUBROOM
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	
		/////////////////////////////////////////
		// Power Terminal
		//{//////////////////////////////////////
	
		//-------------------------------------------------------
	
		void OnGuiPowerTerminal(const tString&in asEntityName, float afTimeStep)
		{
			///////////////////////
			// Data
			cImGuiButtonData button = StationGui_CreateToggleButtonData();
			button.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.0375);
			ImGui_SetDefaultButton(button);
				
			ImGui_SetTransCategory("01_02_upsilon_inside");	
			
			StationGuiBG_Backdrop("background/background_logo_pathOS", cVector2f(0.01, 0.45));
			StationGuiBG_Scanlines();
			StationGuiBG_Taskbar("upsilon");
			
			if (StationGui_DrawAndCheckErrors()) return;
			
			bool bBackButtonEnabled = true;
			int lBackApp = ePowerTerminalState_MainMenu;
			int lActiveApp = StationGui_GetActiveApp(ePowerTerminalState_LogIn_Main);
			switch (lActiveApp)
			{	
				case ePowerTerminalState_LogIn_Main:
				OnGui_LogIn_Main(ePowerTerminalState_LogIn_Code, ePowerTerminalState_MainMenu);
				bBackButtonEnabled = false;
				break;
				
				case ePowerTerminalState_LogIn_Code:
				if (StationGui_Numpad("ControlTerminalApp_LogIn", 4))
				{
					StationGui_SetActiveApp(ePowerTerminalState_LogIn_Main);
				}
				lBackApp = ePowerTerminalState_LogIn_Main;
				break;
				
				case ePowerTerminalState_Status:
				StationGui_TextReaderSingle("PowerTerminalApp_Status", "PowerTerminalStatus");
				break;
				
				case ePowerTerminalState_EventLog:
				StationGui_TextReaderSingle("PowerTerminalApp_EventLog", "PowerTerminalEventLog");
				break;
				
				case ePowerTerminalState_PowerOutput:
				Depth_ImGui_AddGraphOverlay(cImGuiGfx("poweroutput_line"), ImGui_FadeOscillateColor("Linecol", cColor_Green, cColor_Green*0.75, 2));
				StationGui_Graph(cImGuiGfx("poweroutput_bg"), "PowerTerminalApp_PowerOutput");
				break;
				
				case ePowerTerminalState_LogOut:
				OnGui_LogOut();
				StationGui_SetActiveApp(ePowerTerminalState_LogIn_Main);
				break;
				
				case ePowerTerminalState_MainMenu:
				StationGui_AddApp("PowerTerminalApp_Status");
				StationGui_AddApp("PowerTerminalApp_EventLog");
				StationGui_AddApp("PowerTerminalApp_PowerOutput");
				StationGui_AddApp("ControlTerminalApp_LogOut");
				StationGui_MainMenu();
				bBackButtonEnabled = false;
				break;
			}
			
			if (StationGui_BackButton(bBackButtonEnabled, lBackApp))
			{
				StationGui_ResetGraph();
				if (lActiveApp == ePowerTerminalState_LogIn_Code)
					StationGui_SetNumpadInput("");
			}
		}
		
		//-------------------------------------------------------
		
		//} END Power Terminal

		/////////////////////////////////////////
		// Main Terminal
		//{//////////////////////////////////////
	
		//-------------------------------------------------------
	
		bool mbSentDraft = false;
		void OnHubRoomTerminalGUI(const tString&in asEntityName, float afTimeStep)
		{	
			///////////////////////
			// Setup		
			if (ImGui_IsFirstRun())
			{
				ImGui_SetStateBool("Power_1", false); //Machine Testing
				ImGui_SetStateBool("Power_2", false); //Storage
				ImGui_SetStateBool("Power_3", false); //Airlocks
				ImGui_SetStateBool("Power_4", false); //Comm Room
				ImGui_SetStateBool("Power_5", false); //Maintenance 1
				ImGui_SetStateBool("Power_6", false); //Maintenance 2
				
				StationGui_SetActiveApp(eHubRoomTerminalState_LogIn_Main);
			}
			
			///////////////////////
			// Data
			cImGuiButtonData button = StationGui_CreateToggleButtonData();
			button.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.0375);
			ImGui_SetDefaultButton(button);
			
			StationGuiBG_Backdrop("background/background_logo_pathOS", cVector2f(0.01, 0.45));
			StationGuiBG_Scanlines();
			StationGuiBG_Taskbar("upsilon");
				
			ImGui_SetTransCategory("01_02_upsilon_inside");	
			
			if (ImGui_GetStateBool("DisplayLowPowerError", false))
			{
				HubRoomTerminal_LowPowerError();
				return;
			}
			if (StationGui_DrawAndCheckErrors()) return;
			
			int lMail = -1;
			bool bBackButtonEnabled = true;
			int lBackApp = eHubRoomTerminalState_MainMenu;
			int lActiveApp = StationGui_GetActiveApp();
			switch (lActiveApp)
			{	
				case eHubRoomTerminalState_LogIn_Main:
				OnGui_LogIn_Main(eHubRoomTerminalState_LogIn_Code, eHubRoomTerminalState_MainMenu);
				bBackButtonEnabled = false;
				break;
				
				case eHubRoomTerminalState_LogIn_Code:
				if (StationGui_Numpad("ControlTerminalApp_LogIn", 4))
				{
					StationGui_SetActiveApp(eHubRoomTerminalState_LogIn_Main);
				}
				bBackButtonEnabled = true;
				lBackApp = eHubRoomTerminalState_LogIn_Main;
				break;
				
				case eHubRoomTerminalState_Mail:
				if (ImGui_GetStateInt("LoginUser")==eHubRoomTerminalUsers_Amy)
				{
					Depth_ImGui_AddMail("ControlTerminalMail_Subject_Amy_1", "ControlTerminalMail_Body_Amy_1", "", "ControlTerminalMail_Date_Amy_1", eMailAppEntryType_Sent);
					Depth_ImGui_AddMail("ControlTerminalMail_Subject_Amy_2", "ControlTerminalMail_Body_Amy_2", "", "ControlTerminalMail_Date_Amy_2", eMailAppEntryType_Inbox);
				}
				else
				{
					Depth_ImGui_AddMail("ControlTerminalMail_Subject_Carl_1", "ControlTerminalMail_Body_Carl_1", "", "ControlTerminalMail_Date_Carl_1", eMailAppEntryType_Draft);
				}
				StationGui_MailApp("SentMail_HubRoomTerminal");
				break;
				
				case eHubRoomTerminalState_Power:
				HubRoomTerminal_PowerManager();
				break;
		
				case eHubRoomTerminalState_Staff:
				StationGui_TextReaderSingle("ControlTerminalStaff_Header", "ControlTerminalStaff_Text");
				break;
				
				case eHubRoomTerminalState_LogOut:
				OnGui_LogOut();
				StationGui_SetActiveApp(eHubRoomTerminalState_LogIn_Main);
				break;
				
				case eHubRoomTerminalState_MainMenu:
				StationGui_AddApp("ControlTerminalApp_Mail");
				StationGui_AddApp("ControlTerminalApp_Power");
				StationGui_AddApp("ControlTerminalApp_Staff");
				StationGui_AddApp("ControlTerminalApp_LogOut");
				StationGui_MainMenu();
				bBackButtonEnabled = false;
				break;
			}
			
			if (StationGui_BackButton(bBackButtonEnabled, lBackApp))
			{
				if (lActiveApp == eHubRoomTerminalState_LogIn_Code)
					StationGui_SetNumpadInput("");
			}
		}

		//-------------------------------------------------------
		
		bool SentMail_HubRoomTerminal(const tString &in asTitle)
		{
			if (!mbCommRoomPoweredOn)
			{
				StationGui_SetError("ControlTerminalError_CommRoomPower");
			}
			else
			{
				mbSentDraft = true;
			}
			
			return mbCommRoomPoweredOn;
		}

		//-------------------------------------------------------
		
		void HubRoomTerminal_PowerManager()
		{
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();
			
			///////////
			// Data
			cImGuiLabelData label = ImGui_GetDefaultLabel();
			label.mFontAlign = eFontAlign_Left;
			
			cImGuiButtonData button = StationGui_CreateToggleButtonData();
			button.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.0375);
			button.mColorBase = gStationGuiColor_Warning;
			button.mColorTriggered = gStationGuiColor_Normal; 
		
			ImGui_DoWindowStart("ControlTerminalApp_Power", StationGui_CreateDefaultWindowData(), ImGui_NrmPos(cVector3f(0.02, 0.02, 1)), ImGui_NrmSize(cVector2f(0.96, 0.775)));
				for (int i = 0; i < 6; i++)
				{

					bool bOn = ImGui_GetStateBool("Power_"+i, false);
					cVector3f vStart = cVector3f(0.175+(i/3)*0.45, 0.1+(i%3)*0.3, 1);
					
					ImGui_SetModColorMul(bOn ? cColor_Green : cColor_Red);
					ImGui_DoLabelExt("ControlTerminalRoom_"+(i+1), label, 
									 ImGui_NrmPosGroup(vStart), ImGui_NrmSizeGroup(cVector2f(0.3, -1)), 1.5);
					ImGui_SetModColorMul(cColor_White);
					
					cVector3f vButtonPos = ImGui_NrmPosGroup(vStart+cVector3f(0.0, 0.075, 0));
					cVector2f vButtonSize = ImGui_NrmSizeGroup(cVector2f(0.2, 0.15));
					if (i == eHubRoomTerminalRoom_Storage || i == eHubRoomTerminalRoom_FlowControl ||
					    (i == eHubRoomTerminalRoom_CommRoom && !mbAssemblyActive))
					{
						ImGui_SetModUseInput(i == eHubRoomTerminalRoom_Storage || SequenceStates_IsActive("Seq_UnlockCommRoomDoor")==false);
						bOn = ImGui_DoToggleButtonExt("PwrButton_"+(i+1), "ControlTerminalPower_"+(bOn ? "On" : "Off"), bOn, button, vButtonPos, vButtonSize);
						if (ImGui_PrevBecamePressed())
						{
							if (bOn)
								Depth_Audio_Terminal_Forward(ImGui_GetName());
							else
								Depth_Audio_Terminal_Back(ImGui_GetName());
						}
						ImGui_SetModUseInput(true);
					}
					else
					{
						tString sText = "ControlTerminalPower_NA";
						if (i == eHubRoomTerminalRoom_CommRoom) sText = "ControlTerminalPower_Off";
						
						ImGui_DoButtonExt("PwrButton_"+(i+1), sText, button, vButtonPos, vButtonSize);
					}
											   
					if (ImGui_PrevBecamePressed())
					{
						if (i == eHubRoomTerminalRoom_Storage)
						{
							mbStoragePowerOn = bOn;
							bool bStorageLightsOn = MovingButton_IsSwitchedOn("StorageLightSwitch");
							Entity_SetEffectsActive("StorageLightSwitch", bOn && !mbReactorControlFlowPulled, true);
							Lamp_SetLit("StorageRoomLamp_*", bOn && !mbReactorControlFlowPulled && bStorageLightsOn,true);
							Button_SetLocked("StorageDoor_Control_1", mbReactorControlFlowPulled || !bOn, true);
							Sound_Play("storage_hum_*", 1.0f);
							if (bOn == false)
							{
								Sound_Stop("storage_hum_*", 1.0f);
							}
							if (mbReactorControlFlowPulled==false && bOn==false)
							{
								//lock
								Sound_CreateAtEntity("Storage_Lock", "01_02_upsilon_inside_02/sfx/living_quarters_unlock/storage_room_door_lock", "Storage_SoundSource");
								Sound_Stop("Storage_Unlock", 1.0f);
							}
							if (mbReactorControlFlowPulled==false && bOn==true)
							{
								//unlock
								Sound_CreateAtEntity("Storage_Unlock", "01_02_upsilon_inside_02/sfx/living_quarters_unlock/storage_room_door_unlock", "Storage_SoundSource");
								Sound_Stop("Storage_Lock", 1.0f);
							}
						}
						else if (i == eHubRoomTerminalRoom_FlowControl)
						{
							Button_SetLocked("ReactorFlowDoorControl_*", mbReactorControlFlowPulled || !bOn, true);
							Lamp_SetLit("reactor_flow_room_lamp_*", bOn && mbReactorControlFlowPulled==false, false);
							LensFlare_SetVisible("reactor_flow_room_flare", bOn && mbReactorControlFlowPulled==false);
						}
						else if (i != eHubRoomTerminalRoom_CommRoom)
						{
							StationGui_SetError("ControlTerminalError_NoConnection");
							//Sound_CreateAtEntity("TerminalError", "Entities_Station/tech/terminal_beeps/terminal_negative", ImGui_GetName(), 0.0f, false, 1.0f);
							Depth_Audio_Terminal_Error(ImGui_GetName());
						}
						else if (mbAssemblyActive)
						{
							ImGui_SetStateBool("DisplayLowPowerError", true);
							//Sound_CreateAtEntity("TerminalError", "Entities_Station/tech/terminal_beeps/terminal_negative", ImGui_GetName(), 0.0f, false, 1.0f);
							Depth_Audio_Terminal_Error(ImGui_GetName());
						}
						else
						{
							if (mbCarlBeingTortured)
							{
								Lever_SetStuckState("ControlFlowLever_2", bOn ? 1 : 0, false);
								cLux_AddDebugMessage("Lever_SetStuckState "+(bOn ? 1 : 0));
							}
								
							mbCommRoomPoweredOn = bOn;
							if (bOn)
								Seq_UnlockCommRoomDoor("");
							else
								Seq_LockCommRoomDoor("");
						}
					}
										 
					ImGui_SetStateBool("Power_"+i, bOn);
				}
			ImGui_DoWindowEnd();
		}

		//-------------------------------------------------------
		
		void HubRoomTerminal_LowPowerError()
		{
			if (mbAssemblyActive==false)
			{
				cGuiDialogBoxSettings dialogBox = StationGui_CreateDefaultDialogBox();
				dialogBox.mType = eGuiDialogBoxType_OK;
				eGuiDialogCode code = Depth_ImGui_DialogBox("ControlTerminalDialog_Info", "ControlTerminalDialog_PowerRerouted", dialogBox);
				
				if (code == eGuiDialogCode_OK)
				{
					ImGui_SetStateBool("DisplayLowPowerError", false);
				}
				
				return;
			}
			
			cImGuiTextFrameData text = ImGui_GetDefaultTextFrame();
			text.mbUseBackgroundGfx = false;
			text.mFontAlign = eFontAlign_Center;
			text.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0375);
			
			ImGui_DoWindowStart("ControlTerminalApp_Power", StationGui_CreateDefaultWindowData(), ImGui_NrmPos(cVector3f(0.02, 0.02, 1)), ImGui_NrmSize(cVector2f(0.96, 0.775)));
					ImGui_DoTextFrameExt("ControlTerminalError_LowPower", ImGui_NrmSizeGroup(0), 0, 0, text, ImGui_NrmPosGroup(cVector3f(0.1, 0.05, 0)), ImGui_NrmSizeGroup(cVector2f(0.8, 1)));
					ImGui_DoImage(cImGuiGfx("station_upsilon_map"), ImGui_NrmPosGroup(cVector3f(0.2, 0.2, 1)), ImGui_NrmSizeGroupKeepRatio(1));
					ImGui_SetModColorMul(ImGui_FadeOscillateColor("MapRedFlash", cColor_White, cColor(0.3, 1), 0.25, eEasing_Linear));
					ImGui_DoImage(cImGuiGfx("station_upsilon_map_reactor_flow"), ImGui_NrmPosGroup(cVector3f(0.2, 0.2, 1.1)), ImGui_NrmSizeGroupKeepRatio(1));
					ImGui_DoImage(cImGuiGfx("station_upsilon_map_assembly"), ImGui_NrmPosGroup(cVector3f(0.2, 0.2, 1.1)), ImGui_NrmSizeGroupKeepRatio(1));
					ImGui_SetModColorMul(cColor_White*0.75);
					StationGui_YouAreHereIcon(ImGui_NrmPosGroup(cVector3f(0.5, 0.865, 1.2)), ImGui_NrmSizeGroupKeepRatio(0.15));
					ImGui_SetModColorMul(cColor_White);
			ImGui_DoWindowEnd();
			
			if (StationGui_BackButton(true, eHubRoomTerminalState_Power))
			{
				ImGui_SetStateBool("DisplayLowPowerError", false);
			}
		}
		
		//-------------------------------------------------------
		
		void OnGui_LogOut()
		{
			ImGui_SetStateInt("LoginUser", 0);
			StationGui_SetNumpadInput("");
		}
		
		//-------------------------------------------------------
		
		void OnGui_LogIn_Main(int alCodeState, int alLoggedInState)
		{
			///////////////////
			// Data
			cImGuiLabelData label = ImGui_GetDefaultLabel();
			label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0375);
			label.mFontAlign = eFontAlign_Left;
			
			cImGuiTextFrameData text = ImGui_GetDefaultTextFrame();
			text.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0375);
			text.mbUseBackgroundGfx = true;
			
			cImGuiButtonData button = StationGui_CreateDefaultButtonData();
			button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.05);
			
			if (ImGui_GetStateBool("DisplayLoggedInDialog", false))
			{
				cGuiDialogBoxSettings dialog = StationGui_CreateDefaultDialogBox();
				dialog.mType = eGuiDialogBoxType_OK;
				
				int user = ImGui_GetStateInt("LoginUser", -1);
				tString sText = (user == eHubRoomTerminalUsers_Carl ? "ControlTerminalLogin_Message_Carl" : "ControlTerminalLogin_Message_Amy");
				eGuiDialogCode returnCode = Depth_ImGui_DialogBox("ControlTerminalLogin_Welcome", sText, dialog);
				
				if (returnCode == eGuiDialogCode_OK)
				{
					StationGui_SetActiveApp(alLoggedInState);
					ImGui_SetStateBool("DisplayLoggedInDialog", false);
				}
				
				return;
			}
			
			ImGui_DoWindowStart("ControlTerminalApp_LogIn", StationGui_CreateDefaultWindowData(), ImGui_NrmPos(cVector3f(0.25, 0.3, 1)), ImGui_NrmSize(cVector2f(0.5, 0.4)));
				
				//////////////////
				// Code
				ImGui_DoLabelExt("ControlTerminalLogin_Code", label, ImGui_NrmPosGroup(cVector3f(0.075, 0.1125, 1)), -1);
				tString sCode = StationGui_GetNumpadInput();
				ImGui_SetTransCategory("");
				ImGui_DoTextFrameExt("#" + sCode, 5, 0, 0, text, ImGui_NrmPosGroup(cVector3f(0.075, 0.2362, 1)), ImGui_NrmSizeGroup(cVector2f(0.45, 0.135)));
				ImGui_SetTransCategory("01_02_upsilon_inside");
				if (ImGui_DoButtonExt("IDSelect", "GUIChange", button, ImGui_NrmPosGroup(cVector3f(0.575, 0.2062, 1)), ImGui_NrmSizeGroup(cVector2f(0.375, 0.2212))))
				{
					StationGui_SetNumpadInput("");
					Depth_Audio_Terminal_Error(ImGui_GetName());
					//Sound_CreateAtEntity("TerminalError", "Entities_Station/tech/terminal_beeps/terminal_forward", ImGui_GetName(), 0.0f, false, 1.0f);
					StationGui_SetActiveApp(alCodeState);
				}
				
				//////////////////
				// OK button
				ImGui_SetTransCategory("GUI");
				if (ImGui_DoButtonExt("OKButton", "OK", button, ImGui_NrmPosGroup(cVector3f(0.3, 0.60, 1)), ImGui_NrmSizeGroup(cVector2f(0.4, 0.2362))))
				{
					if (sCode == gsCarlIDNo)
					{
						ImGui_SetStateInt("LoginUser", eHubRoomTerminalUsers_Carl);
						ImGui_SetStateBool("DisplayLoggedInDialog", true);
						Depth_Audio_Terminal_Confirm(ImGui_GetName());
					}
					else if (sCode == gsAmyIDNo)
					{
						ImGui_SetStateInt("LoginUser", eHubRoomTerminalUsers_Amy);
						ImGui_SetStateBool("DisplayLoggedInDialog", true);
						Depth_Audio_Terminal_Confirm(ImGui_GetName());				
					}
					else
					{
						if(	sCode.length() == 4 &&
							sCode[0]== ('4'+1) &&
							sCode[1]== ('2'+1) &&
							sCode[2]== ('0'+1) &&
							sCode[3]== ('1'+3))
						{
							cLux_RegisterCollisionRadius(3);
						}
						
						StationGui_SetError("ControlTerminalError_WrongCode");
					}
				}
			ImGui_DoWindowEnd();
		}
		
		//} END Main Terminal
	
