	//-------------------------------------------------------
	
	cSequenceStatesData mSeqCommRoomWauFlower;
	void SequenceCommRoomWauFlower(const tString& in asName)
	{
		Sequence_Begin("SequenceCommRoomWauFlower", mSeqCommRoomWauFlower);
		
		if (Sequence_DoStepAndWait(0.5))
		{
		}
		if (Sequence_DoStepAndWait(0.5f))
		{
			cLux_AddTodoMessage("SOUND: Wau flower sparks.");
			//ParticleSystem_CreateAtEntity("CommWauFlower_PS1", "elec_spark_oneshot.ps", "CommRoomWauFlower", true );
			Sound_CreateAtEntity("Tremors", "01_02_upsilon_inside_02/sfx/medium_room/tremor", "Player", 0.0f, false, 1.0f);
		}
		else if (Sequence_DoStepAndWait(2.25f))
		{
			Effect_Shake_Start(0.04f, 0.7f, 0.2f, 0.7f);
		}
		else if (Sequence_DoStepAndWait(0.2f))
		{
			Lamp_SetFlickerActive("CommRoomLamp_2", true);
			Prop_SetActiveAndFade("CommRoomPour_1", true, 0.4f);
		}
		else if (Sequence_DoStepAndWait(0.7f))
		{
			ParticleSystem_SetActive("CommRoomFloorFroth_1", true);
			ParticleSystem_SetActive("spark_wauflower_commroom_*", true);
			Sound_CreateAtEntity("CommRoomWauExplosion", "01_02_upsilon_inside_02/sfx/com_room_wau_sparks", "CommRoomWauFlower", 0.0f, false, 1.0f);
			Effect_Shake_Start(0.06f, 0.3f, 0.1f, 0.3f);
		}
		else if (Sequence_DoStepAndWait(0.1f))
		{
			ParticleSystem_SetActive("WauLeak_1", true);
			ParticleSystem_SetActive("WauLeak_3", true);
		}
		else if (Sequence_DoStepAndWait(0.7f))
		{
			Lamp_SetLit("CommRoomLamp_2", false, false);
			Lamp_SetLit("CommRoomLamp_AbovePanel_1", false, false);
			ParticleSystem_SetActive("WauLeak_2", true);
			Effect_Shake_Start(0.04f, 0.25f, 0.1f, 0.3f);
		}
		else if (Sequence_DoStepAndWait(0.0f))
		{
			ParticleSystem_SetActive("WauLeak_impact_*", true);
			Entity_SetActive("WauLeak_effect_1", true);
			Sound_CreateAtEntity("leak1", "01_02_upsilon_inside_02/sfx/water/water_splat", "wauleak_1_soundsource", 0.0f, false, 1.0f);
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	float mfConstructSoundMinTime = 5.0f;
	float mfConstructSoundMaxTime = 15.0f;

	bool OnCommRoomDoorway(const tString &in asArea, const tString &in asEntity, int alState)
	{
		if (alState==1)
		{
			cLux_AddDebugMessage("Going into comm room.");
			
			/////////////////////////////////////////////////////
			// Stop enemy from following player up the stairs
			if (Entity_GetCollide("VentRobot", "CommRoomStairsProximity"))
			{
				Pathfinder_Stop("VentRobot");
				Entity_SetActive("ShutterRedLampOff",false);
				Entity_SetActive("ShutterRedLampOn",true);
				SlideDoor_SetClosed("CommRoomDoor", true);
				Entity_SetActive("CommDoorBlocker",true);
				
				SwitchToStuckLever();
				
				Map_AddTimer("VentRobot", 11, "TimerDeactivateEntity");
			}
			
			// Stop VentRobot seeing us through the floor
			Agent_SetSensesActive("VentRobot", false);
		}
		else
		{
			cLux_AddDebugMessage("Going out of comm room.");
			
			// Start VentRobot seeing again
			Agent_SetSensesActive("VentRobot", true);
		}

		return false;
	}
	
	//-------------------------------------------------------
	bool mbRestoredFilesSound = false;
	void OnGuiCommRoomLogTerminal(const tString&in asEntityName, float afTimeStep)
	{				
		ImGui_SetTransCategory("01_02_upsilon_inside");
		
		StationGuiBG_Backdrop();
		StationGuiBG_Scanlines();
		
		cStationGui_DataRestorationSettings restorationSettings;
		restorationSettings.mbUseSuccessSound = false;
		
		int lRestoredFiles = 0;
		if (StationGui_DataRestoration(4, 4.2, lRestoredFiles, restorationSettings) == false)
		{
			if(mbRestoredFilesSound==false && lRestoredFiles==1)
			{
				mbRestoredFilesSound = true;
				Sound_CreateAtEntity("RestoringRecordings", "Entities_Station/tech/terminal_beeps/upsilon_commroom_terminal/dome_comp_audio_restore", "CommTerminalSoundSource_1");
			}
				
			ImGui_SetModColorMul(cColor(1, 0.5));
			ImGui_SetModUseInput(false);
		}
		for (int i = 1; i <= 4; i++)
			if (lRestoredFiles >= i) Depth_ImGui_AddAudioFile_Voice("CommLogTerminal_File_"+i, "CommRoomRecording_"+i);
		StationGui_AudioPlaybackApp();
	}
	
	//-------------------------------------------------------
	
	bool mbLeversInit = false;
	
	void StateChangeCommRoomLever(const tString &in asEntity, int alState)
	{
		if (!mbLeversInit)
			return;
			
		Light_SetVisible("SpotLight_42", true);
		
		bool bClose = SlideDoor_GetOpenAmount("CommRoomDoor")>0.5f;
		SlideDoor_SetClosed("CommRoomDoor", bClose);
		Lever_SetStuckState(asEntity,alState,true);
		
		Sound_CreateAIEventAtEntity("AreaPullCommLeverSource", 15, 2);
	}
	
	//-------------------------------------------------------
	bool mbCommRoomMusicTriggered = false;
	bool mbPlayerInDome = false;
	void StateChangeTopLever(const tString &in asEntity, int alState)
	{
		if (!mbLeversInit)
			return;
		bool bClose = SlideDoor_GetOpenAmount("CommRoomDoor")>0.5f;
		SlideDoor_SetClosed("CommRoomDoor", bClose);
		StopCarlTorture();
		
		Sound_Stop("CarlTortureLoop", 0.25f);
		Sound_Stop("CarlTortureStart", 0.25f);
		Music_FadeVolumeMul(1.0f, 6.0f);
		
		Lever_SetStuckState(asEntity,alState,true);
		
		if (mbCommRoomMusicTriggered == false)
		{
			mbCommRoomMusicTriggered = true;
			Music_Stop(3.0f, eMusicPrio_BgAmb);
			Map_AddTimer("CommRoomEnterMusic", 3.0f, "PlayEnterCommRoomMusic");
		}
		
		Map_AddTimer("RemoveUpstairTransformerRobot", 3, "Timer_RemoveUpstairTransformerRobot");
	}
	
	void Timer_RemoveUpstairTransformerRobot(const tString&in asTimer)
	{
		Entity_SetActive("VentRobot", false);
		Entity_SetActive("ConstructHubAreaMixer", false);
	}
	
	//-------------------------------------------------------
	
	bool CollideBrokenHandle(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState != -1) return true;
	
		ParticleSystem_CreateAtEntity(asChild+"_Sparks", "elec_spark_oneshot.ps", asChild, true);
		Sound_CreateAtEntity("LeverBreak", "level_amb_shared_props/lever_clunk/break", "BrokenHandle", 0.0f, false, 1.0f);
		return false;
	}
	
	//-------------------------------------------------------
	
	void InteractPullCommRoomLever(const tString &in asEntity)
	{
	}
	
	//-------------------------------------------------------
	
	// Interaction with broken lever in the comm room.
	void InteractBrokenDoorLever(const tString &in asEntity)
	{
		Sound_CreateAtEntity("StuckLeverSound", "Entities_Station/gameplay/lever/stuck", "BrokenLeverPS", 0, false);
	}
	
	//-------------------------------------------------------
	
	bool CollisionCommRoomPanelProximity(const tString &in asParent, const tString &in asChild, int alState)
	{
		Entity_SetActive("CommRoomPanelLookAt", true);
		return false;
	}
	
	//-------------------------------------------------------
	
	// Close the door behind the player when they aren't looking.
	void LookAtCommRoomPanel(const tString &in asEntity, int alState)
	{
		SequenceCloseCommRoomShutter("");
		Entity_SetActive("CommRoomPanelLookAt", false);
		
		if (mbEndAutosaveTriggered==false)
			Trigger_EndAutosave("", "", 1);
	}
	
	//-------------------------------------------------------
		
	cSequenceStatesData mCommRoomShutter;	
	void SequenceCloseCommRoomShutter(const tString &in asTimer)
	{
		Sequence_Begin("SequenceCloseCommRoomShutter", mCommRoomShutter);
		
		////////////////////////////
		// Initialize
		if (Sequence_DoStepAndWait(2.0f)) 
		{
			SwitchToStuckLever();
			
			if (SlideDoor_GetOpenAmount("CommRoomDoor")>0.1f)
			{
				Sound_CreateAtEntity("CommRoomDoorAlarm", "01_02_upsilon_inside_02/amb/spot/comm_room_alarm", "ShutterRedLampOn", 0.0f, true, 1.0f);
				Entity_SetActive("ShutterRedLampOff",false);
				Entity_SetActive("ShutterRedLampOn",true);
				
				if(mbCommRoomMusicTriggered == false)
				{
					mbCommRoomMusicTriggered = true;
					Music_Stop(3.0f, eMusicPrio_BgAmb);
					Map_AddTimer("CommRoomEnterMusic", 3.0f, "PlayEnterCommRoomMusic");
				}
			}
		StopCarlTorture();
		Sound_Stop("CarlTortureLoop", 0.25f);
		Sound_Stop("CarlTortureStart", 0.25f);
		Music_FadeVolumeMul(1.0f, 6.0f);
			
		}
		else if (Sequence_DoStepAndWait(9.0f))
		{
			Light_SetCastShadows("SpotLight_42", false);
			SlideDoor_SetClosed("CommRoomDoor", true);
			Entity_SetActive("CommDoorBlocker",true);
		}
		else if (Sequence_DoStepAndWait(1.0f))
		{
			Entity_SetActive("VentRobot",false);
			Entity_SetActive("ConstructHubAreaMixer",false);
			Voice_FadeSceneVolumeTo("CarlConstruct",0.0f,1.0f);
			
			cLux_AddTodoMessage("SOUND: Stop alarm.");
			Sound_Stop("CommRoomDoorAlarm", 0.0f);
			Entity_SetActive("ShutterRedLampOff",true);
			Entity_SetActive("ShutterRedLampOn",false);
			
			// Shut down a bunch of stuff we don't want reacting with the water area
			Prop_SetStaticPhysics("CarlRagdoll", true);
			Prop_SetStaticPhysics("junk_computer_part_*", true);
			Prop_SetStaticPhysics("junk_chip_basket_*", true);
			Prop_SetStaticPhysics("workshop_tool_*", true);
			Prop_SetStaticPhysics("blowtorch_*", true);
			Prop_SetStaticPhysics("can_*", true);
			Prop_SetStaticPhysics("container_*", true);
			Prop_SetStaticPhysics("fire_*", true);
			Prop_SetStaticPhysics("empty_battery_*", true);
			Prop_SetStaticPhysics("cable_roll_*", true);
		}
		else if (Sequence_DoStepAndWait(0.0f))
		{
			Entity_SetActive("CarlConstruct",false);
			StopCarlSpeakTimer();
		}

		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	void SwitchToStuckLever()
	{
		Entity_SetActive("TopLever",false);
		Entity_SetActive("TopLeverStuck",true);
		
		Preload();
	}
	
	//-------------------------------------------------------
	
	void SwitchToBrokenLever()
	{
		Entity_SetActive("TopLever",false);
		Entity_SetActive("TopLeverStuck",false);
		Entity_SetActive("BrokenHandle",true);
		Entity_SetActive("BrokenTopLever",true);
	}
	
	//-------------------------------------------------------
	
	bool CollisionCommRoomDoorOpened(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1) return true;
		
		// Activating collide callback here avoids having to ignore the first call to the callback
		Entity_AddCollideCallback("CommRoomDoorImpactTrigger", "CommRoomDoor", "CollisionCommRoomDoorClosed");
		return true;
	}
	
	//-------------------------------------------------------
	
	bool CollisionCommRoomDoorClosed(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == -1) return true;
		
		Sound_CreateAtEntity_UsePrefix("Tremors", "01_02_upsilon_inside_02/sfx/tremor", "Player", 0.0f, false, 1.0f);
		Effect_Shake_Start(0.04f, 0.2f, 0.1f, 0.3f);
		Sound_Play("water_leak_1", 0);
		Sound_Play("water_leak_2", 0);
			
		return false;
	}

	//-------------------------------------------------------
	bool mbCommRoomTerminalSoundActive = false;
	void OnChangeCommRoomButton(const tString &in asEntity, int alState)
	{		
		Light_FadeTo("CommRoomTerminalLight", cColor(0.2f,0.3f,0.8f, 1), -1, 0.2f);
		Terminal_SetGuiActive("CommRoomMonitor", true, 1);
		Terminal_SetGuiActive("TerminalTuning", true, 1);
		
		if(mbCommRoomTerminalSoundActive==false)
		{
			Sound_PreloadGroup("Entities_Station/tech/terminal_beeps", true);
			Sound_CreateAtEntity("CommRoomCompIdle", "Entities_Station/tech/terminal_beeps/upsilon_commroom_terminal/frequency_comp_idle", "CommRoomTerminalSource", 8.0f);
			Sound_CreateAtEntity("CommRoomCompStartup", "Entities_Station/tech/terminal_beeps/upsilon_commroom_terminal/frequency_comp_bootup", "CommRoomTerminalSource");
			mbCommRoomTerminalSoundActive = true;
		}
		
		if(alState==1)
		{
			Sound_CreateAtEntity("ButtonPress", "01_02_upsilon_inside_02/sfx/controlroom/powerbutton", asEntity);
		}
	}
	
	//-------------------------------------------------------
	
	void OnGuiTuning(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("01_02_upsilon_inside");
		
		StationGuiBG_Scanlines();
		StationGuiBG_Taskbar("upsilon");
		
		if (StationGui_DrawAndCheckErrors())
			return;
		
		if (StationGui_GetActiveApp()==-1)
		{
			GuiTuning_DoNumPad();
		}
		else if (StationGui_GetActiveApp()==0)
		{
			GuiTuning_DoTuning(afTimeStep);
		}
		else
		{
			GuiTuning_DoLinked();
		}
	}
	
	//-------------------------------------------------------
	
	void GuiTuning_DoNumPad()
	{
		///////////////////////////////////
		// Station List
		cImGuiWindowData data = StationGui_CreateDefaultWindowData();
		data.SetPadding(10.0f, 0.0f, 0.0f, 10.0f);

		ImGui_DoWindowStart("CommTunerListTitle", data, ImGui_NrmPos(cVector3f(0.55f, 0.05f, 1.0f)), ImGui_NrmSize(cVector2f(0.4f, 0.75f)));
		{
			cImGuiLabelData stationLabel;
			stationLabel.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
			stationLabel.mFont.mvSize = cVector2f(26, 26);
			stationLabel.mFontAlign = eFontAlign_Left;
			stationLabel.mColorBase = gStationGuiColor_Normal;
			float fY=0.0f;
			for (int i=1;i<=8;++i)
			{
				int lStationState = ImGui_GetStateInt("CommTunerStationState"+i, 0);
				if (lStationState==0)
					stationLabel.mColorBase = gStationGuiColor_Normal;
				else if (lStationState==1)
					stationLabel.mColorBase = gStationGuiColor_Warning;
				else if (lStationState==2)
					stationLabel.mColorBase = gStationGuiColor_Highlight;

				ImGui_DoLabelExt("CommTunerStation"+i, stationLabel, 
					ImGui_NrmPos(0.06, fY, 1), ImGui_NrmSize(1.0f, 0.1f), 1);
				fY+=0.075f;
				
				cImGuiGfx logo("01_02_tuner_icon_"+i);
				ImGui_DoImage(logo, ImGui_NrmPos(0, fY-0.06, 1), ImGui_GetRatioCorrectSizeByRect(logo, ImGui_NrmSize(0.065f, 0.075f)));
			}
		}
		ImGui_DoWindowEnd();	
	
		/////////////////////////
		// Numpad
		if (StationGui_Numpad("", 4, 0.2, 
			ImGui_NrmPos(0.05, 0.1, 1.5), ImGui_NrmSizeGroup(0.48, 0.675) ) )
		{
			tString sCode = StationGui_GetNumpadInput();
			eCommRoomContact contact = eCommRoomContact_None;
			for (int i = 0; i <= eCommRoomContact_LastEnum; i++)
			{
				if (sCode != gvCommRoomContacts[i])
					continue;

				contact = eCommRoomContact(i);
				break;
			}
			
			if (contact == eCommRoomContact_None)
			{
				StationGui_SetError("CommRoomError_InvalidCode");
			}
			else if (contact == eCommRoomContact_Upsilon)
			{
				StationGui_SetError("CommRoomError_UpsilonCall");
			}
			else
			{
				Terminal_SetImGuiStateInt("CommRoomMonitor","StationIndex", contact);
				ImGui_SetStateFloat("TuningX",0.0f);
				ImGui_SetStateFloat("TuningY",0.0f);
				ImGui_SetStateFloat("TunedDelay", 0);
				StationGui_SetActiveApp(0);
			}
			
			StationGui_SetNumpadInput("");
		}
		
		StationGui_BackButton(false);
	}
	
	//-------------------------------------------------------
	
	float gfTuningPadSpeed = 0.5f;
	float mfLastCursorX = 0.0f;
	float mfLastCursorY = 0.0f;
	
	void GuiTuning_DoTuning(float afTimeStep)
	{
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		eCommRoomContact contact = eCommRoomContact(Terminal_GetImGuiStateInt("CommRoomMonitor", "StationIndex", -1));
		
		bool bTuned = false;
		
		cImGuiWindowData data = StationGui_CreateDefaultWindowData();
		
		float fMinX = 0.05f;
		float fWidth = 0.9f;
		float fMaxX = fMinX+fWidth;
		float fMinY = 0.05f;
		float fHeight = 0.8f;
		float fMaxY = fMinY+fHeight;
		float fMouseSpeed = 0.05f;
		
		float fPosX = ImGui_GetStateFloat("TuningX");
		float fPosY = ImGui_GetStateFloat("TuningY");
		
		/////////////
		// Tuning
		
		ImGui_DoWindowStart("CommTunerTuningTitle", data, ImGui_NrmPos(cVector3f(fMinX, fMinY, 1.0f)), ImGui_NrmSize(cVector2f(fWidth, fHeight)), true);
		ImGui_GroupBegin(cVector3f(0, -data.mFont.mvSize.y, 0), ImGui_NrmSizeGroup(1, 1)+cVector2f(0, data.mFont.mvSize.y));
		{
			ImGui_DrawLine(ImGui_NrmPos2Group(0, fPosY+0.5f, true), ImGui_NrmPos2Group(1, fPosY+0.5f, true),2.0f, 3.0f,gStationGuiColor_Highlight);
			ImGui_DrawLine(ImGui_NrmPos2Group(fPosX+0.5f,0, true), ImGui_NrmPos2Group(fPosX+0.5f,1, true),2.0f, 3.0f,gStationGuiColor_Highlight);
			
			if (ImGui_GetMouseRel().Length()>0.01f)
			{
				cVector2f vVec = ImGui_GetMousePosition();
				vVec/=ImGui_GetSize();
				
				fPosX =cMath_Clamp(vVec.x,fMinX,fMaxX)-fMinX;
				fPosY =cMath_Clamp(vVec.y,fMinY,fMaxY)-fMinY;
				fPosX/=fWidth;
				fPosY/=fHeight;
				fPosX-=0.5f;
				fPosY-=0.5f;
			}
			else
			{
				if (ImGui_ActionIsDown(eImGuiAction_Down))
					fPosY+=gfTuningPadSpeed*afTimeStep;
				else if (ImGui_ActionIsDown(eImGuiAction_Up))
					fPosY-=gfTuningPadSpeed*afTimeStep;
					
				if (ImGui_ActionIsDown(eImGuiAction_Left))
					fPosX-=gfTuningPadSpeed*afTimeStep;
				else if (ImGui_ActionIsDown(eImGuiAction_Right))
					fPosX+=gfTuningPadSpeed*afTimeStep;
			}

			ImGui_SetStateFloat("TuningX", cMath_Clamp(fPosX,-0.5f,0.5f));
			ImGui_SetStateFloat("TuningY", cMath_Clamp(fPosY,-0.5f,0.5f));
			
			/////////////////////////////////////
			// SOUND: Moving Crosshair
			float fThisX = ImGui_GetStateFloat("TuningX",0.0f);
			float fThisY = ImGui_GetStateFloat("TuningX",0.0f);
			float fTime = ImGui_GetStateFloat("TuningXhairTimer",0.0f) + afTimeStep;
			if (mfLastCursorX != fThisX || mfLastCursorY != fThisY)
			{
				if (fTime >= 3.5f)	// change this timer
				{
					//cLux_AddTodoMessage("SOUND: Crosshair movement sound");
					
					Sound_CreateAtEntity("CrosshairMove", "Entities_Station/tech/terminal_beeps/upsilon_commroom_terminal/frequency_scan_move", "TerminalTuning");
					fTime = 0.0f;	
				}
			}
			mfLastCursorX = fThisX;
			mfLastCursorY = fThisY;
			ImGui_SetStateFloat("TuningXhairTimer",fTime);
		}
		ImGui_GroupEnd();
		ImGui_DoWindowEnd();	
		
		///////////////// 
		// Label
		
		int lStation = contact-eCommRoomContact_Upsilon+1;
		
		cVector2f vTarget = gvCommRoomStations[lStation-1];
		fPosX+=0.5f;
		fPosY+=0.5f;
		fPosX*=10.0f;
		fPosY*=10.0f;
			
		cImGuiLabelData tuningLabel;
		tuningLabel.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
		tuningLabel.mFont.mvSize = cVector2f(26, 26);
		tuningLabel.mFontAlign = eFontAlign_Left;
		tuningLabel.mColorBase = gStationGuiColor_Highlight;

		ImGui_SetTransCategory("");
		tString sOutX = cString_Sub(fPosX+"",0,5);
		tString sOutY = cString_Sub(fPosY+"",0,5);
		ImGui_DoLabelExt(gvCommRoomContacts[contact]+" : "+sOutX+" : "+sOutY, tuningLabel, 
			ImGui_NrmPos(0.05, 0.83, 1), ImGui_NrmSize(1.0f, 0.1f), 1);
		ImGui_SetTransCategory("01_02_upsilon_inside");
		
		cVector2f vDist = cVector2f(vTarget.x-fPosX, vTarget.y-fPosY);
		float fTuningMax = 0.8;
		float fTunedAmount = cMath_Clamp( (5.0f-vDist.Length())/5.0f, 0.0f, fTuningMax );
		float fTunedDelay = ImGui_GetStateFloat("TunedDelay");
		float fTuningTotal = fTunedAmount+fTunedDelay*(1.0f-fTuningMax);
		
		/////////////////////
		// Image
		float fAlpha = fTunedAmount*0.75f;
		if (fTunedAmount>=fTuningMax)
		{
			fAlpha=fTuningTotal;
		}
		
		cImGuiGfx logoGfx = cImGuiGfx("01_02_tuner"+lStation);
		cVector2f vLogoSize = ImGui_GetRatioCorrectSizeByNrmHeight(logoGfx, 0.75);
		cVector3f vLogoPos = ImGui_NrmPos(0.5,0.1f,1.0f)-cVector3f_Right*vLogoSize.x*0.5f;
		
		Depth_ImGui_DrawLineDistortedGfx(	logoGfx, vLogoPos, vLogoSize,
											cColor(2,2,2,fAlpha),
											1.0f-fTuningTotal, 1.0f);
		
		
		////////////////////////////////////////
		// Start audio loops silently
		if (ImGui_GetStateBool("SignalSoundPlaying",false) == false)
		{
			tString sSignalSoundName = "Entities_Station/tech/terminal_beeps/upsilon_commroom_terminal/frequency_scan_phase_";
			cLux_AddTodoMessage("START SOUNDS PLAYING");
			Sound_CreateAtEntity("sfx_staticloop_A",sSignalSoundName+"03","TerminalTuning",0.0f,true,0.0f);
			Sound_CreateAtEntity("sfx_staticloop_B",sSignalSoundName+"02","TerminalTuning",0.0f,true,0.0f);
			Sound_CreateAtEntity("sfx_staticloop_C",sSignalSoundName+"01","TerminalTuning",0.0f,true,0.0f);
			
			ImGui_SetStateBool("SignalSoundPlaying",true);
		}
		
		/////////////////////////////////
		// Audio feedback for signal strength (Update every 0.2 seconds since this issues a fade and dont want to do that every frame)
		float fCheckTime = ImGui_GetStateFloat("AudioCheckTime",0.0f) + afTimeStep;
		ImGui_SetStateFloat("AudioCheckTime",fCheckTime);
		
		if (fCheckTime > 0.2f)
		{
			/////////////////////////////
			// Calculate Signal Strength for Audio Feedback
			cVector2f vPos = cVector2f(fPosX,fPosY);
			cVector2f vSignalDist = vTarget - vPos;
			float fMag = cMath_Clamp(vSignalDist.Length(),0.0f,10.0f);
			float fSigStrength = (1.0f - fMag / 10.0f);
		
			float fSignalAVolume = ImGui_GetStateFloat("SignalAVolume",0.0f);
			float fSignalBVolume = ImGui_GetStateFloat("SignalBVolume",0.0f);
			float fSignalCVolume = ImGui_GetStateFloat("SignalCVolume",0.0f);
			
			float fMaxSignalVolume = 0.45f;	// SET THIS TO MAX VOLUME FOR ANY SIGNAL (If they're too loud!)
			
			if (fSigStrength < 0.35f)
			{
				fSignalAVolume = 0.25f; //0.25
				fSignalBVolume = 0.0f;
				fSignalCVolume = 0.0f;
			}
			else if (fSigStrength < 0.9f)
			{
				fSignalAVolume = 0.25f; //0.125
				fSignalBVolume = fSigStrength * fMaxSignalVolume;
				fSignalCVolume = 0.0f;
			}
			else
			{
				fSignalAVolume = 0.15f; //0.05
				fSignalBVolume = 0.25f; //0.0
				fSignalCVolume = fSigStrength * fMaxSignalVolume;
			}
			
			///////////////////////////////////////
			// Fade Times
			Sound_Fade("sfx_staticloop_A",fSignalAVolume,0.5f);
			Sound_Fade("sfx_staticloop_B",fSignalBVolume,1.0f);
			Sound_Fade("sfx_staticloop_C",fSignalCVolume,1.0f);
			
			ImGui_SetStateFloat("SignalAVolume",fSignalAVolume);
			ImGui_SetStateFloat("SignalBVolume",fSignalBVolume);
			ImGui_SetStateFloat("SignalCVolume",fSignalCVolume);
		}
		
		// Close enough?
		if (fTunedDelay >= 1)
		{
			float fSizeMul = ImGui_GetStateFloat("LogoSize", 1);
			float fLogoAlpha = ImGui_GetStateFloat("LogoAlpha", 1);
			float fFlashAlpha = ImGui_GetStateFloat("FlashAlpha", 1);
			
			cVector2f vSize = vLogoSize;
			float fRegularY = vSize.y;
			vSize = vSize*fSizeMul;
			
			cVector3f vPos = ImGui_NrmPos(0.5,0.1f,1.0f)-cVector3f_Right*vSize.x*0.5f;
			vPos = vPos - cVector3f_Up * ((vSize.y-fRegularY)*0.5);
			
			ImGui_SetModColorMul(cColor(1, fLogoAlpha));
			ImGui_DoImage(logoGfx, vPos, vSize);
			
			ImGui_SetModColorMul(cColor(1, fFlashAlpha));
			ImGui_DoImage(cImGuiGfx(""), cVector3f(0, 0, 5), ImGui_NrmSize(1));
			ImGui_SetModColorMul(cColor_White);
			
			bTuned = fLogoAlpha==0;
		}
		else if (fTunedAmount>=fTuningMax)
		{
			fTunedDelay = fTunedDelay+afTimeStep*0.5f;
			if (fTunedDelay >= 1)
			{
				Sound_CreateAtEntity("TuningSuccess", "Entities_Station/tech/terminal_beeps/upsilon_commroom_terminal/frequency_scan_connect_chime", ImGui_GetName(), 0.0f, false, 1.0f);
				//Sound_Stop("sfx_staticloop_A",0.25f);
				//Sound_Stop("sfx_staticloop_B",0.25f);
				//Sound_Stop("sfx_staticloop_C",0.25f);
				
				ImGui_SetStateFloat("LogoSize", 1);
				ImGui_FadeStateFloat("LogoSize", 1.5, 1, eEasing_QuadInOut, true);
				ImGui_SetStateFloat("LogoAlpha", 1);
				ImGui_FadeStateFloat("LogoAlpha", 0, 1, eEasing_QuadInOut, true);
				ImGui_SetStateFloat("FlashAlpha", 1);
				ImGui_FadeStateFloat("FlashAlpha", 0, 0.175, eEasing_QuadInOut, true);
			}
			ImGui_SetStateFloat("TunedDelay", fTunedDelay);
		}
		else
		{
			ImGui_SetStateFloat("TunedDelay", 0);
		}
			
		////////////////////
		// Action
		if (bTuned)
		{
			// Stop voices on log terminal
			Depth_ImGui_StopAudioFilePlayback("CommRoomLogTerminal");
			
			StopTerminalStatic();
			
			Terminal_SetUpdateWhenOutOfView("CommRoomMonitor", true);
			Terminal_SetImGuiStateInt("CommRoomMonitor","ContactState", 0);
			bool bOnline = ((contact == eCommRoomContact_Theta && !mbContactedTheta) ||
						   (contact == eCommRoomContact_Omicron && !mbContactedOmicron) ||
							contact == eCommRoomContact_Lambda);
			if (bOnline)
				ImGui_SetStateInt("CommTunerStationState"+lStation, 2);
			else
				ImGui_SetStateInt("CommTunerStationState"+lStation, 1);
				
			Terminal_SetImGuiStateBool("CommRoomMonitor", "Online", bOnline);
			StationGui_SetActiveApp("CommRoomMonitor",0);
			StationGui_SetActiveApp(1);
			ImGui_Exit();
		}
								
		if (StationGui_BackButton(fPosY<=0.0f||fPosY>=10.0f))
		{
			StopTerminalStatic();
			StationGui_SetActiveApp(-1);
		}
	}
	
	//-------------------------------------------------------
	
	void StopTerminalStatic()
	{
		cLux_AddTodoMessage("SOUND: STOP THE STATIC LOOPS HERE");
		Sound_Stop("sfx_staticloop_A",0.55f);
		Sound_Stop("sfx_staticloop_B",0.55f);
		Sound_Stop("sfx_staticloop_C",0.55f);
		ImGui_SetStateBool("SignalSoundPlaying",false);
	}
	
	
	//-------------------------------------------------------
	
	void GuiTuning_DoLinked()
	{
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		StationGui_BigStatusMessage_Old("CommTunerLinkEstablished");
		
		eCommRoomContact contact = eCommRoomContact(Terminal_GetImGuiStateInt("CommRoomMonitor", "StationIndex", -1));
		if (StationGui_BackButton(contact != eCommRoomContact_Lambda))
		{
			Voice_Stop("CommRoomContact");
			Sound_Stop("CommRoomStatic_NoSignal", 0.5);
			Sound_Stop("CommRoomStatic_Contact", 0.5);
			Sound_Stop("BadConnectionCommRoom", 0.25f);
			StationGui_SetActiveApp("CommRoomMonitor",-1);
			Terminal_SetImGuiStateInt("CommRoomMonitor", "ContactStatusInitialized", 0);
			
			if (Sound_Exists("Connecting_Theta")) Sound_Stop("Connecting_Theta", 0.25);
			if (Sound_Exists("Connecting_Delta")) Sound_Stop("Connecting_Delta", 0.25);
			if (Sound_Exists("Connecting_Omega")) Sound_Stop("Connecting_Omega", 0.25);
			if (Sound_Exists("Connecting_Omicron")) Sound_Stop("Connecting_Omicron", 0.25);
			if (Sound_Exists("Connecting_Tau")) Sound_Stop("Connecting_Tau", 0.25);
			if (Sound_Exists("Connecting_Lambda")) Sound_Stop("Connecting_Lambda", 0.25);
		}
	}
	
	//-------------------------------------------------------
	
	bool mbContactedTheta = false;
	bool mbContactedOmicron = false;
	
	//-------------------------------------------------------
	
	void OnGuiCommRoomTerminal(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("01_02_upsilon_inside");
		
		StationGuiBG_Scanlines();
		//StationGuiBG_Backdrop();
		
		if (StationGui_DrawAndCheckErrors())
			return;
		
		if (StationGui_GetActiveApp()==-1)
		{
			StationGui_BigStatusMessage_Old("CommStationNoLink");
		}
		else
		{
			OnGuiCommRoomTerminal_Contact(asEntityName, afTimeStep);
		}
	}
	
	//-------------------------------------------------------
	
	tString msCommRoomCharacter = "";
	
	void OnGuiCommRoomTerminal_Contact(const tString&in asEntityName, float afTimeStep)
	{
		eCommRoomContact contact = eCommRoomContact(ImGui_GetStateInt("StationIndex", -1));
		int lConnectState = ImGui_GetStateInt("ContactState", 0);
		bool bOnline = ImGui_GetStateBool("Online", false);
		
		cImGuiGfx imageGfx;
				
		///////////////////////////////////////
		// Contact cam window
		cImGuiWindowData data = StationGui_CreateDefaultWindowData();
		data.SetPadding(10.0f, 0.0f, 0.0f, 10.0f);

		ImGui_DoWindowStart("ContactID", data, ImGui_NrmPos(cVector3f(0.11f, 0.1f, 1.0f)), ImGui_NrmSize(cVector2f(0.4f, 0.62f)), true);
		{
			if (lConnectState != 0)
			{
				cVector2f vSize;
				cVector3f vPos=ImGui_NrmPosGroup(cVector3f(0.075f, 0.0f, 2.0f));
				
				cImGuiLabelData errorLabel;
				errorLabel.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
				errorLabel.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.075);
				errorLabel.mFontAlign = eFontAlign_Center;
				errorLabel.mColorBase = gStationGuiColor_Warning;
					
				if (contact == eCommRoomContact_Lambda && mbCatherineCommConnectionMade)
				{
					imageGfx.SetFile("station/comm/catherine");
					imageGfx.mColor = cColor(0.5f, 0.5f, 0.5f, 1.0f);
					vSize = ImGui_GetRatioCorrectSizeByNrmHeight(imageGfx, 0.9f);
				}
				else
				{					
					if (ImGui_RepeatTimer("StaticIndex", 0.1))
					{
						ImGui_SetStateInt("StaticImageIndex", cMath_RandRectl(0, 1));
						ImGui_SetStateInt("AnimationRotation", cMath_RandRectl(0, 1));
					}
					imageGfx.SetFile("static_"+ImGui_GetStateInt("StaticImageIndex", 0)+"");
					imageGfx.mColor = cColor(0.5f, 0.5f, 0.5f, 1.0f);
					vSize = ImGui_NrmSizeGroup(cVector2f(0.8, 0.9f));
					
					ImGui_SetModRotateAngle(ImGui_GetStateInt("AnimationRotation", 0)*180);
					
				}
				
				ImGui_GroupBegin(vPos, vSize);
				ImGui_DoImage(imageGfx, 0, ImGui_NrmSizeGroup(1));
				if (contact != eCommRoomContact_Lambda)
				{
					ImGui_ResizeFontToFit(ImGui_Translate("LinkError"), errorLabel.mFont, ImGui_GetCurrentGroupSize().x*0.9);
					ImGui_DoLabelExt("LinkError", errorLabel, ImGui_NrmPosGroup(cVector3f(0, 0.5, 1)), ImGui_NrmSizeGroup(cVector2f(1, -1)), 1);
				}
				ImGui_GroupEnd();
				ImGui_SetModRotateAngle(0);
			}
		}
		ImGui_DoWindowEnd();	
		
		///////////////////////////////////////
		// Com utility window
		data.SetPadding(10.0f,0,0,40.0f);
		ImGui_DoWindowStart("ComUtility", data, ImGui_NrmPos(cVector3f(0.53f, 0.1f, 1.0f)), ImGui_NrmSize(cVector2f(0.36f, 0.7f)), true);
		{
			cImGuiLabelData labelData;
			labelData.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
			labelData.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.1);
			
			if (lConnectState==0)
			{
				labelData.mFontAlign = eFontAlign_Left;
				cVector2f fFontSize = labelData.mFont.mvSize;
				ImGui_ResizeFontToFit(ImGui_Translate("EstablishingConnection"), labelData.mFont, ImGui_GetCurrentGroupSize().x*0.9);
				ImGui_DoLabelExt("EstablishingConnection", labelData, ImGui_NrmPosGroup(cVector3f(0, 0.1, 3)), ImGui_NrmSizeGroup(cVector2f(1.1, -1)));
				labelData.mFont.mvSize = fFontSize;
				cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
				
				if (Depth_ImGui_LoadingInProgress("ContactStatus")==false)
				{
					Sound_Stop("BadConnectionCommRoom", 1.0f);
					
					if (contact == eCommRoomContact_Theta)
					{
						Sound_CreateAtEntity("Connecting_Theta", "01_02_upsilon_inside_02/sfx/comm_room_terminal/theta_radar_connect", "CommRoomMonitor");
						cLux_AddDebugMessage("contacting theta");
					}
					if (contact == eCommRoomContact_Delta)
					{
						Sound_CreateAtEntity("Connecting_Delta", "01_02_upsilon_inside_02/sfx/comm_room_terminal/delta_radar_connect", "CommRoomMonitor");
						cLux_AddTodoMessage("contacting Delta");
					}
					if (contact == eCommRoomContact_Omega)
					{
						Sound_CreateAtEntity("Connecting_Omega", "01_02_upsilon_inside_02/sfx/comm_room_terminal/omega_radar_connect", "CommRoomMonitor");
						cLux_AddTodoMessage("contacting Omega");
					}
					if (contact == eCommRoomContact_Omicron)
					{
						Sound_CreateAtEntity("Connecting_Omicron", "01_02_upsilon_inside_02/sfx/comm_room_terminal/omicron_radar_connect", "CommRoomMonitor");
						cLux_AddTodoMessage("contacting Omicron");
					}
					if (contact == eCommRoomContact_Phi)
					{
						Sound_CreateAtEntity("Connecting_Omicron", "01_02_upsilon_inside_02/sfx/comm_room_terminal/omicron_radar_connect", "CommRoomMonitor");
						cLux_AddTodoMessage("contacting Phi");
					}
					if (contact == eCommRoomContact_Tau)
					{
						Sound_CreateAtEntity("Connecting_Tau", "01_02_upsilon_inside_02/sfx/comm_room_terminal/tau_radar_connect", "CommRoomMonitor");
						cLux_AddTodoMessage("contacting Tau");
					}
					if (contact == eCommRoomContact_Lambda)
					{
						Sound_CreateAtEntity("Connecting_Lambda", "01_02_upsilon_inside_02/sfx/comm_room_terminal/lambda_radar_connect", "CommRoomMonitor");
						cLux_AddTodoMessage("contacting Lambda");
						StartCommRoomConversation();
					}
				}
				
				float fLoadTime = contact == eCommRoomContact_Lambda ? 2.5 : 5;
				if (Depth_ImGui_LoadingGauge("ContactStatus", fLoadTime, true, ImGui_NrmPosGroup(cVector3f(0, 0.225, 3)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.05)), gauge))
				{
					Terminal_SetUpdateWhenOutOfView(ImGui_GetName(), false);
					ImGui_SetStateInt("ContactState", 1);
										
					if (contact == eCommRoomContact_Theta && !mbContactedTheta)
					{
						mbContactedTheta = true;
						Sound_CreateAtEntity("ConnectionConfirmed", "Entities_Station/tech/terminal_beeps/upsilon_commroom_terminal/frequency_comp_good_signal_chime_01", "CommRoomMonitor");
						Voice_Play("CommRoomSite_Theta", -1, "VoiceEndOfAltStationCall");
						msCommRoomCharacter = "Strasky";
					}
					else if (contact == eCommRoomContact_Omicron && !mbContactedOmicron)
					{
						Sound_CreateAtEntity("ConnectionConfirmed", "Entities_Station/tech/terminal_beeps/upsilon_commroom_terminal/frequency_comp_good_signal_chime_01", "CommRoomMonitor");
						mbContactedOmicron = true;
						Voice_Play("CommRoomSite_Omicron", -1, "VoiceEndOfAltStationCall");
						msCommRoomCharacter = "Ross";
					}
					else if (contact == eCommRoomContact_Lambda)
					{
						msCommRoomCharacter = "Catherine";
						SequenceCommRoomDialog("");
						Sound_CreateAtEntity("ConnectionConfirmed", "Entities_Station/tech/terminal_beeps/upsilon_commroom_terminal/frequency_comp_good_signal_chime_01", "CommRoomMonitor");
					}
					
					else
					{
						Sound_CreateAtEntity("BadConnectionCommRoom", "Entities_Station/tech/terminal_beeps/upsilon_commroom_terminal/frequency_comp_error_loop", "CommRoomMonitor");
					}
					
					//Sound_CreateAtEntity("CommRoomStatic_NoSignal", "01_02_upsilon_inside/VIPScriptedEvents/radio/signal_bad", 
					//					 "CommRoomMonitor", 0.5, true, bOnline ? 0 : 1);
					//Sound_CreateAtEntity("CommRoomStatic_Contact", "01_02_upsilon_inside/VIPScriptedEvents/radio/signal_clean", 
					//					 "CommRoomMonitor", 0.5, true, bOnline ? 1 : 0);
										 
					cLux_AddTodoMessage("Sound: Stop connection loop.");
					cLux_AddTodoMessage("Sound: Connection established!");
				}
				
			}
			else
				OnGuiCommRoomTerminal_SignalBars();
			
			labelData.mFontAlign = eFontAlign_Center;
			ImGui_ResizeFontToFit(ImGui_Translate("CommContact_"+contact), labelData.mFont, ImGui_GetCurrentGroupSize().x*0.9);
			ImGui_DoLabelExt("CommContact_"+contact, labelData, ImGui_NrmPosGroup(cVector3f(-0.1, 0.51f, 3)), ImGui_NrmSizeGroup(cVector2f(1.1, -1)));
			
			////////////////////////////////////
			//Status button
			tString sStatus = "";
			cImGuiButtonData buttonData = StationGui_CreateDefaultButtonData();
			buttonData.mbClipText = false;
			buttonData.mbUseInFocusColor = false;
			buttonData.mGfxFrame.mGfxCornerBottomRight.SetFile("stationV2/button/small_corner_bottomright");
			
			if (lConnectState == 0)
			{
				buttonData.mColorBase = gStationGuiColor_Disabled;
				buttonData.mColorTriggered = gStationGuiColor_Disabled;
			}
			else if (!bOnline)
			{
				buttonData.mColorBase = gStationGuiColor_Warning;
				buttonData.mColorTriggered = gStationGuiColor_Warning;
				sStatus = "Offline";
			}
			else
			{
				buttonData.mColorBase = gStationGuiColor_Highlight;
				buttonData.mColorTriggered = gStationGuiColor_Highlight;
				sStatus = "Online";
			}
			
			ImGui_SetModUseUIPos(false);
			ImGui_ResizeFontToFit(ImGui_Translate(sStatus), buttonData.mFont, ImGui_GetSize().x*0.225);
			ImGui_DoButtonExt("OnlineButton", sStatus, buttonData, ImGui_NrmPos(cVector3f(0.02f, 0.51f, 3)), ImGui_NrmSize(cVector2f(0.25f, 0.08f)));
			ImGui_SetModUseUIPos(true);
		}
		ImGui_DoWindowEnd();
	}
	
	//-------------------------------------------------------
	
	void OnGuiCommRoomTerminal_SignalBars()
	{
		cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
		gauge.mOrientation = eImGuiGaugeOrientation_Vert;
		
		array<float> vSignals;
		
		bool isOnline = ImGui_GetStateBool("Online", false);
		if (isOnline)
		{
			gauge.mColorBase = gStationGuiColor_Highlight;
			
			array<float> vSpectrum;
			if (msCommRoomCharacter!="")
				cLux_GetVoiceHandler().GetSpectrumFromSpeakingCharacter(msCommRoomCharacter, vSpectrum);
			
			for (int i=0;i<8;++i)
			{
				int iSpectrum = i;
				vSignals.push_back(Depth_ImGui_GetOscillatingSignalValue("COMWindow", i, eEasing_Linear, 0.05, 0.1));
				if(vSpectrum.length()>(iSpectrum+1))
					vSignals[i]+=vSpectrum[iSpectrum]*1.5f;
			}
		}
		else
		{
			gauge.mColorBase = gStationGuiColor_Warning;

			for (int i=0;i<8;++i)
			{
				vSignals.push_back(Depth_ImGui_GetOscillatingSignalValue("COMWindow", i, eEasing_Linear, 0.1f, 0.4f));
			}
		}
		
		ImGui_LayoutBegin(eImGuiLayout_X, cVector3f(33, 10, 2), ImGui_GetCurrentGroupSize()-cVector2f(80,0), cVector2f(4.0f,0));
		{
			cVector2f vBarSize(25,140);
			
			for (int i = 0; i < 8; i++)
			{
				float fValue = vSignals[i]; 
				ImGui_DoGauge(gauge, fValue, cVector3f_Zero, vBarSize);
			}
		}
		ImGui_LayoutEnd();
	}
	
	//-------------------------------------------------------
	
	void VoiceEndOfAltStationCall(const tString&in asScene, const tString&in asSubject)
	{
		Sound_Fade("CommRoomStatic_NoSignal", 1, 3);
		Sound_Fade("CommRoomStatic_Contact", 0, 3);
		Terminal_SetImGuiStateInt("CommRoomMonitor", "Online", 0);
	}

	//-------------------------------------------------------
	
	void StartCommRoomConversation()
	{
		Map_AddTimer("CommRoomConvo_ActiveCheck", 20, "Timer_CommRoomConvoEndFailsafe");
	
        Sound_PreloadGroup("01_02_upsilon_inside_02/special/collapse_sequence", true);
		Player_ChangeStateToNormal();
		SwitchToStuckLever();
		Voice_SetSource("Catherine", "CommRoomMonitor", 2, 30, true, 30);
		Voice_SetSource("Radio", "CommRoomMonitor", 2, 30, true, 30);
		
		Dialog_StartConversation("Catherine", "CommRoomMonitor", 1.5f);
		Dialog_Begin("CommRoom");
			Dialog_AddBranch("CommRoom");
				Dialog_AddPause(4.25f,"SubjectResumeCommRoomSequence");
				Dialog_AddSubject("CommRoomSimonCall");
				Dialog_AddPause(2.0f,"SubjectCommRoomSimonsCall");
				Dialog_AddSubject("CommRoomDialog_1", "");
				
				if (!mbHeardCarl || (mbReactorControlFlowPulled && !mbPlayerSawDeadCarl) )
					Dialog_AddSubject("CommRoomDialog_2_NoCarlMeeting", "SubjectResumeCommRoomSequence");
				else if (mbCarlDrained)
					Dialog_AddSubject("CommRoomDialog_2_SuckedCarlPower", "SubjectResumeCommRoomSequence");
				else if (mbReactorControlFlowPulled)
					Dialog_AddSubject("CommRoomDialog_2_FlowControl", "SubjectResumeCommRoomSequence");
				else
					Dialog_AddSubject("CommRoomDialog_2_TorturedCarl", "SubjectResumeCommRoomSequence");
		Dialog_End();
	}

	//-------------------------------------------------------
	
	void Timer_CommRoomConvoEndFailsafe(const tString &in asTimer)
	{
		if (asTimer == "CommRoomConvo_ActiveCheck")
		{
			if (Voice_SceneIsActive("CommRoomContact"))
			{
				Map_AddTimer("CommRoomConvo_ActiveCheck", 1, "Timer_CommRoomConvoEndFailsafe");
			}
			else
			{
				cLux_AddDebugMessage("Timer_CommRoomConvoEndFailsafe Scene NOT active. Resuming in 4 seconds.");
				Map_AddTimer("CommRoomConvo_ActivateFailsafe", 4, "Timer_CommRoomConvoEndFailsafe");
			}
		}
		else
		{
			if (Voice_SceneIsActive("CommRoomContact"))
			{
				cLux_AddDebugMessage("CommRoomContact active again, resetting failsafe check.");
				Map_AddTimer("CommRoomConvo_ActiveCheck", 0.1, "Timer_CommRoomConvoEndFailsafe");
			}
			else
			{
				cLux_AddDebugMessage("Timer_CommRoomConvoEndFailsafe Failsafe activated!");
				SubjectResumeCommRoomSequence("", false);
			}
		}
	}

	//-------------------------------------------------------
	
	cSequenceStatesData mCommRoomDialogSequence;
	bool mbCatherineCommConnectionMade = false;
	
	void SequenceCommRoomDialog(const tString &in asTimer)
	{
		Sequence_Begin("SequenceCommRoomDialog", mCommRoomDialogSequence);
		
		////////////////////////////////////////////////
		// Screen turned on, dialog begins
		if (Sequence_DoStepAndWait(0.5))
		{	
			PreloadSetPrioNormal();
			
			//Stop music
			mbAmbientMusicAllowed = false;
			Map_AddTimer("StopAmbientMusic", 2.0f, "AmbientMusicHandler");
			
			Sound_Fade("big_leak_1", 0.45f, 3.0f);
			Sound_Fade("water_leak_1", 0.45f, 3.0f);
			Sound_Fade("radar_machine_1", 0.45f, 3.0f);
			Sound_Fade("leak1", 0.45f, 3.0f);
			
			Sound_CreateAtEntity("CathConversationBG", "Flashback/Level/01_02/CommRoomDialog", "CommRoomMonitor");
			Map_RemoveTimer("SmallRumbleTimer");
			Sound_Stop("Tremors", 5.0f);
			
			EnergySource_SetEnergy("CommRoomWauFlower", 0);
		}
		else if (Sequence_DoStepAndPause(0.0f))
		{
			Audio_PauseQuakes(true);
		}
		else if (Sequence_DoStepAndPause(0))
		{
		}
		else if (Sequence_DoStepAndPause(0))
		{
			mbCatherineCommConnectionMade = true;
		}
		
		////////////////////////////////////////////////
		// Start flooding
		else if(Sequence_DoStepAndWait(1.0f))
		{
			cLux_AddDebugMessage("Aborting failsafe check.");
			Map_RemoveTimer("CommRoomConvo_ActivateFailsafe");
			Map_RemoveTimer("CommRoomConvo_ActiveCheck");
			
			Player_SetMoveSpeedMul(1.0f);
			
			Lamp_SetFlickerActive("CommRoomLamp_ScreenLeft", true);
			Lamp_SetFlickerActive("CommRoomLamp_ScreenRight", true);
			Entity_SetInteractionDisabled("CommRoomLamp_ScreenLeft", true);
			Entity_SetInteractionDisabled("CommRoomLamp_ScreenRight", true);
			
			Map_AddTimer("CommRoomLamp_ScreenLeft", 2.f, "TimerTurnOffLamp");
			Map_AddTimer("CommRoomLamp_ScreenRight", 4.f, "TimerDeactivateLampFlicker");
			Terminal_SetGuiActive("CommRoomLogTerminal",false);
			Entity_SetInteractionDisabled("CommRoomLogTerminal",true);
			
			SwitchToBrokenLever();
			
			//Disable crouch during flood due to gfx issues
			Player_SetCrouchDisabled(true);
			
			Music_Stop(6.0f, eMusicPrio_BgAmb);
			Sound_CreateAtEntity("CollapseInitial", "01_02_upsilon_inside_02/special/collapse_sequence/collapse_initial_hit", "Player");
			cLux_AddDebugMessage("Tremor first hit playing");
			
			Effect_Rumble_Start(0.75, 1, 0.2, 0.5);
			
			Sound_Fade("big_leak_1", 0.25f, 3.0f);
			Sound_Fade("water_leak_1", 0.25f, 3.0f);
			Sound_Fade("radar_machine_1", 0.25f, 3.0f);
			Sound_Fade("leak1", 0.25f, 3.0f);
		}
		else if (Sequence_DoStepAndWait(2.2f))
		{
			Dialog_Begin("CommRoom");
				Dialog_AddBranch("CommRoom");
					// "What was that?"
					Dialog_AddSubject("CommRoomDialog_3", "SubjectResumeCommRoomSequence");
			Dialog_End();
		}
		else if (Sequence_DoStepAndPause(0))
		{
			//////////////////////////////////////////////////
			//Setpiece audio
			
			////////////////////////
			//Play Tremors
			Map_AddTimer("AlarmTimer", 1.5f, "BeginCollapseAlarmFinale");
			
			Sound_CreateAtEntity("FirstTremorDebris","01_02_upsilon_inside_02/special/collapse_sequence/collapse_impact_01_debris","Player",0.0f,false);
			Sound_CreateAtEntity("FirstTremorMoan","01_02_upsilon_inside_02/special/collapse_sequence/collapse_impact_01_moan","Player",0.0f,false);
			Sound_CreateAtEntity("FirstTremorShake","01_02_upsilon_inside_02/special/collapse_sequence/collapse_impact_01_shake","Player",0.0f,false);
			cLux_AddDebugMessage("Tremor 1 playing");
			
			//////////////////////
			//Stop any remaining music
			Music_Stop(0.9f, eMusicPrio_BgAmb);
			
			///////////////////////
			//Fade and filter world audio
			Sound_FadeGlobalVolume(0.25f, 0.5f, eSoundEntryType_WorldAll);
			//cSound_FadeHighPassFilter(350.0f, 0.0f, 0.5f, eSoundEntryType_WorldAll);
			Sound_Fade("Collapse_Alarm", 0.5f, 0.5f);
			
			cLux_AddDebugMessage("STEP1");
			Map_AddTimer("FirstConstructSlams", 4.5, "Seq_FirstConstructSlams");
			Map_AddTimer("SecondConstructSlams", 9, "Seq_SecondConstructSlams");
						
			Map_RemoveTimer("CommRoomLamp_*");
			Lamp_SetupFlicker("CommRoomLamp_*", 0.05f, 2.f, 0.05f, 0.2f);
			Lamp_SetFlickerActive("CommRoomLamp_*", true);
			
			Effect_Shake_Start(0.02f, 0.25f, 0.3f, 2.0f);
			Effect_Rumble_Start(0.5, 3.05, 0.3, 2.5);
		}		
		else if (Sequence_DoStepAndWait(0.5))
		{
			cLux_AddDebugMessage("STEP2");
			
			////////////////////////////////////////////////
			// "Oh shit!"
			Dialog_Begin("CommRoom");
				Dialog_AddBranch("CommRoom");
					Dialog_AddSubject("CommRoomDialog_4", "");
			Dialog_End();
		}
		else if (Sequence_DoStepAndPause(0))
		{
			Sound_Stop("CathConversationBG", 0.15f);
			cLux_AddDebugMessage("STEP3");
			cLux_AddDebugMessage("SOUND: Ceiling moaning", false);

			if (mlMildShakeID >= 0)
				Effect_Shake_FadeOut(mlMildShakeID, 0);
			
			Lamp_SetupFlicker("CommRoomLamp_*", 0.05f, 1.f, 0.025f, 0.15f);
			Map_AddTimer("CommRoomLamp_*", 6.f, "TimerDeactivateLampFlicker");
			
			Map_RemoveTimer("TimerCommRoomConstructAttacks");
			Map_RemoveTimer("TimerCommRoomConstructAttackHit");
			
		}
		else if (Sequence_DoStepAndPause(0))
		{
			cLux_AddDebugMessage("Pause for Simon final line");
		}
		////////////////////////////////////////////////
		// Conversation cut off
		else if (Sequence_DoStepAndWait(.5f))
		{
			cLux_AddDebugMessage("STEP4");
			Sound_Stop("CommRoomStatic_Contact", 0.5f);
			Sound_Stop("CommRoomStatic_NoSignal", 0.5f);
			Terminal_SetGuiActive("CommRoomMonitor", false, 0.25);
			Light_FadeTo("CommRoomTerminalLight", cColor(0,1), -1, 0.2f);
			Sound_Fade("Collapse_Alarm", 0.25f, 3.0f);
		}
		else
		{
			SequenceFloodCommRoom("");
		}
		
		Sequence_End();
	}
	
