		if(alState==1)
		{
			Sound_FadeGlobalVolume(0.7f, 3.0f, eSoundEntryType_WorldAll);
			//cSound_FadeHighPassFilter(250.0f, 0.0f, 3.0f, eSoundEntryType_WorldAll);
			cLux_AddDebugMessage("Hall Robot - Proximity ducking active");
		}
		else
		{
			Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_WorldAll);
			//cSound_FadeHighPassFilter(0.0f, 0.0f, 3.0f, eSoundEntryType_WorldAll);
			cLux_AddDebugMessage("Hall Robot - Proximity ducking disabled");
		}
		return true;
	}
	
	////////////////////////////////////////
	// Hub Construct Mixer
	bool Trigger_ConstructHubAreaMixer(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Sound_FadeGlobalVolume(0.7f, 3.0f, eSoundEntryType_WorldAll);
			//cSound_FadeHighPassFilter(250.0f, 0.0f, 3.0f, eSoundEntryType_WorldAll);
			cLux_AddDebugMessage("Hub Robot - Proximity ducking active");
		}
		else
		{
			Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_WorldAll);
			//cSound_FadeHighPassFilter(0.0f, 0.0f, 3.0f, eSoundEntryType_WorldAll);
			cLux_AddDebugMessage("Hub Robot - Proximity ducking disabled");
		}
		return true;
	}
	
	////////////////////////////////////////
	// Reactor Room Music
	bool CollideGeneratorRoomMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		 if (alState != 1) return true;

		 Music_PlayExt("01_02_enterreactorroom", false, 0.65, 1, 0, 0, eMusicPrio_MinorEvent, false);
		 Sound_FadeGlobalVolume(0.625, 2.0f);
		 Map_AddTimer("ReactorRoomFadeUp", 3.0f, "ReactorRoomFadeUp");
		 Sound_PreloadGroup("01_02_upsilon_inside_02/sfx", true);
		 Sound_CreateAtEntity("EnterGeneratorSweetener", "01_02_upsilon_inside_02/amb/sweet/generator_room_enter_sweet", "Player", 0.0f, false, 1.0f);
         StopVentTremor();
		 return false;
	}
	
	void ReactorRoomFadeUp(const tString &in asTimer)
	{
		 Sound_FadeGlobalVolume(1.0f, 7.0f);
	}
	
	bool Trigger_EnableTransformerConstructLookAt(const tString &in asParent, const tString &in asChild, int alState)
	{
		cLux_AddDebugMessage("Construct lookat area off");
		Entity_SetActive("Trigger_TransformerConstructMusic", false);
		if (alState==1)
		{
			cLux_AddDebugMessage("Construct lookat area on");
			Entity_SetActive("Trigger_TransformerConstructMusic", true);
		}
		return true;
	}
		
	//-------------------------------------------------------
	bool mbFanProximity = false;
	bool OnTriggerFanProximity(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			mbFanProximity = true;
		}
		else 
		{
			mbFanProximity = false;
		}
		cLux_AddDebugMessage("Player is fan area bool is "+mbFanProximity);
		return true;
	}
	
	bool Trigger_AudioControlRoomDoorOpen(const tString &in asParent, const tString &in asChild, int alState)
	{
		
		if (alState==1 && mbFanProximity==false)
		{
			cLux_AddDebugMessage("Fan Sound Off");
			Sound_Stop("turbine_exhaust", 1.0f);
			Sound_Stop("volcanic_pit_spot", 1.0f);
		}
		else if(mbFanProximity==false && mbThermalVentActive == true)
		{
			cLux_AddDebugMessage("Fan Sound On");
			Sound_Play("turbine_exhaust", 1.0f);
			Sound_Play("volcanic_pit_spot", 1.0f);
		}
		return true;
	}
	
	//-------------------------------------------------------
	//Thermal Machinery sounds
	bool mbIsReactorDoorOpen = false;
	
	bool Trigger_StartThermalSound(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState==1 && mbIsReactorDoorOpen==true && mbThermalReactorActive==true)
		{
			Sound_CreateAtEntity("ThermalMachinery_Close", "01_02_upsilon_inside_02/amb/spot/thermal_machinery/close", "ThermalMachinerySoundSource", 0.25f, true, 1.0f);
			Sound_CreateAtEntity("ThermalMachinery_Corridor", "01_02_upsilon_inside_02/amb/spot/thermal_machinery/corridor", "ThermalMachinerySoundSource", 0.5f, true, 0.0f);
			cLux_AddDebugMessage("Trigger - Turning on close spot");
		}
		if (alState==1 && mbIsReactorDoorOpen==false && mbThermalReactorActive==true)
		{
			Sound_CreateAtEntity("ThermalMachinery_Corridor", "01_02_upsilon_inside_02/amb/spot/thermal_machinery/corridor", "ThermalMachinerySoundSource", 0.5f, true, 1.0f);
			Sound_CreateAtEntity("ThermalMachinery_Close", "01_02_upsilon_inside_02/amb/spot/thermal_machinery/close", "ThermalMachinerySoundSource", 0.25f, true, 0.0f);
			cLux_AddDebugMessage("Trigger - Turning on corridor spot");
		}
		return false;
	}
	
	
	bool ReactorDoorState(const tString &in asParent, const tString &in asChild, int alState)
	{
		bool bPlayerInsideThermalReactorRoom = Entity_GetCollide("Player","ThermalReactor") ? true : false;
		
		if (alState == 1 && mbThermalReactorActive==true) // door is closing, body has entered the area
		{
			mbIsReactorDoorOpen = false;
			cLux_AddDebugMessage("Reactor Door Closed and Inside Thermal Room = " + bPlayerInsideThermalReactorRoom);

			if (bPlayerInsideThermalReactorRoom==false)
			{
				Sound_Fade("ThermalMachinery_Close", 0.0f, 0.25f);
				Sound_Fade("ThermalMachinery_Corridor", 1.0f, 0.5f);
				cLux_AddDebugMessage("Turning down Close Sound + Turning on corridor spot");
			} 
		}

		if (alState == -1 && mbThermalReactorActive==true) // door is opening, body has left
		{
			mbIsReactorDoorOpen = true;
			cLux_AddDebugMessage("Reactor Door Open and Inside Thermal Room = " + bPlayerInsideThermalReactorRoom);
			
			if (bPlayerInsideThermalReactorRoom==false)
			{
				Sound_Fade("ThermalMachinery_Corridor", 0.0f, 0.5f);
				Sound_Fade("ThermalMachinery_Close", 1.0f, 0.25f);
				cLux_AddDebugMessage("Turning up Close Sound + Turning off corridor spot");
			} 
		}
		return true;
	}
	
	//---------------------------------------
	//Pause quakes for conversations
	
	void Audio_PauseQuakes(bool asPause)
	{
		if (asPause==true)
		{
			cLux_AddDebugMessage("Quake Timers Paused");
			Map_SetTimerPaused("SmallRumbleTimer", true);
		}
		else if (asPause==false)
		{
			cLux_AddDebugMessage("Quake Timers Resume");
			Map_SetTimerPaused("SmallRumbleTimer", false);
		}
	}
	
	//////////////////////////////////////
	//Carl Construct
	
	bool mbCarlSightedMusic = false;
	
	bool Trigger_CarlAudioMixer(const tString &in asParent, const tString &in asChild, int alState)
	{
		//A trigger area that ducks World audio when you approach Carl, and resets when you leave area
		if(alState==1)
		{
			cLux_AddDebugMessage("Carl Mixer - Ducking");
			Map_AddTimer("StopAmbientMusic", 1.0f, "AmbientMusicHandler");
			Audio_PauseQuakes(true);
			
			if (mbCarlSightedMusic==false)
			{
				Music_Play("01_01_afterflashback", 0.45f, false, eMusicPrio_MinorEvent);
				mbCarlSightedMusic = true;
			}
		}
		
		else
		{
			cLux_AddDebugMessage("Carl Mixer - Return to Normal");
			Sound_FadeGlobalVolume(1.0f, 3.0f);
			Map_AddTimer("StartAmbient", cMath_RandRectf(3.f, 5.f), "AmbientMusicHandler");
			Audio_PauseQuakes(false);
		}
		return true;
	}
	
	//---------------------------------------

	void PlayEnterCommRoomMusic(const tString &in asTimer)
	{
		cLux_AddDebugMessage("PlayEnterCommRoomMusic");
		Music_Play("01_02_entercommroom", 0.45f, false, eMusicPrio_BigEvent);
		
		//Start exploration ambience
		mbAmbientMusicAllowed = true;
		mbAmbientMusicSecondStage = true;
		Map_AddTimer("StartAmbient", cMath_RandRectf(10.f, 15.f), "AmbientMusicHandler");
	}
	
	/////////////////////////////////
	//Construct second encounter start sweetener
	bool ConstructEncounterSweetener(const tString &in asParent, const tString &in asChild, int alState)
	{
		Sound_CreateAtEntity("ConstructSweetStart", "01_02_upsilon_inside_02/sfx/construct_encounter/upstairs/start", "ConstructEncounterSweetener_SoundSource");
		Map_AddTimer("ConstructSweetenerLoop", 4.0f, "ConstructSweetenerLoop");
		Entity_SetActive("ConstructEncounterSweetner_End", true);
		Entity_SetActive("ConstructEncounterSweetner_End_1", true);
		return false;
	}
	
	void ConstructSweetenerFear(const tString &in asTimer)
	{
		Depth_Audio_Fear_LowIntensity(8.0f, 10.0f, 1, true, false);
	}
	
	void ConstructSweetenerLoop(const tString &in asTimer)
	{
		Sound_CreateAtEntity("ConstructSweetLoop", "01_02_upsilon_inside_02/sfx/construct_encounter/upstairs/loop", "ConstructEncounterSweetener_SoundSource");
	}
	
	bool ConstructEncounterSweetenerStop(const tString &in asParent, const tString &in asChild, int alState)
	{
		Map_RemoveTimer("ConstructSweetenerLoop");
		Sound_Stop("ConstructSweetStart", 0.25f);
		Sound_Stop("ConstructSweetLoop", 0.25f);
		Map_AddTimer("ConstructSweetenerFear", 1.0f, "ConstructSweetenerFear");
		Sound_CreateAtEntity("ConstructSweetEnd", "01_02_upsilon_inside_02/sfx/construct_encounter/upstairs/end", "ConstructEncounterSweetener_SoundSource");
		return false;
	}
		
