		//Ornaments
		cImGuiGfx ornamentImageGfx("station/chinsymbol/small_default_tools");
		ornamentImageGfx.mColor = gStationGuiColor_Normal2;
		ImGui_DoImage(ornamentImageGfx, ImGui_NrmPos(cVector3f(0.9f,  0.65f, -1.0f)));
	}

