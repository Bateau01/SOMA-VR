		void LineOver_TriggerCollapseAlarm(const tString &in asParent, const tString &in asChild, int alState, bool abStart)
		{
			if (abStart)
				return;
				

		}
		
		void LineStart_BeginConversation(const tString &in asParent, const tString &in asChild, int alState, bool abStart)
		{
			if(abStart)
			{
				Sound_FadeGlobalVolume(0.55f, 5.0f, eSoundEntryType_World);
			}
		}
		
		void BeginCollapseAlarmFinale(const tString &in asTimer)
		{
			/////////////////////////////////
			///Setpiece audio - Begin Alarm
			Sound_CreateAtEntity("Collapse_Alarm", "01_02_upsilon_inside_02/special/collapse_sequence/alarm", "Player", 0.0f, false, 1.0f);
		}
			
				
