	//-------------------------------------------------------
	
	void OnChangeMachineRoomLever(const tString &in asEntity, int alState)
	{			
		if (alState == 0) return;
		
		Lever_SetAutoMoveTarget(asEntity, alState);
		
		if (mbReactorControlFlowPulled)
			return;
		
		if (alState == 1)
		{
			if (!mbAssemblyActive) return;
			Seq_AssemblyRoomPowerReroute("");
		}
		else
		{
			if (mbAssemblyActive) return;
			Seq_AssemblyRoomPowerReturns("");
		}
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mAssemblyRoomPowerRerouteSequence;
	int mlAssemblyRoomShake;
		
	void Seq_AssemblyRoomPowerReroute(const tString &in asTimer)
	{
		Sequence_Begin("Seq_AssemblyRoomPowerReroute", mAssemblyRoomPowerRerouteSequence);
			
		if (Sequence_DoStepAndWait(2.575))
		{	
			SequenceStates_Stop("Seq_AssemblyRoomPowerReturns");
			mAssemblyRoomPowerReturnsSequence.mlStateCounter = 0;
		
			Lamp_SetLit("MachineRoomLamp_Desk", false, true);
			Lamp_SetLit("MachineRoomLamp_Ceiling_4", false, true);
			Lamp_SetLit("MachineRoomLamp_Ceiling_5", false, true);
			Lamp_SetLit("MachineRoomLamp_Ceiling_8", false, true);
			Lamp_SetLit("MachineRoomLamp_Ceiling_6", false, true);
			Lamp_SetLit("MachineRoomLamp_Ceiling_7", false, true);
			Lamp_SetLit("AssemblyLeverLamp", false, true);
			Lamp_SetFlickerActive("power_calbe_lamp_*", false);
			Entity_FadeEffectBaseColor("power_calbe_lamp_*", cColor(2), 0.5);
			Entity_FadeEffectBaseColor("carl_burn_effects", cColor(1), 8);
			
			ParticleSystem_SetVisible("ParticleSystem_13", false);
			ParticleSystem_SetVisible("ParticleSystem_57", false);
			
			mlAssemblyRoomShake = Effect_Shake_Start(0.01f,100000.0f,0.1f,0.5f);
			Effect_Shake_SetSourceEntity(mlAssemblyRoomShake, "CarlConstruct", 0.5f, 7.0f, eEasing_Linear);
			Lamp_SetFlickerActive("FloorLight_*",true);
			
			Sound_CreateAtEntity("TortureStartup", "01_02_upsilon_inside_02/sfx/carl_torture_event/electricity_startup", "TortureSoundSource");
			Sound_FadeGlobalVolume(0.05f, 1.0f);
			Entity_PlayAnimation("ControlFlowLever_2_fan", "switchoff", 1.0f, false, false);
			Sound_Stop("carl_lever_fan", 2.0f);
			Entity_SetEffectsActive("ControlFlowLever_2", false, false);
			Lamp_SetLit("ControlFlowLever_2_lamp_*", true, true);
			RobotArmDeactivation();
		}
		else if (Sequence_DoStepAndWait(0.425))
		{
			Lamp_SetLit("MachineRoomLamp_Ceiling_4", true, false);
			Lamp_SetFlickerActive("MachineRoomLamp_Ceiling_3", true);
			Lamp_SetFlickerActive("MachineRoomLamp_Ceiling_4", true);
		}
		else if (Sequence_DoStepAndWait(1))
		{
			if (!mbCarlDead)
			{
				StartCarlTorture();
				Voice_Stop("CarlConstruct");
				StartCarlSpeakTimer();
			}
			
			//Audio
			Sound_CreateAtEntity("LeverActivate", "level_amb_shared_props/lever_clunk/activate", "ControlFlowLever_2");
			Sound_CreateAtEntity("CarlTortureStart","01_02_upsilon_inside_02/sfx/carl_torture_event/electricity_start", "TortureSoundSource");
			Sound_CreateAtEntity("CarlTortureLoop","01_02_upsilon_inside_02/sfx/carl_torture_event/electricity_loop", "TortureSoundSource");
			Sound_Stop("CarlTortureCooldownLoop", 0.1f);
			Map_AddTimer("CarlTortureCooldownEnable", 3.5f, "EnableCarlCooldownBool");
			Map_AddTimer("CarlTortureMusic", 1.5f, "PlayCarlTortureMusic");
			Map_RemoveTimer("CarlTortureCoolDownLoopStop");
			Map_AddTimer("StopAmbientMusicQuickly", 1.0f, "AmbientMusicHandler");
			mbAmbientMusicAllowed = false;
			
			Sound_FadeGlobalVolume(1.0f, 2.0f);
			Entity_SetActive("TriggerCarlCanHearPlayer", false);
			Entity_SetActive("TriggerCarlCanSeePlayer", false);
			Entity_SetInteractionDisabled("CarlConstruct_Talk", true);
			ParticleSystem_SetActive("carl_burn_smoke", true);
		}
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mAssemblyRoomPowerReturnsSequence;
		
	void Seq_AssemblyRoomPowerReturns(const tString &in asTimer)
	{
		Sequence_Begin("Seq_AssemblyRoomPowerReturns", mAssemblyRoomPowerReturnsSequence);
			
		if (Sequence_DoStepAndWait(1))
		{
			SequenceStates_Stop("Seq_AssemblyRoomPowerReroute");
			mAssemblyRoomPowerRerouteSequence.mlStateCounter = 0;
			
			if (!mbCarlDead)
				StopCarlTorture();
			
			//Audio
			Sound_CreateAtEntity("LeverActivate", "Entities_OceanBottom/lever/lever/lever_stop", "ControlFlowLever_2");
			Sound_Stop("CarlTortureLoop", 0.25f);
			Sound_Stop("CarlTortureStart", 0.25f);
			Music_FadeVolumeMul(1.0f, 6.0f);
			
			Sound_CreateAtEntity("TortureStop", "01_02_upsilon_inside_02/sfx/carl_torture_event/electricity_stop", "TortureSoundSource");
			Sound_FadeGlobalVolume(0.25, 1.0f);
			Map_AddTimer("FadeUpStopTorture", 1.0f, "FadeUpStopTorture");
			Sound_Stop("TortureStartup", 1.0f);
			
			Lamp_SetLit("MachineRoomLamp_Desk", true, true);
			Lamp_SetFlickerActive("MachineRoomLamp_Ceiling_1", false);
			Lamp_SetFlickerActive("MachineRoomLamp_Ceiling_4", false);
			Lamp_SetLit("MachineRoomLamp_Ceiling_4", true, true);
			Lamp_SetLit("MachineRoomLamp_Ceiling_5", true, true);
			Lamp_SetLit("MachineRoomLamp_Ceiling_6", true, true);
			Lamp_SetLit("MachineRoomLamp_Ceiling_7", true, true);
			Lamp_SetLit("MachineRoomLamp_Ceiling_8", true, true);
			Lamp_SetLit("AssemblyLeverLamp", true, true);
			Lamp_SetFlickerActive("power_calbe_lamp_*", true);
			Entity_FadeEffectBaseColor("power_calbe_lamp_*", cColor(1), 0.5);
			Entity_FadeEffectBaseColor("carl_burn_effects", cColor(0), 25);
			
			Effect_Shake_FadeOut(mlAssemblyRoomShake, 0.5f);
			Lamp_SetFlickerActive("FloorLight_*",false);
			
			ParticleSystem_SetVisible("ParticleSystem_13", true);
			ParticleSystem_SetVisible("ParticleSystem_57", true);
			
			Entity_PlayAnimation("ControlFlowLever_2_fan", "spin", 1.0f, true, true);
			Sound_Play("carl_lever_fan", 1.0f);
			Entity_SetEffectsActive("ControlFlowLever_2", true, true);
			Lamp_SetLit("ControlFlowLever_2_lamp_*", false, true);
			
			RobotArmActivation();
			
			if (!mbCarlDead)
			{
				Entity_SetActive("TriggerCarlCanHearPlayer", true);
				Entity_SetActive("TriggerCarlCanSeePlayer", true);
					
				Voice_Stop("CarlConstruct");
				OnCarlConstructSpeakDone("", "");
				
				Entity_SetInteractionDisabled("CarlConstruct_Talk", false);
			}
		}
		Sequence_End();
	}
	
	void FadeUpStopTorture(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 3.0f);
	}
				
	//-------------------------------------------------------
	bool mbRobotAlarmCooldown = false;
	
	void RobotArmActivation()
	{
		if (mbAssemblyActive) return;
		mbAssemblyActive = true;
		RobotArmActivationUpstairsEnter();
		if (mbRobotAlarmCooldown == false)
		{
			Sound_CreateAtEntity("RobotArmAlarm", "01_02_upsilon_inside_02/sfx/robot_arm_event/robot_arm_event_triggered", "Player", 0, false);
			mbRobotAlarmCooldown = true;
			Map_AddTimer("RobotAlarmCooldownOver", 8.0f, "ResetRobotAlarmCooldown");
		}
	}
	
	void ResetRobotAlarmCooldown(const tString &in asTimer)
	{
		mbRobotAlarmCooldown = false;
	}
	
	//-------------------------------------------------------
	 
	void RobotArmActivationUpstairsEnter()
	{	
		Sound_CreateAtEntity("RobotArmIdle", "Entities_Station/tech/robot_arm/robot_arm_idle", "robot_arm_welding", 0, false);
		Sound_CreateAtEntity("RobotArmBroken", "Entities_Station/tech/robot_arm/robot_arm_broken_idle", "RobotArmPSArea_1", 0, false);
		
		Entity_PlayAnimation("robot_arm_broken", "broken_idle", 0.1f, true, false);
		Entity_PlayAnimation("robot_arm_welding", "idle_to_weld", 0.1f, false, false, "RobotArmAnimationOver");
		Entity_PlayAnimation("robot_arm_broken_on_belt", "broken_on_belt", 0.1f, true, false);
		
		Entity_SetActive("robot_arm_broken_on_belt", true);
		Entity_SetActive("robot_arm_broken_on_belt_1", false);
		
		Entity_SetEffectsActive("robot_arm_broken", true, true);
	}
	
	//-------------------------------------------------------
	 
	void RobotArmDeactivation()
	{
		if (!mbAssemblyActive) return;
		mbAssemblyActive = false;
		
		Sound_Stop("RobotArmIdle", 1.0f);
		Sound_Stop("RobotArmBroken", 1.0f);
		
		Entity_PlayAnimation("robot_arm_broken", "idle", 0.1f, true, false);
		Entity_PlayAnimation("robot_arm_welding", "weld_to_idle", 0.1f, false, false, "RobotArmAnimationOver");
		Entity_StopAnimation("robot_arm_broken_on_belt");
		
		Entity_SetActive("robot_arm_broken_on_belt", false);
		Entity_SetActive("robot_arm_broken_on_belt_1", true);
		
		Entity_SetEffectsActive("robot_arm_broken", false, false);
	}
	
