	//-------------------------------------------------------
	
	void StopLeverSoundPhysicsLeverStart(const tString &in asTimer)
	{
		Sound_Stop("LeverSound", 0.01f);
		Map_AddTimer("Timer_LeverSoundStopLevelStart", 0.05f, "StopLeverSoundPhysicsLeverStart");
	}
	
	void StopLeverSoundTimer(const tString &in asTimer)
	{
		Map_RemoveTimer("Timer_LeverSoundStopLevelStart");
	}
		
	//-------------------------------------------------------
	
	void OnHatchStateChanged(const tString &in asEntity, int alState)
	{
		if (alState == 1)
		{
			if (!mbInTunnels)
				Map_AddTimer("HatchClimb_2", 0.75, "TimerActivateEntity");
		}
		else
		{
			Entity_SetActive("HatchClimb_2", false);
			Map_RemoveTimer("HatchClimb_2");
		}
	}
	
	//-------------------------------------------------------
	
	bool CollideCrouchTrigger(const tString &in asParent, const tString &in asChild, int alState)
	{
		Player_SetJumpDisabled(true);
		return false;
	}
	
	//-------------------------------------------------------
	
	bool TriggerConstructLoop(const tString &in asParent, const tString &in asChild, int alState)
	{
		Sound_CreateAtEntity("ConstructVentLoopStart", "01_02_upsilon_inside_02/sfx/vent/construct/loop_intro", "ConstructVentSoundSource", 0.0f, false, 1.0f);
		Map_AddTimer("BeginConstructLoopTimer", 3.5f, "BeginConstructLoop");
		Depth_Audio_Fear_LowIntensity();
		return false;
	}
	
	//-------------------------------------------------------
		
