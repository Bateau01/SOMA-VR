	//-------------------------------------------------------
	
	bool OnTriggerEnableVentRobot(const tString&in asParent, const tString&in asChild, int alState)
	{
		cLux_AddDebugMessage("Enable Vent Robot!");
		Map_AddTimer("ConstructEnterFearBreathing", 3.0f, "ConstructEnterFearBreathing");
		
		Entity_SetActive("VentRobot", true);
		Agent_SetSensesActive("VentRobot", false);
		CharMover_PlayAnimation("VentRobot", "01_02_appearance", 0, false, true, "AnimOver_VentRobotEnters");
		Sound_CreateAtEntity("VentRobotEmerges", "NPC_Creatures/Foley/InWorld/Construct/long_falloff/upsilon_stairs_emerge", "VentRobot");
		Sound_FadeGlobalVolume(0.7f, 3.0f);
		Map_AddTimer("VentRobotEmergeFadeUp", 4.0f, "VentRobotEmergeFadeUp");
		return false;
	}
	
	void VentRobotEmergeFadeUp(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 4.0f);
	}
	
	void ConstructEnterFearBreathing(const tString &in asTimer)
	{
		Depth_Audio_Fear_MediumIntensity();
	}
	
	void AnimOver_VentRobotEnters(const tString &in asEntityName, const tString &in asAnimName)
	{
		if (cLux_GetExplorationModeActive())
		{
			//////////////////////////////////////////////////
			// Activate senses after patrol path has started
			Map_AddTimer("ActivateVentRobotSenses", 0.5f, "Timer_ActivateVentRobotSenses");					
		}
		else
		{
			Agent_SetSensesActive("VentRobot", true);				
		}
		
		ActivateVentRobotPath();
		
		if(Entity_GetCollide("PlayerNearVentRobot", "Player"))
		{
			Agent_RevealPlayerPosition("VentRobot");
		}
			
	}
	
	//-------------------------------------------------------
	
	void ActivateVentRobotPath()
	{
		Pathfinder_Track_Add("VentRobot", "PathNodeArea_162", 2);
		Pathfinder_Track_Add("VentRobot", "PathNodeArea_134", 2);
		Pathfinder_Track_Add("VentRobot", "PathNodeArea_133", 2, 5);
		Pathfinder_Track_Add("VentRobot", "PathNodeArea_197", 2, 5);
		Pathfinder_Track_Add("VentRobot", "PathNodeArea_206", 2, 5);
		Pathfinder_Track_Add("VentRobot", "PathNodeArea_170", 2, 5);
		Pathfinder_Track_Add("VentRobot", "PathNodeArea_163", 2, 5);
		Pathfinder_Track_Add("VentRobot", "PathNodeArea_213", 2, 5);
		Pathfinder_Track_Start("VentRobot", true, 0.5f, "");
	}
	
