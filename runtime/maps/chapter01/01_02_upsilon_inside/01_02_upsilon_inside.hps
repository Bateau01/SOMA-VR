	bool CollideConstructSoundTrigger(const tString &in asParent, const tString &in asChild, int alState)
	{
		cLux_AddTodoMessage("SOUND: Construct moving around.");
		return false;
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////////////
	// Triggers random rumbles while in the tunnels
	void TimerTunnelAmbientRumble(const tString &in asTimer)
	{
		Sound_CreateAtEntity("TunnelRumbleTremor", "01_02_upsilon_inside_02/sfx/vent/tremor", "Player", 0.0f, false, 1.0f);
		StopActiveVentTremor();
		Effect_Shake_Start(cMath_RandRectf(0.0015f, 0.0025f), cMath_RandRectf(0.5f, 1.0f), cMath_RandRectf(0.5, 1.0f), cMath_RandRectf(0.75f, 1.25f));
		Map_AddTimer("AmbientRumbleTimer", cMath_RandRectf(5.f, 25.f), "TimerTunnelAmbientRumble");
		
		for (int i = 1; Entity_Exists("TunnelDustPSArea_" + i); i++)
		{
			ParticleSystem_CreateAtEntityExt("TunnelDustPS_" + i, "dust_falling_fast.ps", "TunnelDustPSArea_" + i, true, cColor(0.415,0.645,0.645,1), 0.75f, true, 1.f, 3.f);
		}
	}
	
	//-------------------------------------------------------
	
	// Auto standup when leaving the tunnels for the first time.
