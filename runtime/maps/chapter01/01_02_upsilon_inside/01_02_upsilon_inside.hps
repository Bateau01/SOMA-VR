	void CutScreentoBlack(const tString &in asTimer)
	{
		//////////////////////////
		//Cut to black
		Effect_Fade_Out(0.05f);
		
        
        
		PreloadDeload();
		
		PreloadRemoveEntitiesNotToTrans();
		PreloadSetPrioVeryHigh();
	}
	
	//-------------------------------------------------------	
	
	int mlTimesFixedPipe = 0;
	
	void OnChangeCommRoomPipe(const tString &in asEntity, int alState)
	{
		if(alState == 1)
		{
			cLux_AddDebugMessage("FLOOD: Pipe breaks");
			Sound_Stop(asEntity+"_RattleSound", 0.5f);
			
			////////////////////
			// Sounds
			cLux_AddTodoMessage("Sound: pipe dislocates");
			cLux_AddTodoMessage("Sound: water starts flushing in");
			
			////////////////////
			// Water effects
			Map_AddTimer(asEntity + "_Water", 0.40f, "TimerActivateEntity");
			ParticleSystem_CreateAtEntity(asEntity + "_Splash", "splash_continuous_big.ps", asEntity + "_SplashArea", false);
			ParticleSystem_Destroy(asEntity + "_Spray");
			ParticleSystem_CreateAtEntity(asEntity + "_Spray", "spray_cone_med.ps", asEntity + "_PSArea", true);
			
			Entity_StopAnimation(asEntity);
			
			// Detach panel if it isn't already so the player can't close it
			if (asEntity == "CommRoomPipe_2" && Entity_IsActive("LoosePanel_2")) 
				BreakLoosePanel("LoosePanel_2");
			
			// Temporarily disable player to avoid accidentally looking away from pipe
			Player_ChangeStateToNormal();
			Player_SetActive(false);
			Map_AddTimer("ActivatePlayerTimer", 0.25f, "TimerActivatePlayer");
		}
		else if(alState == -1)
		{
			cLux_AddDebugMessage("FLOOD: Player fixes pipe");
			mlTimesFixedPipe++;
			Sound_CreateAtEntity(asEntity+"_RattleSound", "Entities_Station/special/01_02_pipe_medium/pipes_rattle_intensive", asEntity, 0.1f, true);
			Entity_PlayAnimation("CommRoomPipe_1", "rattle", 0, true, false, "");
			
			Sound_Stop(asEntity + "_Leak", 0.2f);
			ParticleSystem_Destroy(asEntity + "_Splash");
			ParticleSystem_Destroy(asEntity + "_Spray");
			ParticleSystem_CreateAtEntity("CommRoomPipe_1_Spray", "spray_plane_med.ps", "CommRoomPipe_1_PSArea", true);
			
			Entity_SetInteractionDisabled(asEntity, true);
			
			SequenceStates_Resume("SequenceFloodCommRoom");
		}
	}
	
	//-------------------------------------------------------
	
	// The player pulled one of the panels off the wall
	bool CollisionBreakLoosePanel(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == -1) return true;
		
		BreakLoosePanel(asChild);
		
		return false;
	}
	
	//-------------------------------------------------------
	
	void BreakLoosePanel(const tString &in asPanel)
	{
		cLux_AddTodoMessage("Sound: panel torn from wall");
		
		Entity_SetActive(asPanel + "_Broken", true);
		Entity_PlaceAtEntity(asPanel + "_Broken", asPanel, cVector3f_Zero, true);
		Entity_AddImpulse(asPanel + "_Broken", cVector3f(-1, 0, -0.5f)*2, true, true);
		Entity_SetActive(asPanel, false);
		
		/////////////////////////////////////////////////////////////////////////////
		// Temporarily disable player to avoid accidentally looking away from panel
		Player_ChangeStateToNormal();
		Player_SetActive(false);
		Map_AddTimer("ActivatePlayerTimer", 0.2f, "TimerActivatePlayer");
	}
	
