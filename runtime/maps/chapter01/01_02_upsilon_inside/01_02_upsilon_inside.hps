			return;
			
		SequenceStates_Resume("SequenceCommRoomDialog");
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// FLOODING
	/////////////////////////////////////////
	
	//-------------------------------------------------------	
	
	cSequenceStatesData mFirstConstructSlamsSequence;

	void Seq_FirstConstructSlams(const tString &in asTimer)
	{
		Sequence_Begin("Seq_FirstConstructSlams", mFirstConstructSlamsSequence);
			
		/////////////////////////////////
		// First construct hits the outside wall
		if (Sequence_DoStepAndWait(0.6f))
		{
			//////////////////////////////////////////////////
			//Setpiece audio
			
			////////////////////////
			//Play Tremors
			Sound_CreateAtEntity("SecondTremorDebris","01_02_upsilon_inside_02/special/collapse_sequence/collapse_impact_02_debris","Player",0.0f,false);
			Sound_CreateAtEntity("SecondTremorMoan","01_02_upsilon_inside_02/special/collapse_sequence/collapse_impact_02_moan","Player",0.0f,false);
			Sound_CreateAtEntity("SecondTremorShake","01_02_upsilon_inside_02/special/collapse_sequence/collapse_impact_02_shake","Player",0.0f,false);
			cLux_AddDebugMessage("Tremor 2 playing");
			Music_Stop(0.0f, eMusicPrio_BigEvent);
			Music_Stop(0.0f, eMusicPrio_BgAmb);
			
			Effect_Shake_Start(0.12f, 0.2f, 0.125f, 0.85f);
			Effect_Rumble_Start(0.6, 1.325, 0.125, 1);
			//ParticleSystem_CreateAtEntity("SlamPS_LoosePanel_1","ps_impact_metal_high.ps","LoosePanel_1",false);
			Lamp_SetupFlicker("CommRoomLamp_*", 0.05f, 5.f, 0.05f, 0.2f);
			Lamp_SetFlickerActive("CommRoomLamp_*", true);
			Map_AddTimer("CommRoomLamp_*", 4.f, "TimerDeactivateLampFlicker");
		}
		else
		{
		}
		Sequence_End();
	}
	
	//-------------------------------------------------------	
	
	cSequenceStatesData mSecondConstructSlamsSequence;
		
	void Seq_SecondConstructSlams(const tString &in asTimer)
	{
		Sequence_Begin("Seq_SecondConstructSlams", mSecondConstructSlamsSequence);
			
		/////////////////////////////////
		// Second construct hits the outside wall
		if (Sequence_DoStepAndWait(0.5f))
		{
			////////////////////////
			//Play Tremors
			Sound_CreateAtEntity("ThirdTremorDebris","01_02_upsilon_inside_02/special/collapse_sequence/collapse_impact_03_debris","Player",0.0f,false);
			Sound_CreateAtEntity("ThirdTremorMoan","01_02_upsilon_inside_02/special/collapse_sequence/collapse_impact_03_moan","Player",0.0f,false);
			Sound_CreateAtEntity("ThirdTremorShake","01_02_upsilon_inside_02/special/collapse_sequence/collapse_impact_03_shake","Player",0.0f,false);
			cLux_AddDebugMessage("Tremor 3 playing");
			Sound_FadeGlobalVolume(0.35f, 5.5f);
			
			Effect_Shake_Start(0.15f, 0.4f, 0.2f, 0.9f);
			Effect_Rumble_Start(0.7, 1.85f, 0.2f, 1.25);
			Lamp_SetupFlicker("CommRoomLamp_*", 0.05f, 5.f, 0.05f, 0.2f);
			Lamp_SetFlickerActive("CommRoomLamp_*", true);
			Map_AddTimer("CommRoomLamp_*", 1.f, "TimerDeactivateLampFlicker");
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{			
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------	
	
	void TimerPopPipe(const tString &in asTimer)
	{
		MovingButton_SetSwitchedOn(asTimer, true, true);
	}
	
	//-------------------------------------------------------	
	
	cSequenceStatesData mCommRoomFloodSequence;
	[nosave] int mlMildShakeID = -1;
	void SequenceFloodCommRoom(const tString &in asTimer)
	{
		Sequence_Begin("SequenceFloodCommRoom", mCommRoomFloodSequence);
			
		//////////////////////////////////
		// Ceiling about to break
		if (Sequence_DoStepAndWait(0.35f))
		{			
			
			ParticleSystem_CreateAtEntityExt("CommRoomCeiling_PS_Small_1", "stream_flood01.ps", "CommRoomCeiling_PSArea_1", false, cColor(1,1,1,1));
			
			////////////////////////////
			//Sound - Water bursting in
			Sound_CreateAtEntity("WaterBurst","01_02_upsilon_inside_02/special/collapse_sequence/collapse_waterburst","Player",0.0f,false);
			Sound_CreateAtEntity("WaterBurstCreak","01_02_upsilon_inside_02/special/collapse_sequence/collapse_waterburst_creak","Player",0.0f,false);
			Sound_CreateAtEntity("WaterBurstMoan","01_02_upsilon_inside_02/special/collapse_sequence/collapse_waterburst_moan","Player",0.0f,false);
			
			Sound_Stop("ThirdTremorShake", 0.5f);
			Sound_Stop("ThirdTremorMoan", 0.5f);
			Sound_Stop("ThirdTremorDebris", 0.5f);
			
			Map_AddTimer("WaterFloodSoundStart", 2.f, "StartFloodingLoop");
			Sound_FadeGlobalVolume(0.0f, 3.0f, eSoundEntryType_WorldAll);
			cLux_AddDebugMessage("WaterBurstTrigger");
		}	
		else if (Sequence_DoStepAndWait(0.25f))
		{
			ParticleSystem_CreateAtEntityExt("CommRoomCeiling_PS_Small_2", "stream_flood01.ps", "CommRoomCeiling_PSArea_2", false, cColor(1,1,1,1));
			cLux_AddDebugMessage("PSSmall2");
		}	
		else if (Sequence_DoStepAndWait(0.25f))
		{
			ParticleSystem_CreateAtEntityExt("CommRoomCeiling_PS_Small_3", "stream_flood01.ps", "CommRoomCeiling_PSArea_3", false, cColor(1,1,1,1));
			cLux_AddDebugMessage("PSSmall3");
		}		
		else if (Sequence_DoStepAndWait(0.5f))
		{
			ParticleSystem_CreateAtEntityExt("CommRoomCeiling_PS_Small_4", "stream_flood01.ps", "CommRoomCeiling_PSArea_4", false, cColor(1,1,1,1));
		}
		
		//////////////////////////////////
		// Ceiling buckling
		else if (Sequence_DoStepAndWait(0.2f))
		{
			ParticleSystem_CreateAtEntityExt("CommRoomCeiling_PS_Med_1", "stream_flood02.ps", "CommRoomCeiling_PSArea_1", false, cColor(0.7,0.8,0.7,0.7));
			ParticleSystem_CreateAtEntityExt("CommRoomCeiling_PS_Med_2", "stream_flood03.ps", "CommRoomCeiling_PSArea_2", false, cColor(0.7,0.8,0.7,0.7));
			ParticleSystem_CreateAtEntityExt("CommRoomCeiling_PS_Med_3", "stream_flood04.ps", "CommRoomCeiling_PSArea_3", false, cColor(0.7,0.8,0.7,0.7));
			ParticleSystem_CreateAtEntityExt("CommRoomCeiling_PS_Med_4", "stream_flood05.ps", "CommRoomCeiling_PSArea_4", false, cColor(0.7,0.8,0.7,0.7));
			ParticleSystem_CreateAtEntityExt("CommRoomCeiling_PS_Med_5", "stream_flood06.ps", "CommRoomCeiling_PSArea_5", false, cColor(0.5,0.6,0.5,0.6));
			ParticleSystem_Destroy("CommRoomCeiling_PS_Small_1");
			ParticleSystem_Destroy("CommRoomCeiling_PS_Small_2");
			ParticleSystem_Destroy("CommRoomCeiling_PS_Small_3");
			ParticleSystem_Destroy("CommRoomCeiling_PS_Small_4");
			Effect_Rumble_Start(0.75, 1.5f, 0, 1);		
			
		}
		else if (Sequence_DoStepAndWait(0.5f))
		{
			Entity_SetActive("CommRoomRoof", false);
			Entity_SetActive("CommRoomRoof_Buckled_1", true);
			ParticleSystem_CreateAtEntityExt("SplashEffect", "splash_camera_continuous_big.ps", "player", true, cColor(0.85,1,0.85,1));
		}	
		else if (Sequence_DoStepAndWait(0.4f))
		{
			Effect_Shake_Start(0.2f, 0.3f, 0.01f, 0.8f);	
			Effect_Screen_Start("water_splash_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 0.4f, 0.2f, 0.6f); 
			Effect_Screen_Start("water_drip_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 2.15f, 2.f, 3.5f);
			Effect_Screen_Start("water_drip_fast_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 2.15f, 2.f, 3.5f);
			
			if (Entity_IsInPlayerFOV("CommRoomMonitor") && Entity_GetCollide("Player", "CommRoomPanelLookAtProximity"))
			{
				Player_StartLookAt("CommRoomCeiling_PSArea_1", 0.3, 1.25, 7);
				Player_SetCrouching(true);
				Player_MoveHeadPos(cVector3f(0,-0.25, 0), 2,3,0.01f);
			}
		}
		
		//////////////////////////////////
		// Setup waist deep water state
		else if (Sequence_DoStepAndWait(0.2f))
		{
			
			/////////////////////////////
			// Deactivate the old
			ParticleSystem_Destroy("CommRoomPipe_1_Spray");
			ParticleSystem_Destroy("CommRoomPipe_2_Spray");
			
			if (MovingButton_IsSwitchedOn("CommRoomPipe_1"))
			{
				Entity_SetActive("CommRoomPipe_1_Water", false);
				ParticleSystem_Destroy("CommRoomPipe_1_Splash");
				Sound_Stop("CommRoomPipe_1_Leak", 0.5f);
			}
			if (MovingButton_IsSwitchedOn("CommRoomPipe_2"))
			{
				Entity_SetActive("CommRoomPipe_2_Water", false);
				ParticleSystem_Destroy("CommRoomPipe_2_Splash");
				Sound_Stop("CommRoomPipe_2_Leak", 0.5f);
			}
			Entity_SetActive("CommRoomFloorRipples_*", false);
			ParticleSystem_Destroy("CommRoomFloorFroth_1");
			ParticleSystem_Destroy("CommRoomFloorFroth_2");
			
			//////////////////////////////
			// Activate the new
			Entity_SetActive("CommRoomWater_1", true);
			LiquidArea_MoveLinearTo("CommRoomWater_1", "CommRoomWater_1_End", 1, 0.05f, 0, false);
			Prop_SetActiveAndFade("CommRoomPour_*", true, 0.4f);
			
			// Creates froth particles all around the comm room
			for(int i = 1; Entity_Exists("FrothPSArea_" + i); i++)
			{
				ParticleSystem_CreateAtEntityExt("FrothPS", "edge_continuous_large.ps", "FrothPSArea_" + i, true, cColor(0.75,1,0.8,1), 1.f);
			}
			// Creates splash particles beneath the pour meshes.
			ParticleSystem_SetActive("PourSplashPS_*", true);
			ParticleSystem_AttachToEntity("PourSplashPS_*", "CommRoomWater_1");
			ParticleSystem_SetActive("PourUnderwaterPS_*", true);
			ParticleSystem_AttachToEntity("PourUnderwaterPS_*", "CommRoomWater_1");
			
			Lamp_SetFlickerActive("CommRoomPanelLamp_*", true);
			Map_AddTimer("CommRoomPanelLamp_1", 2.f, "TimerDeactivateLampFlicker");
			Map_AddTimer("CommRoomPanelLamp_1", 2.f, "TimerTurnOffLamp");
			Map_AddTimer("CommRoomPanelLamp_2", 3.f, "TimerDeactivateLampFlicker");
			Map_AddTimer("CommRoomPanelLamp_2", 3.f, "TimerTurnOffLamp");
			Map_AddTimer("CommRoomPanelLamp_3", 2.5f, "TimerDeactivateLampFlicker");
			Map_AddTimer("CommRoomPanelLamp_3", 2.5f, "TimerTurnOffLamp");
			Map_AddTimer("CommRoomPanelLamp_4", 2.2f, "TimerDeactivateLampFlicker");
			Map_AddTimer("CommRoomPanelLamp_4", 2.2f, "TimerTurnOffLamp");
		
			Light_SetVisible("WaterReflection_*", true);
		}
		
		else if (Sequence_DoStepAndWait(0.1f))
		{
			ParticleSystem_Destroy("SplashEffect");
		}
		
		///////////////////////////////////////////////
		// Break Lamp
		else if (Sequence_DoStepAndWait(0.3f))
		{	
			Player_StopLookAt(0.075);	
			
			Sound_CreateAtEntity("LightSnapping", "01_02_upsilon_inside_02/special/collapse_sequence/spots/lights_fall", "LightSnapSoundSource", 0.0f, false, 1.0f);
			Sound_CreateAtEntity("LightSnappingSplash", "01_02_upsilon_inside_02/special/collapse_sequence/spots/lights_splash", "LightSnapWaterSoundSource", 0.0f, false, 1.0f);
	
			Prop_SetStaticPhysics("CommRoomBreakLamp", false);
			Map_AddTimer("CommRoomBreakLamp_JointHinge_2", 1.f, "TimerBreakJoint");
		}
		
		///////////////////////////////////////////////
		// Play creaking sound from ceiling
		else if (Sequence_DoStepAndWait(1.f))
		{		
			Player_MoveHeadPos(cVector3f(0,0,0), 0.5,1,0.2f);
			//Sound_CreateAtEntity("CommRoomCeilingCreak_2", "Entities_Station/special/01_02_comm_room_roof_pplant/before_breaking", "CommRoomCeiling_PSArea_4", 0, false);
		}
		
		///////////////////////////////////////////////
		// Break Lamp
		else if (Sequence_DoStepAndWait(4.0f))
		{
			
			Voice_Play("WaterComment", -1);
			
			cLux_AddTodoMessage("Sound: Lamp Hinge breaking");
			
			Joint_Break("CommRoomBreakLamp_JointHinge_3");
			Body_AddImpulse("CommRoomBreakLamp_Body_1", cVector3f_Down, false);
			Map_AddTimer("CommRoomBreakLamp_JointHinge_1", 0.1f, "TimerBreakJoint");
			
			Sound_Fade("WaterRushingLoop", 0.45f, 3.0f);
			Sound_Fade("WaterRushingLoop", 0.45f, 3.0f);
			
			// Stop readables
			Player_ChangeStateToNormal();
			Entity_SetInteractionDisabled("upsilon_information_05_1", true);
			Entity_SetInteractionDisabled("TerminalTuning", true);
			Entity_SetInteractionDisabled("ZoomArea_14", true);
			Entity_SetInteractionDisabled("CityNote_*", true);
		}	
		
		////////////////////////////////
		// Setup flooded state
		else if (Sequence_DoStepAndWait(6.5f))
		{
			///////////////////////////////////////
			//Sound - Final buckling in
			Sound_Stop("WaterRushingLoop", 0.05f);
			Sound_SetGlobalVolume(0.0f);
			
			Sound_Stop("WaterBurstCreak", 0.3f);
			Sound_Stop("WaterBurstMoan", 0.3f);
			Sound_Stop("Collapse_Alarm", 0.3f);
			Sound_CreateAtEntity("CollapseFinal", "01_02_upsilon_inside_02/special/collapse_sequence/collapse_final", "Player", 0.0f, false, 1.f);
			
			///////////////////////////////////////
			// Break ceiling
			ParticleSystem_Destroy("CommRoomCeiling_PS_Med_1");
			ParticleSystem_Destroy("CommRoomCeiling_PS_Med_2");
			ParticleSystem_Destroy("CommRoomCeiling_PS_Med_3");
			ParticleSystem_Destroy("CommRoomCeiling_PS_Med_4");
			ParticleSystem_CreateAtEntityExt("CommRoomStream", "stream_flood_end_splash.ps", "LevelExit_LookAt", false, cColor(0.8,1,0.8,1), 1, false);
			Map_AddTimer("CommRoomRoof_Buckled_1", 0.15f, "TimerDeactivateEntity");
			Map_AddTimer("CommRoomRoof_Broken", 0.15f, "TimerActivateEntity");
			
			Map_AddTimer("FinalSplash", 0.3f, "Timer_FinalSplash");
			Effect_Rumble_Start(0.9, 1.6f, 0, 1);		
			Map_AddTimer("CuttoBlack", 0.9f, "CutScreentoBlack");
			
			//Return player movement to normal
			Player_SetCrouchDisabled(false);
		
			/////////////////////////////
			//Deactivate stuff
			ParticleSystem_Destroy("FrothPS");
			ParticleSystem_Destroy("CommRoomDrops_*");
			ParticleSystem_Destroy("PourSplashPS_*");
			ParticleSystem_Destroy("PourUnderwaterPS_*");
			Lamp_SetLit("CommRoomLamp_*", false, true);
			Entity_SetActive("CommRoomPour_*", false);
			
		}
		else if (Sequence_DoStepAndWait(1.1f))
		{	

			Player_SetActive(true);
			Player_SetLookSpeedMul(0);
			Player_FadeLookSpeedMulTo(0.5f, 2.f);
			Player_SetMoveSpeedMul(0.2);
			Player_SetJumpDisabled(true);
			
			//To stop next level from loading prematurely
			Map_AddTimer("NextMapChange", 3.0f, "LoadNextMap");
		}
		Sequence_End();
	}
	
	//-------------------------------------------------------	
	
	void LoadNextMap(const tString &in asTimer)
	{
		/////////////////////////
		// Change to next map
		Player_SetMoveSpeedMul(1.f);
		Player_SetRunSpeedMul(1.f);
		Player_SetLookSpeedMul(1.f);
		Player_SetJumpDisabled(false);
		Effect_ToneMapping_FadeExposure(0,0.0f);
		Effect_DoF_Reset();
		
		
		int lETA = 0;
		if(cLux_IsPlayGoReady(lETA)) //Is all the data needed downloaded?
		{
			Map_ChangeMap("01_03_upsilon_outside.hpm", "PlayerStartArea_1", "Transfer0203", "", "");
		}
		else
		{
			// Remaining data has not finished download, try again in 3 seconds
			cScript_SetGlobalVarBool("PlayGo", true);
			PauseMenu_Show(true);
			Map_AddTimer("NextMapChange", 3.0f, "LoadNextMap");
		}
	}
		
	//-------------------------------------------------------	
	
	void StartFloodingLoop(const tString &in asTimer)
	{
		//////////////////////////
		//Water Rushing In Loop
		Sound_CreateAtEntity("WaterRushingLoop", "01_02_upsilon_inside_02/special/collapse_sequence/water_flooding_loop", "Player", 0.3f, false, 1.f);
		Effect_Shake_Start(0.005f, 8.5f, 0.5f, 4.0f);
	}
	
	void Timer_FinalSplash(const tString &in asTimer)
	{
		Effect_Shake_Start(0.15f, 0.3f, 0.01f, 0.8f);			
		Effect_Screen_Start("water_plunge_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 0.15f, 1.f, 3.f); 
		ParticleSystem_CreateAtEntity("PlayerPlungePS", "loop_waterbubbles_small_plunge.ps", "player", true);
	}
		
