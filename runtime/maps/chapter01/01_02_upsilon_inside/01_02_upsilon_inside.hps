	// REACTOR CONTROL FLOW
	/////////////////////////////////////////
    	
	//-------------------------------------------------------
	
    bool CollideFlowLeverPreload(const tString &in asParent, const tString &in asChild, int alState)
    {
        Sound_PreloadGroup("01_02_upsilon_inside_02/special/thermal_flow_shutdown", true);
        return false;
    }
	
	//-------------------------------------------------------
	
	bool mbReactorControlFlowPulled = false;
	bool mbThermalReactorActive = true;
	bool mbFlowLeverCheckpointTriggered = false;
    bool mbFlowLeverSound = false;
	bool mbReactedToCarlBody = false;
	bool mbCarlBodyGaze = false;
	float mbCarlBodyReactTimer = 0.0f;
	
	void OnChangeReactorControlFlowLever(const tString &in asEntity, int alState)
	{
		if (alState!=1) return;
		if (mbReactorControlFlowPulled)
			return;
			
		EnergySource_SetEnergy("FlowWauFlower", 0);
        
        if(mbFlowLeverSound==false)
        {
            Sound_CreateAtEntity("ReactorShutdown", "01_02_upsilon_inside_02/special/thermal_flow_shutdown/thermal_flow_shutdown_sequence", "Player");
            mbFlowLeverSound = true;
        }
        
		SetHubFloorPowerOn(false);
		KillCarl(false);
		Entity_SetActive("SeeDeadCarlTrigger", true);
		
		Seq_VentBotAppear();
		
		Map_AddTimer("Timer_FlowLeverCheckpoint", 10, "Timer_FlowLeverCheckpoint");
		Entity_SetActive("FlowLeverCheckpointTrigger", true);
	}
	
	//-------------------------------------------------------
	
	bool Trigger_FlowLeverCheckpoint(const tString &in asParent, const tString &in asChild, int alState)
	{
		Timer_FlowLeverCheckpoint("");
		return false;
	}
	
	void Timer_FlowLeverCheckpoint(const tString &in asTimer)
	{
		if (mbFlowLeverCheckpointTriggered) return;
		
		mbFlowLeverCheckpointTriggered = true;
		CheckPoint_Setup("");
	}
	
	//-------------------------------------------------------
	

	cSequenceStatesData mSeqVentBotAppear;
	void Seq_VentBotAppear(const tString& in asName="")
	{
		Sequence_Begin("Seq_VentBotAppear", mSeqVentBotAppear);
		
		if (Sequence_DoStepAndWait(3.0f))
		{
			Music_StopAll(3);
			mbAmbientMusicAllowed = false;
			
			Entity_SetActive("TransformerBot", false);
			Entity_SetActive("Trigger_HallConstructDucking", false);
			
			Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_WorldAll);
			//cSound_FadeHighPassFilter(0.0f, 0.0f, 3.0f, eSoundEntryType_WorldAll);
			
			SlideDoor_SetClosed("NorthDoor", false, true);
			
			//////////////////////
			// Open stairs door
			Entity_SetEffectsActive("StairsLever", false, false);
			Entity_SetEffectsActive("StairsLever_2", false, false);
			Lamp_SetLit("StairsLeverLampOn_*", false, false);
			Lever_SetStuckState("StairsLeve*", 1, false);
			Lever_SetAutoMoveEnabled("StairsLeve*", true);
			Lever_SetAutoMoveTarget("StairsLeve*", 1);
			Lever_SetInteractionDisablesStuck("StairsLeve*", false);
			SlideDoor_SetClosed("StairsDoor", false, true);
			InactivateStairSteam();
			
			// Sparks and rumbles and stuff
			Effect_Shake_Start(0.08f,1.0f,0.4f,1.0f);
			Effect_Rumble_Start(0.5, 2.5, 0.4, 1.5);
			
			for (int i=1;i<=4;++i)
			{	
				ParticleSystem_CreateAtEntity("FlowPS_"+i, "elec_spark_large_continuous.ps", "FlowPSArea_"+i, false);
			}
		}
		else if (Sequence_DoStepAndWait(0.0f))
		{
			Entity_SetActive("TriggerEnableVentRobot", true);
			//Entity_SetActive("AgentRepelArea_Floor_3", true);
			Entity_SetActive("AgentRepelArea_Floor_2*", false);
			Entity_SetActive("ConstructHubAreaMixer", true);
			Entity_SetActive("VentRobotTrigger", true);
			Entity_SetActive("VentBotSoundTrigger", true);
			
			for (int i=1;i<=4;++i)
			{	
				ParticleSystem_Destroy("FlowPS_"+i);
			}
		}
		
		Sequence_End();
	}
			
	//------------------------------------------------------
		
	bool Trigger_CommRoomRobotSoundControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Map_AddTimer("RobotCommRoomDoorSoundControl", 0.05f, "RobotCommRoomDoorSoundControl");
			mbPlayerInDome = true;
		}
		else
		{
			Map_RemoveTimer("RobotCommRoomDoorSoundControl");
			mbPlayerInDome = false;
		}
		return true;
	}
		
	//------------------------------------------------------
		
	void RobotCommRoomDoorSoundControl(const tString &in asTimer)
	{
		Map_AddTimer("RobotCommRoomDoorSoundControl", 0.05f, "RobotCommRoomDoorSoundControl");
		if(SlideDoor_GetOpenAmount("CommRoomDoor")<0.75f && Entity_IsActive("VentRobot"))
			{
				//Stops the robots animation sounds from conflicting with the door pound event, timer doesn't reset when door opens
				
				if(Sound_Exists("VentRobot_AnimEvent"))
				{
					Sound_Stop("VentRobot_AnimEvent", 0.05f);
				}
				
				if(Sound_Exists("VentRobot_VentRobot_Bark"))
				{
					Sound_Stop("VentRobot_VentRobot_Bark", 0.05f);
				}
				
				if(Sound_Exists("VentRobot_InvestigateStart"))
				{
					Sound_Stop("VentRobot_InvestigateStart", 0.05f);
				}
				
				if(Sound_Exists("VentRobot_InvestigateOver"))
				{
					Sound_Stop("VentRobot_InvestigateOver", 0.05f);
				}
				
				Music_Stop(5.0f, eMusicPrio_AgentAlert);
				Music_Stop(5.0f, eMusicPrio_AgentAmb);
				Music_Stop(5.0f, eMusicPrio_AgentHunt);
			}
			else if(Entity_IsActive("VentRobot")==false)
			{
				cLux_AddDebugMessage("Robot sound control disabled");
				Entity_SetActive("CommRoomRobotSoundControl", false);
				Map_RemoveTimer("RobotCommRoomDoorSoundControl");
			}
	}
	
	//-------------------------------------------------------
	
	void OnFlowWauFlowerDrained(const tString &in asEntity)
	{
		Seq_FlowWauFlowerDrained("");
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mFlowWauFlowerDrainedSequence;
		
	void Seq_FlowWauFlowerDrained(const tString &in asTimer)
	{
		Sequence_Begin("Seq_FlowWauFlowerDrained", mFlowWauFlowerDrainedSequence);
			
		if (Sequence_DoStepAndWait(3))
		{
			Entity_SetInteractionDisabled("ControlFlowLever", true);
		}
		else if (Sequence_DoStepAndWait(1))
		{
			OnChangeReactorControlFlowLever("ControlFlowLever", 1);
		}
		else
		{
			Entity_SetInteractionDisabled("ControlFlowLever", false);
		}
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	void SetHubFloorLighting(bool abState, bool abStaggerOn=false)
	{
		if (!abStaggerOn||abState==false)
		{
			Lamp_SetLit("HubRoomLamp_*", abState, false);
			Lamp_SetLit("MachineRoomLamp_Ceiling_*", abState, false);
			Lamp_SetLit("DeskLamp1", abState, false);
			Lamp_SetLit("MachineRoomLamp_Desk", abState, false);
			Lamp_SetLit("AssemblyLeverLamp", abState, false);
			Lamp_SetLit("MachineRoomLogTerminal", abState, false);
		}
		else
		{
			Map_AddTimer("HubRoomLamp_*", 0.1f, "TimerTurnOnLamp");
			Map_AddTimer("MachineRoomLamp_Ceiling_*", 0.5f, "TimerTurnOnLamp");
			Map_AddTimer("DeskLamp1", 1.0f, "TimerTurnOnLamp");
			Map_AddTimer("MachineRoomLamp_Desk", 1.0f, "TimerTurnOnLamp");
			Map_AddTimer("AssemblyLeverLamp", 1.5f, "TimerTurnOnLamp");
			Map_AddTimer("MachineRoomLogTerminal", 1.8f, "TimerTurnOnLamp");
		}
	}
	
	//-------------------------------------------------------
	
	void SetHubFloorPowerOn(bool abState)
	{
		mbReactorControlFlowPulled = !abState;
		mbThermalReactorActive = false;
		
		///////////////////////////
		// Lamps
		SetHubFloorLighting(abState);
		
		//////////////////////////
		// Reactor flow room effects
		Lamp_SetLit("01_02_reactor_flow_pipe_*", abState, false);
		Lamp_SetLit("lamp_reactor_flow", abState, false);
		Lamp_SetLit("reactor_flow_room_lamp_*", abState, false);
		Lamp_SetLit("reactor_flow_lever_lamp_*", abState, false);
		Entity_PlayAnimation("reactor_flow_fan", "switchoff", 1.0f, false, false);
		Entity_SetEffectsActive("ControlFlowLever", false, false);
		Entity_PlayAnimation("reactor_flow_control_fan", "switchoff", 1.0f, false, false);
		ParticleSystem_SetVisible("reactor_flow_steam_*", abState);
		LensFlare_SetVisible("reactor_flow_room_flare", abState);
		
		///////////////////////////
		// Reactor flow shutdown sounds
		Map_AddTimer("DuckStrong", 0.1f, "Audio_ConversationDucking");
		Map_AddTimer("Return6s", 3.5f, "Audio_ConversationDucking");
		Sound_Stop("storage_hum_*", 1.0f);
		Sound_Stop("storage_hum_*", 1.0f);
		Map_AddTimer("StopAmbientMusic", 1.0f, "AmbientMusicHandler");
		Sound_Stop("ThermalMachinery_Close", 0.5f);
		Sound_Stop("ThermalMachinery_Corridor", 0.5f);
		Entity_SetActive("ThermalEngineSoundStart", false);
		Entity_SetActive("ThermalDoorCollidor", false);
		Entity_SetActive("ConstructEncounterSweetner", true);
		Entity_SetActive("Trigger_CarlMixerArea", false);
		
		//////////////////////////
		// Electrics room lighting
		bool bElectricsLightsOn = MovingButton_IsSwitchedOn("ElectricsLightSwitch");
		Lamp_SetLit("ElectricsRoomLamp_*",abState && bElectricsLightsOn,true);
		Lamp_SetLit("WarningLightFuseRoom",!abState || !bElectricsLightsOn,true);
		Billboard_SetVisible("Billboard_8",!abState || !bElectricsLightsOn);
		Entity_SetEffectsActive("ElectricsLightSwitch", abState, false);
		
		//////////////////////////
		// Storage room lighting
		bool bStorageLightsOn = MovingButton_IsSwitchedOn("StorageLightSwitch");
		Lamp_SetLit("StorageRoomLamp_*",abState && bStorageLightsOn && mbStoragePowerOn,true);
		Entity_SetEffectsActive("StorageLightSwitch", abState, false);
		
		//////////////////////////
		// Machine room lighting
		Lamp_SetLit("warning_light_machine_room_*", abState, true);
		Entity_SetEffectsActive("warning_light_machine_room_*", true, true);
        Entity_PlayAnimation("warning_light_machine_room_*", "spin", 0.1f, true, false);
		Sound_Play("robot_spin_light", 1.0f);
		
		///////////////////////////
		// Flicker lamps
		Lamp_SetLit("MachineRoomLamp_Ceiling_4", true, false);
		Lamp_SetupFlicker("MachineRoomLamp_Ceiling_4", 0.05, 1, 0.025, 0.15);
		Lamp_SetFlickerActive("MachineRoomLamp_Ceiling_4", !abState);
		Lamp_SetLit("CorridorLamp_2", true, false);
		Lamp_SetFlickerActive("CommRoomLamp_2", !abState);
		Lamp_SetFlickerActive("CorridorLamp_3", !abState);
		Lamp_SetFlickerActive("CommRoomLamp_6", !abState);
		
		//////////////////////////////////
		// Emergency lighting
		Lamp_SetLit("EmergencyHubRoomLamp_*", true, false);
		
		/////////////////////////////////
		// Effects
		ParticleSystem_SetVisible("ParticleSystem_13", abState);
		ParticleSystem_SetVisible("ParticleSystem_57", abState);
		
		/////////////////////////////////
		// Interactions
		Entity_SetInteractionDisabled("DeskLamp1", !abState);
		Entity_SetInteractionDisabled("MachineRoomLamp_Desk", !abState);
		
		Terminal_SetGuiActive("WorkingMonitor_*", abState);
		
		/////////////////////////////////
		// Door buttons
		Button_SetDisabled("NorthDoorControl_1", !abState, false);
		Button_SetDisabled("NorthDoorControl_2", !abState, false);
		Button_SetDisabled("MachineRoomDoor_Control_2", !abState, false);
		Button_SetDisabled("MachineRoomDoor_Control_1", !abState, false);
		Button_SetDisabled("ElectricsDoor_Control_1", !abState, false);
		Button_SetDisabled("ElectricsDoor_Control_2", !abState, false);
		Button_SetDisabled("StorageDoor_Control_1", !abState, false);
		Button_SetDisabled("StorageDoor_Control_2", !abState, false);
		Button_SetDisabled("ReactorFlowDoorControl_1", !abState, false);
		Button_SetDisabled("ReactorFlowDoorControl_2", !abState, false);
			
		//////////////////////////////////////
		// Stop carl torture
		StopCarlTorture();
		Sound_Stop("CarlTortureLoop", 0.25f);
		Sound_Stop("CarlTortureStart", 0.25f);
		Music_FadeVolumeMul(1.0f, 6.0f);
		
		mbAmbientMusicAllowed = true;
		
		if (!abState)
		{
			RobotArmDeactivation();
			SlideDoor_SetClosed("slidedoor_medium_interlock_window_1", false, true);
			SlideDoor_SetClosed("NorthDoor", false, true);
			SlideDoor_SetClosed("ElectricsDoor", false, true);
			SlideDoor_SetClosed("StorageDoor", false, true);
			SlideDoor_SetClosed("ReactorFlowDoor", false);
			Button_SetSwitchedOn("MachineRoomDoor_Control_1", true, false);
			Button_SetSwitchedOn("NorthDoorControl_1", true, false);
			Button_SetSwitchedOn("ElectricsDoor_Control_1", true, false);
			Button_SetSwitchedOn("StorageDoor_Control_1", true, false);
			Button_SetSwitchedOn("ReactorFlowDoorControl_1", true, false);
			Entity_SetActive("CarlConstruct_Talk", false);
			KillCarl(false);
		}
		else
		{
			RobotArmActivation();
			Entity_SetActive("TriggerCarlCanSeePlayer", true);
			Entity_SetActive("TriggerCarlCanHearPlayer", true);
			Lamp_SetLit("CarlLamp", true, false);	
			Entity_SetActive("CarlConstruct_Talk", true);
			Entity_SetAnimationPaused("CarlConstruct", "idle", false);
			Entity_SetEffectsActive("CarlConstruct", true, false);
		}
	}
	
