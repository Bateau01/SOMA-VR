	//-------------------------------------------------------
		
	////////////////////////////
	// Run first time starting map
	void OnStart()
	{	
		//////Level Audio and Preloads	
		Player_SetClothing("default");
		Player_SetFootWear("default");
		Sound_PreloadProject("01_02_upsilon_inside_02");
		Sound_PreloadGroup("Flashback/Level/01_02", true);
		
		//Soften steam volume
		Sound_CreateAtEntity("SteamSoundLoopInitial", "01_02_upsilon_inside_02/sfx/valve_burst/valve_steam_loop", "SteamSoundSource_1", 0.0f, true, 1.0f);
		Map_AddTimer("Timer_LeverSoundStopLevelStart", 0.01f, "StopLeverSoundPhysicsLeverStart");
		Map_AddTimer("Timer_LeverTimerStop", 3.0f, "StopLeverSoundTimer");
		
		//////////////////////////////////////////
		// Specific setup functions
		SetupTunnels();
		SetupElectricDoors();
		SetupControlRoomPanel();
		SetupGeneratorRoom();
		SetupTransformerArea();
		SetupStairsArea();
		SetupHubRoom();
		SetupMachineRoom();
		KillMachineRoom();
		SetupCommRoom();
		
		//////////////////////////////////////////
		// Setup entities
		Tool_PickUp("CathTool", false, false); 
	
		//////////////////////////////////////////
		// Player setup
		Player_SetAmbientLight_Indoors();
		Player_SetMoveSpeedMul(1); //Set to 0 by preload in 1.1 for slow computers.
		PlayerHands_SetHandModel_Human();
		
		//////////////////////////////////////////
		// No flashlight until later on in the game
		Player_SetFlashlightDisabled(true);
		
		PlayerEnergy_SetFlowerSwallows(false);
		
		//////////////////////////////////////////
		// Begin game in tunnels
		Map_AddTimer("AmbientRumbleTimer", cMath_RandRectf(5.f, 30.f), "TimerTunnelAmbientRumble");
		
		//----DEBUG----//
		if(cLux_ScriptDebugOn())
		{
			Player_SetFlashlightDisabled(false);
			Player_SetStandDisabled(false);
			Effect_ToneMapping_FadeExposure(0,0.1f);
			Effect_DoF_Reset();
			
			//Effect_Fade_Out(0.0f);
			Map_AddTimer("TimerFadeInLevel",0.1f,"TimerFadeInLevel");
			Sound_Stop("SteamSoundLoopInitial", 0.0f);
		}
		else
		{	
		//	Effect_Fade_Out(0.0f);
			Map_AddTimer("TimerFadeInLevel",0.5f,"TimerFadeInLevel");
		}
		
		LastOnSoma_SetText("01_02_upsilon_inside_1");
		
		/////////////////////////
		// Eye tracking
		EyeTracking_RegisterEntity("AuxCarlID_Big", true, false, true, 15.0f, 4.0f);
		EyeTracking_RegisterEntity("JonsiTalkTo", true, false, true, 15.0f, 4.0f);
		EyeTracking_RegisterEntity("DatamineArea_FriedRobot", true, false, true, 15.0f, 4.0f);

		//////////////////////////////////
		// Exploration mode setup
		if (cLux_GetExplorationModeActive())
		{
			Entity_SetActive("CommRoomStairsRepelArea", true);
		}
	}
	
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	    // Visual-only initialization also runs after save loading, which can skip OnEnter.
    void EnsureVRTraversalIA()
    {
        if(mVRTraversalHY.mvPoints.length()!=0)return;
        mVRTraversalHY.Add("LadderArea_1",cVector3f(0.1016297f,-0.7205733f,0.0314772f),cVector3f(0.0000000f,1.0000000f,0.0000000f),cVector3f(-0.0000000f,0.0119065f,0.9999291f));

        mVRTraversalHY.Add("LadderArea_1",cVector3f(-0.3812347f,2.4596367f,-0.1695345f),cVector3f(0.0000000f,0.0000000f,-1.0000000f),cVector3f(0.3776376f,0.8701023f,0.3167205f));

        mVRTraversalHY.Add("HatchClimb_2",cVector3f(0.253841f,-0.014486f,-0.176838f),cVector3f(0.000000f,0.000000f,-1.000000f),cVector3f(0.000000f,1.000000f,0.000000f),"hatch_1");

    }

void OnEnter()
	{
        mVRTraversalHY.Dispose();EnsureVRTraversalIA();
        
        
        

		MainMenu_SetBGPhase(eMainMenuPhase_Initial_To_1_3);	
	}
	
	//-------------------------------------------------------
	
	void TimerFadeInLevel(const tString&in asTimer)
	{ 
		//Disabled as transitions from 1.1
	//	cLux_AddDebugMessage("Fade in!");
	//	Effect_Fade_In(3.0f);
	//	Sound_FadeGlobalVolume(1.0f, 1.5f, eSoundEntryType_All);
		mbLeversInit = true;
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
        mVRTraversalHY.Dispose();
	}
	
	//-------------------------------------------------------
	
	void Update(float afTimeStep)
	{
        EnsureVRTraversalIA();mVRTraversalHY.Update(afTimeStep);	
		////////////////////////////
		// React to Carl on gaze
		if (EyeTracking_IsEnvironmentReactive() && EyeTracking_IsEntityBeingLookedAt("AuxCarlID_Big") && mbReactedToCarlBody == false)
		{
			if (mbCarlBodyReactTimer <= 1.0f)
				mbCarlBodyReactTimer += afTimeStep;
			else
				CarlBodyReaction();
		}
		
		////////////////////////////
		// Increase Jonsi distortion on gaze
		if (EyeTracking_IsEnvironmentReactive() && EyeTracking_IsEntityBeingLookedAt("JonsiTalkTo") && mbJonsiGaze == false)
		{
			mbJonsiGaze = true;
			cScript_SetGlobalArgFloat(0, 0.2f);
			cScript_RunGlobalFunc("JonsiDistortion", "cScrAreaDistortion", "_Global_SetAddedDistortionAmount");
		}
		if (mbJonsiGaze && (EyeTracking_IsEntityBeingLookedAt("JonsiTalkTo") == false || EyeTracking_IsEnvironmentReactive() == false))
		{
			mbJonsiGaze = false;
			cScript_SetGlobalArgFloat(0, 0.0f);
			cScript_RunGlobalFunc("JonsiDistortion", "cScrAreaDistortion", "_Global_SetAddedDistortionAmount");
		}
	}
	
