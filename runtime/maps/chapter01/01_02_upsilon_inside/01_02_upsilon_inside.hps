	/////////////////////////////////////////
	// AUDIO
	/////////////////////////////////////////
	
	//---------------------------------------------------------------------

	/**
	*Simple ambient music player that fades the ambience randomly whilst playing to stop it from getting repetitive
	**/
	
	bool mbAmbientMusicPlaying = false;
	bool mbAmbientMusicSecondStage = false;
	bool mbAmbientMusicAllowed = true;
	float gfAmbientMusicMul = 1.0f;
	
	void AmbientMusicHandler(const tString &in asTimer)
	{		
		if (asTimer=="StartAmbient" && mbAmbientMusicPlaying==false && mbAmbientMusicAllowed==true)
		{
			if(mbAmbientMusicSecondStage==false)
			{
				Music_PlayExt(gsUpsilonMusicStage1, true, 0.65f, 1.0f, cMath_RandRectf(3.f,5.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			else if(mbAmbientMusicSecondStage==true)
			{
				Music_PlayExt(gsUpsilonMusicStage2, true, 0.65f, 1.0f, cMath_RandRectf(3.f,5.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			
			cLux_AddDebugMessage("Ambient music triggering");
			
			mbAmbientMusicPlaying = true;
			
			//Dynamic fades
			Map_AddTimer("RandomFadeRider", cMath_RandRectf(10.f,20.f), "AmbientMusicHandler");
			Map_AddTimer("FadeOut", cMath_RandRectf(120.f,180.f), "AmbientMusicHandler");
			Map_RemoveTimer("StopAmbientMusic");
			Map_RemoveTimer("StopAmbientMusicQuickly");
		}
		
		else if (asTimer=="StartAmbient" && mbAmbientMusicPlaying==false && mbAmbientMusicAllowed==false)
		{
			Map_AddTimer("StartAmbient", cMath_RandRectf(10.f,20.f), "AmbientMusicHandler");
		}
		
		else if (asTimer=="StopAmbientMusic" && mbAmbientMusicPlaying==true)
		{
			Music_Stop(4.5f, eMusicPrio_BgAmb);
			Map_RemoveTimer("RandomFadeRider");
			Map_RemoveTimer("FadeOut");
			Map_RemoveTimer("StartAmbient");
			Music_FadeVolumeMul(1.0f,1.0f);
			mbAmbientMusicPlaying = false;
		}
		else if (asTimer=="StopAmbientMusicQuickly" && mbAmbientMusicPlaying==true)
		{
			cLux_AddDebugMessage("Stop Ambient Music Quickly Triggered");
			Music_Stop(1.5f, eMusicPrio_BgAmb);
			Map_RemoveTimer("StartAmbient");
			Map_RemoveTimer("RandomFadeRider");
			Map_RemoveTimer("FadeOut");
			Music_FadeVolumeMul(1.0f,1.0f);
			mbAmbientMusicPlaying = false;
		}
		
		else if(asTimer=="RandomFadeRider")
		{
			if(mbAmbientMusicSecondStage==false)
			{
				Music_PlayExt(gsUpsilonMusicStage1, true, 0.5f*gfAmbientMusicMul, 1.0f, cMath_RandRectf(5.f,8.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			else if(mbAmbientMusicSecondStage==true)
			{
				Music_PlayExt(gsUpsilonMusicStage2, true, 0.5f*gfAmbientMusicMul, 1.0f, cMath_RandRectf(5.f,8.f), 0.0f, eMusicPrio_BgAmb, true);
			}
			
			cLux_AddDebugMessage("Ambient Music Fading");
			gfAmbientMusicMul = cMath_RandRectf(0.35f, 1.2f);
			Map_AddTimer("RandomFadeRider", cMath_RandRectf(10.f,15.f), "AmbientMusicHandler");
		}
		
		else if(asTimer=="FadeOut")
		{	
			cLux_AddDebugMessage("Ambient Music Fading Out");
			Music_Stop(cMath_RandRectf(8.f,12.f), eMusicPrio_BgAmb);
			mbAmbientMusicPlaying = false;
			
			Map_RemoveTimer("RandomFadeRider");
			Map_AddTimer("StartAmbient", cMath_RandRectf(120.f,180.f), "AmbientMusicHandler");
		}
		
		cLux_AddDebugMessage("Ambient Music Playing is "+mbAmbientMusicPlaying);
	}
		
	//--------------------------------------------------------------------	
	
	///////////////////////////////////////
	// Small vent tremor
	
	bool mbVentTremorActive = false;
	bool mbVentTremorCooldown = false;
	bool VentTremorTrigger(const tString &in asParent, const tString &in asChild, int alState)
	{
		Map_AddTimer("VentTremorCooldown", cMath_RandRectf(12.0f, 16.0f), "VentTremorCooldown");
		Sound_CreateAtEntity("VentTremorLoop", "01_02_upsilon_inside_02/sfx/vent/loop", "Player", 3.0f, true);
		cLux_AddDebugMessage("Vent tremor loop start");
		
		mbVentTremorActive = true;
		return false;
	}


	bool VentTremorKillTrigger(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(mbVentTremorActive==true)
		{
			StopVentTremor();
		}
		return false;
	}

	void VentTremorCooldown(const tString &in asTimer)
	{
		mbVentTremorCooldown = true;
		cLux_AddDebugMessage("Tremor cooldown "+mbVentTremorCooldown);
	}

	void StopActiveVentTremor()
	{
		if(mbVentTremorActive == true && mbVentTremorCooldown == true)
		{
			StopVentTremor();
		}
	}

	void StopVentTremor()
	{
        if(Sound_Exists("VentTremorLoop"))
        {
            Sound_Stop("VentTremorLoop", 4.0f);
            mbVentTremorActive = false;
        }
        Map_RemoveTimer("AmbientRumbleTimer");
		cLux_AddDebugMessage("Stop tremor");
	}
			
	//--------------------------------------------------------------------	
	
	///////////////////////////////////////
	//Control Room Gloop Spot Control (in vents)
	bool mbVentGloopProximity = false;
	bool Trigger_VentControlRoomProximity(const tString &in asParent, const tString &in asChild, int alState)
	{
		Map_AddTimer("ControlRoomGloopControl", 1.0f, "ControlRoomGloopControl");
		if(alState==1)
		{
			mbVentGloopProximity = true;
		}
		else
		{
			mbVentGloopProximity = false;
		}
		cLux_AddDebugMessage("Gloop proximity is "+mbVentGloopProximity);
		return true;
	}
			
	//--------------------------------------------------------------------	
	
	bool CollideSteamSoundControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Map_AddTimer("SteamSoundControl", 0.05, "StairwellSteamSoundControl");
		}
		else
		{
			Map_RemoveTimer("SteamSoundControl");
		}
		return true;
	}
	
	void StairwellSteamSoundControl(const tString &in asTimer)
	{
		if(Sound_Exists("SteamSoundLoopInitial") && SlideDoor_GetOpenAmount("StairsDoor")<0.6f)
		{
			Sound_Fade("SteamSoundLoopInitial", 0.0f, 1.0f);
			Map_AddTimer("SteamSoundControl", 0.05, "StairwellSteamSoundControl");
		}
		
		else if(Sound_Exists("SteamSoundLoopInitial") && SlideDoor_GetOpenAmount("StairsDoor")>0.6f && mbLowerSoundsActive==true)
		{
			Sound_Fade("SteamSoundLoopInitial", 1.0f, 3.0f);
			Map_AddTimer("SteamSoundControl", 0.05, "StairwellSteamSoundControl");
		}
		
		else if(Sound_Exists("SteamSoundLoopInitial"))
		{
			Map_AddTimer("SteamSoundControl", 0.05, "StairwellSteamSoundControl");
		}
	}
		
	//--------------------------------------------------------------------	
	
	bool Trigger_SlideDoorCloseFast(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Sound_CreateAtEntity("SlideDoorCloseFast", "Entities_Station/doors/vertical_door/fast_open_stop", "SlideDoorCloseFastTrigger");
			Entity_SetActive("SlideDoorCloseFastTrigger", false);
		}
		return true;
	}
	
	bool mbControlRoomSting = false;
	bool mbControlRoomGloopActive = false;
	void ControlRoomGloopControl(const tString &in asTimer)
	{
		Map_AddTimer("ControlRoomGloopControl", 1.5f, "ControlRoomGloopControl");

		if (Button_IsSwitchedOn("hatch_1_button_1") && mbVentGloopProximity == true)
		{
			if(mbControlRoomSting==false)
			{
				Map_AddTimer("ControlRoomSting", 1.0f, "ControlRoomSting");
				mbControlRoomSting = true;
			}
			Entity_SetActive("AMB_VentSpace_LargeVerb", true);
			Sound_Play("control_spot_gloop_*", 1.0f);
		}
		else if (Button_IsSwitchedOn("hatch_1_button_1") == false && mbVentGloopProximity == true)
		{
			Entity_SetActive("AMB_VentSpace_LargeVerb", false);
			Sound_Stop("control_spot_gloop_*", 1.0f);
		}
	}
			
	//--------------------------------------------------------------------	
	
	///////////////////////////////////////
	//Control room steam control
	bool Trigger_ControlRoomSteamControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbStairwellSteamBurst) return true;
		
		if(alState==1)
		{
			Sound_Stop("SteamSoundLoopInitial", 1.0f);
			cLux_AddDebugMessage("Stopping Steam sound from leaking through");
		}
		else
		{
			Sound_CreateAtEntity("SteamSoundLoopInitial", "01_02_upsilon_inside_02/sfx/valve_burst/valve_steam_loop", "SteamSoundSource_1", 0.0f, true, 1.0f);
			cLux_AddDebugMessage("starting steam sound again");
		}
		return true;
	}
			
