	{
		Player_SetCrouching(false);
		//CloseHatch();
		return false;
	}

	//-------------------------------------------------------

	bool mbInTunnels = true;
	
	//-------------------------------------------------------
	
	bool Doorway_Hatch(const tString &in asArea, const tString &in asEntity, int alState)
	{
		mbInTunnels = (alState==-1);
		
		Entity_SetActive("HatchClimb_2", !mbInTunnels);
		Player_SetJumpDisabled(mbInTunnels);
			
		/////////////////////////////////////////////////////////////////////////////////////////////////
		// Sets the ambience the station or the tunnels when player leaves or enters tunnels
		if (alState == 1)
		{
			cLux_AddDebugMessage("Left tunnels");
			/////////////////////////////
			//Stop ventilation music and add timer to trigger control room music
			Music_Stop(3.0f, eMusicPrio_BgAmb);
			Map_RemoveTimer("AmbientRumbleTimer");
            StopVentTremor();
		}
		else
		{
			cLux_AddDebugMessage("Entered tunnels");
			Music_Stop(3.f, eMusicPrio_BgAmb);
		
			Map_AddTimer("AmbientRumbleTimer", cMath_RandRectf(5.f, 30.f), "TimerTunnelAmbientRumble");
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	bool Trigger_StartAutosave(const tString &in asParent, const tString &in asChild, int alState)
	{
		Game_AutoSave();
		return false;
	}
	
