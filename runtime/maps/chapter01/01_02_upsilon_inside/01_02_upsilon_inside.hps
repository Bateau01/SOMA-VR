	{
		if (abStartOfSubject)
			return;
			
		cLux_AddDebugMessage("End of pause");
		SequenceStates_Resume("SequenceCommRoomDialog");
		//Music_PlayExt("01_02_radiocontact.ogg", false, 0.35, 1, 2, 0, eMusicPrio_BigEvent, false);
	}
	
