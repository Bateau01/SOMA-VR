	bool CollideRobotSpawnSparks(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState != 1) return true;
		
		//ParticleSystem_CreateAtEntityExt(asParent+"spark", "elec_spark_oneshot.ps", asParent, true, cColor(1,0.628,0.047,0.682),  50.0f);
