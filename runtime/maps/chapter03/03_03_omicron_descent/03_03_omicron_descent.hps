	//-------------------------------------------------------
	
	void OnGuiElevatorStart(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("03_03_omicron_descent");
		
		ImGui_GroupBegin(cVector3f_Zero, ImGui_GetSize());
		
		cImGuiLabelData label;
		label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Medium));
		label.mFont.mvSize = cVector2f(50, 50);
		label.mFontAlign = eFontAlign_Center;

		ImGui_SetModColorMul(gStationGuiColor_Highlight);
		ImGui_DoLabelExt("GUIStartKnob1", label, 	ImGui_NrmPos( cVector3f(0.0f, 0.00f, 0)), 
											ImGui_NrmSize( cVector2f(1.0f,0.2f) ),1.0f); 
		ImGui_SetModColorMul(gStationGuiColor_Normal);
		ImGui_DoLabelExt("GUIStartKnob1_"+mlKnob1State, label, 	ImGui_NrmPos( cVector3f(0.0f, 0.09f, 0)), 
											ImGui_NrmSize( cVector2f(1.0f,0.2f) ),1.0f); 
										
		ImGui_SetModColorMul(gStationGuiColor_Highlight);
		ImGui_DoLabelExt("GUIStartKnob2", label, 	ImGui_NrmPos( cVector3f(0.0f, 0.35f, 0)), 
											ImGui_NrmSize( cVector2f(1.0f,0.2f) ),1.0f); 
		ImGui_SetModColorMul(gStationGuiColor_Normal);
		ImGui_DoLabelExt("GUIStartKnob2_"+mlKnob2State, label, 	ImGui_NrmPos( cVector3f(0.0f, 0.44f, 0)), 
											ImGui_NrmSize( cVector2f(1.0f,0.2f) ),1.0f); 
											
		ImGui_ResetModifiers();
		
		ImGui_GroupEnd();
	}

	//-------------------------------------------------------

	/////////////////////////////////////////
	// Elevator Terminal
	/////////////////////////////////////////

	//-------------------------------------------------------

	void OnGuiElevator(const tString&in asEntityName, float afTimeStep)
	{
		cImGuiLabelData label;
		label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Medium));
		label.mFont.mvSize = cVector2f(80, 80);
		
		ImGui_SetTransCategory("03_03_omicron_descent");
		
		StationGuiBG_Scanlines();
		
		ImGui_GroupBegin(cVector3f_Zero, ImGui_GetSize());
		if (mlProbe!=0) // If a probe is in range...
		{
			iLuxEntity@ pProbe = Map_GetEntity("Probe"+mlProbe);
			float fProbeDist = cMath_Abs(pProbe.GetVarFloat("ProbeDist")-gfProbeMaxRange);
			
			tString sDist = ""+fProbeDist;
			int lDotPos = cString_GetLastCharPos(sDist, '.');
			sDist = cString_Sub(sDist, 0, lDotPos+3);
			
			tWString sProbeDist = cResources_Translate("03_03_omicron_descent", "ElevGUI_ProbeDist");
			sProbeDist = cString_ReplaceStringToW(sProbeDist, tWString("%f"), tWString(sDist));
	
			///////////////////
			// Background
			ImGui_DoImage(cImGuiGfx("03_03_zone"+mlOceanZone+".dds", eImGuiGfx_Texture), 
				ImGui_NrmPosGroup(cVector3f_Zero), ImGui_NrmSizeGroup(cVector2f(1.0f,1.0f)) );
					
			if (fProbeDist<gfProbeDisplayRange|| (mfProbeImageTimer>0.0f && mfProbeImageTimer<=2.5f) )
			{
				mfProbeImageTimer+=afTimeStep;
				float fX = 0.0f;
				if ( (mfProbeImageTimer>2.5f) && (fProbeDist<gfProbeDisplayRange) )
				{
					mfProbeImageTimer = 0.0f;
					mlProbeImage++;
					if (mlProbeImage == 4)
						mlProbeImage = 1;
				}
				
				///////////////////
				// Probe Image
				ImGui_DoImage(cImGuiGfx("03_03_probe"+mlProbe+"_"+mlProbeImage+".dds", eImGuiGfx_Texture), 
					ImGui_NrmPosGroup(cVector3f(fX,0.0f,0.1f)), ImGui_NrmSizeGroup(cVector2f_One));
			}
					
			/////////////////////////
			// Probe title
			ImGui_DoLabelExt("ElevGUI_Probe", label, cVector3f(40.0f,120.0f,1.0f), cVector2f_MinusOne, 0.8f);
			
			/////////////////////////
			// Probe distance
			ImGui_SetTextOverride(sProbeDist);
			ImGui_DoLabelExt("", label, cVector3f(40.0f,190.0f,1.0f), cVector2f_MinusOne, 0.8f);
		}
		else // Otherwise show the current zone
		{
			///////////////////
			// Background
			ImGui_DoImage(cImGuiGfx("03_03_zone"+mlOceanZone+".dds", eImGuiGfx_Texture), 
				ImGui_NrmPosGroup(cVector3f_Zero), ImGui_NrmSizeGroup(cVector2f(1.0f,1.0f)) );
				
			///////////////////
			// Info overlay
			ImGui_DoImage(cImGuiGfx("03_03_zone"+mlOceanZone+"_info.dds", eImGuiGfx_Texture), 
				ImGui_NrmPosGroup(cVector3f(0.02f,0.02f,1.0f)), ImGui_NrmSizeGroup(cVector2f(0.96f,0.96f) ) );
			
			for (int lZone=0;lZone<=4;lZone++)
			{
				float fScale = 0.8f;
				if (lZone!=mlOceanZone)
					fScale = 0.5f;
					
				cVector2f vPos;
				if (mlOceanZone<lZone)
					vPos = gvZoneGuiDataBottom[lZone];
				else
					vPos = gvZoneGuiDataTop[lZone];
				
				///////////////////
				// Title
				ImGui_DoLabelExt("ElevGUI_ZoneTitle"+lZone, label, cVector3f(vPos.x+10.0f,vPos.y,1.0f), cVector2f_MinusOne, fScale);
				
				///////////////////
				// Subtitle
				ImGui_DoLabelExt("ElevGUI_ZoneSubtitle"+lZone, label, cVector3f(vPos.x+10.0f,vPos.y+80.0f*fScale,1.0f), cVector2f_MinusOne, 0.7f*fScale);
				
				if (lZone==mlOceanZone)
				{
					///////////////////
					// Body Text
					cImGuiTextFrameData frame;
					frame.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Medium));
					frame.mFont.mvSize = cVector2f(80*fScale, 80*fScale);
					frame.mbUseBackgroundGfx = false;
					
					ImGui_DoTextFrameExt("ElevGUI_ZoneInfo"+lZone, cVector2f(10.0f,10.0f), 5.0f, 0.0f,
						frame, cVector3f(vPos.x,vPos.y+130.0f,1.0f), cVector2f(879.0f,900.0f));
				}
			}
		}

		
		ImGui_GroupEnd();
	}

	//-------------------------------------------------------

	/////////////////////////////////////////
	// Depth Display Terminal
	/////////////////////////////////////////

	//-------------------------------------------------------

	void OnGuiDepth(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("03_03_omicron_descent");
		
		cImGuiLabelData label;
		label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Medium));
		label.mFont.mvSize = cVector2f(32, 32);
		
		StationGuiBG_Scanlines();
		
		ImGui_GroupBegin(cVector3f_Zero, ImGui_GetSize());
		
		///////////////////
		// Background
		ImGui_DoImage(cImGuiGfx("03_03_depth.dds", eImGuiGfx_Texture), 
			ImGui_NrmPosGroup(cVector3f_Zero), ImGui_NrmSizeGroupKeepRatio(cVector2f_One));
		
		///////////////////
		// Lift Wire
		cColor cableColor = cColor(0.5f,0.5f,0.5f, 0.5f);
		ImGui_DrawLine(ImGui_NrmSizeGroup(cVector2f(0.5f,0.0f)), ImGui_NrmSizeGroup(cVector2f(0.5f,1.0f)), 0.5f, 1.0f, cableColor);
		
		///////////////////
		// Lift
		float fProgress = (mfElevatorDepth+gfDepthDisplayStart)/gfDepthDisplayHeight; 
		
		cImGuiGfx imLift("03_03_elevator.dds", eImGuiGfx_Texture);
		ImGui_DoImage(imLift, ImGui_NrmPosGroup(cVector3f(0.5f,fProgress+0.025f,1.0f)) - cVector3f(8.0f,16.0f,0.0f), cVector2f(16.0f,32.0f));
			
		/////////////////
		// Probes
		float fProbe1 = (gfProbe1Depth+gfDepthDisplayStart)/gfDepthDisplayHeight; 
		float fProbe2 = (gfProbe2Depth+gfDepthDisplayStart)/gfDepthDisplayHeight; 
		float fProbe3 = (gfProbe3Depth+gfDepthDisplayStart)/gfDepthDisplayHeight; 
		
		cColor probeLineColor = cColor(0.5f,0.0f,0.0f);
		ImGui_DrawLine(ImGui_NrmSizeGroup(cVector2f(0.0f,fProbe1)), ImGui_NrmSizeGroup(cVector2f(1.0f,fProbe1)), 0.5f, 1.0f, probeLineColor);
		ImGui_DrawLine(ImGui_NrmSizeGroup(cVector2f(0.0f,fProbe2)), ImGui_NrmSizeGroup(cVector2f(1.0f,fProbe2)), 0.5f, 1.0f, probeLineColor);
		ImGui_DrawLine(ImGui_NrmSizeGroup(cVector2f(0.0f,fProbe3)), ImGui_NrmSizeGroup(cVector2f(1.0f,fProbe3)), 0.5f, 1.0f, probeLineColor);
		
		cImGuiGfx imProbe("03_03_probe.dds", eImGuiGfx_Texture);
		ImGui_SetModColorMul(cColor(1.0f,0.25f,0.25f));
		ImGui_DoImage(imProbe, ImGui_NrmPosGroup(cVector3f(0.25f,fProbe1,1.0f)) - cVector3f(16.0f,16.0f,0.0f), cVector2f(32.0f,32.0f));
		ImGui_DoImage(imProbe, ImGui_NrmPosGroup(cVector3f(0.25f,fProbe2,1.0f)) - cVector3f(16.0f,16.0f,0.0f), cVector2f(32.0f,32.0f));
		ImGui_DoImage(imProbe, ImGui_NrmPosGroup(cVector3f(0.25f,fProbe3,1.0f)) - cVector3f(16.0f,16.0f,0.0f), cVector2f(32.0f,32.0f));
		ImGui_ResetModifiers();
		
		/////////////////
		// Zones
		float fZone1 = (gfZone1+gfDepthDisplayStart)/gfDepthDisplayHeight; 
		float fZone2 = (gfZone2+gfDepthDisplayStart)/gfDepthDisplayHeight; 
		float fZone3 = (gfZone3+gfDepthDisplayStart)/gfDepthDisplayHeight; 
		
		cColor zoneLineColor = cColor(0.25f,0.25f,1.0f);
		ImGui_DrawLine(ImGui_NrmSizeGroup(cVector2f(0.0f,fZone1)), ImGui_NrmSizeGroup(cVector2f(1.0f,fZone1)), 0.5f, 1.0f, zoneLineColor);
		ImGui_DrawLine(ImGui_NrmSizeGroup(cVector2f(0.0f,fZone2)), ImGui_NrmSizeGroup(cVector2f(1.0f,fZone2)), 0.5f, 1.0f, zoneLineColor);
		ImGui_DrawLine(ImGui_NrmSizeGroup(cVector2f(0.0f,fZone3)), ImGui_NrmSizeGroup(cVector2f(1.0f,fZone3)), 0.5f, 1.0f, zoneLineColor);
		
		/////////////////
		// Ground
		cColor groundLineColor = cColor(0.5f,1.0f,0.0f);
		float fGroundLine = (gfStationDepth+gfDepthDisplayStart)/gfDepthDisplayHeight+0.025f;
		ImGui_DrawLine(ImGui_NrmSizeGroup(cVector2f(0.0f,fGroundLine)), ImGui_NrmSizeGroup(cVector2f(1.0f,fGroundLine)), 0.5f, 1.0f, groundLineColor);
		
		///////////////////
		// Display
		float fDepth = mfElevatorDepth+gfDepthDisplayStart;
		
		tString sDepth = ""+fDepth;
		int lDotPos = cString_GetLastCharPos(sDepth, '.');
		sDepth = cString_Sub(sDepth, 0, lDotPos+3);
		
		float fPressure = ((1000.0f*9.81f*fDepth)/101300.0f)+1.0f;	// Atmospheres
		tString sPressure = ""+fPressure;
		lDotPos = cString_GetLastCharPos(sPressure, '.');
		sPressure = cString_Sub(sPressure, 0, lDotPos+3);
		
		tString sSpeed = ""+mfElevatorSpeed;
		lDotPos = cString_GetLastCharPos(sSpeed, '.');
		sSpeed = cString_Sub(sSpeed, 0, lDotPos+3);
				
		tWString sDepthLabel = ImGui_Translate("DepthGUI_Depth");
		ImGui_ResizeFontToFit(sDepthLabel, label.mFont, ImGui_GetCurrentGroupSize().x-100);
		sDepthLabel = cString_ReplaceStringToW(sDepthLabel, tWString("%f"), tWString(sDepth));
				
		tWString sPressureLabel = ImGui_Translate("DepthGUI_Pressure");
		ImGui_ResizeFontToFit(sPressureLabel, label.mFont, ImGui_GetCurrentGroupSize().x-100);
		sPressureLabel = cString_ReplaceStringToW(sPressureLabel, tWString("%f"), tWString(sPressure));
		
		tWString sSpeedLabel = ImGui_Translate("DepthGUI_Speed");
		ImGui_ResizeFontToFit(sSpeedLabel, label.mFont, ImGui_GetCurrentGroupSize().x-100);
		sSpeedLabel = cString_ReplaceStringToW(sSpeedLabel, tWString("%f"), tWString(sSpeed));
		
		ImGui_SetTransCategory("");
		
		ImGui_SetTextOverride(sDepthLabel);
		ImGui_DoLabelExt("", label, ImGui_NrmPosGroup(cVector3f(0.1f,0.82f,0.0f)), 
			cVector2f_MinusOne, 1);
		ImGui_SetTextOverride(sPressureLabel);
		ImGui_DoLabelExt("", label, ImGui_NrmPosGroup(cVector3f(0.1f,0.87f,0.0f)), 
			cVector2f_MinusOne, 1);
		ImGui_SetTextOverride(sSpeedLabel);
		ImGui_DoLabelExt("", label, ImGui_NrmPosGroup(cVector3f(0.1f,0.92f,0.0f)), 
			cVector2f_MinusOne, 1);
		ImGui_ClearTextOverride();
		
		ImGui_GroupEnd();
	}

	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// ==============
	// AUDIO
	// ==============
	/////////////////////////////////////////

	//-------------------------------------------------------
	//Elevator Audio
	//-------------------------------------------------------
	bool mbElevatorMusicConversation = false;
	void ElevatorAudio_Start()
	{
		mbIsElevatorAudioRunning = true;

		if(mbElevatorMusicConversation==false)
		{
			Map_AddTimer("ConversationMusic", 1.0f, "ConversationMusic");
			mbElevatorMusicConversation = true;
		}
		
		Sound_CreateAtEntity("ElevatorAudio_Startup", "03_03_omicron_descent/SFX/elevator/motor_start", "Player", 0.0f, false, 1.0f);
		Sound_CreateAtEntity("ElevatorAudio_MotorLoop", "03_03_omicron_descent/SFX/elevator/motor_loop", "Player", 3.5f, true, 1.0f);
				
		Sound_Stop("ElevatorAudioStop_BackgroundAmbience", 5.0f);		
		Sound_CreateAtEntity("ElevatorAudio_BackgroundAmbience", "level_amb_shared_underwater/amb/background/industrial_plain", "Player", 3.0f, false, 0.75f);
		
		Sound_Stop("ElevatorAudioStop_BackgroundAmbience", 3.0f);
		
		Entity_SetActive("AMB_OnElevator", false);
		Entity_SetActive("AMB_InElevator", false);
		Entity_SetActive("Trigger_CableSwingSound", false);
		
		Map_AddTimer("ElevatorAudioDescentBeep", 5.0f, "ElevatorAudio");
		Map_AddTimer("ElevatorAudioDescentCreaks_Stage1", 10.0f, "ElevatorAudio");
	}
	
	void ConversationMusic(const tString &in asTimer)
	{
		Music_Play("03_03_conversation", 0.85f, false, eMusicPrio_SceneAmb);
	}

	//-------------------------------------------------------
	
	void ElevatorAudio_Stop(float afFadeTime=0.25f, bool abHaltSound = false)
	{
		mbIsElevatorAudioRunning = false;
		Sound_Stop("ElevatorAudio_MotorLoop", afFadeTime);
		Sound_Stop("ElevatorAudio_BackgroundAmbience", afFadeTime);
		Sound_Stop("DescentBeep", 0.0f);
		Sound_Stop("ElevatorAudio_Creak", afFadeTime);
		
		if(abHaltSound == true)
		{
			Sound_CreateAtEntity("ElevatorAudioStop_BackgroundAmbience", "level_amb_shared_underwater/amb/background/interior_abandoned_medium", "Player", 3.0f, false, 0.75f);
			Sound_PlayGui("03_03_omicron_descent/SFX/elevator/motor_halt_stop", 1.0f);
			Entity_SetActive("AMB_OnElevator", true);
			Entity_SetActive("AMB_InElevator", true);
			Entity_SetActive("Trigger_CableSwingSound", true);
			Music_Stop(0.25f, eMusicPrio_SceneAmb);
			Music_Stop(0.5f, eMusicPrio_BgAmb);
		}
	}

