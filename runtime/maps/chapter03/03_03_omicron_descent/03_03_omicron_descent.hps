	//-------------------------------------------------------

	bool mbElevatorRunning = false;
	bool mbInElevator = false;
	bool mbOnElevator = false;
	bool mbSuppressSway = false;
	bool mbBlackoutHappened = false;
	
	float mfElevatorStartY = 0.0f;
	cVector3f mvElevatorStartPos;
	float mfElevatorLoopY = 0.0f;
	
	float mfElevatorSpeed = 0.0f;
	float mfElevatorAccel = 0.0f;
	float mfElevatorTargetSpeed = 0.0f;
	float mfElevatorDepth = 0.0f;		// Virtual position inc loops
	float mfElevatorPrevDepth = 0.0f;
	
	float mfPressure = 0.0f;
	
	int mlElevatorLoop = -1;
	bool mbSeatsCanBeInteractedWith = true;
	//-------------------------------------------------------

	void SetupElevator()
	{
		mbFloodLightsOn = false;
		mbElevatorRunning = false;
		mfElevatorAccel = 0.0f;
		mvElevatorStartPos = Map_GetEntity("Elevator").GetPosition();
		mfElevatorStartY = mvElevatorStartPos.y;
		mfElevatorLoopY = Map_GetEntity("LoopPoint").GetPosition().y;
		mlElevatorLoop = -1;
		
		Button_SetSwitchedOn("LiftExitPanel",false,false);
		Button_SetDisabled("LiftExitPanel",true);
		
		Entity_AttachToEntity("DescentCameraAnim*", "Elevator", "", false, false);
		Entity_AttachToEntity("SeatCameraAnim*", "Elevator", "", false, false);
		Entity_AttachToEntity("SeatInteract*", "Elevator", "", false, false);
		
		Entity_SetActive("ElevatorCableLoopPoint",true);
		Entity_SetActive("ElevatorCableLoopStart*",false);
		
		ParticleSystem_SetVisible("Elevator_ParticleSystem_1",false);
		ParticleSystem_SetActive("Elevator_ParticleSystem_1", false);
		
		//////////////////////////////
		// Fix up loop objects
		for (int i=0;i<glElevatorNumLoops*2;++i)
		{
			iLuxEntity@ pLoopEntity = Map_GetEntity("Loop"+i);
			
			if (pLoopEntity==null)
			{
				Error("Missing loop entity for elevator loop: Loop"+i);
				continue;
			}
	
			// Make sure entities are attached
			Entity_AttachToEntity("Loop"+i+"_*", "Loop"+i, "", false, false);
			
			// Don't need these active in level
			SetLoopActive(i, false);
		}
		
		/////////////////////////////////////
		// Set up restraints
		for (int i=1;i<=5;++i)
		{
			Entity_PlayAnimation("seat_restraint_"+i, "chair_03_03_idle_up_restraint",0.0f,true,false,"");
			Entity_SetVarBool("seat_restraint_"+i, "SeatState", false);
			Entity_SetActive("SeatInteract"+i,true);
		}
		Entity_PlayAnimation("seat_restraint_6", "chair_03_03_idle_restraint",0.0f,true,false,"");
		Entity_SetActive("SeatInteract6",false);
		Entity_SetVarBool("seat_restraint_6", "SeatState", true);
		
		////////////////////////////////////
		// Turn off spots
		Lamp_SetLit("CageSpot*", false, false);
		
		////////////////////////////////////
		// Make sure first part of the loop is active
		Entity_SetActive("LoopStart",true);
	}

	//-------------------------------------------------------
	
	void FadeElevatorSpeed(float afTargetSpeed, float afAccel)
	{
		mfElevatorTargetSpeed = afTargetSpeed;
		mfElevatorAccel = afAccel;
	}
	
	//-------------------------------------------------------
	
	float mfSwayTimer = 0.0f;
	
	void UpdateElevator(float afTimeStep)
	{
		/////////////////////////
		// Update status
		if ((mfElevatorAccel==0.0f) && (mfElevatorSpeed==0.0f))
		{
			if (mbElevatorRunning)
			{
				mbElevatorRunning = false;
						
				// Detach player from elevator to avoid head bob etc.
				Entity_RemoveEntityAttachment("player");
				Effect_Sway_FadeOut(1.0f);
				ParticleSystem_SetActive("Elevator_ParticleSystem_1", false);
				ParticleSystem_SetVisible("Elevator_ParticleSystem_1",false);
				
				Effect_Rumble_SetScreenShakeMul(1);
				
				if (mlShakeID!=-1)
				{
					Effect_Shake_FadeOut(mlShakeID, 0.5f);
					mlShakeID = -1;
				}
			}
		}
		else 
		{
			if (!mbElevatorRunning)
			{
				mbElevatorRunning = true;
				
				// Attach player to elevator to avoid head bob etc.
				Entity_AttachToEntity("player","Elevator","",false,false);
				
				ParticleSystem_SetActive("Elevator_ParticleSystem_1", true);
				ParticleSystem_SetVisible("Elevator_ParticleSystem_1",true);
				
				Effect_Rumble_SetScreenShakeMul(0);
			}
		}
		
		if (mbInElevator)
		{
			UpdateSway(afTimeStep);
		}
			
		if (!mbElevatorRunning)
			return;
		
		/////////////////////////
		// Update speeds
		mfElevatorSpeed+=mfElevatorAccel*afTimeStep;
		if (mfElevatorAccel>0.0f)
		{
			if (mfElevatorSpeed>mfElevatorTargetSpeed)
			{
				mfElevatorSpeed = mfElevatorTargetSpeed;
				mfElevatorAccel = 0.0f;
			}
		}
		else if (mfElevatorAccel<0.0f)
		{
			if (mfElevatorSpeed<mfElevatorTargetSpeed)
			{
				mfElevatorSpeed = mfElevatorTargetSpeed;
				mfElevatorAccel = 0.0f;
			}
		}
		
		/////////////////////////
		// Update logical elevator position
		mfElevatorPrevDepth = mfElevatorDepth;
		mfElevatorDepth += mfElevatorSpeed*afTimeStep;	// Virtual position, inc loops
		
		/////////////////////////
		// Figure out physical position
		float fElevatorY = mfElevatorStartY-mfElevatorDepth;
		
		// Handle loops
		if ( fElevatorY > mfElevatorLoopY )
		{
			// Not in a loop - still in the initial phase - nothing to do.
			mlElevatorLoop = -1;
		}
		else
		{
			fElevatorY = mfElevatorLoopY;
			
			Map_SetEnvironmentParticleGravityVelocity(cVector3f(0.0f,mfElevatorSpeed,0.0f));
			Entity_SetActive("ElevatorCableLoopPoint", false);
			Entity_SetActive("ElevatorCableLoopStart*", true);
			
			// If we're not in the first loop, switch into it now
			if (mlElevatorLoop==-1)
			{
				EnterNextLoop();
			}
			
			////////////////////////////////////
			// Update all active loops
			for (int i=0;i<=(mlElevatorLoop+1);++i)
			{
				UpdateLoop(i, mfElevatorSpeed*afTimeStep);
			}
		}
			
		/////////////////////////
		// Update physical position
		cLuxProp@ pElevator = Map_GetProp("Elevator");
		cVector3f vPos = pElevator.GetPosition();
		
		////////////////////////
		// Only adjust positions if we haven't hit the loop point
		if (vPos.y!=mfElevatorLoopY)
		{
			vPos.y=fElevatorY;
			pElevator.SetPosition(vPos);
		}
		
		UpdateDepthEvents();
		UpdateProbes(afTimeStep);
	}

	//-------------------------------------------------------

	void UpdateSway(float afTimeStep)
	{
		float fSwaySpeed = mfElevatorSpeed/gfElevatorMaxSpeed;
		mfSwayTimer+=afTimeStep*(10.0f+5.0f*fSwaySpeed);
		float fSwaySize = 0.03f-fSwaySpeed*0.02f;
		float fSwayRate = 1.0f+fSwaySpeed*1.5f;
		if (mbFlesherAttacked)
		{
			fSwaySize = 0.1f;
			fSwayRate = 3.0f;
		}
		if (mbSuppressSway || (Player_GetCurrentStateName()=="State_Ladder") )
		{
			fSwaySize*=0.1f;
			fSwayRate*=0.1f;
		}
		if (mbOnElevator && mbBlackoutHappened)
		{
			fSwaySize*=4.0f;
			fSwayRate*=2.0f;
		}
		Effect_Sway_SetDirect(fSwaySize, fSwayRate, mfSwayTimer, 
								1.0f, 0.25f, 1.0f, 0.0f);
								
		cLuxProp@ pElevator = Map_GetProp("Elevator");
		cVector3f vPos = mvElevatorStartPos;
		vPos.y = pElevator.GetPosition().y;
		cVector3f vOffs = Effect_Sway_GetOffset()*0.5f;
		vPos.x+=vOffs.x;
		vPos.z+=vOffs.z;
		pElevator.SetPosition(vPos);
	}
	
	//-------------------------------------------------------

	void EnterNextLoop()
	{
		if (mlElevatorLoop==-1)
			mlElevatorLoop = 0;
		else
			mlElevatorLoop +=2;
		
		// Changed loops
		cLux_AddDebugMessage("Changed loop to:"+mlElevatorLoop);

		// Make all the relevant entities visible
		SetLoopActive(mlElevatorLoop, true);
		SetLoopActive(mlElevatorLoop+1, true);
		
		////////////////////////////////////////////
		// Positions for loops 0 and 1 should be in level
		if (mlElevatorLoop==0)
			return;
			
		////////////////////////////////////////////
		// Find start position
		iLuxEntity@ pLoop = Map_GetEntity("Loop"+mlElevatorLoop);
		cBoundingVolume@ pVol = pLoop.GetMainBody().GetBoundingVolume();
		
		iLuxEntity@ pPrevLoop = Map_GetEntity("Loop"+(mlElevatorLoop-1));
		cBoundingVolume@ pPrevVol = pPrevLoop.GetMainBody().GetBoundingVolume();
		float fStartY = pPrevVol.GetMin().y;
		
		////////////////////////////////////////////
		// Move loop object 1 to start point
		cVector3f vPos = pLoop.GetPosition();
		vPos.y = fStartY - pVol.GetSize().y*0.5f;
		pLoop.SetPosition(vPos);
		
		////////////////////////////////////////////
		// Move loop object 2 to start point
		iLuxEntity@ pLoop2 = Map_GetEntity("Loop"+(mlElevatorLoop+1));
		cBoundingVolume@ pVol2 = pLoop2.GetMainBody().GetBoundingVolume();
		
		fStartY-=pVol.GetSize().y;
		
		cVector3f vPos2 = pLoop2.GetPosition();
		vPos2.y = fStartY - pVol.GetSize().y*0.5f;
		pLoop2.SetPosition(vPos2);
	}
	
	//-------------------------------------------------------
	
	void SetLoopActive(int alLoop, bool abActive)
	{
		Entity_SetActive("Loop"+alLoop, abActive);
		Entity_SetActive("Loop"+alLoop+"_*", abActive);
		if (alLoop==0)
		{
			Entity_SetActive("LoopStart", abActive);
		}
	}
	
	//-------------------------------------------------------
	
	void UpdateLoop(int alLoop, float afMovement)
	{
		//////////////////////////////
		// Is the loop active?
		iLuxEntity@ pLoop = Map_GetEntity("Loop"+alLoop);
		if (!pLoop.IsActive())
			return;
	
		//////////////////////////////
		// Appear to move slightly faster
		afMovement*=gfLoopWallsMultiplier;
		
		//////////////////////////////
		// Move master loop object
		cVector3f vPos = pLoop.GetPosition();
		vPos.y+=afMovement;
		
		cBoundingVolume@ pBounds = pLoop.GetMainBody().GetBoundingVolume();
		
		if (alLoop == mlElevatorLoop || alLoop == mlElevatorLoop+1)
		{
			///////////////////////////////////////////////
			// Check to see if we've reached the wrap point
			float fLowerEdge = pBounds.GetMin().y;	
			if (fLowerEdge+afMovement>mfElevatorLoopY+pBounds.GetSize().y*0.5f)	// Lower edge of wrap point reached - wrap!
			{
				cLux_AddDebugMessage("Wrap:"+(mlElevatorLoop));
				vPos.y-=pBounds.GetSize().y*2.0f;
			}
		}
		else
		{
			///////////////////////////////////////////////
			// Check to see if this old loop has moved far enough away
			// to deactivate
			float fLowerEdge = pBounds.GetMin().y;
			if (fLowerEdge+afMovement>mfElevatorLoopY+pBounds.GetSize().y)
			{
				cLux_AddDebugMessage("Gone:"+(mlElevatorLoop));
				SetLoopActive(alLoop,false);
			}
		}
		
		pLoop.SetPosition(vPos);
		
		if (alLoop==0)
		{
			iLuxEntity@ pLoopStart = Map_GetEntity("LoopStart");
			vPos = pLoopStart.GetPosition();
			vPos.y+=afMovement;
			pLoopStart.SetPosition(vPos);
		}
	}
	
	//-------------------------------------------------------
	
	bool mbBotTriggered = false;
	
	bool OnTriggerInElevator(const tString &in asParent, const tString &in asChild, int alState)
	{
		mbInElevator = (alState==1);
		cLux_AddDebugMessage("IN ELEVATOR:"+mbInElevator);
		
		if (!mbBotTriggered)
		{
			mbBotTriggered = true;
			StartBot();
		}
		
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnTriggerOnElevator(const tString &in asParent, const tString &in asChild, int alState)
	{
		mbOnElevator = (alState==1);
		cLux_AddDebugMessage("ON ELEVATOR:"+mbOnElevator);
		return true;
	}
	
