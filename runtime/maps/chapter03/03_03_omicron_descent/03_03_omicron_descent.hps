	/////////////////////////////////////////
	// Scene 2 Event E Creatures Appear
	/////////////////////////////////////////
	
	bool mbCreaturesActive = false;
	
	//-------------------------------------------------------
	
	void SetupCreatures()
	{
		Entity_SetActive("Creature*",false);
		mbCreaturesActive = false;
		SetupCreatureSet("Creature1_*");
		SetupCreatureSet("Creature2_*");
	}
	
	//-------------------------------------------------------
	
	void UpdateCreatures(float afTimeStep)
	{
		if (mbCreaturesActive)
		{
			bool bSet1 = UpdateCreatureSet("Creature1_*", afTimeStep);
			bool bSet2 = UpdateCreatureSet("Creature2_*", afTimeStep);
			mbCreaturesActive = bSet1 || bSet2;
		}
	}
	
	//-------------------------------------------------------
	
	void SetupCreatureSet(const tString& in asName)
	{
		array<iLuxEntity@> vEntities;
		cLux_GetCurrentMap().GetEntityArray(asName, eLuxEntityType_Prop, "", vEntities);
		cVector3f vPos;
		cVector3f vVel;
		cBoundingVolume@ vVol = Map_GetEntity("TriggerInElevator").GetMainBody().GetBoundingVolume();
		for(uint i=0; i<vEntities.length(); ++i)
		{
			cLuxProp@ pProp = cLux_ToProp(vEntities[i]);
			vPos = pProp.GetPosition();
			vVel = cMath_RandRectVector3f(cVector3f(-0.2f,0.2f,-0.2f), cVector3f(0.2f,0.7f,0.2f));
			
			// Stop fish floating into the cage!
			if (vPos.x<vVol.GetMin().x) vVel.x=cMath_Max(-0.1f,cMath_Min(0.0f,vVel.x));
			if (vPos.x>vVol.GetMax().x) vVel.x=cMath_Min(0.1f,cMath_Max(0.0f,vVel.x));
			if (vPos.z<vVol.GetMin().z) vVel.z=cMath_Max(-0.1f,cMath_Min(0.0f,vVel.z));
			if (vPos.z>vVol.GetMax().z) vVel.z=cMath_Min(0.1f,cMath_Max(0.0f,vVel.z));
			
			pProp.SetVarVector3f("Vel",vVel);
			pProp.SetVarFloat("IllumTime", 0.0f);
			pProp.SetVarFloat("IllumRate", cMath_RandRectf(1.0f,5.0f));
			pProp.RotateAtSpeed(10.0f, cMath_RandRectf(-1.0f,1.0f), cVector3f(0.0f,1.0f,0.0f),  
				false, false, cVector3f_Zero, cVector3f_Zero);
			pProp.SetVarColor("Color", cMath_RandRectColor(cColor(0,0,0), cColor_White));
		}
	}
	
	//-------------------------------------------------------
	
	bool UpdateCreatureSet(const tString& in asName, float afTimeStep)
	{
		array<iLuxEntity@> vEntities;
		cLux_GetCurrentMap().GetEntityArray(asName, eLuxEntityType_Prop, "", vEntities);
		cVector3f vPos;
		cVector3f vVel;
		float fIllumTime;
		bool bActive = false;
		float fRot;
		cColor col;
		cBoundingVolume@ pVol = Map_GetEntity("CreatureBounds").GetMainBody().GetBoundingVolume();
		float yBoundsMax = pVol.GetMax().y;
		float ySlow = pVol.GetMin().y+pVol.GetSize().y*0.4f;
		float fOldY;
		float fAlpha;
		for(uint i=0; i<vEntities.length(); ++i)
		{
			cLuxProp@ pProp = cLux_ToProp(vEntities[i]);
			if (!pProp.IsActive())
				continue;
				
			bActive = true;

			vPos = pProp.GetPosition();
			vVel = pProp.GetVarVector3f("Vel");
			fOldY = vPos.y;
			vPos+=(vVel*afTimeStep);
			vPos.y+=mfElevatorSpeed*afTimeStep;
			pProp.SetPosition(vPos);
			
			fIllumTime = pProp.GetVarFloat("IllumTime");
			fIllumTime += pProp.GetVarFloat("IllumRate")*afTimeStep;
			pProp.SetVarFloat("IllumTime",fIllumTime);
			fAlpha = cMath_Clamp(fIllumTime / 20.0f,0.0f,1.0f);
			col = pProp.GetVarColor("Color");
			pProp.SetEffectBaseColor(col*cColor(1.0f,1.0f,1.0f,(cMath_Sin(fIllumTime)+1.0f)*0.5f*fAlpha));

			if ( (vPos.y>ySlow) && (fOldY<ySlow) )
			{
				vVel.y*=0.5f;
				pProp.SetVarVector3f("Vel",vVel);
			}
			if (vPos.y>yBoundsMax)
			{
				cLux_AddDebugMessage("Deactivate:"+pProp.GetName());
				pProp.SetActive(false);
			}
		}
		return bActive;
	}
	
