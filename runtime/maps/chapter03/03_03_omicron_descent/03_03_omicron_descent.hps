	//-------------------------------------------------------
	
	bool ElevatorAudio_CreakSwingSoundTrigger(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState==1)
		{
			Sound_CreateAtEntity("CableSwing", "03_03_omicron_descent/SFX/elevator/cable_swing", "CableSwingSoundSource", 0.0f, false, 1.0f);
			cLux_AddDebugMessage("Trigger Cable Swing on Elevator sounds");
			return true;
		}
		
		else
		{
			Sound_Stop("CableSwing", 1.5f);
			cLux_AddDebugMessage("Stop Elevator Cable Swinging Sounds");
			return true;
		}
	}

	//-------------------------------------------------------
	//Audio fades
	//-------------------------------------------------------
	
	void FadeAudio(const tString &in asTimer)
	{
		if(asTimer == "FadeAudioUpLevelStart")
		{	
			cLux_AddDebugMessage("Audio fading to 1.0f");
			Sound_FadeGlobalVolume(1.0f, 4.5f);
		}
		
		if(asTimer == "FadeAudioUp")
		{	
			cLux_AddDebugMessage("Audio fading to 1.0f");
			Sound_FadeGlobalVolume(1.0f, 10.0f);
		}

		if(asTimer == "FadeAudioDown")
		{	
			cLux_AddDebugMessage("Audio fading to 0.75f");
			Sound_FadeGlobalVolume(0.75f, 6.0f);
		}
	}
}