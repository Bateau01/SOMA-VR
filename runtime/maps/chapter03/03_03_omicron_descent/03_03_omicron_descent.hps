	}
	
	//-------------------------------------------------------

	void OnSeatInteract(const tString &in asEntity)
	{
		mlSeat = cString_ToInt(cString_GetLastChar(asEntity),-1);
		CameraAnimation_Begin("SeatCameraAnim"+mlSeat, "", true);
		Sound_CreateAtEntity("PlayerSeating", "03_03_omicron_descent/SFX/player/seating_elevator", "Player", 0.0f, false, 1.0f);
		EyeTracking_SetExtendedViewMul(0.0f);
	}
	
	//-------------------------------------------------------
	bool mbHasPlayerSeatedBefore = false;
	bool mbPlayerSeated = false;
	bool OnSeated(const tString &in asEntity, int alDirection)
	{
		mbSeatsCanBeInteractedWith = false;
		
		cLux_AddDebugMessage("[Elevator] Seated.");
		mbPlayerSeated = true;
		
		if (mbHasPlayerSeatedBefore==false)
		{
			//Map_AddTimer("ElevatorAlarmTimer", 5.5f, "ElevatorAlarm");
			mbHasPlayerSeatedBefore = true;
		}
		if (mbBlackoutHappened)
		{
			if (mbElevatorReady)
			{
				if (!Voice_AnySceneIsActive())
					SequenceStates_Resume("SequenceCathConversation");
				SequenceStates_Resume("SequenceBlackout");
			}
			return true;
		}
			
		// First time around
		if (!mbElevatorReady)
		{
			cLux_AddDebugMessage("[Elevator] Elevator not ready.");
			EyeTracking_SetExtendedViewMul(0.6f);
			return true;
		}
		
		Map_RemoveTimer("TimerCathSitDown");
		
		SequenceElevator();
		return true;
	}

	//-------------------------------------------------------
	
	bool mbBlackoutSaveDone = false;
	
	bool OnGotUp(const tString &in asEntity, int alDirection)
	{
		cLux_AddDebugMessage("Got Up");
		mbSeatsCanBeInteractedWith = true;
		Entity_SetActive("SeatInteract"+mlSeat, true);
		mbPlayerSeated = false;
		Entity_SetActive("SimonLegs_"+mlSeat,false);
		mlSeat = -1;
		EyeTracking_SetExtendedViewMul(1.0f);
		
		if (mbBlackoutHappened)
		{
			if (!mbBlackoutSaveDone)
			{
				Map_AddTimer("TimerAutosave",1.0f,"TimerAutosave");
				mbBlackoutSaveDone = true;
			}
		}
			
		return true;
	}
	
	// S26AO: preserve the scheduled callback spelling and the authored save handler.
