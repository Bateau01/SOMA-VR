	//-------------------------------------------------------

	void SetupElevatorControls()
	{
		mbCathPluggedIn = false;
		mbElevatorReady = false;
		mlSeat = -1;
		
		Entity_FadeEffectBaseColor("CathSocket", cColor(1,0,0,1), 0.1f);
		
		Entity_SetEffectsActive("Slider*",false,false);
		Slide_SetSlideAmount("Slider1", 1.0f);
		Slide_SetSlideAmount("Slider2", 0.7f);
		Entity_SetInteractionDisabled("Slider*",true);
		
		Slide_SetSlideAmount("RepSlider1", 0.0f);
		Slide_SetSlideAmount("RepSlider2", 0.0f);
		
		Entity_SetActive("RepSlider*", false);
		Entity_SetActive("RepElevatorHatch", false);
		
		Terminal_SetGuiActive("TerminalElevatorStart",false);
		Terminal_SetGuiActive("TerminalElevatorMain",false);
		Terminal_SetGuiActive("TerminalElevatorDepth*",false);
		
		Lamp_SetLit("ControlsLight*",false, false);
	} 

