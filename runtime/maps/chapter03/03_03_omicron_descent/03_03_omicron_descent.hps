			//Music_PlayExt("03_03_conversation", false, 0.45f, 1.0f, 0.0f, 0.0f, eMusicPrio_BigEvent, false);
			//Sound_FadeGlobalVolume(0.5f, 8.0f);
			//Map_AddTimer("FadeAudioUp", 50.0f, "FadeAudio");
