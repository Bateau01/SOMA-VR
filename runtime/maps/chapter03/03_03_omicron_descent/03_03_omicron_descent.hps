	//-------------------------------------------------------
	
	bool TrippedDepth(float afDesiredDepth)
	{
		return (mfElevatorPrevDepth<(afDesiredDepth-gfDepthDisplayStart) && 
				mfElevatorDepth>=(afDesiredDepth-gfDepthDisplayStart));
	}
	
	//-------------------------------------------------------
	
	void UpdateDepthEvents()
	{
		//////////////////////////
		// Depths we care about!
		if (TrippedDepth(gfProbe1Depth-gfProbeMaxRange))
		{
			StartProbe(1);
		}
		else if (TrippedDepth(gfFloodLightDepth))
		{
			// Floodlights come on
			SequenceStates_Resume("SequenceElevator");
		}
		else if (TrippedDepth(gfProbe2Depth-gfProbeMaxRange))
		{
			StartProbe(2);
		}
		else if (TrippedDepth(gfProbe3Depth-gfProbeMaxRange))
		{
			StartProbe(3);
		}
	/*	else if (TrippedDepth(3200.0f))
		{
			// Flesher attack
			cLux_AddDebugMessage("Tripped depth 3200!");
			SequenceStates_Resume("SequenceElevator");		
		}*/
		
		///////////////////////////
		// Zones
		if (TrippedDepth(gfZone1)||TrippedDepth(gfZone2)||TrippedDepth(gfZone3))
		{
			mlOceanZone++;
		}
		
		///////////////////////////
		// Loops
		// First loop automatically happens, so go to loop 2
		if (TrippedDepth(1900.0f))
		{
			EnterNextLoop();
		}
		else if (TrippedDepth(500.0f))
		{
			//EnterNextLoop();
		}
		
		///////////////////////////
		// Light - gets darker as we go down...
		float fLightLevel = cMath_Clamp(1.0f - (mfElevatorDepth/(1000.0f-gfDepthDisplayStart)), 0.0f, 1.0f);
		Light_SetBrightness("LevelBoxLight", fLightLevel);
		Light_SetBrightness("Elevator_SpotLight_1", fLightLevel);
		if (!mbFloodLightsOn)
			Light_SetBrightness("Elevator_SpotLight_2", fLightLevel);
		else
			Light_SetBrightness("Elevator_SpotLight_2", 1.0f);
		
		///////////////////////////
		// Pressure effects
		UpdatePressureEffects();
	}
	
	//-------------------------------------------------------
	
	int mlShakeID = -1;
	
	void UpdatePressureEffects()
	{
		float fPressure = cMath_Clamp((mfElevatorDepth+gfDepthDisplayStart)/3300.0f, 0.0f, 1.0f);

		int lOldPress = cMath_Easing(eEasing_CubicIn, mfPressure, 0.0f, 1.0f)*20.0f;
		int lCurrPress = cMath_Easing(eEasing_CubicIn, fPressure, 0.0f, 1.0f)*20.0f;
		
		if (lOldPress!=lCurrPress)
		{
			//////////////////////////////////////////
			// Blurriness
			float fBurstEnd = gfDofMax - fPressure*(gfDofMax-0.5f);
			float fBurstStart = cMath_Max(0.1f, fBurstEnd-1.0f);
			if (mlDofID!=-1)
				Effect_DoF_FadeOut(mlDofID,1.0f);
			mlDofID = Effect_DoF_Start(0.0f, fBurstStart, 1.0f, 0.25f);
			Effect_DoF_FadeFocus(mlDofID, 0.0f , fBurstEnd, 5.0f);
			Player_FadeFOVMulTo(1.0f-mfPressure*0.1f, 2.0f);
			Effect_ChromaticAberration_StartAnim(5.0f, fPressure*0.01f, 0.2f, cVector2f_Zero);
			Map_AddTimer("TimerEndBurst",1.0f,"TimerEndBurst");
		}
		
		if ( (lOldPress!=lCurrPress) || (mbElevatorRunning&&mlShakeID==-1) )
		{
			//////////////////////////////////////////
			// Shaking
			// Okay, shaking isn't a pressure effect, but seems a good place to do this
			if (mlShakeID!=-1)
				Effect_Shake_FadeOut(mlShakeID,1.0f);
			mlShakeID = Effect_Shake_Start(fPressure*0.005f, 1000.0f, 1.0f, 1.0f,
						cVector3f(0.2,1,0.2), mfElevatorSpeed*0.5f);
		}
		
		mfPressure = fPressure;
	}
	
	//-------------------------------------------------------
	
	void TimerEndBurst(const tString& in asName)
	{
		Player_FadeFOVMulTo(1.0f, 1.0f/5.25f);
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceElevator;
	void SequenceElevator(const tString& in asName="")
	{
		Sequence_Begin("SequenceElevator", mSequenceElevator);
		
		if (Sequence_DoStepAndWait(1.0f))
		{
			cLux_AddDebugMessage("[Elevator] Sat down");
			CameraAnimation_End();
			CameraAnimation_Begin("DescentCameraAnim"+mlSeat, "", true);
			CameraAnimationNode_SetInteractiveMovement("SeatCameraAnim*", false);
			
			Prop_SetStaticPhysics("Slider*",true);
			Entity_SetInteractionDisabled("Slider*",true);
			Entity_SetInteractionDisabled("StartLever",true);
			Prop_SetStaticPhysics("StartLever", true);
		}
		if (Sequence_DoStepAndWait(3.0f))
		{
			Lamp_SetFlickerActive("ControlsLightGood", false);
			
			CloseRestraints();
			PlayPlayerRestraintsClosing();
		}
		if (Sequence_DoStepAndWait(2.0f))
		{	
			Map_AddTimer("TerminalElevatorMain", 0.75f, "TimerTurnOnTerminal");
			Map_AddTimer("TerminalElevatorDepth*", 1.0f, "TimerTurnOnTerminal");
			
			Sound_CreateAtEntity("ScreensOn", "03_03_omicron_descent/SFX/elevator/screens_on", "TerminalElevatorMain", 0.0f, false, 1.0f);
		}
		if (Sequence_DoStepAndWait(1.0f))
		{
			Prop_SetStaticPhysics("ElevatorHatch",false);
			Slide_AutoMoveTo("ElevatorHatch", 0.0f);
		}
		else if (Sequence_DoStepAndPause())
		{
			cLux_AddDebugMessage("[Elevator] Starting ride");
			ElevatorAudio_Start();
			Player_SetCameraUseSmoothing(false);
			FadeElevatorSpeed(gfElevatorMaxSpeed, 1.0f);
			Prop_SetStaticPhysics("ElevatorHatch", true);
			Entity_SetActive("Ladder2_*",true);
			Entity_SetActive("Ladder1_*",false);
			Entity_AttachToEntity("Ladder2_Main","Elevator","",true,false);
			Entity_AttachToEntity("Ladder2_Top","Elevator","",true,false);
			
			Effect_Rumble_Start(0.5f,0.5f);
			
			SequenceCathConversation();
			
			cLux_AddTodoMessage("MARCUS: Add new particles here!");
			ParticleSystem_CreateAtEntity("ElevatorStartPS","03_03_oneshot_waterbubbles_elevator_release.ps","Elevator",false);
		}
		else if (Sequence_DoStepAndPause())
		{
			//////////////////////
			// Floodlights come on
			SequenceFloodlights();
		}
		else if (Sequence_DoStepAndPause())
		{
			//////////////////////
			// Flesher Attack
			SequenceFlesherAttack();
		}
		else if (Sequence_DoStepAndWait(0))
		{
			//////////////////////
			// Journey's end
			cScript_SetGlobalVarInt("ElevatorSeat",mlSeat);
			
			ElevatorAudio_LevelEnd();
			Effect_VideoDistortion_SetDirectAmount(0.0f);
			Effect_Fade_Out(0.0f);
			
			Effect_Rumble_Start(0.9f,0.7f);
			
			////////enough fade out time for audio to finish
			cLux_AddDebugMessage("[Elevator] Start loading next level");
			Map_AddTimer("LoadNextLevel", 11.0f, "LoadNextMap");
			
			PreloadDeload();
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	void LoadNextMap(const tString &in asTimer)
	{
		PreloadChangeOfMap();
	}
	
	//-------------------------------------------------------

	/////////////////////////////////////////
	// Scene 2 Event A Conversation with Cath
	/////////////////////////////////////////
	
	//-------------------------------------------------------

	cSequenceStatesData mSequenceCathConversation;
	void SequenceCathConversation(const tString& in asName="")
	{
		Sequence_Begin("SequenceCathConversation", mSequenceCathConversation);
		
		if (Sequence_DoStepAndWait(3.0f))
		{
			Sound_FadeGlobalVolume(0.55f, 6.0f, eSoundEntryType_WorldClean);
		}
		else if (Sequence_DoStepAndPause(4.0f))
		{
			cLux_AddDebugMessage("Cath Conversation starts - Simon leads on from what happened in 3.2.");
			bool bPlayerKilledOmicronSimon = cScript_GetGlobalVarBool("PlayerKilledOmicronSimon");
			if (bPlayerKilledOmicronSimon)
			{
				Dialog_Begin("SimonDiscussion_Killed");
					Dialog_AddBranchAndSubject("SimonDiscussion_Killed", "", "OnCathChatDone");
				Dialog_End();
			}
			else
			{
				Dialog_Begin("SimonDiscussion_Left");
					Dialog_AddBranchAndSubject("SimonDiscussion_Left", "", "OnCathChatDone");
				Dialog_End();			
			}

			///////////////
			// Start preloading next map here
			Preload();
		}
		else if (Sequence_DoStepAndPause())
		{
			Sound_FadeGlobalVolume(0.55f, 5.0f, eSoundEntryType_WorldClean);
			cLux_AddDebugMessage("Cath carries on conversation.");
			Dialog_Begin("CatherineStartChat");
				Dialog_AddBranchAndSubject("CatherineStartChat", "", "OnCathChatDone");
			Dialog_End();
		}
		else if (Sequence_DoStepAndPause())
		{
			cLux_AddDebugMessage("Cath Conversation interrupted.");
			SequenceBlackout();
		}
		else if (Sequence_DoStepAndPause())
		{
			cLux_AddDebugMessage("Cath Conversation about power.");
			Dialog_Begin("CatherineResumeChat");
				Dialog_AddBranchAndSubject("CatherineResumeChat", "", "OnCathPowerChatDone");
			Dialog_End();
		}
		else if (Sequence_DoStepAndPause(10.0f))
		{
			cLux_AddDebugMessage("Cath Conversation restarts.");
			Dialog_Begin("CatherinePart2Chat");
				Dialog_AddBranchAndSubject("CatherinePart2Chat", "", "OnCathChatDone");
			Dialog_End();
			
			PreloadFadeGlobal();
		}
		else if (Sequence_DoStepAndWait(0))
		{
			cLux_AddDebugMessage("Cath Conversation complete.");
			// Flesher attack
			SequenceStates_Resume("SequenceElevator");	
		}
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	void OnCathPowerChatDone(const tString&in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject)
			return;
			
		cLux_AddDebugMessage("Cath power chat done");
		if (mlSeat!=-1)
		{
			cLux_AddDebugMessage("Resuming sequence");
			SequenceStates_Resume("SequenceCathConversation");
		}
	}
	
	//-------------------------------------------------------
	
	void OnCathChatDone(const tString&in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject)
			return;
		
		cLux_AddDebugMessage("Cath chat done");
		cLux_AddDebugMessage("Resuming sequence");
		SequenceStates_Resume("SequenceCathConversation");
		Sound_FadeGlobalVolume(1.0f, 3.5f, eSoundEntryType_WorldClean);
	}
	
	//-------------------------------------------------------
	
	void LineStart_Part2ChatStart(const tString &in asScene, const tString &in asSubject, int alLineIndex, bool abStart)
	{
		if (abStart==false)
			return;
			
		Sound_FadeGlobalVolume(0.65f, 6.0f, eSoundEntryType_WorldClean);
	}
	
	void LineOver_Part2ChatEnd(const tString &in asScene, const tString &in asSubject, int alLineIndex, bool abStart)
	{
		if (abStart==false)
			return;
			
		Sound_FadeGlobalVolume(1.0f, 4.0f, eSoundEntryType_WorldClean);
	}

	/////////////////////////////////////////
	// Scene 2 Event B Probes Pass
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	void SetupProbes()
	{
		for(int i=1;i<=glProbeCount;++i)
			SetProbeActive(i,false);
	}
	
	//-------------------------------------------------------
	
	void SetProbeActive(int alProbe, bool abActive)
	{
		Entity_SetActive("Probe"+alProbe+"*", abActive);
	}
	
	//-------------------------------------------------------
	
	void StartProbe(int alProbe)
	{
		cLux_AddDebugMessage("[Probes] Started probe:"+alProbe);
		
		mlProbe = alProbe;
		mlProbeImage = 1;
		mfProbeImageTimer = 0.0f;
		
		SetProbeActive(alProbe, true);
		iLuxEntity@ pProbe = Map_GetEntity("Probe"+alProbe);
		cVector3f vPos = pProbe.GetPosition();
		vPos.y = cLux_GetPlayer().GetCamera().GetPosition().y - gfProbeMaxRange;
		pProbe.SetPosition(vPos);
		pProbe.SetVarFloat("ProbeDist",0.0f);
	}
	
	//-------------------------------------------------------

	void UpdateProbes(float afTimeStep)
	{
		iLuxEntity@ pProbe;
		cVector3f vPos;
		for(int i=1;i<=glProbeCount;++i)
		{
			@pProbe = Map_GetEntity("Probe"+i);
			if (!pProbe.IsActive())
				continue;
			
			float fDist = pProbe.GetVarFloat("ProbeDist");
			fDist+=mfElevatorSpeed*afTimeStep;
			if (fDist>(gfProbeMaxRange*2.0f))
			{
				cLux_AddDebugMessage("[Probes] Finished probe:"+i);
				SetProbeActive(i, false);
				mlProbe = 0;
				return;
			}
			pProbe.SetVarFloat("ProbeDist",fDist);
				
			vPos = pProbe.GetPosition();
			if (mlElevatorLoop!=-1)
				vPos.y+=mfElevatorSpeed*afTimeStep;
			pProbe.SetPosition(vPos);
		}
	}
	
