	}
				
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceBlackout;
	void SequenceBlackout(const tString& in asName="")
	{
		Sequence_Begin("SequenceBlackout", mSequenceBlackout);
		if (Sequence_DoStepAndWait(0.01f))
		{			
			////////////////
			// Black Out
			cLux_AddDebugMessage("[Elevator] All goes dark");
			SwitchElevatorLights(false,false);
			
			Sound_PreloadGroup("03_03_omicron_descent/SFX/elevator/shoulder_restraint", true);
			
			// Sudden stop
			mfElevatorAccel = 0.0f;
			mfElevatorSpeed = 0.0f;
			mfElevatorTargetSpeed = 0.0f;
			
			Effect_Shake_Start(0.25f, 0.25f, 0.25f, 0.5f, cVector3f(0.3,1,0.3), 12.0f);
			Effect_Rumble_Start(0.5f,1.0f,0.25f,0.5f);
			
			mbBlackoutHappened = true;
			
			////////////////////
			// Replacements
			// These objects will be swapped in when the elevator stops in blackout, due to
			// physics issues
			Entity_AttachToEntity("RepElevatorHatch","Elevator","",false,false);
			Entity_AttachToEntity("RepElevatorDoor","Elevator","",false,false);
			Entity_AttachToEntity("RepSlider1","Elevator","",false,false);
			Entity_AttachToEntity("RepSlider2","Elevator","",false,false);
			Entity_SetEffectsActive("RepSlider*",false,false);
			cLux_AddTodoMessage("Interrupt Cath conversation");
			
			ElevatorAudio_Stop(0.25f, true);
			
			// Make sure box can be opened.
			Lever_SetStuckState("ResetBox",0,true);
			
			Entity_SetEffectsActive("TerminalElevatorStart",false,false);
			CathTool_SetScreen("CathTool",eCathToolScreen_Disconnected);
			Lamp_SetLit("omnislot_deepdiving_left_light_1",false,false);
		}
		else if (Sequence_DoStepAndWait(0.99f))
		{
			Map_SetEnvironmentParticleGravityVelocity(cVector3f(0.0f,0.0f,0.0f));
		}
		else if (Sequence_DoStepAndWait(5.0f))
		{
			////////////////////
			// Swap in replacement objects (due to physics issues)
			Entity_SetActive("ElevatorHatch", false);
			Entity_SetActive("RepElevatorHatch", true);
			Slide_AutoMoveTo("RepElevatorHatch", 1.0f);
			Entity_SetActive("Slider*", false);
			Entity_SetActive("RepSlider*", true);
			Entity_SetInteractionDisabled("RepSlider*",true);
			Prop_SetStaticPhysics("RepSlider*", true);
			
			Entity_SetActive("ElevatorDoor", false);
			Entity_SetActive("RepElevatorDoor", true);
			
			//Sound_CreateAtEntity("ElevatorHatchOpen", "03_03_omicron_descent/SFX/elevator/hatch/open", "ElevatorHatch", 0.0f, false, 1.0f);
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			//////////////////
			// Release seats
			OpenRestraints();
			PlayPlayerRestraintsOpening();
			
			/////////////////
			// Reset puzzles
			Entity_SetEffectsActive("ResetButton",true,true);	
			Entity_SetActive("DeathArea",true);
			
			Prop_SetStaticPhysics("RepElevatorHatch",true);
			
			mbElevatorReady = false;
		}
		else if (Sequence_DoStepAndPause())
		{
			CameraAnimationNode_SetInteractiveMovement("DescentCameraAnim"+mlSeat+"_1", true);
			CameraAnimationNode_SetInteractiveMovement("SeatCameraAnim*", true);
			
			Dialog_Begin("SimonChatInterrupted");
				Dialog_AddBranchAndSubject("SimonChatInterrupted", "", "");
			Dialog_End();
		
			Map_AddTimer("Creature1",5.0f,"TimerStartCreatures");
			Map_AddTimer("Creature2",15.0f,"TimerStartCreatures");
		}
		else if (Sequence_DoStepAndPause())
		{
			////////////////
			// End Black Out
			cLux_AddDebugMessage("[Elevator] Lights come back on");
			Sound_CreateAtEntity("LightsOn", "03_03_omicron_descent/SFX/elevator/lights_on_louder", "Player", 0.0f, false, 1.0f);
			SequenceStates_Resume("SequenceCathConversation");
			
			SwitchElevatorLights(true,true);

			Lamp_SetFlickerActive("ControlsLightGood", true);
			
			/////////////////
			// Reset puzzles
			Entity_SetEffectsActive("ResetButton",false,true);
			Entity_SetInteractionDisabled("ResetButton",true);
			Entity_SetEffectsActive("RepSlider*",true,true);
			
			Entity_SetEffectsActive("TerminalElevatorStart",true,false);
			CathTool_SetScreen("CathTool",eCathToolScreen_Interact);
			Lamp_SetLit("omnislot_deepdiving_left_light_1",true,false);
			
			if (!Voice_SceneInvolvingCharacterIsActive("Catherine"))
				SequenceStates_Resume("SequenceCathConversation");
			
			mbElevatorReady = true;
		}
		else if (Sequence_DoStepAndWait(1.0f))
		{
			// Sat back down
			Entity_SetActive("DeathArea",false);
			
			cLux_AddDebugMessage("[Elevator] Sat down");
			CameraAnimation_End();
			CameraAnimation_Begin("DescentCameraAnim"+mlSeat, "", true);
			CameraAnimationNode_SetInteractiveMovement("DescentCameraAnim"+mlSeat+"_1", false);
			CameraAnimationNode_SetInteractiveMovement("SeatCameraAnim*", false);
			
			Prop_SetStaticPhysics("RepSlider*", false);
		}
		if (Sequence_DoStepAndWait(5.0f))
		{
			Lamp_SetFlickerActive("ControlsLightGood", false);
			CloseRestraints();
			PlayPlayerRestraintsClosing();
		}
		if (Sequence_DoStepAndWait(3.0f))
		{
			Prop_SetStaticPhysics("RepElevatorHatch",false);
			Slide_AutoMoveTo("RepElevatorHatch", 0.0f);
			//Sound_CreateAtEntity("ElevatorHatchClose", "03_03_omicron_descent/SFX/elevator/hatch/close", "ElevatorHatch", 0.0f, false, 1.0f);
		}		
		if (Sequence_DoStepAndWait(0.4f))
		{
			ElevatorAudio_Start();
		}
		else if (Sequence_DoStepAndWait(0.0f))
		{
			cLux_AddDebugMessage("[Elevator] Resuming ride");
			Effect_Rumble_Start(0.5f,0.5f);
			Player_SetCameraUseSmoothing(false);
			FadeElevatorSpeed(gfElevatorMaxSpeed, 1.0f);
			Entity_AttachToEntity("player","Elevator","",false,false);
			Prop_SetStaticPhysics("RepElevatorHatch", true);

			cLux_AddTodoMessage("MARCUS: Add new particles here!");
			ParticleSystem_CreateAtEntity("ElevatorStartPS","03_03_oneshot_waterbubbles_elevator_release.ps","Elevator",false);
		}
		Sequence_End();
	}
	
