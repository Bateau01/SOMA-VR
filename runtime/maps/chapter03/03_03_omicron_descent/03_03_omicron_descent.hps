	//-------------------------------------------------------

	void SetupBot()
	{
		Entity_SetActive("Bot*",false);
		mbBotTriggered = false;
	}
	
	//-------------------------------------------------------

	void StartBot()
	{
		Entity_SetActive("Bot1",true);
		
		Pathfinder_Stop("Bot1");
		Pathfinder_Track_Clear("Bot1");
		for (int i=1;i<=7;++i)
		{
			Pathfinder_Track_Add("Bot1", "NodeBot1_"+i, 0.25f, 1.0f);
		}
		Pathfinder_Track_Start("Bot1", true, 0.5f, "BotDone");
	}
	
