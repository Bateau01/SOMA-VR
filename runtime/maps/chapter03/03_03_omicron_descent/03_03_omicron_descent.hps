	////////////////////////////
	// Set up map environment
	void Setup()
	{
		////////////////////
		//4.1 Preset for transition
		Map_Preset_SetupColorGrading("Preset4.1", "textures/colorgrading/grading_04_01.dds");
		Map_Preset_SetupBloom("Preset4.1", 64, 0.00001, 1, cColor(0.6, 0.6, 0.6, 0));
		Map_Preset_SetupDirLight("Preset4.1", true, cColor(0.397,0.508,0.448,1), 0.1f, cVector3f(0.008,-0.852,-0.523), cColor(0.046,0.164,0.078,1), cColor(0.4,0.84,0.634,1));
		
		GetBase().SetDisplayNameEntry("03-03-omicron-descent");
		RichPresence_SetCurrent(eRichPresence_TheDescent );
		
		cLux_GetCurrentMap().GetWorld().SetFogUnderwater(true);
		
		mlDofID = Effect_DoF_Start(0.0f, gfDofMax, 0.1, 0.0);
		
		float fFadeTime = 0.5;
		Effect_Bloom_FadeBrightPass(0.00001, fFadeTime);
		Effect_Bloom_FadeBloomWidth(160, fFadeTime);
		Effect_Bloom_FadeBloomTint(0.3, 0.3, 0.3, fFadeTime);
		
		if(cLux_ScriptDebugOn())
		{
			
		}
	}
	
	//-------------------------------------------------------
	
	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		CathTool_ResetScreen(eCathToolVariant_CathDelta);
		
		SetupElevator();
		SetupElevatorControls();
		SetupProbes();
		SetupCreatures();
		SetupFlesher();
		SetupBot();
		SetupResetPuzzle();
		
		/////////////////////////////
		//Level Fade
	//	Effect_Fade_Out(0.0f);
	//	Map_AddTimer("TimerFadeInLevel",2.0f,"TimerFadeInLevel");
				
		/////////////////////////////
		// Voices
		Voice_SetSource("Catherine", "CathSocket", 6, 24, true, 20);
		Voice_SetSource("Player", "player", 1, 1, false, 1);
		Voice_SetSource("Flesher", "flesher", 6, 24, true, 20);
		Light_SetVisible("DebugBoxLight",false); 
		
		////////////////////////////
		//Audio
		Sound_FadeGlobalVolume(1.0f, 2.0f, eSoundEntryType_WorldClean);
		Sound_FadeGlobalVolume(1.0f, 2.0f, eSoundEntryType_World);
		Sound_PreloadProject("03_03_omicron_descent");
		Sound_PreloadGroup("Flashback/Level/03_03", true);
		Sound_PreloadGroup("Flashback/Ross/3.3", true);
				
		Entity_SetActive("CathTool",true);
		Tool_PickUp("CathTool", false, false);
		PlayerHands_SetHandModel_DeepSea();
		
		Map_AddTimer("OpenAirLock", 2, "TimerOpenAirLock");
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			//Add any debug stuff here
			
			cLux_SetDebugInfoWindowText("Text that should show up when pressing F1");
		}
		
		
		LastOnSoma_SetText("03_03_omicron_descent_1");
	}

