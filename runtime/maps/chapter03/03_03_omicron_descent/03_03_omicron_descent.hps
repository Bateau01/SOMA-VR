	//-------------------------------------------------------
	bool mbSwayFirstTime = true;
	bool OnTriggerSwayArea(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState==1)
		{
			cLux_AddDebugMessage("Enter sway area.");
			Effect_Sway_FadeIn(0.05f, 1.0f, 1.0f, 0.0f);
			if(mbSwayFirstTime==true)
			{
				Sound_CreateAtEntity("Sway", "03_03_omicron_descent/AMB/platform_sway", "Player");
				mbSwayFirstTime = false;
			}
			
			Map_AddTimer("SwaySounds", cMath_RandRectf(6.0f,8.0f), "PlatformSway");
		}
		else
		{
			cLux_AddDebugMessage("Exit sway area.");
			Effect_Sway_FadeOut(1.0f);
			Map_RemoveTimer("SwaySounds");
		}
		return true;
	}
	
	void PlatformSway(const tString &in asTimer)
	{
		Sound_CreateAtEntity("Sway", "03_03_omicron_descent/AMB/platform_sway", "Player");
		Map_AddTimer("SwaySounds", cMath_RandRectf(6.0f,8.0f), "PlatformSway");
	}
	
