	//-------------------------------------------------------
	 
	/////////////////////////////////////////
	// ==============
	// SCENE 2 - The Descent
	// ==============
	/////////////////////////////////////////

	int mlActionRestraintsStart = -1;
	int mlActionRestraintsEnd = -1;
	int mlSeatNo = 0;
	//-------------------------------------------------------

	void CloseRestraints(int alStart=1, int alEnd=1)
	{
		mlActionRestraintsStart = alStart;
		mlActionRestraintsEnd = alEnd;
		
		
		int nSeatsMoving = 0;
		for (int i=alStart;i<=alEnd;i++)
		{
			if (!Entity_GetVarBool("seat_restraint_"+i, "SeatState"))
			{
				nSeatsMoving++;
				Entity_PlayAnimation("seat_restraint_"+i, "chair_03_03_enter_restraint",0.3f,false,false,"OnSeatClosed");
				Entity_SetVarBool("seat_restraint_"+i, "SeatState",true);
			}
			Entity_SetActive("SeatInteract"+i,false);
			
			mlSeatNo = i;
		}
		
		if (mbPlayerSeated)
		{
			Map_AddTimer("Lower", 0.0f, "ShoulderRestraintAudio");
		}
		else
		{
			// Current sound - probably needs removing!
			
			
			if (nSeatsMoving==1)
			{
				Map_AddTimer("LowerRestraintSoundSingle", 0.75f, "LowerRestraintSound");
			}
			else
			{
				Map_AddTimer("LowerRestraintSoundMulti", 2.0f, "LowerRestraintSound");
				
			}
		}
	}
	
	
	bool mbSoundPreloaded = false;
	void LowerRestraintSound(const tString &in asTimer)
	{
		if(mbSoundPreloaded==false)
		{
			Sound_PreloadGroup("03_03_omicron_descent/SFX/elevator", true);
			mbSoundPreloaded = true;
		}
		
		if(asTimer=="LowerRestraintSoundMulti")
		{
			Sound_CreateAtEntity("LowerRestraintMulti", "03_03_omicron_descent/SFX/elevator/shoulder_restraint/multi/lower", "SeatMultipleSoundArea");
		}
		
		if(asTimer=="LowerRestraintSoundSingle")
		{
			Sound_CreateAtEntity("LowerRestraintSingle", "03_03_omicron_descent/SFX/elevator/shoulder_restraint/single/lower", "seat_restraint_"+mlSeatNo);
		}
		
		if(asTimer=="RaiseRestraintSound")
		{
			Sound_CreateAtEntity("OpenRestraintSingle", "03_03_omicron_descent/SFX/elevator/shoulder_restraint/multi/raise", "seat_restraint_3");
		}
		
	}
	
	//-------------------------------------------------------
	
	void OnSeatClosed(const tString &in asEntityName, const tString &in asAnimName)
	{
		Entity_PlayAnimation(asEntityName, "chair_03_03_idle_restraint",0.3f,true,false,"");
	}
	
	//-------------------------------------------------------
	
	void OpenRestraints(int alStart=1, int alEnd=1)
	{
		mlActionRestraintsStart = alStart;
		mlActionRestraintsEnd = alEnd;
		
		//////////////////
		//Small buffer timer to allow for sound of mechanism whirring away
		Map_AddTimer("RestraintsOpenTimer", 0.5f, "OpenRestraintsAction");
		
		if(mbPlayerSeated==true)
		{
			Map_AddTimer("Raise", 0.0f, "ShoulderRestraintAudio");
		}
		else
		{
			Map_AddTimer("RaiseRestraintSound", 1.0f, "LowerRestraintSound");
		}
		
		cLux_AddDebugMessage("[Elevator] Opening restraints...");
	}
	
	//-------------------------------------------------------
	
	void OpenRestraintsAction(const tString& in asTimer)
	{
		for (int i=mlActionRestraintsStart;i<=mlActionRestraintsEnd;i++)
		{
			if (Entity_GetVarBool("seat_restraint_"+i, "SeatState"))
			{
				Entity_PlayAnimation("seat_restraint_"+i, "chair_03_03_leave_restraint",0.3f,false,false,"OnSeatOpen");
				Entity_SetVarBool("seat_restraint_"+i, "SeatState",false);
			}
			Entity_SetActive("SeatInteract"+i, mbSeatsCanBeInteractedWith);
		}
	}
	
	void OnSeatOpen(const tString &in asEntityName, const tString &in asAnimName)
	{
		Entity_PlayAnimation(asEntityName, "chair_03_03_idle_up_restraint",0.3f,true,false,"");
	}
	
