	// Scene 2 Event C Lights Come On
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbFloodLightsOn = false;
	bool mbLightsOnFirstTime = true;
	
	cSequenceStatesData mSequenceFloodlights;
