	/////////////////////////////////////////

	//-------------------------------------------------------
	
	bool CanUseCathTool(const tString &in asTool, const tString &in asEntity)
	{
		return asEntity == "CathSocket" || asEntity == "CathSocketInteractAux";
	}

	//-------------------------------------------------------
	
	bool OnUseCathTool(const tString &in asTool, const tString &in asEntity)
	{
		if (asEntity == "CathSocket" || asEntity == "CathSocketInteractAux")
		{
			mbCathPluggedIn = true;
			Entity_FadeEffectBaseColor("CathSocket", cColor(0,1,0,1), 0.1f);
			Entity_SetEffectsActive("Slider*",true,true);
			Entity_SetInteractionDisabled("Slider*",false);
			CathTool_Insert("CathTool", "CathSocket");
			Lever_SetStuckState("StartLever", 0, true);
			
			Entity_AttachToEntity("CathTool","Elevator","",false,false);
				
			Map_AddTimer("TerminalElevatorStart", 0.5f, "TimerTurnOnTerminal");
			
			Map_AddTimer("CathIntro", 0.5f, "TimerCathSpeak");
		}
			
		return true;
	}

	//-------------------------------------------------------
	
	void TimerTurnOnTerminal(const tString& in asName)
	{
		Terminal_SetGuiActive(asName,true,0.5f);
	}
	
	//-------------------------------------------------------

	/////////////////////////////////////////
	// Scene 1 Event C Start Elevator
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	int mlKnob1State = 0;
	int mlKnob2State = 0;

	//-------------------------------------------------------
	
	void UpdateElevatorControls(float afTimeStamp)
	{
		tString sRoot = "Slider";
		if (mbBlackoutHappened)
			sRoot = "RepSlider";
		float fKnob1 = Slide_GetSlideAmount(sRoot+"1");
		mlKnob1State = cMath_Clamp(fKnob1*3.0f,0,2);
		
		float fKnob2 = Slide_GetSlideAmount(sRoot+"2");
		mlKnob2State = cMath_Clamp(fKnob2*6.0f,0,5);
	}
	
	//-------------------------------------------------------

	void OnStartLeverChangeState(const tString &in asEntity, int alState)
	{
		cLux_AddDebugMessage("Lever state changed:"+alState);
		
		if (alState!=1)
			return;
			
		if (!mbCathPluggedIn)
		{
			cLux_AddDebugMessage("Cath not plugged in!");
			Map_AddTimer(asEntity, 0.5f, "TimerSwitchLeverOff");
			return;
		}
		
		Entity_SetInteractionDisabled("StartLever",true);
		
		// Update seats
		{
			int lTarget = mlKnob2State+1;
			cLux_AddDebugMessage("New number of seats:"+lTarget);
			int lOld = 0;
			for (int i=1;i<=6;i++)
			{
				if (!Entity_GetVarBool("seat_restraint_"+i, "SeatState"))
					lOld=i;
			}
			
			if (lOld<lTarget)
			{
				cLux_AddDebugMessage("Opening restraints:"+lOld+","+lTarget);
				
				//Sound_CreateAtEntity("OpenRestraintSingle", "03_03_omicron_descent/SFX/elevator/shoulder_restraint/single/raise", "seat_restraint_"+lTarget);
				
				OpenRestraints(lOld+1,lTarget);
			}
			else
			{
				cLux_AddDebugMessage("Closing restraints:"+lOld+","+lTarget);
				
				//Sound_CreateAtEntity("CloseRestraintSingle", "03_03_omicron_descent/SFX/elevator/shoulder_restraint/single/lower", "seat_restraint_"+lTarget);
				
				CloseRestraints(lTarget+1,lOld);
			}
		}
		
		if ((mlKnob1State!=0)||(mlKnob2State!=0))
		{
			cLux_AddDebugMessage("Knobs set wrong.");
			Map_RemoveTimer(asEntity);
			
			Map_AddTimer(asEntity, 0.5f, "TimerSwitchLeverOff");
			Lamp_SetLit("ControlsLightBad", true, true);
			Lamp_SetLit("ControlsLightGood", false, true);
			Map_AddTimer("TimerControlsReset", 1.0f, "TimerControlsReset");
			return;
		}
		
		Entity_SetInteractionDisabled("Slider*",true);
		
		Lamp_SetLit("ControlsLightGood", true, true);
		Lamp_SetLit("ControlsLightBad", false, true);

		Lamp_SetFlickerActive("ControlsLightGood", true);
		
		Map_AddTimer("CathElevatorReady", 0.5f, "TimerCathSpeak");
		Map_AddTimer("TimerCathSitDown",20.0f,"TimerCathSitDown");
		
		Depth_Audio_PuzzleBeeps_AbyssElevator_Positive("ControlsLightGood");
		
		Lever_SetAutoMoveTarget(asEntity,1);
		Lever_SetAutoMoveEnabled(asEntity,true);
		Lever_SetStuckState(asEntity,1,true);

		mbElevatorReady = true;
	}
	
	//-------------------------------------------------------
	
	void TimerCathSpeak(const tString& in asName)
	{
		Voice_Play(asName);
	}
	
	//-------------------------------------------------------
	
	void TimerControlsReset(const tString& in asName)
	{
		Entity_SetInteractionDisabled("StartLever",false);
		Lamp_SetLit("ControlsLightBad", false, true);
	}
	
