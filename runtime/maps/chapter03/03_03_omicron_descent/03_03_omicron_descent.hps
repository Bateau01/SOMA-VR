	void ElevatorAudio_LevelEnd()
	{
		cLux_AddDebugMessage("Audio - LevelEnd");
		Sound_SetGlobalVolume(0.0f);
		//Sound_SetGlobalVolume(0.0f, eSoundEntryType_GuiWorld);
		ElevatorAudio_Stop(0.0f, false);
	}
		
	//-------------------------------------------------------
	void ElevatorAudio(const tString &in asTimer)
	{
		if(asTimer == "ElevatorAudioDescentBeep")
		{	
			Sound_CreateAtEntity("DescentBeep", "Entities_OceanBottom/tech/terminal/buttons/descent", "ControlsLightGood", 0.0f, false, 1.0f);
		}
		if (asTimer == "ElevatorAudioDescentCreaks_Stage1")
		{
			Sound_CreateAtEntity("ElevatorAudio_Creak", "03_03_omicron_descent/SFX/elevator/creak", "Player", 0.0f, false, 1.0f);
		}
	}

