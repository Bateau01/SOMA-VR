	//-------------------------------------------------------
	
	bool OnTriggerDeathArea(const tString &in asParent, const tString &in asChild, int alState)
	{
		SequenceAbyssFall("");
		return true;
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mAbyssFallSequence;
	
	void SequenceAbyssFall(const tString &in asTimer)
	{
		Sequence_Begin("SequenceAbyssFall", mAbyssFallSequence);
	
		// Silence everything except dark tone
		if (Sequence_DoStepAndWait(3.5))
		{
			//Fade out level audio
			Sound_FadeGlobalVolume(0.0f ,3.0f, eSoundEntryType_World);
			Sound_FadeGlobalVolume(0.0f ,3.0f, eSoundEntryType_WorldClean);
			
			//Create Falling Sound
			Sound_CreateAtEntity("AbyssFall", "Player/action/underwater/abyss_fall", "Player", 0.0f, false, 1.0f);
		}
		/////////////////////
		// Start falling
		if (Sequence_DoStepAndWait(2.f))
		{						
			Effect_Fade_Out(3.5f);
			//Breathing
			Sound_CreateAtEntity("HeavyBreathing", "Player/breaths/abyss/breathing", "Player", 0.0f, false, 1.0f);
		}
		else if (Sequence_DoStepAndWait(1.5f))
		{
			Player_SetMoveSpeedMul(0);
		}
		else if (Sequence_DoStepAndWait(4.75f))
		{
			//Trigger Suit Pressure Alarm
			Sound_CreateAtEntity("PressureAlarmMediumSpeed", "Player/UI/Suit/pressure_alarm_medium", "Player", 0.0f, false, 1.0f);
		}
		
		else if (Sequence_DoStepAndWait(1.f))
		{
			//Stop Medium Alarm and Trigger Fast Alarm
			Sound_Stop("PressureAlarmMediumSpeed", 0.0f);
			Sound_CreateAtEntity("PressureAlarmHighSpeed", "Player/UI/Suit/pressure_alarm_high", "Player", 0.0f, false, 1.0f);
		}
		
		else if (Sequence_DoStepAndWait(2.5f))
		{
			//Trigger Suit Cracking Under Pressure
			Sound_CreateAtEntity("SuitCracking", "Player/action/underwater/abyss_suit_crack", "player", 0.0f, false);
		}
				
		else if (Sequence_DoStepAndWait(6.5f))
		{
			//Stop all sounds apart from the big finale, quick fade to black
			Sound_Stop("AbyssFall", 0.0f);
			Sound_Stop("PressureAlarmHighSpeed", 0.0f);
			
			//Suit Crack Open
			Sound_CreateAtEntity("SuitCrackOpen", "Player/action/underwater/abyss_suit_end", "player", 0.0f, false);
		}
		
		// Kill off player
		else if (Sequence_DoStepAndWait(2.f))
		{
			if (cLux_GetExplorationModeActive() == false)
			{
				AttackMeter_AutoDamage(1.0f, 1.0f, true);
			}
			else
			{
				Sound_Fade("HeavyBreathing", 0.f, 0.2f);
				Player_SetHealth(0.f);
			}
		}
	
		Sequence_End();
	}
	
	//-------------------------------------------------------

	/////////////////////////////////////////
	// Scene 2 Event G Conversation Resumes
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	//-------------------------------------------------------

	/////////////////////////////////////////
	// Scene 2 Event H Flesher Breaks In
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	void SetupFlesher()
	{
		Light_SetVisible("FlesherSpot",false);
		Entity_SetActive("Flesher", false);
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceFlesherAttack;
	void SequenceFlesherAttack(const tString& in asName="")
	{
		Sequence_Begin("SequenceFlesherAttack", mSequenceFlesherAttack);
		
		if (Sequence_DoStepAndWait(0.2f))
		{
			/////////////////
			// Flesher Spawns
			
			cLux_AddDebugMessage("[Elevator] Flesher Attack");
			Sound_CreateAtEntity("LightsGlitch", "03_03_omicron_descent/SFX/elevator/lights_glitch", "Player", 0.0f, false, 1.0f);
			Entity_SetActive("Flesher", false);
			Map_GetEntity("Flesher").SetPosition(Map_GetEntity("Elevator").GetPosition());
			mbFlesherPulse = true;
			
			StartFlicker();
		}
		else if (Sequence_DoStepAndWait(0.8f))
		{
			Entity_SetActive("Flesher", true);
			Entity_PlayAnimation("Flesher", "visit_elevator",0.0f,false);
			Map_AddTimer("TimerFlesherDoorOpen", 7.4f, "TimerFlesherDoorOpen");
			
			Effect_Rumble_SetScreenShakeMul(1);
						
			///////////////////////////////
			// Setpiece audio start
			ElevatorAudio_RossAttackStage01();
		}
		else if (Sequence_DoStepAndWait(3.0f))
		{
			////////////////////////
			// Flesher Lands On Roof
			
			Light_SetVisible("FlesherSpot",true);
			
			Effect_Shake_Start(0.1f, 2.5f, 0.0f, 0.5f, cVector3f(0.5,1,0.5));
			Effect_Rumble_Start(0.7f,0.5f,0.1f,0.2f);
			
			mbFlesherAttacked = true;
		}
		else if (Sequence_DoStepAndWait(3.0f))
		{
			Effect_Shake_Start(0.05f, 2.0f, 0.0f, 1.0f, cVector3f(0.5,1,0.5));
			
			Effect_VideoDistortion_SetDirectAmount(1.0f);
			
			/*Dialog_Begin("CatherineFlesher");
				Dialog_AddBranchAndSubject("CatherineFlesher", "", "");
			Dialog_End();*/
		}
		else if (Sequence_DoStepAndWait(3.0f))
		{
			ElevatorAudio_RossAttackStage02();
			Effect_Shake_Start(0.1f, 1.0f, 0.0f, 0.5f, cVector3f(0.5,1,0.5));
			Effect_Rumble_Start(0.5f,0.5f);
		}
		else if (Sequence_DoStepAndWait(1.0f))
		{

		}
		else if (Sequence_DoStepAndWait(1.5f))
		{
			Effect_Shake_Start(0.1f, 1.0f, 0.0f, 0.5f, cVector3f(0.5,1,0.5));
		}
		else if (Sequence_DoStepAndWait(4.0f))
		{
			Voice_Play("FlesherThreaten");
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			Effect_TimeGlitch_Start(2, 0.0, 1.0f, true, 1.0f);
			mfFlesherPulseLevel = 0.8f;
			mfFlesherPulseVel = 1.0f;
			mfFlesherPulseMul = 2.0f;
			Entity_PlaceAtEntity("Flesher", "FlesherCloseUp");
		}		
		else if (Sequence_DoStepAndWait(0.0f))
		{
			SequenceStates_Resume("SequenceElevator");
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	float mfFlesherPulseLevel = 0.0f;
	float mfFlesherPulseVel = 1.0f;
	float mfFlesherPulseMul = 1.0f;
	
	void UpdateFlesherPulse(float afTimeStep)
	{
		mfFlesherPulseLevel+=afTimeStep*mfFlesherPulseVel;
	
		mfFlesherPulseVel= cMath_Clamp(mfFlesherPulseVel*cMath_RandRectf(0.9f,1.1f),0.5,1.0f);
		float fPulse = mfFlesherPulseLevel % 2.0f;
		if (fPulse>1.0f)
			fPulse=1.0f-(fPulse-1.0f);

		Entity_SetEffectBaseColor("Flesher",cColor_White*fPulse*mfFlesherPulseMul);
	}
	
	//-------------------------------------------------------
	
	void TimerFlesherDoorOpen(const tString& in asTimer)
	{
		Prop_SetStaticPhysics("RepElevatorDoor",false);
		SwingDoor_SetLocked("RepElevatorDoor",false,true);
		SwingDoor_SetClosed("RepElevatorDoor",false, true);
		SwingDoor_SetOpenAmount("RepElevatorDoor",0.1);
		Entity_AddForce("RepElevatorDoor", cVector3f(0,0,300), true, true);
	}
	
	//-------------------------------------------------------
	
	void SwitchElevatorLights(bool abOn, bool abEffects)
	{
		Lamp_SetLit("CageSpot*",abOn,abEffects);
		
		Light_SetVisible("Elevator_SpotLight_2",abOn);
		
		Terminal_SetGuiActive("TerminalElevatorStart",abOn);
		Terminal_SetGuiActive("TerminalElevatorMain",abOn);
		Terminal_SetGuiActive("TerminalElevatorDepth*",abOn);
		Entity_SetEffectsActive("CathSocket", abOn, abEffects);
		Entity_SetEffectsActive("CathTool", abOn, abEffects);
		
		Lamp_SetLit("ControlsLightGood", abOn, abEffects);
	}
	
	//-------------------------------------------------------
	
	bool mbFlickerState = false;
	
	//-------------------------------------------------------
	
	void StartFlicker()
	{
		mbFlickerState = true;
		TimerFlicker("");
	}
	
	//-------------------------------------------------------
	
	void TimerFlicker(const tString& in asTimer)
	{
		mbFlickerState = !mbFlickerState;
		SwitchElevatorLights(mbFlickerState, false);
		
		float fTimer = (mbFlickerState) ? cMath_RandRectf(0.1f, 0.5f) : cMath_RandRectf(0.2f, 0.5f);
		Map_AddTimer("TimerFlicker", fTimer, "TimerFlicker");
	}
	
	//-------------------------------------------------------
	
	void StopFlicker()
	{
		Map_RemoveTimer("TimerFlicker");
	}
			
	//-------------------------------------------------------
 
    /////////////////////////////////////////
    // ==============
    // PRELOAD
    // ==============
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	bool PreloadDisabled(bool abCheckIfPreloading = true)
	{
		if(cLux_ScriptDebugOn())
		{
			cLux_AddDebugMessage("PRELOAD DISABLED!"); 
			
			return true;
		}

		if(abCheckIfPreloading == true && Map_IsPreloading() == false)
			return true;
			 
		return false;
	}
	
	//-------------------------------------------------------
	
	void Preload()
	{
		if(PreloadDisabled(false)) return;
		
		Map_Preload("04_01_tau_outside.hpm");
	}
	
	//-------------------------------------------------------
	
	void PreloadDeload()
	{
		if(PreloadDisabled()) return;
		//Might use latr if adding a transfer area to make sure objects follow to next level.
	//	Map_Deload("transfer3341"); 
		//Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
	}
	
	//-------------------------------------------------------
	
	void PreloadFadeGlobal()
	{
		if(PreloadDisabled()) return;

		Map_AddTimer("FadeGlobal", 10, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	
	void PreloadChangeOfMap()
	{
		if(PreloadDisabled()) 
		{
			PreloadManualChangeMap();
			return;
		}
		
		Map_RemoveTimer("FadeGlobal");

		Map_AddTimer("ChangeMap", 0, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	bool mbGlobalCopyCompleted = false;
	void PreloadTimer(const tString &in asTimer)
	{
		////////////////////////////
		//Preload - Change map globals when possible.
		if(asTimer == "FadeGlobal")
		{
			if(mbGlobalCopyCompleted)
			{
				Map_Preset_Fade("Preset4.1", 20); 
				return;
			}
			
			mbGlobalCopyCompleted = Map_CopyGlobalSettings(Map_GetPreloadMap(), 20);
			
			Map_AddTimer("FadeGlobal", 20.1, "PreloadTimer");
		}

		if(asTimer == "ChangeMap")
		{
			Effect_Rumble_SetScreenShakeMul(1);
			if(Map_IsPreloadCompleted()) Map_ChangeMap("04_01_tau_outside.hpm", "PlayerStartArea_1", "", ""); //Map_ChangeMap("04_01_tau_outside.hpm", "", "transfer3341", "", "");
			else Map_AddTimer("ChangeMap", 0.1f, "PreloadTimer");
		}
	}
	
	//-------------------------------------------------------
	
	void PreloadManualChangeMap()
	{
		Effect_Rumble_SetScreenShakeMul(1);
		Map_ChangeMap("04_01_tau_outside.hpm", "PlayerStartArea_1", "", "");
	}

