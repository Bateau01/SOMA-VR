	//-------------------------------------------------------
	
	bool mbBioMechChipRepaired = false;
	bool mbBioMechChipExploded = false;
	bool mbDamagedChipPlaced = false;
	
	//-------------------------------------------------------
	
	void button_GelContainer_OnConnectionStateChange(const tString &in asEntity, int alState)
	{
		if (alState == -1) return;
		
		/////////////////////////////////////
		// Chip explodes the first time
		if (mbBioMechChipRepaired == false)
		{
			if (mbBioMechChipExploded) return;
			
			SequenceChipExplode("");
			mbBioMechChipExploded = true;
			return;
		}
		
		/////////////////////////////////////
		// Chip is now repaired, door can be opened
		SlideDoor_SetClosed("BioMech_GelDoor",false,false);
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceChipExplode;
	void SequenceChipExplode(const tString &in asTimer)
	{
		Sequence_Begin("SequenceChipExplode", mSequenceChipExplode);
			
		if (Sequence_DoStepAndWait(0.2))
		{
			SlideDoor_SetOpenAmount("BioMech_GelDoor",0.1f,false);
			Sound_Stop("BioMech_GelDoor_SlideDoorStart", 0.1f);
			
			Sound_CreateAtEntity("BioMech_GelDoor_Sweet","03_02_omicron_inside/SFX/gel_case/jammed","BioMech_GelDoor");
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			if(Sound_Exists("BioMech_GelDoor_SlideDoorStart"))
			{
				Sound_Stop("BioMech_GelDoor_SlideDoorStart", 0.1f);
			}
			
			Sound_CreateAtEntity("sound_elecfault","03_02_omicron_inside/gameplay/gel_chip/gel_chip_break","Area_ChipExplode_Effect");
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			mbFlashingServiceIndicator = true;
			ParticleSystem_CreateAtEntity("ChipSparks","elec_spark_physics_few_oneshot.ps","Area_ChipExplode_Effect",false);
		
			SwingDoor_SetLocked("FluidContainerFuseBox",false,false);
			SwingDoor_SetOpenAmount("FluidContainerFuseBox",0.1f);
			Entity_AddForceFromEntity("FluidContainerFuseBox","Area_ChipExplode_Effect",3.0f,false);
			Lamp_SetLit("incubator_chip_lamp", true, false);
		}
		
		else if (Sequence_DoStepAndWait(0.75))
		{
	        ParticleSystem_SetActive("biomech_chip_smoke", true);
	        ParticleSystem_SetActive("biomech_chip_spark", true);
			Entity_SetInteractionDisabled("FluidContainerFuseBox",false);
			Map_AddTimer("LabAlarmDisable", 10.f, "LabAlarmFinish");
			
			Sound_CreateAtEntity("IncubatorChipAlarm", "03_02_omicron_inside/gameplay/gel_chip/gel_chip_alarm", "TerminalBiomechIncubator");
		}
		else if (Sequence_DoStepAndWait(6))
		{
			cLux_AddTodoMessage("* Dialogue removed - review this *");
			/*Dialog_Begin("Catherine");
					Dialog_AddBranchAndSubject("4BChipExplodes","","");
			Dialog_End();*/
		}
		else if (Sequence_DoStepAndWait(0))
		{
		    ParticleSystem_Destroy("biomech_chip_smoke");
		}
		
		Sequence_End();
	}
	
