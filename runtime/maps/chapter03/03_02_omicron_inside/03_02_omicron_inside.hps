	//-------------------------------------------------------
	
	///////////////////////////////////
	// HANDLE BIOMECH DRAWERS / LOCKS 
	///////////////////////////////////
	
	//-------------------------------------------------------
	
	void button_biomech_drawerLock_OnConnectionStateChange(const tString &in asEntity, int alState)
	{
		if (alState != 1) return;
		
		int lDrawerNum = Entity_GetVarInt(asEntity,"");
		int lTargetCell = mlGelDispenserQueued;
		bool bDispensing = mbRobotArmLocked;
		bool bClosed = Slide_GetSlideAmount("IncubatorDrawer_"+lDrawerNum) <= 0.01f ? true : false;
		bool bLocked = Slide_GetLocked("IncubatorDrawer_"+lDrawerNum);
		bool bUnlockable = (mbRobotArmLocked && bDispensing && lTargetCell == lDrawerNum) ? false : true;
		bool bLockable = bClosed;
		
		/*cLux_AddDebugMessage("Pressed        : " + lDrawerNum);
		cLux_AddDebugMessage("DrawerClosed   : " + bClosed);
		cLux_AddDebugMessage("DrawerLocked   : " + bLocked);
		cLux_AddDebugMessage("DrawerLockable : " + bLockable);
		cLux_AddDebugMessage("Unlockable     : " + bUnlockable);
		cLux_AddDebugMessage("GelPouring     : " + bDispensing);
		cLux_AddDebugMessage("ArmInCell      : " + lTargetCell);*/
		
		//////////////////////////////////////////////
		// When attempting to unlock
		if (bLocked)
		{
			if (bUnlockable)
			{
				SetBiomechDrawerLocked(lDrawerNum, false);
				Sound_CreateAtEntity("LockAlter", "03_02_omicron_inside/SFX/chip_drawer/lock", asEntity, 0.0f, false, 1.0f);
			}
			else
			{
				Sound_CreateAtEntity("LockAlter", "Entities_Station/object/memchip_cylinder/memchip_cylinder_button", asEntity, 0.0f, false, 1.0f);
			}
		}
		
		////////////////////////////////////////////////
		// When attempting to lock
		if (bLocked == false)
		{
			if (bLockable)
			{
				SetBiomechDrawerLocked(lDrawerNum, true);
				Sound_CreateAtEntity("LockAlter", "03_02_omicron_inside/SFX/chip_drawer/lock", asEntity, 0.0f, false, 1.0f);
			}
		}
	}
	
	////////////////////////////////////////////////
	// Draw attention to the lock controls when interacting with a locked drawer
    void IncubatorDrawer_OnPlayerInteract(const tString &in asEntity)
    {
		bool bLocked = Slide_GetLocked(asEntity);
		int lDrawerNum = Entity_GetVarInt(asEntity,"");
		
		if(bLocked)
		{
			Lamp_SetFlickerActive("biomech_indicator_locked_"+lDrawerNum, true);
			Map_AddTimer("EnableLockedFlash", 2.0f, "LockedFlash");
			//Lamp_SetFlickerActive("biomech_indicator_locked_"+alDrawerNum, true);
		}
		else
		{
		}
    }
	
	void LockedFlash (const tString &in asTimer)
	{
        Lamp_SetFlickerActive("biomech_indicator_locked_*", false);
	}
	
	//-------------------------------------------------------
	
	void SetBiomechDrawerLocked(int alDrawerNum, bool abLocked)
	{
		//////////////////////////////
		// Simple helper for setting the biomech drawer lock
		Lamp_SetLit("biomech_indicator_locked_"+alDrawerNum,abLocked,true);
		Lamp_SetLit("biomech_indicator_open_"+alDrawerNum,!abLocked,true);
		Slide_SetLocked("IncubatorDrawer_"+alDrawerNum,abLocked,true);
	}
	
