	//-------------------------------------------------------
	
	//////////////////////////////////
	// Terminal *Pressure Chamber*  //
	//////////////////////////////////
	
	//-------------------------------------------------------
	float mfPressureChamberAmount = 200.0f;
	float mfPressureChamberMax = 200.0f;
	cColor mPressureFill;
	//-------------------------------------------------------
	
	void PressureChamberTerminal_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		/////////////////////////////////////////
		// Show standard lockdown message when unpowered
		if (!mbMainPowerRestored)
		{
			SecurityLockdownActive(asEntityName, afTimeStep);
			return;
		}
		
		StationGuiBG_Scanlines();
		
		/////////////////////////////////////////
		// Calculate Pressure and decrement when decompressing
		float fPressure = mfPressureChamberAmount / mfPressureChamberMax;
		
		if (ImGui_GetStateBool("Decompressing",false))
		{
			mfPressureChamberAmount -= afTimeStep * 10.0f;
			mfPressureChamberAmount = cMath_Clamp(mfPressureChamberAmount,0.0f,mfPressureChamberMax);
		}
		
		/////////////////////////////////////////
		// Unlock door when pressure is zero
		if (mfPressureChamberAmount <= 0.0f && ImGui_GetStateBool("PressureChamberOpen",false) == false)
		{
			ImGui_SetStateBool("PressureChamberOpen",true);
			SlideDoor_SetClosed("PressureChamberDoor",false,false);
			Map_RemoveTimer("timer_pressurechambervictim");
		}
			
		/////////////////////////////////////////
		// Pressure goes from green to red
		mPressureFill.a = 1.0f;
		mPressureFill.g = 0.0f + fPressure;
		mPressureFill.r = 1.0f - fPressure;
		mPressureFill.b = 0.0f;
		
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		
		cImGuiLabelData label = ImGui_GetDefaultLabel();
		label.mFontAlign = eFontAlign_Left;
		label.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.075);
		ImGui_SetDefaultLabel(label);
		
		cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
		gauge.mOrientation = eImGuiGaugeOrientation_Vert;
		gauge.mbUseBackgroundGfx = true;
		gauge.mGfxFill.mColor = mPressureFill;
		
		cImGuiButtonData button = StationGui_CreateDefaultButtonData();
		button.mFont.mvSize = cVector2f(24);
		ImGui_SetDefaultButton(button);
		
		tString sPressure = ""+mfPressureChamberAmount;
		int lDotPos = cString_GetLastCharPos(sPressure, '.');
		sPressure = cString_Sub(sPressure, 0, lDotPos+3);
		
		ImGui_DoWindowStart("PressureStatus", window, ImGui_NrmPosGroup(cVector3f(0.1, 0.1, 3)), ImGui_NrmSizeGroup(cVector2f(0.8, 0.8)));
		
			///////////////////////////
			// Show pressure gauge
			ImGui_DoGauge(gauge,fPressure,ImGui_NrmPosGroup(cVector3f(0.1,0.1,3)), ImGui_NrmSizeGroup(cVector2f(0.1f,0.8f)));
			
			/////////////////////////////////
			// Grey out the decompression button if already started
			ImGui_SetModUseInput(!ImGui_GetStateBool("Decompressing",false));
			if (ImGui_DoButton("button_decompress","DECOMPRESSION",ImGui_NrmPosGroup(cVector3f(0.275,0.65,3)),ImGui_NrmSizeGroup(cVector2f(0.65f,0.25f))))
			{
				ImGui_SetStateBool("Decompressing", true);
				Sound_CreateAtEntity("DecompressionSequence", "03_02_omicron_inside/SFX/decompression_sequence/machine_decomp", "DecompSoundSource");
			}
			
			ImGui_DoLabel("PRESSURE",ImGui_NrmPosGroup(cVector3f(0.3,0.055,3)),ImGui_NrmSizeGroup(cVector2f_MinusOne),1.0f);
			
			////////////////////////////
			// Display current pressure numerically
			ImGui_SetTransCategory("");
			ImGui_DoLabel(""+sPressure+ " atm",ImGui_NrmPosGroup(cVector3f(0.3,0.15,3)),ImGui_NrmSizeGroup(cVector2f_MinusOne),1.0f);
			
		ImGui_DoWindowEnd();
	}
	
