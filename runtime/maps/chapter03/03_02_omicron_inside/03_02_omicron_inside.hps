	//-------------------------------------------------------
	
	/////////
	// De-Activate Kitchen Corpse
	bool CollideAreaDeactivateKitchenCorpse(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		Map_AddTimer("timer_remove_kitchenscares",2.0f,"TimerRemoveKitchenCorpse");
		return false;
	}
	
	//-------------------------------------------------------
	
	void TimerRemoveKitchenCorpse(const tString &in asTimer)
	{
		// Disable corpse when the player is not looking
		if (Entity_IsInPlayerFOV("corpse_kitchen"))
		{
			Map_AddTimer("timer_remove_kitchenscares",2.0f,"TimerRemoveKitchenCorpse");
			return;
		}
		
		Entity_SetActive("corpse_kitchen",false);
		Entity_SetActive("KitchenMaggots_*",false);
		ParticleSystem_Destroy("particle_flies");
		Sound_Fade("sound_flies_corpse",0.0,1.0);
	}
	
