	bool mbReminderActive_LeaveWithChip=false;
	
	bool CollideStartDiveRoomBanter(const tString &in asParent, const tString &in asChild, int alState)
	{
		/////////////////////////////////////
		// Leave with chip
		if(mbReminderActive_LeaveWithChip)
		{
			Voice_Play("4_LeaveWithChip",-1, "", 1);
			mbReminderActive_LeaveWithChip=false;
		}
		
		return true;
	}
	
