			Map_AddTimer("CubeEerieSounds",cMath_RandRectf(3.0f,5.0f),"CubeEerieSounds");
		}
		else
		{
			cLux_AddDebugMessage("Stop eerie sound timer");
			Map_RemoveTimer("CubeEerieSounds");
		}
		return true;
	}
	
	void CubeEerieSounds(const tString &in asTimer)
	{
		if(mlPuzzleItemsGathered == 0 && mbMidSectionLockdownReleased == true)
