	//--------------------------------------------
		
	void FadeUpCubeMusic(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 5.0f, eSoundEntryType_World);
	}
	bool mbCubeMusicStartActive = false;
	void LineOver_RossSpeaksFirstTime(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStart)
	{
		if(abStart)
		{
			Sound_FadeGlobalVolume(0.65f, 1.0f, eSoundEntryType_World);
		}
		
		else if (abStart==false)
		{
			Music_Play("04_03_ross_killyourself", 0.65f, false, eMusicPrio_BigEvent);
			Sound_FadeGlobalVolume(0.65f, 3.0f, eSoundEntryType_World);
			Map_AddTimer("FadeUpFromCubeMusic", 6.0f, "FadeUpCubeMusic");
			Map_AddTimer("CubeMusicGracefulFade", 30.0f, "CubeMusicGracefulFade");
			Sound_FadeGlobalVolume(1.0f, 6.0f, eSoundEntryType_World);
			mbCubeMusicStartActive = true;
		}
	}
	
	void CubeMusicGracefulFade(const tString &in asTimer)
	{
		if(mbCubeMusicStartActive==true)
		{
			Music_Stop(6.0f, eMusicPrio_BigEvent);
			mbCubeMusicStartActive = false;
		}
	}

