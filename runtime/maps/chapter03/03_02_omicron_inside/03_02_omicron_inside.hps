	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceDispenseGelAndRepairChip;
	void SequenceDispenseGelAndRepairChip(const tString &in asName)
	{
		Sequence_Begin("SequenceDispenseGelAndRepairChip", mSequenceDispenseGelAndRepairChip);
		
		/////////////////////////////
		// Start dispensing gel
		if (Sequence_DoStepAndWait(4.0f))
		{
			///////////////////////////////////////////
			// Create gel particles
			ParticleSystem_CreateAtEntity("particle_gel_"+msTargetGelParticleArea, "03_02_structure_gel_drops.ps", msTargetGelParticleArea, true);
			
			Entity_SetActive("ChipTool_PreRepair",false);
			Entity_SetActive("ChipTool_Repaired",true);
			//Entity_SetEffectsActive("ChipTool_Repaired",true, true);
		}
		if (Sequence_DoStepAndWait(1.0f))
		{
		    ///////////////////////////////////////////
			// Stop particles
			ParticleSystem_Destroy("particle_gel_"+msTargetGelParticleArea);
		    ParticleSystem_CreateAtEntity("particle_zap_"+msTargetGelParticleArea, "03_02_structure_gel_zap.ps", msTargetGelParticleArea, true);
			Sound_CreateAtEntity("Zap", "Entities_Station/object/controllable_robot_arm/gel_spark", msTargetGelParticleArea);
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			mbRobotArmLocked = false;
			Sound_Stop("Zap", 0.25f);
			Entity_PlayAnimation("ChipTool_Repaired", "grow", 0.1f, false, false);
		}
		else if (Sequence_DoStepAndPause())
		{
			//////////////////////////////////////////
			// Chip is repaired, drawer is unlocked
			mbBrokenChipInserted = false;
			
			//////////////////////////////////////////
			// Simon comments on repairing the chip
			cLux_AddTodoMessage("* Dialogue removed - review this *");
			/*if (mbCommentOnRepairedChip == false)
			{
				Voice_Play("4FRepairChip");
				mbCommentOnRepairedChip = true;
			}*/
			Button_SetSwitchedOn("biomech_dispenser_button",false,true);
			Entity_SetInteractionDisabled("biomech_dispenser_button",false);
			Entity_PlayAnimation("robot_arm_1","going_up",0.1f,false,false,"");
			cLux_AddTodoMessage("SOUND: Robot arm retracts!");
		}
		Sequence_End();
	}
	
