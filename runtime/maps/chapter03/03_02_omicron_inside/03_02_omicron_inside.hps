	//-------------------------------------------------------

	/////////////////////////////////////////
	// Scene 2 Event D *Plug in Catherine and get back some power*
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	//-------------------------------------------------------
	bool mbCathLightFlashingSound = false;
	void TimerDiveroomCathLamp(const tString &in asTimer)
	{
		////////////////////////////////////
		// Flash lamp to draw attention if Catherine is not inserted
		if (mbCatherineInserted == false)
		{
			bool bLit = Lamp_GetLit("DiveRoomCathLamp");
			Lamp_SetLit("DiveRoomCathLamp",!bLit,true);
			Map_AddTimer("timer_diveroomcathlamp",2.0f,"TimerDiveroomCathLamp");
			
			if(mbCathLightFlashingSound==false)
			{
				Sound_CreateAtEntity("CathLight", "Entities_Station/object/siren_alarm/upsilon_blink", "CathToolLightSoundSource");
				mbCathLightFlashingSound = true;
			}
			return;
		}
		
		////////////////////////////////////
		// Otherwise turn light off
		Lamp_SetLit("DiveRoomCathLamp",false,true);
		Sound_Stop("CathLight", 0.1f);
		mbCathLightFlashingSound = false;
	}
	
	//-------------------------------------------------------
	
	bool OnUseCathTool(const tString &in asTool, const tString &in asEntity)
	{
		cLux_AddDebugMessage("TOOL USED");
		
		///////////////////////////////////////////////
		// Player inserts Catherine
		if (asEntity == "omnislot_inside_1")
		{
		
			//Entity_SetInteractionDisabled("CathTool_Placed",true);
			CathTool_Insert("CathTool_Placed","omnislot_inside_1");
			
			////////////////////////////////////
			//Fade out eerie music if still playing
			Music_Stop(5.0f, eMusicPrio_BgAmb);
			Sound_Stop("DiveRoomWhispers", 2.0f);
			Map_RemoveTimer("Timer_DiveRoomSpookyWhispers");
			cLux_AddDebugMessage("Stopping music and dive room whispers");
			
			////////////////////////////////////
			// Begin conversation with Catherine
			Dialog_StartConversation_PosBased("Catherine", "CatherineFocalPoint", "CathConvArea");
			Dialog_Begin("Catherine");
					Dialog_AddBranchAndSubject("2DCatherineActivates","","RestorePower");
			Dialog_End();
			
			mbMainPowerRestored = true;
			mbCatherineInserted = true;
			
			Button_SetDisabled("diveroom_airlockpanel_1",false,true);
			
			///////////////////////////////////////////
			// Turn on containment computer
			Terminal_SetAllowInteraction("ContainmentComputer",true);
		}
		
		return true;
	}
	
	//-------------------------------------------------------
	
	void SimonLookAtHands(const tString &in asScene, const tString &in asSubject, int alLineIndex, bool abStartOfLine)
	{
		if (!abStartOfLine) return;
			PlayerHands_PlayAnimation("event_look_at_hands_2_1");
	}
	
	//-------------------------------------------------------
	
	void RestorePower(const tString&in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		
		/////////////////////////
		//Little delay to allow for sound to whirr up
		Map_AddTimer("DiveRoomLightsOn", 0.25f, "DiveRoomPower");
		
		/////////////////////////
		//Dive room power on
		Sound_CreateAtEntity("DiveRoomPowerOn", "03_02_omicron_inside/SFX/lockdown_release/suit_room", "Player", 0.0f, false, 1.0f);
		
		/////////////////////////
		// Schedule reminders for player
		Map_AddTimer("timer_suitreminder",cMath_RandRectf(30,35),"TimerSuitReminder");
	}
	
	//-------------------------------------------------------
	
	void DiveRoomPower(const tString &in asTimer)
	{
		////////////////////////////
		// Dive room lights come on
		SetLevelLockdownLights(false,"DivePrep");
		OpenShutters("DivePrep", false);
		
		////////////////////////////
		// Lockers are now accessible
		SwingDoor_SetLocked("03_02_diving_suit_locker_door_*",false,false);
		SwingDoor_SetLocked("DiveLocker_Door",false,false);
		
		Entity_SetInteractionDisabled("DiveLocker_Door",false);
		Entity_SetInteractionDisabled("03_02_diving_suit_locker_door_*",false);
	}
	
	//-------------------------------------------------------
	
