	//--------------------------------------------------------------------
	
	void TerminalBiomechCamera_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		tString sCamName = "BiomechCamera_"+mlIncubatorCamera;
		cImGuiGfx gfx(sCamName, eImGuiGfx_Special);
		ImGui_DrawGfx(gfx, ImGui_NrmPos(cVector3f(0.0f,0.0f,0.0f)), ImGui_NrmSize(cVector2f(1.0f,1.0f)), cColor(1.0,1.0,1.0,1.0f));
		
		cImGuiLabelData labelRecording;
		labelRecording.mColorBase = cColor_Red;
		
		StationGuiBG_Scanlines();
		//StationGuiBG_Backdrop();
		
		////////////////////////////////
		// Image declarations
		cImGuiGfx staticImage;
			
		if (mfIncubatorStaticTime > 0.0f)
		{
			mfIncubatorStaticTime -= afTimeStep;
			int lStatic = cMath_RandRectl(0,1);
			staticImage.SetFile("station/static/static_"+lStatic);
			ImGui_DoImage(staticImage,ImGui_NrmPos(cVector3f(0.0,0.0,7.0)),ImGui_NrmSize(cVector2f(1.0,1.0)));
		}
		
		
		tString sCellLangEntry = "Biomech_Cell"+mlIncubatorCellText;
		ImGui_DoLabel(sCellLangEntry,ImGui_NrmPos(cVector3f(0.025,0.025,10.0)),cVector2f_MinusOne,5.0f);
		
		ImGui_SetTransCategory("");
		ImGui_DoLabel("REC",ImGui_NrmPos(cVector3f(0.8,0.025,10.0)),cVector2f_MinusOne,5.0f);
		
		
		///////////////////////////////////////
		// Flashing dot
		float fDotTimer = ImGui_GetStateFloat("RecordingTimer",0.0f);
		if (fDotTimer > 0.5f)
		{
			ImGui_DoLabelExt(".",labelRecording,ImGui_NrmPos(cVector3f(0.725,-0.05,10.0)),cVector2f_MinusOne,8.0f);
		}
		
		fDotTimer += afTimeStep;
		if (fDotTimer > 1.25f) 
			fDotTimer = 0.0f;
			
		ImGui_SetStateFloat("RecordingTimer",fDotTimer);
		
		ImGui_SetTransCategory("03_02_omicron_inside");
			DoRobotArmError(asEntityName);
		
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////////////////
	// Terminal *Biomech Structure Gel Incubator* //
	////////////////////////////////////////////////
	
	//-------------------------------------------------------
	bool mbFlashingServiceIndicator = false;
	float mfServiceFlash = 0.0f;
	//-------------------------------------------------------
	
	void TerminalBiomechIncubator_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		mfServiceFlash -= afTimeStep;
		ImGui_SetTransCategory("");
		
		//////////////////////////////
		// Window data
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		window.mColorBase = gStationGuiColor_Normal;
		window.mFont.mvSize = cVector2f(18);
		
		////////////////////////////
		// Text
		cImGuiTextFrameData textData = ImGui_GetDefaultTextFrame();
		textData.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
		textData.mbUseBackgroundGfx = false;
		textData.mFont.mvSize = cVector2f(32);
		textData.mFontAlign = eFontAlign_Left;
		
		
		/////////////////////////////////
		// Button
		cImGuiButtonData button = StationGui_CreateDefaultButtonData();
		button.mFont.mvSize = cVector2f(24);
		
		/////////////////////////////////
		// Backdrop
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
	
		ImGui_SetTransCategory("03_02_omicron_inside");
	
		ImGui_DoWindowStart("", window, ImGui_NrmPosGroup(cVector3f(0.05,0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.9)));
		
			if (mbBioMechChipExploded && !mbBioMechChipRepaired && mbFlashingServiceIndicator)
			{
				cStationGui_BigStatusMessageSettings settings;
				settings.mbBlinking = mfServiceFlash > 0;
				StationGui_BigStatusMessage("ChipExploded", settings);
			}
			else
				ImGui_DoTextFrameExt("ChipInserted", ImGui_NrmSizeGroup(cVector2f(0.05, 0.5)), 5, 0, textData, ImGui_NrmPosGroup(cVector3f(0, -0.4, 0.1)), ImGui_NrmSizeGroup(cVector2f(1.25,1.25)));
		
		if (mbBioMechChipRepaired || !mbBioMechChipExploded)
		{
			if (ImGui_DoButtonExt("ButtonIncubator","ButtonIncubator",button,ImGui_NrmPosGroup(cVector3f(0.15, 0.75, 0.1)),ImGui_NrmSizeGroup(cVector2f(0.75,0.175))))
			{
				if (mbBioMechChipRepaired)
				{
					/////////////////////////////////////
					// Chip is now repaired, door can be opened
					bool bOpen = (SlideDoor_GetOpenAmount("BioMech_GelDoor") > 0.1f) ? true : false;
					SlideDoor_SetClosed("BioMech_GelDoor",bOpen,false);
				}
				else
				{
					SequenceChipExplode("");
					mfServiceFlash = 4;
					mbBioMechChipExploded = true;
				}	
			}
		}
		
		ImGui_DoWindowEnd();
	}
	
