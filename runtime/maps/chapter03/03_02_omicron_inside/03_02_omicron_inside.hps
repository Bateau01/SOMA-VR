	void BeginIntro()
	{
		if (mbIntroDone) return;
		
		mbIntroDone = true;
		SequenceIntro("");
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceIntro;
	void SequenceIntro(const tString &in asTimer)
	{
		Sequence_Begin("SequenceIntro", mSequenceIntro);
			
		///////////////////////////
		// Hold screen black for a few seconds while playing sounds
		if (Sequence_DoStepAndWait(0.5))
		{
		//	Sound_SetGlobalVolume(0, eSoundEntryType_WorldAll);
		//	Effect_Fade_Out(0);
		//	Player_SetMoveSpeedMul(0);
		//	Map_SetUnderwater(true,true);
			
		}
		else if (Sequence_DoStepAndWait(0.0))
		{
		//	Player_SetMoveSpeedMul(1);
		//	Map_SetUnderwater(false,true);
		//	Effect_Fade_In(6.0f);
		//	Sound_FadeGlobalVolume(1.0f, 6.0f, eSoundEntryType_WorldAll);
			////////////////////////
			//faux airlock
		//	Depth_Audio_PlayLeaveWater();
		//	Depth_Audio_AirlockDrainLoopUWStop();
		//	Depth_Audio_AirlockDrainLoopAir();
		//	Map_AddTimer("AirlockDrainingAirStopTimer", 4.0f, "AirlockDrainingAirStop");
		//	Effect_Screen_Start("water_drip_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 1, 2, 1);
		}
		else if (Sequence_DoStepAndWait(0.8))
		{
		// turn off first effects
			Voice_Play("1EnterLevel");
		//	ParticleSystem_Destroy("first_airlock_drain_particles_*");
		}
		else
		{
			SlideDoor_SetClosed("slidedoor_medium_vertical_airlock_1", false);
			
		// turn off second effects effects
		 //   ParticleSystem_Destroy("second_airlock_drain_particles_*");
		}
		
		Sequence_End();
	}
	
