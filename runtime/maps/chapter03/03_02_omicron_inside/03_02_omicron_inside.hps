	//-------------------------------------------------------
	
	void KillSimon()
	{
		cLux_AddDebugMessage("Simon has been terminated");
		
		//////////////////////////
		// Simons death 
		cLux_AddTodoMessage("SOUND: Simon dies...");
		Sound_Stop("SimonBreathing",1.0f);
		Sound_Stop("SimonOldCopy_AnimEvent",0.25f);
		
		Map_RemoveTimer("TimerSimonBreath");
		mbSimonKilled = true;
		Entity_PlayAnimation("SimonOldCopy", "death", 0.1f, false, false);
		Map_AddTimer("EnableDrainSimonEyes", 4, "DrainSimonEyes");
		
		///////////////////////
		// Music
		Music_Play("03_02_originalsimon", 0.55f, false, eMusicPrio_BigEvent);
		Map_AddTimer("KilledSimonSadMusic", 17, "Timer_KilledSimonSadMusic");
		
		///////////////////////////////////
		// Set bool for use in later levels
		cScript_SetGlobalVarBool("PlayerKilledOmicronSimon", true);
	}
	
