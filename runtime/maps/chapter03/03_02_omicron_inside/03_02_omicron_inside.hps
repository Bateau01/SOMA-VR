	//-------------------------------------------------------
	bool mbBiolabMaggots = false;
	//-------------------------------------------------------
	
	void biolab_tap_OnConnectionStateChange(const tString &in asEntity, int alState)
	{
		cLux_AddTodoMessage("SOUND: Taps in the biolab");
		tString sTargetArea = Entity_GetVarString(asEntity,"");
		
		///////////////////
		// Tap on
		if (alState == 1)
		{
			Sound_CreateAtEntity("TapRunning"+sTargetArea,"Entities_Urban/toilet/sink_toilet_tap/interact",sTargetArea,0,false);
			ParticleSystem_CreateAtEntity("Particles_TapStream"+sTargetArea,"toilet_sink_stream.ps",sTargetArea,false);
	
		}
		
		///////////////////
		// Tap off..
		if (alState == -1)
		{
			Sound_Stop("TapRunning"+sTargetArea,0);
			ParticleSystem_Destroy("Particles_TapStream"+sTargetArea);
			
			if (mbBiolabMaggots)
			{
				mbBiolabMaggots = false;
				Map_AddTimer("timer_nomaggots",5.0f,"TimerRemoveBiolabMaggots");
			}
		}
	}

