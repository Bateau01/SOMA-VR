	//{//////////////////////////////////////
	
	//--------------------------------------------
	
	bool mbInteractingWithBiomechJoystick = false;
	
	//--------------------------------------------
	
	void Setup()
	{	
		GetBase().SetDisplayNameEntry("03-02-omicron-inside");
		RichPresence_SetCurrent(eRichPresence_SiteOmicron );		
		
		////////////////////////////
		//3.3 Preset
		Map_Preset_SetupBloom("3.3Preset", 160, 0.00001f, 0, cColor(0.3f, 0.3f, 0.3f, 1));
		Map_Preset_SetupDepthOfField("3.3Preset", true, 0, 6, 0.1);
		Map_Preset_SetupColorGrading("3.3Preset", "textures/colorgrading/grading_default.dds");
		Map_Preset_SetupToneMapping("3.3Preset", 0.5, 1.5, 3.5);
		
		Effect_Bloom_FadeBrightPass(0.65f, 2);
        Effect_Bloom_FadeBloomWidth(128, 2);
        Effect_Bloom_FadeBloomFalloff(0.5f, 2);
        Effect_Bloom_FadeBloomTint(1, 1, 1, 2);
	}

	//--------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		CathTool_ResetScreen(eCathToolVariant_CathDelta);
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			//Add any debug stuff here
			
			cLux_SetDebugInfoWindowText("Text that should show up when pressing F1");
		}
		
		Map_AddTimer("timer_fleshernoises",5.0f,"TimerFlesherSounds");
		Tool_PickUp("CathTool",false,false);
		
		//todo: speak to Peter about this! This shouldn't be here
		Entity_WakeUp("PowerGeneratorButton");
		Entity_SetAutoSleep("PowerGeneratorButton",false);
		Entity_SetAutoSleep("03_02_worker_medium_maintenance_front_open_1",false);
		
		SetupLights();
		SetupFlesherEvents();
		SetupRobotArm();
		SetupRobotRepair();
		SetupDiveSuit();
		SetupSecurityConsole();
		SetupIncubatorCameras();
		SetupSineWaves();
		SetupDivePrepTerminal();
		SetupPowerRoom();
		SetupMirror();
		
		///////////////////////
		//Sound preloads
		Sound_PreloadProject("03_02_omicron_inside");
		Sound_PreloadGroup("Flashback/Ross/3.2", true);
		Sound_PreloadGroup("Flashback/Level/03_02", true);
		
		//////////////////////////////////////////
		// Periodically allow the Flesher to speak to player
		//Map_AddTimer("Timer_FlesherSpeak",cMath_RandRectf(5.0f,10.0f),"FlesherSpeakTimer");
		Map_AddTimer("timer_robotmanbreath",cMath_RandRectf(5.0f,7.0f),"TimerRobotManBreath");
		
		//Player_SetAmbientLight_None(true);
		Player_SetAmbientLight_Indoors(true);
		Light_SetVisible("NextLevelBoxLIght", false);
		
		Map_SetEnvironmentParticlesActive(false);
		Map_SetEnvironmentParticleVisible("*", false);
			
		PlayerHands_SetHandModel_Diving();
		PlayerHands_PreloadHandModel_DeepSea();
		
		//Voice_SetSource("Catherine", "Player", 2, 20, true, 20);
		
		Entity_WakeUp("agent_*");
		Entity_SetAutoSleep("agent_*",false);
		
		///////////////////////////
		// Set Ross always visible
		MakeRossAppear();
		
		///////////////////////
		//Particle init
		ParticleSystem_SetActive("coldstorage_open_*", false);
		ParticleSystem_SetActive("biomech_chip_smoke", false);
		ParticleSystem_SetActive("biomech_chip_spark", false);
		ParticleSystem_SetActive("first_airlock_drain_particles_*", false);
		ParticleSystem_SetActive("second_airlock_drain_particles_*", false);
		ParticleSystem_SetActive("brain_insert_splash", false);
		ParticleSystem_SetActive("exti_airlock_flood_effects_*", false);
		ParticleSystem_SetActive("exti_airlock_flood_effects2_*", false);
		ParticleSystem_SetActive("exti_airlock_flood_effects3_*", false);
		ParticleSystem_SetActive("exti_airlock_flood_effects4_*", false);
		ParticleSystem_SetActive("glass_smash_effect_*", false);
		
		FogArea_SetVisible("03_03_airlock_fog",false);
		
		///////////////////////
		//Entity init
		//Entity_SetActive("wau_and_rat_alive", false);
		Entity_SetEffectsActive("wau_and_rat_alive", false, false);
		Entity_PlayAnimation("wau_and_rat_alive", "dead_2", 0, false, false);
		
		Lamp_SetFlickerActive("ceiling_large_single_65", false);
		
		
		////////////////////////
		// Facts from previous maps
		mbRadioPlayedInSubstation = cScript_GetGlobalVarBool("SubstationRadioPlayed");
		
        Entity_SetInteractionDisabled("power_box_1", true);
		
		LastOnSoma_SetText("03_02_omicron_inside_1");
		
		// Disable this from transferring
		Prop_SetAllowMapTransfer("Panel_Airlock_Omnitool_7994", false);
		Prop_SetAllowMapTransfer("CathTool_Placed",false);
		
		/////////////////////////
		// Eye tracking
		EyeTracking_RegisterEntity("DatamineCorpse_2", true, false, true, 15.0f, 3.0f);
		EyeTracking_RegisterEntity("DatamineCorpse_1", true, false, true, 15.0f, 3.0f);
		EyeTracking_RegisterEntity("DatamineCorpse", true, false, true, 15.0f, 3.0f);
		EyeTracking_RegisterEntity("patchwork_spook", true, false, true, 15.0f, 3.0f);
		EyeTracking_RegisterEntity("DatamineCorpse_5", true, false, true, 15.0f, 3.0f);
		EyeTracking_RegisterEntity("DatamineCorpse_3", true, false, true, 15.0f, 3.0f);
		EyeTracking_RegisterEntity("DatamineCorpse_4", true, false, true, 15.0f, 3.0f);
		// Disables coll for final door blocker used in explo mode	//clux_GetExplorationModeActive()
		Entity_SetCollide("FinalDoorBlocker_2", false);
		Entity_SetCollideCharacter("FinalDoorBlocker_2", false);
		
		Entity_SetCollide("TunnelChaseBlocker", false);
		Entity_SetCollideCharacter("TunnelChaseBlocker", false);
		
		if (cLux_GetExplorationModeActive() == false)
		{
			Entity_SetActive("FinalDoorBlocker_2", false);
			Entity_SetActive("TunnelChaseBlocker", false);
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
        // S26BC: physical surface -> exact native tool-use target; refreshed on save entry.
        Entity_SetVarString("Panel_Airlock_Omnitool_7994", "VRUseTarget", "Area_OmniTool");
        // Inbound scenery has no use branch/change callback in this map.
        Entity_SetVarBool("SideAirlockButton", "VRPhysicalOmniDisabled", true);

		// S26P: this map's entity metadata names PowerCube_Inserted_OnPlayerInteract,
		// but no such callback exists. Remove only this stale generic interaction
		// hook in VR. The separate Pickup/Use/CanBeUsed callbacks still own the story.
		cScript_SetGlobalReturnBool(false);
		cScript_RunGlobalFunc("MenuHandler","cScrMenuHandler","HPL3VR_GetRuntimeActive");
		if(cScript_GetGlobalReturnBool()) Entity_SetPlayerInteractCallback("PowerCube_Inserted","",false);

		MainMenu_SetBGPhase(eMainMenuPhase_2_4_To_3_3);
		
		//Effect_Fade_Out(0);
	//	Effect_Fade_In(5);
		BeginIntro();
		
		Entity_PlayAnimation("patchwork_spook","lying",0.0f,true);
		
		iPhysicsWorld @pWorld = cLux_GetCurrentMap().GetPhysicsWorld();
		cLux_AddDebugMessage("WorldSize: "+pWorld.GetWorldSizeMin()+ " - "+pWorld.GetWorldSizeMax());
		
		//Voice_SetSource("Catherine", "Player", 2, 20, true, 20);
	}

