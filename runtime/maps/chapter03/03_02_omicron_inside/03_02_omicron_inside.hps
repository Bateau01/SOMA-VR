			Sound_CreateAtEntity("CubeEerieWindowSound","03_02_omicron_inside/AMB/spot/window_rub","CubeEerieSoundSource");
			Map_AddTimer("CubeEerieSounds", cMath_RandRectf(6.0f,12.0f), "CubeEerieSounds");
		}
		
	}
	
