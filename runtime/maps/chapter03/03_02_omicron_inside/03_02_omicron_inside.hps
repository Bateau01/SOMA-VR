	//-------------------------------------------------------
	
	void ActivateScanChair()
	{
		Entity_SetActive("Area_ScanChair",true);
		
		if (mbFirstTimeActivatingSeat)
		{
			Dialog_Begin("Catherine");
				Dialog_AddBranchAndSubject("10GTakeSeat","","");
			Dialog_End();
			mbFirstTimeActivatingSeat = false;
		}
		else
		{
			Dialog_Begin("Catherine");
				Dialog_AddBranchAndSubject("10GTakeSeatSecondTime","","");
			Dialog_End();
		}
		
		Map_AddTimer("timer_remindseat",cMath_RandRectf(10.0f,15.0f), "TimerRemindPlayerToSit");
	}
	
	//--------------------------------------------------------
	
	void TimerRemindPlayerToSit(const tString &in asTimer)
	{
		if (mlSeatReminders > 2) return;
		
		if (Voice_CharacterIsSpeaking("Player") || Voice_CharacterIsSpeaking("Catherine") || Voice_CharacterIsSpeaking("Player"))
		{
			Map_AddTimer("timer_remindseat",cMath_RandRectf(10.0f,15.0f), "TimerRemindPlayerToSit");	
		}
		else
		{
			//////////////////////////////////////////
			// Player is reminded to sit by Catherine
			tString sSubject = "";
			if (mbFirstSitting)
			{
				sSubject = "10F_SeatRemindersA" + mlSeatReminders;
			}
			
			////////////////////////////////////////
			// Different subject used if the player has already sat down before
			else
			{
				sSubject = "10F_SeatRemindersB" + mlSeatReminders;
			}
			
			Voice_Play(sSubject);
			mlSeatReminders++;
			
			Map_AddTimer("timer_remindseat",cMath_RandRectf(10.0f,15.0f), "TimerRemindPlayerToSit");
		}
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////////////////
	// Scene 10 - Event G - Sit down in chair and start transfer
	////////////////////////////////////////////////
	
	//-------------------------------------------------------
	
	int mlid_Vignette = 0;
	int mlid_RadialBlur = 0;
	int mlid_ScanLines = 0;
	
	bool mbScanWillSucceed = false;
	bool mbFirstSitting = true;
	bool mbScanPreviouslyFailed = false;
	
	bool mbFirstForcedFailure = true;	// set to false if scan should fail first time. (read as : have we forced it?)
	bool mbCypherIncorrect = false;
	int mlCorrectCypher = -1;
	
	//-------------------------------------------------------
	
	void SetupScanChair()
	{
		mlCorrectCypher = 2;
	}
	
	//-------------------------------------------------------
	
	void InteractScanChair(const tString &in asEntity)
	{
		/*	notes
		    if (mlDataFlowType == 2) msDataFlow = "TransferContBurst";
			if (mlDataAlignmentType == 3) msDataAlignment = "Data2048BE";
			if (mlDataCypherType == 2) msDataCypher = "Cypher3";
		
		 	<Entry Name="Cypher1">4D5A</Entry> = 0
			<Entry Name="Cypher2">D54B</Entry> = 1
			<Entry Name="Cypher3">5D4F</Entry> = 2
			<Entry Name="Cypher4">5D4E</Entry> = 3
		*/
		
		//**********************************
		cLux_AddDebugMessage("IMPORTANT: If forced scan failure is desired, set mbFirstForcedFailure to false");
		//**********************************
		
		if (mbFirstForcedFailure == false)
		{	
			////////////////////////////////////////////
			// The first time the scan runs, it will fail (Catherine screws up)
			mbFirstForcedFailure = true;
			mbScanWillSucceed = false;
		}
		else
		{
			////////////////////////////////////////////
			// Otherwise determine if scan will succeed based on matching the correct cypher
			mbScanWillSucceed = mbSineWaveAligned; //(mlDataFlowType == 2 && mlDataAlignmentType == 3 && mlDataCypherType == 2) ? true : false;		
		}
		
		cLux_AddDebugMessage("Scan will succeed? " + mbScanWillSucceed);
	 
		//////////////////////////////////////////////
		// Player sits down after interacting with chair
		CameraAnimation_Begin("SitAnim", "", false);
		Entity_PlaceAtEntity("Player", "SafePlayerArea");
		
		Sound_CreateAtEntity("sound_sit_down", "00_06_lab/VIPScriptedEvents/Camera_Anim_sitinchair", asEntity, 0, false);
		
		Entity_SetActive("Area_ScanChair",false);
		
		Voice_StopAll();
		Map_AddTimer("timer_chairspeak",2.5f,"TimerScheduleSittingConversation");
		Map_RemoveTimer("timer_remindseat");
	}
	
	//-------------------------------------------------------
	
	bool SitAnim_OnTurnHead(const tString &in asEntity, int alDirection)
	{
		if (alDirection == 1)
		{
			Entity_SetActive("SimonHands", true);
			Entity_SetActive("SimonLegs", true);
			Entity_PlayAnimation("SimonHands","chair_01_01_scan",0.0,true);
		}
		
		return true;
	}
	
	//-------------------------------------------------------
	
	void TimerScheduleSittingConversation(const tString &in asTimer)
	{
		if (Voice_CharacterIsSpeaking("Player") || Voice_CharacterIsSpeaking("Catherine"))
		{
			Map_AddTimer("timer_chairspeak",1.5f,"TimerScheduleSittingConversation");
			return;
		}
		
		if (mbFirstSitting)
		{
			Dialog_Begin("Catherine");
				Dialog_AddBranchAndSubject("10GTakeSeatLong","","BeginScanning");
			Dialog_End();
			mbFirstSitting = false;
			
			MoveHelmet();
		}
		else
		{
			Dialog_Begin("Catherine");
				Dialog_AddBranchAndSubject("10GTakeSeatShort","","BeginScanning");
			Dialog_End();
			
			MoveHelmet();
		}
	}
	
	//-------------------------------------------------------
	
	void MoveHelmet()
	{
		Sound_PlayGui("Entities_Special/Equipment/scanner/omicron/scanner_lower", 1.0f);
		Prop_MoveLinearTo("chair_scan_moving", "chair_scan_end", 1, 1, 0.25, true, "MoveTo_ScanHelmet");	
	}
	
	void BeginScanning(const tString&in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		
		Map_AddTimer("SequenceScan",1.5f,"SequenceScan");
		
	}
	
