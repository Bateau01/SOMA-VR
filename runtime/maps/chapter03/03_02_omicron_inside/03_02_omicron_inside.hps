	// Scene 2 Event E *open suit locker and examine body*
	/////////////////////////////////////////

	//-------------------------------------------------------

	bool mbDiveSuitFound = false;
	bool mbDiveLockerDoorOpened = false;
	
	//-------------------------------------------------------
	
	void SetupDivePrepTerminal()
	{
	    Entity_PlayAnimation("divesuit_monitor_*", "inactive", 0.1f);
	}
	
	void SetupDiveSuit()
	{
		Entity_PlayAnimation("DivesuitCorpse","divesuit_closed",0.0f);
		Entity_PlayAnimation("DivesuitLocker","divesuit_closed",0.0f);
		Entity_SetActive("structure_gel_application", false);
		Entity_PlayAnimation("structure_gel_application","idle",0.0f);
	}
	
	bool mbMonitorRiseSound = false;
	void OnActivateDivePrepTerminals(const tString &in, int)
	{
		Sound_CreateAtEntity("snd_pushbutton","Entities_Station/tech/recording_device/button_on","button_dive_prep_terminals");
		
		////////////////////////////
		// If cath is plugged in, raise the monitors
		if (mbCatherineInserted)
		{
			if(mbMonitorRiseSound==false)
			{
				Sound_CreateAtEntity("MonitorsRise", "03_02_omicron_inside/SFX/diving_suit_computer/monitor_rise", "MonitorRiseSoundSrc");
				mbMonitorRiseSound = true;
			}
			
			Entity_PlayAnimation("divesuit_monitor_*", "activate", 0.1f);
			Map_AddTimer("timer_monitorraised",3.35f,"TimerMonitorRaised");
		}
		
		//////////////////////////
		// If not, reset the button
		else
		{
			Map_RemoveTimer("timer_resetterminalbutton");
			Map_AddTimer("timer_resetterminalbutton",1.0f,"TimerResetTerminalButton");
		}
	}
	
	//-------------------------------------------------------
	
	void TimerMonitorRaised(const tString &in asTimer)
	{
		Terminal_SetAllowInteraction("DivesuitTerminal",true);
	}
	
	//-------------------------------------------------------
	
	void TimerResetTerminalButton(const tString &in asTimer)
	{
		MovingButton_SetSwitchedOn("button_dive_prep_terminals",false,true);
	}
	
	//-------------------------------------------------------
	
	bool CollideLockerOpen(const tString &in asParent, const tString &in asChild, int alState)
	{
		//if (alState == -1) return true;
		
		////////////////////////
		// Allow the player to click the dive suit to activate it
		if (alState == 1)
		{
			cLux_AddDebugMessage("LOCKER DOOR :: OPEN");
			
			if (mbDiveLockerDoorOpened == false)
			{
				SequenceSuitLightsOn("");
				mbDiveLockerDoorOpened = true;
				cLux_AddDebugMessage("LOCKER DOOR :: LIGHTS!");
			}
			
			if (mbDiveSuitFound == false)
			{
				Entity_SetActive("DiveSuitAreaActivate",true);
				cLux_AddDebugMessage("LOCKER DOOR :: SUIT AREA ACTIVE");

			}
			
			if (mbDiveSuitTerminalUnlocked)
			{
				//Entity_SetActive("BlockBoxSuitBattery",true);				
			}
		}
		
		/////////////////////////////////
		// Make the dive suit non clickable if the player closes the door
		if (alState == -1)
		{
			Entity_SetActive("DiveSuitAreaActivate", false);
			cLux_AddDebugMessage("LOCKER DOOR :: SUIT AREA INACTIVE");
			Entity_SetActive("BlockBoxSuitBattery",false);				
		}
		
		return true;
	}
	
	void DiveSuitAreaActivate_OnPlayerInteract(const tString &in asEntity)
	{
		///////////////////////////////////
		// Player interacts with divesuit and it opens!
		cLux_AddTodoMessage("SOUND: Divesuit opening");
		Entity_SetActive("DiveSuitAreaActivate",false);
		Entity_PlayAnimation("DivesuitCorpse","divesuit_opening",0.0f);
		Entity_PlayAnimation("DivesuitLocker","divesuit_opening",0.0f);
		SequenceHelmetGore("");
		
		/////////////////////////////////////
		// Enable blockbox to block the door
		Entity_SetActive("BlockBoxSuitBattery",true);
		
		////////////////////////////////////
		// Queue dialogue
		Map_AddTimer("timer_opensuit",6.5f,"TimerOpenSuit");
		Map_AddTimer("timer_opensuitmusic",5.5f,"TimerOpenSuitMusic");
		Map_AddTimer("timer_raleighterminalactivation",2.0f,"TimerRaleighTerminal");
		Map_RemoveTimer("timer_suitreminder");
		
		//////////////////////////////////////
		// Begin terminal bootup sequence
		mbDiveSuitTerminalStartup = true;
		mbDiveSuitFound = true;
		mbDiveSuitTerminalUnlocked = true;
		
		Terminal_SetUpdateWhenOutOfView("DivesuitTerminal", true);
		
		cLux_AddDebugMessage("Checking locker door in some seconds..");
		Map_AddTimer("timer_checklocker",4.5f,"TimerCheckLockerDoor");
		
		LastOnSoma_SetText("03_02_omicron_inside_2");
	}
	
	//--------------------------------------------------------
	
	void TimerCheckLockerDoor(const tString &in asTimer)
	{
		float fOpen = SwingDoor_GetOpenAmount("DiveLocker_Door");
		
		if (fOpen < 0.3f)
		{
			Entity_SetActive("BlockBoxSuitBattery",false);				
			SwingDoor_PushOpen("DiveLocker_Door",0.25f,2);
			Map_AddTimer("timer_checklocker",0.2f,"TimerCheckLockerDoor");
		}
		else
		{
			Entity_SetActive("BlockBoxSuitBattery",true);				
		}
	}
	
	//--------------------------------------------------------
	
	void TimerRaleighTerminal(const tString &in asTimer)
	{
		mbRaleighTerminalActive = true;
	}
	
	//--------------------------------------------------------
	
	cSequenceStatesData mSequenceHelmetGore;
	void SequenceHelmetGore(const tString &in asX)
	{
	    Sequence_Begin("SequenceHelmetGore", mSequenceHelmetGore);
		
	    if(Sequence_DoStepAndWait(5.5f))
	    {
        
	    }
		else if(Sequence_DoStepAndWait(1.5f))
		{
		    Prop_SetStaticPhysics("neck_chunk_*", false);
			Entity_RemoveEntityAttachment("neck_chunk_*");
		}
		else if(Sequence_DoStepAndWait(1.0f))
	    {
            Entity_SetActive("brain_chunk_6", true);
            Entity_SetActive("brain_chunk_1", true);
			Entity_RemoveEntityAttachment("brain_chunk_*");
	    }
		else if(Sequence_DoStepAndWait(0.5f))
	    {
            Entity_SetActive("brain_chunk_2", true);
	    }
		else if(Sequence_DoStepAndWait(0.5f))
	    {
            Entity_SetActive("brain_chunk_3", true);
	    }
		else if(Sequence_DoStepAndWait(0.5f))
	    {
            Entity_SetActive("brain_chunk_4", true);
	    }
		else if(Sequence_DoStepAndWait(0))
	    {
            Entity_SetActive("brain_chunk_5", true);
	    }
        Sequence_End();	
	}
	
	//--------------------------------------------------------
	
	void TimerOpenSuit(const tString &in asTimer)
	{
		Dialog_Begin("FoundSuit");
			Dialog_AddBranchAndSubject("1EFindSuit","","DiveSuitOpened");
		Dialog_End();	
	}
		
	//--------------------------------------------------------
	
	void TimerOpenSuitMusic(const tString &in asTimer)
	{
		Music_Play("03_02_body", 0.25f, false, eMusicPrio_BigEvent);
	}
	
	//--------------------------------------------------------
	
	void DiveSuitOpened(const tString&in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		
		/////////////////////////////////////
		// Schedule new reminder for player - give them a little longer as to not be annoying 
		// (They have just performed an action to progress the plot - seems wrong to not reset timer)
		Map_RemoveTimer("timer_suitreminder");
		Map_AddTimer("timer_suitreminder",cMath_RandRectf(30,35),"TimerSuitReminder");
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceSuitLightsOn;
	void SequenceSuitLightsOn(const tString &in asTimer)
	{
		Sequence_Begin("SequenceSuitLightsOn", mSequenceSuitLightsOn);
			
		if (Sequence_DoStepAndWait(0.5))
		{
			Lamp_SetLit("LampDiveSuit_1",true,true);
			Lamp_SetFlickerActive("LampDiveSuit_1",true);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Lamp_SetFlickerActive("LampDiveSuit_1",false);
			Lamp_SetLit("LampDiveSuit_2",true,true);
			Lamp_SetFlickerActive("LampDiveSuit_2",true);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Lamp_SetFlickerActive("LampDiveSuit_2",false);
			Lamp_SetLit("LampDiveSuit_3",true,true);
			Lamp_SetFlickerActive("LampDiveSuit_3",true);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Lamp_SetFlickerActive("LampDiveSuit_3",false);
			Lamp_SetLit("LampDiveSuit_4",true,true);
			Lamp_SetFlickerActive("LampDiveSuit_4",true);
			////////////////////////
			//Diving locker on sounds
			Sound_CreateAtEntity("DivingSuitLockerOn_Oneshot", "Entities_Station/tech/diving_suit_locker/diving_suit_power_on", "SoundSrc_DiveSuitLocker", 0.0f, false, 1.0f);
			Sound_CreateAtEntity("DivingSuitLockerOn_Loop", "Entities_Station/tech/diving_suit_locker/suit_locker_loop", "SoundSrc_DiveSuitLocker", 3.0f, true, 1.0f);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			Lamp_SetFlickerActive("LampDiveSuit_4",false);
		}
		else if (Sequence_DoStepAndWait(0))
		{
			
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------

	/////////////////////////////////////////
	// Scene 2 Event F *Interact with suit terminal*
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	bool mbAttemptedSuitActivation = false;
	bool mbFasterSuitTerminalReadout = false;
	
	//-------------------------------------------------------	
	
	void ActivateSuit()
	{
		Map_AddTimer("timer_suitactivation",6.0f,"TimerActivateSuit");
		
		mfDivesuitBootTimer = 0;
		mlDivesuitBootCount = 0;
		
	}
	
	//-------------------------------------------------------
	
	void TimerActivateSuit(const tString &in asTimer)
	{
		if (Voice_CharacterIsSpeaking("Catherine") || Voice_CharacterIsSpeaking("Player"))
		{
			Map_AddTimer("timer_suitactivation",1.0f,"TimerActivateSuit");
			return;
		}
		
		/////////////////////////////////////////
		// Play Dialogue
		if (!mbAttemptedSuitActivation)
		{
			cLux_AddDebugMessage("Playing Dialog");
			Dialog_Begin("BootingSuit");
				Dialog_AddBranchAndSubject("1FSuitTerminal","","CatherineInstructionsFinished");
			Dialog_End();
		}
			
		mbAttemptedSuitActivation = true;
		cLux_AddDebugMessage("Activating Suit");
		
	}
	
	//-------------------------------------------------------
	
	void CatherineInstructionsFinished(const tString&in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		
		/////////////////////////////////////
		// Unlock Dive room and enable Cath reminders
		Map_AddTimer("timer_unlockdiveroom",1.5f,"TimerUnlockDiveRoom");
		
		////////////////////
		// Enable hints
		cLux_AddTodoMessage("HINTS ENABLED");
		
		CathTool_SetHintsEnabled("CathTool_Placed",true);
		CathTool_SetHintsCallback("CathTool_Placed","OnCathHints");
		
		mbFasterSuitTerminalReadout = true;
		
		
		cLux_AddDebugMessage("Instructions finished!");
		
		//////////////////////////////
		// Ross can become visible again now when player goes through containment
		RossCube_ForceInvisible("CubeShadow",false);
	}
	
	//-------------------------------------------------------
	
	void TimerCathGaveInstructions(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Time has elapsed");
	}
	
	//-------------------------------------------------------
	
	void TimerUnlockDiveRoom(const tString &in asTimer)
	{
		SequenceDiveroomLightsOn("");
		
		Button_SetSwitchedOn("medbay_doorpanel_1",true,true);
		Button_SetSwitchedOn("northhallf2_doorpanel_2",true,true);
		Button_SetSwitchedOn("southhall_doorpanel_1",true,true);
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceDiveroomLightsOn;
	void SequenceDiveroomLightsOn(const tString &in asTimer)
	{
		Sequence_Begin("SequenceDiveroomLightsOn", mSequenceDiveroomLightsOn);
			
		if (Sequence_DoStepAndWait(1.25))
		{
			Lamp_SetLit("diveroom_sec2_lamp_2",true,true);
			Lamp_SetFlickerActive("diveroom_sec2_lamp_2",true);
		}
		else if (Sequence_DoStepAndWait(1.1))
		{
			Lamp_SetFlickerActive("diveroom_sec2_lamp_2",false);
			
			Lamp_SetLit("diveroom_sec2_lamp_3",true,true);
			Lamp_SetFlickerActive("diveroom_sec2_lamp_3",true);
			Lamp_SetLit("diveroom_sec2_lamp_4",true,true);
			Lamp_SetFlickerActive("diveroom_sec2_lamp_4",true);
		}
		else if (Sequence_DoStepAndWait(2.35))
		{
			Lamp_SetFlickerActive("diveroom_sec2_lamp_2",false);
			Lamp_SetFlickerActive("diveroom_sec2_lamp_3",false);
			Lamp_SetFlickerActive("diveroom_sec2_lamp_4",false);
		}
		else if (Sequence_DoStepAndWait(1.0))
		{
			//////////////////////////////////////
			// Unlock the door panels
			Button_SetLocked("diveroom_doorpanel_*", false);
			Button_SetSwitchedOn("diveroom_doorpanel_*",false,true);
			Entity_SetActive("FinalDoorBlocker_*",false);
			
			Entity_CallEntityInteract("diveroom_doorpanel_1");
			
			//////////////////////////////////////
			// Activate area to remind player of mission when leaving tunnel
			Entity_SetActive("AreaMissionReminder",true);
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------

	/////////////////////////////////////////
	// Scene 2 Event G *Interact with crane terminal*
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	//-------------------------------------------------------

	/////////////////////////////////////////
	// Scene 2 Event H *Catherine Comments*
	/////////////////////////////////////////

	//-------------------------------------------------------
	
		
	bool CollideAreaMissionReminder(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		///////////////////////////////////////////
		// Do not nag the player if catherine has recently given the mission
		if (Map_TimerExists("timer_catherinegavehint") == false)
		{	
			//////////////////////////////////////////
			// When leaving the dive room and half way up the tunnel, the player receives a reminder from Catherine for the mission
			Voice_Play("2HCatherineComment_LeavingDiveRoom");
		}
		else
		{
			cLux_AddDebugMessage("Catherine spoke recently!");
		}
		
		mbMusicSupressed = false;
		Entity_SetActive("AreaLeaveTunnel",true);
		
		return false;
	}
	
	//-------------------------------------------------------
	
	void TimerSuitReminder(const tString &in asTimer)
	{
		///////////////////////////////////////////////////////
		// If player is in a terminal, requeue
		if (Player_GetCurrentStateName() == "State_Interact_Terminal")
		{
			Map_AddTimer("timer_suitreminder",cMath_RandRectf(10,15),"TimerSuitReminder");
			return;
		}
		
		///////////////////////////////////////////////////////
		// if suit is not yet found, give the player a reminder
		if (mbDiveSuitFound == false)
		{
			Voice_PlayWhenPossible("2HCatherineComment_ReminderFindSuit", "", 15);
			Map_AddTimer("timer_suitreminder",cMath_RandRectf(30,35),"TimerSuitReminder");
		}
		
		////////////////////////////////////////////////////////
		// if suit is found but not yet activated, also give the player a reminder
		if (mbDiveSuitFound && mbAttemptedSuitActivation == false)
		{
			Voice_PlayWhenPossible("2HCatherineComment_ReminderActivateSuit", "", 15);
			Map_AddTimer("timer_suitreminder",cMath_RandRectf(30,35),"TimerSuitReminder");
		}
	}
	
