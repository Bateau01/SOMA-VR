	bool mbScanParametersLocked = false;
	bool mbScanComplete = false;
	int mlDataFlowType = 0;
	int mlDataAlignmentType = 0;
	int mlDataCypherType = 0;
	bool mbKillSimonButtonActive = false;
	
	float mfFlowGauge = 0.0f;
	float mfDataGauge = 0.0f;
	float mfCypherGauge = 0.0f;
	bool mbLinkAborted = false;
	bool mbFirstTimeUsingTransferTerminal = true;
	
	//-------------------------------------------------------
	
	//////////////////////////
	// SINE WAVE VISUALISER //
	//////////////////////////
	
	//-------------------------------------------------------
	
	float mfAccumulatedSineOffset = 0.0f;
	float mfSineScrollTarget = 3.0f;
	float mfSineScrollValue = 1.0f;
	
	int mlGaugeA = 5;
	int mlGaugeB = 15;
	int mlGaugeC = 3;
	bool mbSineWaveAligned = false;
	
	float mfSinePosX = 0.0f;
	float mfSinePosY = 0.0f;

	tString msTadPoleWave = "03_02_omicron_inside/SFX/scan_puzzle/500hz";
	tString msUserWave = "03_02_omicron_inside/SFX/scan_puzzle/1000hz";
	tString msCurrentSineWave = "03_02_omicron_inside/SFX/scan_puzzle/1000hz";
	
	//-------------------------------------------------------
	
	void SetupSineWaves()
	{
		//AudioSineWavesStartPlaying();
		//AudioSineWavesPlay();
	}
	
	//-------------------------------------------------------
	
	void AudioSineWavesStartPlaying()
	{		
		// Create the looping sounds
		Sound_PlayGui(msTadPoleWave,0.0,eSoundEntryType_Gui);
		Sound_PlayGui(msUserWave,0.0f,eSoundEntryType_Gui);
			
	}
	
	//-------------------------------------------------------
	
	void AudioSineWavesFadeAll()
	{
		Sound_FadeGuiVolume(msTadPoleWave,0.0f,0.1f);
		Sound_FadeGuiVolume(msUserWave,0.0f,0.1f);
	}
	
	//-------------------------------------------------------
	
	void AudioSineWavesPlay()
	{
		Sound_FadeGuiVolume(msTadPoleWave,1.0f,0.75f);
		Sound_FadeGuiVolume(msCurrentSineWave,1.0f,0.75f);
	}
	
	//-------------------------------------------------------
	
	float mfSineLockedPulse = 0.0f;
	void TransferSineWave(const tString&in asEntityName, float afTimeStep, float afX, float afY, int alGaugeA, int alGaugeB, int alGaugeC)
	{
		mfSineLockedPulse += afTimeStep;
		
		// Starting coordinates for sin dot when time == 0.0f;
		float fStartX = afX;
		float fStartY = afY;
		
		
		// Max width of sine wave graphic
		float fWidth = 0.75f;	
		
		// Time for traversal of dot from left to right (One second is added for trail to disappear)
		float fMaxTime = 2.5f;
		
		// Logic for rendering the sin wave
		float fX = ImGui_GetStateFloat("WaveTime");
		float fTimeStepMul = 2.0f;

		fMaxTime *= fTimeStepMul;
		fX += afTimeStep * fTimeStepMul;
		if (fX > fMaxTime + 3.5f)		// We add 1 to allow the trail to disappear
			fX = 0.0f;
		
		cVector3f vPos = cVector3f(0.5,0.5,1.0);	
		cImGuiGfx gfxPlayer = cImGuiGfx("station_omicron_map_playerdot");	
		
		// Convert our ints
		float fGaugeA = alGaugeA/10.0f;
		float fGaugeB = alGaugeB/10.0f;
		float fGaugeC = alGaugeC/10.0f;
		
		// Our faint sine wave line
		float fPuzzleFreq = fGaugeA*2.0f;
		float fPuzzleOffset = (fGaugeB*1.5f)+mfAccumulatedSineOffset;
		float fPuzzleAmp = fGaugeC*0.1f;
		
		// Path of the dot
		float fFreq = 1.8f;
		float fOffset = (0.5f)+mfAccumulatedSineOffset;
		float fAmp = 0.07f;
		float fScale = 1.0f/fMaxTime;
		
		
		// Smoothly move the speed of the wave to give subtle feedback that it has matched
		mfSineScrollValue = cMath_InterpolateLinear(mfSineScrollValue,mfSineScrollTarget,afTimeStep*1.5f);
		if (mbSineWaveAligned) 
			mfSineScrollTarget = 1.5f;
		else
			mfSineScrollTarget = 5.0f;
			
		mfAccumulatedSineOffset += afTimeStep * mfSineScrollValue;
		

		
		cColor debugCol = cColor(1.0f,1.0f,1.0f,.5f);
		ImGui_DrawLine(ImGui_NrmSize(cVector2f(fStartX,fStartY-0.125f)),ImGui_NrmSize(cVector2f(fStartX+fWidth,fStartY-0.125f)),99.0f,1.0f,debugCol);
		ImGui_DrawLine(ImGui_NrmSize(cVector2f(fStartX,fStartY)),ImGui_NrmSize(cVector2f(fStartX+fWidth,fStartY)),99.0f,1.0f,debugCol);
		ImGui_DrawLine(ImGui_NrmSize(cVector2f(fStartX,fStartY+0.125f)),ImGui_NrmSize(cVector2f(fStartX+fWidth,fStartY+0.125f)),99.0f,1.0f,debugCol);
			
		for (int i=0; i<11; i++)
		{
			ImGui_DrawLine(ImGui_NrmSize(cVector2f(fStartX+(fWidth*(i*0.1f)),fStartY-0.125f)),ImGui_NrmSize(cVector2f(fStartX+(fWidth*(i*0.1f)),fStartY+0.125f)),99.0f,1.0f,debugCol);
		}
		
		if (mbSimonKilled) 
			return;
		
		float fT;
		
		for (int i=0; i<32; i++)
		{
			fT = (fX-(0.175f*i));
			if (fT < 0.0f) continue;
			if (fT > fMaxTime) continue;
			vPos.x = fStartX + (fT * fScale * fWidth);
			vPos.y = fStartY + (cMath_Sin(fT*fFreq+fOffset)*fAmp);
			ImGui_SetModColorMul(cColor(1.0f,1.0f,1.0f,1.0f-(0.03f*i)));
			ImGui_DoImage(gfxPlayer,ImGui_NrmPos(vPos),ImGui_NrmSizeGroup(cVector2f(0.01f,0.01f)));
		}
		
		
		for (int point = 0; point < 80; point++)
		{
			fT = fMaxTime * (0.0125)*point;
			
			vPos.x = fStartX + (fT * fScale * fWidth);
			vPos.y = fStartY + (cMath_Sin(fT*fPuzzleFreq+fPuzzleOffset)*fPuzzleAmp);
			ImGui_SetModColorMul(cColor(1.0f,1.0f,1.0f,0.5f));
			ImGui_DoImage(gfxPlayer,ImGui_NrmPos(vPos),ImGui_NrmSizeGroup(cVector2f(0.01f)));
		}
		
		ImGui_SetStateFloat("WaveTime",fX);
		
		ImGui_SetModColorMul(cColor_White);
	}
	
	//-------------------------------------------------------

	
	void TransferTerminal_GuiEnter(const tString&in asEntityName)
	{
		/////////////////////////////////////////////
		// Provide puzzle instructions on the first use
		if (mbFirstTimeUsingTransferTerminal == false) return;
		
		Voice_PlayWhenPossible("10FScanTerminalInstructions");
		mbFirstTimeUsingTransferTerminal = false;
	}
	
	//-------------------------------------------------------
	
	
	
	//-------------------------------------------------------
	
	void TransferTerminal_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		/*if (mbLinkAborted)
		{
			// Todo: Shutdown terminal sequence
			return;
		}*/
		
		// Draw background
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
	
		
		////////////////////////////
		// Text
		cImGuiTextFrameData textFrameData = ImGui_GetDefaultTextFrame();
		textFrameData.mbUseBackgroundGfx = false;
		textFrameData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.045);
		textFrameData.mFontAlign = eFontAlign_Center;
		ImGui_SetDefaultTextFrame(textFrameData);
		
		cImGuiButtonData buttonData = StationGui_CreateDefaultButtonData();
		buttonData.mFont.mvSize = cVector2f(24,24);
		
		cStationGui_ErrorSettings error;
		error.mDialogBox.mWindow.mbUseHeader = false;
		error.mDialogBox.mWindow.mfPaddingTop = 64;
		if (StationGui_DrawAndCheckErrors(error)) return;
		
		float fHeaderY = -0.6f;
		float fFooterY = 0.25f;
		float fStartY = -0.1f;
		float fButtonX = -0.4f;
		float fButtonWidth = 0.25f;
		float fButtonHeight = 0.15f;
		float fButtonSpacing = 0.105f;
		
		ImGui_SetTransCategory("03_02_omicron_inside");
		
		
		//////////////////////////////////////
		// Button to kill Simon
		if (mbScanComplete)
		{
			if (mbLinkAborted)
			{
				ImGui_GroupBegin(ImGui_NrmPos(cVector3f(0.15, 0.25, 1)), ImGui_NrmSize(cVector2f(0.7, 1.0)));
					ImGui_DoTextFrameExt("LinkInactive", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textFrameData, ImGui_NrmPosGroup(cVector3f(0.0, -0.4, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));	
				ImGui_GroupEnd();
			}
			else
			{
				ImGui_GroupBegin(ImGui_NrmPos(cVector3f(0.15, 0.25, 1)), ImGui_NrmSize(cVector2f(0.7, 1.0)));
					ImGui_DoTextFrameExt("LinkActive", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textFrameData, ImGui_NrmPosGroup(cVector3f(0.0, -0.4, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
				
				///////////////////////////////////////
				// Once Catherine Ejects, we get the button to kill Simon
				if (mbKillSimonButtonActive)
				{
					if (ImGui_DoButtonExt("ButtonAbortLink","AbortLink", buttonData, ImGui_NrmPosGroup(cVector3f(0.0f, 0.5, 1)), ImGui_NrmSizeGroup(cVector2f(1.0f, 0.15f))))
					{
						KillSimon();
						mbLinkAborted = true;
						Sound_CreateAtEntity("KillSimonButtonPressed", "03_02_omicron_inside/SFX/suit_diagnostics/drain_battery_button_press", "transtermsoundsrc");
					}
				}
					
				ImGui_GroupEnd();
			}
			
			mfSinePosX = 0.125f;
			mfSinePosY = cMath_InterpolateLinear(mfSinePosY,0.55f,afTimeStep*2.0f);
			TransferSineWave(asEntityName, afTimeStep, mfSinePosX, mfSinePosY, mlGaugeA+8, mlGaugeB-2, mlGaugeC);
			
			return;
		}
		
		//////////////////////////////////////
		// Indicate parameters have been locked
		if (mbScanParametersLocked)
		{
			
			ImGui_GroupBegin(ImGui_NrmPos(cVector3f(0.15, 0.25, 1)), ImGui_NrmSize(cVector2f(0.7, 1.0)));
				ImGui_DoTextFrameExt("ScanInProgress", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textFrameData, ImGui_NrmPosGroup(cVector3f(0.0, 0.0, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_GroupEnd();
			
			mfSinePosX = cMath_InterpolateLinear(mfSinePosX,0.125f,afTimeStep*2.0f);
			mfSinePosY = cMath_InterpolateLinear(mfSinePosY,0.5f,afTimeStep*2.0f);
			TransferSineWave(asEntityName, afTimeStep, mfSinePosX, mfSinePosY, mlGaugeA+8, mlGaugeB-2, mlGaugeC);
			return;
		}
		
		
		ImGui_GroupBegin(ImGui_NrmPos(cVector3f(0.25, 0.25, 1)), ImGui_NrmSize(cVector2f(0.5, 1.0)));
		
			
			// Header
			ImGui_DoTextFrameExt("SetupDataFlow", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textFrameData, ImGui_NrmPosGroup(cVector3f(0.0, fHeaderY, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			
			fStartY = 0.175f;
			
			/////////////////////////
			// Frequency
			if (ImGui_DoButtonExt("ButtonFlowLeft","TransferLeft", buttonData, ImGui_NrmPosGroup(cVector3f(-0.4f, fStartY, 1)), ImGui_NrmSizeGroup(cVector2f(fButtonWidth, fButtonHeight))))
			{
				Depth_Audio_Terminal_Forward(asEntityName);
				mlGaugeA -= 2;
				if (mlGaugeA < 1) mlGaugeA = 1;
			}
			if (ImGui_DoButtonExt("ButtonFlowRight","TransferRight", buttonData, ImGui_NrmPosGroup(cVector3f(-0.125f, fStartY, 1)), ImGui_NrmSizeGroup(cVector2f(fButtonWidth, fButtonHeight))))
			{
				Depth_Audio_Terminal_Forward(asEntityName);
				mlGaugeA += 2;
				if (mlGaugeA > 9) mlGaugeA = 9;
			}
		
			ImGui_DoTextFrameExt("SelectedDataFlow", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textFrameData, ImGui_NrmPosGroup(cVector3f(-0.625, -0.05f, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_SetTransCategory("");
			ImGui_DoTextFrameExt(""+mlGaugeA, ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textFrameData, ImGui_NrmPosGroup(cVector3f(-0.625, -0.0f, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_SetTransCategory("03_02_omicron_inside");
			
			
			
			/////////////////////////
			// Offset
			fStartY = 0.175f;
			
			if (ImGui_DoButtonExt("ButtonDataLeft","TransferLeft", buttonData, ImGui_NrmPosGroup(cVector3f(0.23f, fStartY, 1)), ImGui_NrmSizeGroup(cVector2f(fButtonWidth, fButtonHeight))))
			{
				Depth_Audio_Terminal_Forward(asEntityName);
				mlGaugeB -= 5;
				if (mlGaugeB < 0) mlGaugeB = 0;
			}
			if (ImGui_DoButtonExt("ButtonDataRight","TransferRight", buttonData, ImGui_NrmPosGroup(cVector3f(0.5f, fStartY, 1)), ImGui_NrmSizeGroup(cVector2f(fButtonWidth, fButtonHeight))))
			{
				Depth_Audio_Terminal_Forward(asEntityName);
				mlGaugeB += 5;
				if (mlGaugeB > 20) mlGaugeB = 20;
			}
		
			ImGui_DoTextFrameExt("SelectedDataAlignment", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textFrameData, ImGui_NrmPosGroup(cVector3f(-0.0, -0.05f, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_SetTransCategory("");
			ImGui_DoTextFrameExt(""+mlGaugeB, ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textFrameData, ImGui_NrmPosGroup(cVector3f(-0.0, -0.0f, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_SetTransCategory("03_02_omicron_inside");
			
			////////////////////////////////
			// Frequency
			fStartY = 0.175f;
			
			if (ImGui_DoButtonExt("ButtonCypherDown","TransferLeft", buttonData, ImGui_NrmPosGroup(cVector3f(0.825f, fStartY, 1)), ImGui_NrmSizeGroup(cVector2f(fButtonWidth, fButtonHeight))))
			{
				Depth_Audio_Terminal_Forward(asEntityName);
				mlGaugeC -= 2;
				if (mlGaugeC < 1) mlGaugeC = 1;
			}
			if (ImGui_DoButtonExt("ButtonCypherRight","TransferRight", buttonData, ImGui_NrmPosGroup(cVector3f(1.09f, fStartY, 1)), ImGui_NrmSizeGroup(cVector2f(fButtonWidth, fButtonHeight))))
			{
				Depth_Audio_Terminal_Forward(asEntityName);
				mlGaugeC += 2;
				if (mlGaugeC > 9) mlGaugeC = 9;
			}
			
			ImGui_DoTextFrameExt("EncryptionSignal", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textFrameData, ImGui_NrmPosGroup(cVector3f(0.575, -0.05f, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_SetTransCategory("");
			ImGui_DoTextFrameExt(""+mlGaugeC, ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textFrameData, ImGui_NrmPosGroup(cVector3f(0.575, -0.0f, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_SetTransCategory("03_02_omicron_inside");
			
			////////////////////////////////
			// Confirm button
			fStartY += 0.3f;
			fButtonWidth = 1.75f;
			
			///////////////////////////////////
			// Work out if all the bars are aligned
			/* New Method - follow sine wave */
			// correct values
			mbSineWaveAligned = (mlGaugeA==1 && mlGaugeB==5 && mlGaugeC==7)?true:false;
			
			
			//{ CONFIRM BUTTON
			if (ImGui_DoButtonExt("ButtonBeginScan","BeginReading", buttonData, ImGui_NrmPosGroup(cVector3f(-0.4f, fStartY, 1)), ImGui_NrmSizeGroup(cVector2f(fButtonWidth, fButtonHeight+0.1))))
			{
				bool bActivateChair = false;
					
				/////////////////////////////////////
				// If scan parameters are incorrect, player gets an error
				mbScanWillSucceed = mbSineWaveAligned;
				
				cLux_AddDebugMessage("Scan succeeds: " + mbScanWillSucceed);
				
				if (mbScanWillSucceed)
				{
					/////////////////////////////////////
					// Activate Chair
					bActivateChair = true;
				}
				else
				{
					/////////////////////////////////////
					// Present Error
					bActivateChair = false;
					StationGui_SetError("ScanError");
				}
				
				/////////////////////////////////////
				// Activate first chair on first attempt, or if configured right
				if (bActivateChair)
				{
					Depth_Audio_Terminal_Forward(asEntityName);
					mbScanParametersLocked = true;
					ActivateScanChair();
				}
			}
			//}CONFIRM BUTTON
			
			////////////////////////////////////
			// Gauges (REMOVED)
			/*
			cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
			gauge.mOrientation = eImGuiGaugeOrientation_Vert;
			gauge.mbUseBackgroundGfx = true;
			gauge.mGfxFill.mColor = cColor_White;
			
			cColor gaugeAColor = cColor_White;
			cColor gaugeBColor = cColor_White;
			cColor gaugeCColor = cColor_White;
			cColor gaugeMatchedColor = cColor(0.0f,1.0f,0.0f,1.0f);
			
			float fFluc = ImGui_GetStateFloat("Fluctuate",0.0f) + afTimeStep;
			float fRnd = cMath_Sin(fFluc) * 0.05f;
				
			float fGaugeA = mlGaugeA/9.0f;//ImGui_GetStateFloat("TransferGaugeA",0.0f);
			float fGaugeB = mlGaugeB/20.0f;//ImGui_GetStateFloat("TransferGaugeB",0.0f);
			float fGaugeC = mlGaugeC/7.0f;//ImGui_GetStateFloat("TransferGaugeC",0.0f);
		
			
			mfFlowGauge = cMath_InterpolateLinear(mfFlowGauge,fGaugeA,afTimeStep*5.0f);
			mfDataGauge = cMath_InterpolateLinear(mfDataGauge,fGaugeB,afTimeStep*5.0f);
			mfCypherGauge = cMath_InterpolateLinear(mfCypherGauge,fGaugeC,afTimeStep*5.0f);
			
			gauge.mGfxFill.mColor = gaugeAColor;
				ImGui_DoGauge(gauge,mfFlowGauge,ImGui_NrmPosGroup(cVector3f(0.8,0.15,3)), ImGui_NrmSizeGroup(cVector2f(0.15f,0.5f)));
			
			gauge.mGfxFill.mColor = gaugeBColor;
				ImGui_DoGauge(gauge,mfDataGauge,ImGui_NrmPosGroup(cVector3f(0.975,0.15,3)), ImGui_NrmSizeGroup(cVector2f(0.15f,0.5f)));
			
			gauge.mGfxFill.mColor = gaugeCColor;
				ImGui_DoGauge(gauge,mfCypherGauge,ImGui_NrmPosGroup(cVector3f(1.15,0.15,3)), ImGui_NrmSizeGroup(cVector2f(0.15f,0.5f)));
				
			ImGui_SetStateFloat("Fluctuate",fFluc);*/
			
		ImGui_GroupEnd();
		
		// SINE WAVE GRAPHIC
		mfSinePosX = 0.125f;
		mfSinePosY = 0.275f;
		TransferSineWave(asEntityName, afTimeStep, mfSinePosX, mfSinePosY, mlGaugeA+8, mlGaugeB-2, mlGaugeC);
	}
	
