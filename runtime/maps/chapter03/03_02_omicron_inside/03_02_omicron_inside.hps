	//--------------------------------------------------------
	
	// H5756AX_VR_OMICRON_RELEASED_BATTERY_ROUTE
	// Full authored-map + serialized-autosave audit: the released Omicron route
	// exposes PowerCube_Inserted in the power-room storage cabinet and records that
	// exact Tool as the owned Battery Pack. The PowerCubeTool charger state machine
	// remains shipped/cut content and is NOT auto-promoted by VR. Physical VR pickup,
	// shoulder round-trip, and final DiveSuit use stay on the released carrier.

	ePowerChargerState meChargerState = ePowerChargerState_NoCube;
	bool mbPowerCubeInserted = false;
	bool mbPowerChargerDoorClosed = false;
	int mlBackupGeneratorValue1 = 0;
	int mlBackupGeneratorValue2 = 0;
	
