	//-------------------------------------------------------
	
	bool CollideAreaTunnelScares(const tString &in asParent, const tString &in asChild, int alState)
	{
		//////////////////////////////////////////////
		// Must have all puzzle items to trigger this!
		if (mlPuzzleItemsGathered < 3) return true;
		
		
		//////////////////////////////////////////////
		// Flicker the lights
		Lamp_SetFlickerActive("tunnel_lamp*",true);
		
		////////////////////////////////////////
		// Get local var of area for each step
		switch (Entity_GetVarInt(asChild,""))
		{
			//////////////////////////
			// Open the door at the other end of the corridor in preparation for the chase
			// (so the player doesn't get killed waiting for door to open)
			case 0:
				Button_SetSwitchedOn("diveroom_doorpanel_1",true,true);
			break;
			
			/////////////////////////
			// Step 1 - tunnel chase starts!
			case 1:
				
				////////////////////////////////////////////
				// Ensure the robot is active and add timer for chase
				Entity_SetActive("agent_robothead_tunnelchase",true);
				
				if (Player_GetHealth() < 0.2f)
					mfFinalChaseDelay = 4.0f;
				
				cLux_AddDebugMessage(">>>>>>>> Begin chase! >>>>>>> " + mfFinalChaseDelay);
				
				Map_AddTimer("timer_startchase",mfFinalChaseDelay,"TimerStartTunnelChase");

				if (cLux_GetExplorationModeActive())
				{
					Remade_ForceSlowHunt("agent_robothead_tunnelchase", true);
					Entity_SetCollideCharacter("TunnelChaseBlocker", true);
				}
				
				////////////////////////////////////////////
				// check if the robot is in the tunnel, otherwise place her at start point for the chase!
				if (Entity_GetCollide("agent_robothead_tunnelchase", cLux_GetExplorationModeActive() ? "AreaDiveTunnel" : 
																									   "AreaRobotHeadAtTunnelCheck") == false)
				{
					Effect_TimeGlitch_Start(1, 0.5f, 0.5, true);
					Effect_VideoDistortion_Start(0.8, 1, 0.1, 0.3);
					
					//Entity_PlaceAtEntity("agent_robothead_tunnelchase","SpawnRobotHeadChase",cVector3f_Zero,false);
					Agent_TeleportFeetToEntity("agent_robothead_tunnelchase", cLux_GetExplorationModeActive() ? "SpawnRobotHeadChase_1" :
																												"SpawnRobotHeadChase" );
					CharMover_TurnInstantlyToEntity("agent_robothead_tunnelchase", "Player");
				}			
				
				//////////////////////////////////////
				// Make sure the far end door is open
				Button_SetSwitchedOn("divewalk_doorpanel_4",true,true);			
				
			break;
			
			case 2:
				cLux_AddDebugMessage("Ending scares!");
				EndTunnelScare();
			break;
		}
		
		/////////////////////////////////
		// Only trigger each area once!
		return false;
	}
	
	//-------------------------------------------------
	
	void TimerStartTunnelChase(const tString &in asTimer)
	{
		////////////////////////////////////////////
		// Attack the player
		cScript_RunGlobalFunc("agent_robothead_tunnelchase","cScrAgentRemade","_Global_ForceHuntState");
		//cScript_RunGlobalFunc("agent_robothead_tunnelchase","cScrAgentRemade","_Global_UnlessHuntingGoAgressiveState");
		//cScript_RunGlobalFunc("agent_robothead_tunnelchase","cScrAgentFixedHuman","_Global_EnterHunt");
		
		Map_AddTimer("timer_startchase",0.5f,"TimerStartTunnelChase");
	}
			
	//-------------------------------------------------
	
	bool mbIsChaseSweetenerActive = false;
	bool RobotHeadChaseSweetener(const tString &in asParent, const tString &in asChild, int alState)
	{
		Sound_CreateAtEntity("ChaseSweetener", "03_02_omicron_inside/SFX/robothead_chase/chase_sweet", "Player");
		mbIsChaseSweetenerActive = true;
		return false;		
	}
		
	//-------------------------------------------------
	
	bool CollideAreaEndTunnelScare(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == -1) return true;
		
		Entity_SetActive("TunnelShadow_*",false);
		Map_RemoveTimer(msFlesherTimer);
		Effect_VideoDistortion_FadeOut(mlIDFlesherShadowEffect,0.1f);
		Entity_SetActive("AreaTunnelScares_*",false);
		return false;
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaTriggerChaseSprint(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (cLux_GetExplorationModeActive() == false) return false;
		if (Entity_IsActive("agent_robothead_tunnelchase") == false) return true;
		
		Remade_ForceHuntPause("agent_robothead_tunnelchase", false);
		Remade_ForceSlowHunt("agent_robothead_tunnelchase", false);
		
		cLux_AddDebugMessage("TRIGGER CHASE SPRINT!");
		
		return true;
	}
	
	//-------------------------------------------------------
		
	////////////////////////////////////////////////
	// Simon gets Catherine to lock the door
	void EndTunnelScare()
	{	
		Sound_Stop("ChaseSweetener", 0.5f);
		Map_AddTimer("DoorBashSound", 6.0f, "DoorBashSound");
		
		Map_RemoveTimer("timer_startchase");
		
		Entity_SetActive("TunnelChaseSweetnerTrigger", false);
		Entity_SetActive("AreaTunnelScares_*",false);
		
		Dialog_Begin("EscapeDiveChase");
			Dialog_AddBranchAndSubject("10_EscapeDiveHall","","");
		Dialog_End();
		
		//Entity_SetActive("agent_robothead_tunnelchase",false);
		
		Map_AddTimer("timer_lockdoorfinal",0.5f,"TimerLockFinalDoor");	
		
		if (cLux_GetExplorationModeActive() == false) return;
		Entity_SetCollideCharacter("FinalDoorBlocker_2", true);
	}
	
	void DoorBashSound(const tString &in asTimer)
	{
		BarkMachine_SetActive("agent_robothead_tunnelchase", false);
		Sound_CreateAtEntity("DoorBash", "03_02_omicron_inside/SFX/robothead_chase/pound_door", "diveroom_door");
	}
	
	//-------------------------------------------------------
	
	void TimerLockFinalDoor(const tString &in asTimer)
	{
		//////////////////////////////////////
		// Disable the robothead
		Agent_SetAutoDisableWhenOutOfSightActive("agent_robothead_tunnelchase", true, 1.0f);
				
		//////////////////////////////////////
		// Lock the door!
		Button_SetLocked("diveroom_doorpanel_*", true);
		SlideDoor_SetClosed("diveroom_door",true,false);
		Entity_CallEntityInteract("diveroom_doorpanel_2");
		
		Entity_SetActive("AreaDisableEndChaseAttackMeter", true);
		
		/////////////////////////
		// Areas required for rest of puzzle
		cLux_AddDebugMessage("Tool areas active for main puzzle!");
		Entity_SetActive("ToolArea_ComputerBrain",true);
		Entity_SetActive("DiveSuitArea",true);		
		
		Map_AddTimer("timer_preload",2.5f,"TimerKickPreload");
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_AreaDisableEndChaseAttackMeter(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (Entity_GetCollide("player", "AreaTunnel") == true) return false;
		
		AttackMeter_RemoveInstance(Map_GetEntity("agent_robothead_tunnelchase").GetID());
		cLux_AddDebugMessage("REMOVING ATTACK METER!");
		return false;
	}
	
	//-------------------------------------------------------
	
	void TimerKickPreload(const tString &in asTimer)
	{
		//////////////
		// Start preloading map
		Preload();
	}
			
