	//-------------------------------------------------------
	
	bool ChipTool_Damaged_OnUse(const tString &in asTool, const tString &in asEntity)
	{
		///////////////////////////////////////
		// Player places chip in gel dispenser
		Entity_SetActive("ChipTool_PreRepair",true);
		Entity_SetActive("ChipTool_Repaired",false);
		
		Entity_SetActive("Area_PlaceBrokenChip",false);
		
		Sound_CreateAtEntity("PlaceDownChip", "03_02_omicron_inside/SFX/Pass2/wau_chip_put_down", "Player");
		
		//////////////////////////////////////
		// chip cannot be picked up yet, it must first be fully repaired
		Entity_SetInteractionDisabled("ChipTool_PreRepair",true); 
		mbDamagedChipPlaced = true;
		return true;
	}
	
	//-------------------------------------------------------
	
	bool ChipTool_Damaged_CanBeUsed(const tString &in asTool, const tString &in asEntity)
	{
		//////////////////////////////////////
		// Dispenser drawer must be open for the player to insert
		if (asEntity != "Area_PlaceBrokenChip") return false;
		
		return true;
	}
	
	//-------------------------------------------------------
	
	bool ChipTool_Repaired_OnPickUp(const tString &in asTool)
	{
		///////////////////////////////////
		// Player picks up repaired chip
		Entity_SetActive("Area_InsertRepairedChip",true);
		Entity_SetActive("Area_RetrieveRepairedChip",false);
		
		Sound_CreateAtEntity("PickupRepairedChip", "03_02_omicron_inside/SFX/Pass2/wau_chip_pick_up", "Player");
		
		///////////////////////////////////
		// Enable area to nag the player if they think they can use the gel on chip (It's a good idea, but its not enough!)
		//Entity_SetActive("AreaLeaveWithChip",true);
		mbReminderActive_LeaveWithChip=true;
		return true;
	}
	
	//-------------------------------------------------------
	
	bool ChipTool_Repaired_CanBeUsed(const tString &in asTool, const tString &in asEntity)
	{
		if (asEntity == "Area_InsertRepairedChip") return true;
		return false;
	}
	
	//-------------------------------------------------------
	
	bool ChipTool_Repaired_OnUse(const tString &in asTool, const tString &in asEntity)
	{
		//////////////////////////////
		// Player replaces chip in control panel
		Entity_SetActive("Chip_FullyRepaired",true);
		Entity_PlayAnimation("Chip_FullyRepaired", "after_grow", 0, true, true);
		Lamp_SetLit("incubator_chip_lamp", false, false);
		
		Sound_CreateAtEntity("InsertChip", "03_02_omicron_inside/SFX/Pass2/wau_chip_plugin", "Player");
		
		mbBioMechChipRepaired = true;
		
		////////////////////////////
		// Disable nag area since the player put the chip in the slot
		//Entity_SetActive("AreaLeaveWithChip", false);
		mbReminderActive_LeaveWithChip=false;
		return true;
	}
	
	
