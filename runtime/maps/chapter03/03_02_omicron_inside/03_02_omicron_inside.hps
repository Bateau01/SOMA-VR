	//-------------------------------------------------------
	//Stops flickering sound leaking through map
	bool TopFloorLampFlickerControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Lamp_SetFlickerActive("ceiling_large_single_65", true);
		}
		else
		{
			Lamp_SetFlickerActive("ceiling_large_single_65", false);
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////////////////
	// Scene 9 - Biolab Wau Flower
	////////////////////////////////////////////////
	
	//-------------------------------------------------------
	
	void wau_flower_biolab_Callback(const tString &in asEntity)
	{
		SequenceBiolabWauFlower("");
		OnWauFlowerDrainedAny();
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceBiolabWauFlower;
	void SequenceBiolabWauFlower(const tString &in asName)
	{
		Sequence_Begin("SequenceBiolabWauFlower", mSequenceBiolabWauFlower);
		
		///////////////////////////
		// Initial Delay
		if (Sequence_DoStepAndWait(0.75f))
		{
			
		}
		
		///////////////////////////
		// Lights go out in sets
		if (Sequence_DoStepAndWait(1.75f))
		{
			Lamp_SetFlickerActive("biolab_ceilinglamp_1",true);
			Lamp_SetFlickerActive("biolab_ceilinglamp_2",true);
			
			Sound_CreateAtEntity("lab_flowerevent", "03_02_omicron_inside/SFX/wau_flower_events/lab_powerdown", "Player");
		}
		if (Sequence_DoStepAndWait(1.75f))
		{
			Lamp_SetFlickerActive("biolab_ceilinglamp_3",true);
			Lamp_SetFlickerActive("biolab_ceilinglamp_4",true);
			Lamp_SetLit("biolab_ceilinglamp_1",false,true);
			Lamp_SetLit("biolab_ceilinglamp_2",false,true);
		}
		if (Sequence_DoStepAndWait(1.75f))
		{
			Lamp_SetFlickerActive("biolab_ceilinglamp_5",true);
			Lamp_SetFlickerActive("biolab_ceilinglamp_6",true);
			Lamp_SetLit("biolab_ceilinglamp_3",false,true);
			Lamp_SetLit("biolab_ceilinglamp_4",false,true);
		}
		if (Sequence_DoStepAndWait(1.75f))
		{
			Lamp_SetLit("biolab_ceilinglamp_5",false,true);
			Lamp_SetLit("biolab_ceilinglamp_6",false,true);
			
			
		}
		
		Sequence_End();
	}
	
