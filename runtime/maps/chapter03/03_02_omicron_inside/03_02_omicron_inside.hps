	//-------------------------------------------------------
	
	/////////////////////////////////////////////
	// Terminal - Herbers Laptop
	/////////////////////////////////////////////
	
	//-------------------------------------------------------
	bool mbDahlLaptopErrorActive = false;
	//-------------------------------------------------------
	
	void laptop_herber_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("03_02_omicron_inside");
		
		/////////////////////////////////
		// Backdrop
		StationGuiBG_Backdrop("background/background_logo_pathosstation", cVector2f(0.05, 0.05), 0.75);
		
		StationGuiBG_Scanlines();
		
		cImGuiButtonData button;
		button = StationGui_CreateDefaultButtonData();
		
		bool bBackButtonEnabled = true;
		bool bSendTransmission = false;
		
		int lActiveApp = StationGui_GetActiveApp(eHerberLaptop_Recordings);
		switch (lActiveApp)
		{
			case eHerberLaptop_Main:
				StationGui_AddApp("ButtonLaptopRecordings", true, eHerberLaptop_Recordings);
				StationGui_AddApp("ButtonLaptopDocuments", true, eHerberLaptop_Documents);
				StationGui_AddApp("ButtonLaptopImages", true, eHerberLaptop_Images);
				StationGui_MainMenu();
				bBackButtonEnabled = false;
			break;
			
			case eHerberLaptop_Recordings:
			
				if (mbDahlLaptopErrorActive)
				{
					ImGui_SetModUseInput(false);
				}
				else
				{
					ImGui_SetModUseInput(true);
				}
				Depth_ImGui_AddAudioFile_Voice("DahlLaptopRecording_1","DahlReports1");
				Depth_ImGui_AddAudioFile_Voice("DahlLaptopRecording_2","DahlReports2");
				Depth_ImGui_AddAudioFile_Voice("DahlLaptopRecording_3","DahlReports3");
				StationGui_AudioPlaybackApp();		
				
				ImGui_SetTransCategory("02_03_delta");
				button.mbClipText = false;
				bSendTransmission = ImGui_DoButtonExt("SendButton", "GUISend", button, ImGui_NrmPosGroup(0.06, 0.65, 4), ImGui_NrmSizeGroup(0.25, 0.083334));
				ImGui_SetTransCategory("03_02_omicron_inside");
				
				if (mbDahlLaptopErrorActive)
				{
					ImGui_SetModUseInput(true);
					DoDahlLaptopError(asEntityName);
				}
			break;
			
			case eHerberLaptop_Documents:
				Depth_ImGui_AddTextFile("DahlLaptopFilename_1", "DahlLaptopFile_1");
				Depth_ImGui_AddTextFile("DahlLaptopFilename_2", "DahlLaptopFile_2");
				Depth_ImGui_AddTextFile("DahlLaptopFilename_3", "DahlLaptopFile_3");
				StationGui_TextReaderMulti();
			break;
			
			case eHerberLaptop_Images:
				Depth_ImGui_AddPhotoFile("cathtablet_photo_1");
				Depth_ImGui_AddPhotoFile("cathtablet_photo_2");
				Depth_ImGui_AddPhotoFile("cathtablet_photo_3");
				Depth_ImGui_AddPhotoFile("cathtablet_photo_4");
				Depth_ImGui_AddPhotoFile("theta_mastersportrait");
				StationGui_PhotoViewer("");
			break;
			
			case eHerberLaptop_SendError:
				DoDahlLaptopError(asEntityName);
				bBackButtonEnabled = false;
			break;
		}
		
		StationGuiBG_Taskbar("omicron");
		if (StationGui_BackButton(bBackButtonEnabled, eHerberLaptop_Main))
			Depth_ImGui_StopAudioFilePlayback(ImGui_GetName());
		
		if (bSendTransmission)
		{
			mbDahlLaptopErrorActive = true;
			//StationGui_SetActiveApp(asEntityName, eHerberLaptop_SendError);
		}
			
	}
	
	void DoDahlLaptopError(const tString&in asEntityName)
	{
		cColor colorRed = gStationGuiColor_Warning;
			
		float fFadeAlpha = ImGui_GetStateFloat("MessageFadeAlpha",0.0f);
			
		///////////////////////////////////////////////////////
		// Draw background			
		cColor bgCol = colorRed * cColor(0.1f, fFadeAlpha*0.9f);
		ImGui_DrawGfx(cImGuiGfx(""), cVector3f(0,0,9), ImGui_GetSize(), bgCol);
			
		/////////////////////////////////////////////
		// Show error window			
		cGuiDialogBoxSettings dialogBox = StationGui_CreateDefaultDialogBox();
		dialogBox.mWindow.mColorBase = colorRed; 
		dialogBox.mWindow.mColorBase.a = fFadeAlpha;
		dialogBox.mTextFrame.mColorBase.a = fFadeAlpha;
		dialogBox.mButton.mColorBase.a = fFadeAlpha;
		dialogBox.mButton.mFont.mColor.a = fFadeAlpha;
		
		dialogBox.mfZ = 20.0;
		dialogBox.mType = eGuiDialogBoxType_OK;
		ImGui_SetModUseInput(false);
		
		if (ImGui_IsFading("MessageFadeAlpha")==false && fFadeAlpha > 0)
		{
			ImGui_SetModUseInput(true);
			ImGui_SetTransCategory("02_03_delta");
			eGuiDialogCode buttonPressed = Depth_ImGui_DialogBox("ErrorMsg_NoSignal", "ErrorMsg_BunkerMessageFailed", dialogBox);
			ImGui_SetTransCategory("");
			
			////////////////////////////////////////
			// Sound when getting rid of message
			if (buttonPressed == eGuiDialogCode_OK && mbDahlLaptopErrorActive)
			{
				Sound_CreateAtEntity("sfx_ConsoleError", "Entities_Station/tech/terminal_beeps/upsilon_train_map/destination_upsilon_B_cancel", asEntityName);
				mbDahlLaptopErrorActive = false;
			}
		}
		
		////////////////////////////////////////
		// Start fade in
		if(fFadeAlpha==0.0f && ImGui_IsFading("MessageFadeAlpha")==false && mbDahlLaptopErrorActive)
		{
			ImGui_FadeStateFloat("MessageFadeAlpha", 1.0f, 0.5f);
		}
			
		////////////////////////////////////////////////////////////////////////
		// Dismiss if messagebox is fully faded in and button is pressed. 
		//  Start fade out and set the messagebox active to false when done
		if(fFadeAlpha==1.0f && mbDahlLaptopErrorActive == false && ImGui_TimerExists("timer_ReturnToRecordings")==false)
		{
			ImGui_SetStateFloat("MessageFadeAlpha", 0.0f);
			mbDahlLaptopErrorActive = false;
		}
	}
	
	
