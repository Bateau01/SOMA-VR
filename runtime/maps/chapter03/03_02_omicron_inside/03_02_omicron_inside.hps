//-----------------------------------------------

class cRobotRect
{
	
	//--------------------------
	
	/* 
	 * Returns true if a point collides
	 * 
	 * For example:
	 * debugRect.SetRect("somename",vPos,vDimensions); // name if you need to debug
	 * debugRect.CheckCollide(mousePos); // will return true
	 *
	 * All coordinates used by this class assumes (0,0) is top left of terminal
	 * 
	 */
	 
	//--------------------------

	float x1, y1, x2, y2;
	int mlDirection = 4; 
	cVector3f mvDrawPos;
	cVector2f mvCenter;
	tString msName;
	cColor mColor;
	
	//--------------------------
	
	void SetRect(tString asName, cVector2f avPos, cVector2f avDimensions)
	{
		msName = asName;
		
		x1 = avPos.x;
		y1 = avPos.y;
		x2 = x1 + avDimensions.x;
		y2 = y1 + avDimensions.y;
		
		cVector2f vSize = cLux_GetCurrentImGui().GetSet().GetVirtualSize();
		mvCenter = cVector2f(x1 + (avDimensions.x/2), y1 + (avDimensions.y/2)) / vSize;
		
		mColor = cColor_Green;
	}

	//--------------------------
	
	bool CheckCollide(cVector2f avPos)
	{
		cVector2f vSize = cLux_GetCurrentImGui().GetSet().GetVirtualSize();
		avPos *= vSize;
		
		bool bCollide = (avPos.x >= x1 && avPos.x <= x2 && avPos.y >= y1 && avPos.y <= y2) ? true : false;
		
		if (bCollide) return true;
		return false;
	}
	
	//--------------------------
	
	void NudgeDirection()
	{
		mlDirection++;
		if (mlDirection > 4)
			mlDirection = 0;
	}
	
	//--------------------------
	
	void DrawDebug(cVector2f avCheckPos)
	{
		if (cLux_ScriptDebugOn() == false) return;
		
		cColor debugCol = cColor_Green;
		if (CheckCollide(avCheckPos))
		{
			debugCol = cColor_Red;
		}
		
		ImGui_DrawLine(cVector2f(x1,y1),cVector2f(x2,y1),99.0f,1.0f,debugCol);
		ImGui_DrawLine(cVector2f(x2,y1),cVector2f(x2,y2),99.0f,1.0f,debugCol);
		ImGui_DrawLine(cVector2f(x2,y2),cVector2f(x1,y2),99.0f,1.0f,debugCol);
		ImGui_DrawLine(cVector2f(x1,y2),cVector2f(x1,y1),9.0f,1.0f,debugCol);
	}
	
	//--------------------------
}

