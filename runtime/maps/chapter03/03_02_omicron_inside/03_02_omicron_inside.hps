		ImGui_DoTextFrameExt("LockerError", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textFrameData, ImGui_NrmPosGroup(cVector3f(0.0, 0.0, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
	}
	
	//--------------------------------------------------------
	
	float mfSuitTrackingTimer = 0.0f;
	float mfSuitDotAlpha = 0.0f;
	
	void DivesuitPanelTracking(float afTimeStep)
	{		
		float mfX = 0.125f;
		
		mfSuitTrackingTimer += afTimeStep;
		
		int lBarNum = ImGui_GetStateInt("CurrentBar",0);

		if (mfSuitTrackingTimer > 1.0f)
		{
			mfSuitDotAlpha = 1.0f;
			mfSuitTrackingTimer = 0.0f;
			Sound_CreateAtEntity("TerminalBeep", "Entities_Station/tech/terminal_beeps/omicron_battery_recharge_beep", ImGui_GetName(), 0.0f, false, 1.0f);
			
			lBarNum++;
			if (lBarNum > 3) lBarNum = 0;
			ImGui_SetStateInt("CurrentBar",lBarNum);
		}
		
		cImGuiGfx mapGfx("divesuittracker_map", eImGuiGfx_Image);
		cImGuiGfx dotsGfx("divesuittracker_dots", eImGuiGfx_Image);
		
		ImGui_DoImageCorrectAspect(mapGfx,ImGui_NrmPos(cVector3f(0.05+mfX,0.0,1.1)));
		
		
		//////////////////////////////////////////////
		// Fading dots
		ImGui_SetModColorMul(cColor(1.0f,0.0f,0.0f,mfSuitDotAlpha));
		mfSuitDotAlpha = cMath_InterpolateLinear(mfSuitDotAlpha,0.0f,afTimeStep*1.75f);
		ImGui_DoImageCorrectAspect(dotsGfx,ImGui_NrmPos(cVector3f(0.05+mfX,0.0,1.2)));
		ImGui_SetModColorMul(cColor_White);
		
		///////////////////////////////
		// Sliding Bar
		float fMinX = 0.05f;
		float fMaxX = 0.7f;
		float fDiff = fMaxX * (mfSuitTrackingTimer/1.0f);
		fDiff = cMath_Clamp(fDiff,fMinX,fMaxX);
		
		float fSecondX = mfX+fMaxX-fDiff+0.06;
		
		float fBarHeight = 0.83f;
		float fY = fBarHeight - fDiff;
		cColor barColor = cColor(1.0f,1.0f,1.0f,mfSuitDotAlpha);
		
		float fT = ImGui_GetStateFloat("sinPulse",0.0f) + afTimeStep*3.0f;
		ImGui_SetStateFloat("sinPulse", fT);
		float fBarWidth = 2.0f + (1.0f*cMath_Sin(fT));
		
		
		if (lBarNum % 2 == 0)
		{
			ImGui_DrawLine(ImGui_NrmPos2(fDiff+mfX,0.0f),ImGui_NrmPos2(fDiff+mfX,fBarHeight),10.0f,fBarWidth,barColor);
			//ImGui_DrawLine(ImGui_NrmPos2(fMinX+mfX,fY),ImGui_NrmPos2(fBarHeight+0.01,fY),10.0f,fBarWidth,barColor);			
		}
		else
		{
			ImGui_DrawLine(ImGui_NrmPos2(fSecondX,0.0f),ImGui_NrmPos2(fSecondX,fBarHeight),10.0f,fBarWidth,barColor);
			//ImGui_DrawLine(ImGui_NrmPos2(fMinX+mfX,fBarHeight-fY),ImGui_NrmPos2(fBarHeight+0.01,fBarHeight-fY),10.0f,fBarWidth,barColor);
		}
	}
	
	//--------------------------------------------------------
	
	void DivesuitPanelSelectSuit()
	{
		cImGuiButtonData button = StationGui_CreateDefaultButtonData();
		button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
		button.mbClipText = false;
		
		cVector3f vButtonStart = ImGui_NrmPosGroup(0.025, 0.6, 2);
		cVector2f vButtonSize = ImGui_NrmSizeGroup(0.15, 0.2);
		cVector3f vButtonOffset = ImGui_NrmPosGroup(0.01, 0, 2)+cVector3f(vButtonSize.x, 0, 0);
		
		if (ImGui_DoButtonExt("ButtonSuit1", "ButtonSuit1", button, vButtonStart, vButtonSize))
		{
			StationGui_SetError("LockerError");
		}
		if (ImGui_DoButtonExt("ButtonSuit2", "ButtonSuit2", button, vButtonStart+vButtonOffset, vButtonSize))
		{
			StationGui_SetError("LockerError");
		}
		if (ImGui_DoButtonExt("ButtonSuit3", "ButtonSuit3", button, vButtonStart+vButtonOffset*2, vButtonSize))
		{
			StationGui_SetError("LockerError");
		}
		if (ImGui_DoButtonExt("ButtonSuit4", "ButtonSuit4", button, vButtonStart+vButtonOffset*3, vButtonSize))
		{
			///////////////////////////////////
			// If Scan is Complete, locker should be empty
			if (mbScanComplete)
			{
				StationGui_SetError("LockerError");
			}
			else if (mbCorpseCrafted)
			{
				StationGui_SetActiveApp(eDiveSuitPanelState_ActivateCorpse);
				ActivateCorpse();
			}
			else
			{
				StationGui_SetActiveApp(eDiveSuitPanelState_BootSequence);
				ActivateSuit();
			}
		}
		if (ImGui_DoButtonExt("ButtonSuit5", "ButtonSuit5", button, vButtonStart+vButtonOffset*4, vButtonSize))
		{
			StationGui_SetError("LockerError");
		}
		
		if (ImGui_DoButtonExt("ButtonSuit6", "ButtonSuit6", button, vButtonStart+vButtonOffset*5, vButtonSize))
		{
			StationGui_SetError("LockerError");
		}
	}
	
	//--------------------------------------------------------
	
	void DivesuitPanelEnterSerial()
	{
		///////////////////////////////////
		// If the player has left the terminal on this screen and the suit is activated
		// return them to the main menu (Suit is now taken!)
		if (mbScanComplete)
		{
			StationGui_SetActiveApp(eDivesuitPanelState_MainMenu);
			return;
		}
	
		///////////////////////////////////
		// Otherwise allow serial number to be entered
		if (StationGui_Numpad("SuitActivation", 4))
		{
			tString sCode = StationGui_GetNumpadInput();
			
			if (sCode == gsPadCode)
			{
				Sound_CreateAtEntity("OverrideSound", "Entities_Station/tech/terminal_beeps/pathOS_comp/pathOS_comp_ confirm", ImGui_GetName(), 0.0f, false, 1.0f);
				ImGui_SetStateInt("CurrentState", eDivesuitPanelState_BootupSelectSuit);
				StationGui_SetNumpadInput("");
				StationGui_SetActiveApp(eDiveSuitPanelState_BootSequence);
				ActivateSuit();
			}
			else
			{	
				Sound_CreateAtEntity("ErrorSound", "Entities_Station/tech/terminal_beeps/pathOS_comp/pathOS_comp_error", ImGui_GetName(), 0.0f, false, 1.0f);
				Entity_SetVarString(ImGui_GetName(), "Error", "InvalidCode");
				StationGui_SetNumpadInput("");	
				cLux_AddTodoMessage("ART: Code needed on dive suit for code '14623'!");
			}
		}
		
		//////////////////////////////////
		// Return to main menu
		if (ImGui_DoButton("ButtonMain", "ButtonMain", ImGui_NrmPosGroup(cVector3f(0.05, 0.85, 2)), ImGui_NrmSizeGroup(cVector2f(0.275, 0.1))))
		{
			StationGui_SetActiveApp(eDivesuitPanelState_MainMenu);
		}
	}
	
	//--------------------------------------------------------
	
	void DisplayXRayAnimation(float afTimeStep, cVector3f avPos)
	{
		float fFramesPerSecond = 10.0f;
		
		/////////////////////////////////////////
		// Image Names
		tString sXRayEmpty = "xray_omicron_empty_01.dds"; 			// -- nothing inserted in to suit
		tString sXRayBrain = "xray_omicron_brain_01.dds"; 			// -- brain inserted
		tString sXRayBattery = "xray_omicron_battery_01.dds"; 		// -- battery inserted
		tString sXRayBrainAndBattery = "xray_omicron_both_01.dds"; // -- both inserted
		tString sXRayGrowth = "xray_omicron_growth_01.dds"; 		// -- while growing (after structure gel)
		tString sXRayLoop = "xray_omicron_final_01.dds"; 			// -- while growing
		
		tString sCorrectImage = sXRayEmpty;
		
		if (mbBrainInsertedInCorpse)
			sCorrectImage = sXRayBrain;
		if (mbBatteryInsertedInCorpse)
			sCorrectImage = sXRayBrainAndBattery;
		if (mbDisplayActivatedSuit)
			sCorrectImage = sXRayLoop;
		
		cImGuiGfx emptyGfx(sCorrectImage, eImGuiGfx_TextureAnimated);
		emptyGfx.mfAnimationTime = 1.0f / fFramesPerSecond;
		emptyGfx.mColor.a = 1.0f;
		
		ImGui_DoImageCorrectAspect(emptyGfx, avPos);
	}
	
	//--------------------------------------------------------
	bool mbSuitErrorSound = false;
	bool mbSuitErrorBeepAllowed = true;
	bool mbSuitTestTempSound = true;
	bool mbSuitTestPulseSound = true;
	bool mbSuitTestSkinSound = true;
	bool mbSuitTestBrainSound = true;
	bool mbSuitCalibrationTextSoundActive = false;
	bool mbCalibrationCompleteBeep = true;
	
	void DivesuitBootSequence(float afTimeStep)
	{
		cImGuiButtonData button = StationGui_CreateDefaultButtonData();
		button.mbClipText = false;
		
		////////////////////////////
		// Text
		cImGuiTextFrameData textHeader = ImGui_GetDefaultTextFrame();
		textHeader.mbUseBackgroundGfx = false;
		textHeader.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.045);
		textHeader.mFontAlign = eFontAlign_Center;
		
		cImGuiTextFrameData textFrameData = ImGui_GetDefaultTextFrame();
		textFrameData.mbUseBackgroundGfx = false;
		textFrameData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.045);
		textFrameData.mFontAlign = eFontAlign_Left;
		
		cImGuiTextFrameData textError = ImGui_GetDefaultTextFrame();
		textError.mbUseBackgroundGfx = false;
		textError.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.045);
		textError.mFontAlign = eFontAlign_Right;
		textError.mColorText = cColor_Red;
		
		cImGuiTextFrameData textOrange = ImGui_GetDefaultTextFrame();
		textOrange.mbUseBackgroundGfx = false;
		textOrange.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.045);
		textOrange.mFontAlign = eFontAlign_Right;
		textOrange.mColorText = cColor(1.0f,0.3f,0.0f);
		
		cImGuiTextFrameData textOkay = ImGui_GetDefaultTextFrame();
		textOkay.mbUseBackgroundGfx = false;
		textOkay.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.045);
		textOkay.mFontAlign = eFontAlign_Right;
		textOkay.mColorText = cColor_Green;
		
		cImGuiTextFrameData textBigError = ImGui_GetDefaultTextFrame();
		textBigError.mbUseBackgroundGfx = false;
		textBigError.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.045);
		textBigError.mFontAlign = eFontAlign_Center;

		float fY = 0.0f;
		
		if (!mbDiveSuitLoadComplete) 
		{
			GenericTerminalLoadingSoundStart(ImGui_GetName());
			if (DoLoadingWindow("LoadingWindow", "Loading", "Loading", 4.0f, true))
			{
				GenericTerminalLoadingSoundStop(ImGui_GetName());
				mbDiveSuitLoadComplete = true;
			}	
			return;
		}
		
		///////////////////////////////////////////////////////
		// Display big "Suit Error!" warning for a few seconds
		float fErrorTime = ImGui_GetStateFloat("SuitErrorTimer",0.0f);
		float fFlashTime = ImGui_GetStateFloat("SuitErrorFlash",0.0f);
		if (fErrorTime < 6.0f)
		{
			// Run the timers
			if (fFlashTime > 1.0f) fFlashTime = 0.0f;
			ImGui_SetStateFloat("SuitErrorTimer", fErrorTime + afTimeStep);
			ImGui_SetStateFloat("SuitErrorFlash", fFlashTime + afTimeStep);
			
			if(mbSuitErrorSound==false)
			{
				Sound_CreateAtEntity("ErrorFound", "03_02_omicron_inside/SFX/suit_diagnostics/suit_error_found", "diveroom_computer_soundsource");
				mbSuitErrorSound = true;
			}
			
			// Display message
			if (fFlashTime < 0.5f)
			{
				ImGui_SetModColorMul(cColor_Red);
				ImGui_DoTextFrameExt("DivesuitBigError", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textBigError, ImGui_NrmPosGroup(cVector3f(0.0, fY, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			}
			
			ImGui_SetModColorMul(cColor_White);
			ImGui_DoTextFrameExt("DivesuitPreparingDiag", ImGui_NrmSizeGroup(cVector2f(0.05, 0.45)), 5, 0, textBigError, ImGui_NrmPosGroup(cVector3f(0.0, fY, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
					
			return;
		}
		
		/*//(removed)////////////////////////////////
		// When the corpse is activated, start the sine wave
		int lFreq = mbGelInsertedInCorpse ? 9 : 0;	// correct val is 9
		int lOffset = mbGelInsertedInCorpse ? 3 : 0;  // correct val is 3
		int lAmp = mbGelInsertedInCorpse ? 7 : 0;  // correct val is 7
			
		TransferSineWave("",afTimeStep,0.1f,0.7f,lFreq,lOffset,lAmp);*/
		
		DisplayXRayAnimation(afTimeStep, ImGui_NrmPos(cVector3f(0.05,0.1,0.1)));
		
	
		
		ImGui_DoTextFrameExt("DivesuitChecks", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textHeader, ImGui_NrmPosGroup(cVector3f(0.35, -0.2, 2)), ImGui_NrmSizeGroup(cVector2f(0.65,1)));
		
		///////////////////////////////
		// Proceed to next step after approx 2.5 seconds
		mfDivesuitBootTimer += afTimeStep;
		
		
		if (mbFasterSuitTerminalReadout)
		{
			mfDivesuitBootTimer += afTimeStep * 5.0f;
		}
		
		if (mlDivesuitBootCount < 7)
		{
			if (mfDivesuitBootTimer >= cMath_RandRectf(2.25f,3.25f))
			{
				DiagnosticTerminalLoadingSoundStart("diveroom_computer_soundsource");
				mlDivesuitBootCount++;
				mfDivesuitBootTimer = 0.0f;
				mbSuitErrorBeepAllowed = true;
			}
		}
		
		if (mlDivesuitBootCount == 1)
		{
			mbSuitTestTempSound = true;
			mbSuitTestPulseSound = true;
			mbSuitTestSkinSound = true;
			mbSuitTestBrainSound = true;
			mbSuitErrorBeepAllowed = true;
		}
		

		///////////////////////////////
		// Stall the test on the last step
		if (mlDivesuitBootCount == 7)
		{
			if (mfDivesuitBootTimer > 5.0f)
			{
				mlDivesuitBootCount++;
			}
		}
		
		/////////////////////////////
		// Skin Galvanic Response (GEL)
		fY += 0.0;
		
		if (mlDivesuitBootCount >= 1)
		{
			cVector2f vFontSize = textFrameData.mFont.mvSize;
			ImGui_ResizeFontToFit("DivesuitTest1", textFrameData.mFont, ImGui_GetCurrentGroupSize().x*0.35);
			ImGui_DoTextFrameExt("DivesuitTest1", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textFrameData, ImGui_NrmPosGroup(cVector3f(0.4, fY, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			textFrameData.mFont.mvSize = vFontSize;
			
			if(mbFasterSuitTerminalReadout==false && mlDivesuitBootCount == 1 && mbSuitTestSkinSound==true)
			{
				Sound_CreateAtEntity("SkinTest", "03_02_omicron_inside/SFX/suit_diagnostics/suit_fail/skin_fail", "SoundSrc_DiveSuitLocker");
				mbSuitTestSkinSound = false;
			}
		}
		if (mlDivesuitBootCount >= 2)
		{
			if (mbGelInsertedInCorpse)
				ImGui_DoTextFrameExt("DivesuitOkay", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textOkay, ImGui_NrmPosGroup(cVector3f(0.0, fY, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			else
				ImGui_DoTextFrameExt("DivesuitFail", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textError, ImGui_NrmPosGroup(cVector3f(0.0, fY, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
		
			if(mbSuitErrorBeepAllowed==true && mlDivesuitBootCount == 2)
			{
				mbSuitErrorBeepAllowed = false;
				Sound_CreateAtEntity("DivesuitFail", "03_02_omicron_inside/SFX/suit_diagnostics/suit_fail_beep", "diveroom_computer_soundsource");
			}
		}
		
		/////////////////////////////
		// POWER
		fY += 0.05;
		if (mlDivesuitBootCount >= 3)
		{
			cVector2f vFontSize = textFrameData.mFont.mvSize;
			ImGui_ResizeFontToFit("DivesuitTest2", textFrameData.mFont, ImGui_GetCurrentGroupSize().x*0.35);
			ImGui_DoTextFrameExt("DivesuitTest2", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textFrameData, ImGui_NrmPosGroup(cVector3f(0.4, fY, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			textFrameData.mFont.mvSize = vFontSize;
			
			if(mbFasterSuitTerminalReadout==false && mlDivesuitBootCount == 3 && mbSuitTestPulseSound==true)
			{
				Sound_CreateAtEntity("PulseTest", "03_02_omicron_inside/SFX/suit_diagnostics/suit_fail/pulse_fail", "SoundSrc_DiveSuitLocker");
				mbSuitTestPulseSound = false;
			}
		}
		
		if (mlDivesuitBootCount >= 4)
		{
			if(mbFasterSuitTerminalReadout==false && mlDivesuitBootCount == 4 && mbBatteryInsertedInCorpse==false)
			{
				if(mbSuitTestTempSound==true)
				{
					Sound_CreateAtEntity("TempTest", "03_02_omicron_inside/SFX/suit_diagnostics/suit_fail/temperature_fail", "SoundSrc_DiveSuitLocker");
					mbSuitTestTempSound = false;
				}
				
			}
			
			
			if (mbBatteryInsertedInCorpse)
			{
				ImGui_DoTextFrameExt("DivesuitOkay", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textOkay, ImGui_NrmPosGroup(cVector3f(0.0, fY, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
				//ImGui_SetModColorMul(cColor_White);
				
				if(mbFasterSuitTerminalReadout==false && mlDivesuitBootCount == 4 && mbSuitTestTempSound==true)
				{
					Sound_CreateAtEntity("TempTest", "03_02_omicron_inside/SFX/suit_diagnostics/suit_pass/temperature_pass", "SoundSrc_DiveSuitLocker");
					mbSuitTestTempSound = false;
				}
				
				if(mbSuitErrorBeepAllowed==true && mlDivesuitBootCount == 4)
				{
					mbSuitErrorBeepAllowed = false;
					Sound_CreateAtEntity("DivesuitFail", "03_02_omicron_inside/SFX/suit_diagnostics/suit_pass_beep", "diveroom_computer_soundsource");
				}
				
			}
			else
			{
				ImGui_DoTextFrameExt("DivesuitFail", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textError, ImGui_NrmPosGroup(cVector3f(0.0, fY, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			
				if(mbSuitErrorBeepAllowed==true && mlDivesuitBootCount == 4)
				{
					mbSuitErrorBeepAllowed = false;
					Sound_CreateAtEntity("DivesuitFail", "03_02_omicron_inside/SFX/suit_diagnostics/suit_fail_beep", "diveroom_computer_soundsource");
				}
			
			}
		}
		
		/////////////////////////////
		// Brain Waves
		fY += 0.05;
		if (mlDivesuitBootCount >= 5)
		{
			cVector2f vFontSize = textFrameData.mFont.mvSize;
			ImGui_ResizeFontToFit("DivesuitTest3", textFrameData.mFont, ImGui_GetCurrentGroupSize().x*0.35);
			ImGui_DoTextFrameExt("DivesuitTest3", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textFrameData, ImGui_NrmPosGroup(cVector3f(0.4, fY, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			textFrameData.mFont.mvSize = vFontSize;
			
			if(mbFasterSuitTerminalReadout==false && mlDivesuitBootCount == 5 && mbSuitTestBrainSound == true)
			{
				Sound_CreateAtEntity("BrainTest", "03_02_omicron_inside/SFX/suit_diagnostics/suit_fail/brain_fail", "SoundSrc_DiveSuitLocker");
				mbSuitTestBrainSound = false;
			}
		}
		if (mlDivesuitBootCount >= 6)
		{
			ImGui_DoTextFrameExt("DivesuitFail", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textError, ImGui_NrmPosGroup(cVector3f(0.0, fY, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			
			if(mbSuitErrorBeepAllowed==true && mlDivesuitBootCount == 6)
			{
				mbSuitErrorBeepAllowed = false;
				Sound_CreateAtEntity("DivesuitFail", "03_02_omicron_inside/SFX/suit_diagnostics/suit_fail_beep", "diveroom_computer_soundsource");
			}
		
		}
		
		/////////////////////////////
		// Body Temp
		fY += 0.05;
		if (mlDivesuitBootCount >= 7)
		{
			cVector2f vFontSize = textFrameData.mFont.mvSize;
			ImGui_ResizeFontToFit("DivesuitTest4", textFrameData.mFont, ImGui_GetCurrentGroupSize().x*0.35);
			ImGui_DoTextFrameExt("DivesuitTest4", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textFrameData, ImGui_NrmPosGroup(cVector3f(0.4, fY, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			textFrameData.mFont.mvSize = vFontSize;
		}
		if (mlDivesuitBootCount >= 8)
		{
			if (mbGelInsertedInCorpse)
				ImGui_DoTextFrameExt("DivesuitFail", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textOrange, ImGui_NrmPosGroup(cVector3f(0.0, fY, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			else
				ImGui_DoTextFrameExt("DivesuitFail", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textError, ImGui_NrmPosGroup(cVector3f(0.0, fY, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));	
			
			fY += 0.1;
			textFrameData.mFontAlign = eFontAlign_Center;
			ImGui_DoTextFrameExt("DivesuitFinal", ImGui_NrmSizeGroup(cVector2f(0, 0.4)), 5, 0, textFrameData, ImGui_NrmPosGroup(0.4, fY, 0), ImGui_NrmSizeGroup(0.55,1));
		
			if(mbSuitErrorBeepAllowed==true && mlDivesuitBootCount == 8)
			{
				mbSuitErrorBeepAllowed = false;
				Sound_CreateAtEntity("DivesuitFail", "03_02_omicron_inside/SFX/suit_diagnostics/suit_fail_beep", "diveroom_computer_soundsource");
			}
		
		}
		
		/////////////////////////////////////////
		// Provide button to return to main menu when sequence is complete
		if (mlDivesuitBootCount >= 8)
		{
			DiagnosticTerminalLoadingSoundStop("diveroom_computer_soundsource");
			
			cVector2f vFontSize = button.mFont.mvSize;
			ImGui_ResizeFontToFit("ButtonRetry", button.mFont, ImGui_GetCurrentGroupSize().x*0.25);
			if (ImGui_DoButtonExt("ButtonRetry", "ButtonRetry", button, ImGui_NrmPosGroup(cVector3f(0.4, 0.85, 2)), ImGui_NrmSizeGroup(cVector2f(0.275, 0.1))))
			{
				mlDivesuitBootCount = 0;
				mfDivesuitBootTimer = 0.0f;
				
				//////////////////////////////
				// If corpse has been fully crafted, the retry button will switch states to activating the corpse
				if (mbCorpseCrafted)
				{
					StationGui_SetActiveApp(eDiveSuitPanelState_ActivateCorpse);
					ActivateCorpse();
				}
			}
			button.mFont.mvSize = vFontSize;
			ImGui_ResizeFontToFit("ButtonMain", button.mFont, ImGui_GetCurrentGroupSize().x*0.25);
			
			if (ImGui_DoButtonExt("ButtonMain", "ButtonMain", button, ImGui_NrmPosGroup(cVector3f(0.7, 0.85, 2)), ImGui_NrmSizeGroup(cVector2f(0.275, 0.1))))
			{
				StationGui_SetActiveApp(eDivesuitPanelState_MainMenu);
			}
		}
	}
	
	//--------------------------------------------------------
	
	void DoNumpadButton(const cVector3f &in avPos, const tString &in asNum)
	{
		ImGui_SetTransCategory("");
		if (ImGui_DoButton("Numpad_" + asNum, asNum, ImGui_NrmPosGroup(avPos), ImGui_NrmSizeGroup(cVector2f(0.32, 0.18))))
		{
			Depth_Audio_Terminal_Forward("diveroom_computer_soundsource");
			if (msPadCode.length() < gsPadCode.length())
				msPadCode += asNum;
		}
		ImGui_SetTransCategory("03_02_omicron_inside");
	}
	
	//--------------------------------------------------------
	
	int mlSuitGrowthFrame = 1;
	int mlSuitMaxFrame = 42;
	float mfSuitGrowthTime = 0.0f;
	bool mbDiveSuitActivateSound = false;
	bool mbDisplayActivatedSuit = false;
	
	void DivesuitActivateCorpse(float afTimeStep)
	{
		//todo: Images!
		ImGui_SetTransCategory("");
		
		mbDisplayActivatedSuit = true;
		
		cImGuiLabelData label;
		label.mFontAlign = eFontAlign_Left;
		
		if(mbDiveSuitActivateSound==false)
		{
			Sound_CreateAtEntity("ActivateTest", "03_02_omicron_inside/SFX/suit_diagnostics/suit_pass/mechanism_pass", "SoundSrc_DiveSuitLocker");
			mbDiveSuitActivateSound = true;
		}

		//////////////////////////////////
		// When the corpse is activated, start the sine wave
		int lFreq = mbGelInsertedInCorpse ? 9 : 0;	// correct val is 9
		int lOffset = mbGelInsertedInCorpse ? 3 : 0;  // correct val is 3
		int lAmp = mbGelInsertedInCorpse ? 7 : 0;  // correct val is 7		
		bool bFullyGrown = ImGui_GetStateBool("SuitFullyGrown",false);
		float fFramesPerSecond = 10.0f;
		tString sCorrectImage = "";
		
		//////////////////////////////////////
		// Animate Growth
		if (bFullyGrown == false)
		{
			
			lFreq = cMath_RandRectl(3,12);
			lOffset = cMath_RandRectl(1,12);
			lAmp = cMath_RandRectl(2,12);
			
			mfSuitGrowthTime += afTimeStep;
			if (mfSuitGrowthTime > 1.0f/fFramesPerSecond)
			{
				mfSuitGrowthTime = 0.0f;
				mlSuitGrowthFrame++;
				if (mlSuitGrowthFrame > mlSuitMaxFrame)
				{
					mlSuitGrowthFrame = mlSuitMaxFrame;
					ImGui_SetStateBool("SuitFullyGrown",true);
					bFullyGrown = true;
				}
			}
			
			tString sFrame = ""+mlSuitGrowthFrame;
			
			if (sFrame.length() < 2)
			{
				sFrame = "0"+sFrame;
			}
			
			sCorrectImage = "xray_omicron_growth_"+sFrame+".dds";
			cImGuiGfx emptyGfx(sCorrectImage, eImGuiGfx_Texture);
			emptyGfx.mColor.a = 1.0f;
			ImGui_DoImageCorrectAspect(emptyGfx,ImGui_NrmPos(cVector3f(0.05,0.1,0.1)));
		}
		
		if (bFullyGrown == true)
		{
			sCorrectImage = "xray_omicron_final_01.dds";
			cImGuiGfx emptyGfx(sCorrectImage, eImGuiGfx_TextureAnimated);
			emptyGfx.mfAnimationTime = 1.0f / fFramesPerSecond;
			emptyGfx.mColor.a = 1.0f;
			ImGui_DoImageCorrectAspect(emptyGfx,ImGui_NrmPos(cVector3f(0.05,0.1,0.1)));
		}
		
		
		//TransferSineWave("",afTimeStep,0.1f,0.7f,lFreq,lOffset,lAmp);
		
		SuitActivationText(afTimeStep);
		
	}
	
	void SuitActivationText(float afTimeStep)
	{		
		//////////////////////////////
		// Widget data
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		
		cImGuiTextFrameData textData = StationGui_CreateDefaultTextFrameData();
		textData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
		
		if(mbSuitCalibrationTextSoundActive==false)
		{
			mbSuitCalibrationTextSoundActive = true;
			Sound_CreateAtEntity("ScrollingText", "01_01_upsilon_awake/amb/spot/scrolling_text_terminal", "diveroom_computer_soundsource");
		}
		
		//////////////////
		// Draw static
		int lStaticFrames = ImGui_GetStateInt("Static",0);
		if (lStaticFrames > 0)
		{
			ImGui_DoImage(cImGuiGfx("station/static/static_0"), ImGui_NrmPos(cVector3f(-0.5+cMath_RandRectf(-0.05f,0.05f),-0.2+cMath_RandRectf(-0.05f,0.05f),7.0)),ImGui_NrmSize(cVector2f(2.0,2.0)));
			--lStaticFrames;
		}
		
		bool bFullyGrown = ImGui_GetStateBool("SuitFullyGrown",false);
		
		//////////////////
		// Text
		ImGui_SetTransCategory("03_02_omicron_inside");
		
		if (bFullyGrown)
		{
			ImGui_DoWindowStart("SuitCraftHeadingComplete", window, ImGui_NrmPosGroup(0.4, 0.02, 1), ImGui_NrmSizeGroup(0.6, 0.775));
			
			if(mbCalibrationCompleteBeep==true)
			{
				Sound_CreateAtEntity("CalibrationComplete", "03_02_omicron_inside/SFX/suit_diagnostics/calibration_complete", "diveroom_computer_soundsource");
				mbCalibrationCompleteBeep = false;
			}
		}
			
		else
			ImGui_DoWindowStart("SuitCraftHeadingInProgress", window, ImGui_NrmPosGroup(0.4, 0.02, 1), ImGui_NrmSizeGroup(0.6, 0.775));
			
			float fOffs = Depth_ImGui_GetScrollValue("MonitorGibberish");
			float fOverlap = ImGui_DoTextFrameExt("MonitorGibberish_1", ImGui_NrmSizeGroup(cVector2f(0.075, 0.05)), 5, int(fOffs), textData, 
													ImGui_NrmPosGroup(cVector3f(0, 0, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			
			if (fOverlap>0.0f)
			{
				fOffs += afTimeStep*10;
				
				if (fOffs>58)
				{
					lStaticFrames = 10;
					fOffs = 0;
				}
				
				Depth_ImGui_SetScrollValue("MonitorGibberish", fOffs);
			}
		ImGui_DoWindowEnd();
		
		ImGui_SetStateInt("Static",lStaticFrames);
	}

	
	//--------------------------------------------------------

	/////////////////////////////////////////
	// Terminal *Robot Repair Puzzle*
	/////////////////////////////////////////

	//-------------------------------------------------------

	cRobotRect mChipAreaRect;

	array<cRobotRect> mvRobotRects;
	array<cRobotRect> mvRobotOutputs;
	array<cRobotRect> mvRobotSignals;
	//array<cRobotRect> mvRobotInhibitors;
	
	array<array<cVector2f>> mvCircuitPoints;
	array<bool> mvSignalConnected;
	array<cVector2f> mvRobotCircuitStart;
	
	float mfRobotRepairPulse = 0.0f;
	
	cRobotRect mInhibitorComms;
	cRobotRect mInhibitorMotor;
	cRobotRect mInhibitorOptics;
	cRobotRect mInhibitorEject;
	
	int mlOpticsConnections = 0;
	int mlMotorConnections = 0;
	int mlCommsConnections = 0;
	int mlEjectConnections = 0;
	
	bool mbSignalAlpha = false;
	bool mbSignalBeta = false;
	bool mbSignalGamma = false;
	
	float mfRobotStaticTime = 0.0f;
	

	//-------------------------------------------------------
	
	//////////////////////////////////////////
	// ROBOT PUZZLE HELPERS
	//////////////////////////////////////////
	
	//-------------------------------------------------------
	
	void SetupRobotPuzzle()
	{
		
		////////////////
		// Clear Arrays
		mvRobotSignals.resize(0);
		mvRobotOutputs.resize(0);
		mvRobotRects.resize(0);
		mvCircuitPoints.resize(3);
		
		// Sizes		
		float fWidth = 0.075f;
		float fHeight= 0.095f;
		
		/////////////////////
		// Set up play area
		mChipAreaRect.SetRect("ChipArea",ImGui_NrmSize(cVector2f(0.1425,0.1675)),ImGui_NrmSize(cVector2f(0.335,0.64)));
		
		///////////////////////
		// Set up signals
		AddRobotSignalTile("AlphaSignal",cVector2f(0.0675f,0.19f));
		AddRobotSignalTile("BetaSignal",cVector2f(0.0675f,0.335f));
		AddRobotSignalTile("GammaSignal",cVector2f(0.0675f,0.48f));
		//AddRobotSignalTile("DeltaSignal",cVector2f(0.0675f,0.6325f));
		
		////////////////////////
		// Set up circuit outputs
		AddRobotOutputTile("OutputComms",cVector2f(0.485f,0.19f));
		AddRobotOutputTile("OutputMotor",cVector2f(0.485f,0.335f));
		AddRobotOutputTile("OutputOptics",cVector2f(0.485f,0.4825f));
		AddRobotOutputTile("OutputEject0",cVector2f(0.279f,0.61f));
		AddRobotOutputTile("OutputEject1",cVector2f(0.179f,0.61f));
		AddRobotOutputTile("OutputEject2",cVector2f(0.379f,0.61f));
		
		////////////////////////////
		// Set up nodes (rotatables)
		mvRobotRects.resize(0);
	
		//////////////////////////////////////
		// Set up a specific pattern to start and give player something interesting
		AddRobotPuzzleTile("Row1Col1",cVector2f(0.179,0.19),cVector3f(-0.075,-0.065,0),eRobotPuzzleTile_Right);
		AddRobotPuzzleTile("Row1Col2",cVector2f(0.279,0.19),cVector3f(0.025,-0.065,0),eRobotPuzzleTile_Cross);
		AddRobotPuzzleTile("Row1Col3",cVector2f(0.379,0.19),cVector3f(0.125,-0.065,0),eRobotPuzzleTile_Left);
		AddRobotPuzzleTile("Row2Col1",cVector2f(0.179,0.335),cVector3f(-0.075,0.08,0),eRobotPuzzleTile_Cross);
		AddRobotPuzzleTile("Row2Col2",cVector2f(0.279,0.335),cVector3f(0.025,0.08,0),eRobotPuzzleTile_Left);
		AddRobotPuzzleTile("Row2Col3",cVector2f(0.379,0.335),cVector3f(0.125,0.08,0),eRobotPuzzleTile_Cross);
		AddRobotPuzzleTile("Row3Col1",cVector2f(0.179,0.4825),cVector3f(-0.075,0.2275,0),eRobotPuzzleTile_Up);
		AddRobotPuzzleTile("Row3Col2",cVector2f(0.279,0.4825),cVector3f(0.025,0.2275,0),eRobotPuzzleTile_Cross);
		AddRobotPuzzleTile("Row3Col3",cVector2f(0.379,0.4825),cVector3f(0.125,0.2275,0),eRobotPuzzleTile_Up);
		
		for (uint i=0; i<3; ++i)
		{
			mvRobotCircuitStart.push_back(cVector2f(900,900));
			mvSignalConnected.push_back(false);
		}
	}
	
	//-------------------------------------------------------
	
	void ChangeRobotPuzzleTile(tString asName, int alDir)
	{
		for (int i=0; i<mvRobotRects.length();++i)
		{
			if (mvRobotRects[i].msName == asName)
			{
				mvRobotRects[i].mlDirection = alDir;
			}
		}
	}
	
	//-------------------------------------------------------
	
	void AddRobotPuzzleTile(tString asName, cVector2f avPos, cVector3f avDrawPos, int alDir)
	{
		float fWidth = 0.075f;
		float fHeight= 0.095f;
		
		cRobotRect tile;
		tile.SetRect(asName,ImGui_NrmSize(avPos),ImGui_NrmSize(cVector2f(fWidth,fHeight)));
		tile.mlDirection = alDir;
		tile.mvDrawPos = avDrawPos;
		mvRobotRects.push_back(tile);
	}
	
	//-------------------------------------------------------
	
	void AddRobotSignalTile(tString asName, cVector2f avPos)
	{
		float fWidth = 0.075f;
		float fHeight= 0.095f;
		
		cRobotRect tile;
		tile.SetRect(asName,ImGui_NrmSize(avPos),ImGui_NrmSize(cVector2f(fWidth,fHeight)));
		mvRobotSignals.push_back(tile);
	}
	
	//-------------------------------------------------------
	
	void AddRobotOutputTile(tString asName, cVector2f avPos)
	{
		float fWidth = 0.075f;
		float fHeight= 0.095f;
		
		cRobotRect tile;
		tile.SetRect(asName,ImGui_NrmSize(avPos),ImGui_NrmSize(cVector2f(fWidth,fHeight)));
		mvRobotOutputs.push_back(tile);
	}
	
	//-------------------------------------------------------
	
	void RobotRepairTerminal_Solved(const tString&in asEntityName, float afTimeStep)
	{
		/* Quick Explanation
		 * ------------------
		 * This is only shown once the brain has popped out
		 */
		 
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		ImGui_SetTransCategory("03_02_omicron_inside");

		cColor colorRed = gStationGuiColor_Warning;
		cGuiDialogBoxSettings dialogBox = StationGui_CreateDefaultDialogBox();
		dialogBox.mWindow.mColorBase = colorRed; 
		dialogBox.mTextFrame.mColorText = cColor(1,1,1,1);
		dialogBox.mfZ = 20.0;
		dialogBox.mType = eGuiDialogBoxType_NoButton;	

		
		if (ImGui_GetStateBool("ErrorSoundPlayed",false) == false)
		{
			Sound_CreateAtEntity("TerminalNegative", "Entities_Station/tech/terminal_beeps/pathOS_comp/pathOS_comp_negative", asEntityName, 0.0f, false, 1.0f);
			ImGui_SetStateBool("ErrorSoundPlayed",true);
		}
		
		ImGui_GroupBegin(ImGui_NrmPos(cVector3f(0.0, 0.0, 1)), ImGui_NrmSize(cVector2f(1.0, 1.0)));
			eGuiDialogCode buttonPressed = Depth_ImGui_DialogBox("RobotArmErrorCaption", "RobotPuzzle_Solved", dialogBox);
		ImGui_GroupEnd();
	}
	
	//-------------------------------------------------------

	void RobotRepairTerminal_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		
		/* Quick Explanation
		 * ------------------
		 * This is the main terminal for the Robot Repair Puzzle.
		 * We use a custom class (Found at the top of this map script) for each game
		 * tile and some custom logic to drive a crosshair around the screen.
		 * 
		 * When the player clicks on any gameplay element here (Output nodes and game
		 * tiles) we update the circuit and go through various functions to check the
		 * connection
		 * 
		 */
		 
		if (!mbBrainTerminalActive && mfRobotStaticTime <= 0)
		{
			RobotRepairTerminal_Solved(asEntityName, afTimeStep);
			return;
		}
		 
		ImGui_SetTransCategory("03_02_omicron_inside");
		
		////////////////////////////////
		// First time setup - only happens once
		if (ImGui_GetStateBool("Setup", false)==false)
		{
			SetupRobotPuzzle();
			ImGui_SetStateBool("Setup",true);
			
			ImGui_SetStateBool("EditCircuit",true);
			ImGui_SetStateFloat("cursorX",0.5f);
			ImGui_SetStateFloat("cursorY",0.5f);
		}
		
		////////////////////////////
		// Text
		cImGuiTextFrameData textData = ImGui_GetDefaultTextFrame();
		textData.mbUseBackgroundGfx = false;
		textData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
		textData.mFontAlign = eFontAlign_Left;
		ImGui_SetDefaultTextFrame(textData);
		
		/////////////////////////////////
		// Button
		cImGuiButtonData button = StationGui_CreateDefaultButtonData();
		button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
		ImGui_SetDefaultButton(button);
		float fButtonWidth = 0.3f;
		float fOffset = 0.1f;
		
		cImGuiLabelData header;
		header.mColorBase = cColor(0.45,0.75,0.75,1.0);
		header.mFontAlign = eFontAlign_Center;
		
		/////////////////////////////////
		// Custom graphic declaration
		cImGuiGfx gfxDot = cImGuiGfx("station_omicron_map_position.dds");
		cImGuiGfx gfxRobotMain = cImGuiGfx("omicronrobot.dds");
		cImGuiGfx gfxRobotBody = cImGuiGfx("omicronrobotbody.dds");
		cImGuiGfx gfxRobotInput = cImGuiGfx("omicronrobotinput.dds");
		
		/////////////////////////////////
		// Backdrop
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		ImGui_GroupBegin(ImGui_NrmPos(cVector3f(0.25, 0.25, 1)), ImGui_NrmSize(cVector2f(0.5, 0.7)));

			////////////////////////////////////////////////
			// Draw robot brain chip background
			ImGui_DoImage(gfxRobotMain,ImGui_NrmPos(cVector3f(-0.2,-0.15,0)));
			//ImGui_DoImage(gfxRobotBody,ImGui_NrmPos(cVector3f(0.2,-0.15,0)));
			
			//////////////////////////
			// Draw special crosshair if in circuit edit mode
			cVector2f vCursor;
			if (ImGui_GetStateBool("EditCircuit", false) == true)
			{
				vCursor = cVector2f(ImGui_GetStateFloat("cursorX"),ImGui_GetStateFloat("cursorY"));
				RobotRepairTerminalCrosshair(asEntityName, afTimeStep);
			}
			
			////////////////
			// Draw input signals
			DrawRobotInputSignal("AlphaSignal",ImGui_NrmPos(cVector3f(-0.19,-0.065,0)),vCursor);
			DrawRobotInputSignal("BetaSignal",ImGui_NrmPos(cVector3f(-0.19,0.08,0)),vCursor);
			DrawRobotInputSignal("GammaSignal",ImGui_NrmPos(cVector3f(-0.19,0.2275,0)),vCursor);
				
			//////////////////////
			// Draw Text Labels
			ImGui_DoLabel("RobotPuzzle_COMMS",ImGui_NrmPos(cVector3f(0.26,-0.075,0)));
			ImGui_DoLabel("RobotPuzzle_MOTOR",ImGui_NrmPos(cVector3f(0.26,0.07,0)));
			ImGui_DoLabel("RobotPuzzle_OPTICS",ImGui_NrmPos(cVector3f(0.26,0.2175,0)));

		
			
			////////////////
			// Draw Game tiles
			for (uint i=0; i<mvRobotRects.length(); ++i)
			{
				DrawRobotRepairNode(i,mvRobotRects[i].mvDrawPos, vCursor);
			}
			
			///////////////
			// Debug Only
			if (cLux_ScriptDebugOn())
			{
				for (uint i=0; i<mvRobotRects.length();++i)	{ mvRobotRects[i].DrawDebug(vCursor); }
				for (uint i=0; i<mvRobotSignals.length();++i) {	mvRobotSignals[i].DrawDebug(vCursor); }
				for (uint i=0; i<mvRobotOutputs.length();++i) {	mvRobotOutputs[i].DrawDebug(vCursor); }
			}
			
			////////////////////////
			// Draw the circuit
			cColor circuitColor = cColor(0.54,0.98,0.98,1.0f);
			float fLineWidth = 4.0f;
			mfRobotRepairPulse += afTimeStep * 5.0f;
			for (int circuit=0; circuit < 3; ++circuit)
			{
				circuitColor = mvSignalConnected[circuit] ? cColor(0.54,0.98,0.54,1.0f) : cColor(0.54,0.98,0.98,1.0f);
				fLineWidth = mvSignalConnected[circuit] ? 7.0f+(cMath_Sin(mfRobotRepairPulse)*3.0f) : 5.0f+(cMath_Sin(mfRobotRepairPulse));
				for (int i=0; i < mvCircuitPoints[circuit].length - 1; i++)
				{
					ImGui_DrawLine(ImGui_NrmSize(mvCircuitPoints[circuit][i]),ImGui_NrmSize(mvCircuitPoints[circuit][i+1]),999.1f,fLineWidth,circuitColor);			
				}
			}
			
			/////////////////////////////////////////
			// Headers and text
			ImGui_DoLabelExt("RobotPuzzle_CORTEXCHIP",header,ImGui_NrmPos(cVector3f(0.075,-0.2,100)),cVector2f(1.0f,1.0f),2.0f);
			ImGui_DoLabelExt("RobotPuzzle_DIAGNOSTIC",header,ImGui_NrmPos(cVector3f(0.075,-0.125,100)),cVector2f(1.0f,1.0f),3.0f);
			
			ImGui_DoLabelExt("RobotPuzzle_REJECT",header,ImGui_NrmPos(cVector3f(0.075,0.625,100)),cVector2f(1.0f,1.0f),2.0f);
			ImGui_DoLabelExt("RobotPuzzle_CORTEXCHIP",header,ImGui_NrmPos(cVector3f(0.075,0.675,100)),cVector2f(1.0f,1.0f),2.0f);
			
			/////////////////////////////////////
			// Draw Camera View
			
			if (mfRobotStaticTime > 0)
			{
				if (ImGui_GetStateBool("StaticPlayed",false)==false)
				{
					Sound_CreateAtEntity("sfx_burst","03_02_omicron_inside/SFX/monitor_change",asEntityName,0.0f,false,1.0f);
					ImGui_SetStateBool("StaticPlayed",true);
				}
			
				mfRobotStaticTime -= afTimeStep;
				
				cImGuiGfx staticImage;
				int lStatic = cMath_RandRectl(0,1);
				staticImage.SetFile("station/static/static_"+lStatic);
				ImGui_DoImage(staticImage,ImGui_NrmPos(cVector3f(0.35,-0.09,1.9f)), ImGui_NrmSize(cVector2f(0.35f,0.39f)));
				
				if (mfRobotStaticTime <= 0)
					mbBrainTerminalActive = false;
			}
			else
			{
				ImGui_DoWindowStart("", StationGui_CreateDefaultWindowData(), ImGui_NrmPosGroup(0.7f, -0.125, 1), ImGui_NrmSizeGroup(0.7f, 0.55));
				cImGuiGfx gfx("RobotCamera", eImGuiGfx_Special);
				ImGui_DrawGfx(gfx, ImGui_NrmPos(cVector3f(0.625f,0.2f,100.0f)), ImGui_NrmSize(cVector2f(0.3f,0.3f)), cColor(2.54,2.98,2.98,1.0f));
			}
			ImGui_DoWindowEnd();
			
			
			
		
		ImGui_GroupEnd();
	}
	
	//-------------------------------------------------------
	
	void RobotRepairTerminal_GuiLeave(const tString&in asEntityName)
	{
		
	}

	//-------------------------------------------------------
	
	void DrawRobotInputSignal(tString asInputName, cVector3f avPos, cVector2f avCursor)
	{
		/* 
		 * Quick explanation:
		 * ---------------------
		 * 
		 * We check to see if the mouse is colliding with the robot input signal
		 * then we draw the correct graphic.
		 *
		 */
		 
		bool bCollide = false;
		for (uint i=0; i<mvRobotSignals.length();++i)
		{
			if (mvRobotSignals[i].CheckCollide(avCursor) && mvRobotSignals[i].msName == asInputName)
			{
				bCollide = true;
				break;
			}
		}
		
		cImGuiGfx gfxRobotInput;
		
		if (bCollide)
			gfxRobotInput = cImGuiGfx("omicronrobotinput_highlight.dds");
		else
			gfxRobotInput = cImGuiGfx("omicronrobotinput.dds");
		
		ImGui_DoImage(gfxRobotInput,avPos);
	}
	
	//-------------------------------------------------------
	
	void DrawRobotRepairNode(int alIndex, cVector3f avPos, cVector2f avCursor)
	{
		/* Quick Explanation
		 * -----------------
		 * Simply draw the appropriate game tile at the specified position 
		 * 
		 * Appends "_highlight" to the graphic name if the cursor is over it
		*/
		
		cImGuiGfx gfxRobotNode;

		int lDirection = mvRobotRects[alIndex].mlDirection;
		bool bCollide = mvRobotRects[alIndex].CheckCollide(avCursor);
		tString sGraphicName = "";
		tString sHighlight = "";
		
		if (bCollide)
			sHighlight = "_highlight";
		
		if (lDirection == 0) sGraphicName = "omicronrobotnode_right";
		if (lDirection == 1) sGraphicName = "omicronrobotnode_down";
		if (lDirection == 2) sGraphicName = "omicronrobotnode_left";
		if (lDirection == 3) sGraphicName = "omicronrobotnode_up";
		if (lDirection == 4) sGraphicName = "omicronrobotnode_cross";
		if (lDirection == 5) sGraphicName = "omicronrobotnode_output";
			
		gfxRobotNode = cImGuiGfx(sGraphicName + sHighlight + ".dds");
		ImGui_DoImage(gfxRobotNode,ImGui_NrmPos(cVector3f(avPos)));
		
		ImGui_ResetModifiers();
	}
	
	//-------------------------------------------------------
	
	void RobotRepairTraceCircuit(int alCircuit)
	{
		/* Quick Explanation
		 * ---------------------
		 * In this method we trace out the new circuit. This only happens whenever 
		 * the player clicks on a node or sets a new signal - so we are not tracing 
		 * this circuit every frame to help performance
		*/
		 
		int lHopsLeft = 13;
		int lCurrentHop = 0;
		float fHopDistance = 0.1f;
		mvSignalConnected[alCircuit] = false;
		mvCircuitPoints[alCircuit].resize(0);
		
		cVector2f vPos = mvRobotCircuitStart[alCircuit];
		cVector2f vDirection = cVector2f(1,0); // We start going right.
		cVector2f vDestination;
		
		mvCircuitPoints[alCircuit].push_back(vPos);
		
		//Lamp_SetLit("output_*",false,true);
		
		
		while (lHopsLeft > 0)
		{
			vDestination = vPos + (vDirection*fHopDistance);
			
			////////////////////
			// Check Exit nodes first
			for (uint i=0; i<mvRobotOutputs.length();++i)
			{
				if (mvRobotOutputs[i].CheckCollide(vDestination))
				{
					mvSignalConnected[alCircuit] = true;
					RobotRepairOutputReached(mvRobotOutputs[i].msName);
					mvCircuitPoints[alCircuit].push_back(mvRobotOutputs[i].mvCenter);
					lHopsLeft = 0;
					break;
				}
			}
			
			////////////////////
			// Out of bounds
			if (mChipAreaRect.CheckCollide(vDestination) == false)
				break;
			
			////////////////////
			// Run through all the circuit nodes
			for (int i=0; i<mvRobotRects.length();i++)
			{
				if (mvRobotRects[i].CheckCollide(vDestination))
				{
					if (mvRobotRects[i].mlDirection == 0) vDirection = cVector2f(1,0);
					else if (mvRobotRects[i].mlDirection == 1) vDirection = cVector2f(0,1);
					else if (mvRobotRects[i].mlDirection == 2) vDirection = cVector2f(-1,0);
					else if (mvRobotRects[i].mlDirection == 3) vDirection = cVector2f(0,-1);
					else if (mvRobotRects[i].mlDirection == 4) vDirection = vDirection;	
					else if (mvRobotRects[i].mlDirection == 5) vDirection = cVector2f(1,0); // locked pin
					vDestination = mvRobotRects[i].mvCenter;
					break;
				}
			}
			
			////////////////////
			// Add to the line
			vPos = vDestination;
			lHopsLeft--;
			mvCircuitPoints[alCircuit].push_back(vPos);
		}
	}
	
	//----------------------------------------------------------------------------------
	
	void RobotRepairTerminalCrosshair(const tString &in asEntityName, float afTimeStep)
	{
		float fX = ImGui_GetStateFloat("cursorX");
		float fY = ImGui_GetStateFloat("cursorY");
		float fFenceX = 0.997f;
		float fFenceY = 0.997f;
		float fCursorSpeed = 0.005f;
		
		// Key/Pad Movement
		if (ImGui_ActionIsDown(eImGuiAction_Left))	fX -= fCursorSpeed;
		if (ImGui_ActionIsDown(eImGuiAction_Right))	fX += fCursorSpeed;
		if (ImGui_ActionIsDown(eImGuiAction_Up))	fY -= fCursorSpeed;		
		if (ImGui_ActionIsDown(eImGuiAction_Down))	fY += fCursorSpeed;
		
		fX = cMath_Clamp(fX,0.0f,fFenceX);
		fY = cMath_Clamp(fY,0.0f,fFenceY);
		
		// Mouse moved?
		if (ImGui_CheckMouseHasMoved())
		{
			cVector2f mvSize = cLux_GetCurrentImGui().GetSet().GetVirtualSize();
			cVector2f vMouse = ImGui_GetMousePosition() / mvSize;
			fX = vMouse.x;
			fY = vMouse.y;
		}
		
		// Click
		if (ImGui_ActionTriggered(eImGuiAction_Confirm) || ImGui_ActionTriggered(eImGuiAction_MouseLeft))
		{
			CheckRobotNodeClick(cVector2f(fX,fY));
		}
		
		// Store and Draw
		ImGui_SetStateFloat("cursorX",fX);
		ImGui_SetStateFloat("cursorY",fY);
		
		ImGui_DrawLine(ImGui_NrmSize(cVector2f(-5.0f,fY)),ImGui_NrmSize(cVector2f(5.0f,fY)),1000.1f,2.0f,cColor_White);			
		ImGui_DrawLine(ImGui_NrmSize(cVector2f(fX,-5.0f)),ImGui_NrmSize(cVector2f(fX,5.0f)),1000.1f,2.0f,cColor_White);
	}
	
	//-------------------------------------------------------
	
	void CheckRobotNodeClick(cVector2f avCursor)
	{
		
		////////////////////////////////////////
		// Check output signals
		tString sSignalName = "";
		bool bPressedSignal = false;
		for (uint i=0; i<mvRobotSignals.length();++i)
		{
			if (mvRobotSignals[i].CheckCollide(avCursor))
			{
				sSignalName = mvRobotSignals[i].msName;
				PlayRobotRepairSound(2);
				bPressedSignal = true;
			}
		}
		
		if (bPressedSignal)
			RobotRepairSetSignalStart(sSignalName);
		
		////////////////////////
		// Check gameplay nodes
		for (uint i=0; i<mvRobotRects.length();++i)
		{
			if (mvRobotRects[i].CheckCollide(avCursor))
			{
				if (mvRobotRects[i].mlDirection == 9)
				{
					PlayRobotRepairSound(-1);
				}
				else
				{
					PlayRobotRepairSound(1);
					mvRobotRects[i].NudgeDirection();
				}
				break;
			}
		}
		
		//////////////////////////
		// Begin new circuits (and reset signals)
		mbBrainSpeechSignal = false;
		mbBrainMotorSignal = false;
		mbBrainOpticsSignal = false;
		mlOpticsConnections = 0;
		mlMotorConnections = 0;
		mlCommsConnections = 0;
		mlEjectConnections = 0;
		RobotRepairTraceCircuit(0);
		RobotRepairTraceCircuit(1);
		RobotRepairTraceCircuit(2);
	}
	
	//-------------------------------------------------------
	
	void RobotRepairSetSignalStart(const tString &in asName)
	{
		/* Quick explanation..
		 * -------------------------------
		 * When the player toggles a signal, the start position of that
		 * circuit gets moved to the start node, otherwise it is moved off
		 * screen and by the puzzles logic - is ignored due to being outside
		 * the play area
		 * -------------------------------
		 */
		 
		///////////////////////////////////
		// ALPHA SIGNAL
		if (asName == "AlphaSignal")
		{
			mbSignalAlpha = !mbSignalAlpha;
			if (mbSignalAlpha)
			{
				Sound_CreateAtEntity("RobotPuzzleBeepStream", "Entities_Station/tech/terminal_beeps/robot_brain_puzzle/stream_on", "RobotPuzzleTerminalSoundSource");
				mvRobotCircuitStart[0] = cVector2f(0.135,0.2375);		
			}
			else
			{
				Sound_CreateAtEntity("RobotPuzzleBeepActi", "Entities_Station/tech/terminal_beeps/robot_brain_puzzle/activate", "RobotPuzzleTerminalSoundSource");
				mvRobotCircuitStart[0] = cVector2f(900,900);	
			}
		}
		
		///////////////////////////////////
		// BETA SIGNAL
		if (asName == "BetaSignal")
		{
			mbSignalBeta = !mbSignalBeta;
			if (mbSignalBeta)
			{
				Sound_CreateAtEntity("RobotPuzzleBeepStream", "Entities_Station/tech/terminal_beeps/robot_brain_puzzle/stream_on", "RobotPuzzleTerminalSoundSource");
				mvRobotCircuitStart[1] = cVector2f(0.135,0.3825);	
			}
			else
			{
				Sound_CreateAtEntity("RobotPuzzleBeepActi", "Entities_Station/tech/terminal_beeps/robot_brain_puzzle/activate", "RobotPuzzleTerminalSoundSource");
				mvRobotCircuitStart[1] = cVector2f(900,900);	
			}
		}
		
		///////////////////////////////////
		// GAMMA SIGNAL
		if (asName == "GammaSignal")
		{
			mbSignalGamma = !mbSignalGamma;
			if (mbSignalGamma)
			{
				Sound_CreateAtEntity("RobotPuzzleBeepStream", "Entities_Station/tech/terminal_beeps/robot_brain_puzzle/stream_on", "RobotPuzzleTerminalSoundSource");
				mvRobotCircuitStart[2] = cVector2f(0.135,0.53);	
			}
			else
			{
				Sound_CreateAtEntity("RobotPuzzleBeepActi", "Entities_Station/tech/terminal_beeps/robot_brain_puzzle/activate", "RobotPuzzleTerminalSoundSource");
				mvRobotCircuitStart[2] = cVector2f(900,900);	
			}
		}
		
	}
	
	//-------------------------------------------------------
	bool mbOutputComms = false;
	void RobotRepairOutputReached(const tString &in asName)
	{		
		/* Quick explanation
		 * -------------------
		 * Player may experiment with the robot and play with the various outputs
		 * to get the robot to react.
		 * 
		 * However in order to access the brain, the player must connect all three
		 * of the eject pins at the bottom, requiring three signals
		 * 
		 */
		 
		if (mbBrainEjected) return;
		
		///////////////////////////////
		// OPTICS OUTPUT
		if (asName == "OutputOptics")
		{
			cLux_AddTodoMessage("Script: robot response for OutputOptics - " + mlOpticsConnections);
			BrainOpticsSignal();
			
			
			if(mbRobotRepairCryAllowed==true && Sound_Exists("RobotCry")==false && mbOutputComms==false)
			{
				//Sound_CreateAtEntity("RobotCry", "03_02_omicron_inside/gameplay/robot_puzzle/robot_puzzle_cry", "robotBrainHatch");
			}
		}
		
		///////////////////////////////
		// MOTOR OUTPUT
		if (asName == "OutputMotor")
		{
			cLux_AddTodoMessage("Script: robot response for OutputMotor");
			BrainMotorSignal();
			
			if(mbRobotRepairCryAllowed==true && Sound_Exists("RobotCry")==false && mbOutputComms==false)
			{
				//Sound_CreateAtEntity("RobotCry", "03_02_omicron_inside/gameplay/robot_puzzle/robot_puzzle_cry", "robotBrainHatch");
			}
		}
		
		///////////////////////////////
		// COMMS OUTPUT
		if (asName == "OutputComms")
		{
			mbOutputComms = true;
			cLux_AddTodoMessage("Script: robot response for OutputComms");
			BrainSpeechSignal();
		}
		
		////////////////////////////////////////
		// Player must connect all three eject points individually
		if (asName == "OutputEject0") mlEjectConnections += 1;
		if (asName == "OutputEject1") mlEjectConnections += 2;
		if (asName == "OutputEject2") mlEjectConnections += 4;
		
		if (mlEjectConnections == 7)
			EjectRobotBrain();
		
		
	}
	
