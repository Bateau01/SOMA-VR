		Sound_FadeGlobalVolume(0.7f, 4.0f, eSoundEntryType_World);
	}
	
	void LineOver_CatherinePluginStop(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStart)
	{
		if (abStart) 
			return;
	
		Sound_FadeGlobalVolume(1.0f, 4.0f, eSoundEntryType_World);
	}
		
	//--------------------------------------------
	
	bool mbBuildingBodyMusicActive = false;
	void PlayingBuildingBodyMusic()
	{
		if(mbBuildingBodyMusicActive == false)
		{
			Music_PlayExt("03_02_body_ambient",true, 0.65,1.0f,0.0f,0.0f,eMusicPrio_BigEvent,false);
			Sound_FadeGlobalVolume(0.65f, 4.0f, eSoundEntryType_World);
			mbBuildingBodyMusicActive = true;
		}
		
		else if(mbBuildingBodyMusicActive == true)
		{
			Music_PlayOverlay("03_02_body_suitdone", 0.65f);
			Sound_FadeGlobalVolume(1.0f, 4.0f, eSoundEntryType_World);
			Music_Stop(1.0f, eMusicPrio_BigEvent);
		}
	}
			
	//--------------------------------------------
	
	bool ColdStorageSoundControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Map_AddTimer("Timer_ColdStorageSoundControl", 0.05f, "Timer_ColdStorageSoundControl");
		}
		else
		{
			Map_RemoveTimer("Timer_ColdStorageSoundControl");
		}
		return true;
	}
	
	void Timer_ColdStorageSoundControl(const tString &in asTimer)
	{
		Map_AddTimer("Timer_ColdStorageSoundControl", 0.05f, "Timer_ColdStorageSoundControl");
		
		if(SlideDoor_GetOpenAmount("coldstorage_door_2") > 0.5 && Entity_GetCollide("Player","ColdStorageSoundControl")==true)
		{
			Sound_Play("cooling_fan_*", 1.0f, false);
		}
		
		if(SlideDoor_GetOpenAmount("coldstorage_door_2") < 0.5 && Entity_GetCollide("Player","ColdStorageSoundControl")==true)
		{
			Sound_Stop("cooling_fan_*", 1.0f);
		}
	}
	
	//--------------------------------------------
	
	bool DeadBodyMusicTrigger(const tString &in asParent, const tString &in asChild, int alState)
	{
		Map_AddTimer("DeadBodyMusic", 0.5f, "Timer_DeadBodyMusic");
		return true;
	}
	
	bool mbDeadBodyMusic = false;
	void Timer_DeadBodyMusic(const tString &in asTimer)
	{
		if(mbDeadBodyMusic==false && Entity_IsActive("patchwork_spook"))
		{
			Music_Play("01_01_dead_diver", 0.55f, false, eMusicPrio_MinorEvent);
			mbDeadBodyMusic = true;
		}
	}
		
	//--------------------------------------------
	
	bool AudioLogLowerSoundControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		StopLowerAudioLog();
		return true;
	}
			
	//--------------------------------------------
	
	void StopLowerAudioLog()
	{
		Voice_StopAll();
	}
	
	bool CollideVoiceSoundControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Map_AddTimer("Timer_LowerVoiceSoundControl", 0.05f, "Timer_LowerVoiceSoundControl");
		}
		else
		{
			Map_RemoveTimer("Timer_LowerVoiceSoundControl");
		}
		return true;
	}
	
	void Timer_LowerVoiceSoundControl(const tString &in asTimer)
	{
		Map_AddTimer("Timer_LowerVoiceSoundControl", 0.05f, "Timer_LowerVoiceSoundControl");
		
		if(SlideDoor_GetOpenAmount("communicationsroom_door") < 0.5 && Entity_GetCollide("Player","VoiceSoundControl")==true)
		{
			StopLowerAudioLog();
		}
	}
	
	bool BioLabAudioLogSoundControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1 && mbBiolabLogActive==true)
		{
			StopBiolabLog();
		}
		return true;
	}
	
	void BioLabDoorButtonStateChange(const tString &in asEntity, int alState)
	{
		cLux_AddDebugMessage("BioLab Door Button "+alState);
		if(alState== -1)
		{
			if(mbBiolabLogActive==true)
			{
				StopBiolabLog();
			}
		}
	}

	//} END AUDIO

	/////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
