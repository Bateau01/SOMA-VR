	//-------------------------------------------------------
	
	void TimerWauflowerCommRoom(const tString &in asTimer)
	{
		Lamp_SetFlickerActive("commroom_lamp_*", true);
		Map_AddTimer("timer_commroom_lightsout",3.0f,"TimerCommRoomLightsOut");
		
		Lamp_SetFlickerActive("lamp_wall_deepsea_11",true);
		Lamp_SetFlickerActive("lamp_wall_deepsea_12",true);
		Lamp_SetFlickerActive("lamp_wall_deepsea_13",true);
		Lamp_SetFlickerActive("lamp_wall_deepsea_14",true);
		Lamp_SetFlickerActive("lamp_ceiling_comfy_5",true);
		Lamp_SetFlickerActive("lamp_ceiling_comfy_6",true);
		
		
		Sound_CreateAtEntity("CommRoomFlowerEvent", "03_02_omicron_inside/SFX/wau_flower_events/comm_room_powerdown", "Player");
	}
	
	//-------------------------------------------------------
	
	void TimerCommRoomLightsOut(const tString &in asTimer)
	{
		Lamp_SetLit("commroom_lamp_*",false, true);
		Lamp_SetFlickerActive("robothall_lamp_*", true);
		Entity_SetActive("AreaRobotLightsOut",true);
		
		/////////////////////////////////
		// Small round lamps and billboards need to go out
		Lamp_SetLit("lamp_wall_deepsea_11",false,true);
		Lamp_SetLit("lamp_wall_deepsea_12",false,true);
		Lamp_SetLit("lamp_wall_deepsea_13",false,true);
		Lamp_SetLit("lamp_wall_deepsea_14",false,true);
		Lamp_SetLit("lamp_ceiling_comfy_5",false,true);
		Lamp_SetLit("lamp_ceiling_comfy_6",false,true);
		mbCommRoomFlowerDrained = true;
		Light_SetBrightness("PointLight_Monitors_Commroom_*",0.2f);
		Button_SetDisabled("communicationsroom_doorpanel_*",true,true);
		SlideDoor_SetClosed("communicationsroom_door",false,false);
		cLux_AddTodoMessage("SOUND: Lights in comm room cut out..");
		Map_AddTimer("timer_robothalllights",2.0f,"TimerRobotHallLightsOut");
	}
	
	//-------------------------------------------------------
	
	void TimerRobotHallLightsOut(const tString &in asTimer)
	{
		Lamp_SetLit("robothall_lamp_*",false, true);
		Button_SetDisabled("robothall_disableddoorpanel*",true,true);
		
		cLux_AddTodoMessage("SOUND: Power in hall cuts out");
	}
	
