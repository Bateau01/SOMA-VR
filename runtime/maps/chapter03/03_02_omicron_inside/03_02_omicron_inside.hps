	//--------------------------------------------------------
	
	bool CollideRobotHeadCries(const tString &in asParent, const tString &in asChild, int alState)
	{
		cLux_AddTodoMessage("SOUND: ROBOT HEAD CRIES");
		/* 
		* Reusable trigger to make 
		* robot head cry at points around the map!
		* 
		* To use, simply specify the area or entity name you want the sound to appear at
		* as the UserVar (Base->UserVar in editor) and make copies of this trigger
		*/
		
		if (alState != 1) return true;
		
		tString sAreaName = Entity_GetVarString(asChild,"");
		tString sSound = "NPC_Creatures/Vocalisations/InWorld/Robothead/cry";
		
		Sound_CreateAtEntity("robot_cry_"+sAreaName,sSound,sAreaName,0,false);
		
		// trigger is disabled after use
		return false;
	}

