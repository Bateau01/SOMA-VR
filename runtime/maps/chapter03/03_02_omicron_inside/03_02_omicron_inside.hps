	//-------------------------------------------------------
	
	////////////////////////////////////////////////
	// Scene 5 - Event A - Enter power room
	////////////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool CollideEnterPowerRoom(const tString &in asParent, const tString &in asChild, int alState)
	{	
		if (alState != 1) return true;
		
		cLux_AddDebugMessage("Enter Power room!");
		
		//////////////////////////
		// Kill the music
		Map_AddTimer("StopAmbientMusicQuickly", 1.0f, "AmbientMusicHandler");
		
		
		///////////////////////////
		// We also activate the robot girl here
		Entity_SetActive("agent_robothead_powerroom",true);
		mbRobotWomanSpawned = true;
		
		//So she is enabled when u exit and return:
		Entity_SetActive("AreaEnableRobotHead", true);
		
		//CheckPoint_Setup("CheckPoint_PowerRoom");
	
		cLux_AddTodoMessage("* Dialogue removed - review this *");	
		/*Dialog_Begin("Catherine");
			Dialog_AddBranchAndSubject("5AEnterPowerRoom","","");
		Dialog_End();*/
		
		return false;
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaDisableRobotHead(const tString&in asParent, const tString&in asChild, int alState)
	{
		if(alState==1)
		{
			if(Entity_IsActive("agent_robothead_powerroom"))
			{
				//Agent_SetAutoDisableWhenOutOfSightActive("agent_robothead_powerroom", true, 10);
				Agent_TeleportFeetToEntity("agent_robothead_powerroom", "AgentRepelPowerRoom_Exit");
				Entity_SetActive("agent_robothead_powerroom", false);
			}
		}
		
		return true;
	}
	
	bool CollideAreaEnableRobotHead(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			cLux_AddDebugMessage("ACTIVATE ROBOTHEAD");
			
			//if(Entity_IsActive("agent_robothead_powerroom")==false)
			{
				//Agent_SetAutoDisableWhenOutOfSightActive("agent_robothead_powerroom", false, 10);
				Entity_SetActive("agent_robothead_powerroom", true);
			}
		}
		
		return true;
	}
	
