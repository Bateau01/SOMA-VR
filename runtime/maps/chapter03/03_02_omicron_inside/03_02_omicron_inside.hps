	//-------------------------------------------------------
	
	bool CollideRobotArmStopAudio(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
		{
			StopRobotArm();
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	void StopRobotArm()
	{
		Prop_StopMovement("robot_arm_1");
		
		if (mbRobotArmAudioStopped) return;
		
		Sound_Stop("RobotArmStart*", 0.25f);
		Sound_Stop("RobotArmLoop*", 0.25f);
		Sound_CreateAtEntity("RobotArmStop","Entities_Station/object/controllable_robot_arm/stop","robot_arm_1",0.0f,false,1.0f);
			
		mbRobotArmAudioStopped = true;
		mbRobotArmAudioPlaying = false;
	}
	
	//-------------------------------------------------------
	
	void PlayRobotArmSound()
	{
		if (mbRobotArmAudioPlaying) return;
		
		Sound_Stop("RobotArmStop*", 0.25f);
		Sound_CreateAtEntity("RobotArmStart","Entities_Station/object/controllable_robot_arm/start","robot_arm_1",0.0f,false,1.0f);
		Sound_CreateAtEntity("RobotArmLoop","Entities_Station/object/controllable_robot_arm/loop","robot_arm_1",0.0f,false,1.0f);
		
		mbRobotArmAudioPlaying = true;
	}
	
	//-------------------------------------------------------
	
	void biomech_lever_1_OnConnectionStateChange(const tString &in asEntity, int alState)
	{
		Entity_SetAutoSleep(asEntity,false);
		//tString tag = Entity_GetVarString(asParent,"");
		
		/////////////////////
		// Arm is locked - do nothing
		if (mbRobotArmLocked) return;
		
		////////////////////
		// Middle Position - Stop the arm 
		if (alState == 0)
		{		
			cLux_AddDebugMessage("Stop!");
			
			StopRobotArm();
			
			mbRobotArmMoving = false;
		}
		
		////////////////////
		// Left positions
		if (alState == -1)
		{
			if (Entity_GetCollide("robot_arm_1", "AreaRobotArmStopAudio_1") == false)
			{
				cLux_AddDebugMessage("Left");
				Prop_MoveLinearTo("robot_arm_1","robot_arm_movetarget_1",1,0.5,0.05,false);
				
				//////////////////////////
				//Sound
				PlayRobotArmSound();
				
				mbRobotArmMoving = true;
				mbRobotArmAudioStopped = false;
				mbRobotArmMessageBoxActive = false;
			}
		}
		
		if (alState == 1)
		{
			if (Entity_GetCollide("robot_arm_1", "AreaRobotArmStopAudio") == false)
			{
				cLux_AddDebugMessage("Right");
				Prop_MoveLinearTo("robot_arm_1","robot_arm_movetarget_3",1,0.5,0.05,false);
				
				//////////////////////////
				//Sound
				PlayRobotArmSound();
				
				mbRobotArmMoving = true;
				mbRobotArmAudioStopped = false;
				mbRobotArmMessageBoxActive = false;
			}
		}
	}
	
	//-------------------------------------------------------
	
	void biomech_dispenser_button_OnConnectionStateChange(const tString &in asEntity, int alState)
	{
		if (alState == -1) return;
		Entity_SetAutoSleep(asEntity,false);
		
		Sound_CreateAtEntity("LockAlter", "Entities_Station/object/memchip_cylinder/memchip_cylinder_button", asEntity, 0.0f, false, 1.0f);
		
		//////////////////////////////////////////////
		// Disable button until dispense sequence has finished
		Entity_SetInteractionDisabled(asEntity,true);
		
		//////////////////////////////////////////////
		// Check if robot arm is inside chamber 1,2,3 - or if between chambers
		int lChamberTarget = -1;
		
		if (Entity_GetCollide("robot_arm_1","Area_Dispenser_1"))
		{
			lChamberTarget = 1;
		}
		if (Entity_GetCollide("robot_arm_1","Area_Dispenser_2"))
		{
			lChamberTarget = 2;
		}
		if (Entity_GetCollide("robot_arm_1","Area_Dispenser_3"))
		{
			lChamberTarget = 3;
		}
		
		///////////////////////////////////////////////
		// Check if the drawer is closed
		float fOpenAmount = Slide_GetSlideAmount("IncubatorDrawer_"+lChamberTarget);
		bool bLocked = Slide_GetLocked("IncubatorDrawer_"+lChamberTarget);
		bool bClosed = fOpenAmount <= 0.01f || bLocked ? true : false;
		cLux_AddDebugMessage("Drawer " + "#" + lChamberTarget + "Closed? : " + bClosed + " amount="+fOpenAmount+" Locked="+bLocked);
		
		if (bClosed)
		{
			SetBiomechDrawerLocked(lChamberTarget, true);
		}
		else
		{
			lChamberTarget = -1;
		}
		
		//////////////////////////////////////////////
		// If an invalid position, give feedback but do not dispense
		if (lChamberTarget == -1)
		{
			Sound_CreateAtEntity("TerminalNegative", "Entities_Station/tech/terminal_beeps/pathOS_comp/pathOS_comp_negative", asEntity, 0.0f, false, 1.0f);
			Entity_SetInteractionDisabled(asEntity,false);
			Button_SetSwitchedOn(asEntity,false,true);
			mbRobotArmLocked = false;
			mbRobotArmMessageBoxActive = true;
		}
		
		//////////////////////////////////////////////
		// Adjust robot arm to move in to position and queue dispense sequence
		if (lChamberTarget > -1)
		{
			cLux_AddTodoMessage("SOUND: Robot Arm Button Success");
			Prop_MoveLinearTo("robot_arm_1","robot_arm_movetarget_"+lChamberTarget,1,3.0,3.0,false);	
			Entity_SetInteractionDisabled(asEntity,true);
			
			// Begin timer and sequence
			mbRobotArmLocked = true;
			mlGelDispenserQueued = lChamberTarget;
			Map_AddTimer("timer_geldispenser",2.0f,"StartGelDispensing");
			Entity_PlayAnimation("robot_arm_1","going_down",0.1f,false,false,"");
			
			if (mlGelDispenserQueued == 1)
			{
				if (!mbComputerPartsPlayedWith)
				{
					Sound_CreateAtEntity("RobotArmDispenseMotherboard","Entities_Station/object/controllable_robot_arm/dispense_motherboard","robot_arm_1",0.0f,false,1.0f);
				}
				else if(mbComputerPartsPlayedWith)
				{
					Sound_CreateAtEntity("RobotArmDispense","Entities_Station/object/controllable_robot_arm/dispense","robot_arm_1",0.0f,false,1.0f);
				}
			}
			else if (mlGelDispenserQueued == 2)
			{
				if (mbBrokenChipInserted)
				{
					Sound_CreateAtEntity("RobotArmDispenseChip","Entities_Station/object/controllable_robot_arm/dispense_chip","robot_arm_1",0.0f,false,1.0f);
				}
				else if (!mbBrokenChipInserted)
				{
					Sound_CreateAtEntity("RobotArmDispense","Entities_Station/object/controllable_robot_arm/dispense","robot_arm_1",0.0f,false,1.0f);
				}
			}
			else
			{
				Sound_CreateAtEntity("RobotArmDispense","Entities_Station/object/controllable_robot_arm/dispense","robot_arm_1",0.0f,false,1.0f);
			}
			
			
			
			
			
			mbRobotArmMessageBoxActive = false;
		}
	}
		
