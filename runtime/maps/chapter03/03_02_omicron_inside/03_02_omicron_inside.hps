	//-------------------------------------------------------
	
	void StartGelDispensing(const tString &in asTimer)
	{
		///////////////////////////////
		// Left Chamber (Computer parts)
		if (mlGelDispenserQueued == 1)
		{
			if (!mbComputerPartsPlayedWith)
			{
				SequenceDispenseGelLeft("");
			}
			else
			{
				SequenceDispenseGel("");
			}
			
			mbComputerPartsPlayedWith = true;
			
		}
		
		///////////////////////////////
		// Middle Chamber (Player must place chip here)
		if (mlGelDispenserQueued == 2)
		{
			if (mbBrokenChipInserted)
			{
				SequenceDispenseGelAndRepairChip("");
			}
			else
			{
				SequenceDispenseGel("");
			}
		}
		
		///////////////////////////////
		// Right Chamber (Mouse!)
		if (mlGelDispenserQueued == 3)
		{
			if (!mbMousePlayedWith)
			{
				SequenceDispenseGelRight("");
			}
			else
			{
				SequenceDispenseGel("");
			}
			
			mbMousePlayedWith = true;
		}
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceDispenseGelLeft;
	void SequenceDispenseGelLeft(const tString &in asName)
	{
		Sequence_Begin("SequenceDispenseGelLeft", mSequenceDispenseGelLeft);
		
		/////////////////////////////
		// Start dispensing gel
		if (Sequence_DoStepAndWait(4.0f))
		{
			///////////////////////////////////////////
			// Create gel particles
			ParticleSystem_CreateAtEntity("particle_gel_"+msTargetGelParticleArea, "03_02_structure_gel_drops.ps", msTargetGelParticleArea, true);
			
			
		}
		if (Sequence_DoStepAndWait(1.0f))
		{
		    ///////////////////////////////////////////
			// Stop particles
			ParticleSystem_Destroy("particle_gel_"+msTargetGelParticleArea);
		    ParticleSystem_CreateAtEntity("particle_zap_"+msTargetGelParticleArea, "03_02_structure_gel_zap.ps", msTargetGelParticleArea, true);
			Sound_CreateAtEntity("Zap", "Entities_Station/object/controllable_robot_arm/gel_spark", msTargetGelParticleArea);
		}
		else if (Sequence_DoStepAndWait(5.0f))
		{
			Sound_Stop("Zap", 0.25f);
			Entity_SetActive("circuit_board_broken",false);
			Entity_SetActive("circuit_board_repaired",true);
			Entity_SetEffectsActive("circuit_board_repaired", true, true);
			Entity_PlayAnimation("circuit_board_repaired", "grow", 0, false, false);
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			Lamp_SetLit("CircuitBoardLamp",true,true);
			Lamp_SetFlickerActive("CircuitBoardLamp",true);
			
			mbRobotArmLocked = false;
			
			Button_SetSwitchedOn("biomech_dispenser_button",false,true);
			Entity_SetInteractionDisabled("biomech_dispenser_button",false);
			Entity_PlayAnimation("robot_arm_1","going_up",0.1f,false,false,"");
			cLux_AddTodoMessage("SOUND: Robot arm retracts!");
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
		
	cSequenceStatesData mSequenceDispenseGelRight;
	void SequenceDispenseGelRight(const tString &in asName)
	{
		Sequence_Begin("SequenceDispenseGelRight", mSequenceDispenseGelRight);
		
		/////////////////////////////
		// Start dispensing gel
		if (Sequence_DoStepAndWait(4.0f))
		{
			///////////////////////////////////////////
			// Create gel particles
			ParticleSystem_CreateAtEntity("particle_gel_"+msTargetGelParticleArea, "03_02_structure_gel_drops.ps", msTargetGelParticleArea, true);
		}
		if (Sequence_DoStepAndWait(1.0f))
		{
		    ///////////////////////////////////////////
			// Stop particles
			ParticleSystem_Destroy("particle_gel_"+msTargetGelParticleArea);
		    ParticleSystem_CreateAtEntity("particle_zap_"+msTargetGelParticleArea, "03_02_structure_gel_zap.ps", msTargetGelParticleArea, true);
			Sound_CreateAtEntity("Zap", "Entities_Station/object/controllable_robot_arm/gel_spark", msTargetGelParticleArea);
		}
		else if (Sequence_DoStepAndWait(5.0f))
		{
			///////////////////////////////////////////
			// Stop particles
			ParticleSystem_Destroy("particle_gel_"+msTargetGelParticleArea);
			Sound_Stop("Zap", 0.25f);
			mbRobotArmLocked = false;
			
			//Entity_SetActive("wau_and_rat_dead", false);
			//Entity_SetActive("wau_and_rat_alive", true);
			Entity_PlayAnimation("wau_and_rat_alive", "infection_rise", 2, false);
			
			Button_SetSwitchedOn("biomech_dispenser_button",false,true);
			Entity_SetInteractionDisabled("biomech_dispenser_button",false);
			Entity_PlayAnimation("robot_arm_1","going_up",0.1f,false,false,"");
			cLux_AddTodoMessage("SOUND: Robot arm retracts!");
		}
		else if (Sequence_DoStepAndWait(8.0f))
		{
		    Entity_PlayAnimation("wau_and_rat_alive", "alive", 4, true);
			Entity_SetEffectsActive("wau_and_rat_alive", true, true);
			Entity_SetActive("AreaBiomechCommentOnRat", true);
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
		    //Entity_PlayAnimation("wau_and_rat_alive", "dead", 0.1f, false);
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceDispenseGel;
	void SequenceDispenseGel(const tString &in asName)
	{
		Sequence_Begin("SequenceDispenseGel", mSequenceDispenseGel);
		
		/////////////////////////////
