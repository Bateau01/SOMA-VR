	////////////////////////////////////////////////
	
	//-------------------------------------------------------
	tString msBiomechExitPanel = "";
	tString msBiomechEntryPanel = "";
	bool mbBiomechAirlockEnterOutside = false;
	//-------------------------------------------------------
	
	bool OnCollideAreaAirlockButton(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
		{
			Entity_SetInteractionDisabled("diveroom_airlockpanel_1",true);
		}
		else
		{
			Entity_SetInteractionDisabled("diveroom_airlockpanel_1",false);
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	void diveroom_airlockpanel_1_OnConnectionStateChange(const tString &in asEntity, int alState)
	{
		bool bEnableBlockbox = alState == 1 ? false : true;
		Entity_SetActive("block_box_char_airlock",bEnableBlockbox);
	}
	
	//-------------------------------------------------------
	
	bool CollideTriggerBiomechAirlock(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
		{
			float fOuter = SlideDoor_GetOpenAmount("biomech_airlockdooroutside");
			float fInner = SlideDoor_GetOpenAmount("biomech_airlockdoorinside");
			
			if (fOuter > fInner)
			{
				cLux_AddDebugMessage("You have entered from outside!");
				msBiomechEntryPanel = "biomech_airlockdooroutside_panel";
				msBiomechExitPanel = "biomech_airlockdoorinside_panel";
				mbBiomechAirlockEnterOutside = true;
			}
			else
			{
				cLux_AddDebugMessage("You have entered from inside!");
				msBiomechEntryPanel = "biomech_airlockdoorinside_panel";
				msBiomechExitPanel = "biomech_airlockdooroutside_panel";
				mbBiomechAirlockEnterOutside = false;
			}
			
			SequenceAirLock("");
			Entity_SetActive("TriggerBiomechAirlock",false);
		}
		return true;
	}
	
	//-------------------------------------------------------
		
	cSequenceStatesData mAirLockSequence;
	void SequenceAirLock(const tString &in asTimer)
	{
		Sequence_Begin("SequenceAirLock", mAirLockSequence);
		
		if (Sequence_DoStepAndWait(2.0f))
		{
			///////////////////////////////////
			// Close the door the player entered from
			Button_SetSwitchedOn("biomech_airlockdooroutside_panel*",false, true);
			Button_SetSwitchedOn("biomech_airlockdoorinside_panel*",false, true);
			Entity_SetActive("blockbox_airlock_*",true);
		}
		else if (Sequence_DoStepAndWait(3.0f))
		{
			//////////////////////////////////
			// Activate Light
			Light_FadeTo("BiomechAirlockLight",cColor(0.569,1,0.941,1),3,3.0);
			
			//////////////////////////////////////////////
			// Light scanners
			Lamp_SetLit("airlock_scanner_left",true,true);
			Lamp_SetLit("airlock_scanner_right",true,true);
			
			//////////////////////////////////////////////
			//Airlock idle sound
			Sound_CreateAtEntity("AirlockIdle", "Entities_Station/tech/scanner/scan_idle","Player",0.0f,false,1.0f);
			
			//////////////////////////////////////////////
			//Disable crouch
			Player_SetCrouchDisabled(true);
		
		}
		else if (Sequence_DoStepAndWait(4.0f))
		{    
			
			//////////////////////////////////////////////
			// Scanner Sound
			Sound_CreateAtEntity("AirlockScan","Entities_Station/tech/scanner/scan_sequence","Player",0.0f,false,1.0f);
			
		
			/////////////////////////////////////////////
			// Move Scanners
			Prop_MoveLinearTo("airlock_scanner_left","airlock_scanner_left_end",1.0f,1.0f,0.1f,true);
			Prop_MoveLinearTo("airlock_scanner_right","airlock_scanner_right_end",1.0f,1.0f,0.1f,true);
		}
		else if (Sequence_DoStepAndWait(4.0f))
		{
			//ParticleSystem_Destroy("airlock_steam_*");
		
			/////////////////////////////////////////////
			// Move Scanners
			Prop_MoveLinearTo("airlock_scanner_left","airlock_scanner_left_start",1.0f,1.0f,0.1f,true);
			Prop_MoveLinearTo("airlock_scanner_right","airlock_scanner_right_start",1.0f,1.0f,0.1f,true);
		}
		else if (Sequence_DoStepAndWait(3.0f))
		{
			
			///////////////////////////////////
			//End audio
			Sound_Stop("AirlockIdle", 0.1f);
			Sound_CreateAtEntity("AirlockIdleEnd","Entities_Station/tech/scanner/scan_stop","Player",0.0f,false,1.0f);
			
			///////////////////////////////////
			// Give the player control back
			Player_SetMoveSpeedMul(1.0);
			
			//////////////////////////////////////////////
			//Enable crouch
			Player_SetCrouchDisabled(false);
			
			///////////////////////////////////
			// Open the appropriate door for player to leave air lock
			Button_SetSwitchedOn(msBiomechExitPanel,true, true);
			Entity_SetActive("blockbox_airlock_*",false);
			
			///////////////////////////////////
			// Fade airlock lights
			Light_FadeTo("BiomechAirlockLight",cColor(0,0,0,0),3,3.0);
			
			///////////////////////////////////
			// Enable airlock exit triggers
			Entity_SetActive("TriggerBiomechAirlockExit*",true);
			
			///////////////////////////////////
			// Turn off scanner effects
			Lamp_SetLit("airlock_scanner_left",false,true);
			Lamp_SetLit("airlock_scanner_right",false,true);
			
		}
		Sequence_End();
	}
	
	bool CollideTriggerBiomechAirlockExit(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		Button_SetSwitchedOn("biomech_airlockdooroutside_panel*",false, true);
		Button_SetSwitchedOn("biomech_airlockdoorinside_panel*",false, true);
		Entity_SetActive("TriggerBiomechAirlockExit*", false);
		Entity_SetActive("TriggerBiomechAirlock",true);
		
		return true;
	}


