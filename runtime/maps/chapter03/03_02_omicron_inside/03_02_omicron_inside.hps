	//-------------------------------------------------------
	
	bool CollideBreakContainment(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		if (mlPuzzleItemsGathered < 3) return true;
		if (mbContainmentCubeBroken) return false;
		if (mbContainmentEscalation2 == false) return true;	// The flesher must have pounded on the glass first
		
		Map_AddTimer("ContainerCubeBreak", 1.8f, "ContainerCubeBreak");
		
		/////////////////////////////////////
		// Flesher takes over all lockdown mechanisms
		SequenceFlesherEscapes("");
		BreakContainmentCube();
		
		////////////////////////////////////
		// Activate area for first footstep event
		Entity_SetActive("AreaFlesherFootstepsHall",true);
		Entity_SetActive("AreaCubeScare_*",false);
		Entity_SetActive("Area_FlesherContainment",false);
		Entity_SetActive("AreaCubeScareLookAt",false);
		
		///////////////////////////////
		// Stop flesher effects in cube
		Map_RemoveTimer("Timer_FlesherSpeak");
		Map_RemoveTimer("timer_fleshernoises");
		
		///////////////////////////////
		// Turn off the robot woman
		Entity_SetActive("agent_robothead_powerroom",false);
		
		return false;
	}
	
	//-----------------------------------------
	
	void BreakContainmentCube()
	{
		///////////////////////////////////
		// Swap out containment cube for broken one
		Entity_SetActive("containment_cube",false);
		Entity_SetActive("containment_cube_broken",true);
		//Entity_SetActive("containmentcube_inside*",false);
		Entity_SetActive("containmentcube_glass_*",false);
		Entity_SetActive("containmentcube_glass_broken",true);
		//Entity_SetActive("cube_glass_shards_*",true);
		
		Entity_SetActive("AreaBreakContainment*",false);
		Entity_SetActive("block_box_cube",false);
		ParticleSystem_SetActive("glass_smash_effect_*", true);
		
		Entity_SetActive("AreaActivateInfirmaryRobohead", true);
		
		SlideDoor_SetClosed("divewalk_door", false, true);
		
		

		//Entity_AddImpulseFromEntity("containmentcube_glass_broken*","ContainmentForceArea",50.0f,true);
		
		//Entity_AddImpulseFromEntity("cube_glass_shards_side1","ContainmentForceArea",2.254f,false);
		//Entity_AddImpulseFromEntity("cube_glass_shards_side2","ContainmentForceArea",1.1f,false);
		//Entity_AddImpulseFromEntity("cube_glass_shards_side3","ContainmentForceArea",2.6f,false);
		//Entity_AddImpulseFromEntity("cube_glass_shards_top","ContainmentForceArea",0.8f,false);
		//Entity_AddImpulseFromEntity("cube_glass_shards_front","ContainmentForceArea",1.0f,false);
		
		//Map_AddTimer("timer_disableshards",5.0f,"TimerDisableShards");
		
		mbMusicSupressed = true;
		mbContainmentCubeBroken = true;
	}
	
