// Ambient danger levels
const tString gsOmicronMusicLevel1 = "03_02_1st_ambience";		// After one event
const tString gsOmicronMusicLevel2 = "03_02_2nd_ambience";		// After two events
const tString gsOmicronMusicLevel3 = "03_03_drone";	// Before glass smashing


