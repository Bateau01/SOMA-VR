	//--------------------------------------------------------
	
	bool CathTool_Placed_CanBeUsed(const tString &in asTool, const tString &in asEntity)
	{
		if (asEntity == "omnislot_inside_1")
		{
			return true;
		}
		
		//////////////
		//Airlock
		if (asEntity == "Area_OmniTool" && !mbExitStarted)
		{
			return true;
		}
		return false;
	}
	
	//--------------------------------------------------------
	
	bool mbExitStarted = false;
	
	bool CathTool_Placed_OnUse(const tString &in asTool, const tString &in asEntity)
	{
		if (asEntity == "omnislot_inside_1")
		{
			SlideDoor_SetClosed("slidedoor_airlock_4",true,false);
			Map_AddTimer("Timer_Exit",3.0f,"TimerExit");
			return true;
		}
		
		//////////////
		//Airlock
		if (asEntity == "Area_OmniTool" && !mbExitStarted)
		{
			mbExitStarted = true;
			Entity_SetActive("block_box_char_airlock",true);
			CathTool_UseOnPanel("CathTool_Placed","Panel_Airlock_Omnitool_7994");
			Map_AddTimer("SequenceAirlockExit", 2.75f, "SequenceAirlockExit");
			//SequenceAirlockExit("SequenceAirlockExit");
			
			return false;
		}
		return true;
	}

	//--------------------------------------------------------
	
	void TimerExit(const tString &in asTimer)
	{
		Effect_Fade_Out(5.0f);
		cLux_AddTodoMessage("SCRIPT: Airlock sequence!");
		Map_AddTimer("Timer_ChangeMap",6.0f,"TimerChangeMap");
	}
	
	void TimerChangeMap(const tString &in asTimer)
	{
		Map_ChangeMap("03_03_omicron_descent.hpm", "", "", "");
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceAirlockExit;
	void SequenceAirlockExit(const tString &in asName)
	{
		Sequence_Begin("SequenceAirlockExit", mSequenceAirlockExit);
		
		if (Sequence_DoStepAndWait(2.5f))
		{
			//////////////////////////
			// Fade out scan trails
			Effect_ImageTrail_FadeOut(mlIDScanTrails,3.0f);
			
			Entity_SetActive("ToolArea_CathTool_2",false);
			
			Button_SetSwitchedOn("Panel_Airlock_Omnitool",true,true);
			Sound_Stop("side_airlock_idle", 1.0f);
			SlideDoor_SetClosed("slidedoor_airlock_4",true,false);
			Entity_FadeEffectBaseColor("exit_airlock_lamp_*", cColor(1, 0.1, 0.0, 1), 0.5f);
			
			Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_World);
			Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_WorldClean);
		}
		if (Sequence_DoStepAndWait(1.5f))
		{
			
			AirlockEffectsFillWithWater();
			Sound_CreateAtEntity("AirlockAirPump", "Entities_OceanBottom/airlock/air/pump/pump_loop", "Area_OmniTool");
			
		}
		if (Sequence_DoStepAndWait(4))
		{
			Achievement_Unlock(eAchievement_NewYou);
		
			PreloadDeload();
			
			LiquidArea_MoveLinearTo("LiquidArea_1", "LiquidArea_Target", 0.1, 0.5, 0.5);
			ParticleSystem_SetActive("exti_airlock_flood_effects_*", true);
			ParticleSystem_SetActive("exti_airlock_flood_effects3_*", true);
		}
		if (Sequence_DoStepAndWait(2))
		{
			ParticleSystem_Destroy("exti_airlock_flood_effects_*");
			ParticleSystem_Destroy("exti_airlock_flood_effects3_*"); 
			ParticleSystem_SetActive("exti_airlock_flood_effects2_*", true);
			
		}
		if (Sequence_DoStepAndWait(9))
		{
		    ParticleSystem_SetActive("exti_airlock_flood_effects4_*", true);
		}
		if (Sequence_DoStepAndWait(8))
		{
		    ParticleSystem_Destroy("exti_airlock_flood_effects2_*");
		}
		if (Sequence_DoStepAndWait(0))
		{
			PreloadChangeOfMap();
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	//Airlock audio
	void AirlockEffectsFillWithWater()
	{
		Depth_Audio_AirlockFillingLeadInAir();
		Depth_Audio_AirlockFillingLoopAir();
		Map_AddTimer("AirlockFillingAirStopTimer", 7.65f, "AirlockFillingAirStop");
	}

	void AirlockFillingAirStop(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Underwater airlock sounds start");
			
		Sound_CreateAtEntity("AirlockFillingLoopUW", "Entities_OceanBottom/airlock/uw/water/filling/loop", "Player", 1.f, false, 1.0f);
		Depth_Audio_AirlockFillingLoopAirStop();
		Depth_Audio_PlayEnterWater();
			
		///////////////////
		//Pump Sounds
		Sound_CreateAtEntity("AirlockFillingPumpLoopUW", "Entities_OceanBottom/airlock/uw/pump/pump_loop_nointro", "Area_OmniTool", 0.0f, false, 1.0f);
		Sound_Stop("AirlockAirPump", 0.5f);
			
		Map_AddTimer("AirlockFillingLoopUWStopTimer", 7.0f, "AirlockFillingLoopUWStop");
	}
		
	void AirlockFillingLoopUWStop(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Underwater airlock sounds stop");
			
		///////////////////
		//Pump Sounds
		Sound_Stop("AirlockFillingLoopUW", 1.25f);			
		Sound_Stop("AirlockFillingPumpLoopUW", 1.25f);
		Sound_CreateAtEntity("AirlockFillingLeadOutUW", "Entities_OceanBottom/airlock/uw/water/filling/end", "Player", 1.f, false, 1.0f);
		Sound_CreateAtEntity("PumpUWLeadOut", "Entities_OceanBottom/airlock/uw/pump/pump_end", "Area_OmniTool", 0.0f, false, 1.0f);
	}
	//} END EVENT
	
	//-------------------------------------------------------
	
	void CollideAirlockWater(int alState)
	{
		cLux_AddDebugMessage("Splush!");
		
		if(alState == -1)
		{
			Entity_SetActive("AMB_AirlockEnd_Water", false);
			Entity_SetActive("AMB_AirlockEnd", true);
			
			Map_SetEnvironmentParticlesActive(false);
			Map_SetEnvironmentParticleVisible("*", false);
			cLux_GetCurrentMap().GetWorld().SetDirectionalLightActive(true);
			
			Light_SetVisible("NextLevelBoxLIght", false);
			
			Player_SetAmbientLight_Indoors(true);
			
			Depth_Audio_PlayLeaveWater();
		}
		
		else
		{
			Map_AddTimer("FadeGlobal", 0, "PreloadTimer");
			
			Entity_SetActive("AMB_AirlockEnd", false);
			Entity_SetActive("AMB_AirlockEnd_Water", true);
			
			Map_SetEnvironmentParticlesActive(true);
			Map_SetEnvironmentParticleVisible("*", true);
			cLux_GetCurrentMap().GetWorld().SetDirectionalLightActive(false);
			
			Light_SetVisible("NextLevelBoxLIght", true);
			
			Player_SetAmbientLight_Outdoors(true);
			
			FogArea_SetVisible("03_03_airlock_fog",true);
			
			Depth_Audio_PlayEnterWater();
		}
	}
	
	//-------------------------------------------------------
 
    /////////////////////////////////////////
    // ==============
    // PRELOAD
    // ==============
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	bool PreloadDisabled(bool abCheckIfPreloading = true)
	{
		if(cLux_ScriptDebugOn())
		{
			cLux_AddDebugMessage("PRELOAD DISABLED!"); 
			
			return true;
		}

		if(abCheckIfPreloading == true && Map_IsPreloading() == false)
			return true;
			
		return false;
	}
	
	//-------------------------------------------------------
	
	void Preload()
	{
		if(PreloadDisabled(false)) return;
		
		Map_Preload("03_03_omicron_descent.hpm", eWorldStreamPriority_Low);
	}
	
	//-------------------------------------------------------
	
	void PreloadChangePrioNormal()
	{
		Map_SetPreloadPriority(eWorldStreamPriority_Normal);
	}
	
	//-------------------------------------------------------
	
	void PreloadDeload()
	{
		if(PreloadDisabled()) return;
		
		Map_Deload("transfer3233");
		Map_SetPreloadPriority(eWorldStreamPriority_High);
	}
	
	//-------------------------------------------------------
	
	void PreloadChangeOfMap()
	{
		if(PreloadDisabled()) 
		{
			PreloadManualChangeMap();
			return;
		}
		
		Map_AddTimer("ChangeMap", 0, "PreloadTimer");
		Map_AddTimer("ChangeMapNotReady", 3, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	
	bool mbGlobalCopyCompleted = false;
	void PreloadTimer(const tString &in asTimer)
	{
		////////////////////////////
		//Preload - Change map globals when possible.
		if(asTimer == "FadeGlobal")
		{
			if(mbGlobalCopyCompleted)
			{
				Map_Preset_Fade("3.3Preset", 0.1); 
				return;
			}
			
			mbGlobalCopyCompleted = Map_CopyGlobalSettings(Map_GetPreloadMap(), 0.2);
			
			Map_AddTimer("FadeGlobal", 0.3, "PreloadTimer");
		}

		////////////////////////////
		//Preload - Change map when possible
		if(asTimer == "ChangeMap")
		{
			if(Map_IsPreloadCompleted())
			{
				Description_SetForceFading(true);
				Map_ChangeMap("03_03_omicron_descent.hpm", "", "transfer3233", "", "");
			}
			else Map_AddTimer("ChangeMap", 0.6f, "PreloadTimer");
		}
		
		if(asTimer == "ChangeMapNotReady")
		{
			Description_Add("02_05_theta_inside", "ScanRoom_Legacy_Loading", 10, false);
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
		}
	}
	
	//-------------------------------------------------------
	
	void PreloadManualChangeMap()
	{
		Map_ChangeMap("03_03_omicron_descent.hpm", "PlayerStartArea_1", "", "");
	}

