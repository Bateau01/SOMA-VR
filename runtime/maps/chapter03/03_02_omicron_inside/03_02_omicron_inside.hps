	//--------------------------------------------------------
	
	bool PowerCubeTool_CanBeUsed(const tString &in asTool, const tString &in asEntity)
	{
		if (asEntity != "Area_PowerCubeInsert") return false;
		return true;
	}

	//--------------------------------------------------------

	bool PowerCubeTool_OnUse(const tString &in asTool, const tString &in asEntity)
	{
		mbPowerCubeInserted = true;
		Entity_SetActive("PowerCube_Inserted",true);
		Entity_SetActive("Area_PowerCubeInsert",false);
		
		cLux_AddDebugMessage("SOUND: Plug in power pack (approx 14 seconds for total charge sequence)");
		Sound_CreateAtEntity("PlugInPowerpack","Entities_Station/object/cathtool/insert_cathtool_nonunderwater",asTool,0.0f,false,1.0f);
		
		///////////////////////////////
		////Sound for charging sequence
		Sound_CreateAtEntity("BatteryChargingSound", "03_02_omicron_inside/SFX/battery_charger/charging", "PowerCube_Inserted", 0.0f, false, 1.0f);
		
		cLux_AddDebugMessage("POWER PACK CHARGE START!!");
		
		Sound_CreateAIEventAtEntity("Area_PowerCubeInsert", 20, 4);
 
		///////////////////////////////
		// Begin Charging!
		meChargerState = ePowerChargerState_Charging;
		return true;
	}
	
	//-------------------------------------------------------
	
	void PackFullyCharged()
	{
		Entity_SetInteractionDisabled("PowerCube_Inserted",false);
		Entity_SetInteractionDisabled("PowerGeneratorButton",true);
	}
	
	//-------------------------------------------------------
	bool mbPowerCubePickupMusicTriggered = false;
	bool PowerCube_Inserted_OnPickUp(const tString &in asTool)
	{
		///////////////////////////////////////
		// Turn off charger and make note that we've gathered an item
		Lamp_SetLit("chargerIndicator_*",false,false);
		meChargerState = ePowerChargerState_NoCube;
		GotPuzzleItem();
		
		Sound_CreateAtEntity("PowerCubePickupCharged", "03_02_omicron_inside/SFX/Pass2/battery_pickup", "Player", 0, false, 1);
		//Sound_CreateAtEntity("PowerCubePickup", "03_02_omicron_inside/gameplay/battery/battery_pickup", "Player", 0, false, 1);
		if(mbPowerCubePickupMusicTriggered==false)
		{
			Music_Play("03_02_chargedpack", 0.35f, false, eMusicPrio_BigEvent);
			mbPowerCubePickupMusicTriggered = true;
		}
		/////////////////////////////////////////////
		// Enable exit dialogue area
		Entity_SetActive("AreaExitPowerRoom",true);
		
		mbPlayerHasUnchargedPack = false;
		mbPlayerHasChargedPack = true;
		
		return true;
	}
	
