	bool CollideCheckpoint_PowerRoom(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1) return true;
		
		if (mbAllowFloor3Save)
		{
			CheckPoint_Setup("Checkpoint_PowerRoom");
			mbAllowFloor3Save = false;
		}
		
		AttackMeter_SetAttackerTeleportPosition("SpawnPowerRoom_Enemy_*");
		
		return true;
	}
	
