	//--------------------------------------------------------
	
	cSequenceStatesData mSequencePowerLightsOut;
	void SequencePowerLightsOut(const tString &in asName)
	{
		Sequence_Begin("SequencePowerLightsOut", mSequencePowerLightsOut);
		
		///////////////////////////
		// Disable lights in power room with a clunk
		if (Sequence_DoStepAndWait(0.75f))
		{
			Lamp_SetFlickerActive("*amb_lights_pwr_*",true);
			
			Effect_Shake_Start(0.03f, 1.0f, 0.4f, 0.4f);
			
			///////////////////////////
			// Play sounds
			Sound_CreateAtEntity("LightsOut", "03_02_omicron_inside/SFX/power_room/shutdown", "Player", 0.0f, false, 1.0f);
			ParticleSystem_CreateAtEntity("LightsOutSparks","elec_spark_huge_oneshot.ps","EffectAreaSparks",true);
		}
		else if (Sequence_DoStepWaitAndRepeat(37,0.1f))
		{
			if (Entity_Exists("corridor_amb_lights_pwr_"+mlPowerLightCount))
			{
				Lamp_SetLit("corridor_amb_lights_pwr_"+mlPowerLightCount,false,true);
				ParticleSystem_CreateAtEntity("LightsOutSparks","elec_spark_huge_oneshot.ps","corridor_amb_lights_pwr_"+mlPowerLightCount,true);
			}
			mlPowerLightCount++;
		}
		else if (Sequence_DoStepAndWait(5.0f))
		{
			
		}
		
		Sequence_End();
	}
	
