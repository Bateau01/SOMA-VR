	//-----------------------------------------
	
	cSequenceStatesData mSequenceFlesherEscapes;
	void SequenceFlesherEscapes(const tString &in asName)
	{
		Sequence_Begin("SequenceFlesherEscapes", mSequenceFlesherEscapes);
		
		if (Sequence_DoStepAndWait(0.5f))
		{
			////////////////////////
			// Ross Escapes
			Sound_CreateAtEntity("CubeBreak", "03_02_omicron_inside/SFX/ross/cube_smash", "Area_FlesherContainmentSounds");
			Sound_CreateAtEntity("SecurityStatic_1", "03_02_omicron_inside/AMB/spot/lockdown_terminal_static", "Security_TerminalSoundSource_1");
			Sound_CreateAtEntity("SecurityStatic_2", "03_02_omicron_inside/AMB/spot/lockdown_terminal_static", "Security_TerminalSoundSource_2");
			Sound_CreateAtEntity("SecurityStatic_3", "03_02_omicron_inside/AMB/spot/lockdown_terminal_static", "Security_TerminalSoundSource_3");
			Map_AddTimer("RossEscapeMusic", 2.0f, "RossCubeSmashMusic");
			Map_RemoveTimer("timer_fleshernoises");
		
			
			///////////////////////////////////
			// The cube breaks
			SetLevelLockdownLights(false,"FLESHEREVENT");
		}
		else if (Sequence_DoStepAndWait(0.5f))
		{
			OpenShutters("", false);
		}
		else if (Sequence_DoStepAndWait(0.5f))
		{
			SetLevelLockdownLights(true,"");
			//SetLevelLockdownLights(false,"DivePrep");
			
			Light_SetVisible("PointLight_DiveRoomAmbient_*",true);
			Lamp_SetLit("diveroom_lamp_*",true,true);
		}
		else if (Sequence_DoStepAndWait(1.0f))
		{
			RossEscape();
		}
		
		Sequence_End();
	}
	
