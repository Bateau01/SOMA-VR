	//////////////////////////////////////////
	// Terminal *Security Console*
	//////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbMainLockdownRemoved  = false;
	bool mbLockdownPuzzleSolved = false;
	bool mbIntroPlayed = false;
	bool mbDisplayBGImageOnDoorOpen = true;
	bool mbLockdownPuzzleForceAbort = false;
	
	//-------------------------------------------------------
	
	void SetupSecurityConsole()
	{
		Gui_CreateCameraTexture("PowerCamera", cVector2l(768, 613), 10, 60.0f, 0.1, 10);
		Gui_AttachCameraTextureToEntity("PowerCamera", "PowerCameraArea");
		Lamp_SetLit("corridor_amb_lights_pwr_23",false,true);
	}
	
	void LockdownTerminal_GuiEnter(const tString&in asEntityName)
	{
		Terminal_SetImGuiStateBool(asEntityName,"ForceExit", false);
		Terminal_SetUpdateWhenOutOfView(asEntityName,true);
	}
	
	void lockdownTerminal_GuiLeave(const tString&in asEntityName)
	{
		// If puzzle has not just been solved, return to main menu
		int lState = StationGui_GetActiveApp(asEntityName, 0);
		
		if (Terminal_GetImGuiStateInt(asEntityName,"Solved",0) == 0)
		{
			Terminal_SetImGuiStateBool(asEntityName,"ForceExit", true);
		}
	}
	
	//-------------------------------------------------------
	
	void SecurityTerminal_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("03_02_omicron_inside");
		
		
		///////////////////////////////////////////
		// Show Flesher Message
		if (mbContainmentCubeBroken)
		{
			SecurityLockdownActive(asEntityName, afTimeStep);
			TerminalRossBurst(asEntityName, afTimeStep);
			return;
		}
		
		///////////////////////////////////////////
		// Show Lockdown in effect message
		tString sSecuritySector = Entity_GetVarString(asEntityName,"");
		//if ((!mbMainLockdownRemoved && sSecuritySector != "MainSecurity") || !mbMainPowerRestored)
		if (!mbMainPowerRestored)
		{
			SecurityLockdownActive(asEntityName, afTimeStep);
			TerminalRossBurst(asEntityName, afTimeStep);
			return;
		}
		
		////////////////////////////
		// Text
		cImGuiTextFrameData textData = ImGui_GetDefaultTextFrame();
		textData.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Medium));
		textData.mbUseBackgroundGfx = false;
		textData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
		textData.mFontAlign = eFontAlign_Left;
		ImGui_SetDefaultTextFrame(textData);
		
		/////////////////////////////////
		// Button
		cImGuiButtonData button = StationGui_CreateDefaultButtonData();
		button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
		ImGui_SetDefaultButton(button);
		
		/////////////////////////////////
		// Backdrop
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		int lState = StationGui_GetActiveApp(eSecurityPanelState_StatusScreen);
		switch (lState)
		{
			case eSecurityPanelState_MainMenu:
				SecurityPanelMainMenu(asEntityName, afTimeStep);
			break;
			
			case eSecurityPanelState_StatusScreen:
				SecurityPanelStatus(asEntityName, afTimeStep);
			break;
			
			case eSecurityPanelState_ErrorScreen:
				SecurityPanelError(asEntityName, afTimeStep);
			break;
			
			case eSecurityPanelState_RemoveLockdown:
				if (mbIntroPlayed == false)
				{
					SecurityLockdownDisplayIntro(asEntityName,afTimeStep);
				}
				else
				{
					SecurityPanelLockdownRemove(asEntityName, afTimeStep);
				}
			break;
			
			case eSecurityPanelState_OpenDoors:
				SecurityPanelOpenDoors(asEntityName, afTimeStep);
			break;
		}
		TerminalRossBurst(asEntityName, afTimeStep);
	}	
	//--------------------------------------------------------
	

	void SecurityLockdownActive(const tString&in asEntityName, float afTimeStep)
	{
		StationGuiBG_Scanlines();
		
		cImGuiLabelData label = ImGui_GetDefaultLabel();
		label.mFontAlign = eFontAlign_Center;
		label.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.075);
		ImGui_SetDefaultLabel(label);
		
		ImGui_SetModColorMul(cColor_Red);
		if (mbContainmentCubeBroken)
		{
			////////////////////////////////
			// Image declarations
			cImGuiGfx static_0;
			cImGuiGfx static_1;
			
			//////////////////////////////
			// Load images
			static_0.SetFile("station/static/static_0");
			static_1.SetFile("station/static/static_1");
			
			//////////////////////////////
			// Show dark flesher messages
			ImGui_DoLabel("FlesherMessage"+ImGui_GetStateInt("NextFlesherMessage",0), ImGui_NrmPosGroup(0), ImGui_NrmSizeGroup(cVector2f(1)), 1);
			
			//////////////////////////////
			// Show static
			float fStaticTimer = ImGui_GetStateFloat("StaticTimer");
			int lStaticFrames = ImGui_GetStateInt("Static");
			int lStaticImage = ImGui_GetStateInt("StaticImage");
			
			fStaticTimer += afTimeStep;
			
			if (fStaticTimer > 0.3f)
			{
				ImGui_SetModColorMul(gStationGuiColor_Normal*3);
				
				lStaticFrames++;
				if (lStaticFrames % 5 == 0)
				{
					lStaticImage++;
				}
			
				//////////////////////////////
				// Draw images
				if (lStaticImage % 2 == 0)
				{
					ImGui_DoImage(static_0,ImGui_NrmPos(cVector3f(0.0,0.0,7.0)),ImGui_NrmSize(cVector2f(1.0,1.0)));
				}
				else
				{
					ImGui_DoImage(static_1,ImGui_NrmPos(cVector3f(0.0,0.0,7.0)),ImGui_NrmSize(cVector2f(1.0,1.0)));
				}
				
				if (fStaticTimer > ImGui_GetStateFloat("NextImageFlash"))
				{
					if (Entity_IsInPlayerFOV(asEntityName) && Entity_GetDeltaToEntity(asEntityName,"Player").Length() <= 4.0)
					{
						fStaticTimer = 0.0f;
						mlIDFlesherShadowEffect = Effect_VideoDistortion_Start(0.7,2,0,0);
					}
					ImGui_SetStateFloat("NextImageFlash",cMath_RandRectf(7.125f,16.253f));
					ImGui_SetStateInt("NextFlesherMessage",cMath_RandRectl(0,4));
				}
			}
			
			///////////////////////
			// Save local terminal states
			ImGui_SetStateFloat("StaticTimer", fStaticTimer);
			ImGui_SetStateInt("StaticImage",lStaticImage);
			ImGui_SetStateInt("Static",lStaticFrames);
		}
		else
		{
			cStationGui_BigStatusMessageSettings settings;
			settings.mfTextSizeMul = 0.7;
			StationGui_BigStatusMessage("LockdownActive", settings);
		}
	}
	
	//--------------------------------------------------------
	
	void SecurityPanelMainMenu(const tString&in asEntityName, float afTimeStep)
	{
		///////////////
		// Set floor to be the one we are on
		tString sTag = Entity_GetVarString(asEntityName, "");
		ImGui_SetStateInt("SelectedFloor",1);
		if (sTag == "LowerSecurity") ImGui_SetStateInt("SelectedFloor",0);
		else if (sTag == "UpperSecurity") ImGui_SetStateInt("SelectedFloor",2);
	
		/////////////
		// Change to map screen
		ImGui_SetStateInt("Column", 0);
		StationGui_SetActiveApp(eSecurityPanelState_StatusScreen);
		Depth_Audio_Terminal_Forward(asEntityName);
	}
	
	//--------------------------------------------------------
	
	float mfPlayerSecurityDotTimer = 0.0f;
	bool mbShowPlayerSecurityDot = false;
	
	void SecurityPanelStatus(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_GroupBegin(ImGui_NrmPos(cVector3f(0.25, 0.25, 1)), ImGui_NrmSize(cVector2f(0.5, 0.7)));
		
		float fButtonX = 1.0f;
		float fButtonWidth = 0.45f;
		
		///////////////////////////////////
		// set this to false if you want the button to be disabled if incorrect floor selected
		bool bOverrideButtonEnabled = true;		
		
		//////////////////////////////
		// If it is the first time unlocking from a terminal, we let the player unlock from anywhere (since it is a global lockdown)
		bOverrideButtonEnabled = true;
		
		//////////////////////////////
		// Players position dot
		cImGuiGfx gfxPlayer = cImGuiGfx("station_omicron_map_playerdot");
		cVector3f vPlayerPosition = cVector3f(-5.0f,-5.0f,0.0f);
		tString sTag = Entity_GetVarString(asEntityName, "");
		
		//////////////////////////
		// Floor Label
		cImGuiLabelData floorHeading;
		floorHeading.mFontAlign = eFontAlign_Left;
		floorHeading.mvDefaultSize = cVector2f(1.0f);
		
		//////////////////////////
		// Set the background based on selected floor and player dot position if needed
		cImGuiGfx gfx;
		int lPlayerOnFloor = 0;
		tString sFloorNumber = "";
		
		if (sTag == "LowerSecurity")
		{
			sFloorNumber = "ButtonFloor0";	
			lPlayerOnFloor = 0;
		}
		if (sTag == "MainSecurity")
		{
			sFloorNumber = "ButtonFloor1";	
			lPlayerOnFloor = 1;
		}
		if (sTag == "UpperSecurity")
		{
			sFloorNumber = "ButtonFloor2";	
			lPlayerOnFloor = 2;
		}
		
		int lSelectedFloor = ImGui_GetStateInt("SelectedFloor",1);
		switch (lSelectedFloor)
		{
			case 0:
				gfx = cImGuiGfx("station_omicron_map_basement");
				
				
				///////////////////////////////
				// Entrace Room (lower security terminal)
				if (sTag == "LowerSecurity")
				{
					vPlayerPosition = cVector3f(0.115,0.07,10);	
					bOverrideButtonEnabled = true;
				}
			break;
			
			case 1:
				gfx = cImGuiGfx("station_omicron_map_floor1");
				
				
				/////////////////////////////
				// Containment Security Terminal
				if (sTag == "MainSecurity")
				{
					vPlayerPosition = cVector3f(-0.0325,0.2125,10);
					bOverrideButtonEnabled = true;	
				}
			break;
			
			case 2:
				gfx = cImGuiGfx("station_omicron_map_floor2");
				
				
				/////////////////////////////
				// Upper Containment 
				if (sTag == "UpperSecurity")
				{
					vPlayerPosition = cVector3f(0.232,0.18,10);
					bOverrideButtonEnabled = true;	
				}
			break;
		}
		
		///////////////////////////////////
		// Draw map
		float fAlpha = ImGui_GetStateFloat("MapAlpha");
		gfx.mColor.a = fAlpha;
		fAlpha = cMath_InterpolateLinear(fAlpha,1.0f,afTimeStep);
		ImGui_SetStateFloat("MapAlpha",fAlpha);
		ImGui_DoImage(gfx,ImGui_NrmPos(cVector3f(-0.225,-0.25,0)));
		
		
		///////////////////////////////////
		// Draw flashing player dot
		mfPlayerSecurityDotTimer += afTimeStep;
		if (mfPlayerSecurityDotTimer > 0.5f)
		{
			mbShowPlayerSecurityDot = !mbShowPlayerSecurityDot;
			mfPlayerSecurityDotTimer = 0.0f;
		}
		
		if (mbShowPlayerSecurityDot)
		{
			ImGui_DoImage(gfxPlayer,ImGui_NrmPos(vPlayerPosition),ImGui_NrmSizeGroup(cVector2f(0.0225f,0.0225f)));
		}
		
		////////////////////////////////////////////////
		// Floor Selection
		cColor greyed = cColor(0.5f,0.5f,0.5f,1.0f);
		//if (sTag != "UpperSecurity") ImGui_SetModColorMul(greyed);
		if (lSelectedFloor != 2) ImGui_SetModColorMul(greyed);
		if (ImGui_DoButton("ButtonF2", "ButtonFloor2", ImGui_NrmPosGroup(cVector3f(fButtonX, -0.3, 2)), ImGui_NrmSizeGroup(cVector2f(fButtonWidth, 0.15))))
		{
			ImGui_SetStateInt("SelectedFloor",2);
			Depth_Audio_Terminal_Forward(asEntityName);
			ImGui_SetStateFloat("MapAlpha",0);
		}
		ImGui_SetModColorMul(cColor_White);
		
		//if (sTag != "MainSecurity") ImGui_SetModColorMul(greyed);
		if (lSelectedFloor != 1) ImGui_SetModColorMul(greyed);
		if (ImGui_DoButton("ButtonF1", "ButtonFloor1", ImGui_NrmPosGroup(cVector3f(fButtonX, -0.125, 2)), ImGui_NrmSizeGroup(cVector2f(fButtonWidth, 0.15))))
		{
			ImGui_SetStateInt("SelectedFloor",1);
			Depth_Audio_Terminal_Forward(asEntityName);
			ImGui_SetStateFloat("MapAlpha",0);
		}
		ImGui_SetModColorMul(cColor_White);
		
		//if (sTag != "LowerSecurity") ImGui_SetModColorMul(greyed);
		if (lSelectedFloor != 0) ImGui_SetModColorMul(greyed);
		if (ImGui_DoButton("ButtonF0", "ButtonFloor0", ImGui_NrmPosGroup(cVector3f(fButtonX, 0.05, 2)), ImGui_NrmSizeGroup(cVector2f(fButtonWidth, 0.15))))
		{
			ImGui_SetStateInt("SelectedFloor",0);
			Depth_Audio_Terminal_Forward(asEntityName);
			ImGui_SetStateFloat("MapAlpha",0);
		}
		ImGui_SetModColorMul(cColor_White);
		
		float fFloorLabelY = 0.0f;
		if (ImGui_GetStateInt("LockdownRemoved") == 0) fFloorLabelY = 0.35f;
		else fFloorLabelY = 0.45f;
		
		////////////////////////////////////////////////
		// Determine if player can actually lift the local lockdown - or if we display an error
		bool bPlayerCanLiftLockdown = false;
		if (lPlayerOnFloor == ImGui_GetStateInt("SelectedFloor")) bPlayerCanLiftLockdown = true;
		if (mbMainLockdownRemoved == false) bPlayerCanLiftLockdown = true;
		
		///////////////////////////////
		// Display selected floor in top left
		tString sSelectedFloor = "ButtonFloor"+ImGui_GetStateInt("SelectedFloor");
		ImGui_DoLabelExt(sSelectedFloor, floorHeading, ImGui_NrmPosGroup(cVector3f(-0.4f,-0.75f,1.0f)), ImGui_NrmSizeGroup(cVector2f(1)), 2);
		
		//////////////////////////////
		// Display floor player is currently on
		ImGui_DoLabel(sFloorNumber, ImGui_NrmPosGroup(cVector3f(-0.125f,fFloorLabelY,1.0f)), ImGui_NrmSizeGroup(cVector2f(1)), 1);
		
		if (ImGui_GetStateInt("LockdownRemoved") == 0 && bOverrideButtonEnabled)
		{
			//ImGui_SetModUseInput(bOverrideButtonEnabled);
			if (ImGui_DoButton("ButtonRemoveLockdown","ButtonRemoveLockdown", ImGui_NrmPosGroup(cVector3f(fButtonX+0.05, 0.9, 2)), ImGui_NrmSizeGroup(cVector2f(fButtonWidth-0.05, 0.15))))
			{
				if (bPlayerCanLiftLockdown == false)
				{
					StationGui_SetActiveApp(eSecurityPanelState_ErrorScreen);
				}
				else if (mbLockdownPuzzleSolved)
				{
					Terminal_SetUpdateWhenOutOfView(asEntityName,true);
					StationGui_SetActiveApp(eSecurityPanelState_OpenDoors);
				}
				else
				{
					Terminal_SetUpdateWhenOutOfView(asEntityName,true);
					
					ResetLockdownPuzzle();
					StationGui_SetActiveApp(eSecurityPanelState_RemoveLockdown);
					Depth_Audio_Terminal_Forward(asEntityName);
				}
			}
			ImGui_ResetModifiers();
		}
		
		if (ImGui_GetStateInt("LockdownRemoved") == 0 || mbMainLockdownRemoved == false)
		{
			ImGui_SetModColorMul(cColor_Red);
			ImGui_DoLabel("LocalLockdown", ImGui_NrmPosGroup(cVector3f(-0.125f,0.45f,1.0f)), ImGui_NrmSizeGroup(cVector2f(1)), 1);
		}
		
		ImGui_GroupEnd();
	}
	
	//-------------------------------------------------------
	
	void SecurityPanelError(const tString&in asEntityName, float afTimeStep)
	{
		cColor colorRed = gStationGuiColor_Warning;
			
		float fFadeAlpha = ImGui_GetStateFloat("MessageFadeAlpha",0.0f);
			
		///////////////////////////////////////////////////////
		// Draw background			
		cColor bgCol = colorRed * cColor(0.1f, fFadeAlpha*0.9f);
		ImGui_DrawGfx(cImGuiGfx(""), cVector3f(0,0,9), ImGui_GetSize(), bgCol);
			
		/////////////////////////////////////////////
		// Show error window			
		cGuiDialogBoxSettings dialogBox = StationGui_CreateDefaultDialogBox();
		dialogBox.mWindow.mColorBase = colorRed; 
		dialogBox.mWindow.mColorBase.a = fFadeAlpha;
		dialogBox.mTextFrame.mColorBase.a = fFadeAlpha;
		dialogBox.mButton.mColorBase.a = fFadeAlpha;
		dialogBox.mButton.mFont.mColor.a = fFadeAlpha;
		
		dialogBox.mfZ = 20.0;
		dialogBox.mType = eGuiDialogBoxType_OK;
		ImGui_SetModUseInput(false);
		
		if (ImGui_IsFading("MessageFadeAlpha")==false && fFadeAlpha > 0)
		{
			ImGui_SetModUseInput(true);
			eGuiDialogCode buttonPressed = Depth_ImGui_DialogBox("LockdownFAULT", "LockdownWrongFloor", dialogBox);
			
			////////////////////////////////////////
			// Sound when getting rid of message
			if (buttonPressed == eGuiDialogCode_OK)
			{
				Sound_CreateAtEntity("sfx_ConsoleError", "Entities_Station/tech/terminal_beeps/upsilon_train_map/destination_upsilon_B_cancel", asEntityName);
				ImGui_SetStateFloat("MessageFadeAlpha",0.0f);
				StationGui_SetActiveApp(eSecurityPanelState_StatusScreen);
			}
		}
		
		////////////////////////////////////////
		// Start fade in
		if(fFadeAlpha==0.0f && ImGui_IsFading("MessageFadeAlpha")==false)
		{
			ImGui_FadeStateFloat("MessageFadeAlpha", 1.0f, 0.5f);
		}
			
	}
	
	//-------------------------------------------------------
	
	void SecurityPanelOpenDoors(const tString &in asEntityName, float afTimeStep)
	{
		if (mbDisplayBGImageOnDoorOpen)
		{
			cImGuiGfx gfx("PowerCamera", eImGuiGfx_Special);
			ImGui_DrawGfx(gfx, ImGui_NrmPos(cVector3f(0.0f,0.0f,1.0f)), ImGui_NrmSize(cVector2f(1.0f,1.0f)), cColor(1.0f, 1.0f, 1.0f,1.0f));
		}
		
		if (DoLoadingWindow("LoadingWindow", "Unlocking", "Unlocking", 2.0f, true))
		{
			ImGui_SetStateInt("LockdownRemoved", 1);
			StationGui_SetActiveApp(eSecurityPanelState_MainMenu);
			Sound_CreateAtEntity("TerminalBeep", "Entities_Station/tech/terminal_beeps/omicron_lockdown_puzzle_solve", ImGui_GetName(), 0.0f, false, 1.0f);
			mlLockdownPuzzleDifficulty++;
			if (!mbMainLockdownRemoved)
			{
					cLux_AddTodoMessage("* Dialogue removed - review this *");
					/*Dialog_Begin("Catherine");
						Dialog_AddBranchAndSubject("7A_TurnoffLockdown","","");
					Dialog_End();*/
				
				mbMainLockdownRemoved = true;
			}
			
			OpenShutters(Entity_GetVarString(asEntityName,""), true);
			mbLockdownPuzzleSolved = true;
			mbDisplayBGImageOnDoorOpen = false;
		}
	}
	
	//-------------------------------------------------------
	bool mbLockdownStartupPlaying = false;
	bool mbFadeInSecurityBG = false;
	bool mbShowLockdownControls = false;
	void SecurityLockdownDisplayIntro(const tString &in asEntityName, float afTimeStep)
	{
		float fBGAlpha = ImGui_GetStateFloat("IntroBGAlpha",0.0f);
		
		
		cImGuiGfx gfx("PowerCamera", eImGuiGfx_Special);
		ImGui_DrawGfx(gfx, ImGui_NrmPos(cVector3f(0.0f,0.0f,1.0f)), ImGui_NrmSize(cVector2f(1.0f,1.0f)), cColor(1.0f, 1.0f, 1.0f,fBGAlpha));
		
		StationGuiBG_Scanlines();
		
		cImGuiLabelData label;
		label.mFontAlign = eFontAlign_Center;
		
		ImGui_IncStateFloat("IntroTimer",afTimeStep);
		float fTime = ImGui_GetStateFloat("IntroTimer",0.0f);
		
		
		//////////////////////
		// There's a fault, display for 2 seconds
		if (fTime < 2.5f)
		{
			ImGui_DoLabelExt("LockdownFAULT", label, ImGui_NrmPos(cVector3f(-0.0f,-0.0f,2.0f)), ImGui_NrmSize(cVector2f(1)), 1.65);
			ImGui_DoLabelExt("LockdownSTANDBY", label, ImGui_NrmPos(cVector3f(-0.0f,0.1f,2.0f)), ImGui_NrmSize(cVector2f(1)), 1.65);
			
		}
		////////////////////
		// Determine what the fault is
		else if (ImGui_GetStateBool("FaultDetected", false) == false)
		{
			if (StationGui_LoadingWindow("DetectingFaultWindow", "DetectingFaultWindow", "DetectingFault", 5.0f, true))
			{
				ImGui_SetStateBool("FaultDetected", true);
			}
			
			if(mbLockdownStartupPlaying==false)
			{
				mbLockdownStartupPlaying = true;
				cLux_AddTodoMessage("Play lockdown intro sound");
				Sound_CreateAtEntity("LockdownPuzzleStart", "03_02_omicron_inside/SFX/lockdown_puzzle_startup/startup", asEntityName);
			}
		}
		///////////////////
		// Fade in the background
		else if (ImGui_GetStateBool("FaultDetected", false))
		{
			fBGAlpha = cMath_InterpolateLinear(fBGAlpha,1.0f,afTimeStep);
			ImGui_SetStateFloat("IntroBGAlpha",fBGAlpha);
			
			ImGui_IncStateFloat("IntroTimer2",afTimeStep);
			fTime = ImGui_GetStateFloat("IntroTimer2",0.0f);
			
			if (fTime > 3.0f && ImGui_GetStateBool("RepairUtilityLoaded", false) == false)
			{
				if (StationGui_LoadingWindow("LoadingRepairWindow", "LoadingRepairWindow", "LoadingRepair", 5.0f, true, cVector2f(0.6, 0.3)))
				{
					ImGui_SetStateBool("RepairUtilityLoaded", true);
				}
			}
			if (fTime > 2.0f)
			{
				ImGui_DoLabelExt("LockdownREASON", label, ImGui_NrmPos(cVector3f(-0.0f,-0.4f,2.0f)), ImGui_NrmSize(cVector2f(1)), 1.65);
			}
			if (fTime > 1.0f)
			{
				ImGui_DoLabelExt("LockdownLOCATED", label, ImGui_NrmPos(cVector3f(-0.0f,-0.45f,2.0f)), ImGui_NrmSize(cVector2f(1)), 1.65);		
			}
			
			if (ImGui_GetStateBool("RepairUtilityLoaded", false) == true)
			{
				mbIntroPlayed = true;
			}
		}
		
	}
	
	//-------------------------------------------------------
	
	cVector2f[] mvLinePositions;
	cVector3f mvLockPuzzleTopLeft;
	float mfLockPuzzleSpacing = 0.0f;
	int mlLockdownBlocksPerRow = 0;
	int mlLockdownPuzzleMin = 0;
	int mlLockdownPuzzleMax = 0; 
	int mlLockdownPuzzleDifficulty = 0;
	float mfMaxHopLength = 0.0f;
	
	//-------------------------------------------------------
	
	void SecurityPanelLockdownRemove(const tString&in asEntityName, float afTimeStep)
	{
		//cLux_AddTodoMessage("SCRIPT: Some feedback when removing lockdown!");
		//StationGui_SetActiveApp(eSecurityPanelState_MainMenu);
		
		if (ImGui_GetStateBool("ForceExit",false))
		{
			ImGui_SetStateBool("ForceExit",false);
			Terminal_SetUpdateWhenOutOfView(asEntityName,false);
			StationGui_SetActiveApp(eSecurityPanelState_MainMenu);
		}
		
		
		cImGuiGfx gfx("PowerCamera", eImGuiGfx_Special);
		ImGui_DrawGfx(gfx, ImGui_NrmPos(cVector3f(0.0f,0.0f,1.0f)), ImGui_NrmSize(cVector2f(1.0f,1.0f)), cColor(1.0f, 1.0f, 1.0f,1.0f));
		
		bool bSolved = false;
		
		/////////////////////////////////
		// Button
		cImGuiButtonData buttonMenu = StationGui_CreateDefaultButtonData();
		buttonMenu.mFont.mvSize = cVector2f(24);
		
		cImGuiButtonData button;
		button.mvDefaultSize = cVector2f(10,10);
		button.mColorBase = cColor(0.3,0.3,0.3,0);
		button.mbUseInFocusGfx = true;
		button.mGfxInFocus.SetFile("urban/keypad/keypad_Selected");
		
		
					   
		///////////////////////////////////////////////////
		// Determine if puzzle is solved with buttons pushed in right order
		bSolved = ProcessLockdownPuzzleSolved();
		
		///////////////////////////////////////////////////////
		// Menu
		if (bSolved)
		{
			float fSolvedTimer = ImGui_GetStateFloat("SolvedTimer",0);
			ImGui_SetStateFloat("SolvedTimer",fSolvedTimer+afTimeStep);
			ImGui_SetStateInt("Solved",1);
			
			Lamp_SetFlickerActive("corridor_amb_lights_pwr_23",true);
			Lamp_SetLit("corridor_amb_lights_pwr_23",true,true);
			
			if (fSolvedTimer > 3.0f)
			{
				Lamp_SetFlickerActive("corridor_amb_lights_pwr_23",false);
				StationGui_SetActiveApp(eSecurityPanelState_OpenDoors);
				return;
			}
			
		}
		else
		{
			bool bButtonReset = ImGui_DoButtonExt("ButtonPuzzleReset","ButtonPuzzleReset",buttonMenu, ImGui_NrmPos(cVector3f(0.08,0.875,15.0)), ImGui_NrmSize(cVector2f(0.4, 0.11)));
			bool bButtonBack = ImGui_DoButtonExt("ButtonBack","ButtonStatus",buttonMenu, ImGui_NrmPos(cVector3f(0.52,0.875,15.0)), ImGui_NrmSize(cVector2f(0.4, 0.11)));
			if (bButtonReset) ResetLockdownPuzzle();
			if (bButtonBack) StationGui_SetActiveApp(eSecurityPanelState_MainMenu);
		}
		
		/////////////////////////////
		// Header
		cImGuiLabelData label;
		label.mFontAlign = eFontAlign_Center;
		ImGui_DoLabelExt("LockdownREASON", label, ImGui_NrmPos(cVector3f(-0.0f,-0.4f,2.0f)), ImGui_NrmSize(cVector2f(1)), 1.65);
		ImGui_DoLabelExt("LockdownLOCATED", label, ImGui_NrmPos(cVector3f(-0.0f,-0.45f,2.0f)), ImGui_NrmSize(cVector2f(1)), 1.65);		
		
		
		
		///////////////////////////////////////////////////////
		// Load images (based on random shuffle)
		cImGuiGfx lockIcon; 
		cImGuiGfx tooFarIcon; 
		cImGuiGfx pressedIcon;
		cImGuiGfx clearIcon; 
	
		
		pressedIcon.SetFile("station/lockdownterminal/lockdown_icon_3");
		tooFarIcon.SetFile("station/lockdownterminal/lockdown_icon_2");
		lockIcon.SetFile("station/lockdownterminal/lockdown_icon_4");
		clearIcon.SetFile("station/lockdownterminal/lockdown_icon_1");
		tooFarIcon.mColor = cColor(0.5f,0.5f,0.5f,0.5f);
		lockIcon.mColor = cColor(1.0,0.2,0.2,0.7);
		
		///////////////////////////////////////////////////////
		// Show images
		int min = mlLockdownPuzzleMin;
		int max = mlLockdownPuzzleMax;	// 3x3 grid, 9 blocks
		float fX = mvLockPuzzleTopLeft.x;
		float fY = mvLockPuzzleTopLeft.y;
		int count = min;
		int lButtonImage = -1;
			
		cVector2f vPos;
		int lClicks = ImGui_GetStateInt("ClickCount");
		float fLen = 0.0f; 
		
		int lMovesRemaining = 0;
		
		///////////////////////////////////////////
		// Display images
		while (count <= max)
		{
			if (count % mlLockdownBlocksPerRow == 0 && count != 0)
			{
				fY += 0.1f;	
				fX = mvLockPuzzleTopLeft.x;
			}

			if (cLux_ScriptDebugOn())
			{
				ImGui_SetTransCategory("");
				ImGui_DoLabel(""+count,ImGui_NrmPos(cVector3f(fX+0.05f,fY,999.0f)));
			}
			
			lButtonImage = ImGui_GetStateInt("Button"+count,-1);
			
			//////////////////////////////////
			// Determine distance if necessary
			fLen = 0.0f;
			
			if (lClicks > 0)
			{
				vPos.x = fX + 0.05f;
				vPos.y = fY + 0.05f;
				cVector2f vLastPos = cVector2f(ImGui_GetStateFloat("LastX",0.0f), ImGui_GetStateFloat("LastY",0.0f));
				cVector2f vDelta = vPos - vLastPos;
				fLen = vDelta.Length();	
			}
			
			//////////////////////
			// Images
			
			if (lButtonImage == 99) 	 ImGui_DoImage(pressedIcon,ImGui_NrmPos(cVector3f(fX,fY,11.0f)),ImGui_NrmSize(cVector2f(0.1,0.1)));  // Already Pressed
			else if (lButtonImage != -1) ImGui_DoImage(lockIcon,ImGui_NrmPos(cVector3f(fX,fY,11.0f)),ImGui_NrmSize(cVector2f(0.1,0.1)));		// Locked
			else if (fLen > mfMaxHopLength)	 ImGui_DoImage(tooFarIcon,ImGui_NrmPos(cVector3f(fX,fY,11.0f)),ImGui_NrmSize(cVector2f(0.1,0.1)));	// Too Far
			else
			{
				lMovesRemaining++;
				ImGui_DoImage(clearIcon,ImGui_NrmPos(cVector3f(fX,fY,11.0f)),ImGui_NrmSize(cVector2f(0.1,0.1)));	// Available	
			}
			
			
			
			/////////////////////
			// Buttons
			if (ImGui_DoButtonExt("ButtonPuzzle"+count,"",button, ImGui_NrmPos(cVector3f(fX,fY,11.0f)), ImGui_NrmSize(cVector2f(0.1, 0.1))))
			{
				AddLockdownPuzzleLine(count, fX, fY);
			}
			
			
			fX += 0.1f;
			
		
			++count;
		}
				
		////////////////////////////////////////////////////////
		// Render Connections
		float fLineTimer = ImGui_GetStateFloat("LineTimer");
		float fLineWidth = 8.0f+(cMath_Sin(fLineTimer*2.0f)*2.25f);
		fLineTimer += afTimeStep;
		ImGui_SetStateFloat("LineTimer",fLineTimer);
		
		cColor cLineColor = cColor_Red;
		if (bSolved) cLineColor = cColor_Green;
			
		for (int i=0; i < mvLinePositions.length-1; i++)
		{
			
			ImGui_DrawLine(ImGui_NrmSize(mvLinePositions[i]),ImGui_NrmSize(mvLinePositions[i+1]),10.0f,fLineWidth,cLineColor);			
		}
		
		if (lMovesRemaining <= 0)
		{
			float fFailTimer = ImGui_GetStateFloat("FailTimer",0.0f) + afTimeStep;
			
			if (fFailTimer > 1.0f)
			{
				Sound_PlayGui("Entities_Station/tech/terminal_beeps/omicron_lockdown_puzzle_wrong",1.0);		
				fFailTimer = 0.0f;
			}
			ImGui_SetStateFloat("FailTimer",fFailTimer);
		}
		
		ImGui_SetTransCategory("03_02_omicron_inside");
	}
	
	//-------------------------------------------------------
	
	bool ProcessLockdownPuzzleSolved()
	{
		int solved = mlLockdownPuzzleMax+1;
		for (int i=mlLockdownPuzzleMin; i<=mlLockdownPuzzleMax; i++)
		{
			if (ImGui_GetStateInt("Button"+i,-1) != -1)
			{
				solved--;
			}
		}
		
		if (solved <= 0) return true;
		
		return false;
	}
	
	//-------------------------------------------------------
	
	void SetTileRed(int alIndex)
	{
		ImGui_SetStateInt("Slot"+alIndex,1);
		ImGui_SetStateInt("Button"+alIndex,1);
	}
	
	void SetTileWhite(int alIndex)
	{
		ImGui_SetStateInt("Slot"+alIndex,0);
		ImGui_SetStateInt("Button"+alIndex,-1);
	}
	
	void ResetLockdownPuzzle()
	{
		////////////////////////////
		// Reset lines and counters
		mvLinePositions.resize(0);
		ImGui_SetStateInt("ClickCount", 0);
		ImGui_SetStateFloat("SolvedTimer",0);
		ImGui_SetStateFloat("UnsolvedTimer",0);
		
		/////////////////////////////
		// Determine difficulty

		mvLockPuzzleTopLeft = cVector3f(0.1f,0.125f,1);	
		mlLockdownBlocksPerRow = 10;
		mlLockdownPuzzleMax = 69;
			
		
		mvLockPuzzleTopLeft.x -= mfLockPuzzleSpacing * (mlLockdownBlocksPerRow/2.0f) + 0.1f;
		
		mfMaxHopLength = 0.175f;
		
		////////////////////////////////////////
		// Generate the grid
		int min = mlLockdownPuzzleMin;
		int max = mlLockdownPuzzleMax;	// 3x3 grid, 9 blocks
		
			///////////////////////////////////////
			// Set all 'cards' and buttons to be empty
				for (int i=0; i<=max; i++)
			{
				ImGui_SetStateInt("Slot"+i,0);
				ImGui_SetStateInt("Button"+i,-1);
			}
	
			for (int i=0;i<max+1;++i)
			{
				SetTileRed(i);
			}
			
			int[] vWhiteSquares = { 12,21,22,23,32,41,52,43,	// left section
								    34,35,	// middle connector
									17,26,27,28,37,46,48,57};	// right section
			for (int i=0; i<vWhiteSquares.length();++i)
			{
				SetTileWhite(vWhiteSquares[i]);
			}
			
			
		/////////////////////////////////////
		// Sound! We are done!
		Sound_PlayGui("Entities_Station/tech/terminal_beeps/omicron_lockdown_puzzle_button",1.0);
	}
	
	//-------------------------------------------------------
	
	void AddLockdownPuzzleLine(int alButton, float fX, float fY)
	{
		if (ImGui_GetStateInt("Button"+alButton) != -1)
		{
			Sound_PlayGui("Entities_Station/tech/terminal_beeps/omicron_lockdown_puzzle_button",1.0);
			return;
		}
		
		cVector2f vPos;
		vPos.x = fX + 0.05f;
		vPos.y = fY + 0.05f;
		
		int lClicks = ImGui_GetStateInt("ClickCount");
		if (lClicks > 0)
		{
			cVector2f vLastPos = cVector2f(ImGui_GetStateFloat("LastX",0.0f), ImGui_GetStateFloat("LastY",0.0f));
			cVector2f vDelta = vPos - vLastPos;
			float fLen = vDelta.Length();
			if (fLen > mfMaxHopLength)
			{
				cLux_AddDebugMessage("LENGTH : " + vDelta.Length());
				Sound_PlayGui("Entities_Station/tech/terminal_beeps/omicron_lockdown_puzzle_wrong",1.0);
				return;
			}
		}
		
		ImGui_SetStateFloat("LastX",vPos.x);
		ImGui_SetStateFloat("LastY",vPos.y);
		
		mvLinePositions.push_back(vPos);
		
		
		Sound_PlayGui("Entities_Station/tech/terminal_beeps/omicron_lockdown_puzzle_button",1.0);
		ImGui_SetStateInt("Button"+alButton,99);
		
		lClicks++;
		ImGui_SetStateInt("ClickCount", lClicks);
	}
	
	
	
