		Sound_FadeGlobalVolume(0.65f, 0.15f, eSoundEntryType_World);
		Music_Stop(0.25f, eMusicPrio_BigEvent);
		Map_AddTimer("FadeUpRossFirstLine", 5.0f, "FadeUpRossFirstLine");
	}
	
