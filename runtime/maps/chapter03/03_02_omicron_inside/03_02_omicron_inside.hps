	bool CollideActivateInfirmaryRobohead(const tString&in asParent, const tString&in asChild, int alState)
	{
		cLux_AddDebugMessage("Activate Infirmary Remade!");
		
		Entity_SetActive("agent_robothead_tunnelchase",true);
		Agent_SetSensesActive("agent_robothead_tunnelchase", false);
		
		Map_AddTimer("InfirmaryRoboheadSensesBack", 3.5f, "Timer_InfirmaryRoboheadSensesBack");
		
		//CheckPoint_Setup("Checkpoint_RobotHead");
		
