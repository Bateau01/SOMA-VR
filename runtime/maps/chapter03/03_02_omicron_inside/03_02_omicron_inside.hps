	/////////////////////////////////////
	// Scene 2 - Leaving the tunnel
	/////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool OnCollideLeaveTunnel(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		Map_AddTimer("StartAmbient", cMath_RandRectf(8.0f,15.0f), "AmbientMusicHandler");
		
