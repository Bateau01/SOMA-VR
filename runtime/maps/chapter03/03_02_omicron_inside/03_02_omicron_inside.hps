	bool mbPowerRoomMusicPlayer=false;
	
	bool CollidePowerRoom_StartMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(mbPowerRoomMusicPlayer) return true;
		mbPowerRoomMusicPlayer=true;
		
		cLux_AddDebugMessage("Start Power room music");
		
		Music_PlayExt("NPC_deepseadiver_ambient", true, 0.65f, 0.7f, 6, 0, eMusicPrio_SceneAmb, true);
		
		
		return true;
	}
	
	bool CollidePowerRoom_StopMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(mbPowerRoomMusicPlayer==false) return true;
		mbPowerRoomMusicPlayer=false;
		
		cLux_AddDebugMessage("Stop Power room music");
		
		Music_Stop(8, eMusicPrio_SceneAmb);
		Map_AddTimer("StartAmbient", cMath_RandRectf(8.0f,15.0f), "AmbientMusicHandler");
		
		return true;
	}
	
