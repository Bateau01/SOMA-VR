	//-------------------------------------------------------
	
	////////////////////////////////////////////////
	// Scene 10 - Event I - Wake up in copy (dialog)
	////////////////////////////////////////////////
	
	//-------------------------------------------------------
	int mlIDRadialBlur = -1;
	int mlIDScanTrails = -1;
	bool mbPlayerStoodUp = false;
	//-------------------------------------------------------
	
	void ScanComplete()
	{
		////////////////////////////////
		// Disable block boxes to allow player out of the locker
		Entity_SetActive("BlockboxLocker_*",true);
		
		////////////////////////////////
		// Teleport to new body and set up area to begin conversation
		Player_Teleport("start_afterscan",true);
		Entity_SetActive("AreaSimonAwakens",true);
		
		/////////////////////////////////
		// Old Simon is now in chair, breathing slowly
		Entity_SetActive("SimonOldCopy",true);
		Entity_SetActive("old_simon_collision_*",true);
		
		/////////////////////////////////
		// Disable old suit parts
		Entity_SetActive("PowerSourceInBody",false);
		Entity_SetActive("ComputerBrainInBody",false);
		Entity_SetActive("DiveLocker_Empty",true);
		Entity_SetActive("DivesuitLocker",false);
		Entity_SetActive("DivesuitCorpse",false);
		Entity_SetActive("divesuit_battery_lamp",false);
				
		//////////////////////////
		// Simons creepy slow breathing
		Map_AddTimer("timer_simonbreath",0.5f,"TimerSimonBreath");
				
		/////////////////////////
		// Set up the terminal to kill old Simon (if player wishes)
		mbScanComplete = true;
		Entity_SetInteractionDisabled("ScanRoomCable",false);
		Terminal_SetGuiActive("DivesuitTerminal",false,1.0f);
		Terminal_SetGuiActive("computer_terminal_slide_flesher_8",false,1.0f);
		
		mlIDScanTrails = Effect_ImageTrail_Start(0.75f,0.0f,5.0f,35.0f);
		Player_FadeMoveSpeedMulTo(1,30.0f);
		Player_FadeLookSpeedMulTo(1,30.0f);
		
		Player_FadeFOVMulTo(1.0f, 0);
		
		/////////////////////////
		// Set up new body attrs
		Player_SetHealth(1.0f);
		PlayerHands_SetHandModel_DeepSea();
		
		Map_AddTimer("", 2, "Timer_WakeUpLookAtNewHands");
		Map_AddTimer("timer_wakeupconversation",2.0f,"TimerWakeupConversation");
		
		////////////////////////////
		// Global var to say 'we're now in a suit'
		cScript_SetGlobalVarBool("InDeepSeaSuit", true);

		////////////////////////////
		// Begin sitting camanim
		CameraAnimation_Begin("SuitWakePreAnim","",false);
		SwingDoor_SetOpenAmount("DiveLocker_Door",1.0f);
		Map_AddTimer("timer_autostand",15.0f,"TimerAutoStand");
		
		///////////////////////////
		// Begin wake up drone
		Sound_CreateAtEntity("WakeupDrone", "Entities_Special/Equipment/scanner/omicron/omicron_wake_up_drone", "Player");
		Depth_Audio_Fear_MediumIntensity(10.0f, 10.0f, 1, true, false);
		Sound_FadeGlobalVolume(0.45f, 3.0f, eSoundEntryType_World);
		
		////////////////////////////
		// Hide Simon hands/legs and lift the helmet back to start position
		Entity_SetActive("chair_scan_start",true);
		Entity_SetActive("SimonHands", false);
		Entity_SetActive("SimonLegs", false);
		
		
		LastOnSoma_SetText("03_02_omicron_inside_3");
	}
	
