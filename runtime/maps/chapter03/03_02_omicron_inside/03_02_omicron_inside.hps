	//-------------------------------------------------------
	
	void OnChangeCanteenDoor(const tString &in asEntity, int alState)
	{
		cLux_AddDebugMessage("Change canteen door state to "+alState);
		
		if(alState==-1 && Entity_GetCollide("Player", "CanteenHallway"))
		{
			Voice_Stop("CanteenAudioLog");
		}
	}
	
	bool CanteenVOControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState==1)
		{
			Voice_Stop("CanteenAudioLog");
		}
		return true;
	}
	
	//{ Hydroponics Audio Log--------------------------------------
	
	bool mbHydroLogActive = false;	
	void StartHydroLog()
	{
		cLux_AddDebugMessage("Starting Hydro audio log");
		
		//Slight delay for pacing
		Map_AddTimer("HydroLogVoiceStart", 1.f, "HydroLogVoiceStart");
			
		//Sound
		Sound_CreateAtEntity("HydroTapeStart", "Entities_Station/object/tape_recorder/modern/start","audio_log_hydroponics");
		Sound_CreateAtEntity("HydroTapeLoop", "Entities_Station/object/tape_recorder/modern/loop", "audio_log_hydroponics");
		mbHydroLogActive = true;
			
		//Set interaction disbaled for 1 second to stop from sound spamming
		Entity_SetInteractionDisabled("audio_log_hydroponics", true);
		Map_AddTimer("ReEnableTapePlayerInteraction", 1.f, "Timer_TapePlayerInteractionEnable");
	}
			
	//-------------------------------------------------------
	
	void HydroLogVoiceStart(const tString &in asTimer)
	{
		Voice_Play("HydroponicsAudioLog");
	}
		
	//-------------------------------------------------------
	
	void StopHydroLog()
	{
		cLux_AddDebugMessage("Stopping Hydro audio log");
		Voice_Stop("HydroponicsAudioLog");
		Voice_Stop("Recording");
		Map_RemoveTimer("HydroLogVoiceStart");
		Entity_SetActive("audio_log_hydroponics_idle", true);
		Entity_SetActive("audio_log_hydroponics_playback", false);
		
		Sound_Stop("HydroTapeLoop", 0.05f);
		Sound_Stop("HydroTapeStart", 0.05f);
		Sound_CreateAtEntity("HydroTapeStop", "Entities_Station/object/tape_recorder/modern/stop", "audio_log_hydroponics");
		//Sound_CreateAtEntity("HydroTapeLoopEnd", "Entities_Station/object/tape_recorder/loop_end", "audio_log_hydroponics");
		mbHydroLogActive = false;
				
		//Set interaction disbaled for 0.5 seconds to stop from sound spamming
		Entity_SetInteractionDisabled("audio_log_hydroponics", true);
		Map_AddTimer("ReEnableTapePlayerInteraction", 0.5f, "Timer_TapePlayerInteractionEnable");
	}
	
	//-------------------------------------------------------
	
	void LineOver_StopHydroLog(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStart)
	{
		if (abStart) return;
		StopHydroLog();
	}
		
	//-------------------------------------------------------
	
	void Timer_TapePlayerInteractionEnable(const tString &in asTimer)
	{
		Entity_SetInteractionDisabled("audio_log_hydroponics", false);
	}
	
	void audio_log_hydroponics_OnConnectionStateChange(const tString &in asEntity, int alState)
	{
		if (alState == 1)
		{
			Voice_StopAll();
			//Voice_SetSource("Masters",asEntity,0,10,true,10);
			MovingButton_SetSwitchedOn("audio_log_biolab",false,true);
			Entity_SetActive("audio_log_hydroponics_idle", false);
			Entity_SetActive("audio_log_hydroponics_playback", true);
			StartHydroLog();
			
		}
		
		if (alState == -1)
		{
			cLux_AddDebugMessage("Stopping audio log");
			Entity_SetActive("audio_log_hydroponics_idle", true);
			Entity_SetActive("audio_log_hydroponics_playback", false);
			StopHydroLog();
		}
	}
		
	//} End Hydroponics Audio Log--------------------------------------
	
	//-------------------------------------------------------
	
	//{ BioLab Audio Log--------------------------------------
	
	bool mbBiolabLogActive = false;
	
	void StartBiolabLog()
	{
		cLux_AddDebugMessage("Starting Biolab audio log");
		
		//Slight delay for pacing
		Map_AddTimer("BiolabLogVoiceStart", 1.f, "BiolabLogVoiceStart");
			
		//Sound
		Sound_CreateAtEntity("BiolabTapeStart", "Entities_Station/object/tape_recorder/modern/start","audio_log_biolab");
		Sound_CreateAtEntity("BiolabTapeLoop", "Entities_Station/object/tape_recorder/modern/loop", "audio_log_biolab");
		mbBiolabLogActive = true;
			
		//Set interaction disbaled for 1 second to stop from sound spamming
		Entity_SetInteractionDisabled("audio_log_biolab", true);
		Map_AddTimer("BiolabReEnableTapePlayerInteraction", 1.f, "BiolabTimer_TapePlayerInteractionEnable");
		
		Entity_SetActive("audio_log_biolab_icon_idle", false);
		Entity_SetActive("audio_log_biolab_icon_playback", true);
	}
			
	//-------------------------------------------------------
	
	void BiolabLogVoiceStart(const tString &in asTimer)
	{
		Voice_Play("BiolabAudioLog");
	}
		
	//-------------------------------------------------------
	
	void StopBiolabLog()
	{
		cLux_AddDebugMessage("Stopping Biolab audio log");
		Voice_Stop("BiolabAudioLog");
		Voice_Stop("Recording");
		Map_RemoveTimer("BiolabLogVoiceStart");
		
		Sound_Stop("BiolabTapeLoop", 0.05f);
		Sound_Stop("BiolabTapeStart", 0.05f);
		Sound_CreateAtEntity("BiolabTapeStop", "Entities_Station/object/tape_recorder/modern/stop", "audio_log_biolab");
		//Sound_CreateAtEntity("BiolabTapeLoopEnd", "Entities_Station/object/tape_recorder/loop_end", "audio_log_biolab");
		mbBiolabLogActive = false;
				
		//Set interaction disbaled for 0.5 seconds to stop from sound spamming
		Entity_SetInteractionDisabled("audio_log_biolab", true);
		Map_AddTimer("BiolabReEnableTapePlayerInteraction", 0.5f, "BiolabTimer_TapePlayerInteractionEnable");
		
		Entity_SetActive("audio_log_biolab_icon_playback", false);
		Entity_SetActive("audio_log_biolab_icon_idle", true);
		
		MovingButton_SetSwitchedOn("audio_log_biolab",false,true);
	}
	
	void audio_log_biolab_OnConnectionStateChange(const tString &in asEntity, int alState)
	{
		////////////////////////////////////////////
		// BIOLAB AUDIO LOG
		if (alState == 1)
		{
			cLux_AddDebugMessage("Starting audio log");
			Voice_StopAll();
			//MovingButton_SetSwitchedOn("audio_log_biolab",false,true);
			//Voice_SetSource("Masters",asEntity,0,10,true,10);
			StartBiolabLog();
		}
		
		if (alState == -1)
		{
			cLux_AddDebugMessage("Stopping audio log");
			StopBiolabLog();
		}
	}
	
	bool BioLabAudioControl(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(mbBiolabLogActive==true)
		{
			StopBiolabLog();
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	void BiolabTimer_TapePlayerInteractionEnable(const tString &in asTimer)
	{
		Entity_SetInteractionDisabled("audio_log_biolab", false);
	}
	
	void LineOver_BioLabAudioLog(const tString&in asScene, const tString&in asSubject, int alLineIndex, bool abStart)
	{
		if (abStart) return;
		StopBiolabLog();
	}

