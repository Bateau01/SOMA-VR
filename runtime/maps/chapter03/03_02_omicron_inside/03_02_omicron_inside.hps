	//-------------------------------------------------------
	
	////////////////////////////////////////////////
	// Scene 10 - Event B - Build Step 1 : Add Computer Brain
	////////////////////////////////////////////////
	
	//-------------------------------------------------------
	
	void BrainInBody()
	{
		Entity_SetActive("ToolArea_ComputerBrain",false);
		
		PlayingBuildingBodyMusic();
		
		Sound_CreateAtEntity("InsertBrain", "03_02_omicron_inside/SFX/Pass2/brain_suit_insert", "SoundSrc_DiveSuitLocker");
		cLux_AddTodoMessage("SCRIPT: Juice. Blood. Disgusting stuff.");
		Entity_SetActive("ComputerBrainInBody",true);
		Prop_MoveLinearTo("ComputerBrainInBody","ComputerBrainInBody_MoveTarget",1.0f,2.0f,0.1f,true);
		Map_AddTimer("timer_brain_inser_effect", 0.7f, "TimerBrainInsertEffect");
		
		Map_AddTimer("timer_braindialogue",0.5f,"TimerBrainInserted");
	}
	
	//-------------------------------------------------------
	
	void TimerBrainInsertEffect(const tString &in asTimer)
	{
	    ParticleSystem_SetActive("brain_insert_splash", true);
		return;
	}
	
	//-------------------------------------------------------
	
	void TimerBrainInserted(const tString &in asTimer)
	{
		if (Voice_CharacterIsSpeaking("Catherine")||Voice_CharacterIsSpeaking("Player"))
		{
			Map_AddTimer("timer_braindialogue",0.5f,"TimerBrainInserted");
			return;
		}
		
		mbBrainInsertedInCorpse = true;
		
		Dialog_Begin("Catherine");
			Dialog_AddBranchAndSubject("10C_BuildStep2","","BrainInsertedInCorpse");
		Dialog_End();
	}
	
	//-------------------------------------------------------
	
	void BrainInsertedInCorpse(const tString&in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		
		Entity_SetActive("ToolArea_PowerSource",true);
		
	}
	
	
	
	//-------------------------------------------------------
	
	////////////////////////////////////////////////
	// Scene 10 - Event C - Build Step 2 : Add Power Source
	////////////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool PowerCubeToolInserted_OnUse(const tString &in asTool, const tString &in asEntity)
	{
		if (asEntity != "DiveSuitArea") return false;
		
		Entity_SetActive("PowerSourceInBody",true);	
		Map_AddTimer("timer_powerinsuit",0.5f,"TimerPowerInSuit");
		Lamp_SetLit("divesuit_battery_lamp", false, false);
		
		Player_StartLookAt("PowerSourceInBody", 3,3,3);
		
		Sound_CreateAtEntity("InsertBattery", "03_02_omicron_inside/SFX/Pass2/battery_suit_insert", asEntity);
				
		
		return true;
	}
	
	//-------------------------------------------------------
	
	void TimerPowerInSuit(const tString &in asTimer)
	{
		Player_StopLookAt(2);
				
		if (Voice_CharacterIsSpeaking("Catherine")||Voice_CharacterIsSpeaking("Player"))
		{
			Map_AddTimer("timer_powerinsuit",0.5f,"TimerPowerInSuit");
			return;
		}
		
		mbBatteryInsertedInCorpse = true;
		
		/*Dialog_Begin("Catherine");
			Dialog_AddBranchAndSubject("10C_BuildStep2","","OnConversationPowerPackInSuit");
		Dialog_End();*/
		
		Map_AddTimer("PowerPackPlacedInSuit", 1.0, "Timer_PowerPackPlacedInSuit");
	}
	
