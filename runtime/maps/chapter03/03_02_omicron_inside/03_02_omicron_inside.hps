	//-------------------------------------------------------
	
	tString msFlesherFootstepSound = "flesher/fs/metal_run";
	tString msFlesherFootstepArea = "Area_Effect_Footsteps_1";
	tString msFlesherTimer = "timer_flesher_footsteps";
	float mfFlesherFootstepInterval = 0.75f;
	float mfFlesherFootstepMinInterval = 0.55f;
	float mfFlesherFootstepVolume = 0.4f;
	int mlFlesherFootstepCount = 1;
	
	float mfFinalChaseDelay = 1.0f;
	
	//-------------------------------------------------------
	
	void Checkpoint_RobotHead(int alNumberOfRecentDeaths, const tString &in asSource)
	{
		//////////////////////////////////////////////////
		// Increment the final chase delay for each death the player has accumulated.
		// cap it to not become silly.
		mfFinalChaseDelay += 0.75f * alNumberOfRecentDeaths;
		if (mfFinalChaseDelay > 4.0f)
			mfFinalChaseDelay = 4.0f;
			
		cLux_AddTodoMessage("SCRIPT : Final chase delay @ " +mfFinalChaseDelay);
	}
	
