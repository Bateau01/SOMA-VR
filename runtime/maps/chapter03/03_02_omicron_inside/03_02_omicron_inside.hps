	bool CollideExitPowerRoom(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		if (mlPuzzleItemsGathered  >= 3)
		{
			cLux_AddTodoMessage("* Dialogue removed - review this *");
			/*Dialog_Begin("Catherine");
				Dialog_AddBranchAndSubject("5ALeavePowerRoomAllItems","","");	
			Dialog_End();*/
		}
		else if (mbPlayerHasUnchargedPack)
		{
			//////////////////////////////////
			// Only remind the player once to charge the pack
			if (mbChargeReminderPlayed) return true;
			
			cLux_AddTodoMessage("* Dialogue removed - review this *");
			/*Dialog_Begin("Catherine");
				Dialog_AddBranchAndSubject("5ALeavePowerRoomNotCharged","","");	
			Dialog_End();*/
		}
		else
		{
			
			cLux_AddTodoMessage("* Dialogue removed - review this *");
			/*Dialog_Begin("Catherine");
				Dialog_AddBranchAndSubject("5ALeavePowerRoomNeedMoreItems","","");	
			Dialog_End();*/
		}
		
		Entity_SetActive("AreaExitPowerRoom", false);
		return true;
	}
	
