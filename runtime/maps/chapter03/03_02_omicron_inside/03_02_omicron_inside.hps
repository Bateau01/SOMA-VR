	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test1)
		{
			mbCorpseCrafted = true;
			ActivateSuit();
			ScanComplete();
			
			cLux_AddDebugMessage("Power!");
			mbMainPowerRestored = true;
			SwingDoor_SetOpenAmount("DiveLocker_Door",1.0f);
			
			mbCorpseCrafted = true;
			
			Tool_PickUp("PowerCubeTool", false, false);
			Entity_SetActive("agent_robothead_powerroom", true);
			
			Entity_SetActive("AreaActivateInfirmaryRobohead", true);
			Entity_SetActive("AreaTunnelScare*", true);
			
			Entity_SetInteractionDisabled("DiveSuitArea",false);
			Entity_SetActive("ToolArea_ComputerBrain",true);
			Entity_SetActive("DiveSuitArea",true);
			
			SlideDoor_SetClosed("scanningroom_door",false,false);
			Lamp_SetLit("scanroom_lamp_*",true,true);
			CameraAnimation_Begin("SitAnim", "", false);
			Entity_PlaceAtEntity("Player", "SafePlayerArea");
		}
		
		if(alAction == eAction_Test2)
		{
			/////////////////////////////////////////////
			// Set up corpse crafting
			Entity_CallEntityInteract("StructureGelTool");
			Entity_CallEntityInteract("BrokenRobotBrain");
			Entity_CallEntityInteract("PowerCube_Inserted");
			mbMainPowerRestored = true;
			mbCorpseCrafted = false;
			mbCatherineInserted = true;
			mbDiveSuitTerminalUnlocked = true;
			mbAttemptedSuitActivation = true;
			
			Entity_SetInteractionDisabled("DiveSuitArea",false);
			Entity_SetActive("ToolArea_ComputerBrain",true);
			Entity_SetActive("DiveSuitArea",true);
			
			SwingDoor_SetOpenAmount("DiveLocker_Door",1.0f);
			
			Terminal_SetAllowInteraction("ContainmentComputer",true);
			
			/*Map_AddTimer("timer_cheat",1.0f,"TimerActivateCorpse");
			
			SwingDoor_SetOpenAmount("DiveLocker_Door",1.0f);
			Lamp_SetLit("diveroom_lamp_*",true,true);
			Lamp_SetLit("diveroom_sec2_lamp_*",true,true);
			Lamp_SetLit("diveprep_lockdown_lamp_*",false,true);
			Entity_SetActive("Area_PlaceCatherine",false);
			CathTool_Insert("CathTool_Placed","cath_terminal_1");
			Player_RemoveTool("CathTool");
			
			Player_Teleport("start_diveroom",true);
			
			Entity_SetInteractionDisabled("DiveSuitArea",false);
			Entity_SetActive("ToolArea_ComputerBrain",true);
			Entity_SetActive("DiveSuitArea",true);
			
			Entity_PlayAnimation("DivesuitCorpse","divesuit_opening",0.0f);
			Entity_PlayAnimation("DivesuitLocker","divesuit_opening",0.0f);
			
			CathTool_SetHintsEnabled("CathTool_Placed",true);
			CathTool_SetHintsCallback("CathTool_Placed","OnCathHints");*/
		}
		
		if (alAction == eAction_Test3)
		{
			/////////////////////////////////////////
			// Skip to scan puzzle
			mbMainPowerRestored = true;
			mbCorpseCrafted = true;
			mbCatherineInserted = true;
			mbDiveSuitTerminalUnlocked = true;
			mbAttemptedSuitActivation = true;
			mlPuzzleItemsGathered = 3;
			
			SlideDoor_SetClosed("scanningroom_door",false,false);
			SwingDoor_SetOpenAmount("DiveLocker_Door",1.0f);
			Lamp_SetLit("diveroom_lamp_*",true,true);
			Lamp_SetLit("diveroom_sec2_lamp_*",true,true);
			Lamp_SetLit("diveprep_lockdown_lamp_*",false,true);
			Entity_SetActive("Area_PlaceCatherine",false);
			CathTool_Insert("CathTool_Placed","cath_terminal_1");
			Player_RemoveTool("CathTool");
			
			BreakContainmentCube();			
			OpenShutters("", false);
			
			//Player_Teleport("start_infirmary",true);
			Player_Teleport("start_outside_infirmary",true);
		}
		
		if (alAction == eAction_Test4)
		{
			/*mbMainPowerRestored = true;
			SetLevelLockdownLights(false, "");
			OpenShutters("",true);
			SequenceContainmentLights("");*/
			
			/*float fOpen = SwingDoor_GetOpenAmount("DiveLocker_Door");
			cLux_AddDebugMessage(""+fOpen);
			
			Entity_CallEntityInteract("DiveSuitAreaActivate");*/
			
			//Voice_SetSource("Catherine", "Player", 2, 20, true, 20);
			
			//Entity_CallEntityInteract("CathTool_Placed");
			
			SlideDoor_SetClosed("scanningroom_door",false,false);
			Lamp_SetLit("scanroom_lamp_*",true,true);
			Terminal_SetGuiActive("TransferTerminal",true,0.25f);
		}
		
		if (alAction == eAction_Test5)
		{
				
			/////////////////////////////////////////////
			// Set up corpse crafting
			Entity_CallEntityInteract("StructureGelTool");
			Entity_CallEntityInteract("BrokenRobotBrain");
			Entity_CallEntityInteract("PowerCube_Inserted");
			mbMainPowerRestored = true;
			mbCorpseCrafted = false;
			mbCatherineInserted = true;
			mbDiveSuitTerminalUnlocked = true;
			mbAttemptedSuitActivation = true;
			
			SwingDoor_SetOpenAmount("DiveLocker_Door",0.9f);
			Lamp_SetLit("diveroom_lamp_*",true,true);
			Lamp_SetLit("diveroom_sec2_lamp_*",true,true);
			Lamp_SetLit("diveprep_lockdown_lamp_*",false,true);
			Entity_SetActive("Area_PlaceCatherine",false);
			CathTool_Insert("CathTool_Placed","cath_terminal_1");
			Player_RemoveTool("CathTool");
			
			Player_Teleport("start_diveroom",true);
			
			Entity_SetInteractionDisabled("DiveSuitArea",false);
			Entity_SetActive("ToolArea_ComputerBrain",true);
			Entity_SetActive("DiveSuitArea",true);
			
			Entity_PlayAnimation("DivesuitCorpse","divesuit_opening",0.0f);
			Entity_PlayAnimation("DivesuitLocker","divesuit_opening",0.0f);
			
			CathTool_SetHintsEnabled("CathTool_Placed",true);
			CathTool_SetHintsCallback("CathTool_Placed","OnCathHints");
		}
		//Transition testing
		if (alAction == eAction_Test6)
		{
			Tool_PickUp("CathTool_Placed",false,false);
			Player_Teleport("StartEndAirLock",true);
			SlideDoor_SetClosed("slidedoor_airlock_4",false,false);
			Preload();
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
		//	Sound_Stop("sfx_Tadpoletest",0.0f);
			//CameraAnimation_Begin("SuitWakeAnim","",true);
			//ScanComplete();
		}
		
		if (alAction == eAction_Test7)
		{
			cLux_AddDebugMessage("****************************************************");
			cLux_AddDebugMessage("****** SKIPPING DIALOGUE! USE THIS WISELY!!! *******");
			cLux_AddDebugMessage("****************************************************");
			Voice_SkipCurrentLine("General");
		}

		
		if (alAction == eAction_Test8)
		{
			cLux_AddDebugMessage("****** STOPPING ENTIRE DIALOGUE! USE THIS WISELY!!! *******");
			Voice_StopAll();
			/* STOP STEALING THIS DEBUG KEY! :P */
		}
		
		if(alAction == eAction_Test9)
		{
			//cLux_AddDebugMessage("YOU HAVE >>> NOT <<< DISCOVERED THE RADIO TRANSMISSION!!!");
			//mbRadioPlayedInSubstation = false;
			//BreakContainmentCube();
			//Entity_SetActive("agent_robothead_tunnelchase", false);
			
			/*SlideDoor_SetClosed("shutter_door_*", false);
			Button_SetLocked("easthallf1_doorpanel_*", false);
			Button_SetLocked("westhallf1_doorpanel_*", false);*/
			
			Player_SetHealth(0.3f);
			
			//cLux_AddDebugMessage("SET!!");
			//cLux_GetPlayer().SetVisibilityMaxRange(eVisibilityType_Area, -1);
			
			//Button_SetLocked("westhallf1_doorpanel_*"
			//BreakContainmentCube();
			
			//Entity_WakeUp("divesuit_monitor_1");
			//Voice_Play("3AEnterContainmentFirstTime");
		}
	}
	
