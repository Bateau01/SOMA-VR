	//-------------------------------------------------------
	
	void BrainOpticsSignal()
	{
		if (mbBrainEjected)
		{
			mbBrainOpticsSignal = false;
			return;
		}
		
		mbBrainOpticsSignal = true;
		Map_AddTimer("Timer_BrainOpticsSignal",0.1f,"TimerBrainOpticsSignal");
	}
	
	//------------------------------------------------------
	
	void TimerBrainOpticsSignal(const tString &in asTimer)
	{
		if (mbBrainOpticsSignal == false || mbBrainEjected)
		{
			Lamp_SetLit("robot_eye_*",false,true);
			return;
		}
		
		Lamp_SetLit("robot_eye_*",true,true);
		Map_AddTimer("Timer_BrainOpticsSignal",0.5f,"TimerBrainOpticsSignal");
	}
	
	//------------------------------------------------------
	
	void BrainMotorSignal()
	{
		cLux_AddDebugMessage("We get signal. Main motor turn on");
		mbBrainMotorSignal = true;
		if (mbBrainEjected) return;
		if (Map_TimerExists("timer_robotmotors")) return;
		Map_AddTimer("timer_robotmotors",0.2f,"TimerBrainMotorSignal");
	}
	
	//-------------------------------------------------------
	
	void BrainSpeechSignal()
	{
		mbBrainSpeechSignal = true;
		if (mbBrainEjected) return;
		if (Map_TimerExists("timer_robotspeech")) return;
		Map_AddTimer("timer_robotspeech",0.2f,"TimerBrainSpeechSignal");
	}
	
	//-------------------------------------------------------
		
	void TimerBrainMotorSignal(const tString &in asTimer)
	{
		///////////////////////////////////
		// Legs shall not wiggle if the brain is out or there is no signal to motors
		if (mbBrainMotorSignal == false || mbBrainEjected)
		{
			cLux_AddDebugMessage("Why? " + mbBrainMotorSignal + " " + mbBrainEjected);
			Entity_PlayAnimation("robot_arm","stop_spasm",0.1f,true,false,"");
			StopRobotRepairMotorSounds();
			return;
		}
		
		Map_AddTimer("timer_robotmotors",cMath_RandRectf(3.0f,5.0f),"TimerBrainMotorSignal");
		Entity_PlayAnimation("robot_arm","spasm",0.1f,true,true,"");
		
		PlayRobotRepairMotorSounds();
		cLux_AddTodoMessage("SCRIPT/ART: Final construct model with moving parts?");
	}
	
	//-------------------------------------------------------
	
	void TimerBrainSpeechSignal(const tString &in asTimer)
	{
		if (mbBrainSpeechSignal == false) return;
		if (mbBrainEjected) return;
		Map_AddTimer("timer_robotspeech",cMath_RandRectf(3.0f,5.0f),"TimerBrainSpeechSignal");
		
		PlayRobotRepairVoice();
	}

	//-------------------------------------------------------

	void EjectRobotBrain()
	{
		if (mbBrainEjected) return;
		
		SequenceEjectRobotBrain("");
		mbBrainEjected = true;
		Entity_SetInteractionDisabled("robotBrainHatch",true);
	}
	
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceEjectRobotBrain;
	void SequenceEjectRobotBrain(const tString &in asTimer)
	{
		Sequence_Begin("SequenceEjectRobotBrain", mSequenceEjectRobotBrain);
	
		if (Sequence_DoStepAndWait(0.5f))
		{
			cLux_AddTodoMessage("SOUND: Brain hatch opens...");
			Sound_CreateAtEntity("RobotPuzzleBeepEject", "Entities_Station/tech/terminal_beeps/robot_brain_puzzle/eject", "RobotPuzzleTerminalSoundSource");
			Sound_CreateAtEntity("RobotHatchOpen","03_02_omicron_inside/gameplay/robot_puzzle/brain_hatch_open","robotBrainHatch",0.0f,false,1.0f);
			Sound_CreateAtEntity("RobotBrainEject","03_02_omicron_inside/gameplay/robot_puzzle/brain_eject","robotBrainHatch",0.0f,false,1.0f);
			
			Prop_SetStaticPhysics("robotBrainHatch",false);
			Lever_SetStuckState("robotBrainHatch",0,true);
			Lever_SetAutoMoveEnabled("robotBrainHatch",true);
			
			Sound_Stop("RobotCry", 1.0f);
		}
		else if (Sequence_DoStepAndWait(0.5f))
		{
			Sound_Stop("soundHatchOpen",1.0f);
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			Prop_MoveLinearTo("robot_brain_stem","robot_brain_stem_popout",0.1f,0.2f,0.1f,false);
		}
		else if (Sequence_DoStepAndWait(0.5f))
		{
			Entity_SetInteractionDisabled("BrokenRobotBrain",false);
			mfRobotStaticTime = 0.5f;
		}
		
		Sequence_End();
	}

	//-------------------------------------------------------
	
	bool CollideRobotHatch(const tString &in asParent, const tString &in asChild, int alState)
	{
		Lever_SetStuckState("robot_front_plate",0,true);
		Lever_SetAutoMoveTarget("robot_front_plate",1);
		Lever_SetAutoMoveEnabled("robot_front_plate",true);
		Entity_SetInteractionDisabled("robot_front_plate",true);
		Entity_SetInteractionDisabled("BrokenRobotBrain",false);
		
		return false;
	}
	
	//-------------------------------------------------------
	
	void button_robot_send_OnConnectionStateChange(const tString &in asEntity, int alState)
	{
		if (alState == -1) return;
		
		/////////////////////////////////////////////
		// If player has already taken brain, just play the negative sound but dont explicitly say "nothing to do anymore"
		if (mbRobotBrainTaken)
		{
			Sound_CreateAtEntity("TerminalNegative", "Entities_Station/tech/terminal_beeps/pathOS_comp/pathOS_comp_negative", asEntity, 0.0f, false, 1.0f);
			return;
		}
		
		/////////////////////////////////////////////////////////////
		// Player sends signal from device to Robot to open the hatch
		int lVal = 0;
		
		if (Lamp_GetLit("robotLamp_1")) lVal += 1;
		if (Lamp_GetLit("robotLamp_2")) lVal += 2;
		if (Lamp_GetLit("robotLamp_3")) lVal += 4;
		if (Lamp_GetLit("robotLamp_4")) lVal += 8;
		if (Lamp_GetLit("robotLamp_5")) lVal += 16;
		if (Lamp_GetLit("robotLamp_6")) lVal += 32;
		
		if (lVal == 45)
		{
			cLux_AddDebugMessage("Correct!");
			Lever_SetStuckState("BrokenRobot",0,true);
			Lever_SetAutoMoveTarget("BrokenRobot",1);
			Lever_SetAutoMoveEnabled("BrokenRobot",true);
			Entity_SetInteractionDisabled("BrokenRobotBrain",false);
			Entity_SetActive("RobotBrainPickupArea",true);
			Entity_WakeUp("BrokenRobot");
			Sound_CreateAtEntity("TerminalAffirmative", "Entities_Station/tech/terminal_beeps/pathOS_comp/pathOS_comp_device_connect", asEntity, 0.0f, false, 1.0f);
			mbRobotBrainTaken = true;
			mbMusicSupressed = false;
		}
		else
		{
			cLux_AddDebugMessage("Wrong!");
			Sound_CreateAtEntity("TerminalNegative", "Entities_Station/tech/terminal_beeps/pathOS_comp/pathOS_comp_negative", asEntity, 0.0f, false, 1.0f);
		}
	}

	//-------------------------------------------------------
	bool mbRobotBrainPickupSound = false;
	bool BrokenRobotBrain_OnPickUp(const tString &in asTool)
	{
		//////////////////////////////////////////////
		// Play music and activate lower floor robot encounter
		mlPuzzleItemsGathered++;
		Music_Play("03_02_emptypack", 0.4f, false, eMusicPrio_BigEvent);
		Lamp_SetLit("lamp_brain_remove", false, false);
		
		Map_AddTimer("StartAmbient", cMath_RandRectf(8.0f,15.0f), "AmbientMusicHandler");
		Entity_SetActive("AreaRobotBrainPuzzleMusicControl", false);
		
		//////////////////////////////////////////////
		// Schedule line for having acquired brain
		Map_AddTimer("timer_gotbrain",1.5f,"TimerGotBrain");
		
		if(mbRobotBrainPickupSound==false)
		{
			mbRobotBrainPickupSound = true;
			Sound_CreateAtEntity("RobotBrainPickup", "03_02_omicron_inside/gameplay/robot_puzzle/brain_remove", "Player");
		}
		
		return true;
	}
	
