	//------------------------------------------------------
	
	bool DoLoadingWindow(const tString &in asName, const tString &in asCaption, const tString &in asText, float afLoadTime, bool abReset, float afZ=1.5f)
	{		
		StationGui_DialogBox_Start(asCaption, asText, cVector2f(0.6, 0.2), afZ);
			bool bDone = Depth_ImGui_LoadingGauge(asName, afLoadTime, abReset, ImGui_NrmPosGroup(cVector3f(0.1, 0.5, 1)), 
												  ImGui_NrmSizeGroup(cVector2f(0.8, 0.3)), StationGui_CreateDefaultGaugeData());
		StationGui_DialogBox_End();
		
		return bDone;
	}
	
	//-------------------------------------------------------
	
	void DoStatusGaugesHorizontal(int alCount, const cVector3f &in avNrmPos, const cVector2f &in avNrmSize, float afThicknessMul = 0.8, float afMinValue = 0.5, 
								  float afMaxValue = 1.0f, const cColor &in aFillColor = cColor(-1), const tString &in asPrefix = "Horizontal")
	{
		cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
		cVector2f vSize = ImGui_NrmSizeGroup(avNrmSize);
		vSize.y = (vSize.y/alCount) * afThicknessMul;
		cVector3f vOffsetPos = cVector3f(0, avNrmSize.y/alCount, 0);
		
		for (int i = 0; i < alCount; i++)
		{
			float fValue =  Depth_ImGui_GetOscillatingSignalValue(asPrefix, i, eEasing_QuadInOut, 0.0f, 1.0f);
		
			if (aFillColor.r==-1)
				gauge.mGfxFill.mColor = gStationGuiColor_Warning * (cMath_Clamp((0.5f-fValue)*2.0f,0.0,1.0f)) +
										gStationGuiColor_Highlight * (0.5f-cMath_Abs(0.5f-fValue))*2.0f + 
										cColor_White * (cMath_Clamp((fValue-0.5f)*2.0f,0.0f,1.0f));
			else
				gauge.mGfxFill.mColor = aFillColor;
			
			ImGui_DoGauge(gauge, afMinValue+fValue*(afMaxValue-afMinValue), ImGui_NrmPosGroup(avNrmPos + vOffsetPos*i), vSize);
		}
	}
	
	//-------------------------------------------------------
	
	void DoStatusGaugesVertical(int alCount, const cVector3f &in avNrmPos, const cVector2f &in avNrmSize, float afThicknessMul = 0.8, float afMinValue = 0.75, 
								float afMaxValue = 1.0f, const cColor &in aFillColor = cColor(-1), const tString &in asPrefix = "Vertical")
	{
		cImGuiGaugeData gauge = StationGui_CreateDefaultGaugeData();
		gauge.mOrientation = eImGuiGaugeOrientation_Vert;
		cVector2f vSize = ImGui_NrmSizeGroup(avNrmSize);
		vSize.x = (vSize.x/alCount) * afThicknessMul;
		cVector3f vOffsetPos = cVector3f(avNrmSize.x/alCount, 0, 0);
		
		for (int i = 0; i < alCount; i++)
		{
			float fValue =  Depth_ImGui_GetOscillatingSignalValue(asPrefix, i, eEasing_QuadInOut, 0.0f, 1.0f);
		
			if (aFillColor.r==-1)
				gauge.mGfxFill.mColor = gStationGuiColor_Warning * (cMath_Clamp((0.5f-fValue)*2.0f,0.0,1.0f)) +
										gStationGuiColor_Highlight * (0.5f-cMath_Abs(0.5f-fValue))*2.0f + 
										cColor_White * (cMath_Clamp((fValue-0.5f)*2.0f,0.0f,1.0f));
			else
				gauge.mGfxFill.mColor = aFillColor;
				
			ImGui_DoGauge(gauge, afMinValue+fValue*(afMaxValue-afMinValue), ImGui_NrmPosGroup(avNrmPos + vOffsetPos*i), vSize);
			
		}
	}

	//-------------------------------------------------------
	
	void DoRandomNumbers(int alColumns, int alRows, const cVector3f &in avNrmPos, const cVector2f &in avSpacing, int alFontSize = 2, 
						 int alMinValue = 100, int alMaxValue = 999, const tString &in asPrefix = "Number")
	{		
		for (int i = 0; i < alRows*alColumns; i++)
		{
			ImGui_DoLabel("" + int(Depth_ImGui_GetOscillatingSignalValue(asPrefix, i, eEasing_QuadInOut, alMinValue, alMaxValue)), 
						  ImGui_NrmPosGroup(avNrmPos + cVector3f(avSpacing.x*(i%alColumns), avSpacing.y*(i/alColumns), 0)), cVector2f_MinusOne, alFontSize);
		}
	}
	
	//--------------------------------------------------------
	
	///////////////////////////////
	// Terminal *ROSS TRANSMISSIONS*
	// Reusable function for Rosses burst transmissions on terminals
	//{////////////////////////////
	
	//--------------------------------------------------------
	
	int mlRossMessage = 0;
	int mlRossMessageBursts = 0;
	
	
	//--------------------------------------------------------
	
	void SetRossTerminalDistortionAreaActive(const tString &in asEntityName, bool abActive)
	{
		
		
		//////////////////////////////////
		// Toggle distortion area for this terminal if it exists, or show scripter an error so they add it! :)
		tString sDistortionArea = "DistortionArea_"+asEntityName;
		
		//////////////////////////////////
		// If timer already exists, do not enable the distortion area
		if (Map_TimerExists(sDistortionArea)) return;
		
		if (Entity_Exists(""+sDistortionArea))
		{
			Entity_SetActive(sDistortionArea, abActive);
		}
		else 
			cLux_AddTodoMessage("*ERROR* scripter : Place an -inactive- distortion area around this terminal called : " +""+sDistortionArea);
			
		///////////////////////////////////
		// If terminal is using the setting to not update when out of sight (most are) - force the distortion area to disable after a few seconds
		// in case this function does not have time to get called again (Internal terminal timer only runs when player is looking at Terminal)
		if (abActive && Map_TimerExists(sDistortionArea) == false)
		{
			Map_AddTimer(sDistortionArea,1.25f,"TimerForceTerminalDistortionOff");
		}
	}
	
	//--------------------------------------------------------
	
	void TimerForceTerminalDistortionOff(const tString &in asTimer)
	{
		Entity_SetActive(asTimer, false);
	}
	
	//--------------------------------------------------------
	
	void TerminalRossBurst(const tString &in asEntityName, float afTimeStep)
	{
		ImGui_SetModColorMul(cColor_White);
		
		///////////////////////////////////////////
		// Ross will 'speak' through this terminal after a random time (17.5 seconds by default)
		float fRossTime = ImGui_GetStateFloat("RossTime",0.0f);
		float fRossBurstTime = ImGui_GetStateFloat("RossNextBurst",17.5f);
		
		///////////////////////////////////////////
		// Blinking overrides bursts
		if (EyeTracking_IsEnvironmentReactive() && EyeTracking_HasPlayerBlinked() && fRossTime > 2.0f)
		{
			ImGui_SetStateFloat("RossNextBurst", 0.0f);
			fRossBurstTime = 0.0f;
		}
		
		ImGui_SetStateFloat("RossTime",fRossTime + afTimeStep);
		
		if (ImGui_GetStateFloat("RossTime",0.0f) > fRossBurstTime && ImGui_GetStateBool("RossCommunicated",false) == false)
		{
			ImGui_SetStateBool("RossCommunicated",true);
			cLux_AddTodoMessage("SOUND: Ross Communicates " + asEntityName);
			
			mlRossMessage++;
			if (mlRossMessage > 8) mlRossMessage = 1;
			
			SetRossTerminalDistortionAreaActive(asEntityName,true);
		}
		
		if (ImGui_GetStateFloat("RossTime",0.0f) > fRossBurstTime)
		{
			//cLux_AddDebugMessage("Interfering");
			TerminalRossInterference(asEntityName,afTimeStep);
		}
		
		
	}
	
	//--------------------------------------------------------
	
	void TerminalRossInterference(const tString&in asEntityName, float afTimeStep)
	{
		////////////////////////////////////////
		// Increment Timer
		float fRossInterferenceTime = ImGui_GetStateFloat("InterferenceTime",0.0f);
		ImGui_SetStateFloat("InterferenceTime",fRossInterferenceTime + afTimeStep);
		
		ImGui_SetTransCategory("03_02_omicron_inside");

		if (fRossInterferenceTime > 0.0f)
		{
			///////////////////////////////////////////
			// Display the static and play sound
			TerminalStatic(0.6f,asEntityName);			
			if (ImGui_GetStateBool("StaticBurstPlayed",false) == false)
			{
				Sound_CreateAtEntity("sfx_staticburst","03_02_omicron_inside/SFX/ross_message",asEntityName,0.0f,false,1.0f);
				ImGui_SetStateBool("StaticBurstPlayed",true);
			}
			
			cImGuiLabelData label;
			label.mFontAlign = eFontAlign_Center;
			label.mColorBase = cColor(1.0f,1.0f,1.0f,0.5f);
			ImGui_DoLabelExt("CreepyRossMessage_"+mlRossMessage, label, ImGui_NrmPosGroup(cVector3f(0.0f,0.0f,110.0f)), ImGui_NrmSizeGroup(cVector2f(1)), 2.0);
			
			//////////////////////////////////////////
			// Reset values for this terminal
			if (fRossInterferenceTime > .65f)
			{
				ImGui_SetStateBool("RossCommunicated",false);
				ImGui_SetStateBool("StaticBurstPlayed",false);
				ImGui_SetStateFloat("InterferenceTime",0.0f);
				ImGui_SetStateFloat("RossTime",0.0f);
				SetRossTerminalDistortionAreaActive(asEntityName,false);	

				// Randomize the next burst time
				ImGui_SetStateFloat("RossNextBurst",17.5f + cMath_RandRectf(7.25f,19.35f));
				mlRossMessageBursts++;
			}
			
		}
	}
	
	//-------------------------------------------------------
	
	//////////////////////////////////////////////
	// Comm Room Screens
	//////////////////////////////////////////////
	
	//-------------------------------------------------------
	
	void OnGuiCommRoomTerminal_1(const tString&in asEntityName, float afTimeStep)
	{
		if (mbCommRoomFlowerDrained)
		{
			OnGuiCommRoomTerminal_CreepyStatic(asEntityName,afTimeStep);
			return;
		}
		
		ImGui_SetTransCategory("");
		
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		ImGui_DoWindowStart("Status", window, ImGui_NrmPosGroup(cVector3f(0.025, 0.025, 3)), ImGui_NrmSizeGroup(cVector2f(0.95, 0.95)));
		
			DoStatusGaugesHorizontal(5, cVector3f(0.1, 0.1, 1), cVector2f(0.75, 0.525));
			DoStatusGaugesVertical(4, cVector3f(0.55, 0.7, 1), cVector2f(0.2, 0.19), 0.6, 0.3, 0.9);
			DoRandomNumbers(3, 2, cVector3f(0.15, 0.7, 1), cVector2f(0.1, 0.1), 2, 10, 99);
			
		ImGui_DoWindowEnd();
		
	}
	
	//-------------------------------------------------------
	
	void OnGuiCommRoomTerminal_2(const tString&in asEntityName, float afTimeStep)
	{
		if (mbCommRoomFlowerDrained)
		{
			OnGuiCommRoomTerminal_CreepyStatic(asEntityName,afTimeStep);
			return;
		}
		
		ImGui_SetTransCategory("");
		
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		ImGui_DoWindowStart("Status", window, ImGui_NrmPosGroup(cVector3f(0.025, 0.025, 3)), ImGui_NrmSizeGroup(cVector2f(0.95, 0.95)));
		
			DoStatusGaugesVertical(8, cVector3f(0.5, 0.1, 1), cVector2f(0.4, 0.3), 0.6, 0.3, 0.9);
			DoRandomNumbers(5, 2, cVector3f(0.2, 0.5, 1), cVector2f(0.15, 0.1));
							  
		ImGui_DoWindowEnd();
	}
	
	//-------------------------------------------------------
	
	void OnGuiCommRoomTerminal_CreepyStatic(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("");
		
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		StationGuiBG_OrnamentBottomLeft();
		StationGuiBG_OrnamentBottomRight();
		StationGuiBG_OrnamentTopRight();
		
		///////////////////////////////////////
		// Handle static timer
		float fCurrentStaticTime = ImGui_GetStateFloat("StaticTime",0.0f) + afTimeStep;
		float fCurrentStaticTimeMax = ImGui_GetStateFloat("StaticTimeMax",0.0f);
		
		//cLux_AddDebugMessage("Static time : " + fCurrentStaticTime);
		if (fCurrentStaticTime >= fCurrentStaticTimeMax)
		{
			ImGui_SetStateInt("RossMessage",cMath_RandRectl(1,8));
			ImGui_SetStateFloat("StaticTime", cMath_RandRectf(-0.3f,-0.1f));
			ImGui_SetStateFloat("StaticTimeMax", cMath_RandRectf(2.5f,4.5f));
			
			//////////////////
			// Audio - asEntityName will give you the terminal entity for sound source
			Sound_CreateAtEntity("sfx_camswitch","03_02_omicron_inside/SFX/ross_message",asEntityName,0.0f,false,0.2f);
		}
		else
		{
			ImGui_SetStateFloat("StaticTime", fCurrentStaticTime);
		}
		
		//////////////////////////////////////
		// When static timer is < 0.0f we see creepy messages
		if (fCurrentStaticTime < 0.0f)
		{
			ImGui_SetTransCategory("03_02_omicron_inside");
			int lRossMessage = ImGui_GetStateInt("RossMessage",1);
			tString rossMessage = "CreepyRossMessage_"+lRossMessage;
			
			cImGuiLabelData label;
			label.mFontAlign = eFontAlign_Center;
			
			cImGuiWindowData window = StationGui_CreateDefaultWindowData();
			ImGui_DoWindowStart("Status", window, ImGui_NrmPosGroup(cVector3f(0.1, 0.1, 3)), ImGui_NrmSizeGroup(cVector2f(0.8, 0.8)));
				ImGui_DoLabelExt(rossMessage,label,ImGui_NrmPosGroup(cVector3f(0.0,0,1)),ImGui_NrmSizeGroup(cVector2f(1)),4);
			ImGui_DoWindowEnd();
			
			return;
		}
		
		/////////////////////////////////////
		// When above, we just show the white static
		TerminalStatic();
	}
	
	void TerminalStatic(float afAlpha=1.0f, tString asEntity="")
	{	
		cVector2f vSize;
		cVector3f vPos=ImGui_NrmPosGroup(cVector3f(0.0f, 0.0f, 2.0f));
				
		cImGuiGfx imageGfx;
		if (ImGui_RepeatTimer("StaticIndex", 0.1))
		{
			ImGui_SetStateInt("StaticImageIndex", cMath_RandRectl(0, 1));
			ImGui_SetStateInt("AnimationRotation", cMath_RandRectl(0, 1));
		}
		imageGfx.SetFile("static_"+ImGui_GetStateInt("StaticImageIndex", 0));
		imageGfx.mColor = cColor(0.5f, 0.5f, 0.5f, afAlpha);
		vSize = ImGui_NrmSizeGroup(cVector2f(1.0, 1.0f));
					
		ImGui_SetModRotateAngle(ImGui_GetStateInt("AnimationRotation", 0)*180);
		
		
		ImGui_GroupBegin(vPos, vSize);
			ImGui_DoImage(imageGfx, cVector3f(0,0,100), ImGui_NrmSizeGroup(1));
		ImGui_GroupEnd();
		ImGui_SetModRotateAngle(0);
	}
	
