	bool CollideAreaHallFootsteps(const tString &in asParent, const tString &in asChild, int alState)
	{
		mfFlesherFootstepInterval = 0.4f;
		Map_AddTimer("timer_hallsteps",0.1f,"TimerFlesherHallFootsteps");
		
		return false;
	}
	
	//-------------------------------------------------------
	
	void TimerFlesherHallFootsteps(const tString &in asTimer)
	{
		
		////////////////////////////////////////
		// Each step is slightly quicker than the last
		if (mfFlesherFootstepInterval > mfFlesherFootstepMinInterval)
			mfFlesherFootstepInterval -= 0.1f;
			
		////////////////////////////////////////
		// Each step is slightly louder than the last
		if (mfFlesherFootstepVolume < 1.0)
			mfFlesherFootstepVolume += 0.1f;
		
		////////////////////////////////////////
		// Do Flesher Footsteps but dont get too close
		if (mlFlesherHallFootsteps < 8)
		{
			
			
			mlFlesherHallFootsteps++;
			tString sArea = "Area_Particle_FootstepsCorridor_"+mlFlesherHallFootsteps;
			ParticleSystem_CreateAtEntity("step"+mlFlesherFootstepCount,"mind_coral_goo_splash_small_oneshot.ps",sArea,true);
			ParticleSystem_CreateAtEntity("splash"+mlFlesherFootstepCount,"splash_oneshot_tiny.ps",sArea,true);
			
			cLux_AddTodoMessage("SOUND: Flesher Footsteps are heard..");
			Sound_CreateAtEntity("FlesherFootsteps",msFlesherFootstepSound,sArea,0.0f,false,mfFlesherFootstepVolume);
			
			////////////////////////
			// Flashes and effects
			if (mlFlesherHallFootsteps % 3 == 0)
			{
				mlIDFlesherShadowEffect = Effect_VideoDistortion_Start(0.8,0.5,0,0);
			
			}
			
			Map_AddTimer("timer_hallsteps",mfFlesherFootstepInterval,"TimerFlesherHallFootsteps");
		}
		
	}
	
