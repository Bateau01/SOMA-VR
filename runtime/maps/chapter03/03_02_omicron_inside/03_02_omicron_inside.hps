	//-------------------------------------------------------
	
	//////////////////////////////////////////////////////////////
	// Scene 3 - Event A2 - Containment cube begins to escalate in intensity
	//////////////////////////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbContainmentEscalation1 = false;
	bool mbContainmentEscalation2 = false;
	bool mbContainmentEscalation3 = false;
	
	int mlFlesherCubeDistortion = -1;
	
	//-------------------------------------------------------
	
	void HandleContainmentEscalation()
	{
		cLux_AddTodoMessage("SCRIPT: Things must begin to escalate.. cracking glass, effects and other bad things");
		
		if (mbContainmentCubeBroken)
		{
			// The containment cube is already broken
			return;
		}
		
		///////////////////////////
		// If we have all puzzle pieces, the cube will break 
		if (mlPuzzleItemsGathered >= 3)
		{
			Entity_SetActive("AreaBreakContainment*",true);
		}
		
		////////////////////////////////////
		// First level of tension
		if (mbContainmentEscalation1 == false)
		{
			cLux_AddTodoMessage("SCRIPT: ESCALATION EVENT #1 HERE");
			Entity_SetActive("AreaCubeScare*",true);
			SequenceFirstContainmentEvent("");
			mbContainmentEscalation1 = true;
			
			return;
		}
		
		////////////////////////////////////
		// Second level of tension
		if (mbContainmentEscalation2 == false)
		{
			/////////////////////////////////////////////
			// Player must be in the mid section for this
			//if (Entity_GetCollide("Player","AreaMid")==false) return;
			
			cLux_AddTodoMessage("SCRIPT: ESCALATION EVENT #2 HERE");
			SequenceSecondContainmentEvent("");
			mbContainmentEscalation2 = true;
			return;
		}
		
		////////////////////////////////////
		// Third level of tension
		if (mbContainmentEscalation3 == false)
		{
			///////////////////////////////////
			// Ross speaks as the cube breaks
			Map_AddTimer("RossSpeaksCubeBreak", 5.0f, "RossSpeaksCubeBreak");
			mbContainmentEscalation3 = true;
			
			SequenceThirdContainmentEvent("");
			Sound_CreateAtEntity("EscalationEvent3Eerie", "03_02_omicron_inside/SFX/escalation/escalation_event_03_eerie", "Player");
			return;
		}
	}
	
	void RossSpeaksCubeBreak(const tString &in asTimer)
	{
		Voice_Play("3AEnterContainmentCubeBreaks");
	}
	
	//-------------------------------------------------------
	
	//////////////////////////////////////////////////////////////
	// Scene 3 - Event A3 - Containment cube escalation #1
	//////////////////////////////////////////////////////////////
	
	//-------------------------------------------------------
	
	int mlCubeGlassImpacts = 0;
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceFirstContainmentEvent;
	void SequenceFirstContainmentEvent(const tString &in asTimer)
	{
		Sequence_Begin("SequenceFirstContainmentEvent", mSequenceFirstContainmentEvent);
			
		if (Sequence_DoStepAndWait(1.0))
		{
			Sound_CreateAtEntity("EscalationEvent1", "03_02_omicron_inside/SFX/escalation/escalation_event_01", "Player");
			Map_AddTimer("Timer_EscalationEvent1Music", 2.0f, "EscalationEvent1Music");
			//cSound_FadeHighPassFilter(7000.00, 0.5f, 3.0f, eSoundEntryType_World);
			Sound_FadeGlobalVolume(0.55f, 3.0f, eSoundEntryType_World);
			Map_AddTimer("Timer_EscalationEventComplete", 4.0f, "EscalationEventComplete");
			
			Lamp_SetFlickerActive("corridor_amb_lights_*",true);
			mlFlesherCubeDistortion = Effect_VideoDistortion_Start(0.2f,5.25f,0.0f,0.2f);
		}
		
		else if (Sequence_DoStepWaitAndRepeat(mlContainmentLightEnd,0.25f))
		{
			Lamp_SetFlickerActive("ContainmentLamp_"+mlContainmentLight,true);
			
			if (mlContainmentLight < mlContainmentLightEnd)
			{
				mlContainmentLight++;
			}
			
			int lRandomLight = cMath_RandRectl(mlContainmentLightStart,mlContainmentLightEnd);
			Lamp_SetFlickerActive("ContainmentLamp_"+lRandomLight,false);
		}
		else if (Sequence_DoStepAndWait(7.5))
		{
			
		}
		else if (Sequence_DoStepWaitAndRepeat(mlContainmentLightEnd,0.15f))
		{
			Lamp_SetFlickerActive("corridor_amb_lights_*",false);
			if (mlContainmentLight > 0)
			{
				Lamp_SetFlickerActive("ContainmentLamp_"+mlContainmentLight,false);
				mlContainmentLight--;
			}
		}
		else if (Sequence_DoStepAndWait(0.0f))
		{
			Entity_SetActive("AreaCubeScareLookAt",true);
		}
		
		Sequence_End();
	}
	
	void EscalationEventComplete(const tString &in asTimer)
	{
		//cSound_FadeHighPassFilter(0.0f, 0.0f, 5.0f, eSoundEntryType_World);
		Sound_FadeGlobalVolume(1.0f, 5.0f, eSoundEntryType_World);
		Depth_Audio_Fear_MediumIntensity();
	}
	
	void EscalationEvent1Music(const tString &in asTimer)
	{
		Music_Play("03_02_flesherspook05", 0.35f, false, eMusicPrio_BigEvent);
	}
	
	//-------------------------------------------------------
	
	//////////////////////////////////////////////////////////////
	// Scene 3 - Event A4 - Containment cube escalation #2
	//////////////////////////////////////////////////////////////
	
	//-------------------------------------------------------
	
	
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceSecondContainmentEvent;
	void SequenceSecondContainmentEvent(const tString &in asTimer)
	{
		Sequence_Begin("SequenceSecondContainmentEvent", mSequenceSecondContainmentEvent);
		
		if (Sequence_DoStepAndWait(1.25))	
		{
			//cSound_FadeHighPassFilter(7000.00, 0.5f, 3.0f, eSoundEntryType_World);
			Sound_FadeGlobalVolume(0.55f, 3.0f, eSoundEntryType_World);
			Sound_CreateAtEntity("SecondEscalationGlass","03_02_omicron_inside/SFX/escalation/escalation_event_02_glass","Area_FlesherContainmentSounds",0.0,false,1.0f);
			Sound_CreateAtEntity("SecondEscalationGlass","03_02_omicron_inside/SFX/escalation/escalation_event_02_eerie","Player",0.0,false,1.0f);
			Map_AddTimer("Timer_EscalationEventComplete", 6.0f, "EscalationEventComplete");
		}
		else if (Sequence_DoStepAndWait(3.25))
		{
			Lamp_SetFlickerActive("corridor_amb_lights_*",true);
			Lamp_SetFlickerActive("ContainmentLamp_*",true);
			
		}
		else if (Sequence_DoStepAndWait(0.1f))
		{
			
		}
		else if (Sequence_DoStepWaitAndRepeat(2,2.75f))
		{
			if (mbContainmentCubeBroken == false)
			{
				Entity_SetActive("containmentcube_glass_*",false);
				Entity_SetActive("containmentcube_glass_cracked",true);
			}
			
			mlFlesherCubeDistortion = Effect_VideoDistortion_Start(0.5f,2.25f,0.0f,0.2f);
			
			mlCubeGlassImpacts++;
			if (mlCubeGlassImpacts == 1)
			{
				Music_Play(gsGlassHitStinger,0.25f,false,eMusicPrio_BigEvent);
			}
		}
		else if (Sequence_DoStepAndWait(2.15f))
		{
			Lamp_SetFlickerActive("corridor_amb_lights_*",false);
			Lamp_SetFlickerActive("ContainmentLamp_*",false);
		}
		else if (Sequence_DoStepAndWait(1.0f))
		{
			mlFlesherCubeDistortion = Effect_VideoDistortion_Start(0.8f,3.25f,0.0f,0.2f);
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	//////////////////////////////////////////////////////////////
	// Scene 3 - Event A5 - Containment cube escalation #3
	//////////////////////////////////////////////////////////////
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceThirdContainmentEvent;
	void SequenceThirdContainmentEvent(const tString &in asTimer)
	{
		Sequence_Begin("SequenceThirdContainmentEvent", mSequenceThirdContainmentEvent);
			
		if (Sequence_DoStepAndWait(1.0))
		{
			
			Lamp_SetFlickerActive("corridor_amb_lights_*",true);
		}
		else if (Sequence_DoStepAndWait(2.0))
		{
			Sound_CreateAtEntity("FlesherScream",gsFlesherAngryScream,"Area_FlesherContainmentSounds",0.0,false,1.0f);
			mlFlesherCubeDistortion = Effect_VideoDistortion_Start(0.8f,3.25f,0.0f,0.2f);
			Entity_SetActive("CubeShadow",false);
			CollideBreakContainment("","",1);
		}
		else if (Sequence_DoStepAndWait(7.5))
		{
			
		}
		else if (Sequence_DoStepWaitAndRepeat(mlContainmentLightEnd,0.15f))
		{
			Lamp_SetFlickerActive("corridor_amb_lights_*",false);
			if (mlContainmentLight > 0)
			{
				Lamp_SetFlickerActive("ContainmentLamp_"+mlContainmentLight,false);
				mlContainmentLight--;
			}
		}
		
		Sequence_End();
	}

	//-------------------------------------------------------
	
	////////////////////////////////////////////////
	// Scene 3 - Event B - Interact with security panel and turn off shutdown mode
	////////////////////////////////////////////////
	
	//-------------------------------------------------------
	
	int mlContainmentLightStart = 1;
	int mlContainmentLightEnd = 20;
	int mlContainmentLight = 1;
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceContainmentLights;
	void SequenceContainmentLights(const tString &in asTimer)
	{
		Sequence_Begin("SequenceContainmentLights", mSequenceContainmentLights);
			
		if (Sequence_DoStepAndWait(1.0))
		{
			///////////////////////////////////////////
			// Disable the black fog inside
			FogArea_SetVisible("ContainmentFog",false);
			Lamp_SetLit("containment_cube_spot_*", false, false);
			
			
		}
		else if (Sequence_DoStepWaitAndRepeat(mlContainmentLightEnd,0.25f))
		{
			Lamp_SetLit("ContainmentLamp_"+mlContainmentLight,true,true);
			Lamp_SetFlickerActive("ContainmentLamp_"+mlContainmentLight,true);
			
			if (mlContainmentLight < mlContainmentLightEnd)
			{
				mlContainmentLight++;
			}
			
			int lRandomLight = cMath_RandRectl(mlContainmentLightStart,mlContainmentLightEnd);
			Lamp_SetFlickerActive("ContainmentLamp_"+lRandomLight,false);
		}
		else if (Sequence_DoStepAndWait(0.15))
		{
			
		}
		else if (Sequence_DoStepWaitAndRepeat(mlContainmentLightEnd,0.15f))
		{
			if (mlContainmentLight > 0)
			{
				Lamp_SetFlickerActive("ContainmentLamp_"+mlContainmentLight,false);
				mlContainmentLight--;
			}
		}
		
		Sequence_End();
	}
	
