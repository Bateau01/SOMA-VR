	void MoveTo_ScanHelmet(const tString &in asProp)
	{
		Effect_Fade_Out(2.0f);
		Map_AddTimer("timer_removehelmet",2.5f,"TimerRemoveHelmet");
		
		cLux_AddTodoMessage("SOUND: Helmet moves to face");
		Prop_MoveLinearTo("chair_scan_moving", "chair_scan_end_1", 1, 1, 0.25, true, "MoveTo_ScanHelmet");	
		
	}
	
	//-------------------------------------------------------
	
	void TimerRemoveHelmet(const tString &in asTimer)
	{
		Effect_Fade_In(5.0f);
		Entity_SetActive("chair_scan_moving",false);
		Player_FadeFOVMulTo(0.75f, 0);
		
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceScan;
	void SequenceScan(const tString &in asName)
	{
		Sequence_Begin("SequenceScan", mSequenceScan);
		
		///////////////////////////
		// Initial Delay
		if (Sequence_DoStepAndWait(5.0f))
		{
			// Turn off flashlight
			Player_SetFlashlightActive(false,true);
			
			//////////////////////////////////////
			// Terminal resets after scan
			mbScanParametersLocked = false;
			mlSeatReminders = 1;
			
			//////////////////////////////////////
			// Display scanning effect
			mlid_Vignette = Effect_Screen_Start("vignette_screen.mat", cVector2f(0.5,0.5), cVector2f(1.4,1.0f), 1.0, 1.0, 900.0, 0.1);
			mlid_ScanLines = Effect_Screen_Start("00_04_scan_noise.mat", cVector2f(0.5, 0.5), cVector2f(2,1),  1, 0.1, 900, 0.1);
			
			Effect_ChromaticAberration_StartAnim(4.0f,0.005,0.005,cVector2f_Zero);
			
			Effect_ImageTrail_Start(0.08,0.1,4.0,1.0);
			
			//////////////////////////////////////
			//Sound
			Sound_FadeGlobalVolume(0.1f, 5.0f, eSoundEntryType_WorldAll);
			//cSound_FadeLowPassFilter(500.0, 0.55f, 5.0f, eSoundEntryType_WorldAll);
			if (mbScanWillSucceed)
			{
				cLux_AddDebugMessage("Success scan sound triggered");
				Sound_PlayGui("Entities_Special/Equipment/scanner/omicron/omicron_scan_seq_success", 1.0);
			}
			else
			{
				cLux_AddDebugMessage("Fail scan sound triggered");
				Sound_PlayGui("Entities_Special/Equipment/scanner/omicron/omicron_scan_seq_fail", 1.0);
			}
		}

		if (Sequence_DoStepAndWait(0.5f))
		{
			//////////////////////
			// Turn off Distortion effects
			Effect_Screen_FadeOut(mlid_Vignette,0.0);
			Effect_Screen_FadeOut(mlid_ScanLines,0.0);
			//Player_FadeFOVMulTo(2.5f, 1.0f);
			Effect_Flash_Start(0.5f, 0.75, 0.5);
			Effect_Rumble_Start(0.9, 0.7, 0.25f);
			Effect_Shake_Start(0.08,0.65,0,0.1);
			
			//////////////////////////
			// Flash sound
			Sound_FadeGlobalVolume(0, 0.15, eSoundEntryType_World);
		}
		
		//////////////////////////////////
		// Fade to black and restore FOV
		if(Sequence_DoStepAndWait(0.0f))
		{
			Effect_Screen_FadeOut(mlid_ScanLines,0);
			Effect_RadialBlur_FadeOut(mlid_RadialBlur,12.0);
			Player_FadeFOVMulTo(1.0f, 0.3f);
			
			if (mbScanWillSucceed)
			{
				///////////////////////////
				// Reset values
				CameraAnimation_End();
				Player_ChangeStateToNormal();
				Player_SetLookSpeedMul(0.6);
				Player_SetMoveSpeedMul(0.0);
			
				/////////////////////////
				// Kick off post scan dialog and events
				ScanComplete();
			}
			else
			{
				////////////////////////////
				// Scan failed
				Map_AddTimer("timer_scanaborted",3.0f,"TimerScanAborted");
				
				///////////////////////////
				// Sound
				Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_WorldAll);
				//cSound_FadeLowPassFilter(22000, 0.0f, 3.0f, eSoundEntryType_WorldAll);
			}
		}

		Sequence_End();
	}
	
