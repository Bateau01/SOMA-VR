	//-------------------------------------------------------
	
	bool mbDiveRoomEntered = false;
	
	//-------------------------------------------------------
	
	bool CollideEnterDiveroom(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
			Terminal_SetUpdateWhenOutOfView("DivesuitTerminal", true);
			
		return true;
	}
	
	//-------------------------------------------------------
	
	bool CollideLeaveDiveroom(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
			Terminal_SetUpdateWhenOutOfView("DivesuitTerminal", false);
			
		return true;
	}
	
	//-------------------------------------------------------

	bool CollideLockDiveRoom(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		if (mbDiveRoomEntered) return false;
		
		cLux_AddDebugMessage("Entered dive room " + mbDiveRoomEntered);
		
		///////////////////////////////////
		// Flesher causes the door to lock sealing the player in here
		Button_SetLocked("diveroom_doorpanel_*", true);
		Entity_CallEntityInteract("diveroom_doorpanel_2");
		Entity_SetActive("FinalDoorBlocker_*",true);
		
		mbDiveRoomEntered = true;
		
		///////////////////////////////////
		// The lights go out!
		Music_Stop(1.0f, eMusicPrio_BigEvent);
		if(mbCubeMusicStartActive==true)
		{
			Music_Stop(1.0f, eMusicPrio_BigEvent);
			mbCubeMusicStartActive = false;
		}
		Sound_FadeGlobalVolume(0.25f, 0.15f, eSoundEntryType_WorldAll);
		Sound_CreateAtEntity("DiveRoomLightsOut", "03_02_omicron_inside/SFX/diving_room_power_down_weird", "Player");
		Map_AddTimer("DiveRoomLightsOut", 0.7f, "DiveRoomLightsOut");

		return false;
	}
	
	void DiveRoomLightsOut(const tString &in asTimer)
	{
		Lamp_SetLit("diveprep_lockdown_lamp_*",false,true);
		SlideDoor_SetClosed("diveroom_door",true,false);
		Sound_FadeGlobalVolume(1.0f, 8.0f, eSoundEntryType_WorldAll);
		Music_Play("03_02_flesherspook04", 0.25f, false, eMusicPrio_BigEvent);
		Map_AddTimer("Timer_DiveRoomSpookyWhispers", cMath_RandRectf(6,12), "DiveRoomSpookyWhispers");
	}
	
	void DiveRoomSpookyWhispers(const tString &in asTimer)
	{
		Sound_CreateAtEntity("DiveRoomWhispers", "03_02_omicron_inside/AMB/spot/whispers", "SpookyWhispersSoundSource");
		Map_AddTimer("Timer_DiveRoomSpookyWhispers", cMath_RandRectf(6,12), "DiveRoomSpookyWhispers");
	}
	
