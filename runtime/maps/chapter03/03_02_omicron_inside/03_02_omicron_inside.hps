	///////////////////////////////
	
	//--------------------------------------------------------
	
	void terminal_raleigh_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		if (mbScanComplete) return;
		if (mbRaleighTerminalActive == false) return;
		
		float fInitialTimer = ImGui_GetStateFloat("InitialStatic",0.0f);
		if (fInitialTimer < 4.0f)
		{
			fInitialTimer += afTimeStep;
			ImGui_SetStateFloat("InitialStatic",fInitialTimer);
			TerminalStatic(1.0f,asEntityName);
			return;
		}
		
		cImGuiLabelData header;
		header.mColorBase = cColor(0.15,0.75,0.75,1.0);
		header.mFontAlign = eFontAlign_Right;
		
		//StationGuiBG_Backdrop();
		StationGuiBG_OrnamentBottomLeft();
		StationGuiBG_Scanlines();
		
		ImGui_DoWindowStart("", StationGui_CreateDefaultWindowData(), ImGui_NrmPosGroup(0.025, 0.3, 1), ImGui_NrmSizeGroup(0.4, 0.65));
			cImGuiGfx gfxHerberFace("foto_herber.dds", eImGuiGfx_Texture);
			ImGui_DoImage(gfxHerberFace, ImGui_NrmPos(cVector3f(0.025f,-0.125f,100.0f)), ImGui_NrmSize(cVector2f(0.5f,0.7f)));
		ImGui_DoWindowEnd();
		
		ImGui_DoWindowStart("", StationGui_CreateDefaultWindowData(), ImGui_NrmPosGroup(0.025, 0.025, 1), ImGui_NrmSizeGroup(0.95, 0.25));
		ImGui_DoWindowEnd();
		
		ImGui_SetTransCategory("03_02_omicron_inside");
			ImGui_DoLabelExt("HerberSuitScreenName",header,ImGui_NrmPos(cVector3f(0.9,0.1,102.0f)),cVector2f(1.0f,1.0f),2.75f);
			ImGui_DoLabelExt("HerberSuitScreenRank",header,ImGui_NrmPos(cVector3f(0.9,0.2,102.0f)),cVector2f(1.0f,1.0f),2.5f);
		
		ImGui_DoWindowStart("", StationGui_CreateDefaultWindowData(), ImGui_NrmPosGroup(0.45, 0.3, 1), ImGui_NrmSizeGroup(0.525, 0.65));
		ImGui_DoWindowEnd();
		
		DisplayXRayAnimation(afTimeStep, ImGui_NrmPos(cVector3f(0.46,0.4,10.0f)));
	}

