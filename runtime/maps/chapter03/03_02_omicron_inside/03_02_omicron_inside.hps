	bool CollideFinalPowerLights(const tString &in asParent, const tString &in asChild, int alState)
	{
		/////////////////////////////////////
		// The last lights in here go out to put the player in darkness for this encounter
		Lamp_SetFlickerActive("*amb_lights_pwr_*",false);
		Lamp_SetLit("*amb_lights_pwr_*",false,true);
		
		return false;
	}
	
