	// MAIN FUNCTIONS
	// ==============
	//{//////////////////////////////////////

	//-------------------------------------------------------

	bool mbRadioPlayedInSubstation = false;
	int mlCorpseDataminesHeard = 0;
	
	bool mbLockdownLifted = false;
	bool mbCatherineInserted = false;
	int mlPuzzleItemsGathered = 0;
	int mlFlesherLine = 0;
	
	bool mbPlayerFoundBrain = false;
	bool mbPlayerFoundChip = false;
	bool mbPlayerFoundPowerRoom = false;
	bool mbPlayerFoundRobotRoom = false;
	bool mbPlayerFoundBioMech = false;
	bool mbBrainEjected = false;
	bool mbPlayerNotifiedAllItems = false;
	
	bool mbPlayerHasUnchargedPack = false;
	bool mbPlayerHasChargedPack = false;

	bool mbSavedBeforeCubeBreak = false;
	
	//-------------------------------------------------------
	
	bool CollideAreaAutoSave(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		cLux_AddDebugMessage("Auto Save");
		Game_AutoSave();
		
		return false;
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaSaveAllItems(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		if (mlPuzzleItemsGathered < 3) return true;
		if (mbSavedBeforeCubeBreak) return false;
		
		mbSavedBeforeCubeBreak = true;
		CheckPoint_Setup("Checkpoint_RobotHead");
		return false;
	}
	
	//-------------------------------------------------------
	
	
	bool CollideFoundPuzzleItem(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		tString sItem = Entity_GetVarString(asChild,"");
		cLux_AddDebugMessage("found puzzle item/area : " + sItem);
		
		if (sItem == "Brain")
			mbPlayerFoundBrain = true;
			
		if (sItem == "PowerRoom")
			mbPlayerFoundPowerRoom = true;
			
		if (sItem == "SecurityChip")
			mbPlayerFoundChip = true;
			
		return true;
	}
	
	//-------------------------------------------------------
	
	void GotPuzzleItem()
	{
		///////////////////////////////////////////////////////////////////////
		// The flesher that speaks to the player starts on a different line of 
		// conversation when a puzzle item is gathered
		mlFlesherLine = 0;
		mlPuzzleItemsGathered++;
		mlAmbientStage++;
	
	}
	
	//-------------------------------------------------------
	
	bool CollideAreaNotifyAllPuzzlePieces(const tString &in asParent, const tString &in asChild, int alState)
	{
		///////////////////////////////////////////////
		// When leaving puzzle areas, Catherine talks to player and says to return if player has all items
		if (mbPlayerNotifiedAllItems) return false;
		if (mlPuzzleItemsGathered < 3) return true;
		
		//Voice_PlayWhenPossible("YouHaveAllThings");
		
		mbPlayerNotifiedAllItems = true;
		
		return true;
	}
	
	//-------------------------------------------------------

	void SetupLights()
	{
		SetLevelLockdownLights(true, "");
		
		for (int i = 1; Entity_Exists("chargerIndicator_"+i); i++)
			Lamp_SetLit("chargerIndicator_"+i,false,true);
		
		//////////////////////////////////
		// Exit airlock lights
		Entity_FadeEffectBaseColor("exit_airlock_lamp_1", cColor(1,0.515,0.055,1), 1);
		Entity_FadeEffectBaseColor("exit_airlock_lamp_2", cColor(1,0.515,0.055,1), 1);
		Entity_FadeEffectBaseColor("exit_airlock_lamp_3", cColor(1,0.515,0.055,1), 1);
		Entity_FadeEffectBaseColor("exit_airlock_lamp_4", cColor(1,0.515,0.055,1), 1);
		
		//////////////////////////////////
		// Power room lights
		//Light_SetVisible("PowerRoom_FakeLight_*",false);
		for (int i = 1; i <= 40; i++)
		{
			if (Entity_Exists("corridor_amb_lights_pwr_"+i))
				Lamp_SetLit("corridor_amb_lights_pwr_"+i,true,true);
		}
		
		//////////////////////////////////
		// Dive room flashing light
		Map_AddTimer("timer_diveroomcathlamp",1.0f,"TimerDiveroomCathLamp");
	}
	
	//-------------------------------------------------------
	
	void SetupFlesherEvents()
	{
		Entity_SetActive("AreaCubeScare*",false);
		
		// We do not want Ross to be visible until we walk in to containment
		RossCube_ForceInvisible("CubeShadow",true);
	}
	
	//-------------------------------------------------------
	
	void TimerFadeIn(const tString &in asTimer)
	{
		Effect_Fade_In(5.0f);
	}
	
	//-------------------------------------------------------
	bool mbMidSectionLockdownReleased = false; 
	
	void SetLevelLockdownLights(bool abLockdownActive, const tString &in asTag)
	{
		
		///////////////////////////////////
		// If no tag given, toggle all ambient corridor lights
		bool bAllLights = asTag == "" ? true : false;
		if (bAllLights)
		{
			Lamp_SetLit("corridor_amb_lights_*",!abLockdownActive,true);
			Lamp_SetLit("corridor_lockdown_lights_*",abLockdownActive,true);
			SetLevelLockdownLights(abLockdownActive,"DivePrep");
		}
		
		////////////////////////////////////
		// Special for Lights Out event
		bool bLightsOut = asTag == "FLESHEREVENT" ? true : false;
		if (bLightsOut)
		{
			Lamp_SetLit("corridor_amb_lights_*",false,true);
			Lamp_SetLit("corridor_lockdown_lights_*",false,true);
			Lamp_SetLit("*corridor_amb_lights_*North",false,true);
			Lamp_SetLit("*corridor_lockdown_lights_*North",false,true);
			Lamp_SetLit("*corridor_amb_lights_*South",false,true);
			Lamp_SetLit("*corridor_lockdown_lights_*South",false,true);
			Lamp_SetLit("*corridor_amb_lights_*mid",false,true);
			Lamp_SetLit("*corridor_lockdown_lights_*mid",false,true);
			Lamp_SetLit("*corridor_amb_lights_*upper",false,true);
			Lamp_SetLit("*corridor_lockdown_lights_*upper",false,true);
			Lamp_SetLit("*corridor_amb_lights_*lower",false,true);
			Lamp_SetLit("*corridor_lockdown_lights_*lower",false,true);
			Lamp_SetLit("medicbay_lockdown_lights_*",false,true);
			Lamp_SetLit("medical_lamp*",false,true);
			Lamp_SetLit("pressurechamber_lamp_*",false,true);
			//Lamp_SetLit("medicbay_cleanroom_lamp_*",false,true);
			Lamp_SetLit("medicbay_cleanroom_lockdown_lamp_*",false,true);
			Lamp_SetLit("dive_prep_lamp_*",false,true);
			Lamp_SetLit("diveprep_lockdown_lamp_*",false,true);
			Lamp_SetLit("ContainmentLamp_*",false,true);
			Lamp_SetLit("containment_cube_spot_*",false,true);
			Lamp_SetLit("diveroom_tunnel_under_lamp_*",false,true);
			return;
		}
		
		//////////////////////////
		// Containment Mid Section Lights
		if (asTag == "MainSecurity")
		{
			Lamp_SetLit("*corridor_amb_lights_*mid",!abLockdownActive,true);
			Lamp_SetLit("*corridor_lockdown_lights_*mid",abLockdownActive,true);
			///////////////////////////
		// South Corridor Lights
			Lamp_SetLit("*corridor_amb_lights_*South",!abLockdownActive,true);
			Lamp_SetLit("*corridor_lockdown_lights_*South",abLockdownActive,true);
			///////////////////////////
			// North Corridor Lights
			Lamp_SetLit("*corridor_amb_lights_*North",!abLockdownActive,true);
			Lamp_SetLit("*corridor_lockdown_lights_*North",abLockdownActive,true);
			/////////////////////////
			//Play sound and drop mix quickly for oomph
			Sound_CreateAtEntity("LockdownLiftedMidsection", "03_02_omicron_inside/SFX/lockdown_release/midsection", "Player", 0.0f, false, 1.0f);
			Sound_FadeGlobalVolume(0.5f, 0.05f, eSoundEntryType_World);
			Map_AddTimer("LockdownMixerOver", 0.5, "LiftLockdownMix");
			mbMidSectionLockdownReleased = true;
			
			
		}
		
		//////////////////////////
		// Containment Upper Section Lights
		if (asTag == "UpperSecurity")
		{
			Lamp_SetLit("*corridor_amb_lights_*upper",!abLockdownActive,true);
			Lamp_SetLit("*corridor_lockdown_lights_*upper",abLockdownActive,true);
			
			////////////////////////
			//Play sound and drop mix quickly for oomph
			Sound_CreateAtEntity("LockdownLiftedUppersection", "03_02_omicron_inside/SFX/lockdown_release/upper", "Player", 0.0f, false, 1.0f);
			Sound_FadeGlobalVolume(0.5f, 0.05f, eSoundEntryType_World);
			Map_AddTimer("LockdownMixerOver", 0.5, "LiftLockdownMix");
		}
		
		//////////////////////////
		// Containment Lower Section Lights
		if (asTag == "LowerSecurity")
		{
			Lamp_SetLit("*corridor_amb_lights_*lower",!abLockdownActive,true);
			Lamp_SetLit("*corridor_lockdown_lights_*lower",abLockdownActive,true);
			
			////////////////////////
			//Play sound and drop mix quickly for oomph
			Sound_CreateAtEntity("LockdownLiftedUppersection", "03_02_omicron_inside/SFX/lockdown_release/lower", "Player", 0.0f, false, 1.0f);
			Sound_FadeGlobalVolume(0.5f, 0.05f, eSoundEntryType_World);
			Map_AddTimer("LockdownMixerOver", 0.5, "LiftLockdownMix");
		}

		//////////////////////////////////
		// Medical Bay Lights
		if (asTag == "DivePrep")
		{
			Lamp_SetLit("medicbay_lockdown_lights_*",abLockdownActive,true);
			Lamp_SetLit("medical_lamp*",!abLockdownActive,true);
			Lamp_SetLit("pressurechamber_lamp_*",!abLockdownActive,true);
			
			Lamp_SetLit("medicbay_cleanroom_lamp_*",!abLockdownActive,true);
			Lamp_SetLit("medicbay_cleanroom_lockdown_lamp_*",abLockdownActive,true);
			
			Lamp_SetLit("dive_prep_lamp_*",!abLockdownActive,true);
			Lamp_SetLit("diveprep_lockdown_lamp_*",abLockdownActive,true);		
			
			//////////////////////////////////
			// Switch lights specific to the dive room walk tunnel
			Lamp_SetLit("tunnel_warning_light*",abLockdownActive,true);
			Lamp_SetLit("tunnel_lamp*",!abLockdownActive,true);
			Lamp_SetLit("diveroom_tunnel_under_lamp_*",!abLockdownActive,true);
			
			/////////////////////////////////
			// Dive Room
			Light_SetVisible("PointLight_DiveRoomAmbient_*",!abLockdownActive);
			Lamp_SetLit("diveroom_lamp_*",!abLockdownActive,true);
		}
			
		
	}
							
	//--------------------------------------------------
	
	void OpenShutters(const tString &in asTag, bool abPlayMusic)
	{
		/////////////////////////////////////
		// Remove lockdown on shutters and buttons with matching suffix
		cLux_AddDebugMessage("*shutter_door*"+asTag);
		SlideDoor_SetClosed("*shutter_door*"+asTag,false,false);
		Button_SetLocked("*_lockdown*"+asTag,false);
		
		/////////////////////////////////////
		// activate fish outside infirmary window
		Entity_SetActive("blue_runner_*", true);
		
		////////////////////////////////////
		// If event based music should be played with these shutters
		if (abPlayMusic)
		{
			PlayLockdownMusic();
		}
		
		/////////////////////////////////////
		// Turn on lights accordingly
		SetLevelLockdownLights(false, asTag);
		
		/*temp entry
		 * todo: temp entry after redesign to take in to account old BioMech/Hydroponics areas.
		 * ideally we will rename these to '_MainSecurity' in the editor once new layout is signed off as okay
		 */
		if (asTag == "MainSecurity")
		{
			SequenceContainmentLights("");
			
			mbLockdownLifted = true;
			Entity_SetActive("containment_cube_inside",false);
			SlideDoor_SetClosed("*shutter_door*BioMech",false,false);
			Button_SetLocked("*_lockdown*BioMech",false);
			SlideDoor_SetClosed("*shutter_door*Hydroponics",false,false);
			Button_SetLocked("*_lockdown*Hydroponics",false);
		}
		
		
		///////////////////////////////////////////////
		// Open dive prep and tunnel shutters
		Entity_SetActive("window_security_shutter_large_1",false);
		Entity_SetActive("03_02_tunnel_window_shutter_*",false);
		
		///////////////////////////////////////////////
		// Activate areas to make fish swim by windows
		Entity_SetActive("TriggerAreaFishSwimBy",true);
		
		Player_ChangeStateToNormal();
	}
	
	//-------------------------------------------------------
	
	void GhostPropVanish(const tString& in asEntity, bool abDistortion)
	{
		Map_RemoveTimer("FlesherCancelDistortion");
		Prop_SetActiveAndFade(asEntity, false, 1.65f);
		if (abDistortion)
		{
			Effect_VideoDistortion_SetDirectAmount(cMath_RandRectf(0.8f,1.0f));
			Map_AddTimer("GhostPropCancelDistortion", 1.1f, "GhostPropCancelDistortion");
		}
	}
	
	//-------------------------------------------------------
	
	void GhostPropAppear(const tString& in asEntity)
	{
		Map_RemoveTimer("GhostPropCancelDistortion");
		Effect_VideoDistortion_SetDirectAmount(cMath_RandRectf(0.6f,0.8f));
		Prop_SetActiveAndFade(asEntity, true, 2.0f);
		Map_AddTimer("GhostPropCancelDistortion", 2.1f, "GhostPropCancelDistortion");
	}
	
	//-------------------------------------------------------
	
	void GhostPropCancelDistortion(const tString &in asTimer)
	{
		Effect_VideoDistortion_SetDirectAmount(0.0f);
	}
	
	//-------------------------------------------------------
	
	void TimerEnableInteraction(const tString &in asTimer)
	{
		Entity_SetInteractionDisabled(asTimer, false);
	}
	
	//-------------------------------------------------------
	
	void TimerTurnOnEffects(const tString &in asTimer)
	{
		Entity_SetEffectsActive(asTimer, true, false);
	}
	
	//-------------------------------------------------------
	
	void TimerTurnOffEffects(const tString &in asTimer)
	{
		Entity_SetEffectsActive(asTimer, false, false);
	}
	
	//-------------------------------------------------------
	
	void OnCorpseDatamineOver(const tString &in asScene, const tString &in asSubject)
	{
		cLux_AddDebugMessage("***** CORPSE DATAMINE OVER *****");
		if (mlCorpseDataminesHeard >= 3) return;
		
		/*if (mbRadioPlayedInSubstation)
		{
			Voice_PlayWhenPossible("BodySpottingAware_"+mlCorpseDataminesHeard);
		}
		else
		{
			Voice_PlayWhenPossible("BodySpottingUnaware_"+mlCorpseDataminesHeard);
		}*/
		
		mlCorpseDataminesHeard++;
	}
	
	//-------------------------------------------------------
	
	//////////////////////
	// When draining ANY wau flower
	//////////////////////
	
	//-------------------------------------------------------
	int mlFlowersDrained = 0;
	//-------------------------------------------------------
	
	void OnWauFlowerDrainedAny()
	{
		mlFlowersDrained++;
		cLux_AddDebugMessage("Total flowers drained : " + mlFlowersDrained);
		if (mlFlowersDrained < 2)
		{
			cLux_AddDebugMessage("NOT draining other flowers yet");
			return;
		}
		
		
		cLux_AddDebugMessage("Draining ALL other flowers");
		
		////////////////////////////////
		// Now other wau flowers will have energy set to zero	
		EnergySource_SetEnergy("wau_flower_1",0.0f);
		EnergySource_SetEnergy("wau_flower_kitchen",0.0f);
		EnergySource_SetEnergy("wau_flower_biolab",0.0f);
		EnergySource_SetEnergy("wau_flower_commroom",0.0f);
	}
	
	//-------------------------------------------------------
	
	///////////////////////////////
	// When leaving third floor - reset checkpoint
	///////////////////////////////
	
	//-------------------------------------------------------
	bool mbAllowFloor3Save = true;
	//-------------------------------------------------------
	
	bool OnCollideAreaStairwellToFloor3(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		cLux_AddDebugMessage("Floor 3 checkpoint has been re-enabled");
		mbAllowFloor3Save = true;
		return true;
	}
	
