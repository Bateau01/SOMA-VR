	void TransferTerminalError(const tString&in asEntityName, float afTimeStep)
	{
		float fTime = ImGui_GetStateFloat("ERRORTIME",0.0f) - afTimeStep;
		ImGui_SetStateFloat("ERRORTIME",fTime);
	
		ImGui_SetTransCategory("03_02_omicron_inside");
		
		ImGui_GroupBegin(ImGui_NrmPos(cVector3f(0.0, 0.0, 1)), ImGui_NrmSize(cVector2f(1.0, 1.0)));
			ImGui_DoTextFrame("ScanError",ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)),5,0,ImGui_NrmPosGroup(cVector3f(0.0, 0.0, 0)),ImGui_NrmSizeGroup(cVector2f(1,1)));
		ImGui_GroupEnd();
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// Terminal *Power Charger*
	/////////////////////////////////////////

	//-------------------------------------------------------

	float mfChargingTimer = 0.0f;
	int mlChargerLight = 1;
	bool mbChargerLampsOn;

	//-------------------------------------------------------

	void PowerCharger_Terminal_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		
		ImGui_SetTransCategory("03_02_omicron_inside");
		
		////////////////////////////
		// Text
		cImGuiTextFrameData textData = ImGui_GetDefaultTextFrame();
		textData.mbUseBackgroundGfx = false;
		textData.mFontAlign = eFontAlign_Center;
		textData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.09);
		
		// Draw background
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		switch (meChargerState)
		{
			//todo: more info here
			case ePowerChargerState_NoCube:
			ImGui_DoTextFrameExt("ChargerNoCube", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textData, ImGui_NrmPosGroup(cVector3f(0.0, -0.25, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			break;
			
			case ePowerChargerState_Charging:
			ImGui_DoTextFrameExt("ChargerCharging", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textData, ImGui_NrmPosGroup(cVector3f(0.0, -0.25, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			
			mfChargingTimer += afTimeStep;
			if (mfChargingTimer > 0.8f)
			{
				mfChargingTimer = 0.0f;
				if (Entity_Exists("chargerIndicator_"+mlChargerLight))
				{
					Lamp_SetLit("chargerIndicator_"+mlChargerLight,true,false);
					Sound_CreateAtEntity("TerminalBeep", "Entities_Station/tech/terminal_beeps/omicron_battery_recharge_beep", ImGui_GetName(), 0.0f, false, 1.0f);
				}
				mlChargerLight++;
			}
			
			if (DoLoadingWindow("ChargeWindow", "ChargingCube", "ChargingCube", 14.25f, true))
			{
				cLux_AddDebugMessage("POWER PACK CHARGE DONE!!");
				
				meChargerState = ePowerChargerState_ChargeComplete;
				mfChargingTimer = 0.0f;
				SwingDoor_SetLocked("PowerChargerDoor",false,true);
				Sound_CreateAtEntity("TerminalBeep", "Entities_Station/tech/terminal_beeps/pathOS_comp/pathOS_comp_device_disconnect", ImGui_GetName(), 0.0f, false, 1.0f);
				PackFullyCharged();
								
				Sound_CreateAIEventAtEntity("Area_PowerCubeInsert", 30, 4);
			}
			break;
			
			case ePowerChargerState_ChargeComplete:
			ImGui_DoTextFrameExt("ChargerComplete", ImGui_NrmSizeGroup(cVector2f(0.05, 0.4)), 5, 0, textData, ImGui_NrmPosGroup(cVector3f(0.0, -0.25, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			
			mfChargingTimer += afTimeStep;
			if (mfChargingTimer > 0.5f)
			{
				Lamp_SetLit("chargerIndicator_*",mbChargerLampsOn,false);
				mfChargingTimer = 0.0f;
				mbChargerLampsOn = !mbChargerLampsOn;
			}
			break;
		}
	}
	
