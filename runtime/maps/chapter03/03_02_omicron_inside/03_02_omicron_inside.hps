	///////////////////////////////
	
	//--------------------------------------------------------
	
	tString msPadCode = "";
	float mfLockerErrorTime = 0;
	bool mbRaleighTerminalActive = false;
	bool mbDiveSuitTerminalStartup = false;
	bool mbShowSuitActivatedDialog = false;
	bool mbDiveSuitTerminalUnlocked = false;
	bool mbDiveSuitLoadComplete = false;
	int mlDivesuitBootCount = 0;
	float mfDivesuitBootTimer = 0;
	
	//--------------------------------------------------------
	
	void DivesuitComputerBootUpSound()
	{
		////////////////////
		//Booting up sound sequence
		Sound_CreateAtEntity("DiveSuitComputerBootup", "03_02_omicron_inside/SFX/diving_suit_computer/startup", "diveroom_computer_soundsource", 0.0f, false, 1.0f);
		Map_AddTimer("Timer_DiveSuitComputerIdleSound", 38.5f, "DiveSuitComputerIdleSound");
	}
	
	void DiveSuitComputerIdleSound(const tString &in asTimer)
	{
		Sound_CreateAtEntity("DiveSuitComputerBootup", "03_02_omicron_inside/SFX/diving_suit_computer/comp_loop", "diveroom_computer_soundsource", 1.0f, false, 1.0f);
	}
		
	//--------------------------------------------------------
	
	void DivesuitTerminal_OnGui(const tString&in asEntityName, float afTimeStep)
	{
		if (!mbMainPowerRestored) return;
		if (!mbDiveSuitTerminalUnlocked) return;
		
		ImGui_SetTransCategory("03_02_omicron_inside");
		
		////////////////////////////
		// Text
		cImGuiTextFrameData textData = ImGui_GetDefaultTextFrame();
		textData.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Medium));
		textData.mbUseBackgroundGfx = false;
		textData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
		textData.mFontAlign = eFontAlign_Left;
		ImGui_SetDefaultTextFrame(textData);
		
		/////////////////////////////////
		// Button
		cImGuiButtonData button = StationGui_CreateDefaultButtonData();
		button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
		ImGui_SetDefaultButton(button);
		
		/////////////////////////////////
		// Backdrop
		StationGuiBG_Scanlines();
		//StationGuiBG_Backdrop();
		
		/////////////////////////////////
		// Go through boot sequence while Catherine and Simon are talking
		if (mbDiveSuitTerminalStartup)
		{
			DiveTerminalBootSequence(afTimeStep);
			return;
		}
		
		if (StationGui_DrawAndCheckErrors()) return;
		
		int lState = StationGui_GetActiveApp(eDivesuitPanelState_MainMenu);
		bool bBackEnabled = false;
		bool bTaskbarEnabled = false;

		switch (lState)
		{
			case eDivesuitPanelState_MainMenu:
				if (ImGui_GetStateBool("ForceExit",false))
				{
					Terminal_SetUpdateWhenOutOfView(asEntityName,false);
				}
				StationGui_AddApp("ButtonSuitInfo", true, eDivesuitPanelState_Information);
				StationGui_AddApp("ButtonSuitTracking", true, eDivesuitPanelState_Tracking);
				StationGui_AddApp("ButtonSuitBoot", true, eDivesuitPanelState_BootupSelectSuit);
				StationGui_MainMenu();
				bTaskbarEnabled = true;
			break;
			
			case eDivesuitPanelState_Information:
				StationGui_TextReaderMulti("03_02_omicron_inside", "", "DiveSuitTerminalFile", "DiveSuitTerminalFileName", 3);
				bTaskbarEnabled = true;
				bBackEnabled = true;
			break;
			
			case eDivesuitPanelState_Tracking:
				DivesuitPanelTracking(afTimeStep);
				bTaskbarEnabled = true;
				bBackEnabled = true;
			break;
			
			case eDivesuitPanelState_BootupSelectSuit:
				DivesuitPanelSelectSuit();
				bTaskbarEnabled = true;
				bBackEnabled = true;
			break;
			
			case eDivesuitPanelState_EnterSerial:
				DivesuitPanelEnterSerial();
			break;
			
			case eDiveSuitPanelState_BootSequence:
				DivesuitBootSequence(afTimeStep);
			break;
			
			case eDiveSuitPanelState_ActivateCorpse:
				DivesuitActivateCorpse(afTimeStep);
			break;
			
			case eDivesuitPanelState_LockerEmpty:
				mfLockerErrorTime += afTimeStep;
				if (mfLockerErrorTime < 3.0f)
				{
					DivesuitPanelLockerError();
				}
				else
				{
					mfLockerErrorTime = 0.0f;
					StationGui_SetActiveApp(eDivesuitPanelState_BootupSelectSuit);
				}
			break;
		}
		
		if (bTaskbarEnabled)
		{
			StationGuiBG_Taskbar("omicron");
			StationGui_BackButton(bBackEnabled, eDivesuitPanelState_MainMenu);
		}
	}
	
	//---------------------------------------------------------------
	
	int mlDiveBootCounter = 0;
	int mlDiveMemCheck = 0;
	float mfDiveTerminalTimer = 0.0f;
	
	void DiveTerminalBootSequence(float afTimeStep)
	{
		mfDiveTerminalTimer += afTimeStep;
		
		ImGui_SetTransCategory("");
	
		/////////////////////////////////////
		// Play bootup sound
		if (ImGui_GetStateBool("BootupSoundPlayed",false) == false)
		{
			DivesuitComputerBootUpSound();	
			ImGui_SetStateBool("BootupSoundPlayed", true);
		}
	
		if (ImGui_GetStateInt("BootProcess", 0) == 0)
		{
			////////////////////////////////////
			// Header
			ImGui_DoLabel("-------------------------------------------------------",ImGui_NrmPosGroup(cVector3f(0.05, -0.4, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("PATHOS 189453",ImGui_NrmPosGroup(cVector3f(0.05, -0.35, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("INIT",ImGui_NrmPosGroup(cVector3f(0.05, -0.3, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("-------------------------------------------------------",ImGui_NrmPosGroup(cVector3f(0.05, -0.25, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
		
			////////////////////////////////////
			// System Memory Check
			ImGui_DoLabel("MEMCHECK : " + mlDiveMemCheck + "GB OK",ImGui_NrmPosGroup(cVector3f(0.05, -0.2, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			
			if (mfDiveTerminalTimer >= 8.53f)
				mlDiveMemCheck = 4096;
				
			if (mlDiveMemCheck < 4096)
			{
				mlDiveMemCheck += 8;	
				return;
			}
			
			ImGui_DoLabel("SYS MEM OK",ImGui_NrmPosGroup(cVector3f(0.05, -0.15, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			
			////////////////////////////////////
			// Storage Detection
			if (mfDiveTerminalTimer < 12.0f) return;
			ImGui_DoLabel("DETECTING STORAGE...",ImGui_NrmPosGroup(cVector3f(0.05, -0.1, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			if (mfDiveTerminalTimer < 15.0f) return;
			ImGui_DoLabel("/dev/sda1 mounted",ImGui_NrmPosGroup(cVector3f(0.05, -0.05, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			if (mfDiveTerminalTimer < 16.0f) return;
			ImGui_DoLabel("mount -o loop,encryption=aes divecontrol.img /media/main",ImGui_NrmPosGroup(cVector3f(0.05, -0.0, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			if (mfDiveTerminalTimer < 19.0f) return;		
			ImGui_DoLabel("Decrypting Volume....",ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			if (mfDiveTerminalTimer < 20.0f) return;
			
			/////////////////////////////////////
			// Boot up the system
			ImGui_DoLabel("Decompressing to memory",ImGui_NrmPosGroup(cVector3f(0.05, 0.1, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			if (mfDiveTerminalTimer < 25.0f) return;
			ImGui_DoLabel("Begin Startup",ImGui_NrmPosGroup(cVector3f(0.05, 0.15, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			if (mfDiveTerminalTimer < 27.0f) return;
			ImGui_SetStateInt("BootProcess", 1);
		}
		else if (ImGui_GetStateInt("BootProcess", 0) == 1)
		{
			/* TEMP */
			ImGui_DoLabel("---------------------------------------------------------------------------------------------------------",ImGui_NrmPosGroup(cVector3f(0.05, -0.4, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("Pri  M  /dev/sda1",ImGui_NrmPosGroup(cVector3f(0.05, -0.35, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("Pri  S  /dev/sdb1",ImGui_NrmPosGroup(cVector3f(0.05, -0.325, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("Sec M  /dev/sdc1",ImGui_NrmPosGroup(cVector3f(0.05, -0.3, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("Sec S  none",ImGui_NrmPosGroup(cVector3f(0.05, -0.275, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("Serial Port(s) 3F0 2F0",ImGui_NrmPosGroup(cVector3f(0.35, -0.35, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("USB7 0x0AF",ImGui_NrmPosGroup(cVector3f(0.35, -0.325, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("RAM at Banks 0 1 2 3",ImGui_NrmPosGroup(cVector3f(0.35, -0.3, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("---------------------------------------------------------------------------------------------------------",ImGui_NrmPosGroup(cVector3f(0.05, -0.225, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("DEVICE LISTING",ImGui_NrmPosGroup(cVector3f(0.05, -0.2, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("---------------------------------------------------------------------------------------------------------",ImGui_NrmPosGroup(cVector3f(0.05, -0.175, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("Bus,Dev,Fun,Vendor,Device,SVID,SSID,Class,Device Class, IRQ",ImGui_NrmPosGroup(cVector3f(0.05, -0.15, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("---------------------------------------------------------------------------------------------------------",ImGui_NrmPosGroup(cVector3f(0.05, -0.125, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("0,27,0,8086,2668,1458,A005,0403,Media Device, 5",ImGui_NrmPosGroup(cVector3f(0.05, -0.1, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("0,29,0,8086,2658,1450,2658,0C03,USB Host Cntrlr, 9",ImGui_NrmPosGroup(cVector3f(0.05, -0.075, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("0,29,1,8086,2659,1450,2659,0C03,USB Host Cntrlr, 11",ImGui_NrmPosGroup(cVector3f(0.05, -0.05, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("0,29,2,8086,265A,1450,265A,0C03,USB Host Cntrlr, 11",ImGui_NrmPosGroup(cVector3f(0.05, -0.025, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("0,31,2,8086,2651,1458,2651,0101,IDE Cntrlr, 14",ImGui_NrmPosGroup(cVector3f(0.05, -0.0, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("2,5,0,11AB,4320,1458,E000,0200,Network Cntrlr, 12",ImGui_NrmPosGroup(cVector3f(0.05, 0.025, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_DoLabel("---------------------------------------------------------------------------------------------------------",ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			
			if (mfDiveTerminalTimer < 30.0f) return;
			ImGui_DoLabel("Booting..",ImGui_NrmPosGroup(cVector3f(0.05, 0.1, 0)), ImGui_NrmSizeGroup(cVector2f(1,1)));
			ImGui_SetStateInt("BootProcess",2);
		}
		else
		{
			if (DoLoadingWindow("LoadingWindow", "Loading", "Loading", 10.0f, true))
			{
				mbDiveSuitTerminalStartup = false;
			}	
		}
		
	}
	
