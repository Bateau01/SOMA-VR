	bool SuitWakePreAnim_2_CameraNodePassed(const tString &in asEntity, int alDirection)
	{
		
		cLux_AddDebugMessage("DIR : " +alDirection);
		if (alDirection == -1)
		{
			mbPlayerStoodUp = true;
			CameraAnimation_End();
			CameraAnimation_Begin("SuitWakeAnim","",true);
			//Map_AddTimer("timer_wakeupconversation",2.35f,"TimerWakeupConversation");
		}
		return true;
	}
	

