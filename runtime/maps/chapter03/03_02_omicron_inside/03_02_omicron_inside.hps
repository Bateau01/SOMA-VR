	//-------------------------------------------------------
	
	bool CollideTunnelFlicker(const tString &in asParent, const tString &in asChild, int alState)
	{
		////////////////////////////////////////////
		// Do nothing if lockdown lights are still active
		if (!mbLockdownLifted) return true;
		
		//////////////////////////////////////////////
		// Percent chance for lights to flicker again when player walks through tunnel
		if (mbTunnelFlickerDone)
		{
			float fRand = cMath_RandRectf(0,100);
			if (fRand > 15) return true;
		}
		
		//////////////////////////////////////////////
		// Flicker the lamps for a while
		Lamp_SetFlickerActive("tunnel_lamp*",true);
		Map_AddTimer("timer_stopflicker",2.0,"TimerStopTunnelFlicker");
		mbTunnelFlickerDone = true;
		
		return true;
	}
	
