	//-------------------------------------------------------
	
	tString OnCathHints(const tString& in asEntityName) 
	{
		bool bHasStructureGel = false;
		bool bHasRobotBrain = false;
		tString sSubj = "";
		
		if (Map_TimerExists("timer_catherinegavehint")) Map_RemoveTimer("timer_catherinegavehint");
		Map_AddTimer("timer_catherinegavehint",30.0f,"TimerCathGaveInstructions");
		
		////////////////////////////////
		// Return if the player has already built a corpse &activated it
		if (mbCorpseActivated) return "";	
			
		////////////////////////////////////////
		// Remind player to activate the suit
		else if (mbCorpseCrafted) return "10EActivateSuitHint";	
		
		////////////////////////////////////////
		// Return if player has all three items
		if (mlPuzzleItemsGathered >= 3) return "BuildSuitHint";
		
		/////////////////////////////////////////
		//  Check if player has structure gel and brain
		bHasStructureGel = Player_ToolIsInInventory("StructureGelTool");
		bHasRobotBrain = Player_ToolIsInInventory("BrokenRobotBrain");
	
		//////////////////////////////////////////
		// Player has not found any of the relevant rooms
		if (!mbPlayerFoundPowerRoom && !mbPlayerFoundBioMech && !mbPlayerFoundRobotRoom)
		{
			sSubj = "7_ItemReminders_FindAll";
		}
		
		//////////////////////////////////////////
		// Player has not found brain
		//{
		else if (mbPlayerFoundBrain == false && bHasRobotBrain == false)
		{
			sSubj = "7_ItemReminders_FindBrain";
		}
		//}
		
		/////////////////////////////////////////
		// Player has found the brain, but not ejected/taken it
		//{
		else if (mbBrainEjected == false && bHasRobotBrain == false)
		{
			sSubj = "7_ItemReminders_EjectBrain";
		}
		//}
		
		///////////////////////////////////////
		// Player has not found the gel / chip puzzle
		//{
		else if (mbPlayerFoundChip == false && bHasStructureGel == false)
		{
			sSubj = "7_ItemReminders_FindGel";
		}
		//}
		
		///////////////////////////////////////
		// Player has found chip, but not fixed it
		//{
		else if (mbPlayerFoundChip == true && bHasStructureGel == false)
		{	 
			sSubj = "7_ItemReminders_FixChip";
		}
		//}
		
		///////////////////////////////////////
		// Player has not found the power room
		//{
		else if (mbPlayerFoundPowerRoom == false)
		{
			sSubj = "7_ItemReminders_FindPowerRoom";
		}
		//}
		
		///////////////////////////////////////
		// Player has found the power room but not the pack
		//{
		else if (mbPlayerFoundPowerRoom == true && mbPlayerHasUnchargedPack == false && mbPlayerHasChargedPack == false)
		{
			sSubj = "7_ItemReminders_FindPack";
		}
		//}
		
		///////////////////////////////////////
		// Player has not found the power pack, but not charged it
		//{
		else if (mbPlayerFoundPowerRoom == true && mbPlayerHasUnchargedPack && mbPlayerHasChargedPack == false)
		{
			sSubj = "7_ItemReminders_ChargePack";
		}
		//}
	
		////////////////////////////////////
		// If nothing to remind the player about..
		else if (sSubj == "")
		{
			sSubj = "7_ItemReminders_AllComplete";
		}
		
		return sSubj;
	}
	
