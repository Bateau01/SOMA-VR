	//--------------------------------------------
	
	void PlayRobotRepairSound(int alSound)
	{
		switch (alSound)
		{
			////////////////////////////////////
			// User clicks in a bad place, negative feedback (i.e clicking on output nodes nothing will happen)
			case -1:
				cLux_AddTodoMessage("SOUND: Repair Puzzle, bad press");
				Depth_Audio_Terminal_Negative("RobotPuzzleTerminalSoundSource");
			break;
			
			////////////////////////////////////
			// User clicks on a circuit piece to rotate it
			case 1:
				cLux_AddTodoMessage("SOUND: Repair Puzzle, rotate a piece");
				Sound_CreateAtEntity("RobotPuzzleBeepTurn", "Entities_Station/tech/terminal_beeps/robot_brain_puzzle/turn", "RobotPuzzleTerminalSoundSource");
			break;
			
			////////////////////////////////////
			// User changes state of output inhibitor
			case 2:
				cLux_AddTodoMessage("SOUND: Repair Puzzle, change inhibitor");
				Sound_CreateAtEntity("RobotPuzzleBeepActi", "Entities_Station/tech/terminal_beeps/robot_brain_puzzle/activate", "RobotPuzzleTerminalSoundSource");
			break;
		}
	}
	
