	}
		
	
	//-------------------------------------------------------
	
	/////////////////////////////////////
	// ==============
	// Scene 3 - Containment Room
	// ==============
	/////////////////////////////////////

	//-------------------------------------------------------
	
	int mlContainmentCrackPhase = 0;
	int mlFlesherCubeEffect = -1;
	int mlFlesherCubeRadialEffect = -1;
	bool mbPlayerInContainment = false;
	bool mbFirstRossSighting = true;
	
	bool mbRossSpokenFirstTime = false;
	bool mbRossSpokenSecondTime = false;
	bool mbRossSpokenThirdTime = false;
	bool mbPlayerInMidSection = false;
	
	//-------------------------------------------------------
	
	////////////////////////////////////////////////
	// Scene 3 - Event A - Enter Containment Room
	////////////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool CollideContainmentArea(const tString &in asParent, const tString &in asChild, int alState)
	{
		
		//cLux_AddDebugMessage("AREA NAME : " + asChild);
		//////////////////////////////////////////
		// Check if the player is in the mid section
		mbPlayerInMidSection = (Entity_GetVarString(asChild,"") == "mid") ? true : false;
		
		///////////////////////////////////////
		// Resume music when player leaves the room
		if (alState == -1) 
		{
			Map_AddTimer("StartAmbient", cMath_RandRectf(8.0f,15.0f), "AmbientMusicHandler");
			Map_RemoveTimer("timer_rossflicker");
			mbPlayerInContainment = false;
			return true;		
		}
		
		mbPlayerInContainment = true;
		
		//////////////////////////////////////
		// If the cube has already cracked, do not trigger again
		if (mbContainmentCubeBroken)
		{
			//No music after containment cube smashed
			return false;
		}
		
		///////////////////////////////////////
		// Handle Ross speaking to the player from the cube
		HandleRossSpeaking();
		
		//////////////////////////////////////////////////////////////////
		// Whenever player enters the containment areas, noises will occur
		Map_RemoveTimer("timer_fleshernoises");
		Map_AddTimer("timer_fleshernoises",cMath_RandRectf(2.0f,4.0f),"TimerFlesherSounds");
		
		/////////////////////////////////////////////////
		// Make Ross Flicker
		float fMinFlicker = mbFirstRossSighting ? 3.0f : 20.0f;
		float fMaxFlicker = mbFirstRossSighting ? 7.0f : 30.0f;
		Map_AddTimer("timer_rossflicker",cMath_RandRectf(fMinFlicker,fMaxFlicker),"TimerRossFlicker");
		
		/////////////////////////////////////////////////
		// Stop the music when player enters here
		cLux_AddTodoMessage("SOUND: Stop level music - this place needs to be quiet as hell!");
		Map_AddTimer("StopAmbientMusicQuickly", 1.0f, "AmbientMusicHandler");
		
		
		///////////////////////////////////////
		// We don't want to do anything if the player has all 3 items and is passing through upper/lower (Scare should happen where the player can see it)
		if (mlPuzzleItemsGathered == 3 && mbPlayerInMidSection == false)
		{
			return true;
		}
		
		/////////////////////////////////////////////////
		// Things get progressively worse as we pass through here after getting a puzzle piece
		if (mlContainmentCrackPhase < mlPuzzleItemsGathered)
		{
            Sound_PreloadGroup("03_02_omicron_inside/SFX/escalation", true);
			mlContainmentCrackPhase = mlPuzzleItemsGathered;
			HandleContainmentEscalation();
		}
		else if (mbPlayerInMidSection && mlPuzzleItemsGathered == 3)
		{
			/////////////////////////////
			// We have to break the cube when the player goes through mid with 3 puzzle items!
			HandleContainmentEscalation();
		}
		else
		{
			cLux_AddDebugMessage("No escalation yet : phase="+mlContainmentCrackPhase + " gathered: " +mlPuzzleItemsGathered);
		}
		
		return true;
	}
	
	//-------------------------------------------------------
	
	void HandleRossSpeaking()
	{
		//////////////////////////////////////
		// Ross speaks to the player the first time they come in here
		if (!mbRossSpokenFirstTime && mbPlayerInMidSection)
		{
			Map_AddTimer("RossFirstLinePlay", 0.5f, "RossFirstLinePlay");
			Map_AddTimer("Ross1stLineSweetner", 1.65f, "RossFirstLineSweet");
			mbRossSpokenFirstTime = true;
			
			// Force ross visible here then hide him until Simon has plugged in Catherine
			RossCube_ForceVisible("CubeShadow", 2.5f);
			Map_AddTimer("timer_hideross",2.75f,"TimerHideRoss");
			return;
		}
		
		//////////////////////////////////////
		// Ross also speaks to the player the first time they go through with an item
		if (!mbRossSpokenSecondTime && mlPuzzleItemsGathered >= 1)
		{
			Map_AddTimer("RossSpeakFirstItem", 1.5f, "RossSpeakFirstItem");
			mbRossSpokenSecondTime = true;
			return;
		}
		
		//////////////////////////////////////
		// Ross also speaks to the player the second time they go through with an item
		if (!mbRossSpokenThirdTime && mlPuzzleItemsGathered >= 2)
		{
			Map_AddTimer("RossSpeakSecondTime", 2.0f, "RossSpeakSecondTime");
			mbRossSpokenThirdTime = true;
			return;
		}
	}
	
