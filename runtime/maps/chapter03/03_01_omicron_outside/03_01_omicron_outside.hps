	//-------------------------------------------------------
	
	int mlPowerNodeCount = 0;
	int mlPowerMeter = 1;
	int mlPowerMeterTarget = 0;
	bool mbSurgeActive = false;

	//-------------------------------------------------------
	
	void OnChangeElectricSwitch(const tString &in asEntity, int alState)
	{
        Sound_CreateAtEntity("PowerSwitch", "Entities_OceanBottom/tech/fuse_puzzle/fuse_puzzle_switch", "FuseSoundSource");
		if (!mbCatherineActiveInSubBase || mbSurgeActive) return;
		
		EvaluateAllPowerConnections();
		TimerFadePowerMeter("");
	}

	//-------------------------------------------------------
	
	void EvaluateAllPowerConnections()
	{
		mlPowerNodeCount = 0;
		Entity_SetVarBool("ElectricSwitch_*", "Powered", false);
		Entity_SetVarBool("ConnectionLamp_*", "Powered", false);
		Entity_SetEffectsActive("ElectricSwitch_*", false, true);
		bool bAtEndNode = EvaluatePowerConnection(-1, cVector2l(0, 0));

		if (bAtEndNode && mlPowerNodeCount <= glMaxPowerNodesActive)
		{
			Lamp_SetLit("ConnectionLamp_End", true, true);
		}
	  
		array<iLuxEntity@> vLamps;
		Map_GetEntityArray("ConnectionLamp_*", vLamps, eLuxEntityType_Prop);
		for (int i = 0; i < vLamps.length(); i++)
		{
			iLuxEntity@ pLamp = vLamps[i];
			tString sName = pLamp.GetName();
		   
			if (sName == "ConnectionLamp_End")
				continue;
		   
			bool bLit = pLamp.GetVarBool("Powered");
		   
			if (bLit == Lamp_GetLit(sName))
				continue;
			else if (bLit)
			{
				Sound_CreateAtEntity("PowerBeep", "03_01_omicron_outside/Gameplay/fuse_puzzle/fuse_puzzle_beep", "FuseSoundSource", 0.0f, false, 1.0f);
                Sound_CreateAtEntity(sName, "03_01_omicron_outside/SFX/fuse_flicker_loop", sName);
			}
			else
			{
                Sound_Stop(sName, 0.15f);
			}

			Lamp_SetLit(sName, bLit, true);
		}
	}
	
	//-------------------------------------------------------
	
	bool EvaluatePowerConnection(const cVector2l &in avFrom, const cVector2l &in avTo)
	{
		tString sSwitch = "ElectricSwitch_"+avTo.x+"_"+avTo.y;
		
		if (!Entity_Exists(sSwitch))
			return false;
			
		///////////////////////////////
		// Turn on connection effect
		if (avFrom != -1)
		{
			tString sLamp;
			if (avFrom.x < avTo.x || avFrom.y < avTo.y) 
				sLamp = "ConnectionLamp_"+avFrom.x+"_"+avFrom.y+"_"+avTo.x+"_"+avTo.y;
			else										
				sLamp = "ConnectionLamp_"+avTo.x+"_"+avTo.y+"_"+avFrom.x+"_"+avFrom.y;
			Entity_SetVarBool(sLamp, "Powered", true);

			bool bBroken = Entity_Exists(sLamp+"_Broken");
			if (bBroken) 
			{
				if (Entity_IsActive(sLamp))
				{
					Map_AddTimer(sLamp, cMath_RandRectf(0, 0.4), "TimerOverloadNode");
				}
				return false;
			}
			
			cColor col = MovingButton_IsSwitchedOn(sSwitch) ? cColor_Green : cColor_White;
			//Entity_SetEffectBaseColor(sLamp, col);
		}
			
		if (MovingButton_IsSwitchedOn(sSwitch)) 
			return false;
			
		// Already checked this node
		if (Entity_GetVarBool(sSwitch, "Powered")) return false;
			
		////////////////////////////
		// Turn on node effects
		Entity_SetEffectsActive(sSwitch, true, true);
		
		////////////////////////////////////////////////////////
		// Tag as powered to avoid counting multiple times
		Entity_SetVarBool(sSwitch, "Powered", true);
		
		/////////////////////////////
		// Check connected nodes
		bool bSuccess =
		EvaluatePowerConnection(avTo, cVector2l(avTo.x-1, avTo.y)) ||
		EvaluatePowerConnection(avTo, cVector2l(avTo.x+1, avTo.y)) ||
		EvaluatePowerConnection(avTo, cVector2l(avTo.x, avTo.y-1)) ||
		EvaluatePowerConnection(avTo, cVector2l(avTo.x, avTo.y+1));
		
		mlPowerNodeCount++;
		
		////////////////////////////////
		// Special case for final node
		if (avTo == cVector2l(3, 3))
		{
			return true;
		}
		
		return bSuccess;
	}

	//-------------------------------------------------------
	
	void TimerOverloadNode(const tString &in asTimer)
	{
		Entity_SetActive(asTimer, false);
		Entity_SetActive(asTimer+"_Broken", true);
		
		Sound_CreateAtEntity(asTimer+"Burst", "Entities_OceanBottom/tech/fuse_puzzle/fuse_puzzle_break", "FuseSoundSource");
		
		cParticleSystem@ pParticles = ParticleSystem_CreateAtEntityExt(asTimer+"_PS", "elec_spark_physics_oneshot.ps", asTimer, false, cColor_White);
		pParticles.SetWorldPosition(pParticles.GetWorldPosition() + cVector3f(-0.06, 0.15, 0));
	}

	//-------------------------------------------------------
	
	void TimerFadePowerMeter(const tString &in asTimer)
	{	
		Map_RemoveTimer("FadePowerMeter");
	
		/////////////////////////////////////////
		// Check if too many moves were made
		if (mlPowerMeter==0 && !mbSurgeActive)
		{
			Seq_PowerSurge("");
			
			return;
		}
		
		mlPowerMeterTarget = glMaxPowerNodesActive - mlPowerNodeCount;
		if (mlPowerMeterTarget == mlPowerMeter)
		{
			if(Lamp_GetLit("ConnectionLamp_End"))
			{
				Player_ChangeStateToNormal();
				Player_SetLookSpeedMul(0);
				Player_FadeLookSpeedMulTo(1, 1);
				Entity_SetInteractionDisabled("ElectricSwitch_*", true);
				Sound_CreateAtEntity("PowerOn", "03_01_omicron_outside/Gameplay/fuse_puzzle/fuse_puzzle_success", "FuseSoundSource", 0.0f, false, 1.0f);
				
				Map_AddTimer("3_CathChatPowerPuzzleDone", 1, "PlayCathMiniConvo");				
				
				TurnOnPower();
			}
			return;
		}
		
		mlPowerMeter += cMath_Sign(mlPowerMeterTarget-mlPowerMeter);
		
		for (int i = 1; i <= glMaxPowerNodesActive; i++)
		{
			Entity_SetEffectsActive("PowerLevelLamp_"+i, (i <= mlPowerMeter), true);
		}
		
		Map_AddTimer("FadePowerMeter", mlPowerMeter == 10 ? 0.7 : 0.2, "TimerFadePowerMeter");
	}

	//-------------------------------------------------------

	
	void TurnOnPower()
	{
		SetCathPanelEnabled("AirlockButton", true, false);
		cLux_AddTodoMessage("Sound: Power getting turned on.");
		Sound_CreateAtEntity("PowerOn", "03_01_omicron_outside/Gameplay/fuse_puzzle/fuse_puzzle_success", "FuseSoundSource", 0.0f, false, 1.0f);
		Sound_CreateAtEntity("DomeGeneratorSound", "Entities_OceanBottom/tech/fuse_puzzle/fuse_puzzle_machine", "GeneratorSoundSource");
		
		////////////////////
		//slight delay to stop from sound overkill and to bulk out the power on sequence
		Map_AddTimer("DomePowerTimer", 3.0f, "DomePowerSequence");
		
		Entity_PlayProcAnimation("GeneratorFan", "Spin", 4, true, 0, 4);
		Light_FadeTo("FanLight", cColor(1,0.584,0,0.204), -1, 4);
	}

	//-------------------------------------------------------
	
	void DomePowerSequence (const tString &in asTimer)
	{	
		mbPowerOn = true;
		
		//Sound_CreateAtEntity("DomePowerOn", "03_01_omicron_outside/SFX/special/dome_poweron", "Player", 0.0f, false, 1.0);
		
		Terminal_SetAllowInteraction("BloodTerminal", true);
		Terminal_SetAllowInteraction("StatusTerminal", true);
		
		Terminal_ForceCacheUpdate("DoorTerminal");
		Terminal_ForceCacheUpdate("BloodTerminal");
		Terminal_ForceCacheUpdate("StatusTerminal");
		
		Lamp_SetLit("SubBaseWallLamp_*", true, true);
		
		if (mbSubBaseFlowerDrained)
			Lamp_SetLit("SubBaseWallLamp_5", false, false);

		ActivateOutsidePower();

		///////////////////
		// Start preloading
		Preload();
	}

	//-------------------------------------------------------
	
	cSequenceStatesData mPowerSurgeSequence;
		
	void Seq_PowerSurge(const tString &in asTimer)
	{
		Sequence_Begin("Seq_PowerSurge", mPowerSurgeSequence);
			
		if (Sequence_DoStepAndWait(0.3))
		{
			mbSurgeActive = true;
			Entity_SetInteractionDisabled("ElectricSwitch_*", true);
			Sound_CreateAtEntity("PowerOverload_1", "03_01_omicron_outside/Gameplay/fuse_puzzle/fuse_puzzle_fail", "FuseSoundSource", 0.0f, false, 1.0f);
		}	
		else if (Sequence_DoStepAndWait(0.3))
		{
			MovingButton_SetSwitchedOn("ElectricSwitch_*", true, false);
			EvaluateAllPowerConnections();
			Lamp_SetLit("PowerLevelLamp_0", false, true);
		}
		else if (Sequence_DoStepAndWait(0.3)) Lamp_SetLit("PowerLevelLamp_0", true, true);
		else if (Sequence_DoStepAndWait(0.3)) Lamp_SetLit("PowerLevelLamp_0", false, true);
		else if (Sequence_DoStepAndWait(0.3)) Lamp_SetLit("PowerLevelLamp_0", true, true);
		else if (Sequence_DoStepAndWait(0.3)) Lamp_SetLit("PowerLevelLamp_0", false, true);
		else if (Sequence_DoStepAndWait(0.3)) Lamp_SetLit("PowerLevelLamp_0", true, true);
		else if (Sequence_DoStepAndWait(0.3)) Lamp_SetLit("PowerLevelLamp_0", false, true);
		else
		{
			Entity_SetInteractionDisabled("ElectricSwitch_*", false);
			TimerFadePowerMeter("");
			Lamp_SetLit("PowerLevelLamp_0", true, true);
			mbSurgeActive = false;
		}
		Sequence_End();
	}

	//-------------------------------------------------------

	///////////////////////////////
	//Dome generator sound logic for use in airlock
	void GeneratorSoundOn()
	{
		if(mbPowerOn==true)
		{
			Sound_CreateAtEntity("DomeGeneratorSound", "Entities_OceanBottom/tech/fuse_puzzle/fuse_puzzle_machine_nostartup", "GeneratorSoundSource");
			//Sound_CreateAtEntity("LeakSound", "01_02_upsilon_inside_02/amb/spot/water_stream_from_roof_quieter", "SubStationLeakSoundSource");
			cLux_AddDebugMessage("Power is on, generator sound triggering");
		}
		
		else if (mbPowerOn==false)
		{
			cLux_AddDebugMessage("Power is not on, generator sound not triggering");
		}
	}

	void GeneratorSoundOff()
	{
		if(mbPowerOn==true)
		{
			Sound_Stop("DomeGeneratorSound", 2.0f);
			//Sound_Stop("LeakSound", 0.5f);
			cLux_AddDebugMessage("Power is on, turning generator sound off");
		}
		
		else if (mbPowerOn==false)
		{
			cLux_AddDebugMessage("Power is not on, generator sound not turning off");
		}
	}

