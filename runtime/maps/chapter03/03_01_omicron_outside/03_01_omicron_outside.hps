	//-------------------------------------------------------

	/////////////////////////////////////////
	// Cath tool
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	bool CanUseCathTool(const tString &in asTool, const tString &in asEntity)
	{
		return CathTool_CanUse(asTool, asEntity) || asEntity == "SubStationCathTerminal_Aux";
	}

	//-------------------------------------------------------
	
	bool OnUseCathTool(const tString &in asTool, const tString &in asEntity)
	{
		if (asEntity == "SubStationCathTerminal" || asEntity == "SubStationCathTerminal_Aux")
		{
			return PlugInCatherine();
		}
		else if (asEntity == "AirlockButton")
		{
			CathTool_UseOnPanel(asTool, asEntity);
		}
		else if (asEntity == "MainAirlockButton")
		{
			CathTool_UseOnPanel(asTool, asEntity);
		}
		else if (asEntity == "SideAirlockButton")
		{
			CathTool_UseOnPanel(asTool, asEntity);
			Entity_SetActive("EndAirlockBlocker", true);
		
			Entity_SetActive("BridgeLookDownTrigger_*", false);
			SetAbyssEffectsActive(false);
		}
			
		return false;
	}

	//-------------------------------------------------------

	/////////////////////////////////////////
	// Inactive buttons and panels
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	void InteractInactiveButton(const tString &in asEntity)
	{
		//////////////////////////////////////
		// Temporarily disable interaction
		Entity_SetInteractionDisabled(asEntity, true);
		Map_AddTimer(asEntity, 1.25f, "TimerEnableInteraction");
			
		tString sButton = Entity_GetVarString(asEntity, "");
		
		// Use entity name if no user var specified
		bool bGotUserVar = true;
		if (sButton == "") 
		{
			sButton = asEntity;		
			bGotUserVar = false;
		}
		
		//////////////////////////////////////
		// For actually disabled buttons (not those using areas to produce this effect) - set the button to off to avoid green!
		if (bGotUserVar == false)
			Button_SetSwitchedOn(asEntity,true,true);
			
		Sound_CreateAtEntity("InactiveDoorButton", "Entities_Station/doors/theta_door/button_locked", asEntity, 0, false);
		Entity_SetEffectBaseColor(sButton, cColor_Red);
		Entity_SetEffectsActive(sButton, true, false);

	
			
		//////////////////////////////////////
		// Blink effects
		Map_AddTimer(sButton, 0.45f, "TimerTurnOffEffectsNoFade");
		Map_AddTimer(sButton, 0.75f, "TimerTurnOnEffectsNoFade");
		Map_AddTimer(sButton, 0.9f, "TimerTurnOffEffectsNoFade");
	}

	//-------------------------------------------------------
	
	void SetCathPanelEnabled(const tString &in asPanel, bool abState, bool abEffects)
	{
		Button_SetLocked(asPanel, !abState, abEffects);
	}

	//-------------------------------------------------------

	/////////////////////////////////////////
	// ==============
	// SCENE 1 *WAKE UP NEAR OMICRON*
	// ==============
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	void SetupWakeUp(bool abIntro)
	{
		if (abIntro)
		{
			/////////////////////////////////////////////
			//Fade in audio once intro is over
			Map_AddTimer("AudioFadeInTimer", 8.0f, "FadeInAudio");
			Map_AddTimer("IntroMusicTimer", 10.0f, "TriggerIntroMusic");
			//Animation audio
			Sound_CreateAtEntity("IntroCameraAnimation", "03_01_omicron_outside/SFX/special/intro_sequence/camera_anim", "Player", 0.0f, false, 1.0f);
			Emotion_PlayEventBreath("03_01_omicron_outside/SFX/special/intro_sequence/camera_anim_vo", 5);
			
			Effect_Fade_Out(0);
			Effect_Fade_In(0.5);
			CameraAnimation_Begin("IntroAnim", "", true);
			CameraAnimation_SetAttachedEntity("IntroParticles", false, false, false);
			ParticleSystem_CreateAtEntityExt("IntroBubblePS", "loop_waterbubbles_large_cloud.ps", "IntroParticles", true, cColor(0.487,0.628,0.7,1), 0.25);
			cLux_AddDebugMessage("Frame 0 for sound sync");
		}
		else
		{
			Map_AddTimer("AudioFadeInTimer", 1.0f, "FadeInAudio");
		}
		
		ParticleSystem_SetActive("SealPoundPS_*", false);
		ParticleSystem_SetActive("TunnelBubbles", false);
	}

	//-------------------------------------------------------
	
	bool Trigger_CheckpointStart(const tString &in asParent, const tString &in asChild, int alState)
	{
		Game_AutoSave();
		return false;
	}

	//-------------------------------------------------------
	
	bool Trigger_RestateObjective(const tString &in asParent, const tString &in asChild, int alState)
	{
		Map_AddTimer("1_Objective", 4, "TimerPlayVoice");
		return false;
	}

	//-------------------------------------------------------

	void FadeInAudio(const tString &in asTimer)
	{
        if (cLux_ScriptDebugOn())
        {
            Sound_FadeGlobalVolume(1.0f, 1.0f, eSoundEntryType_World);
            Sound_FadeGlobalVolume(1.0f, 1.0f, eSoundEntryType_WorldClean); 
        }
        else
        {
            Sound_FadeGlobalVolume(1.0f, 10.0f, eSoundEntryType_World);
            Sound_FadeGlobalVolume(1.0f, 10.0f, eSoundEntryType_WorldClean);
        }
		cLux_AddDebugMessage("Fading in Game Audio");
	}

	//-------------------------------------------------------

	void TriggerIntroMusic(const tString &in asTimer)
	{
		Music_Play("03_01_start", 0.4f, false, eMusicPrio_BgAmb);
	}
