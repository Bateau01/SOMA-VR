	void Subject_CathOverrideDone(const tString &in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		
		CathTool_AllowDetach("CathTool");
		mbCatherineActiveInSubBase = false;
		Terminal_SetGuiActive("CathFaceTerminal", false, 0.5);
		Entity_SetActive("ToolArea_1", false);
		Entity_SetActive("SubStationCathTerminal_Aux", false);
		
		PlayerEnergy_SetAllowCathComment(false);
	}

