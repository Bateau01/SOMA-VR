	//-------------------------------------------------------
	
	bool Trigger_SupportCollapse(const tString &in asParent, const tString &in asChild, int alState)
	{
		Entity_SetActive("SupportCollapseTrigger_*", false);
		Seq_SupportCollapse("");
		return false;
	}

	//-------------------------------------------------------
	
	cSequenceStatesData mSupportCollapseSequence;
		
	void Seq_SupportCollapse(const tString &in asTimer)
	{
		Sequence_Begin("Seq_SupportCollapse", mSupportCollapseSequence);
		if (Sequence_DoStepAndWait(2.0f))
		{
			//////////////////////////
			//Setpiece audio
			Sound_CreateAtEntity("BridgeCollapse", "03_01_omicron_outside/SFX/special/structure_fall/bridge_collapse", "Player");
		}	
		
		else if (Sequence_DoStepAndWait(1.1))
		{
			//////////////////////////
			//Setpiece audio
			Sound_CreateAtEntity("StructureCollapse", "03_01_omicron_outside/SFX/special/structure_fall/structure_fall", "Player");
			
			Depth_Audio_Fear_MediumIntensity(6.5f, 13.0f, 3, true, true);
			
			Entity_SetActive("CollapsedCrawlspace_Physics", true);
			Entity_SetActive("CollapsedCrawlspace_Static", false);
			Map_AddTimer("CollapseCrawlSpaceImpactTimer", 0.6f, "CollapseCrawlspaceImpact");
		}
		else if (Sequence_DoStepAndWait(0))
		{
			//Effect_Shake_Start(0.2, 0, 0, 0.5);
			Effect_Sway_FadeIn(0.75, 1, 1, -90, 1, 0.25f, 0.995f, 0);
			Entity_SetActive("SupportCollapse_Static_*", false);
			Entity_SetActive("SupportCollapse_Physics_*", true);
		}
		Sequence_End();
	}

	void CollapseCrawlspaceImpact(const tString &in asTimer)
	{
		Effect_Shake_Start(0.1, 0, 0, 0.5);
		Effect_Rumble_Start(0.75, 1, 0, 1);
	}
	
