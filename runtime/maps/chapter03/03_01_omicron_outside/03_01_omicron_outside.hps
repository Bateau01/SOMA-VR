	//-------------------------------------------------------
	
	void OnGuiFishSphere(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("03_01_omicron_outside");
		
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		if (!mbPowerOn)
		{
			DoNoMainPowerScreen();
			return;
		}
		
		// Data
		cImGuiLabelData label = ImGui_GetDefaultLabel();
		label.mFontAlign = eFontAlign_Left;
		label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
		label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.06);
