			Voice_Play("4_LookAtOmicron");
	}

	//-------------------------------------------------------
	
	void OnChange_OmicronGateButton(const tString &in asEntity, int alState)
	{
		if (alState != 1)
			return;
		
		if (mbLockdownOverridden==false)
		{
			Terminal_SetImGuiStateBool("DoorTerminal", "ButtonWasPressed", true);
			Depth_Audio_Terminal_Error("DoorTerminal");
			return;
		}
		
		bool bMainDoorOpen = MovingButton_IsSwitchedOn("MainDoorButton");
		
		if (bMainDoorOpen==false)
			OmicronMainDoorOpen();
	}

