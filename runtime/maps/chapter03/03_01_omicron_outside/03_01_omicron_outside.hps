	//-------------------------------------------------------
	
	void ActivateOutsidePower()
	{
		Lamp_SetLit("path_marker_*", true, false);
		Lamp_SetLit("subs_underlight_*", true, false);
		Lamp_SetLit("fish_sphere_*", true, false);
		
		if (mbFishSphereFlowerDrained)
		{
			Lamp_SetLit("fish_sphere_7*", false, false);
			Entity_SetEffectsActive("fish_sphere_7*", false, false);
		}
			
		Lamp_SetLit("ThetaRedLamp_*", true, false);
		Lamp_SetLit("ThetaSpotLamp_*", true, false);
		Lamp_SetLit("OmicronDoorLamp_*", true, false);
		
		Sound_CreateAtEntity("Pump_Idle_Loop_OmicronMain", "Entities_OceanBottom/airlock/uw/pump/idle_loop", "AirlockFailSoundSource", 1.0f, false, 1.0f);
		
		Terminal_SetAllowInteraction("DoorTerminal", true);
		
		//////////////
		// Cute bots
		for (int i = 1; Entity_Exists("CuteBot_"+i+"_Off"); i++)
		{
			Entity_SetActive("CuteBot_"+i, true);
			Entity_SetActive("CuteBot_"+i+"_Proximity", true);
			Entity_SetActive("CuteBot_"+i+"_Off", false);
			Entity_PlaceAtEntity("CuteBot_"+i, "CuteBot_"+i+"_Off", cVector3f_Up*0.75f);
			Entity_PlaceAtEntity("CuteBot_"+i+"_Proximity", "CuteBot_"+i+"_Off", cVector3f_Up*0.75f);
		}
		Pathfinder_Track_Add("CuteBot_1", "PathNodeArea_1");
		Pathfinder_Track_Add("CuteBot_1", "PathNodeArea_22");
		Pathfinder_Track_Add("CuteBot_1", "PathNodeArea_17");
		Pathfinder_Track_Add("CuteBot_1", "PathNodeArea_9");
		Pathfinder_Track_Start("CuteBot_1", true, 0, "");
		
		Pathfinder_Track_Add("CuteBot_2", "PathNodeArea_24");
		Pathfinder_Track_Add("CuteBot_2", "PathNodeArea_28");
		Pathfinder_Track_Add("CuteBot_2", "PathNodeArea_31");
		Pathfinder_Track_Add("CuteBot_2", "PathNodeArea_36");
		Pathfinder_Track_Add("CuteBot_2", "PathNodeArea_38");
		Pathfinder_Track_Add("CuteBot_2", "PathNodeArea_40");
		Pathfinder_Track_Add("CuteBot_2", "PathNodeArea_43");
		Pathfinder_Track_Add("CuteBot_2", "PathNodeArea_46");
		Pathfinder_Track_Add("CuteBot_2", "PathNodeArea_48");
		Pathfinder_Track_Start("CuteBot_2", true, 0, "");
		
		Pathfinder_Track_Add("CuteBot_3", "PathNodeArea_51");
		Pathfinder_Track_Add("CuteBot_3", "PathNodeArea_56");
		Pathfinder_Track_Add("CuteBot_3", "PathNodeArea_57");
		Pathfinder_Track_Add("CuteBot_3", "PathNodeArea_58");
		Pathfinder_Track_Add("CuteBot_3", "PathNodeArea_64");
		Pathfinder_Track_Add("CuteBot_3", "PathNodeArea_65");
		Pathfinder_Track_Start("CuteBot_3", true, 0, "");
		
	}

