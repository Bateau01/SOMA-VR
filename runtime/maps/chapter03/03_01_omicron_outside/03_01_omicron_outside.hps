	bool mbSecretCodeSeen = false;

	//-------------------------------------------------------
	
	////////////////////////
	// Hack to get around the cache's not working 
	// well with so many screens active at the same time
	// This just constantly updates the screens so they are 
	// nearly guaranteed to look right when you reach them.
	void Timer_FishSphereCacheUpdate(const tString &in asTimer)
	{
		int lIndex = cString_GetNumericSuffixInt(asTimer);
		if (Entity_Exists("FishSphereTerminal_"+lIndex)==false)
			lIndex = 1;
			
		Terminal_ForceCacheUpdate("FishSphereTerminal_"+lIndex);
		Map_AddTimer("Timer_FishSphereCacheUpdate_"+(lIndex+1), 0.4, "Timer_FishSphereCacheUpdate");
	}

