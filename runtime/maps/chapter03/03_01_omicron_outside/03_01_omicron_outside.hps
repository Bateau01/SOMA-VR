	//-------------------------------------------------------
	
	void Timer_SubBaseCorpseDatamineDone(const tString &in asEntity)
	{
		if ((mbCatherineActiveInSubBase && mbTriedDataminingCorpse_Catherine) || 
		    (mbCatherineActiveInSubBase == false && mbTriedDataminingCorpse_NoCatherine))
			return;
			
		StopSubStationIdleDialogImmediately();
		
		if (mbCatherineActiveInSubBase)
		{
			Voice_Play("3_InteractSubBaseCorpse_Catherine", -1, "VoiceAllowIdleDialog");
			mbTriedDataminingCorpse_Catherine = true;
		}
		else
		{
			Voice_Play("3_InteractSubBaseCorpse_NoCatherine", -1, "VoiceAllowIdleDialog");
			mbTriedDataminingCorpse_NoCatherine = true;
		}
	}

