	/////////////////////////////////////////
	// Scene 3 Event F *Catherine Conversation(dialog)*
	/////////////////////////////////////////

	//-------------------------------------------------------

	int mlIdleDialogSequence = 1;
	int mlIdleDialogSubject = 1;
	bool mbIdleDialogSequenceActive = false;
	bool mbIdleDialogAllowed = true;

	//-------------------------------------------------------
	
	void TimerSubStationIdleDialog(const tString &in asTimer)
	{
		if (mlIdleDialogSequence > 3 || 
			!mbIdleDialogAllowed || 
			mbIdleDialogSequenceActive ||
			!mbCatherineActiveInSubBase)
		{
			return;
		}
		
		///////////////////////////////////////////////////////////////////////
		// Requeue if already speaking (i.e listening to hints) or datamining
		if (Voice_CharacterIsSpeaking("Catherine") || Voice_CharacterIsSpeaking("Player") || Entity_IsInteractedWith("RelayCorpseArea"))
		{
			cLux_AddDebugMessage("Requeued dialogue");
			Map_AddTimer("BeginSubStationIdleDialog", cMath_RandRectf(4, 5), "TimerSubStationIdleDialog");
			return;
		}
		
		mbIdleDialogSequenceActive = true;
		
		Dialog_Begin("SubStationIdleDialog");
			Dialog_AddBranch("3_IdleDialog_"+mlIdleDialogSequence);
				AddIdleDialogSequence(1, 3);
				AddIdleDialogSequence(2, 2);
				AddIdleDialogSequence(3, 2);		
		Dialog_End();
	}

	//-------------------------------------------------------
	
	void AddIdleDialogSequence(int alSequence, int alSubjectCount)
	{
		if (mlIdleDialogSequence != alSequence) return;
		
		for (int i = 1; i <= alSubjectCount; i++)
		{
			if (mlIdleDialogSubject > i) continue;
			
			tString sCallback = (i == alSubjectCount) ? "SubjectIdleDialogSequenceOver" : 
														"SubjectSubStationIdleDialog";
			
			Dialog_AddSubject("3_IdleDialog_"+alSequence+"_"+i, sCallback);
		}
	}

	//-------------------------------------------------------
	
	void SubjectIdleDialogSequenceOver(const tString &in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject)
		{			
			if (mbIdleDialogAllowed==false)
			{
				StopSubStationIdleDialogImmediately(false);
			}
			else
			{
				mlIdleDialogSequence++;
				mlIdleDialogSubject=1;
			}
			return;
		}
	
		mbIdleDialogSequenceActive = false;
		Map_AddTimer("BeginSubStationIdleDialog", cMath_RandRectf(5, 10), "TimerSubStationIdleDialog");
	}

	//-------------------------------------------------------
	
	void SubjectSubStationIdleDialog(const tString &in asSubject, bool abStartOfSubject)
	{
		if (!abStartOfSubject) return;
		
			
		if (mbIdleDialogAllowed==false)
		{
			StopSubStationIdleDialogImmediately(false);
		}
		else
		{
			mlIdleDialogSubject++;
			cLux_AddDebugMessage("Subject "+mlIdleDialogSubject);
		}
	}

	//-------------------------------------------------------
	
	void StopSubStationIdleDialog()
	{
		if (!mbCatherineActiveInSubBase) return;
		
		mbIdleDialogAllowed = false;
		if (!mbIdleDialogSequenceActive)
		{
			Map_RemoveTimer("BeginSubStationIdleDialog");
		}
	}

	//-------------------------------------------------------
	
	void StopSubStationIdleDialogImmediately(bool abSkipToNextSequence=true)
	{
		if (!mbCatherineActiveInSubBase) return;
		
		// Skip to next sequence if the current one has been started
		if (mlIdleDialogSubject!=1 && abSkipToNextSequence)
		{
			mlIdleDialogSequence++;
			mlIdleDialogSubject=1;
		}
		
		mbIdleDialogSequenceActive = false;
		mbIdleDialogAllowed = false;
			
		cLux_AddDebugMessage("Dialog_Stop");
		Dialog_Stop("SubStationIdleDialog");
		Map_RemoveTimer("BeginSubStationIdleDialog");
	}

	//-------------------------------------------------------
	
	void ResumeSubStationIdleDialog(float afDelay)
	{
		cLux_AddDebugMessage("ResumeSubStationIdleDialog");
		if (!mbCatherineActiveInSubBase) return;
		
		mbIdleDialogAllowed = true;
		mbResumeIdleDialogOnTerminalLeave = true;
		
		// Check if already active
		if (mbIdleDialogSequenceActive) return;
		
		// Make sure dialog isn't already about to start
		Map_RemoveTimer("BeginSubStationIdleDialog");	
		Map_AddTimer("BeginSubStationIdleDialog", afDelay, "TimerSubStationIdleDialog");
	}

	//-------------------------------------------------------
	
	bool CollisionAtTopFloor(const tString &in asParent, const tString &in asChild, int alState)
	{
		PlayCathMiniConvo("3_CathChatTopFloor");
		return true;
	}

	//-------------------------------------------------------
	
	void PlayCathMiniConvo(const tString &in asSubject)
	{
		if (mbCatherineActiveInSubBase==false) return;
		
		if (Voice_AnySceneIsActive()==false)
		{
			float fTimeLeft = Map_GetTimerTime("BeginSubStationIdleDialog");
			StopSubStationIdleDialog();
			
			Dialog_Begin("SubStationIdleDialog");
				Dialog_AddBranchAndSubject(asSubject, "", "SubjectMiniConvoOver");
			Dialog_End();
			
			if (Voice_AnySceneIsActive()==false)
			{
				ResumeSubStationIdleDialog(fTimeLeft);
			}
		}
	}
	
	void SubjectMiniConvoOver(const tString &in asSubject, bool abStartOfSubject)
	{
		if (abStartOfSubject) return;
		
		cLux_AddDebugMessage("SubjectMiniConvoOver");
		ResumeSubStationIdleDialog(5);
	}

