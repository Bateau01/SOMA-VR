	//-------------------------------------------------------
	
	tString OnCathHints(const tString& in asEntityName) 
	{
		//////////////////////////////////
		// If player has not gotten power up and running
		if (mbPowerOn == false)
		{
			return "Hint_NoPower";
		}
		
		//////////////////////////////////
		// If player has not tried removing emergency lockdown
		if (mbKeypadScreenSeen == false)
		{
			return "Hint_NoEmergLockTry";
		}
		
		//////////////////////////////////
		// If player has not found secret code
		if (mbSecretCodeSeen == false)
		{
			return "Hint_NoSecretCode";
		}
		
		//////////////////////////////////
		// If player has not tried secret code (having found it)
		if (mbLockdownOverridden == false)
		{
			return "Hint_HasSeenCode";
		}
		
		// fallthrough
		return "";
	}

