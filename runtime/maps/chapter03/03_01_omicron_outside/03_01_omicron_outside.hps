	//-------------------------------------------------------
	
	void DoNoMainPowerScreen(bool abBlinking=false)
	{		
		cStationGui_BigStatusMessageSettings statusMessage;
		statusMessage.mColor = gStationGuiColor_Warning;
		statusMessage.mfTextSizeMul = 1.5f;
		statusMessage.mbBlinking = abBlinking;
		StationGui_BigStatusMessage("NoPower", statusMessage);
	}
	
	//-------------------------------------------------------
	
	bool DoMainMenuSelectionButton(const tString &in asText, int alState, float afPosition, float afHeight)
	{
		if (ImGui_DoButton(asText, asText, ImGui_NrmPosGroup(cVector3f(0, afPosition, 1)), ImGui_NrmSizeGroup(cVector2f(1, afHeight))))
		{
			if (alState != -1) ImGui_SetStateInt("CurrentState", alState);
			Depth_Audio_Terminal_Forward(ImGui_GetName());
			return true;
		}
		return false;
	}

	//-------------------------------------------------------
	
	bool DoBackButton(const cVector3f &in avPos, int alState = 0, const cVector2f &in avSize=cVector2f(0.275, 0.1))
	{
		if (ImGui_DoButton("BackButton", "Back", ImGui_NrmPosGroup(avPos), ImGui_NrmSizeGroup(avSize)))
		{
			ImGui_SetStateInt("CurrentState", alState);
			Depth_Audio_Terminal_Back(ImGui_GetName());
			return true;
		}
		return false;
	}

	//-------------------------------------------------------
	
	void OnEnterSubStationTerminal(const tString&in asEntityName)
	{
		cLux_AddDebugMessage("OnEnterSubStationTerminal");
		if (mbCatherineActiveInSubBase)
			StopSubStationIdleDialog();
	}

	//-------------------------------------------------------
	
	void OnLeaveSubStationTerminal(const tString&in asEntityName)
	{
		if (mbCatherineActiveInSubBase && mbResumeIdleDialogOnTerminalLeave)
			ResumeSubStationIdleDialog(4);
	}

	//-------------------------------------------------------

	/////////////////////////////////////////
	// Terminal *Door Terminal*
	/////////////////////////////////////////

	//-------------------------------------------------------

	bool mbTriedDoorTerminalOpen = false;
	bool mbTriedDoorTerminalStatus = false;

	//-------------------------------------------------------

	void OnGuiDoorTerminal(const tString&in asEntityName, float afTimeStep)
	{			
		ImGui_SetTransCategory("03_01_omicron_outside");
				
		// Draw background
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		if (!mbLockdownOverridden)
		{
			if (ImGui_GetStateBool("ButtonWasPressed", false))
			{
				ImGui_SetStateBool("ButtonWasPressed", false);
				ImGui_AddTimer("ButtonBlinkingActive", 2);
			}
			bool bBlinking = ImGui_TimerExists("ButtonBlinkingActive");
			DoNoMainPowerScreen(bBlinking);
			return;
		}
		
		ImGui_SetTransCategory("StationGUI");
		
		cStationGui_BigStatusMessageSettings statusMessage;
		statusMessage.mColor = gStationGuiColor_Highlight;
		statusMessage.mfTextSizeMul = 2;
		StationGui_BigStatusMessage("DoorControlApp_Unlocked", statusMessage);
	}

	//-------------------------------------------------------
	
	void DoorTerminalMainMenu()
	{	
		bool bMainDoorOpen = MovingButton_IsSwitchedOn("MainDoorButton");
		float fOpenAmount = SlideDoor_GetOpenAmount("Omicron_MainDoor");
	
		StationGui_AddApp("OpenDoorButton", !bMainDoorOpen && fOpenAmount==0 && !SequenceStates_IsActive("Seq_MainBaseAirlockMalfunction"), false);
		StationGui_AddApp("CloseDoorButton", bMainDoorOpen && fOpenAmount==1, false);
		StationGui_AddApp("DoorStatusButton", true, 1);
		int lSelection = StationGui_MainMenu();
		
		if (lSelection == 0)
		{
			mbTriedDoorTerminalOpen = true;
			if (mbLockdownOverridden)
			{
				OmicronMainDoorOpen();
			}
			else
			{
				StationGui_SetError("DoorOpenFail");
			}
		}
		else if (lSelection == 1)
		{
			OmicronMainDoorClose();
		}
	}
	
	//-------------------------------------------------------
	
	void OmicronMainDoorClose()
	{
		/////////////////////////
		//Door Close
		Sound_CreateAtEntity("OmicronDoorClose", "03_01_omicron_outside/Gameplay/door/omicron_front_door_close", "OmicronDoorSoundSource", 0.0f, false, 1.0f);
		Sound_Stop("OmicronDoorOpen", 1.0f);
		SlideDoor_SetClosed("Omicron_MainDoor", true);
		MovingButton_SetSwitchedOn("MainDoorButton", false, false);
	}
	
	//-------------------------------------------------------
	
	void OmicronMainDoorOpen()
	{
		/////////////////////////
		//Door Open
		Sound_CreateAtEntity("OmicronDoorOpen", "03_01_omicron_outside/Gameplay/door/omicron_front_door_open", "OmicronDoorSoundSource", 0.0f, false, 1.0f);
		Sound_Stop("OmicronDoorClose", 1.0f);
		SlideDoor_SetClosed("Omicron_MainDoor", false);
		MovingButton_SetSwitchedOn("MainDoorButton", true, false);
	}
	
	//-------------------------------------------------------
	
	void DoorTerminalStatus()
	{			
		mbTriedDoorTerminalStatus = true;
		tString sStatus = mbLockdownOverridden ? "DoorTerminalStatus_Inactive" : "DoorTerminalStatus_Active";
		StationGui_TextReaderSingle("DoorStatusButton", sStatus);
	}

	//-------------------------------------------------------

	/////////////////////////////////////////
	// Terminal *Blood Terminal*
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	int mlCatherineOverrideState = 0;
	bool mbOverridingCorrectLockdown = false;
	bool mbBlackboxCutOutHeard = false;
	bool mbKeypadScreenSeen = false;

	//-------------------------------------------------------
	
	void OnGuiBloodTerminal(const tString&in asEntityName, float afTimeStep)
	{	
		ImGui_SetTransCategory("03_01_omicron_outside");
		
		// Draw background
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		if (!mbPowerOn)
		{
			DoNoMainPowerScreen();
			return;
		}
		
		if (ImGui_TimerOver("VoiceBegin"))
		{
			StopSubStationIdleDialog();
			Map_AddTimer("Timer_LockdownLiftedDialog", 0, "Timer_LockdownLiftedDialog");
		}
		
		///////////////////////
		// Data
/*		cImGuiButtonData buttonData = StationGui_CreateDefaultButtonData();
		buttonData.mFont.mvSize = ImGui_NrmSizeGroupKeepRatio(0.045);
		ImGui_SetDefaultButton(buttonData);*/
				
		// Draw background
		StationGuiBG_Taskbar("omicron");
		
		///////////////////////
		// Error messages
		if (StationGui_DrawAndCheckErrors())
			return;
		
		bool bBackButton = false;
		int lBackApp = eBloodTerminalApp_MainMenu;
		int lState = StationGui_GetActiveApp();
		
		/////////////////////////
		// States
		switch (lState)
		{
			case eBloodTerminalApp_MainMenu:
				StationGui_AddApp("RecordedMessage");
				StationGui_AddApp("LockdownStatus");
				StationGui_MainMenu();
				break;
			case eBloodTerminalApp_Message:
				Depth_ImGui_AddAudioFile_Voice("CommandLogHeader", "3_BloodTerminalRecording", "VoiceBloodTerminalRecording");
				if (StationGui_AudioPlaybackApp()!=-1 && mbIdleDialogSequenceActive)
				{
					StopSubStationIdleDialogImmediately();
					Voice_Play("3_CancelIdleDialog");
				}
				bBackButton = true;
				break;
			case eBloodTerminalApp_LockdownStatus:
				BloodTerminalLockdownStatus();
				bBackButton = true;
				break;
			case eBloodTerminalApp_LockdownInput:
				BloodTerminalLockdownInput();
				bBackButton = true;
				lBackApp = eBloodTerminalApp_LockdownStatus;
				break;
			case eBloodTerminalApp_LockdownOverride:
				BloodTerminalLockdownOverride();
				break;
		}
		
		if (StationGui_BackButton(bBackButton, lBackApp))
		{
			if (lState==eBloodTerminalApp_Message)
			{
				Depth_ImGui_StopAudioFilePlayback(ImGui_GetName(), true);
			}
			StationGui_SetNumpadInput("");
		}
	}
	
	void Timer_LockdownLiftedDialog(const tString &in asTimer)
	{
		if (Voice_AnySceneIsActive())
		{
			Map_AddTimer("Timer_LockdownLiftedDialog", 1, "Timer_LockdownLiftedDialog");
			return;
		}
		
		mbResumeIdleDialogOnTerminalLeave = false;
		StopSubStationIdleDialogImmediately();
		Dialog_Begin();
			Dialog_AddBranch("4_OverrideCodeEntered");
				if (mbSecretCodeSeen==false) Dialog_AddSubject("4_OverrideCodeEntered_NoHint");
				Dialog_AddSubject("4_OverrideCodeEntered_CathReacts");
				if (mbSecretCodeSeen) Dialog_AddSubject("4_OverrideCodeEntered");
				Dialog_AddPause(0.75);
				Dialog_AddSubject("4_OverrideCodeEntered_End", "Subject_CathOverrideDone");
		Dialog_End();
	}

	//-------------------------------------------------------
	
	void LineOver_SetRadioMessageDiscovered(const tString &in asScene, const tString &in asSubject, int alLineIndex, bool abStart)
	{
		/////////////////////////////////////////
		// Set radio discovered for 3.2
		if (abStart) return;
		
		cScript_SetGlobalVarBool("SubstationRadioPlayed", true);
	}
	
	//-------------------------------------------------------
	
	void LineOver_VoiceCutOutBlackbox(const tString &in asScene, const tString &in asSubject, int alLineIndex, bool abStart)
	{
		if (abStart)
			return;
		mbBlackboxCutOutHeard = true;
	}

	//-------------------------------------------------------
	
	void VoiceBloodTerminalRecording(const tString&in asScene, const tString&in asSubject)
	{
		if (mbBlackboxCutOutHeard)
			Voice_Play("3_AfterBloodTerminalRecording");
	}

	//-------------------------------------------------------
	
	void BloodTerminalLockdownStatus()
	{
		cImGuiButtonData button = StationGui_CreateDefaultButtonData();
		
		cImGuiLabelData label = ImGui_GetDefaultLabel();
		label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Additive));
		label.mFont.mMaterial = eGuiMaterial_Additive;
		label.mFont.mvSize = button.mFont.mvSize;
		label.mFont.mColor = gStationGuiColor_Normal;
		label.mFontAlign = eFontAlign_Center;
		
		cImGuiWindowData window = StationGui_CreateDefaultWindowData();
		
		ImGui_DoWindowStart("", window, ImGui_NrmPosGroup(0.125, 0.025, 1), ImGui_NrmSizeGroup(0.75, 0.2));
		
			ImGui_DoLabelExt("DoorStatusButton", label, ImGui_NrmPosGroup(0, 0.19, 1), ImGui_NrmSizeGroup(0.35, -1));
		
			ImGui_SetModUseInput(mbLockdownOverridden==false);
			tString sStatusText = "LockdownStatusOuter_" + (mbLockdownOverridden ? "Off" : "On");
			ImGui_ResizeFontToFit(sStatusText, button.mFont, ImGui_GetCurrentGroupSize().x*0.55);
			if (ImGui_DoButtonExt("LockdownUnlock", sStatusText, button,
							  ImGui_NrmPosGroup(0.35, 0.1, 1), ImGui_NrmSizeGroup(0.6, 0.6)))
			{
				mbOverridingCorrectLockdown = true;
				Depth_Audio_Terminal_Forward(ImGui_GetName());
				StationGui_SetActiveApp(eBloodTerminalApp_LockdownInput);
			}
			ImGui_SetModUseInput(true);
		ImGui_DoWindowEnd();
		
		window.mbUseHeader = false;
		ImGui_DoWindowStart("", window, ImGui_NrmPosGroup(0.2, 0.25, 1), ImGui_NrmSizeGroup(0.6, 0.6), false);
			ImGui_SetAlignment(eImGuiAlign_CenterCenter);
			cImGuiGfx camera("OmicronCamera", eImGuiGfx_Special);
			cVector2f vFeedSize = ImGui_GetRatioCorrectSizeByRect(camera, ImGui_NrmSizeGroup(0.9, 0.9));
			ImGui_DoImage(camera, ImGui_NrmPosGroup(0.5,0.5,1.0f), vFeedSize);
			
			// Static overlay
			ImGui_SetModColorMul(gStationGuiColor_Normal*cColor(0.4, 0.5));
			cImGuiGfx staticAnim = cImGuiGfx("static_anim_01", eImGuiGfx_TextureAnimated);
			staticAnim.mfAnimationTime = 0.08;
			ImGui_DoImage(staticAnim, ImGui_NrmPosGroup(0.5,0.5,2.0f), vFeedSize);
			ImGui_ResetModifiers();
					
			ImGui_SetAlignment(eImGuiAlign_TopLeft);
		ImGui_DoWindowEnd();
	}

	//-------------------------------------------------------
	
	void BloodTerminalLockdownInput()
	{		
		// First time the keypads are displayed
		if (!mbKeypadScreenSeen)
		{
			mbKeypadScreenSeen = true;
			
			Terminal_SetEnterCallback("StatusTerminal", "OnEnterStatusTerminal_StartGlitching");
			Map_AddTimer("StatusTerminalGlitch", 15, "TimerStatusTerminalGlitch");
			
			Map_AddTimer("Timer_BlodTerminalKeypadComment", 2, "Timer_BlodTerminalKeypadComment");
		}
		
		if (StationGui_Numpad("LockdownStatus", 4))
		{
			tString sCode = StationGui_GetNumpadInput();
			
			if (CodeIsValid(sCode))
			{
				Depth_Audio_Terminal_Confirm(ImGui_GetName());
				StationGui_SetActiveApp(eBloodTerminalApp_LockdownOverride);
				StationGui_SetNumpadInput("");
				mbLockdownOverridden = true;
				mbOverridingCorrectLockdown = false;
			}
			else
			{	
				StationGui_SetError("InvalidCode");
				StationGui_SetNumpadInput("");
			}
		}
	}

	//-------------------------------------------------------
	
	bool CodeIsValid(const tString &in asCode)
	{
		cLux_AddDebugMessage("Current code "+mvValidCodes[0]);
		////////////////////////////////////////////////////////////////////////////////
		// Check if it's the code that has been displayed or the last remaining code
		if (mbSecretCodeSeen || mvValidCodes.length()==1)
		{
			return asCode == mvValidCodes[0];
		}
		
		/////////////////////////////////
		// Remove from valid codes
		else
		{
			for (int i = 0; i < mvValidCodes.length(); i++)
			{
				if (asCode != mvValidCodes[i])
					continue;
				
				cLux_AddDebugMessage("Removed code "+mvValidCodes[i]);
				mvValidCodes.removeAt(i);
				cLux_AddDebugMessage("Codes left "+mvValidCodes.length());
				break;
			}
		}
		return false;
	}

	//-------------------------------------------------------
	
	void Timer_BlodTerminalKeypadComment(const tString &in asTimer)
	{
		mbResumeIdleDialogOnTerminalLeave = false;
		StopSubStationIdleDialog();
		Voice_PlayWhenPossible("3_LockdownCodeUnknown", "VoiceCondition_BloodTerminalKeypadComment", -1, 1, "VoiceAllowIdleDialog");
	}
		
	bool VoiceCondition_BloodTerminalKeypadComment(const tString &in asSubject)
	{	
		return Entity_IsInteractedWith("StatusTerminal") == false;
	}

	//-------------------------------------------------------
	
	void BloodTerminalLockdownOverride()
	{	
		cGuiDialogBoxSettings dialogBox = StationGui_CreateDefaultDialogBox();
		dialogBox.mType = eGuiDialogBoxType_OK;
		eGuiDialogCode returnCode = Depth_ImGui_DialogBox("Success", "LockdownOverrideConfirmation", dialogBox);
		if (returnCode==eGuiDialogCode_OK)
		{
			StationGui_SetActiveApp(eBloodTerminalApp_LockdownStatus);
			Depth_Audio_Terminal_Confirm(ImGui_GetName());
			OpenShutters();
				
			/////////////////////////////
			//add approach music area
			cLux_AddDebugMessage("Omicron Approach Music trigger enabled");
			Entity_SetActive("OmicronApproachMusic", true);
			
			ImGui_AddTimer("VoiceBegin", 1);
		}
		return;
	}

	//-------------------------------------------------------

	/////////////////////////////////////////
	// Terminal *Status Terminal*
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	bool mbShowHiddenButton = false;
	eHiddenButtonGlitchState mHiddenButtonGlitchState = eHiddenButtonGlitchState_None;

	//-------------------------------------------------------
	
	void OnGuiStatusTerminal(const tString&in asEntityName, float afTimeStep)
	{	
		// Failsafe to avoid displaying hidden button after door has been overridden.
		mbShowHiddenButton = mbShowHiddenButton && !mbLockdownOverridden; 
		
		// Display secret button if the player is using the terminal, 
		// otherwise stop glitching for a bit
		if (ImGui_TimerOver("HiddenButtonDelay"))
		{
			ImGui_StopTimer("HiddenButtonDelay");
			mHiddenButtonGlitchState = eHiddenButtonGlitchState_None;
			if  (ImGui_InFocus())
			{
				Terminal_SetUpdateWhenOutOfView(ImGui_GetName(), false);
				mbShowHiddenButton = true;
				Map_AddTimer("4_HiddenButtonAppears", 0.5, "TimerPlayVoice");
				return;
			}
			else
			{
				PlayCathMiniConvo("3_CathChatGlitchSound");
			}
		}
		
		ImGui_SetTransCategory("03_01_omicron_outside");
		
		// Draw background
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		if (!mbPowerOn)
		{
			DoNoMainPowerScreen();
			return;
		}
		
		CheckHiddenButton();
				
		StationGuiBG_Taskbar("omicron");
		
		// Force main menu to display if the glitches are happening
		if (!mbShowHiddenButton && ImGui_TimerOver("HiddenButtonGlitch"))
			StationGui_SetActiveApp(eStatusTerminalApp_MainMenu);
			
		bool bBackButton = true;
		int lState = StationGui_GetActiveApp();
		
		/////////////////////////
		// States
		switch (lState)
		{
			case eStatusTerminalApp_MainMenu:
				StatusTerminalMainMenu();
				bBackButton=false;
				break;
			case eStatusTerminalApp_BlackBoxStatus:
				StationGui_TextReaderSingle("BlackboxStatusButton", "BlackboxStatus");
				break;
			case eStatusTerminalApp_SystemUpdates:
				StatusTerminalSystemUpdates();
				break;
			case eStatusTerminalApp_HiddenMenu:
				StatusTerminalHiddenMenu();
				break;
		}
		
		if (StationGui_BackButton(bBackButton) && lState==eStatusTerminalApp_HiddenMenu)
		{
			Terminal_SetUpdateWhenOutOfView(ImGui_GetName(), false);
		}
	}

	//-------------------------------------------------------
	
	void StatusTerminalMainMenu()
	{
		cVector3f vOffset = cVector3f_Zero;
		if (ImGui_TimerExists("HiddenButtonDelay") && ImGui_TimerOver("HiddenButtonGlitch"))
		{
			mHiddenButtonGlitchState = eHiddenButtonGlitchState(cMath_RandRectl(eHiddenButtonGlitchState_None, eHiddenButtonGlitchState_LastEnum));
			if (mHiddenButtonGlitchState == eHiddenButtonGlitchState_Offset)
				ImGui_SetStateVector3f("Offset", cMath_RandRectVector3f(cVector3f(-0.5, -0.5, 0), cVector3f(0.5, 0.5, 0)));
			ImGui_AddTimer("HiddenButtonGlitch", cMath_RandRectf(0.025, 0.1f));		
		
			Sound_CreateAtEntity("StatusTerminalGlitch", "03_01_omicron_outside/Gameplay/wau_glitch/wau_glitch_burst", ImGui_GetName());
		}
		if (mHiddenButtonGlitchState == eHiddenButtonGlitchState_NoRender) return;
		if (mHiddenButtonGlitchState == eHiddenButtonGlitchState_Offset)
			vOffset = ImGui_GetStateVector3f("Offset", cVector3f_Zero);
			
		
		
		ImGui_GroupBegin(ImGui_NrmPos(cVector3f(0, 0, 1)+vOffset), ImGui_NrmSize(1, 1));
			StationGui_AddApp("BlackboxStatusButton");
			StationGui_AddApp("SystemUpdatesButton");
			if (mbShowHiddenButton) StationGui_AddApp("HiddenButton");
			StationGui_MainMenu();
		ImGui_GroupEnd();
	}

	//-------------------------------------------------------
	
	void StatusTerminalSystemUpdates()
	{		
		cStationGui_TextReaderSettings settings;
		settings.msCustomHeader = "SystemUpdatesButton";
		settings.mbDrawAppIcon = false;
		
		int lPrevSelection = ImGui_GetStateInt("SystemUpdateSelection", -1);
		
		for (int i = 1; i <= 7; i++)
			Depth_ImGui_AddTextFile("SystemUpdateName_"+i, "SystemUpdate_"+i);
		int lSelection = StationGui_TextReaderMulti(settings);
		
		if (lPrevSelection != lSelection && lSelection == 4)
		{
			//Map_AddTimer("3_CathChatWauSystemUpdate", 0.25, "PlayCathMiniConvo");
		}
		
		ImGui_SetStateInt("SystemUpdateSelection", lSelection);
	}

	//-------------------------------------------------------
	
	void StatusTerminalHiddenMenu()
	{			
		if (mbSecretCodeSeen==false)
		{
			Voice_AbortIfQueued("3_LockdownCodeUnknown");
			mbResumeIdleDialogOnTerminalLeave = true;
		}
		mbSecretCodeSeen = true;
		
		tString sPasswordRepeat = "";
		int lRepeatFade = int(ImGui_GetStateFloat("PasswordRepeat", -1));
		int lRepetitionTimes = 165;
		if (lRepeatFade < 0)
		{
			ImGui_SetStateFloat("PasswordRepeat", 0);
			ImGui_FadeStateFloat("PasswordRepeat", lRepetitionTimes, 3, eEasing_Linear);
			Sound_CreateAtEntity("PasswordRepeat", "03_01_omicron_outside/Gameplay/wau_glitch/wau_glitch_number", "StatusTerminal_SoundSource", 0.0f, false, 1.0f);
			Sound_FadeGlobalVolume(0.45, 0.25);
			Map_AddTimer("FadeQuickReturnTimer", 3.5, "FadeQuickReturn");
			Map_AddTimer("3_CathChatSecretButtonClicked", 4.5, "PlayCathMiniConvo");
		}
		Terminal_SetUpdateWhenOutOfView(ImGui_GetName(), lRepeatFade < lRepetitionTimes);
		for (int i = 0; i < lRepeatFade; i++) sPasswordRepeat = sPasswordRepeat + mvValidCodes[0]+" ";
		StationGui_TextReaderSingle("", "", sPasswordRepeat);
	}

	//-------------------------------------------------------
	
	void CheckHiddenButton()
	{		
		if (mbShowHiddenButton) return;
		if (mbLockdownOverridden) return;
				
		if (ImGui_GetStateInt("StartGlitch") != 1) return;
		ImGui_SetStateInt("StartGlitch", 0);
		
		if (ImGui_TimerExists("HiddenButtonDelay")) return;
		
		Terminal_SetUpdateWhenOutOfView(ImGui_GetName(), true);
		
		ImGui_AddTimer("HiddenButtonDelay", 1.75);
		ImGui_AddTimer("HiddenButtonGlitch", 1.25);
	}

	//-------------------------------------------------------
	
	void TimerStatusTerminalGlitch(const tString &in asTimer)
	{
		Terminal_SetImGuiStateInt("StatusTerminal", "StartGlitch", 1);
		
		Map_RemoveTimer("GlitchRepeatTimer"); 
		Map_AddTimer("GlitchRepeatTimer", cMath_RandRectf(0.25, 4), "TimerStatusTerminalGlitch");
	}

	//-------------------------------------------------------
	
	void OnEnterStatusTerminal_StartGlitching(const tString&in asEntityName)
	{
		OnEnterSubStationTerminal(asEntityName);
		
		Map_RemoveTimer("StatusTerminalGlitch");
		TimerStatusTerminalGlitch("");
		
		Terminal_SetEnterCallback(asEntityName, "OnEnterSubStationTerminal");
	}

