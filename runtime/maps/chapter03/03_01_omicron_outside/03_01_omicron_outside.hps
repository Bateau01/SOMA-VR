		void OnChangeMainDoorButton(const tString &in asEntity, int alState)
		 {
				Entity_SetInteractionDisabled(asEntity, true);
				TimerCheckMainDoorButtonLock(asEntity);
				float fOpenAmount = SlideDoor_GetOpenAmount("Omicron_MainDoor");
				
				if (alState==-1)
				{
					OmicronMainDoorClose();
				}
				
				else
				{
					OmicronMainDoorOpen();
				}
		 }

	 //-------------------------------------------------------
		 
		void TimerCheckMainDoorButtonLock(const tString &in asTimer)
		{
			float fOpenAmount = SlideDoor_GetOpenAmount("Omicron_MainDoor");
			bool bSwitchedOn = MovingButton_IsSwitchedOn("MainDoorButton");
			if ((bSwitchedOn==true && fOpenAmount>0.99) || (bSwitchedOn==false && fOpenAmount<0.01))
			{
				Entity_SetInteractionDisabled("MainDoorButton", false);
				return;	
			}
			  
			Map_AddTimer(asTimer, 0.25, "TimerCheckMainDoorButtonLock");
		}
			 
	/////////////////////////////////////////
	// Scene 5 Event B *Turn on airlock, fail.*
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	void OnChangeMainAirlockButton(const tString &in asEntity, int alState)
	{
		Entity_SetActive("MainAirlockOmniToolArea", false);
		Seq_MainBaseAirlockMalfunction("");
	}
 
    //-------------------------------------------------------
	
	cSequenceStatesData mMainBaseAirlockMalfunctionSequence;
		
	void Seq_MainBaseAirlockMalfunction(const tString &in asTimer)
	{
		Sequence_Begin("Seq_MainBaseAirlockMalfunction", mMainBaseAirlockMalfunctionSequence);
		
		if (Sequence_DoStepAndWait(3.4))
		{			
			OmicronMainDoorClose();
			MovingButton_SetSwitchedOn("MainDoorButton", false, true);
			MovingButton_SetLocked("MainDoorButton", true);
			Sound_CreateAtEntity("OmicronPumpsFail", "03_01_omicron_outside/SFX/special/airlock_fail/omicron", "AirlockFailSoundSource", 0.0);
			Sound_Stop("Pump_Idle_Loop_OmicronMain", 3.4f);
			Sound_FadeGlobalVolume(0.7, 3.0f);
			cLux_AddTodoMessage("Sound: Valves opening");
			
		}
		else if (Sequence_DoStepAndWait(2.3))
		{
			Effect_Shake_Start(0.015, 0.75, 0.00f, 0.5f);
			cLux_AddTodoMessage("Sound: Pumps running");
		}
		else if (Sequence_DoStepAndWait(1))
		{
			//int lShakeID = Effect_Shake_Start(0.1, 0.5, 0.0, 0.75);
			//Effect_Shake_SetSourceEntity(lShakeID, "MainEntrancePumpsSource", 5, 7);
			MovingButton_SetLocked("MainDoorButton", false);
			Sound_FadeGlobalVolume(1.0, 2.0f);
		}
		else
		{
			Depth_Audio_Terminal_Error("MainAirlockButton");
			Button_SetSwitchedOn("MainAirlockButton", false, false);
			SetCathPanelEnabled("MainAirlockButton", false, true);
			Terminal_ForceCacheUpdate("MainAirlockTerminal");
			Entity_SetActive("MainAirlockOmniToolArea", true);
		}
		
		Sequence_End();
	}

	//-------------------------------------------------------
	
	void OnGuiMainAirlock(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("03_01_omicron_outside");
		
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		cStationGui_BigStatusMessageSettings statusMessage;
		if (Button_IsLocked("MainAirlockButton"))
		{
			statusMessage.mfTextSizeMul = 1.25;
			StationGui_BigStatusMessage("BrokenAirlockError", statusMessage);
		}
		else if (Button_IsSwitchedOn("MainAirlockButton"))
		{
			statusMessage.mfTextSizeMul = 2;
			StationGui_BigStatusMessage("AirlockFlushing", statusMessage);
		}
		else
		{
			statusMessage.mColor = gStationGuiColor_Highlight;
			statusMessage.mfTextSizeMul = 2;
			StationGui_BigStatusMessage("AirlockReady", statusMessage);
		}
	}

