//--------------------------------------------------
 
class cScrMap : iScrMap
{
    // S26IO: permission for unrelated physical world controls only.
    // Native exit callbacks, GUI ownership, B/distance exit and pickups are unchanged.
    bool VR_CanUseWorldControlsFromTerminal(const tString &in asEntityName)
    {
        return asEntityName=="StatusTerminal" ||
               asEntityName=="BloodTerminal";
    }

 [nosave] cVRTraversalGuidesHY mVRTraversalHY;

	//--------------------------------------------

	/////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	void Setup()
	{		
		GetBase().SetDisplayNameEntry("03-01-omicron-outside");
		RichPresence_SetCurrent(eRichPresence_OutsideOmicron );
		
		///////////////////////////////
		// Setup presets
		{
			// When outside and underwater
			Map_Preset_SetupDepthOfField("Outside", true, 0, 12.0, 0.25);
			Map_Preset_SetupBloom("Outside", 256, 0.00001, 0.5, cColor(0.5, 0.37, 0.37, 1.0));

			// In the dome
			Map_Preset_SetupDepthOfField("Dome", false, 0, 12.0, 0.25);
			Map_Preset_SetupBloom("Dome", 128, 0.75, 0.5, cColor(1.0, 1.0));

			// 3.2
			Map_Preset_SetupDepthOfField("3.2Preset", false, 0, 12.0, 0.25);
			Map_Preset_SetupBloom("3.2Preset", 128, 0.75, 0.5, cColor(1.0, 1.0));
		}
						
		Effect_DoF_Start(0, 12, 0.25, 0.0);

		Effect_Bloom_FadeBrightPass(0.00001, 2);
		Effect_Bloom_FadeBloomWidth(256, 2);
        Effect_Bloom_FadeBloomFalloff(0.5f, 2);
		Effect_Bloom_FadeBloomTint(0.5, 0.37, 0.37, 2);
		Map_SetUnderwater(true);
		
		cLux_GetCurrentMap().GetWorld().SetFogUnderwater(true);

		cTerrain@ pTerrain = cLux_GetCurrentMap().GetWorld().GetTerrain();
		if(pTerrain !is null) pTerrain.SetCheapMaterial("sand_wavy.mat", 0.5f);
		
		////////////////////
		//3.2 Preset for transition
		Map_Preset_SetupColorGrading("Omicron3.2", "textures/colorgrading/grading_03_02.dds");
		
		////////////////////
		// Entity init
		Entity_PlayAnimation("fish_sphere_*", "fish_sphere_sway", 0, true, true);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		CathTool_ResetScreen(eCathToolVariant_CathDelta);
		
		//Setup Particles
		ParticleSystem_SetActive("first_airlock_drain_particles_*", false);
		ParticleSystem_SetActive("second_airlock_drain_particles_*", false);
		
		/////////////////////////////
		//Preload Audio
		Sound_PreloadProject("03_01_omicron_outside");
		Sound_PreloadGroup("Flashback/Level/03_01", true);
		
		/////////////////////////////////
		//Audio fades
		Sound_SetGlobalVolume(0.0f, eSoundEntryType_WorldClean);
		Sound_SetGlobalVolume(0.0f, eSoundEntryType_World);
		
		SetupWakeUp(!cLux_ScriptDebugOn());
		SetupWalkToOmicron();
		SetupSubStation();
		SetupEnterOmicron();
		
		Tool_PickUp("CathTool", false, false);
		Player_SetAmbientLight_Outdoors();
		
		PlayerHands_SetHandModel_Diving();
		
		PlayerEnergy_SetFlowerSwallows(true);
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			//Add any debug stuff here
			//Map_SetUnderwater(false);
			
			cLux_SetDebugInfoWindowText("Text that should show up when pressing F1");
		}

		/////////////////////////
		// Eye tracking
		EyeTracking_RegisterEntity("DatamineArea_3", true, false, true, 15.0f, 3.0f);
		EyeTracking_RegisterEntity("RelayCorpseArea", true, false, true, 15.0f, 3.0f);
		EyeTracking_RegisterEntity("BridgeLookDownTrigger_2", false, false, false, -1.0f);
		
		LastOnSoma_SetText("03_01_omicron_outside_1");
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	    // Visual-only initialization also runs after save loading, which can skip OnEnter.
    void EnsureVRTraversalIA()
    {
        if(mVRTraversalHY.mvPoints.length()!=0)return;
        mVRTraversalHY.Add("SubBaseLadder_Outer",cVector3f(0.1570268f,-2.4922840f,0.0303175f),cVector3f(0.0000000f,1.0000000f,0.0000000f),cVector3f(-0.0171492f,-0.0000000f,0.9998529f));

        mVRTraversalHY.Add("SubBaseLadder_Outer",cVector3f(-0.3300839f,3.8883403f,-0.2022386f),cVector3f(0.0000000f,0.0000000f,-1.0000000f),cVector3f(0.0000002f,1.0000000f,0.0000013f));

        mVRTraversalHY.Add("ClimbArea_3",cVector3f(0.1108645f,-0.9675833f,0.0347009f),cVector3f(0.0000000f,1.0000000f,0.0000000f),cVector3f(-0.0025698f,0.0119075f,0.9999258f));

        mVRTraversalHY.Add("ClimbArea_3",cVector3f(-0.2804628f,2.0569402f,-0.0106805f),cVector3f(0.0000000f,0.0000000f,-1.0000000f),cVector3f(0.0007939f,0.9510499f,-0.3090363f));

        mVRTraversalHY.Add("ClimbArea_4",cVector3f(0.0982174f,-1.4815840f,0.0182613f),cVector3f(0.0000000f,1.0000000f,0.0000000f),cVector3f(-0.0116789f,0.0119084f,0.9998609f));

        mVRTraversalHY.Add("ClimbArea_4",cVector3f(-0.3968268f,2.9841800f,-0.2340872f),cVector3f(0.0000000f,0.0000000f,-1.0000000f),cVector3f(-0.0039951f,0.9396864f,0.3420139f));

    }

void OnEnter()
	{
        // HY ladder surfaces: source triangles recorded in ladder_coverage_hy.json.
        mVRTraversalHY.Dispose();EnsureVRTraversalIA();
        
        


        
        


        
        


		MainMenu_SetBGPhase(eMainMenuPhase_2_4_To_3_3);
		
		//PRELOAD SOUND
		
		/////////////////////////////////////////////////////////////
		// Regain control after fake knock out and flush
		if (cLux_GetExplorationModeActive())
		{
			Player_FadeMoveSpeedMulTo(1.f, 1.f);
			Player_FadeLookSpeedMulTo(1.f, 1.f);
			Player_StopLookAt(0);
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
 mVRTraversalHY.Dispose();
		PlayerEnergy_SetAllowCathComment(false);
	}

	//-------------------------------------------------------

	////////////////////////////
	// The player has died.
	void OnPlayerDead(int aType, const tString&in asSource)
	{
	}

	//-------------------------------------------------------
	
	void Update(float afTimeStep)
	{
 EnsureVRTraversalIA();mVRTraversalHY.Update(afTimeStep);
		////////////////////////////
		// Handle LookAtAbyss with eye tracking
		if (EyeTracking_IsEnvironmentReactive())
		{
			bool bPrevLookAtAbyssActive = mbLookAtAbyssActive;
			mbLookAtAbyssActive = EyeTracking_IsEntityBeingLookedAt("BridgeLookDownTrigger_2");
			float fDist = (Map_GetEntity("BridgeLookDownTrigger_2").GetPosition() - Player_GetPosition()).Length();
			if (fDist > 100.0f) return;
			if (bPrevLookAtAbyssActive == true && mbLookAtAbyssActive == false) SetAbyssEffectsActive(false);
			else if (bPrevLookAtAbyssActive == false && mbLookAtAbyssActive == true) SetAbyssEffectsActive(true);		
		}
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		////////////////////////////
		// Super debug button
		if (alAction == eAction_Test1)
		{
			cLuxClosestEntityData pData;
			if (!cLux_GetClosestEntity(cLux_GetPlayer().GetCamera().GetPosition(),cLux_GetPlayer().GetCamera().GetForward(),100, 0, false, pData))
				return;
				
			tString sFocusEntity = pData.mpEntity.GetName();
			
			SlideDoor_SetClosed(sFocusEntity, false, false);
			Button_SetDisabled(sFocusEntity, !Button_IsDisabled(sFocusEntity), true);
			Button_SetSwitchedOn(sFocusEntity, !Button_IsSwitchedOn(sFocusEntity), true);
		}
		
		if(alAction == eAction_Test2)
		{
			mbLockdownOverridden = true;
			OpenShutters();
			SlideDoor_SetClosed("SubBaseAirlockDoor_Outer", false);
		}
		
		if(alAction == eAction_Test3)
		{
			//Timer_FishSphereCacheUpdate("Timer_FishSphereCacheUpdate_1");
			cLux_AddDebugMessage("FOV: " + cLux_GetPlayer().GetCamera().GetFOV());
        }
		
		if(alAction == eAction_Test4)
		{
			//PreloadChangeOfMap();
			Seq_AirlockEmpty_Flush("");
		}
		
		if(alAction == eAction_Test5)
		{
			Sound_CreateAtEntity("PowerOn", "03_01_omicron_outside/Gameplay/fuse_puzzle/fuse_puzzle_success", "FuseSoundSource", 0.0f, false, 1.0f);
			Map_AddTimer("3_CathChatPowerPuzzleDone", 1, "PlayCathMiniConvo");				
			TurnOnPower();
		}
		
		if(alAction == eAction_Test6)
		{
			cLux_AddDebugMessage("mbResumeIdleDialogOnTerminalLeave "+mbResumeIdleDialogOnTerminalLeave );
		}
		
		if(alAction == eAction_Test7)
		{
			Preload();
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
		}
		
		if(alAction == eAction_Test8)
		{
			Map_SetEnvironmentParticleFadeIn("*", 0.1, 0.2);
			Map_SetEnvironmentParticleFadeOut("*", 0.3, 0.4);
		}
		if(alAction == eAction_Test9)
		{
			DomePowerSequence("");
		}
	}

