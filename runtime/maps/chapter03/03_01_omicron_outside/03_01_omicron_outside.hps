	//-------------------------------------------------------
	
	bool mbShuttersOpened = false;

	//-------------------------------------------------------
	
	void OpenShutters()
	{
		if (mbShuttersOpened) return;
		mbShuttersOpened = true;
		
		for (int i = 1; Entity_Exists("Shutter_"+i); i++)
		{
			Map_AddTimer("Shutter_"+i, cMath_RandRectf(0, 2), "TimerOpenSlideDoor");
		}
		MovingButton_SetLocked("SideDoorButton", false);
		
		Entity_SetActive("SupportCollapseTrigger_*", true);
		Entity_SetActive("DebrisCrossingLineTrigger_Normal", true);
		Entity_SetActive("DebrisCrossingLineTrigger_Early", false);
	}

