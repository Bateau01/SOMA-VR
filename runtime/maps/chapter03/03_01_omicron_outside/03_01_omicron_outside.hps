	/////////////////////////////////////////
	// Scene 2 Event E *Walk onto collapsed site*
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	bool Trigger_AbyssDamage(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (SequenceStates_IsActive("SequenceAbyssFall") || alState == -1) return true;
		
		cLux_AddDebugMessage("BeginFall " + alState + " " + asChild);
		
		SequenceAbyssFall("");
		
		return true;
	}

	//-------------------------------------------------------

	bool Trigger_AbyssDeath(const tString &in asParent, const tString &in asChild, int alState)
	{		
		if (alState == -1) return true;
		
		Entity_SetActive("BridgeLookDownTrigger_*", false);
		SetAbyssEffectsActive(false);
		
		SequenceStates_Resume("SequenceAbyssFall");
		
		return true;
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mAbyssFallSequence;
	
	void SequenceAbyssFall(const tString &in asTimer)
	{
		Sequence_Begin("SequenceAbyssFall", mAbyssFallSequence);
	
		// Silence everything except dark tone
		if (Sequence_DoStepAndPause(0))
		{
			//Stop Music
			mbAmbientMusicPlaying = false;
			Music_Stop(3.0, eMusicPrio_BgAmb);
			Music_Stop(3.0, eMusicPrio_BigEvent);
			Music_StopAll(3.0f);
			//Fade out level audio
			Sound_FadeGlobalVolume(0.0f ,3.0f, eSoundEntryType_World);
			Sound_FadeGlobalVolume(0.0f ,3.0f, eSoundEntryType_WorldClean);
			
			//Create Falling Sound
			Sound_CreateAtEntity("AbyssFall", "Player/action/underwater/abyss_fall", "Player", 0.0f, false, 1.0f);
			Prop_MoveLinearTo("AbyssWall_1", "AbyssFallLoopTrigger_1", 100, 20, 0, true);
			Prop_MoveLinearTo("AbyssWall_2", "AbyssFallLoopTrigger_1", 100, 20, 0, true);
			Prop_MoveLinearTo("AbyssWall_3", "AbyssFallLoopTrigger_1", 100, 20, 0, true);
			Prop_MoveLinearTo("AbyssWall_4", "AbyssFallLoopTrigger_2", 100, 20, 0, true);
			Prop_MoveLinearTo("AbyssWall_5", "AbyssFallLoopTrigger_2", 100, 20, 0, true);
			Prop_MoveLinearTo("AbyssWall_6", "AbyssFallLoopTrigger_2", 100, 20, 0, true);
			
			Effect_Fade_Out(3.5f);
		}
		
		if (Sequence_DoStepAndWait(2.f))
		{	
			// Setup scene for fall
			cLux_GetCurrentMap().GetWorld().SetDirectionalLightActive(false);
			Map_SetSkyBoxColor(cColor(0, 1));
			Map_SetEnvironmentParticleColor("*", cColor(0.177,0.446,0.508,0.392)*0.75);
			Map_SetEnvironmentParticleFadeOut("*", 1.5, 3.5);
			Map_SetEnvironmentParticleGravityVelocity(cVector3f_Up * 20);
			
			Player_Teleport("abyss_fall_loop", false);
			Player_SetMoveSpeedMul(0);
			Player_SetFootstepSoundsDisabled(true);
		}
		
		/////////////////////
		// Start falling
		if (Sequence_DoStepAndWait(2.f))
		{			
			Effect_Fade_In(1.f);
			
			Effect_Shake_Start(0.2, 2, 12, 0);
			
			//Breathing
			Sound_CreateAtEntity("HeavyBreathing", "Player/breaths/abyss/breathing", "Player", 0.0f, false, 1.0f);
		}
		
	
		else if (Sequence_DoStepAndWait(4.75f))
		{
			//Trigger Suit Pressure Alarm
			Sound_CreateAtEntity("PressureAlarmMediumSpeed", "Player/UI/Suit/pressure_alarm_medium", "Player", 0.0f, false, 1.0f);
		}
		
		else if (Sequence_DoStepAndWait(1.f))
		{
			//Stop Medium Alarm and Trigger Fast Alarm
			Sound_Stop("PressureAlarmMediumSpeed", 0.0f);
			Sound_CreateAtEntity("PressureAlarmHighSpeed", "Player/UI/Suit/pressure_alarm_high", "Player", 0.0f, false, 1.0f);
		}
		
		else if (Sequence_DoStepAndWait(2.5f))
		{
			//Trigger Suit Cracking Under Pressure
			Sound_CreateAtEntity("SuitCracking", "Player/action/underwater/abyss_suit_crack", "player", 0.0f, false);
		}
				
		else if (Sequence_DoStepAndWait(6.5f))
		{
			//Stop all sounds apart from the big finale, quick fade to black
			Sound_Stop("AbyssFall", 0.0f);
			Sound_Stop("PressureAlarmHighSpeed", 0.0f);
			
			//Suit Crack Open
			Sound_CreateAtEntity("SuitCrackOpen", "Player/action/underwater/abyss_suit_end", "player", 0.0f, false);
			Effect_Fade_Out(0.1f);
		}
		
		// Kill off player
		else if (Sequence_DoStepAndWait(2.f))
		{
			Player_SetFootstepSoundsDisabled(false);
			if (cLux_GetExplorationModeActive() == false)
			{
				Sound_PlayGui("Player/UI/death_hit", 1.0f, eSoundEntryType_Gui);
				Player_GiveDamage(1, 0, eDamageType_None, "");
			}
			else
			{
				Player_SetHealth(0.f);
			}
		}
	
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	bool LoopAbyssFall(const tString &in asParent, const tString &in asChild, int alState)
	{
		int lTrigger = cString_GetNumericSuffixInt(asParent);
		Entity_PlaceAtEntity(asChild, "AbyssWallSpawnArea_" + lTrigger);
		
		return true;
	}

	//-------------------------------------------------------
	
	bool Trigger_AbyssCheckpoint(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1 || Entity_PlayerIsInFront(asChild)==false) return true;
		
		return true;
	}

	//-------------------------------------------------------
	
	bool Trigger_AbyssDepthEffects(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1) return true;
		
		bool bActive = Entity_PlayerIsInFront(asChild);
		
		Entity_SetActive("BridgeLookDownTrigger_*", bActive);
		if (!bActive) SetAbyssEffectsActive(false);
		
		return true;
	}

	//-------------------------------------------------------
	
	bool Trigger_SwayArea(const tString &in asParent, const tString &in asChild, int alState)
	{
		cLux_AddDebugMessage("Trigger_SwayArea " + alState);
		if (alState == -1)
		{
			Player_FadeRunSpeedMulTo(1, 2);
			Player_FadeMoveSpeedMulTo(1, 2);
			Effect_Sway_FadeOut(2);
		}
		else
		{
			Player_FadeRunSpeedMulTo(0.33, 1);
			Player_FadeMoveSpeedMulTo(0.75, 1);
			Effect_Sway_FadeIn(0.18, 1, 1, Entity_GetVarFloat(asChild, ""));
		}
		return true;
	}

	//-------------------------------------------------------
	
	bool Trigger_DebrisFall(const tString &in asParent, const tString &in asChild, int alState)
	{
		cLux_AddTodoMessage("Sound: Some small debris come loose as player walks over it.");
		Sound_CreateAtEntity("DebrisFall", "03_01_omicron_outside/SFX/special/structure_fall/scaffold_panel_drop", "FallingDebris_1");
		Prop_SetStaticPhysics("FallingDebris_*", false);
		Entity_AddForce("FallingDebris_*", 1, false, false);
		return false;
	}

	//-------------------------------------------------------
	
	bool Trigger_DebrisCrossingComment(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (asChild == "DebrisCrossingLineTrigger_Early")
			Voice_Play("2_CrossingTheAbyssPrematurely");
		else
			Voice_Play("5_CrossingTheAbyss");
		return false;
	}

	//-------------------------------------------------------

	/////////////////////////////////////////
	// Scene 2 Event F *Look down into abyss.*
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	int mlImageTrailId = -1;
	bool mbLookAtAbyssActive = false;

	//-------------------------------------------------------
	
	void LookAtAbyss(const tString &in asEntity, int alState)
	{
		if (cLux_ScriptDebugOn()) return;
		if (EyeTracking_IsAiReactive()) return;
		cLux_AddDebugMessage("alState "+alState);
		SetAbyssEffectsActive(alState==1);
	}

	//-------------------------------------------------------
	
	void SetAbyssEffectsActive(bool abActive)
	{
		float fMul = abActive ? 0.7 : 1;
		float fSpeed = abActive ? 0.5 : 0.5;
		
		Player_FadeFOVMulTo(fMul, fSpeed);
		if (abActive)
		{
			mlImageTrailId = Effect_ImageTrail_Start(1.25, 2, -1, 0);
			Map_AddTimer("AbyssDangerEffect", cMath_RandRectf(0, 2), "TimerAbyssDangerEffect");
			
			if (mbLockdownOverridden)
			{
				for (int i = 1; i <= mlWauLightCount; i++)
				{
					Map_AddTimer("WauLight_"+i, cMath_RandRectf(0, 8), "TimerActivateWauLight");
				}
			}
		}
		else
		{
			Effect_ImageTrail_FadeOut(mlImageTrailId, 2);
			Map_RemoveTimer("AbyssDangerEffect");
			
			if (mbLockdownOverridden)
			{
				Entity_SetEffectsActive("WauLight_*", false, true);
				Map_AddTimer("WauLight_*", 1, "TimerSetEntityInactive");
				for (int i = 1; i <= mlWauLightCount; i++)
				{
					Map_RemoveTimer("WauLight_"+i);
				}
			}
		}			  
		
	}

	//-------------------------------------------------------
	
	void TimerAbyssDangerEffect(const tString &in asTimer)
	{
		float fEffectTime = cMath_RandRectf(0.5, 2);
		float fFadeIn = 1.f;
		float fFadeOut = 1.f;
		Effect_VideoDistortion_Start(0.4, fEffectTime, 1, 1);
		Map_AddTimer("AbyssDangerEffect", fEffectTime + fFadeIn + fFadeOut + cMath_RandRectf(0, 2), "TimerAbyssDangerEffect");
	}

	//-------------------------------------------------------
	
	void TimerActivateWauLight(const tString &in asTimer)
	{		
		float fTime = cMath_RandRectf(1, 5);
		Entity_SetActive(asTimer, true);
		Entity_SetEffectsActive(asTimer, true, true);
		Map_AddTimer(asTimer, fTime, "TimerTurnOffEffects");
		Map_AddTimer(asTimer, fTime+1, "TimerSetEntityInactive");
		Map_AddTimer(asTimer, fTime+cMath_RandRectf(2, 8), "TimerActivateWauLight");
	}

