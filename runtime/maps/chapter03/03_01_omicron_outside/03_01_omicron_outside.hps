	//-------------------------------------------------------
	
	bool Trigger_CloseToCuteBot(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
		{
			Voice_SetSource("CuteBot", Entity_GetVarString(asChild, ""), 2, 15, true, 12);
			Map_AddTimer("CuteBotSpeaks", 1, "TimerCuteBotSpeaks");
		}
		else
		{
			Map_RemoveTimer("CuteBotSpeaks");
		}
		return true;
	}
	
	void TimerCuteBotSpeaks(const tString &in asTimer)
	{
		Voice_Play("4_CloseToCuteBot");
		Map_AddTimer("CuteBotSpeaks", cMath_RandRectf(7, 10), "TimerCuteBotSpeaks");
	}

