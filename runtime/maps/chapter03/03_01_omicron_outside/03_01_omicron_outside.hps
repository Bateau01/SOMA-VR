	//-------------------------------------------------------
	
	int mlWauLightCount = 0;

	//-------------------------------------------------------
	
	void SetupWalkToOmicron()
	{
		Entity_SetEffectsActive("WauLight_*", false, false);
		for (int i = 1; Entity_Exists("WauLight_"+i); i++)
		{
			mlWauLightCount++;
		}
	}

	//-------------------------------------------------------
	
	bool mbVistaMusicPlayed = false;
	
	bool TriggerVistaMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbVistaMusicPlayed==false)
		{
			//graceful fadeout if music already playing
			Music_Stop(3.0f, eMusicPrio_BgAmb);
			Map_AddTimer("VistaMusicTimer", 3.1f, "VistaMusicPlay");
			mbVistaMusicPlayed = true;
		}
		else if (mbVistaMusicPlayed==true)
		{
			cLux_AddDebugMessage("Vista Music already triggered");
		}
		return false;
	}

	void VistaMusicPlay(const tString &in asTimer)
	{
		/////////////
		//Vista music
		cLux_AddDebugMessage("Trigger Vista Music");
		Music_PlayExt("03_01_fishfield.ogg", false, 0.65f, 1.0f, 0.0f, 0.0f, eMusicPrio_BigEvent, false);
		Sound_FadeGlobalVolume(0.65f, 8.0f,eSoundEntryType_WorldClean);
		Map_AddTimer("VistaMusicFadeUp", 15.0f, "VistaMusicFadeUpTimer");
	}

	//-------------------------------------------------------

	void VistaMusicFadeUpTimer(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 13.0f,eSoundEntryType_WorldClean);
		cLux_AddDebugMessage("Return mix to normal");
		Map_AddTimer("StartAmbient", cMath_RandRectf(25.0f,30.0f), "AmbientMusicHandler");
	}
	
	//-------------------------------------------------------

	void FadeQuickReturn(const tString &in asTimer)
	{
		Sound_FadeGlobalVolume(1.0f, 2.0f);
		cLux_AddDebugMessage("Return mix to normal");
	}
	
