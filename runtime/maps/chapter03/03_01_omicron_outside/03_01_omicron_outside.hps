	{
		ParticleSystem_Destroy("IntroBubblePS");
		return true;
	}

	//-------------------------------------------------------
	
	bool AnimationIntroGroundHit(const tString &in asEntity, int alDirection)
	{
		Effect_Shake_Start(0.09, 0.5, 0.2, 1.75);
		return true;
	}

	//-------------------------------------------------------
	
	bool AnimationIntroStopped(const tString &in asEntity, int alDirection)
	{
		Map_AddTimer("Timer_Achievement", 5, "Timer_Achievement");
		Map_AddTimer(asEntity, 2.5, "TimerIntroGetUp");
		ParticleSystem_SetActive("TunnelBubbles", true);
		Map_AddTimer("TunnelBubbles", 6, "TimerDestroyParticleSystem");
		
		Timer_FishSphereCacheUpdate("Timer_FishSphereCacheUpdate_1");
		
		return true;
	}

	//-------------------------------------------------------
	
	void TimerIntroGetUp(const tString &in asTimer)
	{
		CameraAnimationNode_SetAutoMove(asTimer, 0.45);
		Entity_SetActive("SealProximityTrigger", true);
	}
	
	void Timer_Achievement(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Achievement_Unlock");
		Achievement_Unlock(eAchievement_Dream);
	}

	//-------------------------------------------------------

	/////////////////////////////////////////
	// Scene 1 Event B *Examine broken tunnel*
	/////////////////////////////////////////

	//-------------------------------------------------------

	bool mbSealPoundTimerPaused = false;

	//-------------------------------------------------------
	//Akers is dead - this no longer applies
    /**
	bool Trigger_SealProximity(const tString &in asParent, const tString &in asChild, int alState)
	{
		cLux_AddDebugMessage("Trigger_SealProximity");
		if (alState == 1)
		{
			if (Entity_IsInteractedWith("ListScreen"))
			{
				mbSealPoundTimerPaused = true;
				return true;
			}
				
			Map_AddTimer("SealPound_1", 4, "TimerSealPounds");
		}
		else
		{
			Map_RemoveTimer("SealPound_1");
		}
		return true;
	}
	
	//-------------------------------------------------------

	void TimerSealPounds(const tString &in asTimer)
	{
		if (asTimer == "SealPound_1")
		{
			Entity_RemoveCollideCallback("player", "SealProximityTrigger");
			
			Sound_CreateAtEntity("SealBangSound", "03_01_omicron_outside/SFX/seal_banging/hit", "SealSource", 0, false, 1.0);
			ParticleSystem_SetActive("SealPoundPS_1", true);
			ParticleSystem_SetActive("SealPoundPS_2", true);
			ParticleSystem_SetActive("SealPoundPS_3", true);
			
			int lShake = Effect_Shake_Start(0.0175, 0.3, 0.05, 0.15);
			Effect_Shake_SetSourceEntity(lShake, "SealSource", 5, 10);
			
			Map_AddTimer("SealPound_2", 1.25, "TimerSealPounds");
		}
		else
		{			
			ParticleSystem_SetActive("SealPoundPS_4", true);
			ParticleSystem_SetActive("SealPoundPS_5", true);
			ParticleSystem_SetActive("SealPoundPS_6", true);
			
			int lShake = Effect_Shake_Start(0.0275, 0.3, 0.05, 0.15);
			Effect_Shake_SetSourceEntity(lShake, "SealSource", 5, 10);
		}
	}
	**/
	//-------------------------------------------------------
	
	void OnEnterListScreen(const tString&in asEntityName)
	{
		if (Map_GetTimerTime("SealPound_1") <= 0)
			return;
			
		mbSealPoundTimerPaused = true;
		Map_RemoveTimer("SealPound_1");
	}
	
	//-------------------------------------------------------
	
	void OnLeaveListScreen(const tString&in asEntityName)
	{
		if (!mbSealPoundTimerPaused)
			return;
			
		Map_AddTimer("SealPound_1", 4, "TimerSealPounds");
		mbSealPoundTimerPaused = false;
	}
	
