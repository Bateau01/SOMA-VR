	//-------------------------------------------------------
	
	void EnergyDrained_SubBaseFlower(const tString &in asEntity)
	{
		mbSubBaseFlowerDrained = true;
		
		Lamp_SetLit("SubBaseFlowerLamp_*", false, false);
		if (Lamp_GetLit("SubBaseWallLamp_5"))
		{
			Map_AddTimer("SubBaseWallLamp_5", 1, "TimerSetLampUnlit");
		
		}
	}

