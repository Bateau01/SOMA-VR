	//-------------------------------------------------------
	
	bool mbCatherineActiveInSubBase = false;
	bool mbResumeIdleDialogOnTerminalLeave = true;
	bool mbAirlockFull = true;
	bool mbAirlockFull_Audio = true;
	bool mbSubBaseFlowerDrained = false;
	array<tString> mvValidCodes;

	//-------------------------------------------------------
	
	void SetupSubStation()
	{
		Entity_SetVarBool("ElectricSwitch_*", "Powered", false);
		Entity_SetEffectBaseColor("AirlockValveLamp", cColor_Red);
		Entity_SetEffectBaseColor("AirlockPumpLamp", cColor_Red);
		Entity_SetEffectBaseColor("AirlockFlushLamp", cColor_Red);
		Entity_SetEffectBaseColor("AirlockValve_1_Lamp", cColor(1,0.1,0.1,1));
		Entity_SetEffectBaseColor("AirlockValve_2_Lamp", cColor(1,0.1,0.1,1));
		Entity_SetEffectBaseColor("AirlockPumpSwitch_Lamp", cColor(1,0.1,0.1,1));
		ParticleSystem_SetActive("SubStationLeakPS_*", false);
		
		Wheel_SetStuckState("AirlockValve_*", -1, false);
		
		Gui_CreateCameraTexture("OmicronCamera", cVector2l(768, 613), 12, 70.0f, 0.1, 60);
		Gui_AttachCameraTextureToEntity("OmicronCamera", "OmicronCamera");
		
		int lStartPassword = cMath_RandRectl(0, gvOverridePasswords.length()-1);
		for (int i = 0; i < gvOverridePasswords.length(); i++)
		{
			int lCodeIndex = cMath_Wrap(lStartPassword+i, -1, gvOverridePasswords.length()-1);
			mvValidCodes.push_back(gvOverridePasswords[lCodeIndex]);
		}
	}

	//-------------------------------------------------------

	/////////////////////////////////////////
	// Scene 3 Event A *Go through sub station airlock (dialog)*
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	int mlAirlockValveCount = 0;
	bool mbInAirlockWater = true;

	//-------------------------------------------------------
	
	bool Trigger_SubBaseAirlockEntrance(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1) return true;
		
		// Entered airlock
		if (Entity_PlayerIsInFront(asChild))
		{
			if (asChild == "InsideSubBaseAirlockTrigger_Outer")
			{
				Entity_SetActive("SubBaseAirlockBlocker_Outer", true);
			}
			return true;
		}
		
		// Left to outside
		if (asChild == "InsideSubBaseAirlockTrigger_Outer")
		{
			if (mbLockdownOverridden) OpenShutters();

		}
		return true;
	}

	//-------------------------------------------------------
	
	void Interact_ClimbSubBaseLadder(const tString &in asEntity)
	{
		Entity_SetActive("SubBaseAirlockBlocker_Outer", false);
		Entity_CallEntityInteract("SubBaseLadder_Outer");
	}

	//-------------------------------------------------------
	
	bool Trigger_OverrideHatchTorn(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1) return true;
		
		Entity_SetActive("OverrideZoomArea", true);
		
		return false;
	}

	//-------------------------------------------------------
	
	void OnChangeAirlockValve(const tString &in asEntity, int alState)
	{
		if (alState != 1) return;
		
		mlAirlockValveCount += 1;
		cLux_AddDebugMessage("mlAirlockValveCount "+mlAirlockValveCount);
		
		AirlockEffectsOpenValves();
		
		Entity_FadeEffectBaseColor(asEntity+"_Lamp", cColor(0.1,1,0.1,1), 0.1);
			
		if (mlAirlockValveCount==2)
		{
			Entity_FadeEffectBaseColor("AirlockValveLamp", cColor_Green, 0.3);
			DomeAirlockEnable();
		}
	}

	//-------------------------------------------------------
	
	void OnChangeAirlockPumpSwitch(const tString &in asEntity, int alState)
	{
		if (alState != 1) return;
		
		Entity_SetActive("SubBaseLadder_Outer_Aux_*", false);
		SlideDoor_SetClosed("SubBaseAirlockDoor_Outer", true);
		Sound_CreateAtEntity("SubBaseAirlockDoor_Outer_Close", "Entities_OceanBottom/airlock/door/slide_hatch_dome_close", "SubBaseAirlockDoor_Outer", 0.0f, false, 1.0f);
		Entity_FadeEffectBaseColor("AirlockPumpLamp", cColor_Green, 0.3);
		
		Entity_FadeEffectBaseColor(asEntity+"_Lamp", cColor(0.1,1,0.1,1), 0.1);
		
		Entity_SetActive("SubBaseLadder_Outer", false);
		
		cLux_AddDebugMessage("Hatch closing");
		
		AirlockEffectsTurnOnPumps();
	}

	//-------------------------------------------------------
	
	void DomeAirlockEnable()
	{
		Sound_CreateAtEntity("DomeAirlockActive", "03_01_omicron_outside/SFX/special/airlock_fail/dome_enable", "PumpsSource");
	}

	//-------------------------------------------------------
	
	void TimerPushAirlockDoorClosed(const tString &in asTimer)
	{
		Map_RemoveTimer("PushAirlockDoorOpen");
		if (SwingDoor_GetState("SubBaseAirlockDoor_Inner")==-1) 
		{

			SwingDoor_SetLocked("SubBaseAirlockDoor_Inner", true, true);
			SwingDoor_SetDisableAutoClose("SubBaseAirlockDoor_Inner", false);			
			return;
		}
		
		Prop_SetStaticPhysics("SubBaseAirlockDoor_Inner", false);
		Entity_AddForce("SubBaseAirlockDoor_Inner", cVector3f_Down*3500, true, true);
		Map_AddTimer("PushAirlockDoorClosed", 0.05, "TimerPushAirlockDoorClosed");
	}

	//-------------------------------------------------------
	
	void TimerPushAirlockDoorOpen(const tString &in asTimer)
	{
		Map_RemoveTimer("PushAirlockDoorClosed");
		if (SwingDoor_GetState("SubBaseAirlockDoor_Inner")==1) 
		{
			Map_AddTimer("SubBaseAirlockDoor_Inner", 0.25, "TimerSetPhysicsStatic");
			return;
		}
		
		if (SwingDoor_GetLocked("SubBaseAirlockDoor_Inner"))
		{
			Entity_SetActive("SubBaseAirlockBlocker_Inner", false);
			
			SwingDoor_SetLocked("SubBaseAirlockDoor_Inner", false, true);
			SwingDoor_SetClosed("SubBaseAirlockDoor_Inner", false, true);
			SwingDoor_SetDisableAutoClose("SubBaseAirlockDoor_Inner", true);
			
			Map_AddTimer("Timer_AutoSaveEnterSubBase", 3, "Timer_AutoSaveEnterSubBase");
		}
		
		Entity_AddForce("SubBaseAirlockDoor_Inner", cVector3f_Up*7000, true, true);
		Map_AddTimer("PushAirlockDoorOpen", 0.05, "TimerPushAirlockDoorOpen");
	}
	
	bool mbAutoSaveEnterSubBase = false;
	void Timer_AutoSaveEnterSubBase(const tString &in asTimer)
	{
		if (mbAutoSaveEnterSubBase) return;
		
		mbAutoSaveEnterSubBase = true;
		Game_AutoSave();
	}
 
    //-------------------------------------------------------
	
	cSequenceStatesData mAirlockEmptySequence;
		
	void Seq_AirlockEmpty(const tString &in asTimer)
	{
		Sequence_Begin("Seq_AirlockEmpty", mAirlockEmptySequence);
			
		if (Sequence_DoStepAndWait(0.66))
		{
			mbAirlockFull = false;
			
			Entity_SetActive("SubBaseLadder_Outer_Aux_*", false);
			SlideDoor_SetClosed("SubBaseAirlockDoor_Outer", true);
			Sound_CreateAtEntity("SubBaseAirlockDoor_Outer_Close", "Entities_OceanBottom/airlock/door/slide_hatch_dome_close", "SubBaseAirlockDoor_Outer", 0.0f, false, 1.0f);
			AirlockEffectsOpenValves();
			
			Entity_SetActive("SubBaseLadder_Outer", false);
		}
		else if (Sequence_DoStepAndWait(0.66))
		{
			mbAirlockFull_Audio = true;
		}
		else
		{
			Map_AddTimer("Seq_AirlockEmpty_Flush", 0, "Seq_AirlockEmpty_Flush");
		}
		Sequence_End();
	}
 
    //-------------------------------------------------------
	
	cSequenceStatesData mAirlockEmpty_ManualSequence;
		
	void Seq_AirlockEmpty_Flush(const tString &in asTimer)
	{
		Sequence_Begin("Seq_AirlockEmpty_Flush", mAirlockEmpty_ManualSequence);
			
		if (Sequence_DoStepAndWait(1.0))
		{
			mbAirlockFull = false;
			for (int i = 1; Entity_Exists("SubBaseAiriockVentArea_"+i);i++)
			{
				Map_AddTimer("VentBubbles_"+i, cMath_RandRectf(0, 1.5), "TimerCreateFlushBubbles");
			}
			/////////////////////////
			//Pump Sounds
			AirlockEffectsTurnOffPumps();
			Sound_CreateAtEntity("PumpUW", "Entities_OceanBottom/airlock/uw/pump/pump_loop", "PumpsSource", 0.0f, false, 1.0f);
			Entity_SetInteractionDisabled("AirlockFlushSwitch", true);
		}
		else if (Sequence_DoStepAndWait(7.25))
		{
			AirlockEffectsFlushWater();
			mbAirlockFull_Audio = false;
			Entity_SetActive("AirlockLiquidArea", true);
			LiquidArea_MoveLinearTo("AirlockLiquidArea","AirlockLiquidArea_Down",0.1, 1, 0.5, false);
			Map_SetUnderwater(false,false);
			Visibility_SetTerrainActive(false);
		}
        else if (Sequence_DoStepAndWait(0.75))
        {
            Map_SetUnderwater(false);
            Entity_SetInteractionDisabled("AirlockValve_*", true);
			
			ParticleSystem_CreateAtEntityExt("substation_airlock_drain_1", "03_01_substation_leak.ps", "substation_airlock_drain_1_area", false, cColor(1,1,1,1), 0.4);
			ParticleSystem_CreateAtEntityExt("substation_airlock_drain_2", "03_01_substation_leak.ps", "substation_airlock_drain_2_area", false, cColor(1,1,1,1), 0.5);
			ParticleSystem_CreateAtEntityExt("substation_airlock_drain_3", "03_01_substation_leak.ps", "substation_airlock_drain_3_area", false, cColor(1,1,1,0.379), 0.5);
			
			ParticleSystem_CreateAtEntityExt("substation_airlock_impact_1", "splash_continuous_med.ps", "substation_airlock_impact_1_area", false, cColor(1,1,1,0.488), 0.2);
			ParticleSystem_CreateAtEntityExt("substation_airlock_impact_2", "splash_continuous_med.ps", "substation_airlock_impact_2_area", false, cColor(1,1,1,0.488), 0.2);
			ParticleSystem_CreateAtEntityExt("substation_airlock_impact_3", "splash_continuous_med.ps", "substation_airlock_impact_3_area", false, cColor(1,1,1,0.488), 0.2);
			
			ParticleSystem_CreateAtEntityExt("substation_airlock_droplets_1", "drops_med_continuous.ps", "substation_airlock_droplets_1_area", false, cColor(1,1,1,1), 1);
			ParticleSystem_CreateAtEntityExt("substation_airlock_droplets_2", "drops_med_continuous.ps", "substation_airlock_droplets_2_area", false, cColor(1,1,1,1), 1);
			ParticleSystem_CreateAtEntityExt("substation_airlock_droplets_3", "drops_med_continuous.ps", "substation_airlock_droplets_3_area", false, cColor(1,1,1,1), 1);
        }
		else if (Sequence_DoStepAndWait(1))
		{
			//ground foam
			ParticleSystem_CreateAtEntityExt("substation_foam_1", "03_01_substation_foam.ps", "substation_foam_1_area", false, cColor(1,1,1,0.387), 0.125);
			ParticleSystem_CreateAtEntityExt("substation_foam_2", "03_01_substation_foam.ps", "substation_foam_2_area", false, cColor(1,1,1,0.473), 0.25);
			ParticleSystem_CreateAtEntityExt("substation_foam_3", "03_01_substation_foam.ps", "substation_foam_3_area", false, cColor(1,1,1,0.473), 0.25);
			ParticleSystem_CreateAtEntityExt("substation_foam_4", "03_01_substation_foam.ps", "substation_foam_4_area", false, cColor(1,1,1,0.473), 0.124);
		}
		else if (Sequence_DoStepAndWait(1))
		{
		    ParticleSystem_Destroy("substation_airlock_drain_1");
		    ParticleSystem_Destroy("substation_airlock_impact_1");
		}
		else if (Sequence_DoStepAndWait(2))
		{
		    ParticleSystem_Destroy("substation_airlock_drain_*");
		    ParticleSystem_Destroy("substation_airlock_impact_*");
		}
		else if (Sequence_DoStepAndWait(1))
		{
			Map_SetEnvironmentParticlesActive(false);
            //Delay for hatch to open
            Map_AddTimer("PushAirlockHatchOpen", 5.0f, "TimerPushAirlockDoorOpen");
			Entity_SetActive("InsideSubStationMain", true);
			Entity_SetActive("AirlockLiquidArea", false);
			ParticleSystem_Destroy("substation_airlock_droplets_*");
		}
		else
		{
			Button_SetSwitchedOn("AirlockButton", false, true);
			Entity_SetActive("AirlockOmniToolArea", true);
		}
		
		Sequence_End();
	}
 
    //-------------------------------------------------------
	
	void TimerCreateFlushBubbles(const tString &in asTimer)
	{
		int lIndex = cString_GetNumericSuffixInt(asTimer);
		ParticleSystem_CreateAtEntity(asTimer, "loop_waterbubbles_medium_stream.ps", "SubBaseAiriockVentArea_"+lIndex, false);
		Map_AddTimer(asTimer, 1, "TimerDestroyParticleSystem");
	}
 
    //-------------------------------------------------------
	
	void AirlockEffectsOpenValves()
	{
		
	}
 
    //-------------------------------------------------------
	
	void AirlockEffectsTurnOnPumps()
	{
		if (mbAirlockFull_Audio==false)
		{
				//airlock not full, play non-underwater idle sound
				Sound_CreateAtEntity("Pump_Idle_Loop_Air", "Entities_OceanBottom/airlock/air/pump/idle_loop", "PumpsSource", 1.0f, false, 1.0f); 
		}
		else if (mbAirlockFull_Audio==true)
		{
				//airlock is full play underwater idle sound
				Sound_CreateAtEntity("Pump_Idle_Loop_Underwater", "Entities_OceanBottom/airlock/uw/pump/idle_loop", "PumpsSource", 1.0f, false, 1.0f);
		}
	}
 
    //-------------------------------------------------------
	
	void AirlockEffectsTurnOffPumps()
	{
		if (mbAirlockFull_Audio==false)
		{
				//Airlock not full, play air idle sound
				Sound_Stop("Pump_Idle_Loop_Air", 1.0f);
		}
		else if (mbAirlockFull_Audio==true)
		{
				//Airlock is full play underwater idle sound
				Sound_Stop("Pump_Idle_Loop_Underwater", 1.0f);
		}
	}
 
    //-------------------------------------------------------
	
	void AirlockEffectsFlushWater()
	{
		Depth_Audio_AirlockDrainLeadInUW();
		Depth_Audio_AirlockDrainLoopUW();
		Map_AddTimer("AirlockDrainUWStopTimer", 7.25f, "AirlockDrainUWStop");
	}
	
	void AirlockEffectsFlushWaterFinalAirlock()
	{
		Depth_Audio_AirlockDrainLeadInUW();
		Depth_Audio_AirlockDrainLoopUW();
		Map_AddTimer("AirlockDrainUWStopTimer", 8.75f, "AirlockDrainUWStopFinalAirlock");
	}
 
    //-------------------------------------------------------
	
	void AirlockDrainUWStop(const tString &in asTimer)
	{
		AirlockSoundLogic();
		Depth_Audio_PlayLeaveWater();
		Sound_Stop("PumpUW", 0.55f);
		Sound_CreateAtEntity("PumpingAirLoop", "Entities_OceanBottom/airlock/air/pump/pump_loop_nointro", "PumpsSource", 0.55f, false, 1.0f);
		Depth_Audio_AirlockDrainLoopUWStop();
		Depth_Audio_AirlockDrainLoopAir();
		Map_AddTimer("AirlockDrainingAirStopTimer", 3.0f, "AirlockDrainingAirStop");
	}
	
	void AirlockDrainUWStopFinalAirlock(const tString &in asTimer)
	{
		Depth_Audio_PlayLeaveWater();
		Sound_Stop("FauxPump", 0.55f);
		Sound_CreateAtEntity("PumpingAirLoop", "Entities_OceanBottom/airlock/air/pump/pump_loop_nointro", "FauxAirlockMotorSource", 0.55f, false, 1.0f);
		Depth_Audio_AirlockDrainLoopUWStop();
		Depth_Audio_AirlockDrainLoopAir();
		Map_AddTimer("AirlockDrainingAirStopTimer", 3.0f, "AirlockDrainingAirStopFinalAirlock");
	}
	 
    //-------------------------------------------------------
	
	void AirlockDrainingAirStop(const tString &in asTimer)
	{
		Depth_Audio_AirlockDrainLoopAirStop();
		Depth_Audio_AirlockDrainLeadOutAir();
		Sound_Stop("PumpingAirLoop", 0.25f);
		Sound_CreateAtEntity("PumpAirLeadOut", "Entities_OceanBottom/airlock/air/pump/pump_end", "PumpsSource", 0.0f, false, 1.0f);
		AirlockEffectsTurnOnPumps();
	}
	
	void AirlockDrainingAirStopFinalAirlock(const tString &in asTimer)
	{
		Depth_Audio_AirlockDrainLoopAirStop();
		Depth_Audio_AirlockDrainLeadOutAir();
		Sound_Stop("PumpingAirLoop", 0.25f);
		Sound_CreateAtEntity("PumpAirLeadOut", "Entities_OceanBottom/airlock/air/pump/pump_end", "FauxAirlockMotorSource", 0.0f, false, 1.0f);
		AirlockEffectsTurnOnPumps();
	}
	 
    //-------------------------------------------------------
	
	void AirlockEffectsFillWithWater()
	{
		Depth_Audio_AirlockFillingLeadInAir();
		Depth_Audio_AirlockFillingLoopAir();
		Map_AddTimer("AirlockFillingAirStopTimer", 10.f, "AirlockFillingAirStop");
	}
	 
    //-------------------------------------------------------
	
	void AirlockFillingAirStop(const tString &in asTimer)
	{
		AirlockSoundLogic();
		Depth_Audio_PlayEnterWater();
		Depth_Audio_AirlockFillingLoopAirStop();
		Depth_Audio_AirlockFillingLoopUW();
		
		///////////////////
		//Pump Sounds
		Sound_Stop("PumpingAirLoop", 0.5f);
		Sound_CreateAtEntity("PumpUW", "Entities_OceanBottom/airlock/uw/pump/pump_loop_nointro", "PumpsSource", 0.0f, false, 1.0f);
		Map_AddTimer("AirlockFillingLoopUWStopTimer", 5.0f, "AirlockFillingLoopUWStop");
	}
	 
    //-------------------------------------------------------
	
	void AirlockFillingLoopUWStop(const tString &in asTimer)
	{
		Depth_Audio_AirlockFillingLoopUWStop();
		Depth_Audio_AirlockFillingLeadOutUW();
		
		///////////////////
		//Pump Sounds
		Sound_CreateAtEntity("PumpUWLeadOut", "Entities_OceanBottom/airlock/uw/pump/pump_end", "PumpsSource", 0.0f, false, 1.0f);
		Sound_Stop("PumpUW", 0.5f);
		AirlockEffectsTurnOnPumps();		
	}
	 
    //-------------------------------------------------------
	
	bool mbIsAirlockEmptySound = false;
	
	void AirlockSoundLogic()
	{
		if (mbIsAirlockEmptySound==false)
		{
			cLux_AddDebugMessage("Air Sound Areas Active");
			Entity_SetActive("AMB_Airlock_Air", true);
			Entity_SetActive("AMB_Dome", true);
            Entity_SetActive("AMB_Global_1", false);
			Entity_SetActive("AMB_Airlock_UW", false);
            
			Map_AddTimer("HatchSoundTimer", 7.05f, "HatchSound");
			
			KillFieldAmbienceMusic();
			mbIsAirlockEmptySound = true;
		}
		
		else if (mbIsAirlockEmptySound==true)
		{
			cLux_AddDebugMessage("Air Sound Areas Disabled");
			Entity_SetActive("AMB_Airlock_UW", true);
           Entity_SetActive("AMB_Global_1", true);
			Entity_SetActive("AMB_Airlock_Air", false);
			Entity_SetActive("AMB_Dome", false);
			
			mbIsAirlockEmptySound = false;
		}
	}
	 
    //-------------------------------------------------------
	
	void HatchSound(const tString &in asTimer)
	{
		if (SwingDoor_GetState("SubBaseAirlockDoor_Inner")==-1)
		{
			Sound_CreateAtEntity("AirlockHatchOpen", "Entities_OceanBottom/doors/hatch/air/open", "HatchSoundSource", 0.0f, false, 1.0f);
			GeneratorSoundOn();
			cLux_AddDebugMessage("Hatch Opening");
		}
		
		else if (SwingDoor_GetState("SubBaseAirlockDoor_Inner")==1) 
		{
			Sound_CreateAtEntity("AirlockHatchClose", "Entities_OceanBottom/doors/hatch/air/close", "HatchSoundSource", 0.0f, false, 1.0f);
			GeneratorSoundOff();
			cLux_AddDebugMessage("Hatch Close");
		}

	}
	 
    //-------------------------------------------------------
	
	cSequenceStatesData mAirlockFillSequence;
		
	void Seq_AirlockFill(const tString &in asTimer)
	{
		Sequence_Begin("Seq_AirlockFill", mAirlockFillSequence);
		
		if(Sequence_DoStepAndWait(2.0))
        {
            //Slight delay for pacing
			mbAirlockFull = true;
        }
        else if (Sequence_DoStepAndWait(0.66))
		{
			Map_AddTimer("HatchSoundTimer", 0.05f, "HatchSound");
			TimerPushAirlockDoorClosed("");
			Entity_SetActive("InsideSubStationMain", false);
			Entity_SetActive("SubBaseAirlockBlocker_Inner", true);
		}
        else if (Sequence_DoStepAndWait(0.66))
		{
           AirlockEffectsOpenValves(); 
        }
		else if (Sequence_DoStepAndWait(0.66))
		{
			////////////////////
			//Pump non underwater triggered
			Sound_CreateAtEntity("PumpingAirLoop", "Entities_OceanBottom/airlock/air/pump/pump_loop", "PumpsSource", 0.0f, false, 1.0f);
			
			AirlockEffectsTurnOffPumps();
			mbAirlockFull_Audio = true;
		}
		else if (Sequence_DoStepAndWait(2.5))
		{
			AirlockEffectsFillWithWater();
		}
		else if (Sequence_DoStepAndWait(3.5))
		{
			Entity_SetActive("AirlockLiquidArea", true);
			LiquidArea_MoveLinearTo("AirlockLiquidArea","AirlockLiquidArea_Up",0.1, 1, 0.5, false);
		}
		else if (Sequence_DoStepAndWait(2))
		{
			ParticleSystem_CreateAtEntityExt("substation_airlock_fill_1", "03_02_airlock_fill.ps", "substation_airlock_fill_1_area", false, cColor(1,1,1,1), 1);
			ParticleSystem_CreateAtEntityExt("substation_airlock_fill_2", "03_02_airlock_fill.ps", "substation_airlock_fill_2_area", false, cColor(1,1,1,1), 1);
			ParticleSystem_CreateAtEntityExt("substation_airlock_fill_3", "03_02_airlock_fill.ps", "substation_airlock_fill_3_area", false, cColor(1,1,1,1), 1);
			ParticleSystem_CreateAtEntityExt("substation_airlock_fill_4", "03_02_airlock_fill.ps", "substation_airlock_fill_4_area", false, cColor(1,1,1,1), 1);
			ParticleSystem_CreateAtEntityExt("substation_airlock_fill_5", "03_02_airlock_fill.ps", "substation_airlock_fill_5_area", false, cColor(1,1,1,1), 1);
			ParticleSystem_CreateAtEntityExt("substation_airlock_fill_6", "03_02_airlock_fill.ps", "substation_airlock_fill_6_area", false, cColor(1,1,1,1), 1);
			ParticleSystem_CreateAtEntityExt("substation_airlock_fill_7", "splash_continuous_med.ps", "substation_airlock_fill_7_area", false, cColor(1,0.865,0.766,0.488), 1, true, 1, 2, 100, 110);
			ParticleSystem_CreateAtEntityExt("substation_airlock_fill_8", "splash_continuous_med.ps", "substation_airlock_fill_8_area", false, cColor(1,0.865,0.766,0.488), 1, true, 1, 2, 100, 110);
			ParticleSystem_CreateAtEntityExt("substation_airlock_fill_9", "splash_continuous_med.ps", "substation_airlock_fill_9_area", false, cColor(1,0.865,0.766,0.488), 1, true, 1, 2, 100, 110);
			ParticleSystem_CreateAtEntityExt("substation_airlock_fill_10", "splash_continuous_med.ps", "substation_airlock_fill_10_area", false, cColor(1,0.865,0.766,0.488), 1);
			ParticleSystem_CreateAtEntityExt("substation_airlock_fill_11", "splash_continuous_med.ps", "substation_airlock_fill_11_area", false, cColor(1,0.865,0.766,0.488), 1);
			ParticleSystem_CreateAtEntityExt("substation_airlock_fill_12", "splash_continuous_med.ps", "substation_airlock_fill_12_area", false, cColor(1,0.865,0.766,0.488), 1);
		}
		else if (Sequence_DoStepAndWait(2))
		{
		    ParticleSystem_Destroy("substation_airlock_fill_*");
		}
        else if (Sequence_DoStepAndWait(4.5))
		{
			Map_SetUnderwater(true, true);  
			ParticleSystem_CreateAtEntityExt("substation_airlock_bubbles", "oneshot_waterbubbles_huge.ps", "substation_airlock_bubbles_area", false, cColor(1,1,1,0.328), 0.5);
        }
		else if (Sequence_DoStepAndWait(3))
		{
			Entity_SetActive("AirlockLiquidArea", false);
			Map_SetEnvironmentParticlesActive(true);
		}
		else
		{
			Visibility_SetTerrainActive(true);

            Entity_SetActive("SubBaseLadder_Outer_Aux_*", true);
            SlideDoor_SetClosed("SubBaseAirlockDoor_Outer", false);
            Sound_CreateAtEntity("SubBaseAirlockDoor_Outer_Open", "Entities_OceanBottom/airlock/door/slide_hatch_dome_open", "SubBaseAirlockDoor_Outer", 0.0f, false, 1.0f);
			
            Entity_SetActive("SubBaseLadder_Outer", true);
            
            Button_SetSwitchedOn("AirlockButton", false, true);
            Entity_SetActive("AirlockOmniToolArea", true);
			
			Map_AddTimer("Timer_AutoSaveLeaveSubBase", 3, "Timer_AutoSaveLeaveSubBase");
        }
		
		Sequence_End();
	}
	
	bool mbAutoSaveLeaveSubBase = false;
	void Timer_AutoSaveLeaveSubBase(const tString &in asTimer)
	{
		if (mbPowerOn==false || mbAutoSaveLeaveSubBase) return;
		
		mbAutoSaveLeaveSubBase = true;
		Game_AutoSave();
	}

	//-------------------------------------------------------

	void CameraCollide_DomeAirlock(int alState)
	{			
		Map_SetEnvironmentParticlesActive(alState==1);
		
		if (alState==-1 && mbInAirlockWater)
		{
			mbInAirlockWater = false;
			
			if (!mbAirlockFull)
			{
				ParticleSystem_SetVisible("VentBubbles_*", false);
				if (!ParticleSystem_Exists("AirlockDrip"))
					ParticleSystem_CreateAtEntityExt("AirlockDrip", "03_01_airlock_drops.ps", "AirlockDripsArea", true, cColor_White, 0.00001f);
			}
			
			Player_SetAmbientLight_Indoors(true);
			Map_Preset_Fade("Dome", 0.5);
		}
		else if (alState==1 && mbInAirlockWater==false)
		{
			Effect_Screen_Start("water_splash_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 0.4f, 0.2f, 0.6f); 
			mbInAirlockWater = true;
			Player_SetAmbientLight_Outdoors(true);
			Map_Preset_Fade("Outside", 0);
		}
	}

	//-------------------------------------------------------
	
	void OnChangeActivateOverride(const tString &in asEntity, int alState)
	{
		Lever_SetStuckState("AirlockFlushSwitch", 0, true);
		Lever_SetStuckState("AirlockPumpSwitch", 0, true);
		Wheel_SetStuckState("AirlockValve_*", 0, true);
		Entity_FadeEffectBaseColor("AirlockValve_1_Lamp", cColor(0.75,0.5,0.1,1), 0.1);
		Entity_FadeEffectBaseColor("AirlockValve_2_Lamp", cColor(0.75,0.5,0.1,1), 0.1);
		Entity_FadeEffectBaseColor("AirlockPumpSwitch_Lamp", cColor(0.75,0.5,0.1,1), 0.1);
		
		Lamp_SetLit("AirlockValveLamp", true, true);
		Lamp_SetLit("AirlockPumpLamp", true, true);
		Lamp_SetLit("AirlockFlushLamp", true, true);
		
		Lamp_SetLit("OverrideStandbyLamp", false, true);
		
		if (alState != 1) return;
		Sound_CreateAtEntity("ButtonPress", "Entities_OceanBottom/button/plastic_red_push", asEntity);
	}

	//-------------------------------------------------------
	
	void OnChangeFlushSwitch(const tString &in asEntity, int alState)
	{
		if (alState != 1)
		{
			Lamp_SetFlickerActive("AirlockFlushLamp", false);
			return;
		}
		
		if (Lever_GetState("AirlockPumpSwitch") != 1 || mlAirlockValveCount < 2)
		{
			if (!SequenceStates_IsActive("Seq_AirlockUnstable"))
			{
				Seq_AirlockUnstable("");
			}
			
			Lamp_SetFlickerActive("AirlockFlushLamp", true);
			return;
		}
		
		Lever_SetStuckState(asEntity, 1, true);
		Entity_FadeEffectBaseColor("AirlockFlushLamp", cColor_Green, 0.3);
		
		Seq_AirlockEmpty_Flush("");
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mAirlockUnstableSequence;
	bool mbAirlockUnstableSequence = false;

	//-------------------------------------------------------
	
	/////////////////////////
	//added check to stop from spamming
	void Seq_AirlockUnstable(const tString &in asTimer)
	{
		if (mbAirlockUnstableSequence == false)
		{
			AirlockUnstableSequence("");
			mbAirlockUnstableSequence = true;
		}
		else if (mbAirlockUnstableSequence == true)
		{
			cLux_AddDebugMessage("Unstable Sequence already played");
		}
	}

	//-------------------------------------------------------

	void AirlockUnstableSequence(const tString &in asTimer)
	{
		Sequence_Begin("AirlockUnstableSequence", mAirlockUnstableSequence);
			
		if (Sequence_DoStepAndWait(3.4))
		{		
			cLux_AddDebugMessage("START");
			Sound_CreateAtEntity("AirlockUnstable", "03_01_omicron_outside/SFX/special/airlock_fail/dome", "Player");
			Music_FadeVolumeMul(0.3f, 2.5f);
		}
			
		else if (Sequence_DoStepAndWait(2))
		{
			Sound_SetGlobalVolume(0.25);
			Effect_Rumble_Start(0.5, 0.8, 0, 0.4);
			Effect_Shake_Start(0.025, 0.4, 0.1, 0.25, cVector3f(1, 0.25, 1), 32);
			Effect_Shake_Start(0.005, 0.5, 0.2, 3.0, cVector3f(1, 0.25, 1), 32);
			Effect_Sway_FadeIn(0.05, 1, 1, 0, 1, 0.25f, 0.995f, 0);
			cLux_AddDebugMessage("shaky");
		}
		
		else
		{
			Sound_FadeGlobalVolume(1, 3.5);
			Music_FadeVolumeMul(1.0f, 6.5f);
			Map_AddTimer("3_WrongValveComment", 0.25, "TimerPlayVoice");
			Effect_Sway_FadeOut(3);
			cLux_AddDebugMessage("DONE");
		}

		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	void OnGuiAirlockPowerStatus(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetTransCategory("03_01_omicron_outside");
		
		StationGuiBG_Scanlines();
		StationGuiBG_Backdrop();
		
		if (!mbPowerOn)
		{
			DoNoMainPowerScreen();
			return;
		}
		
		if (Button_IsSwitchedOn("AirlockButton"))
		{
			cStationGui_BigStatusMessageSettings statusMessage;
			statusMessage.mfTextSizeMul = 2;
			StationGui_BigStatusMessage(mbAirlockFull ? "AirlockFilling" : "AirlockFlushing", statusMessage);
		}
		else
		{
			cStationGui_BigStatusMessageSettings statusMessage;
			statusMessage.mColor = gStationGuiColor_Highlight;
			statusMessage.mfTextSizeMul = 2;
			StationGui_BigStatusMessage("AirlockReady", statusMessage);
		}
		
	}

	//-------------------------------------------------------

	/////////////////////////////////////////
	// Scene 3 Event B *Enter substation*
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	bool mbHasEnteredSubbase = false;

	//-------------------------------------------------------

	bool Trigger_InsideSubStationMain(const tString &in asParent, const tString &in asChild, int alState)
	{		
		if (alState == 1)
		{
			ResumeSubStationIdleDialog(4);
			AirlockEffectsTurnOffPumps();
            if(mbLeakSoundFade==true)
            {
                //Sound_Fade("LeakSound", 0.75f, 2.0f);
            }
            else if(mbLeakSoundFade==false)
            {
               //Sound_Fade("LeakSound", 1.0f, 2.0f); 
            }
			
			cLux_AddDebugMessage("turn off pumps");
			if (mbHasEnteredSubbase) return true;
			Map_AddTimer("SubBaseUnstable", 4, "SequenceSubBaseUnstable");
		}
		else
		{
			AirlockEffectsTurnOnPumps();
			Sound_Fade("LeakSound", 0.35f, 3.0f);
			cLux_AddDebugMessage("turn on pumps");
			StopSubStationIdleDialog(/*false*/);
			Map_RemoveTimer("SubBaseUnstable");
		}
		return true;
	}

	//-------------------------------------------------------
	
	cSequenceStatesData mSubBaseUnstableSequence;
		
	void SequenceSubBaseUnstable(const tString &in asTimer)
	{
		Sequence_Begin("SequenceSubBaseUnstable", mSubBaseUnstableSequence);
			
		if (Sequence_DoStepAndWait(1.25))
		{
			mbHasEnteredSubbase = true;
			Sound_CreateAtEntity("SubBaseCreak", "03_01_omicron_outside/SFX/special/dome_tremor", "Player");
			Sound_FadeGlobalVolume(0.6f, 1.5f, eSoundEntryType_World);
            Entity_SetActive("hatch_omicron_substation_1", false);
		}
		else if (Sequence_DoStepAndWait(0.75))
		{
			Effect_Shake_Start(0.1, 0, 0.1, 1, cVector3f(1, 0.25, 1), 32);
			Effect_Sway_FadeIn(0.15, 1, 1, 0, 1, 0.25f, 0.995f, 0);
			Depth_Audio_Fear_MediumIntensity();
		}
		else if (Sequence_DoStepAndWait(2.25))
		{
			Sound_FadeGlobalVolume(1.0f, 4.0f, eSoundEntryType_World);
		}
		else if (Sequence_DoStepAndWait(2))
		{
			Effect_Sway_FadeOut(0.5);
		}
		else
		{
			PlaySubStationMusic();
		}
		Sequence_End();
	}

