	//-------------------------------------------------------
	
	void OnChangeEndLevel(const tString &in asEntity, int alState)
	{
		Entity_SetActive("SideAirlockOmniToolArea", false);
		Entity_SetInteractionDisabled(asEntity, true);
		SlideDoor_SetClosed("Omicron_SideDoor", true);
		Seq_EndOfLevel("");
	}

	//-------------------------------------------------------
	
	cSequenceStatesData mEndOfLevelSequence;
		
	void Seq_EndOfLevel(const tString &in asTimer)
	{
		Sequence_Begin("Seq_EndOfLevel", mEndOfLevelSequence);
		
		if (Sequence_DoStepAndWait(4))
		{
			//Small delay to allow for door to close
			Prop_SetAllowMapTransfer("slidedoor_medium_vertical_airlock_1", false);
		}
		else if (Sequence_DoStepAndWait(1.5))
		{
			PreloadDeload();	
		}
		else if (Sequence_DoStepAndWait(3.5))
		{
			////////////////////
			//faux airlock sounds
			Sound_Stop("side_airlock_idle", 1.0f);
			Sound_CreateAtEntity("FauxPump", "Entities_OceanBottom/airlock/uw/pump/pump_loop", "FauxAirlockMotorSource", 0.0f, false, 1.0f);
			AirlockEffectsFlushWaterFinalAirlock();
				
			Entity_SetActive("LiquidArea_1", true);
			FogArea_SetVisible("LiquidArea_1_Fog", false);
			
			for (int i = 1; Entity_Exists("AuxAirlockBubbleArea_"+i);i++)
			{
				Map_AddTimer("AuxAirlockBubbleArea_"+i, cMath_RandRectf(0, 1), "TimerCreateEndFlushBubbles");
			}
		}

		else if (Sequence_DoStepAndWait(5.0))
		{
			LiquidArea_MoveLinearTo("LiquidArea_1", "LiquidArea_Target", 0.5, 0.5, 1);
		}
		
		else if (Sequence_DoStepAndWait(4.0))
		{
			Map_SetUnderwater(false);
			
			ParticleSystem_Destroy("first_airlock_drain_particles_*");
			Entity_SetActive("AMB_Airlock_SideEntrance", false);
			Entity_SetActive("AMB_Airlock_SideEntrance_Air", true);
			
			cLux_AddDebugMessage("Air areas");
		}
		else if (Sequence_DoStepAndWait(7.5))
		{
			ParticleSystem_Destroy("second_airlock_drain_particles_*");
			ParticleSystem_Destroy("EndAirlockSplashParticles_*");
		}
		else if (Sequence_DoStepAndWait(0.3))
		{
			//Effect_Shake_Start(0.0175, 0.3, 0.05, 0.15);
			
			// Failsafe for abyss effects not clearing
			Player_FadeFOVMulTo(1, 10);
			Effect_ImageTrail_Clear();
			Entity_SetActive("BridgeLookDownTrigger_*", false);
			Map_RemoveTimer("AbyssDangerEffect");
			Entity_SetEffectsActive("WauLight_*", false, false);
			Entity_SetActive("WauLight_*", false);
			for (int i = 1; i <= mlWauLightCount; i++)
			{
				Map_RemoveTimer("WauLight_"+i);
			}
		}
		else
		{
			//cLux_SetGamePaused(true);
			PreloadChangeOfMap();
		}
		
		Sequence_End();
	}
 
    //-------------------------------------------------------
	
	void TimerCreateEndFlushBubbles(const tString &in asTimer)
	{
		int lIndex = cString_GetNumericSuffixInt(asTimer);
		ParticleSystem_CreateAtEntityExt(asTimer, "loop_waterbubbles_medium_stream.ps", "AuxAirlockBubbleArea_"+lIndex, false, cColor(0.487,0.628,0.7,0.25), 0.25);
		Map_AddTimer(asTimer, 0.75, "TimerDestroyParticleSystem"); cLux_AddDebugMessage("TimerCreateEndFlushBubbles");
	}

	//-------------------------------------------------------
	
	void CollideAirlockWater(int alState)
	{
		if(alState == -1)
		{
			ParticleSystem_SetActive("first_airlock_drain_particles_*", true);
			ParticleSystem_SetActive("second_airlock_drain_particles_*", true);
			ParticleSystem_SetVisible("first_airlock_drain_particles_*", true);
			ParticleSystem_SetVisible("second_airlock_drain_particles_*", true);
			
			for (int i = 1; Entity_Exists("EndAirlockSplashPSArea_"+i); i++)
			{
				if (ParticleSystem_Exists("EndAirlockSplashParticles_"+i))
					continue;

				ParticleSystem_CreateAtEntity("EndAirlockSplashParticles_"+i, "03_01_substation_leak_impact", "EndAirlockSplashPSArea_"+i, true);
			}
			
			for (int i = 1; ParticleSystem_Exists("AuxAirlockBubbleArea_"+i); i++)
			{
				ParticleSystem_SetVisible("AuxAirlockBubbleArea_"+i, false);
			}
			
			Map_Preset_Fade("3.2Preset", 0.25);
			Map_AddTimer("FadeGlobal", 0.5, "PreloadTimer");
			
			Entity_SetActive("AMB_Airlock_SideEntrance_NoWater", true);
			Entity_SetActive("AMB_Airlock_SideEntrance", false);
			
			Map_SetEnvironmentParticlesActive(false);
			
			Depth_Audio_PlayLeaveWater();
		}
		
		else
		{
			ParticleSystem_SetVisible("first_airlock_drain_particles_*", false);
			ParticleSystem_SetVisible("second_airlock_drain_particles_*", false);
			if (ParticleSystem_Exists("EndAirlockSplashParticles_1"))
				ParticleSystem_SetVisible("EndAirlockSplashParticles_*", false);
			
			for (int i = 1; ParticleSystem_Exists("AuxAirlockBubbleArea_"+i); i++)
			{
				ParticleSystem_SetVisible("AuxAirlockBubbleArea_"+i, true);
			}
			
			Entity_SetActive("AMB_Airlock_SideEntrance", true);
			Entity_SetActive("AMB_Airlock_SideEntrance_NoWater", false);
			
			Map_SetEnvironmentParticlesActive(true);
			
			Depth_Audio_PlayEnterWater();
		}
	}
	
	//-------------------------------------------------------
 
    /////////////////////////////////////////
    // ==============
    // PRELOAD
    // ==============
    /////////////////////////////////////////
 
    //-------------------------------------------------------
	
	bool PreloadDisabled(bool abCheckIfPreloading = true)
	{
		if(cLux_ScriptDebugOn())
		{
			cLux_AddDebugMessage("PRELOAD DISABLED!"); 
			
			return true;
		}

		if(abCheckIfPreloading == true && Map_IsPreloading() == false)
			return true;
			
		return false;
	}
	
	//-------------------------------------------------------
	
	void Preload()
	{
		if(PreloadDisabled(false)) return;
		
		Map_Preload("03_02_omicron_inside.hpm");
	}
	
	//-------------------------------------------------------
	
	void PreloadDeload()
	{
		if(PreloadDisabled()) return;
		
		Map_Deload("transfer3132");
		Map_SetPreloadPriority(eWorldStreamPriority_High);
	}
	
	//-------------------------------------------------------
	
	void PreloadChangeOfMap()
	{
		if(PreloadDisabled()) 
		{
			PreloadManualChangeMap();
			return;
		}
		
		Map_AddTimer("ChangeMap", 0, "PreloadTimer");
		Map_AddTimer("ChangeMapNotReady", 3, "PreloadTimer");
	}
	
	//-------------------------------------------------------
	
	bool mbGlobalCopyCompleted = false;
	void PreloadTimer(const tString &in asTimer)
	{
		////////////////////////////
		//Preload - Change map globals when possible.
		if(asTimer == "FadeGlobal")
		{
			if(mbGlobalCopyCompleted)
			{
				Map_Preset_Fade("Omicron3.2", 0.1); 
				return;
			}
			
			mbGlobalCopyCompleted = Map_CopyGlobalSettings(Map_GetPreloadMap(), 0.2);
			
			Map_AddTimer("FadeGlobal", 0.3, "PreloadTimer");
		}

		////////////////////////////
		//Preload - Change map when possible
		if(asTimer == "ChangeMap")
		{
			if(Map_IsPreloadCompleted())
			{				
				Description_SetForceFading(true);
				Map_ChangeMap("03_02_omicron_inside.hpm", "", "transfer3132", "", "");
			}
			else Map_AddTimer("ChangeMap", 0.6f, "PreloadTimer");
		}
		
		if(asTimer == "ChangeMapNotReady")
		{
			Description_Add("02_05_theta_inside", "ScanRoom_Legacy_Loading", 10, false);
			Map_SetPreloadPriority(eWorldStreamPriority_VeryHigh);
		}
	}
	
	//-------------------------------------------------------
	
	void PreloadManualChangeMap()
	{
		Map_ChangeMap("03_02_omicron_inside.hpm", "PlayerStartArea_1", "", "");
	}
	
