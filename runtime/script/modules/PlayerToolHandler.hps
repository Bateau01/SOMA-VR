	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnAction(int alAction, bool abPressed)
	{
		if (!_HPL3VR_RuntimeActive_ToolHandler())
		{
				if(abPressed==false) return;
				if(mlCurrentToolIndex < 0) return;
				
				cToolData@ pCurrentTool = mvInventory[mlCurrentToolIndex];
				if(pCurrentTool.m_idHudObject == tID_Invalid) return;
				
				////////////////////////////
				// Use Tool
				if(alAction == eAction_Interact)
				{
					/////////////////////////////////////
					// Check if interaction possible
					if(pCurrentTool.msUseCallback == "") return;
			
					tString sFocusEntity = mPickBasics.msFocusedEntityName;
					if(sFocusEntity=="") return;
								
					if(mbCanInteract==false) return;
								
					/////////////////////////////////////
					// Call callback
					cLuxMap@ pMap = cLux_GetCurrentMap();
					if(pMap.ScriptPrepare("bool "+pCurrentTool.msUseCallback+"(const tString &in asToolName, const tString &in asFocusEntity)" ) )
					{
						tString sToolName = pCurrentTool.msPickedEntityName;
						pMap.SetArgString(0, sToolName);
						pMap.SetArgString(1, sFocusEntity);
						
						if(pMap.ScriptExecute())
						{
							if(pMap.GetReturnBool())
							{
								RemoveTool(sToolName); // Remove tool from inventory by default
							}
						}
					}
				}
			return;
		}
		if(abPressed==false) return;
		if(mlCurrentToolIndex < 0) return;
		
		cToolData@ pCurrentTool = mvInventory[mlCurrentToolIndex];
		if(pCurrentTool.m_idHudObject == tID_Invalid && !VR_IsPhysicalWorldTool(pCurrentTool)) return;
		
		////////////////////////////
		// Use Tool
		if(alAction == eAction_Interact)
		{
			// H57.56J O4: Catherine use is physical. Slot docking and OmniPanel
			// contact own activation; the flatscreen Interact-button callback is suppressed.
			if (VR_IsPhysicalWorldTool(pCurrentTool)) return;
			/////////////////////////////////////
			// Check if interaction possible
			if(pCurrentTool.msUseCallback == "") return;

			tString sFocusEntity = mPickBasics.msFocusedEntityName;
			if(sFocusEntity=="") return;
						
			if(mbCanInteract==false) return;
						
			/////////////////////////////////////
			// Call callback
			cLuxMap@ pMap = cLux_GetCurrentMap();
			if(pMap.ScriptPrepare("bool "+pCurrentTool.msUseCallback+"(const tString &in asToolName, const tString &in asFocusEntity)" ) )
			{
				tString sToolName = pCurrentTool.msPickedEntityName;
				pMap.SetArgString(0, sToolName);
				pMap.SetArgString(1, sFocusEntity);
				
				if(pMap.ScriptExecute())
				{
					if(pMap.GetReturnBool())
					{
						RemoveTool(sToolName); // Remove tool from inventory by default
					}
				}
			}
		}
	}
	
