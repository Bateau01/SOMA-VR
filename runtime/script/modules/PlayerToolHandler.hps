	//------------------------------------------------------------
	
	bool CanPickOrUseTool()
	{
		if(mbActive && (mState == eToolState_Hide))
			return false;
			
		if(mbActive==false && PlayerHands_IsActive()) return false;
		
		return true;
	}
	
	//------------------------------------------------------------
	
	bool CanEquipToolAreaTool()
	{
		if(mbActive && (mState == eToolState_Unhide))
			return false;
			
		if(mbActive==false && PlayerHands_IsActive()) return false;
		
		return true;
	}
	
	//------------------------------------------------------------
	
	bool GetPlayerCarriesHeavyTool()
	{
		if(mbActive==false) return false;
		
		bool bHeavyTool = false;
		cToolData@ pCurrentTool = null;
		if (mlCurrentToolIndex >= 0 && mlCurrentToolIndex < mvInventory.length())
		{
			@pCurrentTool = mvInventory[mlCurrentToolIndex];
			bHeavyTool = pCurrentTool.mbIsHeavy;
		}
		return bHeavyTool;
	}
	
	//------------------------------------------------------------
	
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Reset()
	{
		if (!_HPL3VR_RuntimeActive_ToolHandler())
		{
				mbPlayerCarriesHeavyTool=false;
				
				msPreviousTool = "";
				mlCurrentToolIndex = -1;
				mvInventory.resize(0);
				
				mbActive = false;
				mbCanInteract = false;
				
				mPickBasics.Reset();
				
				mState = eToolState_Idle;
				mPrevState = eToolState_Idle;
				
				SetupMoveStateMultipliers();
				
				mbFadeInDrawAnim=false;
			return;
		}
		mbPlayerCarriesHeavyTool=false;
		
		msPreviousTool = "";
		mlCurrentToolIndex = -1;
		mvInventory.resize(0);
		
		mbActive = false;
		mbCanInteract = false;
		
		mPickBasics.Reset();
		
		mState = eToolState_Idle;
		mPrevState = eToolState_Idle;
		
		SetupMoveStateMultipliers();
		
		mbFadeInDrawAnim=false;
		mbVRPhysicalOmniEnsured = false;
		mfVRPhysicalOmniEnsureTimer = 0.75f;
		msVRPhysicalOmniPanelCandidate = "";
		mfVRPhysicalOmniPanelCooldown = 0.0f;
		mbVROmniPanelAreasLoaded=false; mvVROmniPanelAreas.resize(0);
		msVRPhysicalUpgradeChipCandidate = "";
		msVRPhysicalUpgradeFocusTarget = "";
		msVRUpsilonToolChipCarrierName = "";
		mfVRPhysicalUpgradeChipCooldown = 0.0f;
		msVROmniPhysicalInsertTarget = "";
		mfVROmniPhysicalInsertCooldown = 0.0f;
		msVRShoulderUseTool = "";
		msVRShoulderUseTarget = "";
		msVRShoulderRetrievePending = "";
		mfVRShoulderUseCooldown = 0.0f;
		mbVRShoulderReconciled = false;
        mvVRReconciledCarriers.resize(0);
        mlBVChipRepair=0;
		mfVRShoulderReconcileTimer = 0.60f;
	}
	
	void SetActive(bool abX)
	{
		if(mbActive==abX) return;
		
		mbActive = abX;
		if(mbActive==false)
		{			
			mState = eToolState_Idle;
			mbCanInteract = false;
			
			PlayerHands_SetActive(false);
			SetToolInteractionAllowed(true);
		}		
	}
	
	bool IsActive()
	{
		return mbActive;
	}
	
	//------------------------------------------------------------

    // BL: a displayed carrier name is not necessarily a map callback target.
    // Delta accepts the authored zeppelin slot for either replacement chip,
    // including saves that already have the legacy crash carrier inserted there.
    tString VR_AuthoredUpgradeFocus(const tString &in map, const tString &in chip,
                                  const tString &in omni, const tString &in slot)
    {
        if(chip=="KateChip" || chip=="GoyaChip")
        {
            if(map!="02_03_delta" || slot!="ZeppelinCathTerminal") return "";
            if(omni!="CathTool" && omni!="CathTool_Crashed") return "";
            return slot;
        }
        return omni;
    }

	void VR_UpdatePhysicalUpgradeChipContact(float afTimeStep)
	{
		if (!_HPL3VR_RuntimeActive_ToolHandler()) return;
		if (mfVRPhysicalUpgradeChipCooldown > 0.0f)
		{
			mfVRPhysicalUpgradeChipCooldown -= afTimeStep;
			if (mfVRPhysicalUpgradeChipCooldown > 0.0f) return;
		}
		if (msVRInsertedOmniName == "") { mfVRPhysicalUpgradeChipCooldown = 0.05f; return; }
		cLuxMap@ pMapVR = cLux_GetCurrentMap();
		if (pMapVR is null) { mfVRPhysicalUpgradeChipCooldown = 0.05f; return; }

		for (uint i = 0; i < mvInventory.length(); ++i)
		{
			cToolData@ pChip = mvInventory[i];
			if (!VR_IsPhysicalUpgradeChip(pChip) || pChip.mbVRShoulderStowed) continue;

			// X: Upsilon's four visible tray chips are ordinary props. Vanilla uses an
			// invisible AreaGetToolChip_* to award hidden ConfigChipTool. In VR the prop
			// actually grabbed by the hand is retained as physical carrier while the
			// ConfigChipTool record remains the exact stock CanBeUsed/Use authority.
			if (pChip.msHandAnimationSuffix == "securitychip" && pChip.msPickedEntityName == "ConfigChipTool")
			{
				tString sCarrier = VR_GetPhysicalCarrierName(pChip);
				if (sCarrier != "" && sCarrier != pChip.msPickedEntityName)
				{
					pChip.msVRPhysicalCarrierName = sCarrier;
					msVRUpsilonToolChipCarrierName = sCarrier;
					iLuxEntity@ pCarrierEntity = pMapVR.GetEntityByName(sCarrier, eLuxEntityType_LastEnum, "");
					cLuxProp@ pCarrierProp = cast<cLuxProp>(pCarrierEntity);
					if (pCarrierProp is null) break;

					msVRPhysicalUpgradeChipCandidate = pChip.msPickedEntityName;
					cScript_RunGlobalFunc("VROMNICHIP", sCarrier, "B");
					iPhysicsBody@ pCarrierBody = pCarrierProp.GetMainBody();
					cScript_RunGlobalFunc("VROMNICHIP", sCarrier, "E");
					if (pCarrierBody !is null)
					{
						tString sToolChipTarget = "AreaInsertConfigChip";
						if (Entity_IsActive(sToolChipTarget))
						{
							if (Entity_GetCollide(sCarrier, sToolChipTarget))
							{
								msVRPhysicalUpgradeFocusTarget = sToolChipTarget;
								cScript_RunGlobalFunc("VROMNICHIP", sCarrier, "Z");
							}
							else
							{
								msVRPhysicalUpgradeFocusTarget = "";
								cScript_RunGlobalFunc("VROMNICHIP", sCarrier, "N");
							}
						}
						else msVRPhysicalUpgradeFocusTarget = "";
					}
					break;
				}
			}

			iLuxEntity@ pChipEntity = pMapVR.GetEntityByName(pChip.msPickedEntityName, eLuxEntityType_LastEnum, "");
			cLuxProp@ pChipProp = cast<cLuxProp>(pChipEntity);
			if (pChipProp is null) continue;
			cScript_SetGlobalReturnBool(false);
			if (!pChipEntity.ScriptPrepare("bool VR_Try_EnsurePhysicalUpgradeChip()") ||
                !pChipEntity.ScriptExecute() || !pChipEntity.GetReturnBool()) continue;
			msVRPhysicalUpgradeChipCandidate = pChip.msPickedEntityName;
			cScript_RunGlobalFunc("VROMNICHIP", msVRPhysicalUpgradeChipCandidate, "B");
			iPhysicsBody@ pChipBody = pChipProp.GetMainBody();
			cScript_RunGlobalFunc("VROMNICHIP", msVRPhysicalUpgradeChipCandidate, "E");
			if (pChipBody !is null)
			{
				if (pChip.msHandAnimationSuffix == "brainchip")
				{
					tString sCortexTarget = "Area_PutCortexOnOmniTool";
					if (Entity_IsActive(sCortexTarget))
					{
						if (Entity_GetCollide(msVRPhysicalUpgradeChipCandidate, sCortexTarget))
						{
							msVRPhysicalUpgradeFocusTarget = sCortexTarget;
							cScript_RunGlobalFunc("VROMNICHIP", msVRPhysicalUpgradeChipCandidate, "X");
						}
						else
						{
							msVRPhysicalUpgradeFocusTarget = "";
							cScript_RunGlobalFunc("VROMNICHIP", msVRPhysicalUpgradeChipCandidate, "A");
						}
					}
					else msVRPhysicalUpgradeFocusTarget = "";
				}
				else if (pChip.msHandAnimationSuffix == "securitychip" && pChip.msPickedEntityName == "ConfigChipTool")
				{
					// Legacy V fallback retained only for saves/flows where ConfigChipTool itself
					// is already the physical body and no visible tray carrier was registered.
					tString sToolChipTarget = "AreaInsertConfigChip";
					if (Entity_IsActive(sToolChipTarget))
					{
						if (Entity_GetCollide(msVRPhysicalUpgradeChipCandidate, sToolChipTarget))
						{
							msVRPhysicalUpgradeFocusTarget = sToolChipTarget;
							cScript_RunGlobalFunc("VROMNICHIP", msVRPhysicalUpgradeChipCandidate, "Y");
						}
						else
						{
							msVRPhysicalUpgradeFocusTarget = "";
							cScript_RunGlobalFunc("VROMNICHIP", msVRPhysicalUpgradeChipCandidate, "M");
						}
					}
					else msVRPhysicalUpgradeFocusTarget = "";
				}
				else
				{
					msVRPhysicalUpgradeFocusTarget = VR_AuthoredUpgradeFocus(pMapVR.GetName(), msVRPhysicalUpgradeChipCandidate, msVRInsertedOmniName, msVRInsertedOmniSlot);
					if(msVRPhysicalUpgradeFocusTarget!="") cScript_RunGlobalFunc("VROMNICHIP", msVRPhysicalUpgradeChipCandidate, "Q");
				}
			}
			break;
		}
		mfVRPhysicalUpgradeChipCooldown = 0.05f;
	}

	//------------------------------------------------------------

	bool VR_UpdateStreamMapReadiness(float afTimeStep)
	{
		if (mbVRStreamMapReady) return true;
		cLuxMap @pVRMap = cLux_GetCurrentMap();
		if (pVRMap is null)
		{
			mfVRStreamMapReadyTimer = 1.00f;
			return false;
		}
		if (!mbVRStreamMapReadyTokenSent)
		{
			mfVRStreamMapReadyTimer -= afTimeStep;
			if (mfVRStreamMapReadyTimer > 0.0f) return false;
			cScript_RunGlobalFunc("VROMNIMAP", "", "R");
			mbVRStreamMapReadyTokenSent = true;
			mfVRStreamPhysicalDelay = 0.20f;
			return false;
		}
		mfVRStreamPhysicalDelay -= afTimeStep;
		if (mfVRStreamPhysicalDelay > 0.0f) return false;
		mbVRStreamMapReady = true;
		return true;
	}

	void Update(float afTimeStep)
	{					
		if (!_HPL3VR_RuntimeActive_ToolHandler())
		{
				if(mbActive==false || mlCurrentToolIndex < 0) return;
				
				cToolData@ pCurrentTool = mvInventory[mlCurrentToolIndex];
				
				////////////////////////////////////////////
				// Check if tool has been displayed long enough
				if (mfAutoHideTimer >= 0)
				{
					mfAutoHideTimer -= afTimeStep;
					if (mfAutoHideTimer < 0)
					{
						mState = eToolState_Hide;
					}
				}
				
				//////////////////////////
				//Check if if anything in focus can be used by tool
				mbCanInteract = false;
				if(CanPickOrUseTool() && pCurrentTool.msCanBeUsedCallback!="" && mfAutoHideTimer < 0)
				{
					cCamera @pCam = cLux_GetPlayer().GetCamera();
					if(mPickBasics.UpdatePickCheck(pCam, false))
					{
						//iLuxEntity@ pPickedEntity = cLux_ID_Entity(mPickBasics.m_idFocusedEntity);
						//if(pPickedEntity !is null && pPickedEntity.GetInteractionDisabled()==false)
						{
							cLuxMap@ pMap = cLux_GetCurrentMap();
			
							if(pMap.ScriptPrepare("bool "+pCurrentTool.msCanBeUsedCallback+"(const tString &in asToolName, const tString &in asFocusEntity)" ) )
							{
								tString sTool = pCurrentTool.msPickedEntityName;
								pMap.SetArgString(0, sTool);
								tString sFocusedEntity = mPickBasics.msFocusedEntityName;
								pMap.SetArgString(1, sFocusedEntity);
								
								if(pMap.ScriptExecute())
								{
									if(pMap.GetReturnBool())
									{
										Player_SetCrossHairState(eCrossHairState(pCurrentTool.mlCustomUseIcon));
										mbCanInteract = true;
									}
								}
							}
						}
					}
				}
				
				//////////////////////////////////////////
				//This set if the normal player state can use interactions.
				SetToolInteractionAllowed(!mbCanInteract);
				
				/////////////////////////////////////////
				// State var setup
				eToolState lastState = mState;
				tString sEntity = cLux_ID_Entity(pCurrentTool.m_idHudObject).GetName();
				
				/////////////////////////////////////////
				// State: None
				if(mState == eToolState_Idle)
				{
					/////////////////////////
					// Enter state
					if(mPrevState != eToolState_Idle)
					{
						PlayerHands_PlayAnimation("tool_"+pCurrentTool.msHandAnimationSuffix+"_idle", true,false,0.2f,sEntity, false);
					}
				}
				/////////////////////////////////////////
				// State: Unhide
				else if(mState == eToolState_Unhide)
				{
					/////////////////////////
					// Enter state
					if(mPrevState != eToolState_Unhide)
					{
						PlayerHands_SetUseCustomPosition(false);
						PlayerHands_SetUseCustomRotation(false);
						
						float fFadeTime = mbFadeInDrawAnim ? 0.2f : 0.0f;
						PlayerHands_PlayAnimation("tool_"+pCurrentTool.msHandAnimationSuffix+"_draw", false,false,fFadeTime,sEntity, false);
						
						//cLux_AddDebugMessage("Enter Unhide");
					}
					
					/////////////////////////
					// Animation over
					if(PlayerHands_GetAnimationPlaying()==false)
					{
						mState = eToolState_Idle;
					}	
				}
				/////////////////////////////////////////
				// State: Hide
				else if(mState == eToolState_Hide)
				{
					/////////////////////////
					// Enter state
					if(mPrevState != eToolState_Hide)
					{
						PlayerHands_PlayAnimation("tool_"+pCurrentTool.msHandAnimationSuffix+"_holster", false,false,0.2f,sEntity, true);
						//cLux_AddDebugMessage("Enter Hide");
					}
					
					/////////////////////////
					// Animation over
					if(PlayerHands_GetAnimationPlaying()==false)
					{
						if(msPreviousTool!="") cScript_RunGlobalFunc(msPreviousTool, "", "_Global_OnUnequip");
						
						if (mbRemoveToolWhenHidden)
						{
							RemoveTool(mlCurrentToolIndex);
						}
						else 
						{
							mlCurrentToolIndex = -1;
							SetupMoveStateMultipliers();
						}
						SetActive(false);
					}	
				}
				/////////////////////////////////////////
				// State: Custom animation
				else if(mState == eToolState_CustomAnimation)
				{
					/////////////////////////
					// Animation over
					if(PlayerHands_GetAnimationPlaying()==false)
					{
						//////////////////////////
						// Determine next state
						if(mbCustomAnim_RemoveToolWhenOver)				
						{
							RemoveTool(mlCurrentToolIndex);
							SetActive(false);
						}
						else if(mbCustomAnim_HideToolWhenOver)
						{
							mState = eToolState_Hide;
						}
						else
						{
							mState = eToolState_Idle;
						}
						
						//////////////////////////
						//Callback
						if(msCustomAnim_Callback != "")
						{
							cLuxMap @pMap = cLux_GetCurrentMap();
							if(pMap.ScriptPrepare("void "+msCustomAnim_Callback+"(const tString& in)"))
							{
								tString sAnim = msCustomAnim;
								pMap.SetArgString(0, sAnim);
								pMap.ScriptExecute();
							}
						}
					}
				}
				mPrevState = lastState;
				
			return;
		}
		if (VR_UpdateStreamMapReadiness(afTimeStep))
		{
			if(!VR_RepairElevatorChipCarrier()) return;
            VR_EnsurePhysicalOmniWorldEntity(afTimeStep);
			VR_ReconcileShoulderInventory(afTimeStep);
			VR_UpdatePhysicalOmniAuthoredInsert(afTimeStep);
			VR_UpdateOmniPanelAreas(afTimeStep);
			VR_UpdatePhysicalUpgradeChipContact(afTimeStep);
			VR_UpdatePhysicalShoulderKeyItemUse(afTimeStep);
			VR_UpdateBaton(afTimeStep);
			VR_UpdateTracer(afTimeStep);
		}
		if(mbActive==false || mlCurrentToolIndex < 0) return;
		
		cToolData@ pCurrentTool = mvInventory[mlCurrentToolIndex];
		bool bVRPhysicalOmni = VR_IsPhysicalOmni(pCurrentTool);
		bool bVRPhysicalUpgradeChip = VR_IsPhysicalUpgradeChip(pCurrentTool);
		bool bVRPhysicalWorldTool = VR_IsPhysicalWorldTool(pCurrentTool);
		if (mfVRPhysicalOmniPanelCooldown > 0.0f) mfVRPhysicalOmniPanelCooldown -= afTimeStep;
		
		////////////////////////////////////////////
		// Check if tool has been displayed long enough
		if (mfAutoHideTimer >= 0)
		{
			mfAutoHideTimer -= afTimeStep;
			if (mfAutoHideTimer < 0)
			{
				mState = eToolState_Hide;
			}
		}
		
		//////////////////////////
		//Check if if anything in focus can be used by tool
		mbCanInteract = false;
		if(!bVRPhysicalUpgradeChip && !VR_IsShoulderKeyItem(pCurrentTool) && CanPickOrUseTool() && pCurrentTool.msCanBeUsedCallback!="" && mfAutoHideTimer < 0)
		{
			cCamera @pCam = cLux_GetPlayer().GetCamera();
			if(mPickBasics.UpdatePickCheck(pCam, false))
			{
				//iLuxEntity@ pPickedEntity = cLux_ID_Entity(mPickBasics.m_idFocusedEntity);
				//if(pPickedEntity !is null && pPickedEntity.GetInteractionDisabled()==false)
				{
					cLuxMap@ pMap = cLux_GetCurrentMap();

					if(pMap.ScriptPrepare("bool "+pCurrentTool.msCanBeUsedCallback+"(const tString &in asToolName, const tString &in asFocusEntity)" ) )
					{
						tString sTool = pCurrentTool.msPickedEntityName;
						pMap.SetArgString(0, sTool);
						tString sFocusedEntity = mPickBasics.msFocusedEntityName;
						pMap.SetArgString(1, sFocusedEntity);
						
						if(pMap.ScriptExecute())
						{
							bool bCanUse = pMap.GetReturnBool();
							if(bCanUse)
							{
								Player_SetCrossHairState(eCrossHairState(pCurrentTool.mlCustomUseIcon));
								mbCanInteract = true;
							}

						}
					}
				}
			}
		}
		
		//////////////////////////////////////////
		//This set if the normal player state can use interactions.
		SetToolInteractionAllowed(!mbCanInteract);
		
		/////////////////////////////////////////
		// State var setup
		eToolState lastState = mState;
		tString sEntity = "";
		if (!bVRPhysicalWorldTool && pCurrentTool.m_idHudObject != tID_Invalid)
			sEntity = cLux_ID_Entity(pCurrentTool.m_idHudObject).GetName();
		
		/////////////////////////////////////////
		// State: None
		if(mState == eToolState_Idle)
		{
			/////////////////////////
			// Enter state
			if(mPrevState != eToolState_Idle)
			{
				if (!bVRPhysicalWorldTool) PlayerHands_PlayAnimation("tool_"+pCurrentTool.msHandAnimationSuffix+"_idle", true,false,0.2f,sEntity, false);
			}
		}
		/////////////////////////////////////////
		// State: Unhide
		else if(mState == eToolState_Unhide)
		{
			/////////////////////////
			// Enter state
			if(mPrevState != eToolState_Unhide)
			{
				if (!bVRPhysicalWorldTool)
				{
					PlayerHands_SetUseCustomPosition(false);
					PlayerHands_SetUseCustomRotation(false);
					float fFadeTime = mbFadeInDrawAnim ? 0.2f : 0.0f;
					PlayerHands_PlayAnimation("tool_"+pCurrentTool.msHandAnimationSuffix+"_draw", false,false,fFadeTime,sEntity, false);
				}
                else
                {
                    // Retiring a physical tool draw must also retire a stale
                    // native tool-hand animation. Never cancel a story scene.
                    tString sPhysicalName=pCurrentTool.msPickedEntityName;
                    if(VR_IsShoulderKeyItem(pCurrentTool) && sPhysicalName!="ConfigChipTool" &&
                       sPhysicalName!="CortexChipTool" && sPhysicalName!="KateChip" && sPhysicalName!="GoyaChip" &&
                       cLux_GetPlayer().IsActive() && cLux_GetPlayer().GetCurrentStateId()==ePlayerState_Normal &&
                       !cScript_GetGlobalVarBool("UsingWauFlower")) PlayerHands_SetActive(false);
                    mState = eToolState_Idle;
                }
				
				//cLux_AddDebugMessage("Enter Unhide");
			}
			
			/////////////////////////
			// Animation over
			if(bVRPhysicalWorldTool || PlayerHands_GetAnimationPlaying()==false)
			{
				mState = eToolState_Idle;
			}	
		}
		/////////////////////////////////////////
		// State: Hide
		else if(mState == eToolState_Hide)
		{
			/////////////////////////
			// Enter state
			if(mPrevState != eToolState_Hide)
			{
				if (!bVRPhysicalWorldTool) PlayerHands_PlayAnimation("tool_"+pCurrentTool.msHandAnimationSuffix+"_holster", false,false,0.2f,sEntity, true);
				//cLux_AddDebugMessage("Enter Hide");
			}
			
			/////////////////////////
			// Animation over
			if(bVRPhysicalWorldTool || PlayerHands_GetAnimationPlaying()==false)
			{
				if(msPreviousTool!="") cScript_RunGlobalFunc(msPreviousTool, "", "_Global_OnUnequip");
				
				if (mbRemoveToolWhenHidden)
				{
					RemoveTool(mlCurrentToolIndex);
				}
				else 
				{
					mlCurrentToolIndex = -1;
					SetupMoveStateMultipliers();
				}
				SetActive(false);
			}	
		}
		/////////////////////////////////////////
		// State: Custom animation
		else if(mState == eToolState_CustomAnimation)
		{
			/////////////////////////
			// Animation over
			if(bVRPhysicalWorldTool || PlayerHands_GetAnimationPlaying()==false)
			{
				//////////////////////////
				// Determine next state
				if(mbCustomAnim_RemoveToolWhenOver)				
				{
					RemoveTool(mlCurrentToolIndex);
					SetActive(false);
				}
				else if(mbCustomAnim_HideToolWhenOver)
				{
					mState = eToolState_Hide;
				}
				else
				{
					mState = eToolState_Idle;
				}
				
				//////////////////////////
				//Callback
				if(msCustomAnim_Callback != "")
				{
					cLuxMap @pMap = cLux_GetCurrentMap();
					if(pMap.ScriptPrepare("void "+msCustomAnim_Callback+"(const tString& in)"))
					{
						tString sAnim = msCustomAnim;
						pMap.SetArgString(0, sAnim);
						pMap.ScriptExecute();
					}
				}
			}
		}
		mPrevState = lastState;
		
	}
	
