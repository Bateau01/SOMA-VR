	//------------------------------------------------------------
	
	void StartTextFade(float afGoal, float afFadeTime)
	{
		mbTextFadingStarted = true;
		
		mfFadeStart = mfTextAlpha;
		mfFadeGoal = afGoal;
		mfFadeTotalTime = afFadeTime;
		
		mfFadeCurrentTime = 0.0f;
	}
	
	bool DoneFading()
	{
		return mfTextAlpha==mfFadeGoal;
	}
	
	void UpdateFade(float afTimeStep)
	{
		mfFadeCurrentTime += afTimeStep;
		if(mfFadeStart<mfFadeGoal)
		{
			mfTextAlpha = cMath_InterpolateLinear(mfFadeStart, mfFadeGoal, mfFadeCurrentTime/mfFadeTotalTime);
			if(mfTextAlpha>mfFadeGoal)
				mfTextAlpha = mfFadeGoal;
		}
		else
		{
			mfTextAlpha = mfFadeStart-cMath_InterpolateLinear(mfFadeGoal, mfFadeStart, mfFadeCurrentTime/mfFadeTotalTime);
			if(mfTextAlpha<mfFadeGoal)
				mfTextAlpha = mfFadeGoal;
		}
	}
	
	//------------------------------------------------------------
	
	void StopHint()
	{
		mfDisplayTime = 0.0f;
	}
	
	//------------------------------------------------------------
	
	// IDs greater than 0 are given to candidates to next hint, since they need to be identified somehow
	// If a hint has ID 0, it started to display right away
	// An ID of -1 means the hint is empty / wasn't added
	int mlHintIDCounter = 0;
	
	int AddHintCandidate(const tString &in asHeaderCat, const tString &in asHeaderEntry, 
							const tString &in asTextCat, const tString &in asTextEntry, 
							bool abIsInputHint, const cColor &in aColor, float afTimeMul, bool abAddAsGiven)
	{
		if(mbHintsEnabled==false)
			return -1;
		
		cHint hint(asHeaderCat, asHeaderEntry, asTextCat, asTextEntry, abIsInputHint, aColor, afTimeMul, abAddAsGiven);
        if(_HPL3VR_RuntimeActive_Hint() && VRMapped(hint) && (VRHintMode()==2 || (VRHintMode()==1 && asTextCat!="VRHints")))return -1;
		//////////////////////////////////////////////////////
		// Check so hint is not blocked or already given
		if(m_setHintsBlocked.Count(hint.msName)>0)
			return -1;
			
		bool bHintIsFullyGiven = false;
		// Check if hints belongs in a sequence
		if(cLux_HasTranslation(hint.msTextCat, hint.msTextEntry+"_1"))
		{
			int lNextHintInSeqIndex = m_setHintsGiven.Count(hint.msName)+1;
			hint.msTextEntry = hint.msTextEntry + "_" + lNextHintInSeqIndex;
			
			bHintIsFullyGiven = cLux_HasTranslation(hint.msTextCat, hint.msTextEntry)==false;
		}
		else
		{
			bHintIsFullyGiven = m_setHintsGiven.Exists(hint.msName);
		}
		
		if(bHintIsFullyGiven)
			return -1;
		
		int lRet = -1;
				
		if(mCurrentHint.IsEmpty())
		{
			StartMessage(hint);
			lRet = hint.mlID;
		}
		else
		{
			if(GetCandidateHintIndexByName(hint.msName)==-1)
			{
				hint.mlID = ++mlHintIDCounter;
										
				if(mlHintIDCounter<0) mlHintIDCounter = 0;
						
				mvNextHintCandidates.push_back(hint);
				
				lRet = hint.mlID;
			}
		}
		
		return lRet;
	}
	
	void RemoveHintCandidate(int alID)
	{
		if(alID<=0)
			return;
			
		//cLux_AddDebugMessage("Releasing hint with ID " + alID);
			
		int lIndex = GetCandidateHintIndexByID(alID);
		
		if(lIndex!=-1)
			mvNextHintCandidates.removeAt(lIndex);
	}
	
	int GetCandidateHintIndexByID(int alID)
	{
		for(int i=0; i<mvNextHintCandidates.length(); ++i)
		{
			cHint @hint = mvNextHintCandidates[i];
			
			if(alID==hint.mlID)
				return i;
		}
		
		return -1;
	}
	int GetCandidateHintIndexByName(const tString &in asName)
	{
		for(int i=0; i<mvNextHintCandidates.length(); ++i)
		{
			cHint @hint = mvNextHintCandidates[i];
			
			if(asName==hint.msName)
				return i;
		}
		
		return -1;
	}
	
	bool HasNextHint()
	{
		return mvNextHintCandidates.length()>0;
	}
	
	cHint GetNextHint()
	{
		cHint next = mvNextHintCandidates[0];
		mvNextHintCandidates.pop_front();
		
		return next;
	}
	
	//------------------------------------------------------------
	
	void AddHintAsGiven(int alID)
	{
		if(mCurrentHint.IsEmpty()==false && mCurrentHint.mlID==alID && m_setHintsGiven.Exists(mCurrentHint.msName)==false)
		{
			AddHintAsGivenHelper(mCurrentHint.msName);
		}
	}
	
	void AddHintAsGiven(const tString &in asTextCat, const tString &in asTextEntry)
	{
		AddHintAsGivenHelper(BuildHintName(asTextCat, asTextEntry));
	}
	
	void AddHintAsGivenHelper(const tString &in asHintName)
	{
		m_setHintsGiven.Add(asHintName);
		//cLux_AddDebugMessage("Hint '" + asHintName + "' given");
	}
	
	//------------------------------------------------------------
	
	void StartMessage(const cHint &in aHint)
	{
		//cLux_AddDebugMessage("StartMessage(" + aHint.msName + ")");
		
		if(aHint.mbAddAsGiven)
		{
			AddHintAsGivenHelper(aHint.msName);
		}
		
		msHeader = cLux_ParseString(cLux_Translate(aHint.msHeaderCat,aHint.msHeaderEntry));
		
		float fHintTime = ParseAndFormatHint(aHint);
		
		mCurrentHint = aHint;
		mCurrentHint.mfTimeToDisplay *= fHintTime;
		mfDisplayTime = mCurrentHint.mfTimeToDisplay;
				
		mTextColor = mCurrentHint.mColor;
	}
	
	float ParseAndFormatHint(const cHint &in aHint)
	{
		// Clear icon array so the old icons are deleted
		mvCurrentHintIcons.resize(0);
		mvCurrentHintIconsPerLine.resize(0);
		
		float fStringDuration;
		tWString hintText;
        if(_HPL3VR_RuntimeActive_Hint() && VRMapped(aHint)){
            hintText=VRText(aHint.msTextEntry);
            if(mpVRFont is null) @mpVRFont=cResources_CreateFontData(Helper_Font_GetFontName(eLuxFontType_Default_Medium_Outline));
            mvCurrentHintLines.resize(0);
            if(mpVRFont !is null)mpVRFont.GetWordWrapRows(gfMaxTextWidth,cVector2f(gfFontSize),hintText,mvCurrentHintLines);
            mfLineHeight=gfFontSize*1.15f;mlNumParsedHintIcons=0;return 6.0f;
        }
        hintText=cLux_Translate(aHint.msTextCat,aHint.msTextEntry);
        cLux_ParseStringIntoScreenText(hintText, cLux_GetGameHudImGui(), mFormatParamsHint, 
										mvCurrentHintLines, mvCurrentHintIcons, mvCurrentHintIconsPerLine, mfLineHeight, fStringDuration, aHint.mbTriggeredByGamepad);
				
		mlNumParsedHintIcons = mvCurrentHintIcons.length();
		
		return fStringDuration;
	}
	
	//------------------------------------------------------------
	
	void Block(const tString &in asTextCat, const tString &in asTextEntry)
	{
		m_setHintsBlocked.Add(BuildHintName(asTextCat, asTextEntry));
	}
	
	void Unblock(const tString &in asTextCat, const tString &in asTextEntry)
	{
		m_setHintsBlocked.Erase(BuildHintName(asTextCat, asTextEntry));
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	[nosave] bool mbHintsEnabled;
	[nosave] iFontData@ mpVRFont;
	
	//------------------------------------------------------------
	
	cLuxScreenTextFormatParameters mFormatParamsHeader;
	cLuxScreenTextFormatParameters mFormatParamsHint;
	
	//------------------------------------------------------------
	
	cHint mCurrentHint;
	array<cHint> mvNextHintCandidates;
	cScriptStringSet m_setHintsGiven;
	cScriptStringSet m_setHintsBlocked;
	
	//------------------------------------------------------------
	
	tWString msHeader;
	array<tWString> mvCurrentHintLines;
	[nosave] array<cLuxScreenTextIcon@>	mvCurrentHintIcons;
	[nosave] array<array<int>>			mvCurrentHintIconsPerLine;
	int mlNumParsedHintIcons;
	
	[nosave] bool mbFirstUpdateAfterLoading = true;
	
	float mfLineHeight;
		
	cColor mTextColor;
	float mfTextAlpha;
	float mfFadeCurrentTime;
	float mfFadeTotalTime;
	float mfFadeStart;
	float mfFadeGoal;
	float mfDisplayTime;
	bool mbTextDisplayed;
	bool mbTextFadingStarted;
		
	//------------------------------------------------------------
}



