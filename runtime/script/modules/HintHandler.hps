	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
        VRHintsUpdate(afTimeStep);
		if(mbHintsEnabled==false) return;
		
		//cLux_AddDebugMessage("HintHandler::Update");
		
		bool bTextWasDisplayed = mbTextDisplayed;
		mbTextDisplayed = mfDisplayTime > 0.0f ? true : false;
	
		if(mfDisplayTime <= -1)
		{
			mbTextDisplayed = true;
		}
		
		// Fade in
		if(bTextWasDisplayed==false && mbTextDisplayed)
		{
			StartTextFade(1.0f, 1.0f);
		}
		// Fade out
		else if(bTextWasDisplayed && mbTextDisplayed==false)
		{
			StartTextFade(0.0f, 1.0f/3);
		}
				
		if(mbTextDisplayed)
			mfDisplayTime -= afTimeStep;
				
		// Update fading
		if(mbTextFadingStarted)
		{
			if(DoneFading()==false)
			{
				UpdateFade(afTimeStep);
			}
			else
			{
				mbTextFadingStarted = false;
				
				// If faded out, resume with next hint (if any)
				if(mfFadeGoal==0.0f)
				{
					mvCurrentHintLines.resize(0);
					if(mCurrentHint.IsEmpty()==false)
					{
						mCurrentHint.Clear();
						
						if(HasNextHint())
						{
							cHint hint = GetNextHint();
							StartMessage(hint);
						}
					}
				}
			}
		}
	}
	
	void PostUpdate(float afTimeStep)
	{
	}
	
	void VariableUpdate(float afDeltaTime)
	{
		mfFrameTime = afDeltaTime;
	}
	void Reset()
	{
		mfTextAlpha = 0.0f;
		mfFadeStart = 0.0f;
		mfFadeGoal = 0.0f;
		mfFadeCurrentTime = 0.0f;
		mbTextFadingStarted = false;
	}
	
	//------------------------------------------------------------
	float mfFrameTime = 0.0f;
	void OnGui(float afFrameTime)
	{
		if (!_HPL3VR_RuntimeActive_Hint())
		{
				if(mbHintsEnabled==false) return;
				
				// Check if a string reparse is needed (e.g. after loading a saved game)
				if(mCurrentHint.IsEmpty()==false)
				{
					if(mbFirstUpdateAfterLoading || mlNumParsedHintIcons!=mvCurrentHintIcons.length())
					{
						ParseAndFormatHint(mCurrentHint);
						// Also Reset hint time
						mfDisplayTime = mCurrentHint.mfTimeToDisplay;
						
						mbFirstUpdateAfterLoading = false;
					}
				}
				else
				{
					return;
				}
				
				bool bCanSkipHintText = mfTextAlpha==0 || mvCurrentHintLines.length()==0;
				if(bCanSkipHintText) return;
				
				cColor currentCol = mTextColor;
				currentCol.a *= mfTextAlpha;
				
				////////////////////
				// Draw hint header
				
				ImGui_SetModColorMul(cColor(1,0,0, mfTextAlpha));
					
				cVector3f vHeaderPos = ImGui_NrmPos(0.0f, 0.055f, 1.0f);
				cVector2f vHeaderLineSize(ImGui_NrmSize(1.0f, 0.0f).x, mFormatParamsHeader.mLabelText.mFont.mvSize.y);
					
				cLux_GetCurrentImGui().DoLabel(msHeader, mFormatParamsHeader.mLabelText, vHeaderPos, vHeaderLineSize, 1.0f);
					
				// If only showing header, skip hint text
				if(bCanSkipHintText) return;
				
				float fHeaderHeight = cMath_Max(mfLineHeight*0.75f, gfFontSize*1.1f);
						
				cVector3f vHintPos = ImGui_NrmPos(0.5f, 0.0f, 1.0f);
				vHintPos.x -= mFormatParamsHint.mfOutputLineWidth*0.5f;
				vHintPos.y = vHeaderPos.y + fHeaderHeight;
				cVector2f vHintLineSize(mFormatParamsHint.mfOutputLineWidth, mFormatParamsHint.mLabelText.mFont.mvSize.y);
				
				
				ImGui_SetModColorMul(cColor(mTextColor.r,mTextColor.g, mTextColor.b, mfTextAlpha));
				
				cLux_DrawHint(cLux_GetGameHudImGui(), mfFrameTime, mFormatParamsHint.mLabelText, vHintPos, vHintLineSize.x, mfLineHeight,
													mvCurrentHintLines, mvCurrentHintIcons, mvCurrentHintIconsPerLine);
													
				ImGui_ResetModifiers();
				
				mfFrameTime = 0.0f;
			return;
		}
		if(mbHintsEnabled==false) return;
		// Keep SOMA's authored parse/reparse and timers here because input-hint
		// text generation still belongs to the original module. Rendering itself
		// moved to OnDraw so it is captured by the VR eye path.
		if(mCurrentHint.IsEmpty()==false)
		{
			if(mbFirstUpdateAfterLoading || mlNumParsedHintIcons!=mvCurrentHintIcons.length())
			{
				ParseAndFormatHint(mCurrentHint);
				mfDisplayTime = mCurrentHint.mfTimeToDisplay;
				mbFirstUpdateAfterLoading = false;
			}
		}
		mfFrameTime = 0.0f;
	}
	
	void OnDraw(float afFrameTime)
	{
		if (!_HPL3VR_RuntimeActive_Hint())
		{
				
			return;
		}
		if (mpVRFont is null) @mpVRFont = cResources_CreateFontData(Helper_Font_GetFontName(eLuxFontType_Default_Medium_Outline));
		if(mbHintsEnabled==false || mCurrentHint.IsEmpty() || mfTextAlpha==0 || mpVRFont is null) return;
		// Prepare the same native 3D surface and per-eye route as VR subtitles.
		// Use an explicit set handle; no global HUD redirection survives this call.
		cScript_RunGlobalFunc("VRHINT", "", "P");
		cGuiSet@ pHintSet = cGui_GetSetFromName("VR_Subtitles");
		if(pHintSet is null) @pHintSet = cLux_GetGameHudSet();
		cColor currentCol = mTextColor;
		currentCol.a *= mfTextAlpha;
		cVector2f vHud = cLux_GetHudVirtualCenterSize();
		float fCenterX = vHud.x * 0.5f;
		float fHeaderY = vHud.y * 0.32f;
		float fLineHeight = mfLineHeight > gfFontSize ? mfLineHeight : gfFontSize * 1.15f;
		// Text-only VR presentation is intentional: keyboard/gamepad sprite icons
		// are desktop affordances and are omitted alongside the crosshair icons.
		pHintSet.DrawFontEx(msHeader, mpVRFont, cVector3f(fCenterX,fHeaderY,1), cVector2f(gfFontSize), cColor(1,1,1,mfTextAlpha), eFontAlign_Center, eGuiMaterial_FontNormal);
		float fY = fHeaderY + fLineHeight * 1.15f;
		for(int i=0; i<mvCurrentHintLines.length(); ++i)
		{
			pHintSet.DrawFontEx(mvCurrentHintLines[i], mpVRFont, cVector3f(fCenterX,fY,1), cVector2f(gfFontSize), currentCol, eFontAlign_Center, eGuiMaterial_FontNormal);
			fY += fLineHeight;
		}
	}
	
	void OnPostRender(float afFrameTime)
	{
	
	}
	
