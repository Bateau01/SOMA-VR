class cHighlightObject
{
	tID m_idEntity;
	
	float mfPreOnScreenTimeCount=0;
	float mfFlashCount=0;
	float mfLightLevel;
	
	float mfRemoveTimeCount=0;
	cColor mColorMul = cColor_White;
}

//------------------------------------------------------------

/////////////////////////////////////////
// SETTINGS
/////////////////////////////////////////

//------------------------------------------------------------

float gfHightlightEffectMaxDistance = 3;
float gfHightlightEffectMaxDistanceSqr = 3*3;

cVector3f gvHighligEffectGridSize = cVector3f(1, 1.5f, 1);

//------------------------------------------------------------

