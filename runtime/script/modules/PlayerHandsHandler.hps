	void OnRenderSolid(cRendererCallbackFunctions@ apFunctions)
	{
		return;
		if(mbCameraAttachActive)
		{
			cCamera @pCam = cLux_GetPlayer().GetCamera();

			apFunctions.GetLowLevelGfx().DrawSphere(pCam.GetPosition(), 0.05f, cColor(0.5,0.5,0.5,1));
			apFunctions.GetLowLevelGfx().DrawLine(pCam.GetPosition(), pCam.GetPosition()+pCam.GetForward()*0.3f, cColor(3,1,3,1));
			

			iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
			
			//apFunctions.GetLowLevelGfx().DrawLine(pEntity.GetPosition(), pEntity.GetPosition()+cVector3f(0.3,0,0), cColor(5,0,0,1));
			//apFunctions.GetLowLevelGfx().DrawLine(pEntity.GetPosition(), pEntity.GetPosition()+cVector3f(0,0.3,0), cColor(0,5,0,1));
			//apFunctions.GetLowLevelGfx().DrawLine(pEntity.GetPosition(), pEntity.GetPosition()+cVector3f(0,0,0.3), cColor(0,0,5,1));
			
			//apFunctions.GetLowLevelGfx().DrawLine(pCam.GetPosition(), pCam.GetPosition()+pCam.GetForward()*0.3, cColor(5,5,5,1));
			
			
			cBoneState@ pBone = pEntity.GetMeshEntity().GetBoneStateFromName(msCameraAttachBone);
			if(pBone !is null)
			{
				apFunctions.GetLowLevelGfx().DrawSphere(pBone.GetWorldPosition(), 0.05f, cColor(5,5,0,1));
				
				cMatrixf mtxTrans = pBone.GetWorldMatrix().GetRotation();//cMath_MatrixInverse(pBone.GetWorldMatrix().GetRotation());
				apFunctions.GetLowLevelGfx().DrawLine(pBone.GetWorldPosition(), pBone.GetWorldPosition()+mtxTrans.GetRight()*0.2, cColor(5,0,0,1));
				apFunctions.GetLowLevelGfx().DrawLine(pBone.GetWorldPosition(), pBone.GetWorldPosition()+mtxTrans.GetUp()*0.2, cColor(0,5,0,1));
				apFunctions.GetLowLevelGfx().DrawLine(pBone.GetWorldPosition(), pBone.GetWorldPosition()+mtxTrans.GetForward()*0.2, cColor(0,0,5,1));
			
			}
		}
	}
 	
	
	/////////////////////////////////////////
	// HPL3VR ONE-SHOT SAVE BOOTSTRAP + UI AUTHORITY
	/////////////////////////////////////////

	//------------------------------------------------------------

	// H57.55bl semantic publisher: reports AngelScript-owned msHandModel for
	// exact loaded-save refreshes and authored SetHandModel transitions.
	void HPL3VR_EndHealingVisibility()
	{
		// Restore the default for the NEXT authored animation without showing
		// the completed full-scale healing mesh after its entity was disabled.
		mbEntityVisible=true;
		iLuxEntity@ pHands=cLux_ID_Entity(m_idHands);
		if(pHands !is null) pHands.GetMeshEntity().SetVisible(false);
	}

	bool HPL3VR_ReplaceAuthoredHands()
	{
		if (!_HPL3VR_RuntimeActive_PlayerHands()) return false;
		if (cScript_GetGlobalVarBool("UsingWauFlower") || mlVRSceneOverride==0) return true;
		cAnimationState@ pAnim = GetCurrentAnimationState();
		if (pAnim is null) return false;
		tString sName = pAnim.GetName();
		return cString_Sub(sName,0,5)=="tool_" || cString_Sub(sName,0,11)=="customtool_" ||
			sName=="event_look_at_hands_1_3";
	}

	bool mbVRSeatSequence=false;
	int mlVRSceneOverride=-1;
	void HPL3VR_SetSceneOverride()
	{
		if(!_HPL3VR_RuntimeActive_PlayerHands()) return;
		mlVRSceneOverride=cScript_GetGlobalArgInt(0);
		HPL3VR_PublishSceneHands();
	}
	[nosave] int mlVRScenePublished = -1;
	void HPL3VR_PublishSceneHands()
	{
		if (!_HPL3VR_RuntimeActive_PlayerHands())
		{
			mlVRScenePublished = -1;
			return;
		}
		int lPlayerState = cLux_GetPlayer().GetCurrentStateId();
		bool bStateHide = lPlayerState==ePlayerState_Sit || lPlayerState==ePlayerState_Ladder ||
			lPlayerState==ePlayerState_ClimbLedge || lPlayerState==ePlayerState_InteractiveCameraAnimation;
		if(lPlayerState==ePlayerState_Sit || lPlayerState==ePlayerState_InteractiveCameraAnimation) mbVRSeatSequence=true;
		if(lPlayerState==ePlayerState_Normal || lPlayerState==ePlayerState_Grab) mbVRSeatSequence=false;
		if(mbVRSeatSequence && lPlayerState==ePlayerState_CustomControls) bStateHide=true;
		bool bHide = bStateHide;
		iLuxEntity@ pHands = cLux_ID_Entity(m_idHands);
		if(mbActive && pHands !is null && mlCurrentAnimation >= 0)
		{
			cAnimationState@ pAnim = pHands.GetMeshEntity().GetAnimationState(mlCurrentAnimation);
			if(pAnim !is null)
			{
				tString sName = pAnim.GetName();
				// All inventory tools keep physical hands, including Omnitool and baton.
				bool bTool = cString_Sub(sName,0,5)=="tool_" || cString_Sub(sName,0,11)=="customtool_" ||
                    (cString_Sub(sName,0,17)=="wau_flower_touch_" && cScript_GetGlobalVarBool("UsingWauFlower"));
				bHide = bStateHide || (!bTool && (pHands.GetAnimationIsPlaying() || mbCameraAttachActive || mfCameraAttachT>0));
				if (sName=="event_look_at_hands_1_3" && pHands.GetAnimationIsPlaying()) bHide=false;
			}
		}
		if(mlVRSceneOverride>=0) bHide=mlVRSceneOverride==1;
		int lState = bHide ? 1 : 0;
		if(lState == mlVRScenePublished) return;
		mlVRScenePublished = lState;
		cScript_RunGlobalFunc("VRSCENE", "", bHide ? "H" : "S");
	}

	void HPL3VR_PublishHandFamilyBootstrap()
	{
		if (!_HPL3VR_RuntimeActive_PlayerHands()) return;
		if(msHandModel == "character/player/hands/hands_human.ent")
			cScript_RunGlobalFunc("VRHAND", "", "H");
		else if(msHandModel == "character/player/hands/hands_diving.ent")
			cScript_RunGlobalFunc("VRHAND", "", "D");
		else if(msHandModel == "character/player/hands/hands_deepsea.ent")
			cScript_RunGlobalFunc("VRHAND", "", "S");
		else if(msHandModel == "character/player/hands/hands_deepsea_mutilated.ent")
			cScript_RunGlobalFunc("VRHAND", "", "M");
		else
			cScript_RunGlobalFunc("VRHAND", "", "U");
	}

	//------------------------------------------------------------

	// H57.54h authoritative UI-state publisher. This deliberately queries the
	// real SOMA load-screen/menu handlers rather than inferring Pause from
	// PlayerState_Normal or Newton timing. L=loading/continue modal, M=menu
	// handler active, G=ordinary gameplay.


	void HPL3VR_PublishUIState()
	{
		if (!_HPL3VR_RuntimeActive_PlayerHands()) return;
		if(cLux_IsLoadingScreenVisible())
		{
			cScript_RunGlobalFunc("VRUI", "", "L");
			return;
		}

		iScrMenuHandler_Interface @pMenu = cast<iScrMenuHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_MenuHandler));
		if(pMenu.GetMenuActive())
			cScript_RunGlobalFunc("VRUI", "", "M");
		else
			cScript_RunGlobalFunc("VRUI", "", "G");
	}

	//------------------------------------------------------------

	// Open Pause through SOMA's own MenuHandler. The DLL never fabricates an
	// Escape key to enter Pause; SDL Escape is retained only for authored Back
	// navigation once the menu is already active.
    void HPL3VR_ComfortHoldBegin() { if(_HPL3VR_RuntimeActive_PlayerHands()) cScript_RunGlobalFunc("MenuHandler","cScrMenuHandler","HPL3VR_MenuHoldBegin"); }
    void HPL3VR_ComfortHoldEnd() { if(_HPL3VR_RuntimeActive_PlayerHands()) cScript_RunGlobalFunc("MenuHandler","cScrMenuHandler","HPL3VR_MenuHoldEnd"); }
	void HPL3VR_AlphaTouch()
	{
		cLuxMap@ pMap = cLux_GetCurrentMap();
		if (pMap !is null && pMap.ScriptPrepare("void HPL3VR_AlphaCommit()")) pMap.ScriptExecute();
	}

    void HPL3VR_SnapLeft() { HPL3VR_SnapTurn(1.0f); }
    void HPL3VR_SnapRight() { HPL3VR_SnapTurn(-1.0f); }
    void HPL3VR_SnapTurn(float sign)
    {
        if(!_HPL3VR_RuntimeActive_PlayerHands()) return;
        int mode=cLux_GetUserConfig().GetInt("SOMA_VR_Comfort","TurnMode",0);
        if(mode!=1 && mode!=2) return;
        cLux_GetPlayer().GetCharacterBody().AddYaw(sign*cMath_ToRad(mode==1 ? 30.0f : 45.0f));
    }
	void HPL3VR_PhysicalCrouchDown() { cScript_RunGlobalFunc("MoveState_Normal","","HPL3VR_PhysicalCrouchDown"); }
	void HPL3VR_PhysicalCrouchUp() { cScript_RunGlobalFunc("MoveState_Normal","","HPL3VR_PhysicalCrouchUp"); }
	void HPL3VR_PhiAction(int action,bool pressed)
	{
		if(!_HPL3VR_RuntimeActive_PlayerHands() || cLux_GetPlayer().GetCurrentStateId()!=ePlayerState_CustomControls) return;
		cLuxMap@ map=cLux_GetCurrentMap();
		if(map !is null && map.ScriptPrepare("bool LoaderArm_Action(int alAction, bool abPressed)"))
		{ map.SetArgInt(0,action);map.SetArgBool(1,pressed);map.ScriptExecute(); }
	}
	void HPL3VR_PhiPress() { HPL3VR_PhiAction(eAction_Interact,true); }
	void HPL3VR_PhiRelease() { HPL3VR_PhiAction(eAction_Interact,false); }
	void HPL3VR_PhiZoomPress() { HPL3VR_PhiAction(eAction_InteractCancel,true); }
	void HPL3VR_PhiZoomRelease() { HPL3VR_PhiAction(eAction_InteractCancel,false); }
	void HPL3VR_PhiPauseRelease()
	{
		HPL3VR_PhiRelease(); HPL3VR_PhiZoomRelease();
		cScript_RunGlobalFunc("VRREMOTE","","S");
	}
	void HPL3VR_OpenPause()
	{
		if (!_HPL3VR_RuntimeActive_PlayerHands()) return;
		iScrMenuHandler_Interface @pMenu = cast<iScrMenuHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_MenuHandler));
		pMenu.SetMenuActive(true);
	}

	// H57.55FZ: use SOMA/HPL's authored viewport camera setter so all
	// dependent viewport/frustum/render bookkeeping follows the native path.
	void HPL3VR_RebindGameplayViewport()
	{
		if (!_HPL3VR_RuntimeActive_PlayerHands()) return;
		// DLL-side preconditions already prove an active viewport and recovered
		// gameplay camera. Keep the script bridge on the exact authored API.
		cLux_GetViewport().SetCamera(cLux_GetPlayer().GetCamera());
	}

	//------------------------------------------------------------

	/////////////////////////////////////////
	// PUBLIC METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetHandModel(const tString& in asFile)
	{
		if (!_HPL3VR_RuntimeActive_PlayerHands())
		{
				if(msHandModel == asFile) return;
				
				msHandModel = asFile;
				
				DestroyHandModel(cLux_GetCurrentMap());
				CreateHandModelIfNeeded(cLux_GetCurrentMap());
			return;
		}
		if(msHandModel == asFile) return;
		
		msHandModel = asFile;
		// H57.55bl: SetHandModel is the semantic family authority. Publish before
		// native entity destruction/recreation; the DLL still switches safely.
		HPL3VR_PublishHandFamilyBootstrap();
		
		DestroyHandModel(cLux_GetCurrentMap());
		CreateHandModelIfNeeded(cLux_GetCurrentMap());
	}
	
	//------------------------------------------------------------
		
	void PreloadHandModel(const tString& in asFile)
	{
		Entity_Preload(asFile);
	}
	
	//------------------------------------------------------------
	
	void PlayAnimation(const tString &in asAnim, bool abLoop, bool abFullScaleModel, float afFadeTime, const tString &in asAttachedProp, bool abDisableWhenOver, float afSpeed, float afRelTimePos)
	{
		CreateHandModelIfNeeded(cLux_GetCurrentMap());
		
		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
		
		float fFadeTime = afFadeTime;
		if(mbUseFullScaleModel!=abFullScaleModel || pEntity.IsActive()==false)
		{
			fFadeTime=0;
		}
		
		int lAnim = pEntity.PlayAnimation(asAnim,  fFadeTime, abLoop);
		if(lAnim<0)
			return;
		//if(lAnim == mlCurrentAnimation) return;
		mlCurrentAnimation = lAnim;
			
		cMeshEntity@ pMeshEntity = pEntity.GetMeshEntity();
		cAnimationState@ pAnim = pMeshEntity.GetAnimationState(mlCurrentAnimation);
		
		////////////////////////////////////
		// Set up animation state
		pAnim.SetSpeed(afSpeed);
		if(afRelTimePos<0)
		{
			if(afSpeed<0) 	pAnim.SetRelativeTimePosition(1);
			else			pAnim.SetRelativeTimePosition(0);
		}
		else
		{
			pAnim.SetRelativeTimePosition(afRelTimePos);
		}
		
		////////////////////////////////////
		// Set up properties
		if(mbCameraAttachActive && mbCameraAttachFadingIn)
		{
			pAnim.SetPaused(true);
			SetVisible(false);
		}
		
		//cLux_AddDebugMessage("Hand Animation - "+asAnim);
		
		
		////////////////////////////////////
		// Hand animation sounds
		if(cLux_GetUnderwaterEffectsActive())
		{	
			//Underwater hand animation sounds
			Sound_PlayGui("Player/foley/default/hand_animation/underwater/"+asAnim, 1.0f, eSoundEntryType_WorldClean);
		}
		else
		{	
			//Normal hand animation sounds
			Sound_PlayGui("Player/foley/default/hand_animation/"+asAnim, 1.0f, eSoundEntryType_World);
		}
		
		////////////////////////////////////
		// Set up properties
		mbUseFullScaleModel = abFullScaleModel;
		SetActive(true);
		mbDisableWhenAnimOver = abDisableWhenOver;
		HPL3VR_PublishSceneHands();
		
		pEntity.GetMeshEntity().SetVisible(mbEntityVisible && !HPL3VR_ReplaceAuthoredHands());
				
		
		/////////////////////////////
		// Attach a prop
		if(asAttachedProp != "")
		{
			iLuxEntity @pProp = cLux_GetCurrentMap().GetEntityByName(asAttachedProp);
			if(pProp is null)
			{
				Error("Could not find entity '"+asAttachedProp+"' to be attached to player hands");
				return;
			}
			
			iLuxEntity @pPrevProp = null;
			if(m_idCurrentAttachProp!=tID_Invalid) @pPrevProp = cLux_ID_Entity(m_idCurrentAttachProp);
			
			if(pPrevProp !is pProp)
			{
				if(pPrevProp !is null)
				{
					pPrevProp.RemoveEntityAttachment();
					pPrevProp.SetActive(false);
				} 
				
				if(pProp.GetMainBody() !is null)
				{
					pProp.GetMainBody().SetCollideCharacter(false);
					pProp.GetMainBody().SetCollide(false);
				}
				
				pProp.AttachToSocket(pEntity, "R_Hand", true, true);
				pProp.SetActive(true);
				m_idCurrentAttachProp  = pProp.GetID();
			}
		}
		/////////////////////////////
		// If something is attached, remove it.
		else
		{
			if(m_idCurrentAttachProp!=tID_Invalid)
			{
				iLuxEntity @pAttachProp = cLux_ID_Entity(m_idCurrentAttachProp);
				if(pAttachProp !is null)
				{
					pAttachProp.SetActive(false);
					pAttachProp.RemoveEntityAttachment();	
				}
				m_idCurrentAttachProp = tID_Invalid;
			}
		}
	}
	
	//------------------------------------------------------------
	
	bool GetAnimationPlaying()
	{
		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
		return (pEntity !is null) && pEntity.GetAnimationIsPlaying();
	}
	
	//------------------------------------------------------------
	
	void SetActive(bool abX)
	{
		if(mbActive == abX) return;
		
		CreateHandModelIfNeeded(cLux_GetCurrentMap());
		
		mbActive = abX;
		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
		pEntity.SetActive(abX);
		
		if(m_idCurrentAttachProp!=tID_Invalid)
		{
			iLuxEntity@ pAttachProp = cLux_ID_Entity(m_idCurrentAttachProp);
			if(pAttachProp !is null)
				pAttachProp.SetActive(false);
			m_idCurrentAttachProp = tID_Invalid;
		}
			
		
		if(abX==false)
		{
			pEntity.StopAllAnimations(0);
		}
					
		cCamera @pCam = cLux_GetPlayer().GetCamera();
		mvCurrentHandRotation = cVector3f(pCam.GetPitch(), pCam.GetYaw(), pCam.GetRoll()*0.5);
	}
	
	//------------------------------------------------------------
	
	bool IsActive()
	{
		return mbActive;
	}
	
	//------------------------------------------------------------
	
	tString GetEntityName()
	{
		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
		return pEntity.GetName();
	}
	
	//------------------------------------------------------------
	
	void SetUseCustomRotation(bool abX)
	{
		mbUseCustomRotation = abX;	
	}
	
	void SetCustomRotation(const cVector3f& in avRot)
	{
		mvCustomRotation = avRot;
	}
	
	//------------------------------------------------------------
	
	cAnimationState@ GetCurrentAnimationState()
	{
		if(mlCurrentAnimation<0) return null;
		
		CreateHandModelIfNeeded(cLux_GetCurrentMap());
		
		return cLux_ID_Entity(m_idHands).GetMeshEntity().GetAnimationState(mlCurrentAnimation);
	}
	
	//------------------------------------------------------------
	
	cBoneState@ GetBoneState(const tString& in asBone)
	{
		CreateHandModelIfNeeded(cLux_GetCurrentMap());
		
		return cLux_ID_Entity(m_idHands).GetMeshEntity().GetBoneStateFromName(asBone);
	}
	
	//------------------------------------------------------------
	
	cNode3D@ GetSocket(const tString& in asSocket)
	{
		CreateHandModelIfNeeded(cLux_GetCurrentMap());
		
		return cLux_ID_Entity(m_idHands).GetMeshEntity().GetSocket(asSocket);
	}
		
	//------------------------------------------------------------
	
	void SetUseCustomPosition(bool abX)
	{
		mbUseCustomPosition = abX;	
	}
	
	//------------------------------------------------------------
	
	void SetCustomPosition(const cVector3f& in avPos, bool abUseBasicOffset)
	{
		mvCustomPosition = avPos;
		mbCustomPositionUseBasicOffset = abUseBasicOffset;
	}
	
	//------------------------------------------------------------
	
	void AttachCameraToSocket(	const tString& in asBoneName, float afFadeTime,
								const tString &in asFadeOverCallback,
								bool abDisablePlayer, bool abAutoDetach, float afDetachTime,
								const cVector3f&in avPosOffset, const cVector3f&in avRotOffset)
	{
		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
		
		if(pEntity.GetMeshEntity().GetBoneStateFromName(asBoneName) is null)
		{
			Error("Could not find bone name '"+asBoneName+"' in player hands mesh!");
			return;
		}
		
		msCameraAttachBone =asBoneName;
		mfCameraAttachFadeTime = afFadeTime;
		mfCameraAttachT=0;
		mbCameraAttachActive=true;
		mbCameraAttachFadingIn = true;
		
		mvCameraAttachPosOffset = avPosOffset;
		mvCameraAttachRotOffset = avRotOffset;
		
		cAnimationState@ pState = GetCurrentAnimationState();
		if(pState !is null)
		{
			pState.SetPaused(true);
			
			float fSpeed = pState.GetSpeed();
			pState.SetTimePosition(fSpeed>=0 ? 0 : pState.GetLength());
			
			SetVisible(false);
		}
		
		mbCameraAttachDisablePlayer = abDisablePlayer;
		if(abDisablePlayer)
			Player_SetActive(false);
			
		cCamera@ pCam = cLux_GetPlayer().GetCamera();
		mvCameraAttachStartRotation.x = pCam.GetPitch();
		mvCameraAttachStartRotation.y = pCam.GetYaw();
		mvCameraAttachStartRotation.z = pCam.GetRoll();
		
		mbCameraAttachAutoDetach = abAutoDetach;
		mfCameraAttachAutoDetachTime = afDetachTime;
		
		msCameraAttachFadeOverCallback = asFadeOverCallback;
		
		cLux_GetPlayer().GetCharacterBody().SetCameraUpdateActive(false);
		
		pCam.SetRotateMode(eCameraRotateMode_Matrix);
	}
	
	//------------------------------------------------------------
	
	void DetachCameraFromSocket(float afFadeTime)
	{
		if(msCameraAttachBone=="") return;
		
		// Force to happen now
		if (afFadeTime<=0.0f)
		{
			ClearCameraState();
		}
		
		mfCameraAttachFadeTime = afFadeTime;
		mbCameraAttachActive=false;
		
		//No need to set T, as the detach might happen when the fade is not done
	}
	
	//------------------------------------------------------------
	
	void SetAnimationOverCallback(const tString& in asFunction)
	{
		msAnimationOverCallback = asFunction;
	}
	
	//------------------------------------------------------------
	
	void SetVisible(bool abX)
	{
		CreateHandModelIfNeeded(cLux_GetCurrentMap());
		
		if (_HPL3VR_RuntimeActive_PlayerHands() && cScript_GetGlobalVarBool("UsingWauFlower")) abX=false;
		mbEntityVisible = abX;
		
		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
		pEntity.GetMeshEntity().SetVisible(mbEntityVisible && !HPL3VR_ReplaceAuthoredHands());
	}
		
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// HELPER METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void CreateHandModelIfNeeded(cLuxMap @apMap)
	{
		if(m_idHands != tID_Invalid)
		{
			//fail safe
			iLuxEntity @pEnt = cLux_ID_Entity(m_idHands);

			if(pEnt is null) m_idHands = tID_Invalid;
			else return;
		}

		iLuxEntity @pEntity = null;
				
		///////////////////////////////
		//Load the file
		if(pEntity is null)
		{
			apMap.CreateEntity("PlayerHands_"+mlHandNum++,msHandModel, cMatrixf_Identity, cVector3f(1));
			@pEntity = apMap.GetLatestEntity();
			
			if(pEntity !is null)
			{
				cLuxProp@ pProp = cast<cLuxProp>(pEntity);
				pProp.SetAllowMapTransfer(false);
			}

			pEntity.SetActive(false);
		}
		
		///////////////////////////////
		//Set up the model
		if(pEntity is null)
		{
			Error("Could not load player hand model: '"+msHandModel+"'");
		}
		else
		{
			pEntity.GetMeshEntity().SetRenderFlagBit(eRenderableFlag_ShadowCaster, false);
			pEntity.GetMeshEntity().SetRenderFlagBit(eRenderableFlag_VisibleInReflection, false);
			m_idHands = pEntity.GetID();

			SetActive(false);
			pEntity.GetMeshEntity().SetDisableSleep(true);
			pEntity.SetActive(false);
			pEntity.StopAllAnimations(0);
			
			GetMeshDepth();
		}
	}
	
	//------------------------------------------------------------
		
	void DestroyHandModel(cLuxMap @apMap)
	{
		if(m_idHands != tID_Invalid)
		{
			iLuxEntity@ pEnt = cLux_ID_Entity(m_idHands);			
			apMap.DestroyEntity(pEnt);
			
			m_idHands = tID_Invalid;
			
			mlCurrentAnimation=-1;
		}
	}
	
	//------------------------------------------------------------
			
	void GetMeshDepth()
	{
		//////////
		// Reset incase of failure
		mfMeshDepth = 0;

		/////////////
		// Get mesh
		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
		if(pEntity is null) return;
		cMeshEntity@ pMeshEntity = pEntity.GetMeshEntity();
		if(pMeshEntity is null) return;

		cMesh@ pMesh = pMeshEntity.GetMesh();

		/////////////
		// Get the base AABB of the mesh
		cVector3f vMin = 10000;
		cVector3f vMax =-10000;

		for(int i = 0; i < pMesh.GetSubMeshNum(); ++i)
		{
			cSubMesh@ pSubMesh = pMesh.GetSubMesh(i);
			iVertexBuffer@ pVtxBuffer = pSubMesh.GetVertexBuffer();
			vMin = cMath_Vector3Min(vMin, pVtxBuffer.GetAABBMin());
			vMax = cMath_Vector3Max(vMax, pVtxBuffer.GetAABBMax());
		}
		
		mfMeshDepth = vMax.x - vMin.x; //Get depth from x axis
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		
		if(mlCurrentAnimation>=0)		
		{
			iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
			cMeshEntity@ pMeshEntity = pEntity.GetMeshEntity();
			cAnimationState@ pAnim = pMeshEntity.GetAnimationState(mlCurrentAnimation);
			
			afStartY = cLux_DrawDebugText("Animation: "+pAnim.GetName()+" Rel:"+pAnim.GetRelativeTimePosition()+" Active:"+pAnim.IsActive()+" Paused:"+pAnim.IsPaused()+" Over:"+pAnim.IsOver(), afStartY);
			afStartY = cLux_DrawDebugText("Mesh active: "+pMeshEntity.IsActive(), afStartY);
		}
		else		
			afStartY = cLux_DrawDebugText("Animation: NONE", afStartY);
				
		return afStartY;
	}
	
