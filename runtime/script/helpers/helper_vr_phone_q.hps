// Temporary story phone; separate retrieval and screen confirmation. No inventory entry.
#include "helpers/helper_player.hps"
#include "helper_imgui_cellphone.hps"
bool VRPhoneQ_Active()
{
    cScript_SetGlobalReturnBool(false);
    cScript_RunGlobalFunc("MenuHandler","cScrMenuHandler","HPL3VR_GetRuntimeActive");
    return cScript_GetGlobalReturnBool();
}
class cVRPhoneQ
{
    int state=0; // 0 ended, 1 waiting for screen tap, 2 accepted, 3 declined/expired
    bool pocket=false, allowDecline=false;
    [nosave] bool guiReady=false;
    float age=0, recoveryTime=0, callAge=0;
    void Hands(int value)
    {
        cScript_SetGlobalArgInt(0,value);
        cScript_RunGlobalFunc("PlayerHandsHandler","","HPL3VR_SetSceneOverride");
    }
    bool Native(const tString &in command) { return cScript_RunGlobalFunc("VRPHONEX","",command); }
    iLuxEntity@ Entity()
    {
        return cLux_GetCurrentMap().GetEntityByName("VR_StoryPhone_Q",eLuxEntityType_LastEnum,"");
    }
    bool Spawn(const cMatrixf &in matrix)
    {
        cLuxMap@ map=cLux_GetCurrentMap();
        iLuxEntity@ phone=Entity();
        if(phone is null)
        {
            map.CreateEntity("VR_StoryPhone_Q","entities/vr/phone_q.ent",matrix,cVector3f(1));
            @phone=Entity();
        }
        if(phone is null || cLux_ToProp(phone) is null || cLux_ToProp(phone).GetMainBody() is null) return false;
        phone.SetMatrix(matrix);phone.SetActive(true);
        SetupPresentation(phone);
        cLux_ToProp(phone).GetMainBody().SetLinearVelocity(cVector3f_Zero);
        cLux_ToProp(phone).GetMainBody().SetAngularVelocity(cVector3f_Zero);
        return true;
    }
    bool Begin(const tString &in source)
    {
        if(!VRPhoneQ_Active()) return false;
        if(state!=0) return true;
        Native("B");Native("F");
        pocket=(source=="");allowDecline=pocket;
        if(!pocket)
        {
            iLuxEntity@ original=cLux_GetCurrentMap().GetEntityByName(source,eLuxEntityType_LastEnum,"");
            if(original is null || !Spawn(original.GetMatrix())) { Native("E");return false; }
        }
        else
        {
            iLuxEntity@ phone=Entity();
            if(phone !is null) phone.SetActive(false);
            Native("P");
        }
        state=1;age=0;recoveryTime=0;callAge=0;Hands(0);
        return true;
    }
    void SetupPresentation(iLuxEntity@ phone)
    {
        cLuxProp@ prop=cLux_ToProp(phone);
        prop.GetMainBody().SetGravity(true);
        if(prop.GetGuiSet() is null)
            prop.CreateAndSetupGui("screen",cColor(1,1),cColor(0,1),cColor(0,1),cVector2f(256,512));
        prop.SetOnGuiFunction("VRPhoneW_Gui");
        prop.SetGuiSetUseInput(false);
        prop.SetGuiVariableFPS(20.0f);
        prop.SetGuiActive(true);prop.ForceGuiCacheUpdate();guiReady=true;
    }
    bool Capture(iLuxEntity@ phone)
    {
        if(!Native("C")) return false;
        iPhysicsBody@ body=cLux_ToProp(phone).GetMainBody();
        bool valid=Native("D");
        return body !is null && valid;
    }
    // 1=Accept/Call tap, 2=missed call, 3=Decline/Cancel tap.
    int Tick(float timeout)
    {
        if(state==0 || !VRPhoneQ_Active()) return 0;
        Native("F");
        if(state==2) { callAge+=0.05f;Native("S"); }
        if(state==3) return 0;
        if(state==1) age+=0.05f;
        if(pocket)
        {
            Native("P");
            if(Native("G"))
            {
                cMatrixf matrix=cMatrixf_Identity;
                matrix.SetTranslation(cLux_GetPlayer().GetCamera().GetPosition());
                if(Spawn(matrix))
                {
                    iLuxEntity@ phone=Entity();
                    if(Capture(phone) && Native("R")) { pocket=false;recoveryTime=0; }
                    else { phone.SetActive(false);Native("K"); }
                }
                else Native("K");
            }
        }
        else
        {
            Native("V");
            iLuxEntity@ phone=Entity();
            if(phone !is null && cLux_ToProp(phone) !is null)
            {
                if(!guiReady) SetupPresentation(phone);
                Capture(phone);
                iPhysicsBody@ body=cLux_ToProp(phone).GetMainBody();
                if(body !is null)
                {
                    bool held=cScript_RunGlobalFunc("VRPHONEQ",""+body.GetUniqueID(),"H");
                    if(!held && (body.GetWorldPosition()-cLux_GetPlayer().GetCamera().GetPosition()).SqrLength()>0.81f) recoveryTime+=0.05f;
                    else recoveryTime=0;
                    if(recoveryTime>=3.0f) { phone.SetActive(false);pocket=true;Native("P"); }
                }
            }
            else { pocket=true;Native("P"); }
        }
        if(state!=1) return 0;
        if(!pocket && Native("A")) { state=2;Native("S");return 1; }
        if(!pocket && Native("J") && allowDecline) { state=3;Native("S");return 3; }
        if(timeout>0 && age>=timeout) { state=3;Native("S");return 2; }
        return 0;
    }
    void Draw(const tString &in caller,const tString &in clock,const tString &in reception,bool outgoing)
    {
        if(state==0 || pocket) return;
        CellPhoneGui_SetClockString(clock);CellPhoneGui_SetReceptionIcons(reception);
        Entity_SetVarString(ImGui_GetName(),"CallerID",caller);
        ImGui_SetShowMouseAutomatically(false);
        ImGui_SetStateInt("CallState",state==2 ? (outgoing ? eCellPhoneGuiState_Calling : eCellPhoneGuiState_CallInProgress) :
                         (state==3 ? (outgoing ? eCellPhoneGuiState_CancelledCall : eCellPhoneGuiState_Rejected) :
                         (outgoing ? eCellPhoneGuiState_DecideToCall : eCellPhoneGuiState_Ringing)));
        ImGui_SetStateFloat("CallTime",callAge);
        VRPhoneX_DrawGui(allowDecline);
    }
    void End()
    {
        Native("E");
        if(state==0) return;
        state=0;guiReady=false;pocket=false;
        iLuxEntity@ phone=Entity();
        if(phone !is null && cLux_ToProp(phone) !is null)
        {
            iPhysicsBody@ body=cLux_ToProp(phone).GetMainBody();
            if(body !is null) cScript_RunGlobalFunc("VRSOCKETHELD",""+body.GetUniqueID(),"R");
            cLux_ToProp(phone).SetGuiActive(false);phone.SetActive(false);
        }
        Hands(-1);
    }
}

// Stock phone artwork, layout and translations; apartment omits the unavailable decline branch.
eCellPhoneGuiAction VRPhoneX_DrawGui(bool allowDecline)
{
	float fCallTime = ImGui_GetStateFloat("CallTime",0);
	int lState = ImGui_GetStateInt("CallState",0);
	tString sClockString = Entity_GetVarString(ImGui_GetName(), "ClockString");
	tString sReceptionIcons = Entity_GetVarString(ImGui_GetName(), "ReceptionIcons");
	
	ImGui_SetTransCategory("Phone");
	
	// Background		
	ImGui_DoImage(cImGuiGfx("smartphone_backdrop"), 0, ImGui_NrmSize(1));
	
	// Power/signal icons
	ImGui_DoImageCorrectAspect(cImGuiGfx("smartphone_icons"+sReceptionIcons), ImGui_NrmPos(0.02, -0.03, 1), ImGui_NrmSize(0.2, 0.1));
	
	// Clock
	cImGuiLabelData label = ImGui_GetDefaultLabel();
	label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Medium_Bold));
	label.mFontAlign = eFontAlign_Right;
	label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
	ImGui_DoLabelExt(sClockString, label, ImGui_NrmPos(0, 0, 1), ImGui_NrmSize(0.97, -1));
	
	tString sCallerID = Entity_GetVarString(ImGui_GetName(), "CallerID");
	
	//////////////
    // Image
	if (lState!=eCellPhoneGuiState_Idle)
	{
		// Image
		ImGui_DoImageCorrectAspect(cImGuiGfx("smartphone_avatar_"+sCallerID), ImGui_NrmPosGroup(0.2, 0.05, 1), ImGui_NrmSizeGroup(0.6, 0.5));
		
		// Caller ID
		label.mFontAlign = eFontAlign_Center;
		label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.06f);
		ImGui_DoLabelExt("Caller_"+sCallerID, label, ImGui_NrmPos(0, 0.5, 1), ImGui_NrmSize(1, -1));
	}
	
	if (lState==eCellPhoneGuiState_Idle)
	{
	}
	else if (lState==eCellPhoneGuiState_Ringing)
	{
		// Answer
		cImGuiButtonData answerButton;
		answerButton.mbUseBackgroundGfx = true;
		answerButton.mbUseInFocusColor = true;
		answerButton.mGfxBackground = cImGuiGfx("smartphone_icon_answer");
		answerButton.mColorBase = cColor(0.35f,1);
		answerButton.mColorInFocus = cColor(ImGui_FadeOscillateFloat("ButtonAnswerFocusColor", 0.5, 1.5, 0.75f, eEasing_QuadInOut));
				
		// Ignore
		cImGuiButtonData ignoreButton = answerButton;
		ignoreButton.mGfxBackground = cImGuiGfx("smartphone_icon_ignore");
		
		if (ImGui_DoButtonExt("AnswerButton", "", answerButton, ImGui_NrmPosGroup(0.05, 0.6, 1), ImGui_NrmSizeGroup(0.45, 0.175)))
		{
			// Answered
			CellPhoneGui_PickUp(sCallerID);
			return eCellPhoneGuiAction_Answered;
		}
		if (allowDecline && ImGui_DoButtonExt("IgnoreButton", "", ignoreButton, ImGui_NrmPosGroup(0.525, 0.6, 1), ImGui_NrmSizeGroup(0.45, 0.175)))
		{
			// Hung up
			CellPhoneGui_RejectCall(sCallerID);
			return eCellPhoneGuiAction_RejectedCall;
		}
			
		if(ImGui_BecameInFocus())
		{
			ImGui_SetFocus("AnswerButton");
		}
		
		if(ImGui_TimerOver("PhoneTimeout"))
		{
			CellPhoneGui_MissedCall(sCallerID);
			return eCellPhoneGuiAction_MissedCall;
		}
	}
	else if (lState==eCellPhoneGuiState_CallInProgress)
	{
		// Call in Progress icon
		ImGui_SetModRotateAngle(ImGui_FadeOscillateFloat("CallProgressIcon",25,35,1.0f));
		ImGui_DoImageCorrectAspect(cImGuiGfx("smartphone_calling"), ImGui_NrmPos(0.3,0.55,1), ImGui_NrmSize(0.4,0.3));
		ImGui_SetModRotateAngle(0);
		
		// Duration
		label.mFontAlign = eFontAlign_Center;
		label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.03);
		ImGui_DoLabelExt("DurationHeader", label, ImGui_NrmPos(0, 0.8, 1), ImGui_NrmSize(1, -1));
		label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.07);
		ImGui_SetTransCategory("");
		ImGui_DoLabelExt(String_SecondsToClockDisplay(fCallTime, true, true, true, false), label, ImGui_NrmPosGroup(0, 0.83, 1), ImGui_NrmSizeGroup(1, -1));
	}
	else if (lState==eCellPhoneGuiState_MissedCall)
	{
		// Missed Call
		CellphoneGui_StatusText("MissedCall");
	}
	else if (lState==eCellPhoneGuiState_Rejected)
	{
		// Rejected Call
		CellphoneGui_StatusText("RejectedCall");
	}
	else if (lState==eCellPhoneGuiState_DecideToCall)
	{
		// Call
		cImGuiButtonData callButton;
		callButton.mbUseBackgroundGfx = true;
		callButton.mbUseInFocusColor = true;
		callButton.mGfxBackground = cImGuiGfx("smartphone_icon_call");
		callButton.mColorBase = cColor(0.35f,1);
		callButton.mColorInFocus = cColor(ImGui_FadeOscillateFloat("ButtonAnswerFocusColor", 0.5, 1.5, 0.75f, eEasing_QuadInOut));
				
		// Cancel
		cImGuiButtonData cancelButton = callButton;
		cancelButton.mGfxBackground = cImGuiGfx("smartphone_icon_cancel");
		
		if (ImGui_DoButtonExt("CallButton", "", callButton, ImGui_NrmPosGroup(0.05, 0.6, 1), ImGui_NrmSizeGroup(0.45, 0.175)))
		{
			// Called
			CellPhoneGui_Calling(sCallerID);
			return eCellPhoneGuiAction_Called;
		}
		if (ImGui_DoButtonExt("CancelButton", "", cancelButton, ImGui_NrmPosGroup(0.525, 0.6, 1), ImGui_NrmSizeGroup(0.45, 0.175)))
		{
			// Cancelled
			CellPhoneGui_CancelledCall(sCallerID);
			return eCellPhoneGuiAction_CancelledCall;
		}
			
		if(ImGui_BecameInFocus())
		{
			ImGui_SetFocus("CallButton");
		}
	}
	else if (lState==eCellPhoneGuiState_CancelledCall)
	{
		// Cancelled Call
		CellphoneGui_StatusText("CancelledCall");
	}	
	else if (lState==eCellPhoneGuiState_Calling)
	{
		// Calling
		CellphoneGui_StatusText("Calling");
	}
	
	return eCellPhoneGuiAction_None;
}

