/**
 * Creates an array of particle systems with a given name.
 * 
 * @param asName name of particle systems. May contain * as wildcards.
 * @param avOutParticles reference to array that will be filled with particle systems.
 * @return array<tID>, array of id to particle systems found.
 **/
array<tID> Map_GetParticleSystemIDArray(const tString &in asName, array<tID> &inout avOutParticles)
{
	////////////////////////////
	//If no asterix, just do normal search
	if(cString_GetFirstStringPos(asName, "*")<0)
	{
		avOutParticles.resize(0);
		
		cParticleSystemIterator@ it = cLux_GetCurrentMap().GetWorld().GetParticleSystemIterator();
	
		while(it.HasNext())
		{
			cParticleSystem@ pPS = it.Next();
			
			if(pPS.GetName() == asName)
			{
				avOutParticles.push_back(pPS.GetID());
			}
		}
		
		return avOutParticles;
		
	}

	////////////////////////////
	//Get the strings that we want to search for
	array<tString> vWantedStrings;
	tString sSepp = "*";
	cString_GetStringVec(asName,vWantedStrings, sSepp);

	bool bFirstCharWildCard = asName[0]=='*';

	////////////////////////////
	//Iterate entities
	cParticleSystemIterator@ it = cLux_GetCurrentMap().GetWorld().GetParticleSystemIterator();
    while(it.HasNext())
	{
		cParticleSystem@ pPS = it.Next();
		
		bool bContainsStrings = true;
		int lLastPos = -1;

		//Iterate wanted strings and name make sure they exist and show up in correct order.
		for(uint i=0; i<vWantedStrings.length(); ++i)
		{
			int lPos = cString_GetFirstStringPos(pPS.GetName(), vWantedStrings[i]);
		
			//If the next string was found before the previous OR the first string is at the start of the string, skip this particle system.
			if(lPos <= lLastPos || (bFirstCharWildCard==false && lLastPos==-1 && lPos!=0) ) 
			{
				bContainsStrings = false;
				break;
			}

			lLastPos = lPos;
		}

		//Add entity
		if(bContainsStrings)
		{
			avOutParticles.push_back(pPS.GetID());
		}
	}
	 
	return avOutParticles;
}

