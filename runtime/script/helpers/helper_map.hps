//-------------------------------------------------

/** 
 * Sets the wind of the env particles
 * @param asName Name of the env particle, wildcard accepted
 * @param asClipSourceEntity Name of the entity to use for clipping, will use main body or mesh entity bounding volume
 * @param abAdditive If the area should be used to add or remove env particles
 */
void Map_AddEnvironmentParticleClipArea(tString asName, tString asClipSourceEntity, bool abAdditive=true)
{
	iLuxEntity@ pEnt = Map_GetEntity(asClipSourceEntity);

	if(pEnt is null)
	{
		Error("Could not find clip entity '"+asClipSourceEntity+"' in Map_AddEnvironmentParticleClipArea");
		return;
	}

	array<cEnvironmentParticles@> vParticles;
	Map_GetEnvironmentParticles(asName, vParticles);

	if(vParticles.empty() && asName != "*")
	{
		Error("Could not find EnvironmentParticles with the name "+asName+ " in Map_AddEnvironmentParticleClipArea");
		return;
	}
	
	for(uint i = 0; i < vParticles.length(); ++i)
	{
		if(pEnt.GetMainBody() !is null)
		{
			vParticles[i].AddClipArea(pEnt.GetMainBody(), abAdditive == false);
		}
		else
		{
			vParticles[i].AddClipArea(pEnt.GetMeshEntity(), abAdditive == false);
		}
	}
}

/** 
 * Sets the wind of the env particles
 * @param asName Name of the env particle, wildcard accepted
 * @param asClipSourceEntity Name of the entity to use for clipping, will use main body or mesh entity bounding volume
 */
void Map_RemoveEnvironmentParticleClipArea(tString asName, tString asClipSourceEntity)
{
	iLuxEntity@ pEnt = Map_GetEntity(asClipSourceEntity);

	if(pEnt is null)
	{
		Error("Could not find clip entity '"+asClipSourceEntity+"' in Map_AddEnvironmentParticleClipArea");
		return;
	}

	array<cEnvironmentParticles@> vParticles;
	Map_GetEnvironmentParticles(asName, vParticles);

	if(vParticles.empty() && asName != "*")
	{
		Error("Could not find EnvironmentParticles with the name '"+asName+ "' in Map_RemoveEnvironmentParticleClipArea");
		return;
	}
	
	for(uint i = 0; i < vParticles.length(); ++i)
	{
		if(pEnt.GetMainBody() !is null)
		{
			vParticles[i].RemoveClipArea(pEnt.GetMainBody());
		}
		else
		{
			vParticles[i].RemoveClipArea(pEnt.GetMeshEntity());
		}
	}
}

