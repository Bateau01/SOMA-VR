void Map_SetEnvironmentParticlesActive(bool abState)
{
	cLux_GetCurrentMap().GetWorld().SetEnvironmentParticlesActive(abState);
}

//-------------------------------------------------

/**
 * Get all env particles that match name
 * @param asName Name of the env particle, wildcard accepted
 * @param avParticles Array where the matching cEnvironmentParticles objects will be returned to.
 */
array<cEnvironmentParticles@> Map_GetEnvironmentParticles(tString asName, array<cEnvironmentParticles@> &inout avParticles)
{
	cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();

	if(cString_GetFirstStringPos(asName, "*") < 0)
	{
		for(int i = 0; i < pWorld.GetEnvironmentParticleNum(); ++i)
		{
			cEnvironmentParticles@ pPart = pWorld.GetEnvironmentParticles(i);

			if(pPart.GetName() == asName) avParticles.push_back(pPart); 
		}
	}
	else
	{
		array<tString> vWantedStrings;
		tString sSepp = "*";
		cString_GetStringVec(asName, vWantedStrings, sSepp);

		bool bFirstCharWildCard = asName[0] == '*';
		for(int i = 0; i < pWorld.GetEnvironmentParticleNum(); ++i)
		{
			cEnvironmentParticles@ pPart = pWorld.GetEnvironmentParticles(i);
			bool bContainsStrings = true;
			int lLastPos = -1;

			//Iterate wanted strings and name make sure they exist and show up in correct order.
			for(uint j=0; j<vWantedStrings.size(); ++j)
			{
				int lPos = cString_GetFirstStringPos(pPart.GetName(), vWantedStrings[j]);
		
				//If the next string was found before the previous OR the first string is at the start of the string, skip this entity.
				if(lPos <= lLastPos || (bFirstCharWildCard == false && lLastPos == -1 && lPos != 0)) 
				{
					bContainsStrings = false;
					break;
				}

				lLastPos = lPos;
			}

			//Add entity
			if(bContainsStrings)
			{
				avParticles.push_back(pPart); 
			}
		}
	}

	return avParticles;
}

/** 
 * Toggle visiblity for specific layer
 * @param asName Name of the env particle, wildcard accepted
 * @param abVisible If visible
 */
void Map_SetEnvironmentParticleVisible(tString asName, bool abVisible)
{
	array<cEnvironmentParticles@> vParticles;
	Map_GetEnvironmentParticles(asName, vParticles);

	if(vParticles.empty() && asName != "*")
	{
		Error("Could not find EnvironmentParticles with the name "+asName+ " in Map_SetEnvironmentParticleVisible");
		return;
	}

	for(uint i = 0; i < vParticles.length(); ++i)
	{
		vParticles[i].SetVisible(abVisible);
	}
}

