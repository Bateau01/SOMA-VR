//-------------------------------------------------

/**
 * Sets the displayed name of the current map.
 * 
 * @param asNameEntry new name of the map.
 **/
void Map_SetDisplayNameEntry(const tString&in asNameEntry)
{
	cLuxMap@ pMap = cLux_GetCurrentMap();
	pMap.SetDisplayNameEntry(asNameEntry);
}

//-------------------------------------------------

/**
 * Activates or deactivates the skybox of the current map
 * 
 * @param abX true = activate - false = deactivate.
 **/
void Map_SetSkyBoxActive(bool abX)
{
	cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();

	pWorld.SetSkyBoxActive(abX);
}

/**
 * Sets the texture of the skybox in the current map
 * 
 * @param asTexture file name of the texture to set.
 **/
void Map_SetSkyBoxTexture(const tString&in asTexture)
{
	cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();

    iTexture@ pTexture = null;
	if(asTexture != "")
		@pTexture = cResources_CreateTextureCubeMap(asTexture,  true);
    
	pWorld.SetSkyBox(pTexture, true);
}

/**
 * Sets the color of the skybox in the current map
 * 
 * @param acColor color to set.
 **/
void Map_SetSkyBoxColor(const cColor&in acColor)
{
	cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();

	pWorld.SetSkyBoxColor(acColor);
}

//-------------------------------------------------

/**
 * Activates or deactivates fog in the current map
 * 
 * @param abX true = activate - false = deactivate.
 **/
void Map_SetFogActive(bool abX)
{
	cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();

	pWorld.SetFogActive(abX);
}

/**
 * Sets the properties of the fog in the current map
 * 
 * @param afStart start distance of fog.
 * @param afEnd distance where the fog effect is maxed out.
 * @param afFalloffExp rate at which the fog effect will decrease over the distance between afStart and afEnd.
 * @param acColor color of fog.
 * @param abCulling true = objects hidden by fog are not rendered - false = fog has no effect on whether objects are rendered or not.
 **/
void Map_SetFogProperties(float afStart, float afEnd, float afFalloffExp, const cColor&in acColor, bool abCulling)
{
	cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();

	pWorld.SetFogStart(afStart);
	pWorld.SetFogEnd(afEnd);
	pWorld.SetFogFalloffExp(afFalloffExp);
	pWorld.SetFogColor(acColor);
	pWorld.SetFogCulling(abCulling);
}

//-------------------------------------------------

/**
 * Activates or deactivates the secondary fog
 * 
 * @param abX true = activate - false = deactivate.
 **/
void Map_SetSecondaryFogActive(bool abX)
{
	cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();

	pWorld.SetSecondaryFogActive(abX);
}

/**
 * Sets the properties of the secondary fog, both the primary and secondary fog will be applied, these are order independent
 * 
 * @param afStart start distance of fog.
 * @param afEnd distance where the fog effect is maxed out.
 * @param afFalloffExp rate at which the fog effect will decrease over the distance between afStart and afEnd.
 * @param acColor color of fog.
 **/
void Map_SetSecondaryFogProperties(float afStart, float afEnd, float afFalloffExp, const cColor&in acColor)
{
	cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();

	pWorld.SetSecondaryFogStart(afStart);
	pWorld.SetSecondaryFogEnd(afEnd);
	pWorld.SetSecondaryFogFalloffExp(afFalloffExp);
	pWorld.SetSecondaryFogColor(acColor);
}

