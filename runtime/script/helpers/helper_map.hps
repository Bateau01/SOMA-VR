/** 
 * Setup fog for the specified preset
 *
 * @param asName Name of the preset
 * @param abActive If fog should be active
 * @param afStart Where fog starts showing
 * @param afEnd Where fog has full effect
 * @param afFalloffExp How fast the fog fades to full effect, lower is faster
 * @param aColor Color of the fog
 * @param afBrightness Brightness of the fog
 * @param abUnderwater If underwater fog should be used
 * @param abSkybox If fog color should be taken from skybox
 */
void Map_Preset_SetupFog(tString asName, bool abActive, float afStart = 0, float afEnd = 0, float afFalloffExp = 1, cColor aColor=1, float afBrightness=1, bool abUnderwater=false, bool abSkybox=false)
{
	iScrMapEffectsHandler_Interface @pEffectsHandler = cast<iScrMapEffectsHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_MapEffectsHandler) );
	pEffectsHandler.PresetSetFog(asName, abActive, afStart, afEnd, afFalloffExp, aColor, afBrightness, abUnderwater, abSkybox);
}

/** 
 * Setup secondary fog for the specified preset
 *
 * @param asName Name of the preset
 * @param abActive If fog should be active
 * @param afStart Where fog starts showing
 * @param afEnd Where fog has full effect
 * @param afFalloffExp How fast the fog fades to full effect, lower is faster
 * @param aColor Color of the fog
 * @param afBrightness Brightness of the fog
 */
void Map_Preset_SetupSecondaryFog(tString asName, bool abActive, float afStart=0, float afEnd=0, float afFalloffExp=1, cColor aColor=1, float afBrightness=1)
{
	iScrMapEffectsHandler_Interface @pEffectsHandler = cast<iScrMapEffectsHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_MapEffectsHandler) );
	pEffectsHandler.PresetSetSecondaryFog(asName, abActive, afStart, afEnd, afFalloffExp, aColor, afBrightness);
}

/** 
 * Setup depth of field for specified preset
 *
 * @param asName Name of the preset
 * @param abActive If DoF should be active
 * @param afStart Where near plane starts
 * @param afEnd Where far plane starts
 * @param afFalloff How fast the depth of field fades in
 */
void Map_Preset_SetupDepthOfField(tString asName, bool abActive, float afStart=0, float afEnd=0, float afFalloff=1)
{
	iScrMapEffectsHandler_Interface @pEffectsHandler = cast<iScrMapEffectsHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_MapEffectsHandler) );
	pEffectsHandler.PresetSetDepthOfField(asName, abActive, afStart, afEnd, afFalloff);
}

