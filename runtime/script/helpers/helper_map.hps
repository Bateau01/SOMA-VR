//-------------------------------------------------

/**
 * Changes the active map to the one specified.
 * 
 * @param asMapName map to change to.
 * @param asStartPos name of the player start node that the player should begin at.
 * @param asStartSound sound that plays before loading the map.
 * @param asEndSound sound that plays as the new map starts.
 **/
// S26BT: finish VR Push while its prop still exists, before spatial deload.
void Map_HPL3VR_EndPushForTransfer()
{
    if(cLux_GetPlayer().GetCurrentStateId()!=ePlayerState_Push) return;
    cScript_SetGlobalReturnBool(false);
    cScript_RunGlobalFunc("MenuHandler", "", "HPL3VR_GetRuntimeActive");
    if(cScript_GetGlobalReturnBool()) cLux_GetPlayer().ChangeState(ePlayerState_Normal);
}

void Map_ChangeMap(const tString &in asMapName, const tString &in asStartPos, 
				   const tString &in asStartSound, const tString &in asEndSound)
{
	// Hack to stop gravity/grab issues when passing through a transition
	if (cLux_GetPlayer().GetCurrentStateName()=="State_Interact_Grab")
		cLux_GetPlayer().ChangeState(ePlayerState_Normal);
	Map_HPL3VR_EndPushForTransfer();
	cLux_ChangeMap(asMapName, asStartPos, "", asStartSound, asEndSound);
}

/**
 * Changes the active map to the one specified.
 * 
 * @param asMapName map to change to.
 * @param asStartPos name of the player start node that the player should begin at.
 * @param asTransferArea name of the area used to transfer objects (and the player) from one map to another
 * @param asStartSound sound that plays before loading the map.
 * @param asEndSound sound that plays as the new map starts.
 **/
void Map_ChangeMap(const tString &in asMapName, const tString &in asStartPos, const tString &in asTransferArea, 
				   const tString &in asStartSound, const tString &in asEndSound)
{
	// Hack to stop gravity/grab issues when passing through a transition
	if (cLux_GetPlayer().GetCurrentStateName()=="State_Interact_Grab")
		cLux_GetPlayer().ChangeState(ePlayerState_Normal);
	Map_HPL3VR_EndPushForTransfer();
	cLux_ChangeMap(asMapName, asStartPos, asTransferArea, asStartSound, asEndSound);
}

/** 
 * Starts loading in assets for the next map
 *
 * @param asMapName Map to load data for
 * @param aPrio How intrusive the preload is
 **/
void Map_Preload(const tString &in asMapName, eWorldStreamPriority aPrio=eWorldStreamPriority_Normal)
{
	cLux_PreloadMap(asMapName);
}

/** 
 * Prioirty of background download thread
 *
 * @param aPrio How intrusive the preload is
 **/
void Map_SetPreloadPriority(eWorldStreamPriority aPrio)
{
	cLux_SetMapPreloadPriority(aPrio);
}

/** 
 * Returns the map that is currently being preloaded
 *
 **/
cLuxMap@ Map_GetPreloadMap()
{
	return cLux_GetPreloadMap();
}

/** 
 * Deloads the objects in the current map
 *
 * @param asTransferArea Objects inside this area will not be deloaded
 **/
void Map_Deload(const tString &in asTransferArea = "")
{
	//cLux_GetSaveHandler().AutoSave(false, true); //Save right before deloading, since it is not possible to save during
    // S26BG: hidden VR inventory carriers retain their last world position.
    // Preserve the existing owned Omni carrier before native spatial deload;
    // no per-frame scan and no replacement entity/story callback is needed.
    if(asTransferArea != ""){
        cScript_SetGlobalArgString(0, asTransferArea);
        cScript_RunGlobalFunc("PlayerToolHandler", "", "_Global_VRPreserveOmniForDeload");
        cScript_SetGlobalArgString(0, asTransferArea);
        cScript_RunGlobalFunc("PlayerToolHandler", "", "_Global_VRPreserveKeysForDeload");
    }
	Map_HPL3VR_EndPushForTransfer();
	cLux_DeloadMap(asTransferArea);
}

/**
 * Fades out the screen and all the sounds. Should be called some second before calling change map
 * 
 * @param afTime time to fade out over
 **/
void Map_FadeOut(float afTime)
{
	cLux_GetEffectHandler().FadeOut(afTime);
	cSound_FadeOutAll(eSoundEntryType_WorldAll, 1.0f / afTime, false);
}

/** 
 * Returns if a map change is occuring 
 *
 **/
bool Map_IsChanging()
{
	return cLux_IsChangingMap();
}

/** 
 * Returns if a map is being streamed in
 *
 **/
bool Map_IsPreloading()
{
	return cLux_IsStreamingMap();
}

/**
 * Returns if the map has been fully preloaded
 *
 **/
bool Map_IsPreloadCompleted()
{
	return cLux_IsReadyToChangeMap();
}

