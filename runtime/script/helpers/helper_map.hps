/**
 * Disables interaction on all entities that are not on the white list
 * 
 * @param abActive if the white list should be used
 * @param abClearList if the white list should be reset
 **/
void Map_SetInteractionWhiteListActive(bool abActive, bool abClearList)
{
	cLux_SetInteractionWhiteListActive(abActive, abClearList);
}

//-------------------------------------------------

/**
 * Adds an entity to the white list, meaning that is can be intereacted with
 * 
 * @param asName Name of the entity
 **/
void Map_AddEntityToInteractionWhiteList(const tString &in asName)
{
	if (cLux_GetCurrentMap() is null) return;
	
	iLuxEntity@ pEntity = cLux_GetCurrentMap().GetEntityByName(asName, eLuxEntityType_LastEnum, "");
		
	if(pEntity !is null) cLux_AddEntityToInteractionWhiteList(pEntity);
}

