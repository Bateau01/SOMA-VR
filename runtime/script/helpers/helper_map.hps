//-------------------------------------------------

/**
 * Set if visibility area is active (visible) or not.
 * 
 * @param asName Name of the entity, Wildcard(s) * are supporeed
 * @param abActive If true, area will become active
 **/
void Visibility_SetAreaActive(const tString &in asName, bool abActive)
{
	/////////////////////////////////////////
	// Get all entities
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asName, eLuxEntityType_Area, "VisibilityArea", vEntities);
	if(vEntities.length() == 0)
	{
		Error("Could not find any VisibilityAreas with name '"+asName+"' for Visibility_SetAreaActive");
		return ;
	}
		
	/////////////////////////////
	// Iterate Parents
	for(uint i=0; i<vEntities.length(); ++i)
	{
		iLuxEntity@ pEntity = vEntities[i];
		
		pEntity.SetActive(abActive);
	}
	
	return;
}

/**
 * Set if the main visiblity area should be active
 * 
 **/
void Visibility_SetMainActive(bool abActive)
{
	cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();
	pWorld.SetMainRenderableContainerVisible(abActive);
	return;
}

/**
 * Set if the terrain should be visible area should be active
 * 
 **/
void Visibility_SetTerrainActive(bool abActive)
{
	cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();
	pWorld.SetTerrainActive(abActive);
	return;
}

//-------------------------------------------------

/////////////////////////////////////////
// DECALS
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Sets visiblity of all decals with material in the area
 * 
 * @param abVisible If visible or not
 * @param avMin Min of area
 * @param avMax Max of area
 * @param avMaterials Array of decals with materials to affect
 **/
void Decal_SetVisibleInArea(bool abVisible, const cVector3f&in avMin, const cVector3f&in avMax, array<tString> avMaterials)
{
	array<cSubMeshEntity@> vSubMeshes;
	cLux_GetCurrentMap().GetWorld().GetSubMeshEntityInArea(vSubMeshes, avMin, avMax);

	for(uint i = 0; i < vSubMeshes.length(); ++i)
	{
		cSubMeshEntity@ pMesh = vSubMeshes[i];
		cMaterial@ pMat = pMesh.GetMaterial();

		if(pMat !is null)
		{
			tString sFileName = cString_GetFileName(pMat.GetName());

			for(uint j = 0; j < avMaterials.length(); ++j)
			{
				if(sFileName == avMaterials[j])
				{
					pMesh.SetVisible(abVisible);
					break;
				}
			}
		}
	}
} 

//-----------------------------------------------

/**
 * Sets visiblity of all decals with material in the area
 * 
 * @param abVisible If visible or not
 * @param asArea Name of the area that the decals has to intersect with
 * @param avMaterials Array of decals with materials to affect
 **/
void Decal_SetVisibleInArea(bool abVisible, const tString&in asArea, array<tString> avMaterials)
{
	iLuxEntity@ pEnt = Map_GetEntity(asArea);

	if(pEnt is null)
	{
		Error("Failed to use Decal_SetVisibleInArea(), No Area with the name '" + asArea +"'");
	}
	else
	{
		cBoundingVolume@ pBV = null;

		if(pEnt.GetMainBody() !is null) @pBV = pEnt.GetMainBody().GetBoundingVolume();
		else if(pEnt.GetMeshEntity() !is null) @pBV = pEnt.GetMeshEntity().GetBoundingVolume();

		if(pBV is null)
		{
			Error("Failed to use Decal_SetVisibleInArea(), No Area with the name '" + asArea +"'");
		}
		else
		{
			Decal_SetVisibleInArea(abVisible, pBV.GetMin(), pBV.GetMax(), avMaterials);
		}
	}
} 

//-----------------------------------------------

/**
 * Sets visiblity of all decals with material in the area
 * 
 * @param abVisible If visible or not
 * @param asArea Name of the area that the decals has to intersect with
 * @param asMaterial Only decals with this material will be affected
 **/
void Decal_SetVisibleInArea(bool abVisible, const tString&in asArea, tString asMaterial)
{
	array<tString> vMaterials = { asMaterial };
	Decal_SetVisibleInArea(abVisible, asArea, vMaterials);
} 

