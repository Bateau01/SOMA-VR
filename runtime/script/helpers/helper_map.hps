//-------------------------------------------------

/**
 * Trigger a callback function in X seconds. The timer is added to the front of a list, so in case there are many timers with the same name, this one will be used for any funcion calls.
 * 
 * @param asName name of the timer that will trigger a callback function.
 * @param afTime time in seconds for when to trigger the callback function.
 * @param asFunction name of the callback function.
 * 
 * Syntax for callback function, void FunctionName(const tString &in asTimer).
 * @abbreviation syntax for the callback function code snippet, clbTimer.
 **/
void Map_AddTimer(const tString&in asName, float afTime, const tString&in asFunction)
{
	cLux_GetCurrentMap().AddTimer(asName, afTime, asFunction);
}

//-------------------------------------------------

/**
 * Remove a created timer.
 * 
 * @param asName name of the timer to remove. (if called inside a timer callback, the parent timer will be chosen in case there are many with the same name)
 **/
void Map_RemoveTimer(const tString&in asName)
{
	cLux_GetCurrentMap().RemoveTimer(asName);
}

//-------------------------------------------------

/**
 * Get the current time of a created timer.
 * 
 * @param asName name of the timer. (if called inside a timer callback, the parent timer will be chosen in case there are many with the same name)
 **/
float Map_GetTimerTime(const tString&in asName)
{
	return cLux_GetCurrentMap().GetTimerTime(asName);
}

//-------------------------------------------------

/**
 * Get if the specified timer exists.
 * 
 * @param asName name of the timer. (if called inside a timer callback, the parent timer will be chosen in case there are many with the same name)
 * 
 * @return bool, true if the timer exists.
 **/
bool Map_TimerExists(const tString&in asName)
{
	return (cLux_GetCurrentMap().GetTimerTime(asName) > 0);
}

//-------------------------------------------------

/**
 * Pause/unpause a created timer.
 * 
 * @param asName name of the timer to remove. (if called inside a timer callback, the parent timer will be chosen in case there are many with the same name)
 * @param abX true = pause - false = unpause.
 **/
void Map_SetTimerPaused(const tString&in asName, bool abX)
{
	cLux_GetCurrentMap().SetTimerPaused(asName, abX);
}

//-------------------------------------------------

/**
 * Checks if a timer with the specified name has reached 0, and if so recreates the timer with the specified time and returns true.
 * Use in if-cases to limit how often the script within the case can run.
 * 
 * @param asName name of the timer to check/create. (if called inside a timer callback, the parent timer will be chosen in case there are many with the same name)
 * @param afTime time to set the timer to if created.
 * 
 * @return bool, true if the time has passed and a new timer was created, otherwise false.
 **/
bool Map_TimeHasPassed(const tString&in asName, float afTime)
{
	if (cLux_GetCurrentMap().GetTimerTime(asName) <= 0)
	{
		cLux_GetCurrentMap().AddTimer(asName, afTime, "");
		return true;
	}
	return false;
}

//-------------------------------------------------

/**
 * If used inside a timer callback it will restart that the timer that issued that callback.
 * 
 * @param afNewTime The time for the new timer to make a callback, if <0 then previous time is used.
 * 
 **/
void Map_RestartCurrentTimer(float afNewTime=-1)
{
	cLux_GetCurrentMap().RestartCurrentTimer(afNewTime);
}

