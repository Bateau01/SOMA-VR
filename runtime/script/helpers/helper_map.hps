/** 
 * Fade in the preset
 *
 * @param asName Name of the preset
 * @param afFadeTime How long it should take to fade in
 */
void Map_Preset_Fade(tString asName, float afFadeTime)
{
	iScrMapEffectsHandler_Interface @pEffectsHandler = cast<iScrMapEffectsHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_MapEffectsHandler) );
	pEffectsHandler.FadePreset(asName, afFadeTime);
}
	
/** 
 * Copies and fades in settings of another map
 *
 * @param apMap Map to copy from
 * @param afFadeTime How long it should take to fade in
 */
bool Map_CopyGlobalSettings(cLuxMap@ apMap, float afFadeTime)
{
	if(apMap is null || apMap.GetWorld() is null)
	{
		Error("Failed to copy global settings from the map, it might not have been created yet, try again in a while");

		return false;
	}

	iScrMapEffectsHandler_Interface @pEffectsHandler = cast<iScrMapEffectsHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_MapEffectsHandler) );
	pEffectsHandler.FadeToWorldSettings(apMap.GetWorld(), afFadeTime);

	return true;
}

//-------------------------------------------------

/**
 * Actives distance culling and sets the min and max range to the value. Any objects further away then that range will get culled
 * Only use this function on maps that dont have distance culling active from the .map file
 *
 * @param afRange any object further away than this will get culled
 * @param afRandomSize adds a little random distance to each object, so that not all objects are culled at exactly the same distance
 */
void Map_SetDistanceCullingRange(float afRange, float afRandomSize = 0)
{
	cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();

	pWorld.SetDistanceCullActive(true);
	pWorld.SetDistanceCullMinRange(afRange - 0.1);
	pWorld.SetDistanceCullMaxRange(afRange + 0.1);
	pWorld.SetDistanceCullRandomSize(afRandomSize);
	pWorld.SetDistanceCullFadeSpeed(0.1);
}

/**
 * Disables distance culling
 */
void Map_DisableDistanceCulling()
{
	cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();

	pWorld.SetDistanceCullActive(false);
}

//-------------------------------------------------

/**
 * Sets if the map is underwater or not, and the correct properties for the state.
 * 
 * @param abX if the map should be underwater or not.
 * @param abUseStartAndEndEffects if special effect should play at start or end.
 **/
void Map_SetUnderwater(bool abX, bool abUseStartAndEndEffects = false)
{
	cScript_SetGlobalVarBool("MapUnderwater", abX);
	
	/////////////////////////
	//Player
	//NOTE: If you update this, update Player_SetUnderwater too!
	cScript_SetGlobalVarBool("PlayerUnderwater", abX);
	if(abX)
	{
		cScript_SetGlobalArgVector3f(0, cVector3f(0,-2,0));
		cScript_RunGlobalFunc("LuxPlayer","","_Global_SetGravity");
	}
	else
	{
		cScript_SetGlobalArgVector3f(0, cVector3f(0,-12,0));
		cScript_RunGlobalFunc("LuxPlayer","","_Global_SetGravity");
	}
	
	//////////////////////////
	//Sound effect
	if(abX)
		cLux_IncUnderwaterEffectUserCount();
	else
		cLux_DecUnderwaterEffectUserCount();
		
	cLux_SetUnderwaterEffectsActive(abX, abUseStartAndEndEffects);
	
	//////////////////////////
	//Map properties
	cLuxMap @pMap = cLux_GetCurrentMap();
	pMap.SetIsUnderwater(abX);

	iPhysicsWorld @pPhysicsWorld = pMap.GetPhysicsWorld();
		
	if(abX)
	{
		pPhysicsWorld.SetGravity(cVector3f(0,-1.5f,0));
	}
	else
	{
		pPhysicsWorld.SetGravity(cVector3f(0,-9.81f,0));	
	}
}

