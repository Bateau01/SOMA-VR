//-------------------------------------------------

/**
 * Creates an array of sound entities with a given name.
 * 
 * @param asName name of the sound entities. May contain * as wildcards.
 * @param avOutSoundEntities reference to array that will be filled with sounds.
 * @return array<cSoundEntity@>, array of sound entities found.
 **/
array<cSoundEntity@> Map_GetSoundEntityArray(const tString &in asName, array<cSoundEntity@> &inout avOutSoundEntities)
{
	////////////////////////////
	//If no asterix, just do normal search
	if(cString_GetFirstStringPos(asName, "*") < 0)
	{
		avOutSoundEntities.resize(0);
		
		cSoundEntity@ pSoundEntity = cLux_GetCurrentMap().GetWorld().GetSoundEntity(asName);
		
		if(pSoundEntity !is null) avOutSoundEntities.push_back(pSoundEntity);
		
		return avOutSoundEntities;
	}

	////////////////////////////
	//Get the strings that we want to search for
	array<tString> vWantedStrings;
	tString sSepp = "*";
	cString_GetStringVec(asName, vWantedStrings, sSepp);

	bool bFirstCharWildCard = asName[0] == '*';

	////////////////////////////
	//Iterate entities
	cSoundEntityIterator@ it = cLux_GetCurrentMap().GetWorld().GetSoundEntityIterator();
    while(it.HasNext())
	{
		cSoundEntity@ pSoundEntity = it.Next();
		
		bool bContainsStrings = true;
		int lLastPos = -1;

		//Iterate wanted strings and name make sure they exist and show up in correct order.
		for(uint i=0; i<vWantedStrings.length(); ++i)
		{
			int lPos = cString_GetFirstStringPos(pSoundEntity.GetName(), vWantedStrings[i]);
		
			//If the next string was found before the previous OR the first string is at the start of the string, skip this entity.
			if(lPos <= lLastPos || (bFirstCharWildCard == false && lLastPos == -1 && lPos != 0)) 
			{
				bContainsStrings = false;
				break;
			}

			lLastPos = lPos;
		}

		//Add entity
		if(bContainsStrings)
		{
			avOutSoundEntities.push_back(pSoundEntity);
		}
	}
	 
	return avOutSoundEntities;
}

