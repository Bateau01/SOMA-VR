/**
 * Creates an array of lens flares with a given name.
 * 
 * @param asName name of lens flares. May contain * as wildcards.
 * @param avOutLensFlares reference to array that will be filled with lens flares.
 * @return array<tID>, array of id to lens flares found.
 **/
array<tID> Map_GetLensFlareIDArray(const tString &in asName, array<tID> &inout avOutLensFlares)
{
	////////////////////////////
	//If no asterix, just do normal search
	if(cString_GetFirstStringPos(asName, "*")<0)
	{
		avOutLensFlares.resize(0);
		
		cLensFlare@ pLensFlare = cLux_GetCurrentMap().GetWorld().GetLensFlare(asName);
		if(pLensFlare !is null) avOutLensFlares.push_back(pLensFlare.GetID());
		return avOutLensFlares;
	}

	////////////////////////////
	//Get the strings that we want to search for
	array<tString> vWantedStrings;
	tString sSepp = "*";
	cString_GetStringVec(asName,vWantedStrings, sSepp);

	bool bFirstCharWildCard = asName[0]=='*';

	////////////////////////////
	//Iterate lens flares
	cLensFlareIterator@ it = cLux_GetCurrentMap().GetWorld().GetLensFlareIterator();
    while(it.HasNext())
	{
		cLensFlare@ pLensFlare = it.Next();
		
		bool bContainsStrings = true;
		int lLastPos = -1;

		//Iterate wanted strings and name make sure they exist and show up in correct order.
		for(uint i=0; i<vWantedStrings.length(); ++i)
		{
			int lPos = cString_GetFirstStringPos(pLensFlare.GetName(), vWantedStrings[i]);
		
			//If the next string was found before the previous OR the first string is at the start of the string, skip this entity.
			if(lPos <= lLastPos || (bFirstCharWildCard==false && lLastPos==-1 && lPos!=0) ) 
			{
				bContainsStrings = false;
				break;
			}

			lLastPos = lPos;
		}

		//Add entity
		if(bContainsStrings)
		{
			avOutLensFlares.push_back(pLensFlare.GetID());
		}
	}
	 
	return avOutLensFlares;
}

