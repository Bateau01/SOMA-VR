{
	array<cEnvironmentParticles@> vParticles;
	Map_GetEnvironmentParticles(asName, vParticles);

	if(vParticles.empty() && asName != "*")
	{
		Error("Could not find EnvironmentParticles with the name '"+asName+ "' in Map_RemoveEnvironmentParticleClipArea");
		return;
	}
	
	for(uint i = 0; i < vParticles.length(); ++i)
	{
		vParticles[i].SetSpotLight(apLight, afMul);
	}
}

