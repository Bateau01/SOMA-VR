	//------------------------------------------------------------
	
    [nosave] float mfVRTracerAcquirePoll=0;
    void OnUpdate(float afTimeStep)
    {
        if(mBaseObj.GetName()!="Tracer_Fluid") return;
        mfVRTracerAcquirePoll-=afTimeStep;if(mfVRTracerAcquirePoll>0) return;mfVRTracerAcquirePoll=0.1f;
        if(!mBaseObj.IsActive() || !_HPL3VR_RuntimeActive_PropTool()) return;
        iPhysicsBody@ body=mBaseObj.GetMainBody();
        if(body is null || !cScript_RunGlobalFunc("VRPHONEQ",""+body.GetUniqueID(),"H")) return;
        cScript_SetGlobalArgString(0,mBaseObj.GetName());cScript_SetGlobalReturnBool(false);
        cScript_RunGlobalFunc("PlayerToolHandler","","_Global_GetToolIsInInventory");
        if(!cScript_GetGlobalReturnBool()) PickUpTool(false,true);
    }
	
