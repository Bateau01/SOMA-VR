    bool VR_RestoreOwnedToolCallbacks()
    {
        // Global arguments are shared with nested script calls. Copy them before
        // the runtime and ownership queries reuse their argument/result slots.
        tString savedUse=cScript_GetGlobalArgString(0), savedDrop=cScript_GetGlobalArgString(1);
        tString savedCanUse=cScript_GetGlobalArgString(2), savedPickup=cScript_GetGlobalArgString(3);
        if(!_HPL3VR_RuntimeActive_PropTool()) return false;
        cScript_SetGlobalArgString(0,mBaseObj.GetName());
        cScript_SetGlobalReturnBool(false);
        cScript_RunGlobalFunc("PlayerToolHandler","","_Global_GetToolIsInInventory");
        if(!cScript_GetGlobalReturnBool()) return false;
        msUseCallback=savedUse;
        msDropCallback=savedDrop;
        msCanBeUsedCallback=savedCanUse;
        if(msPickupCallback=="") msPickupCallback=savedPickup;
        mBaseObj.SetSaveDataIsUpdated(true);
        return true;
    }

    void _Global_VRReturnPhiPowerpack()
    {
        bool committed=VR_Try_ReturnPhiPowerpack();
        cScript_SetGlobalReturnBool(committed);
    }

    bool VR_Try_ReturnPhiPowerpack()
    {
        cScript_SetGlobalReturnBool(false);
        if(!_HPL3VR_RuntimeActive_PropTool() || mBaseObj.GetName()!="powerpack_1") return false;
        PickUpTool(false,false);
        cScript_SetGlobalArgString(0,"powerpack_1");
        cScript_SetGlobalReturnBool(false);
        cScript_RunGlobalFunc("PlayerToolHandler","","_Global_GetToolIsInInventory");
        if(!cScript_GetGlobalReturnBool()) return false;
        return VR_EnableOwnedPhysicalUpgradeChip(false);
    }

    void _Global_VRReturnThetaCarrier()
    {
        bool committed=VR_Try_ReturnThetaCarrier();
        cScript_SetGlobalReturnBool(committed);
    }

    bool VR_Try_ReturnThetaCarrier()
    {
        cScript_SetGlobalReturnBool(false);
        if(!_HPL3VR_RuntimeActive_PropTool()) return false;
        tString name=mBaseObj.GetName();
        if(name!="EnvironmentChip" && name!="BrainScanChip") return false;
        if(Entity_GetVarString(name,"Slot")!="") return false;
        // Existing acquisition callbacks have already run for inserted items.
        // Re-add stock ownership without equipping an authored HUD animation.
        PickUpTool(false,false);
        cScript_SetGlobalArgString(0,name);
        cScript_SetGlobalReturnBool(false);
        cScript_RunGlobalFunc("PlayerToolHandler","","_Global_GetToolIsInInventory");
        if(!cScript_GetGlobalReturnBool()) return false;
        return VR_EnableOwnedPhysicalUpgradeChip(false);
    }

    void _Global_VREnsurePhysicalUpgradeChip()
    {
        bool committed=VR_Try_EnsurePhysicalUpgradeChip();
        cScript_SetGlobalReturnBool(committed);
    }

    bool VR_Try_EnsurePhysicalUpgradeChip()
    {
		if (!_HPL3VR_RuntimeActive_PropTool()) return false;
		cScript_SetGlobalReturnBool(false);
		if (!VR_IsPhysicalKeyItem()) return false;
		return VR_EnableOwnedPhysicalUpgradeChip(false);
	}

	void _Global_VRShoulderStore()
    {
        bool committed=VR_Try_ShoulderStore();
        cScript_SetGlobalReturnBool(committed);
    }

    bool VR_Try_ShoulderStore()
    {
		cScript_SetGlobalReturnBool(false);
		if (!_HPL3VR_RuntimeActive_PropTool() || !VR_IsShoulderKeyItem()) return false;
		cScript_SetGlobalArgString(0, mBaseObj.GetName());
		cScript_RunGlobalFunc("PlayerToolHandler", "", "_Global_VRShoulderStoreTool");
	
        return cScript_GetGlobalReturnBool();
}

	void _Global_VRShoulderRetrievePhysical()
    {
        bool committed=VR_Try_ShoulderRetrievePhysical();
        cScript_SetGlobalReturnBool(committed);
    }

    bool VR_Try_ShoulderRetrievePhysical()
    {
		cScript_SetGlobalReturnBool(false);
		if (!_HPL3VR_RuntimeActive_PropTool() || !VR_IsShoulderKeyItem()) return false;
		// AF: do not ACK shoulder retrieval until the exact world body exists.
		// This avoids dropping a newly-activated Omicron/future key item out of the
		// logical shoulder queue on a transient entity-physics maturation frame.
		if (!VR_EnableOwnedPhysicalUpgradeChip(false)) return false;
		cScript_RunGlobalFunc("VROMNIINV", mBaseObj.GetName(), "R");
		return true;
	}

	void _Global_VRConsumePhysicalUpgradeChip()
    {
        bool committed=VR_Try_ConsumePhysicalUpgradeChip();
        cScript_SetGlobalReturnBool(committed);
    }

    bool VR_Try_ConsumePhysicalUpgradeChip()
    {
		if (!_HPL3VR_RuntimeActive_PropTool()) return false;
		cScript_SetGlobalReturnBool(false);
		if (!VR_IsPhysicalKeyItem()) return false;
		mBaseObj.SetActive(false);
		return true;
	}
 
