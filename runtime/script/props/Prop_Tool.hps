	//------------------------------------------------------------
	
	bool VR_IsPhysicalUpgradeChip()
	{
		if (!_HPL3VR_RuntimeActive_PropTool()) return false;
		tString sName = mBaseObj.GetName();
		return msHandAnimationSuffix == "securitychip" ||
			msHandAnimationSuffix == "brainchip" ||
			sName == "KateChip" || sName == "GoyaChip";
	}

	bool VR_IsShoulderKeyItem()
	{
		if (!_HPL3VR_RuntimeActive_PropTool()) return false;
		cScript_SetGlobalArgString(0, mBaseObj.GetName());
		cScript_SetGlobalReturnBool(false);
		cScript_RunGlobalFunc("PlayerToolHandler", "", "_Global_VRShoulderNameEligible");
		return cScript_GetGlobalReturnBool();
	}

	bool VR_IsPhysicalKeyItem()
	{
		return VR_IsPhysicalUpgradeChip() || VR_IsShoulderKeyItem();
	}

	bool VR_IsBrainUpgradeChip()
	{
		if (!_HPL3VR_RuntimeActive_PropTool()) return false;
		return msHandAnimationSuffix == "brainchip";
	}

	void VR_PrepareUpgradeChipContact()
	{
		if (!_HPL3VR_RuntimeActive_PropTool()) return;
		if (!VR_IsBrainUpgradeChip()) return;
		iPhysicsBody@ pBody = mBaseObj.GetMainBody();
		if (pBody is null) return;
		pBody.SetCollide(true);
		pBody.SetCollideCharacter(false);
	}

    bool VR_RestoreElevatorChipCallbacks()
    {
        if(!_HPL3VR_RuntimeActive_PropTool() || mBaseObj.GetName()!="door_panel_chip_formatted") return false;
        msUseCallback="door_panel_chip_OnUse";
        msCanBeUsedCallback="door_panel_chip_CanBeUsed";
        msPickupCallback="";msDropCallback="";
        return true;
    }

	bool VR_EnableOwnedPhysicalUpgradeChip(bool abPublishPickup)
	{
		if (!VR_IsPhysicalKeyItem()) return false;
		// H5756AV_VR_THETA_AUTHORED_PARENT_DETACH
		// These two Theta Tools are authored as children before pickup: BrainScanChip
		// rides a scan cylinder and chip_unformatted rides Brandon's hand. Stock HUD
		// pickup can hide that relationship; a physical VR carrier cannot. Remove only
		// those proven authored attachments before enabling dynamic physical ownership.
		tString sThetaTool = mBaseObj.GetName();
		if (sThetaTool == "BrainScanChip" || sThetaTool == "chip_unformatted")
			Entity_RemoveEntityAttachment(sThetaTool);
		// H5756AW_VR_OMICRON_BRAIN_PARENT_DETACH
		// Omicron's BrokenRobotBrain is authored as a child of robot_brain_stem.
		// Stock HUD pickup can hide that parent relationship, but the VR-owned Tool
		// body must be free before HQ physical ownership begins. Scope this only to
		// proven authored carriers; no generic Tool detach is added.
		// S26BI: the baton and repaired chip also retain authored parent-motion
        // attachments after stock pickup. Free these exact carriers before physics ownership.
        if (sThetaTool == "BrokenRobotBrain" || sThetaTool == "StunRod" || sThetaTool == "ChipTool_Repaired")
			Entity_RemoveEntityAttachment(sThetaTool);
		mBaseObj.SetActive(true);
		cMeshEntity@ pMeshVR = mBaseObj.GetMeshEntity();
		if (pMeshVR !is null) pMeshVR.SetVisible(true);
		mBaseObj.SetStaticPhysics(false);

		tString sToolName = mBaseObj.GetName();
        tString gripProfile=sToolName;
        cVector3f gripScale=mBaseObj.GetOnLoadScale();
        if(sToolName=="ARK" && cMath_Abs(gripScale.x-0.804669f)<0.0001f &&
           cMath_Abs(gripScale.y-0.804669f)<0.0001f && cMath_Abs(gripScale.z-0.804669f)<0.0001f)
            gripProfile="ARK@Phi";
        cScript_RunGlobalFunc("VRCOMFORT","GRIPMODEL",gripProfile);
		cScript_RunGlobalFunc("VROMNICHIP", sToolName, "B");
		iPhysicsBody@ pBody = mBaseObj.GetMainBody();
		cScript_RunGlobalFunc("VROMNICHIP", sToolName, "E");
        cScript_RunGlobalFunc("VRCOMFORT","GRIPMODEL","END");
		if (pBody is null) return false;

		pBody.SetCollide(true);
		pBody.SetCollideCharacter(false);
		if (pBody.GetMass() < 0.05f) pBody.SetMass(0.20f);
		pBody.SetGravity(true);
		// S26CW: released inventory carriers may sleep once settled. Native
        // pickup/retrieval still wakes them; held AddForce/AddTorque wake normally.
        pBody.SetAutoDisable(true);
		mBaseObj.WakeUp();
		// I re-publishes exact inventory-owned physical identity after save/retrieval.
		// P remains reserved for the completed stock pickup transaction.
		cScript_RunGlobalFunc("VROMNICHIP", sToolName, "I");
		if (abPublishPickup) cScript_RunGlobalFunc("VROMNICHIP", sToolName, "P");
		return true;
	}

	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
    bool VR_IsAuthoredToolPresentation(const tString &in name)
    {
        // Proven map displays and placement markers, never inventory carriers.
        // ScanRoomSlot_Chip has a distinct, real-carrier removal route below.
        return name=="ScanRoomSlot_InPos" || name=="ScanRoomSlot_OutPos" ||
            name=="SimulationSlot_Left_OutPos" || name=="ChipTool_PreRepair" ||
            name=="Chip_FullyRepaired" || name=="ComputerBrainInBody" ||
            name=="ComputerBrainInBody_MoveTarget" || name=="PowerSourceInBody";
    }

	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
        if(_HPL3VR_RuntimeActive_PropTool() && msPickupCallback=="PowerpackPlugged_OnPickUp" &&
            (mBaseObj.GetName()=="PowerpackPlugged_Lights" || mBaseObj.GetName()=="PowerpackPlugged_Cargo" || mBaseObj.GetName()=="PowerpackPlugged_SatFrameRoom")) return true;

        if(_HPL3VR_RuntimeActive_PropTool() && VR_IsAuthoredToolPresentation(mBaseObj.GetName())) return false;
		// H5756AT_VR_PHYSICAL_KEY_ITEM_GRAB_GATE
		// Physical story Tools are world objects in VR. Their authored Active /
		// InteractionDisabled state remains the exposure gate; the flatscreen
		// ToolHandler focus/equip predicate must not suppress an otherwise-valid
		// hand contact (Delta replacement chips were the hardware regression).
		if (_HPL3VR_RuntimeActive_PropTool() && VR_IsPhysicalKeyItem()) return true;
		return ToolHandler_CanPickOrUseTool();
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		PickUpTool(true, true);
		
		return true;
	}
	
	//------------------------------------------------------------
	
	void PickUpTool(bool abEquipTool, bool abCallback)
	{
		if (!_HPL3VR_RuntimeActive_PropTool())
		{
				tString sToolName = mBaseObj.GetName();
				
				//////////////////////////
				//Pick up callback
				if(abCallback && msPickupCallback != "")
				{
					cLuxMap@ pMap = cLux_GetCurrentMap();
					if(pMap.ScriptPrepare("bool "+msPickupCallback+"(const tString &in asName)" ) )
					{
						pMap.SetArgString(0, sToolName);
						
						if(pMap.ScriptExecute())
						{
							if(pMap.GetReturnBool()==false) return;
						}
					}
				}
				
				//////////////////////////
				//Disable entity
				mBaseObj.SetActive(false);
				
				//////////////////////////
				//Setup the tool interact state
				cScript_SetGlobalArgString(0, sToolName);
				cScript_SetGlobalArgString(1, msHudObjectEntity);
				cScript_SetGlobalArgString(2, msUseCallback);
				cScript_SetGlobalArgString(3, msDropCallback);
				cScript_SetGlobalArgString(4, msCanBeUsedCallback);
				cScript_SetGlobalArgBool(5, abEquipTool);
				cScript_SetGlobalArgBool(6, mbAutoHide);
				
				cScript_SetGlobalArgString(7, msInventoryIcon);
				cScript_SetGlobalArgString(8, msHandAnimationSuffix);
				
				cScript_SetGlobalArgBool(9, mbIsHeavy);
				cScript_SetGlobalArgInt(10, mCustomUseIcon);
				
				cScript_RunGlobalFunc("PlayerToolHandler", "", "_Global_AddTool");
			return;
		}
        tString sToolName = mBaseObj.GetName();
        if(VR_IsAuthoredToolPresentation(sToolName)) return;
        if(sToolName=="ScanRoomSlot_Chip")
        {
            if(Entity_GetVarString("EnvironmentChip","Slot")=="ScanRoomSlot")
            {
                cLuxMap@ pMap=cLux_GetCurrentMap();
                if(pMap !is null && pMap.ScriptPrepare("void InteractChipSlot(const tString&in asEntity)"))
                {
                    tString sScanRoomSlot="ScanRoomSlot";
                    pMap.SetArgString(0,sScanRoomSlot);
                    pMap.ScriptExecute();
                }
            }
            return;
        }
        // A hidden Theta carrier is still discoverable by a native body query.
        // If inserted, remove the authored presentation before reacquiring it.
        if (sToolName=="BrainScanChip" || sToolName=="EnvironmentChip")
        {
            tString sSlot=Entity_GetVarString(sToolName,"Slot");
            if (sSlot!="")
            {
                cLuxMap@ pMap=cLux_GetCurrentMap();
                if (pMap !is null && pMap.ScriptPrepare("void InteractChipSlot(const tString&in asEntity)"))
                {
                    pMap.SetArgString(0,sSlot);
                    pMap.ScriptExecute();
                }
                return;
            }
        }
        // Regrabbing an owned non-frozen item is physical ownership, not a
        // second acquisition. Leave the four hardware-frozen chip paths alone.
        if (VR_IsShoulderKeyItem() && sToolName!="ConfigChipTool" &&
            sToolName!="CortexChipTool" && sToolName!="KateChip" && sToolName!="GoyaChip")
        {
            cScript_SetGlobalArgString(0,sToolName);
            cScript_SetGlobalReturnBool(false);
            cScript_RunGlobalFunc("PlayerToolHandler","","_Global_GetToolIsInInventory");
            if (cScript_GetGlobalReturnBool())
            {
                VR_EnableOwnedPhysicalUpgradeChip(false);
                return;
            }
        }

        // H5756AU_VR_UPSILON_STOCK_PICKUP_RESTORE
		// H57.56AT's pre-callback inventory short-circuit is removed. Preserve the
		// H57.56AS stock PickupCallback -> _Global_AddTool -> ownership-proof order.
		//////////////////////////
		//Pick up callback
		if(abCallback && msPickupCallback != "")
		{
			cLuxMap@ pMap = cLux_GetCurrentMap();
			if(pMap.ScriptPrepare("bool "+msPickupCallback+"(const tString &in asName)" ) )
			{
				pMap.SetArgString(0, sToolName);
				
				if(pMap.ScriptExecute())
				{
					if(pMap.GetReturnBool()==false) return;
				}
			}
		}
		
		//////////////////////////
		// Vanilla tools disappear into the HUD inventory. Upgrade chips remain the
		// real world object; their exact callback/inventory record is still added below.
		bool bVRPhysicalUpgradeChip = VR_IsPhysicalKeyItem();
		if (!bVRPhysicalUpgradeChip) mBaseObj.SetActive(false);
		
		//////////////////////////
		//Setup the tool interact state
		cScript_SetGlobalArgString(0, sToolName);
		cScript_SetGlobalArgString(1, msHudObjectEntity);
		cScript_SetGlobalArgString(2, msUseCallback);
		cScript_SetGlobalArgString(3, msDropCallback);
		cScript_SetGlobalArgString(4, msCanBeUsedCallback);
		cScript_SetGlobalArgBool(5, abEquipTool);
		cScript_SetGlobalArgBool(6, mbAutoHide);
		
		cScript_SetGlobalArgString(7, msInventoryIcon);
		cScript_SetGlobalArgString(8, msHandAnimationSuffix);
		
		cScript_SetGlobalArgBool(9, mbIsHeavy);
		cScript_SetGlobalArgInt(10, mCustomUseIcon);
		
		cScript_RunGlobalFunc("PlayerToolHandler", "", "_Global_AddTool");

		// _Global_AddTool is void and can reject a duplicate/invalid record. Prove the
		// exact named chip is now logically owned before publishing physical pickup.
		// This keeps the P token equivalent to a completed stock inventory transaction.
		if (bVRPhysicalUpgradeChip)
		{
			cScript_SetGlobalArgString(0, sToolName);
			cScript_SetGlobalReturnBool(false);
			cScript_RunGlobalFunc("PlayerToolHandler", "", "_Global_GetToolIsInInventory");
			if (cScript_GetGlobalReturnBool()) VR_EnableOwnedPhysicalUpgradeChip(true);
		}
	}
	
