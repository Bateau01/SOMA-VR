// H5756K_VR_OMNITOOL_PHYSICAL_UPGRADE_CHIPS
// H5756S_CORTEX_PRESENTATION_CONTINUITY: do not force story activation; whenever an authored upgrade-chip entity IS active, keep its real world mesh visible before and after physical acquisition.
// H5756Z_VR_DELTA_REPLACEMENT_TOOLCHIP: historical Delta physical-carrier pass.
 // H5756AA_VR_LEFT_SHOULDER_KEY_INVENTORY: exact registered story Tools retain a physical world body and can be stowed/retrieved without altering stock inventory/use callbacks.
// H5756AF_VR_SHOULDER_ROUNDTRIP_OMICRON: shoulder retrieval ACKs only after exact GetMainBody succeeds; generic key-item physicalization remains inventory/callback-authorized.
// H5756N_DUALMODE_SCRIPT_GATE: fail closed to stock; MenuHandler owns the [nosave] session bit.
bool _HPL3VR_RuntimeActive_PropTool()
{
	cScript_SetGlobalReturnBool(false);
	cScript_RunGlobalFunc("MenuHandler", "cScrMenuHandler", "HPL3VR_GetRuntimeActive");
	return cScript_GetGlobalReturnBool();
}

class cScrPropTool : iScrProp, iScrProp_Interface
{
