	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		if(mBaseObj.GetParentType() == eParentType_StickyStuck) return false;

		if(	apBody.GetMass()==0 && mbCanInteractWithStaticBody==false)// && mBaseObj.GetMap().BodyIsInDetachableStickyArea(apBody)==false) 
		{
			return false;
		}

		return true;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{			
		///////////////////////////////
		//If body mass is 0, get a dynamic body
		if(apBody.GetMass()==0 && mbCanInteractWithStaticBody || apBody is mpHandleBody)
		{
			@apBody = mpDoorBody;
		}
		
		mBaseObj.SetSaveDataIsUpdated(true);

		///////////////////////////////
		//Check if in sticky area
		//mBaseObj.GetMap().DetachBodyFromStickyArea(apBody); (not implemented!)
				
		///////////////////////////////
		//Check if locked
		if(mbLocked)
		{
			if(mfInteractSoundCount <=0)
			{
				Effect_Rumble_Start(0.3, 0.5);
				mBaseObj.PlaySound("InteractLocked",msInteractLockedSound,true, true);
				mfInteractSoundCount = 0.5f;
			}

			PlayAnimation(msHandleLockedAnimation, 0.25f);
		}
		else if(mbBlocked)
		{
			if(mfInteractSoundCount <= 0)
			{
				mBaseObj.PlaySound("InteractBlocked",msInteractBlockedSound,true, true);
				mfInteractSoundCount = 0.5f;
			}

			PlayAnimation(msHandleDownAnimation, 0.25f);
		}
		else if(mbLocked==false && mbBlocked == false)
		{
			SetClosed(false, true);
			PlayAnimation(msHandleDownAnimation, 0.25f);
		}
		mbDisableAutoClose = false; //Do not lock door when at edges!

		///////////////////////////////
		//Check if needs start speed (if close to edges
		float fStartPushSpeed = 0;
		if(mbBlocked==false)
		{
			float fAngle = mpHingeJoint.GetAngle();
			if( cMath_Abs(fAngle-mpHingeJoint.GetMinAngle()) < cMath_ToRad(5) )
			{
				fStartPushSpeed = -6;
			}
			else if( cMath_Abs(fAngle-mpHingeJoint.GetMaxAngle()) < cMath_ToRad(5) )
			{
				fStartPushSpeed = 6;
			}
		}
		
	
		///////////////////////////////
		//Set up the slide state
		cScript_RunGlobalFunc("VRMECHPREP","","BEGIN");
		cScript_SetGlobalArgID(0, mBaseObj.GetID()); //Object ID
		cScript_SetGlobalArgInt(1, apBody.GetUniqueID()); //Body Id
		cScript_SetGlobalArgVector3f(2, avFocusPos);//The grab postion
		
		cScript_SetGlobalArgFloat(3, mbLocked ? 0 : mfMoveMaxSpeed);
		cScript_SetGlobalArgFloat(4, mfMoveSpeedFactor);
		cScript_SetGlobalArgFloat(5, mfMoveSlowDownFactor);
		cScript_SetGlobalArgFloat(6, fStartPushSpeed);
		cScript_SetGlobalArgString(7, mBaseObj.GetName());

		cScript_RunGlobalFunc("State_Interact_SwingDoor", "", "SetupSwingDoor");
		
		///////////////////////////////
		//Change the player state
		cLux_GetPlayer().ChangeState(ePlayerState_SwingDoor);	
		mbIsInteracting = true;

		return true;
	}

	//------------------------------------------------------------

	void _Global_OnAddSpeed()
	{
		mBaseObj.SetSaveDataIsUpdated(true);
		
		float fAddSpeed = cScript_GetGlobalArgFloat(0);

		if(cMath_Abs(fAddSpeed) > 0.001)
		{
			if(mpHandleBody !is null)
			{
				// add random shake to the body
				mpHandleBody.AddForce(cVector3f(0, cMath_RandRectf(-16, 16), 0));
			}

			if(mfMovingRepetitionCount <= 0)
			{
				mfMovingRepetitionCount = cMath_RandRectf(mvHandleMovingRepetition.x, mvHandleMovingRepetition.y);

				mBaseObj.AppendAnimation(msHandleMovingAnimation, false);
			}
		}
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return mbIsHatch ? eCrossHairState_PullDoorHatch : eCrossHairState_PullDoor;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DOOR ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_SetOpenAmount()
	{
		SetOpenAmount(cScript_GetGlobalArgFloat(0));
	}
	
	//------------------------------------------------------------
	
	void SetOpenAmount(float afOpenAmount)
	{
		mBaseObj.SetSaveDataIsUpdated(true);
		
		iPhysicsBody @pChildBody = mpHingeJoint.GetChildBody();
		float fWantedAngle = mfMaxAngle * afOpenAmount;
		
		cQuaternion qRotation; qRotation.FromAngleAxis(mpHingeJoint.GetAngle()-fWantedAngle, mpHingeJoint.GetPinDir());
		cMatrixf mtxRotation = cMath_MatrixQuaternion(qRotation);
		cMatrixf mtxBody = pChildBody.GetLocalMatrix();

		cVector3f vBodyPos = pChildBody.GetLocalPosition();
		cVector3f vPivotOffset = mpHingeJoint.GetPivotPoint() - pChildBody.GetLocalPosition();

		mtxBody.SetTranslation(vPivotOffset*-1);
		mtxBody = cMath_MatrixMul(mtxRotation, mtxBody);
		mtxBody.SetTranslation(mtxBody.GetTranslation() + vPivotOffset + vBodyPos);

		cMatrixf mtxDelta = cMath_MatrixMul(mtxBody, cMath_MatrixInverse(pChildBody.GetWorldMatrix()));
		
		pChildBody.SetMatrix(mtxBody);
		pChildBody.SetAngularVelocity(cVector3f(0));
		pChildBody.SetLinearVelocity(cVector3f(0));
		
		// Set closed or not depending on how open the door is
		bool bClosed = cMath_Abs(mpHingeJoint.GetAngle()) < cMath_ToRad(10);

		if(mpHandleBody !is null)
		{
			mpHandleBody.SetMatrix(cMath_MatrixMul(mtxDelta, mpHandleBody.GetWorldMatrix()));
		}

		SetClosed(bClosed, false);
	}
	
	//------------------------------------------------------------

	void _Global_SetClosed()
	{
		SetClosed(cScript_GetGlobalArgBool(0), cScript_GetGlobalArgBool(1));
	}
	
	void SetClosed(bool abClosed, bool abEffects)
	{
		if(mbClosed == abClosed) return;
		
		mBaseObj.SetSaveDataIsUpdated(true);

		mbClosed = abClosed;
		
		float fSpeed = mpHingeJoint.GetAngularVelocity().Length();

		if(mbClosed)
		{
		
			if(mbBlocked)
			{
				if (msMaxOpenSound != "")
					mpHingeJoint.SetMaxLimitSound("", 0);
					
				mpHingeJoint.SetMaxAngle(cMath_ToRad(2.0f));
				mpHingeJoint.SetStickyMinLimit(false);
				mpHingeJoint.SetStickyMaxLimit(false);
			}
			else
			{
				if (msMaxOpenSound != "")
					mpHingeJoint.SetMaxLimitSound("", 0);
					
				mpHingeJoint.SetMaxAngle(cMath_ToRad(0.0001f));
				mpHingeJoint.SetStickyMinLimit(true);
				mpHingeJoint.SetStickyMaxLimit(true);
				mpDoorBody.SetMaxAngularSpeed(0.1f);
				mpDoorBody.SetAngularDamping(0.8f);
			}
		}
		else
		{
			if (msMaxOpenSound != "")
				mpHingeJoint.SetMaxLimitSound(msMaxOpenSound, mfMaxOpenSoundMinSpeed);
					
			mpHingeJoint.SetMaxAngle(mfMaxAngle);
			mpHingeJoint.SetStickyMinLimit(true);
			mpHingeJoint.SetStickyMaxLimit(true);

			mpDoorBody.SetMaxAngularSpeed(mfAngularLimitDefault);
			mpDoorBody.SetAngularDamping(mfAngularDampingDefault);
		}
		
		if(mpHandleJoint !is null)
		{
			if(mbLocked)
			{
				mpHandleJoint.SetMaxAngle(cMath_ToRad(5.0f));
			}
			else
			{
				mpHandleJoint.SetMaxAngle(mfMaxHandleAngle);
			}
		}

		//Add force to body so that the door really closes.
		mpDoorBody.AddForce(cVector3f(1,1,1));
		
		if(abEffects)
		{
			if(mbClosed)
			{
				cSoundEntity@ pSound = mBaseObj.PlaySound("CloseOn",msCloseOnSound,true, true);
				if (pSound !is null) pSound.SetParam(0, fSpeed/mfMoveMaxSpeed);
			}
			else		mBaseObj.PlaySound("CloseOff",msCloseOffSound,true, true);
		}
	}

	//-----------------------------------------------------------------------

	void _Global_GetOpenAmount()
	{
		float fAbsAngle = cMath_Abs(mpHingeJoint.GetAngle());
		float fOpenAmount = fAbsAngle/cMath_Abs(mfMaxAngle);
		
		cLux_AddDebugMessage("Open amount : " + fOpenAmount);
		cScript_SetGlobalReturnFloat(fOpenAmount);
	}
	
	//-----------------------------------------------------------------------
	
	void _Global_GetDoorState()
	{
		cScript_SetGlobalReturnInt(GetDoorState());
	}
	
	int GetDoorState()
	{
		
		int lState =0;

		float fAbsAngle = cMath_Abs(mpHingeJoint.GetAngle());
			
		float fClosedAngle = cMath_ToRad(5);
		float fOpenAngle = cMath_Abs(mfMaxAngle)*0.70f;

		if(fAbsAngle < fClosedAngle)
		{
			if(lState == 1) return 0;
			lState = -1;
		}
		else if(fAbsAngle >  fOpenAngle)
		{
			if(lState == -1) return 0;
			lState = 1;	
		}
		else
		{
			return 0;
		}

		return lState;
	}

	//-----------------------------------------------------------------------

	void _Global_SetLocked()
	{
		SetLocked(cScript_GetGlobalArgBool(0), cScript_GetGlobalArgBool(1));
	}
	
	//------------------------------------------------------------

	void _Global_SetBlocked()
	{
		SetBlocked(cScript_GetGlobalArgBool(0), cScript_GetGlobalArgBool(1));
	}

	//------------------------------------------------------------

	void SetLocked(bool abLocked, bool abEffects)
	{
		if(mbLocked == abLocked) return;
		
		mBaseObj.SetSaveDataIsUpdated(true);

		mbLocked = abLocked;
		
		if(mbLocked) SetClosed(true, false);

		if(abEffects)
		{
			if(mbLocked)mBaseObj.PlaySound("LockedOn",msLockOnSound,true, true);
			else		mBaseObj.PlaySound("LockedOff",msLockOffSound,true, true);
		}

		if(mpHandleJoint !is null)
		{
			if(mbLocked)
			{
				mpHandleJoint.SetMaxAngle(cMath_ToRad(5.0f));
			}
			else
			{
				mpHandleJoint.SetMaxAngle(mfMaxHandleAngle);
			}
		}
	}

	//------------------------------------------------------------

	void SetBlocked(bool abBlocked, bool abEffects)
	{
		if(mbBlocked == abBlocked) return;
		
		mBaseObj.SetSaveDataIsUpdated(true);

		mbBlocked = abBlocked;
		
		if(mbBlocked) SetClosed(true, false);

		if(abEffects)
		{
			if(mbBlocked)mBaseObj.PlaySound("BlockedOn",msBlockOnSound,true, true);
			else		mBaseObj.PlaySound("BlockedOff",msBlockOffSound,true, true);
		}
	}
	
