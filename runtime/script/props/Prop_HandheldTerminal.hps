	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	[nosave] tString msConnectedSubmesh;
	[nosave] cColor mClearColor;
	[nosave] cColor mColorMul;
	[nosave] cColor mOfflineClearColor;
	[nosave] cVector2f mvScreenSize;
	[nosave] tString msHandAnimationSuffix;
	[nosave] float mfDistanceFromCamera;
	[nosave] float mfYStartOffset;
	[nosave] tString msPickupSound;
	[nosave] tString msDropSound;
	[nosave] tString msOnGuiFunction;
	[nosave] tString msHudEntFile;
	[nosave] float mfFOV;
		
	tID m_idOpenProp;
	
	bool mbIsRead=false;
	bool mbIsHudVersion=false;
	bool mbGUIActiveOnTransition=false;
	
	tString msLeaveCallback;
	bool mbShowMouse;
	bool mbLockCamera = true;
	bool mbAllowCancel=true;
	
	//------------------------------------------------------------
	
		
}	

