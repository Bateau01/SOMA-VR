	//------------------------------------------------------------
	
	//NOTE: This is only useable if SetScriptCollisionCallbackActive is true
	void OnPhysicsCollision(iPhysicsBody @apBody, iPhysicsBody @apCollideBody, cPhysicsContactData&in apContactData)
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return true;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{					
        if(_HPL3VR_HandheldActive() && VR_IsTablet()) return VR_BeginTablet(apBody,avFocusPos);
		iCharacterBody@ pCharBody = cLux_GetPlayer().GetCharacterBody();
		if(pCharBody.IsOnGround() == false) return false;
	
		cLuxProp@ pOpenProp = cLux_ID_Prop(m_idOpenProp);

		if (pOpenProp is null)
		{
			cLux_GetCurrentMap().CreateEntity(mBaseObj.GetName() + "_open", msHudEntFile == "" ? mBaseObj.GetFileName() : msHudEntFile, cMatrixf_Identity, cVector3f(1));
			@pOpenProp = cLux_ToProp(cLux_GetCurrentMap().GetLatestEntity());
			pOpenProp.CreateAndSetupGui(msConnectedSubmesh, mColorMul, mClearColor, mOfflineClearColor, mvScreenSize);
			pOpenProp.SetOnGuiFunction(msOnGuiFunction);
			
			for (int i = 0; i < pOpenProp.GetBodyNum(); i++)
			{
				iPhysicsBody@ pBody = pOpenProp.GetBody(i);
				pBody.SetCollideCharacter(false);
				pBody.SetCollide(false);
				pBody.SetCollideRagDoll(false);
				pBody.SetMass(0);
			}
			pOpenProp.SetActive(false);
			pOpenProp.SetGuiActive(false);
			pOpenProp.SetEffectsActive(false,false);
			pOpenProp.SetAllowMapTransfer(false);
		
			//////////////////////////////
			// Set up render flags
			for(int i=0; i<pOpenProp.GetMeshEntity().GetSubMeshEntityNum(); ++i)
			{
				cSubMeshEntity @pEnt = pOpenProp.GetMeshEntity().GetSubMeshEntity(i);
				pEnt.SetRenderFlagBit(eRenderableFlag_VisibleInReflection, false);
				pEnt.SetRenderFlagBit(eRenderableFlag_ShadowCaster, false);
			}

			m_idOpenProp = pOpenProp.GetID();
		}
		
		/////////////////////
		// Fade fov		
		cLux_GetPlayer().FadeCameraFOVTo(mfFOV, 1.0f);

		//////////////////////////////////
		// Set up the created entity
		cScript_RunGlobalFunc(pOpenProp.GetName(), "", "_Global_SetIsHudVersion");
		
		cScript_SetGlobalArgID(0, mBaseObj.GetID()); //Object ID
		cScript_SetGlobalArgInt(1, apBody.GetUniqueID()); //Body Id
		cScript_SetGlobalArgVector3f(2, avFocusPos);//The grab postion
		cScript_SetGlobalArgID(3, pOpenProp.GetID()); //Open entity object ID
		cScript_SetGlobalArgFloat(4, mfDistanceFromCamera); //Target prop distance from camera
		cScript_SetGlobalArgFloat(5, mfYStartOffset); //Start offset along the camera's Y axis.
		cScript_SetGlobalArgString(6, msPickupSound); //Sound played when interaction starts
		cScript_SetGlobalArgString(7, msDropSound); //Sound played when interaction ends
		cScript_SetGlobalArgString(8, msLeaveCallback); //Callback called when interaction ends.
		cScript_SetGlobalArgBool(9, mbAllowCancel);// Allow use of right-button to cancel?
		cScript_SetGlobalArgString(10, msHandAnimationSuffix); //Hand animation used, if any
		cScript_SetGlobalArgBool(11, mbGUIActiveOnTransition);// Display GUI during transition in and out of state?
		cScript_SetGlobalArgBool(12, mbShowMouse);// Display mouse
		cScript_SetGlobalArgBool(13, mbLockCamera);// Should the player be allowed to look around
		
		cScript_RunGlobalFunc("State_Interact_HandheldTerminal", "", "SetupTerminal");
	
		cLux_GetPlayer().ChangeState(ePlayerState_HandheldTerminal);	
		
		mbIsRead = true;
		
		return false;
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return eCrossHairState_Terminal;
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_SetLeaveCallback()
	{
		msLeaveCallback = cScript_GetGlobalArgString(0);
	}
	
	//------------------------------------------------------------
	
	void _Global_CanBeHighlighted()
	{
		cScript_SetGlobalReturnBool(mbIsRead ==false && mBaseObj.IsInteractedWith()==false && mbIsHudVersion==false);
		cScript_SetGlobalArgID(0,mBaseObj.GetID());
	}
	
	//------------------------------------------------------------
	
	void _Global_SetIsHudVersion()
	{
		mbIsHudVersion = true;
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
