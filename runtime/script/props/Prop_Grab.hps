	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
    // S26L: the two static Theta slot displays are Prop_Grab, not the real
    // inventory Tool. Route their physical interaction to the authored socket
    // synchronously, while native dispatch still owns the current grip hand.
    tString VR_ThetaSocket()
    {
        tString name=mBaseObj.GetName();
        tString tool="",slot="";
        if(name=="SimulationSlot_Right_Chip") {tool="BrainScanChip";slot="SimulationSlot_Right";}
        else if(name=="SimulationSlot_Left_Chip") {tool="EnvironmentChip";slot="SimulationSlot_Left";}
        else return "";
        cScript_SetGlobalReturnBool(false);
        cScript_RunGlobalFunc("MenuHandler","cScrMenuHandler","HPL3VR_GetRuntimeActive");
        if(!cScript_GetGlobalReturnBool()) return "";
        cLuxMap@ map=cLux_GetCurrentMap();
        if(map is null || map.GetEntityByName(tool,eLuxEntityType_LastEnum,"") is null) return "";
        if(Entity_GetVarString(tool,"Slot")!=slot || !Entity_IsActive(name)) return "";
        return slot;
    }

	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		if(ToolHandler_GetPlayerCarriesHeavyTool()) return false;
        if(VR_ThetaSocket()!="") return true;
        if(mbGrab_InteractOnlyWithMainBody && apBody !is mBaseObj.GetMainBody()) return false;
		if(mBaseObj.HasPlayerInteractCallback()) return true;
		if(mBaseObj.GetStaticPhysics() && !mbInteractDisablesStaticPhysics) return false;
		if(mBaseObj.GetParentType() == eParentType_StickyStuck) return false;
	
		return true;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
    {
        tString socket=VR_ThetaSocket();
        if(socket!="")
        {
            cLuxMap@ map=cLux_GetCurrentMap();
            if(map !is null && map.ScriptPrepare("void InteractChipSlot(const tString&in asEntity)"))
            {
                map.SetArgString(0,socket);
                map.ScriptExecute();
            }
            return true; // Never promote the socket display into native Grab.
        }
		if (mBaseObj.GetStaticPhysics())
		{
			if (!mbInteractDisablesStaticPhysics) 
				return false;
				
			mBaseObj.SetStaticPhysics(false);
		}
		
		mBaseObj.SetSaveDataIsUpdated(true);
						
		///////////////////////////////
		//Set up the grabstate
		cScript_SetGlobalArgID(0, mBaseObj.GetID()); //Object ID
		cScript_SetGlobalArgInt(1, apBody.GetUniqueID()); //Body Id
		cScript_SetGlobalArgVector3f(2, avFocusPos);//The grab postion
		cScript_SetGlobalArgBool(3, mbGrab_UseCustomOffset);	//Use custom offset
		cScript_SetGlobalArgVector3f(4, mvGrab_CostumPositionOffset);	//Costum Position offset
		cScript_SetGlobalArgVector3f(5, mvGrab_CostumRotationOffset);	//Costum Rotation offset
		cScript_SetGlobalArgBool(6, mbGrab_UseCustomDepth);	//Use custom Depth
		cScript_SetGlobalArgFloat(7, mfGrab_CustomDepth);	//Custom depth
		cScript_SetGlobalArgFloat(8, mfGrab_MassMul);	//Grab mass mul
		cScript_SetGlobalArgFloat(9, mfGrab_MinDepth);	//Min depth
		cScript_SetGlobalArgFloat(10, mfGrab_MaxDepth);	//Max Depth
		cScript_SetGlobalArgFloat(11, mfGrab_ForceMul);
		cScript_SetGlobalArgFloat(12, mfGrab_TorqueMul);
		cScript_SetGlobalArgFloat(13, mfGrab_ThrowImpulse);
		cScript_SetGlobalArgBool(14, mbGrab_IsHeavy);
		cScript_SetGlobalArgBool(15, mbGrab_CollisionWithPlayer);
		
		cScript_RunGlobalFunc("State_Interact_Grab", "", "SetupGrab");
		
		cScript_SetGlobalArgString(0, msTextCategory);
		cScript_SetGlobalArgString(1, msFrontTextEntry);
		cScript_SetGlobalArgString(2, msBackTextEntry);
		cScript_SetGlobalArgFloat(3, mfTextRotateOffset);
		
		cScript_RunGlobalFunc("State_Interact_Grab", "", "SetupReading");
		
		///////////////////////////////
		//Set up the grabstate
		cLux_GetPlayer().ChangeState(ePlayerState_Grab);
	
		return true;
	}
	
