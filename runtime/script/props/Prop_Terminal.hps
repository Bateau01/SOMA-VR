#include "interfaces/Prop_Interface.hps"
#include "base/Player_Types.hps"

// H5756N_DUALMODE_SCRIPT_GATE: fail closed to stock; MenuHandler owns the [nosave] session bit.
// H576BP_CONNECTED_SUBMESH_TERMINAL: VR-only physical fingertip pointer uses the authored connected screen submesh; flatscreen remains literal stock.
bool _HPL3VR_RuntimeActive_PropTerminal()
{
	cScript_SetGlobalReturnBool(false);
	cScript_RunGlobalFunc("MenuHandler", "cScrMenuHandler", "HPL3VR_GetRuntimeActive");
	return cScript_GetGlobalReturnBool();
}

class cScrPropTerminal : iScrProp, iScrProp_Interface
{

	// H576BP: Prop_Terminal GUIs are render-to-submesh surfaces.  The focused
	// cGuiSet itself is not a world-space 3D set, so Get3DTransform/Get3DSize
	// legitimately return the identity/default values seen by BO hardware.
	// Publish the ACTUAL connected screen submesh as an affine world plane:
	// top-left point + right span + down span.  The existing GuiSet remains the
	// sole widget/input/story authority; this only tells the DLL where the glass is.

    // S26M: UV0 from the shipped security_keypad GUI mesh, normalized to
    // its local AABB. This maps glass contact to the authored GUI, not digits.
    cVector2f _HPL3VR_KeypadUV(const cVector3f &in p, const cVector3f &in lo, const cVector3f &in hi)
    {
        float x=(p.x-lo.x)/(hi.x-lo.x), y=(p.y-lo.y)/(hi.y-lo.y);
        return cVector2f(0.224604525f,0.788855435f) + cVector2f(0.377696778f,0.001089576f)*x + cVector2f(0.001319317f,-0.576605372f)*y;
    }


	// S26O: mesh-derived laptop planes. Coordinates are normalized to the live
	// vertex bounds, preserving entity scale and placement. No render mesh changes.
	bool _HPL3VR_LaptopPlane(const cVector3f &in lo, const cVector3f &in hi, cVector3f &out plane, cVector2f &out uv0, cVector2f &out uvX, cVector2f &out uvY)
	{
		tString file=cString_GetFileName(mBaseObj.GetFileName());
		cVector3f ext=hi-lo;
		if(ext.x<0.001f || ext.y<0.001f || ext.z<0.001f) return false;
		if(file=="computer_laptop.ent" && msConnectedSubmesh=="computer_laptop_001"
		   && cMath_Abs(ext.y/ext.x-0.5637135546f)<0.01f && cMath_Abs(ext.z/ext.x-0.2074582110f)<0.01f)
		{
			plane=cVector3f(0.0000035309f,-0.9999964916f,0.9999976529f);
			uv0=cVector2f(0.0017169992f,0.9998936909f);
			uvX=cVector2f(0.9962402429f,-0.0044954540f);
			uvY=cVector2f(-0.0025784657f,-0.9982599078f);
			return true;
		}
		if(file=="laptop_touchscreen.ent" && msConnectedSubmesh=="screen1"
		   && cMath_Abs(ext.y/ext.x-0.5482911723f)<0.01f && cMath_Abs(ext.z/ext.x-0.1995616278f)<0.01f)
		{
			plane=cVector3f(0.0000000000f,-1.0000000000f,1.0000000000f);
			uv0=cVector2f(0.0000000000f,-0.0000000000f);
			uvX=cVector2f(-0.0000000000f,1.0000000000f);
			uvY=cVector2f(1.0000000000f,0.0000000000f);
			return true;
		}
		if(file=="laptop_touchscreen_nosound.ent" && msConnectedSubmesh=="screen1"
		   && cMath_Abs(ext.y/ext.x-0.5482911723f)<0.01f && cMath_Abs(ext.z/ext.x-0.1995616278f)<0.01f)
		{
			plane=cVector3f(0.0000000000f,-1.0000000000f,1.0000000000f);
			uv0=cVector2f(0.0000000000f,-0.0000000000f);
			uvX=cVector2f(-0.0000000000f,1.0000000000f);
			uvY=cVector2f(1.0000000000f,0.0000000000f);
			return true;
		}
		return false;
	}
	cVector3f _HPL3VR_ProjectLaptop(cVector3f p, const cVector3f &in lo, const cVector3f &in hi, const cVector3f &in plane)
	{
		p.z=lo.z+(hi.z-lo.z)*(plane.x*(p.x-lo.x)/(hi.x-lo.x)+plane.y*(p.y-lo.y)/(hi.y-lo.y)+plane.z);
        return p;
	}
	cVector2f _HPL3VR_LaptopUV(const cVector3f &in p, const cVector3f &in lo, const cVector3f &in hi, const cVector2f &in origin, const cVector2f &in ux, const cVector2f &in uy)
	{
		return origin+ux*((p.x-lo.x)/(hi.x-lo.x))+uy*((p.y-lo.y)/(hi.y-lo.y));
	}


    // S26Q: cached mesh-derived mapping for planar connected screens.
    // Match the shipped asset, submesh, normal axis and live bounds proportions.
    [nosave] bool mbVRFitChecked=false;
    [nosave] bool mbVRFitValid=false;
    [nosave] tString msVRFitFile="";
    [nosave] tString msVRFitSubmesh="";
    [nosave] int mlVRFitAxis=-1;
    [nosave] cVector3f mvVRFitPlane;
    [nosave] cVector2f mvVRFitRatio;
    [nosave] cVector2f mvVRFitUV0;
    [nosave] cVector2f mvVRFitUVX;
    [nosave] cVector2f mvVRFitUVY;
    float _HPL3VR_Axis(const cVector3f &in p, int axis)
    {
        return axis==0 ? p.x : (axis==1 ? p.y : p.z);
    }
