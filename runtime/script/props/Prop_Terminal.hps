	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		msConnectedSubmesh = apVars.GetVarString("ConnectedSubmesh", "");
		
		cColor clearColor = apVars.GetVarColor("ClearColor", cColor(0,1));
		cColor offlineClearColor = apVars.GetVarColor("OfflineClearColor", cColor(0,1));
		cColor colorMul = apInstanceVars.GetVarColor("TerminalColorMul", cColor(1,1)) * 
						  cColor(apInstanceVars.GetVarFloat("TerminalBrightness", 1.0f),1.0);
		cVector2f vScreenSize = apVars.GetVarVector2f("ScreenSize", cVector2f(512.0f));
		mvHPL3VRScreenSize = vScreenSize;
		
		mBaseObj.CreateAndSetupGui(msConnectedSubmesh, colorMul, clearColor, offlineClearColor, vScreenSize);
		
		mvScreenPos = apVars.GetVarVector3f("ScreenPosition", cVector3f(0, 0, 0))*mBaseObj.GetOnLoadScale();
		mvScreenNormal = apVars.GetVarVector3f("ScreenNormal", cVector3f(0, 0, 1));
		mfCameraDistance = apVars.GetVarFloat("TargetCameraDistance", 1)*mBaseObj.GetOnLoadScale().y;

		///////////////////////////
		// Instance variables
		float fFPSWhenIdle = apInstanceVars.GetVarFloat("FPSWhenIdle", 30);
		mBaseObj.SetGuiVariableFPS(fFPSWhenIdle);
		
		mfCacheAtScreenSize = apInstanceVars.GetVarFloat("CacheAtScreenSize", 0.05);
		mBaseObj.SetGuiCacheAtScreenSize(mfCacheAtScreenSize);
		mBaseObj.SetOnGuiFunction(apInstanceVars.GetVarString("OnGuiFunction", ""));
		mBaseObj.SetGuiUpdateWhenOutOfView(apInstanceVars.GetVarBool("UpdateWhenOutOfView", false));
		mBaseObj.SetGuiActive(apInstanceVars.GetVarBool("GuiActive", true));
		
		mbShowMouse = apInstanceVars.GetVarBool("ShowMouse", true);
		mbAllowInteraction = apInstanceVars.GetVarBool("AllowInteraction", true);
		
		msEnterCallback = apInstanceVars.GetVarString("EnterCallback", "");
		msLeaveCallback = apInstanceVars.GetVarString("LeaveCallback", "");
		
		msPlayerPosEntity = apInstanceVars.GetVarString("PlayerPosEntity", "");
		mfFOV = cMath_ToRad(apInstanceVars.GetVarFloat("VerticalFOV", 70));

		mBaseObj.SetGuiSetUseInput(mbAllowInteraction);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
    [nosave] float mfVRCursorPoll=0;
    [nosave] bool mbVRAutoCursorOwned=false;
    [nosave] bool mbVRAutoCursorOriginal=true;
    [nosave] bool mbVRSetCursorOwned=false;
    [nosave] bool mbVRSetCursorOriginal=true;
    void OnUpdate(float afTimeStep)
    {
        // A moving monitor must publish its current connected mesh transform.
        if(mBaseObj.IsGuiFocused() && _HPL3VR_RuntimeActive_PropTerminal())
        {
            cVector3f n=cMath_MatrixMul(mBaseObj.GetMatrix().GetRotation(),cMath_Vector3Normalize(mvScreenNormal));
            _HPL3VR_PublishConnectedTerminalSurface(n,true);
        }
        else mbAYSurfaceCached=false;
        mfVRCursorPoll-=afTimeStep;if(mfVRCursorPoll>0) return;mfVRCursorPoll=0.1f;
        if(mBaseObj.GetGuiSet() is null) return;
        bool vr=_HPL3VR_RuntimeActive_PropTerminal();
        // Legacy widget terminals (including the laptop) need no ImGui.
        cGuiSet@ cursorSet=mBaseObj.GetGuiSet().GetSet();
        if(cursorSet !is null)
        {
            if(vr){if(!mbVRSetCursorOwned){mbVRSetCursorOriginal=cursorSet.GetDrawMouse();mbVRSetCursorOwned=true;}cursorSet.SetDrawMouse(false);}
            else if(mbVRSetCursorOwned){cursorSet.SetDrawMouse(mbVRSetCursorOriginal);mbVRSetCursorOwned=false;}
        }
        cImGui@ gui=mBaseObj.GetGuiSet().GetImGui();if(gui is null) return;
        if(vr)
        {
            if(!mbVRAutoCursorOwned){mbVRAutoCursorOriginal=gui.GetShowMouseAutomatically();mbVRAutoCursorOwned=true;}
            gui.SetShowMouseAutomatically(false);
            if(cScript_RunGlobalFunc("VRGUI","","R"))
            {
                gui.SendMouseVirtualPosition(cVector2f(0),cVector2f(0));
                cScript_RunGlobalFunc("VRGUI","","E");
            }
        }
        else if(mbVRAutoCursorOwned){gui.SetShowMouseAutomatically(mbVRAutoCursorOriginal);mbVRAutoCursorOwned=false;}
    }
