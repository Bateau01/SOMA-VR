                mvVRFitRatio=cVector2f(0.6481772695f,0.3491515103f);
                mvVRFitUV0=cVector2f(-0.0000000000f,1.0000000000f);
                mvVRFitUVX=cVector2f(1.0000000000f,0.0000000000f);
                mvVRFitUVY=cVector2f(0.0000000000f,-1.0000000000f);
            }
        }
        if(!mbVRFitValid) return false;
        cVector3f ext=hi-lo;
        float eu=_HPL3VR_Axis(ext,axis==0 ? 1 : 0), ev=_HPL3VR_Axis(ext,axis==2 ? 1 : 2);
        if(eu<0.001f || ev<0.001f) return false;
        return cMath_Abs(ev/eu-mvVRFitRatio.x)<0.01f && cMath_Abs(_HPL3VR_Axis(ext,axis)/eu-mvVRFitRatio.y)<0.01f;
    }
    cVector2f _HPL3VR_MeshCoordinates(const cVector3f &in p, const cVector3f &in lo, const cVector3f &in hi)
    {
        int u=mlVRFitAxis==0 ? 1 : 0, v=mlVRFitAxis==2 ? 1 : 2;
        return cVector2f((_HPL3VR_Axis(p,u)-_HPL3VR_Axis(lo,u))/(_HPL3VR_Axis(hi,u)-_HPL3VR_Axis(lo,u)),
                         (_HPL3VR_Axis(p,v)-_HPL3VR_Axis(lo,v))/(_HPL3VR_Axis(hi,v)-_HPL3VR_Axis(lo,v)));
    }
    cVector3f _HPL3VR_ProjectMesh(cVector3f p, const cVector3f &in lo, const cVector3f &in hi)
    {
        cVector2f uv=_HPL3VR_MeshCoordinates(p,lo,hi);
        int u=mlVRFitAxis==0 ? 1 : 0;
        float value=_HPL3VR_Axis(lo,mlVRFitAxis)+(_HPL3VR_Axis(hi,u)-_HPL3VR_Axis(lo,u))*(mvVRFitPlane.x*uv.x+mvVRFitPlane.y*uv.y+mvVRFitPlane.z);
        if(mlVRFitAxis==0) p.x=value;
        else if(mlVRFitAxis==1) p.y=value;
        else p.z=value;
        return p;
    }
    cVector2f _HPL3VR_MeshUV(const cVector3f &in p, const cVector3f &in lo, const cVector3f &in hi)
    {
        cVector2f uv=_HPL3VR_MeshCoordinates(p,lo,hi);
        return mvVRFitUV0+mvVRFitUVX*uv.x+mvVRFitUVY*uv.y;
    }

	void _HPL3VR_PublishConnectedTerminalSurface(const cVector3f &in avScreenNormal, bool abRefresh=false)
	{
		cGuiSet@ pSet = cGui_GetFocusedSet();
		cMeshEntity@ pMeshEntity = mBaseObj.GetMeshEntity();
		if (pSet is null || pMeshEntity is null || msConnectedSubmesh == "")
		{
			cScript_RunGlobalFunc("VRTERM", "", "X");
			return;
		}

		cMesh@ pMesh = pMeshEntity.GetMesh();
		if (pMesh is null)
		{
			cScript_RunGlobalFunc("VRTERM", "", "X");
			return;
		}

		int lSubIdx = pMesh.GetSubMeshIndex(msConnectedSubmesh);
		if (lSubIdx < 0 || lSubIdx >= pMeshEntity.GetSubMeshEntityNum())
		{
			cScript_RunGlobalFunc("VRTERM", "", "X");
			return;
		}

		cSubMeshEntity@ pSubEnt = pMeshEntity.GetSubMeshEntity(lSubIdx);
		cSubMesh@ pSubMesh = pMesh.GetSubMesh(lSubIdx);
		if (pSubEnt is null || pSubMesh is null)
		{
			cScript_RunGlobalFunc("VRTERM", "", "X");
			return;
		}

		iVertexBuffer@ pVB = pSubMesh.GetVertexBuffer();
		if (pVB is null)
		{
			cScript_RunGlobalFunc("VRTERM", "", "X");
			return;
		}

		cVector3f vMin = pVB.GetAABBMin();
		cVector3f vMax = pVB.GetAABBMax();
		cVector3f vExt = vMax - vMin;
		cVector3f vCenter = (vMin + vMax) * 0.5f;
		cMatrixf mtxWorld = pSubEnt.GetWorldMatrix();
        bool same=abRefresh && mbAYSurfaceCached;
        if(same)for(int row=0;row<3;row++)for(int col=0;col<4;col++)
            if(cMath_Abs(mtxWorld.GetElement(row,col)-mtxAYSurface.GetElement(row,col))>0.000001f)same=false;
        if(same)return;
        mbAYSurfaceCached=false;

		cVector3f vWorldCenter = cMath_MatrixMul(mtxWorld, vCenter);

		// Pick the thinnest local AABB dimension as the panel normal.  This is
		// data-driven from the authored connected submesh, not a map/entity table.
		int lNormalAxis = 0;
		if (vExt.y < vExt.GetElement(lNormalAxis)) lNormalAxis = 1;
		if (vExt.z < vExt.GetElement(lNormalAxis)) lNormalAxis = 2;
		int lAxisA = (lNormalAxis == 0) ? 1 : 0;
		int lAxisB = (lNormalAxis == 2) ? 1 : 2;
		if (lNormalAxis == 1) lAxisB = 2;

		cVector3f vLocalA(0), vLocalB(0);
		vLocalA.SetElement(lAxisA, vExt.GetElement(lAxisA));
		vLocalB.SetElement(lAxisB, vExt.GetElement(lAxisB));
		cVector3f vWorldA = cMath_MatrixMul(mtxWorld, vCenter + vLocalA) - vWorldCenter;
		cVector3f vWorldB = cMath_MatrixMul(mtxWorld, vCenter + vLocalB) - vWorldCenter;
		float fLenA = vWorldA.Length();
		float fLenB = vWorldB.Length();
		if (fLenA < 0.005f || fLenB < 0.005f)
		{
			cScript_RunGlobalFunc("VRTERM", "", "X");
			return;
		}

		// ScreenSize is the authored terminal render-target aspect.  Use it only
		// to decide which of the two panel axes is horizontal; actual dimensions
		// still come from the connected submesh itself.
		float fGuiAspect = mvHPL3VRScreenSize.y > 0.001f ? mvHPL3VRScreenSize.x / mvHPL3VRScreenSize.y : 1.0f;
		float fAB = fLenA / fLenB;
		float fBA = fLenB / fLenA;
		int lHAxis = cMath_Abs(fAB - fGuiAspect) <= cMath_Abs(fBA - fGuiAspect) ? lAxisA : lAxisB;
		int lVAxis = lHAxis == lAxisA ? lAxisB : lAxisA;

		cVector3f vLocalH(0), vLocalV(0);
		vLocalH.SetElement(lHAxis, vExt.GetElement(lHAxis));
		vLocalV.SetElement(lVAxis, vExt.GetElement(lVAxis));
		cVector3f vWorldHPlus = cMath_MatrixMul(mtxWorld, vCenter + vLocalH) - vWorldCenter;
		cVector3f vWorldVPlus = cMath_MatrixMul(mtxWorld, vCenter + vLocalV) - vWorldCenter;

		// Prefer physical world-up for the screen's visual top/bottom.  On nearly
		// horizontal panels, retain positive local V rather than inventing a map rule.
		bool bVUpPositive = true;
		if (cMath_Abs(vWorldVPlus.y) > vWorldVPlus.Length() * 0.15f)
			bVUpPositive = vWorldVPlus.y > 0;
		cVector3f vWorldVUp = bVUpPositive ? vWorldVPlus : vWorldVPlus * -1.0f;

		// Pick screen-right so right x up faces the authored screen normal.  This
		// keeps mirrored/rotated terminals generic while preserving GUI Y-down.
		cVector3f vN = cMath_Vector3Normalize(avScreenNormal);
		bool bHRightPositive = cMath_Vector3Dot(cMath_Vector3Cross(vWorldHPlus, vWorldVUp), vN) >= 0;

		cVector3f vTL = vCenter;
		cVector3f vTR = vCenter;
		cVector3f vBL = vCenter;
		float fHMin = vMin.GetElement(lHAxis), fHMax = vMax.GetElement(lHAxis);
		float fVMin = vMin.GetElement(lVAxis), fVMax = vMax.GetElement(lVAxis);
		float fLeft = bHRightPositive ? fHMin : fHMax;
		float fRight = bHRightPositive ? fHMax : fHMin;
		float fTop = bVUpPositive ? fVMax : fVMin;
		float fBottom = bVUpPositive ? fVMin : fVMax;
		vTL.SetElement(lHAxis, fLeft);  vTL.SetElement(lVAxis, fTop);
		vTR.SetElement(lHAxis, fRight); vTR.SetElement(lVAxis, fTop);
		vBL.SetElement(lHAxis, fLeft);  vBL.SetElement(lVAxis, fBottom);

		cVector3f vLaptopPlane(0); cVector2f vLaptopUV0(0),vLaptopUVX(0),vLaptopUVY(0);
		bool bLaptopPlane=lNormalAxis==2 && _HPL3VR_LaptopPlane(vMin,vMax,vLaptopPlane,vLaptopUV0,vLaptopUVX,vLaptopUVY);
		if(bLaptopPlane)
		{
			vTL=_HPL3VR_ProjectLaptop(vTL,vMin,vMax,vLaptopPlane);
			vTR=_HPL3VR_ProjectLaptop(vTR,vMin,vMax,vLaptopPlane);
			vBL=_HPL3VR_ProjectLaptop(vBL,vMin,vMax,vLaptopPlane);
		}
        bool bMeshPlane=!bLaptopPlane && _HPL3VR_MeshFit(lNormalAxis,vMin,vMax);
        if(bMeshPlane)
        {
            vTL=_HPL3VR_ProjectMesh(vTL,vMin,vMax);
            vTR=_HPL3VR_ProjectMesh(vTR,vMin,vMax);
            vBL=_HPL3VR_ProjectMesh(vBL,vMin,vMax);
        }
		cVector3f vP0 = cMath_MatrixMul(mtxWorld, vTL);
		cVector3f vUSpan = cMath_MatrixMul(mtxWorld, vTR) - vP0;
		cVector3f vVSpan = cMath_MatrixMul(mtxWorld, vBL) - vP0;
		if(bLaptopPlane || bMeshPlane)
		{
			cVector3f vExactN=cMath_Vector3Normalize(cMath_Vector3Cross(vUSpan,vVSpan));
			vN=cMath_Vector3Dot(vExactN,vN)<0 ? vExactN*-1.0f : vExactN;
		}
		cVector2f vVirtual = pSet.GetVirtualSize();
		cVector2f vOffset = pSet.GetVirtualSizeOffset();

		tString sSurface = cString_ToString(vP0.x, 6) + "," +
					   cString_ToString(vP0.y, 6) + "," +
					   cString_ToString(vP0.z, 6) + "," +
					   cString_ToString(vUSpan.x, 6) + "," +
					   cString_ToString(vUSpan.y, 6) + "," +
					   cString_ToString(vUSpan.z, 6) + "," +
					   cString_ToString(vVSpan.x, 6) + "," +
					   cString_ToString(vVSpan.y, 6) + "," +
					   cString_ToString(vVSpan.z, 6) + "," +
					   cString_ToString(vN.x, 6) + "," +
					   cString_ToString(vN.y, 6) + "," +
					   cString_ToString(vN.z, 6) + "," +
					   cString_ToString(vVirtual.x, 3) + "," +
					   cString_ToString(vVirtual.y, 3) + "," +
					   cString_ToString(vOffset.x, 3) + "," +
					   cString_ToString(vOffset.y, 3);
        // Keep world contact bounds unchanged; carry the real texture mapping
        // separately. The baseline 16-field token still means full-rectangle UV.
        if(cString_GetFileName(mBaseObj.GetFileName())=="security_keypad.ent" && msConnectedSubmesh=="GUI"
           && lNormalAxis==2 && vExt.x>0.001f && vExt.y>0.001f)
        {
            cVector2f uv0=_HPL3VR_KeypadUV(vTL,vMin,vMax);
            cVector2f uvU=_HPL3VR_KeypadUV(vTR,vMin,vMax)-uv0;
            cVector2f uvV=_HPL3VR_KeypadUV(vBL,vMin,vMax)-uv0;
            sSurface+=","+cString_ToString(uv0.x,6)+","+cString_ToString(uv0.y,6)
                +","+cString_ToString(uvU.x,6)+","+cString_ToString(uvU.y,6)
                +","+cString_ToString(uvV.x,6)+","+cString_ToString(uvV.y,6);
        }
		if(bLaptopPlane)
		{
			cVector2f uv0=_HPL3VR_LaptopUV(vTL,vMin,vMax,vLaptopUV0,vLaptopUVX,vLaptopUVY);
			cVector2f uvU=_HPL3VR_LaptopUV(vTR,vMin,vMax,vLaptopUV0,vLaptopUVX,vLaptopUVY)-uv0;
			cVector2f uvV=_HPL3VR_LaptopUV(vBL,vMin,vMax,vLaptopUV0,vLaptopUVX,vLaptopUVY)-uv0;
			sSurface+=","+cString_ToString(uv0.x,6)+","+cString_ToString(uv0.y,6)
				+","+cString_ToString(uvU.x,6)+","+cString_ToString(uvU.y,6)
				+","+cString_ToString(uvV.x,6)+","+cString_ToString(uvV.y,6);
		}
        if(bMeshPlane)
        {
            cVector2f uv0=_HPL3VR_MeshUV(vTL,vMin,vMax);
            cVector2f uvU=_HPL3VR_MeshUV(vTR,vMin,vMax)-uv0;
            cVector2f uvV=_HPL3VR_MeshUV(vBL,vMin,vMax)-uv0;
            sSurface+=","+cString_ToString(uv0.x,6)+","+cString_ToString(uv0.y,6)
                +","+cString_ToString(uvU.x,6)+","+cString_ToString(uvU.y,6)
                +","+cString_ToString(uvV.x,6)+","+cString_ToString(uvV.y,6);
        }
		cScript_RunGlobalFunc("VRTERM", sSurface, abRefresh ? "U" : "B");
        mtxAYSurface=mtxWorld;mbAYSurfaceCached=true;
	}

