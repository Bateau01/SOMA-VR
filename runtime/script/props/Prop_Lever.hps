	[nosave] cPidControllerVec3 mRotatePid;

	[nosave] iPhysicsJointHinge @mpHingeJoint;
	[nosave] iPhysicsBody @mpLeverBody;
	
	[nosave] float mfDefaultMinAngle;
	[nosave] float mfDefaultMaxAngle;
	
	//------------------------------------------------------------
	
	[nosave] float mfMoveMaxSpeed;
    [nosave] float mfMoveSlowDownFactor;
    [nosave] float mfMoveSpeedFactor;
    [nosave] bool mbCanInteractWithStaticBody;
    [nosave] float mfMinLimitRange;
    [nosave] float mfMaxLimitRange;
	[nosave] tString msMinLimitSound;
	[nosave] tString msMaxLimitSound;
	[nosave] tString msStuckSound;
	[nosave] tString msMinInteractSound;
	[nosave] tString msMaxInteractSound;
	[nosave] bool mbSkipMiddleState; //Not used atm..
	
	//------------------------------------------------------------
	
	eCrossHairState mInteractIcon;
		
	bool mbInteractionDisablesStuck;
	
	int mlMoveDirection;
	
	float mfMiddleAngle;
	float mfMiddleAngleAmount;
	
	bool mbMinLimitStuck;
	bool mbMaxLimitStuck;
	
	bool mbAutoMoveToAngle;
	int mlAutoMoveGoal;
	float mfAutoMoveSpeedFactor;
	float mfAutoMoveMaxSpeed;
	
	int mlCurrentState;
	int mlStuckState;
	
	float mfStuckSoundTimer;
	cUtility_JointFix mJointFix;
	
	//------------------------------------------------------------
		
}	