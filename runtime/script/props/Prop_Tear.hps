#include "interfaces/Prop_Interface.hps"
#include "base/Player_Types.hps"

/////////////////////////////////////////
// SETTINGS
/////////////////////////////////////////

//------------------------------------------------------------

enum eTearType
{
	eTearType_Slide,
	eTearType_Hinge,
}

//------------------------------------------------------------

class cScrPropTear : iScrProp, iScrProp_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mTearPid.SetErrorNum(10);
		mTearPid.p = 10.0f;
		mTearPid.i = 0.0f;
		mTearPid.d = 1.0f;
		
		m_idStressSound = tID_Invalid;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		mbGrab_UseCustomOffset = apVars.GetVarBool("Grab_UseCustomOffset", false);
		mvGrab_CostumPositionOffset = apVars.GetVarVector3f("Grab_CustomPositionOffset", cVector3f(0,0,0));
		mvGrab_CostumRotationOffset = apVars.GetVarVector3f("Grab_CustomRotationOffset", cVector3f(0,0,0));
		mbGrab_UseCustomDepth = apVars.GetVarBool("Grab_UseCustomDepth", false);
		mfGrab_CustomDepth = apVars.GetVarFloat("Grab_CustomDepth", 0);
		mfGrab_MassMul = apVars.GetVarFloat("Grab_MassMul", 0.1);
		mfGrab_MinDepth = apVars.GetVarFloat("Grab_MinDepth", 1);
		mfGrab_MaxDepth = apVars.GetVarFloat("Grab_MaxDepth", 5);
		mfGrab_ForceMul = apVars.GetVarFloat("Grab_ForceMul", 1);
		mfGrab_TorqueMul = apVars.GetVarFloat("Grab_TorqueMul", 1);
		mbGrab_IsHeavy = apVars.GetVarBool("Grab_IsHeavy", false);
		mbGrab_CollisionWithPlayer = apVars.GetVarBool("Grab_CollisionWithPlayer", false);
		
		msTear_Joint = apVars.GetVarString("Tear_Joint", "");
		mfTear_MoveMaxSpeed = apVars.GetVarFloat("Tear_MoveMaxSpeed", 0.1);
		mfTear_MoveSlowDownSpeed = apVars.GetVarFloat("Tear_MoveSlowDownSpeed", 1);
		mfTear_MoveSpeedFactor = apVars.GetVarFloat("Tear_MoveSpeedFactor", 0.05);
		mbTear_LoseGripWhenTorn = apVars.GetVarBool("Tear_LoseGripWhenTorn", false);
		mfTear_VelocityMulWhenTorn = apVars.GetVarFloat("Tear_VelocityMulWhenTorn", 1.f);
		mfTear_HealthLossFactor = apVars.GetVarFloat("Tear_HealthLossFactor", 0.4);
		mfTear_MaxSnapBackSpeed = apVars.GetVarFloat("Tear_MaxSnapBackSpeed", 1);
		mfTear_MainBodyMassMul = apVars.GetVarFloat("Tear_MainBodyMassMul", 1);
		msTear_StressSound = apVars.GetVarString("Tear_StressSound", "");
		
		////////////////////////////////////
		// Get Joint and door body
		mlJointIndex = 0;
		if (msTear_Joint != "")
		{
			tString sActualName = mBaseObj.GetName() + "_" + msTear_Joint;
			for (int i = 0; i < mBaseObj.GetJointNum(); i++)
			{
				if (mBaseObj.GetJoint(i).GetName() != sActualName)
				{
					continue;
				}
				
				mlJointIndex = i;
				break;
			}
		}
		
		iPhysicsJoint@ pJoint = mBaseObj.GetJoint(mlJointIndex);
		iPhysicsBody @pBody = pJoint.GetChildBody();

		pBody.SetMass(pBody.GetMass() * mfTear_MainBodyMassMul);
		pJoint.SetStickyMinLimit(true);
		if (cPhysics_ToJointHinge(pJoint) !is null)
		{
			mTearType = eTearType_Hinge;
			mTearPid.p = 10;
			mTearPid.d = 1.0f;
			
			iPhysicsJointHinge@ pHinge = cPhysics_ToJointHinge(pJoint);
			mfJointMax = pHinge.GetMaxAngle();
			pHinge.SetMaxAngle(0.001);
		}
		else
		{
			mTearType = eTearType_Slide;
			mTearPid.p = 6;
			mTearPid.d = 0.1f;
			
			iPhysicsJointSlider@ pSlider = cPhysics_ToJointSlider(pJoint);
			mfJointMax = pSlider.GetMaxDistance();
			pSlider.SetMaxDistance(0.001);
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{			
		////////////////////////////
		// Check interaction
		if(mbIsInteracting && !mBaseObj.IsInteractedWith())
		{
			mbIsInteracting = false;
			mTearPid.Reset();
			
			if (m_idStressSound != tID_Invalid)
			{	
				cSoundEntity@ pStressSound = cLux_ID_SoundEntity(m_idStressSound);
				if(pStressSound !is null) pStressSound.FadeOut(2.f);
				m_idStressSound = tID_Invalid;
			}
		}
		
		if (mbJointBroken) return;
		
		iPhysicsJoint@ pJoint = mBaseObj.GetJoint(mlJointIndex);
		float fFraction = GetJointFraction(pJoint);
		iPhysicsBody @pBody = pJoint.GetChildBody();
		
		//////////////////////////////////////////////////////////////////
		// Check if body has been moved enough to activate body again
		if (!mbUpdateForces)
		{
			if (fFraction < 0.1) return;
			
			mbUpdateForces = true; 
			pBody.Enable();
			pBody.SetAutoDisable(false);
		}	
		
		///////////////////////////////////////////////
		// Get correct tear speed
		float fTearSpeed = -mfTear_MaxSnapBackSpeed;
		if (mbIsInteracting)
		{
			fTearSpeed = mBaseObj.GetVarFloat("TearSpeed"); // Use speed from interact state
			
			if (fTearSpeed > 0) fTearSpeed *= mfTear_MoveMaxSpeed;
			else 				fTearSpeed *= mfTear_MaxSnapBackSpeed;
		}
		
		//////////////////////////////////////////////
		// Check if body should get locked in place
		else if (fFraction < 0.01f)
		{
			mbUpdateForces = false;
			pBody.SetAutoDisable(true);
			
			if (mTearType == eTearType_Hinge)
				cPhysics_ToJointHinge(mBaseObj.GetJoint(mlJointIndex)).SetMaxAngle(0.001);
			else
				cPhysics_ToJointSlider(mBaseObj.GetJoint(mlJointIndex)).SetMaxDistance(0.001);
				
			return;
		}	
		
		///////////////////////
		// Slide joint
		if (mTearType == eTearType_Slide)
		{	
			
			//////////////////////////////
			//Update force			
			cVector3f vJointVel = pJoint.GetVelocity();
			cVector3f vWantedVel = pJoint.GetPinDir() * fTearSpeed;
			
			cVector3f vForce = mTearPid.Output(vWantedVel - vJointVel, afTimeStep) * pBody.GetMass();
			
			vForce = cMath_Vector3MaxLength(vForce, mfMaxForce*pBody.GetMass());

			pBody.AddForce(vForce);
		}
		
		///////////////////////
		// Hinge joint
		else
		{					
			///////////////////////////////////
			//Calculate torque
			cVector3f vRotateDir = pJoint.GetPinDir() * -1;
			cVector3f vBodyVel = pBody.GetAngularVelocity();
			cVector3f vHingeVel = vRotateDir * cMath_Vector3Dot(vRotateDir, vBodyVel);
			cVector3f vWantedVel = vRotateDir * fTearSpeed;
			
			cVector3f vTorque = mTearPid.Output(vWantedVel - vHingeVel, afTimeStep);
			vTorque = cMath_MatrixMul(pBody.GetInertiaMatrix(), vTorque);
			
			vTorque = cMath_Vector3MaxLength(vTorque, mfMaxForce*pBody.GetMass());

			pBody.AddTorque(vTorque);
		}	
		
		//////////////////////////////////////////////
		// Handle sound
		if (fTearSpeed > 0)
		{
			if (m_idStressSound == tID_Invalid && msTear_StressSound != "" && !mbStressSoundAttemptFailed)
			{
				cSoundEntity@ pStressSound = mBaseObj.PlaySound("StressSound", msTear_StressSound, true, true);
				if (pStressSound !is null)
				{
					pStressSound.FadeIn(2.f);
					m_idStressSound = pStressSound.GetID();
				}
				else mbStressSoundAttemptFailed = true;
			}
			
			if (m_idStressSound != tID_Invalid) 
			{
				cSoundEntity@ pStressSound = cLux_ID_SoundEntity(m_idStressSound);
				if(pStressSound !is null) pStressSound.SetParam(0, fTearSpeed);
			}
		}
		else if (m_idStressSound != tID_Invalid)
		{
			cSoundEntity@ pStressSound = cLux_ID_SoundEntity(m_idStressSound);
			if(pStressSound !is null) pStressSound.FadeOut(2.f);
			m_idStressSound = tID_Invalid;
		}
	}
	
