	//------------------------------------------------------------
	
	void OnHealthChange()
	{
	}
	//------------------------------------------------------------
	
	//NOTE: This is only useable if SetScriptCollisionCallbackActive is true
	void OnPhysicsCollision(iPhysicsBody @apBody, iPhysicsBody @apCollideBody, cPhysicsContactData&in aContactData)
	{
		//Debug:
		cLux_AddDebugMessage("Body "+apBody.GetName()+" vs "+apCollideBody.GetName() + "Nrm: " +aContactData.mfMaxContactNormalSpeed + " Tan: "+aContactData.mfMaxContactTangentSpeed, false);
	}
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		if(mBaseObj.GetStaticPhysics()) return false;
		if(mBaseObj.GetParentType() == eParentType_StickyStuck) return false;
		if(apBody.GetMass()==0) return false;
	
		return true;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		// Retry a failed optional sound on a new interaction, never every update.
		mbStressSoundAttemptFailed = false;
		
		if (mbJointBroken)
		{
			return SetupGrabInteract(alType, apBody, avFocusPos, asData);
		}
		else
		{
			iPhysicsJoint@ pJoint = mBaseObj.GetJoint(mlJointIndex);
			if (mTearType == eTearType_Hinge)
				cPhysics_ToJointHinge(pJoint).SetMaxAngle(mfJointMax);
			else
				cPhysics_ToJointSlider(pJoint).SetMaxDistance(mfJointMax);
			
			iPhysicsBody @pBody = pJoint.GetChildBody();
			cVector3f vFocusPos = avFocusPos;
			if (@apBody != pBody)
			{
				vFocusPos = pBody.GetWorldPosition();
			}
			
			mbUpdateForces = true;
			pBody.Enable();
			pBody.SetAutoDisable(false);
			return SetupTearInteract(alType, pBody, vFocusPos, asData);
		}
	}
	
	//------------------------------------------------------------
	
	bool SetupGrabInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		mTearPid.Reset();
		
		///////////////////////////////
		//Set up the grabstate
		cScript_SetGlobalArgID(0, mBaseObj.GetID()); //Object ID
		cScript_SetGlobalArgInt(1, apBody.GetUniqueID()); //Body Id
		cScript_SetGlobalArgVector3f(2, avFocusPos);//The grab postion
		cScript_SetGlobalArgBool(3, mbGrab_UseCustomOffset);	//Use custom offset
		cScript_SetGlobalArgVector3f(4, mvGrab_CostumPositionOffset);	//Costum Position offset
		cScript_SetGlobalArgVector3f(5, mvGrab_CostumRotationOffset);	//Costum Rotation offset
		cScript_SetGlobalArgBool(6, mbGrab_UseCustomDepth);	//Use custom Depth
		cScript_SetGlobalArgFloat(7, mfGrab_CustomDepth);	//Custom depth
		cScript_SetGlobalArgFloat(8, mfGrab_MassMul);	//Grab mass mul
		cScript_SetGlobalArgFloat(9, mfGrab_MinDepth);	//Min depth
		cScript_SetGlobalArgFloat(10, mfGrab_MaxDepth);	//Max Depth
		cScript_SetGlobalArgFloat(11, mfGrab_ForceMul);
		cScript_SetGlobalArgFloat(12, mfGrab_TorqueMul);
		cScript_SetGlobalArgBool(13, mbGrab_IsHeavy);
		cScript_SetGlobalArgBool(14, mbGrab_CollisionWithPlayer);
		
		cScript_RunGlobalFunc("State_Interact_Grab", "", "SetupGrab");
		
		///////////////////////////////
		//Set up the grabstate
		cLux_GetPlayer().ChangeState(ePlayerState_Grab);	
	
		return true;
	}
	
	//------------------------------------------------------------
	
	bool SetupTearInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		mTearPid.Reset();
		
		///////////////////////////////
		//If body mass is 0, get a dynamic body
		iPhysicsJoint@ pJoint = mBaseObj.GetJoint(mlJointIndex);
		iPhysicsBody @pBody = pJoint.GetChildBody();
		@apBody = pBody;

		///////////////////////////////
		//Check if in sticky area
		//mBaseObj.GetMap().DetachBodyFromStickyArea(apBody); (not implemented!)
		
		///////////////////////////////
		//Set up the slide state
		cScript_SetGlobalArgID(0, mBaseObj.GetID()); //Object ID
		cScript_SetGlobalArgInt(1, apBody.GetUniqueID()); //Body Id
		cScript_SetGlobalArgVector3f(2, avFocusPos);//The grab postion
		
		cScript_SetGlobalArgFloat(3, mfTear_MoveSpeedFactor);
		cScript_SetGlobalArgFloat(4, mfTear_MoveSlowDownSpeed);
		cScript_SetGlobalArgFloat(5, mfTear_HealthLossFactor);
		cScript_SetGlobalArgInt(6, mlJointIndex);

		cScript_RunGlobalFunc("State_Interact_Tear", "", "SetupTear");
		
		///////////////////////////////
		//Change the player state
		cLux_GetPlayer().ChangeState(ePlayerState_Tear);	
		mbIsInteracting = true;

		return true;
	}

	//------------------------------------------------------------

	void _Global_OnAddSpeed()
	{
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		if (!mbJointBroken)
		{
			if (mTearType == eTearType_Hinge)
				return eCrossHairState_PullDoor;
			else
				return eCrossHairState_PullOut;
		}
		else if(mbGrab_IsHeavy)
		{
			return eCrossHairState_CarryTwoHanded;
		}
		else
		{
			return eCrossHairState_CarryOneHanded;
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_Tear()
	{
		if (mbJointBroken) return;
		
		iPhysicsJoint@ pJoint = mBaseObj.GetJoint(mlJointIndex);
		iPhysicsBody @pMainBody = pJoint.GetChildBody();
		
		pMainBody.SetAutoDisable(true);
		pMainBody.SetMass(pMainBody.GetMass()/mfTear_MainBodyMassMul);
		
		// Sound
		if (m_idStressSound != tID_Invalid)
		{
			cSoundEntity@ pStressSound = cLux_ID_SoundEntity(m_idStressSound);
			if(pStressSound !is null) pStressSound.Stop(false);
			m_idStressSound = tID_Invalid;
		}
		
		int lBodyID = cScript_GetGlobalArgInt(0);
		iPhysicsBody@ pBody = mBaseObj.GetBodyFromID(lBodyID);
		
		cVector3f vPinDir = pJoint.GetPinDir();
		
		if (mTearType == eTearType_Slide)
		{
			pBody.SetLinearVelocity(vPinDir*mfTear_VelocityMulWhenTorn);
		}
		else
		{
			cVector3f vBodyCenter = cMath_MatrixMul(pBody.GetLocalMatrix(), pBody.GetMassCenter());
			cVector3f vJointToBody =  cMath_Vector3Normalize(vBodyCenter - pJoint.GetPivotPoint());
			cVector3f vJointTurnFwd = cMath_Vector3Cross(vJointToBody, vPinDir);
			
			pBody.SetLinearVelocity(vJointTurnFwd*mfTear_VelocityMulWhenTorn);
			pBody.SetAngularVelocity(vPinDir*-mfTear_VelocityMulWhenTorn);
		}			
		
		// Handle changing of state here
		if (mbIsInteracting)
		{			
			// Transfer interaction to Grab
			if (!mbTear_LoseGripWhenTorn)
			{
				cVector3f vFocusPos = cScript_GetGlobalArgVector3f(1);
				
				SetupGrabInteract(1, pBody, vFocusPos, "");
			}
		}
		
		// Break joint
		pJoint.Break();
		mbJointBroken = true;
	}
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	float GetJointFraction(iPhysicsJoint@ apJoint)
	{	
		if (mTearType == eTearType_Hinge)
		{
			return apJoint.GetAngle()/mfJointMax;
		}
		else 
		{
			return apJoint.GetDistance()/mfJointMax;
		}
	}
	
