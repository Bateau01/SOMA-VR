	[nosave] bool mbStressSoundAttemptFailed = false;
	
	//------------------------------------------------------------
	
	[nosave] bool mbGrab_UseCustomOffset;
	[nosave] cVector3f mvGrab_CostumPositionOffset;
	[nosave] cVector3f mvGrab_CostumRotationOffset;
	[nosave] bool mbGrab_UseCustomDepth;
	[nosave] float mfGrab_CustomDepth;
	[nosave] float mfGrab_MassMul;
	[nosave] float mfGrab_MinDepth;
	[nosave] float mfGrab_MaxDepth;
	[nosave] float mfGrab_ForceMul;
	[nosave] float mfGrab_TorqueMul;
	[nosave] bool mbGrab_IsHeavy;
	[nosave] bool mbGrab_CollisionWithPlayer;
	
	[nosave] tString msTear_Joint;
	[nosave] float mfTear_MoveMaxSpeed;
	[nosave] float mfTear_MoveSlowDownSpeed;
	[nosave] float mfTear_MoveSpeedFactor;
	[nosave] bool mbTear_LoseGripWhenTorn;
	[nosave] float mfTear_VelocityMulWhenTorn = 1.f;
	[nosave] float mfTear_HealthLossFactor;
	[nosave] float mfTear_MaxSnapBackSpeed;
	[nosave] float mfTear_MainBodyMassMul;
	[nosave] tString msTear_StressSound;
	
	//------------------------------------------------------------
	
	bool mbIsInteracting;
	bool mbUpdateForces = true;
	bool mbJointBroken = false;
	float mfJointMax;
	
	cPidControllerVec3 mTearPid;
	
	//cProp_Helper_Climbing mClimbHelper;
	
	//------------------------------------------------------------
	
	float mfMaxForce = 1000;
	
	//------------------------------------------------------------
}	
