		afStartY += 14;
		apSet.DrawFont(tWString("Joint Min:"+cMath_ToDeg(mpHingeJoint.GetMinAngle())+" Joint Max:"+cMath_ToDeg(mpHingeJoint.GetMaxAngle()) ), apFont, cVector3f(5,afStartY,0), cVector2f(14), cColor(1,1) );
		afStartY += 14;*/
		
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	[nosave] cPidControllerVec3 mRotatePid;

	[nosave] iPhysicsJointHinge @mpHingeJoint;
	[nosave] iPhysicsBody @mpWheelBody;
	
	//------------------------------------------------------------
	
	[nosave] float mfMoveMaxSpeed;
    [nosave] float mfMoveSlowDownFactor;
    [nosave] float mfMoveSpeedFactor;
    [nosave] bool mbCanInteractWithStaticBody;
    [nosave] float mfMinLimitRange;
    [nosave] float mfMaxLimitRange;
	[nosave] tString msMinLimitSound;
	[nosave] tString msMaxLimitSound;
	[nosave] tString msStuckSound;
	[nosave] bool mbSlowDownRotation;
	[nosave] bool mbSkipMiddleState;
	[nosave] bool mbIsOneHanded;
	
	//------------------------------------------------------------
	
	float mfMinLimit;
	float mfMaxLimit;
	bool mbMinLimitStuck;
	bool mbMaxLimitStuck;
	int mlSpinDir;
	bool mbInteractionDisablesStuck;
	
	//------------------------------------------------------------
	
	float mfAngle;
	float mfPrevAngle;

	float mfStuckSoundTimer;

	float mfLastToMax;
	float mfLastToMin;
	
	int mlCurrentState;
	int mlStuckState;

	float mfJointAngle;
	float mfPrevJointAngle;

	bool mbAutoMoving;
	float mfAutoMoveGoal;
	cUtility_JointFix mJointFix;
	
	//------------------------------------------------------------
		
}	