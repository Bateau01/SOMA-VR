	[nosave] iPhysicsBody@ mpMoveBody;
	[nosave] cVector3f mvOnPosOffset;
	[nosave] cQuaternion mqOnRotOffset;
	[nosave] cAnimationState@ mpAnimState;
	[nosave] float mfStateAmountOnSpeed;
	[nosave] float mfStateAmountOffSpeed;
	[nosave] bool mbHasInputDirection;
	[nosave] cVector2f mvInputDirectionToOn;
	[nosave] bool mbSimplePressInteraction;
	[nosave] eCrossHairState mCustomInteractIcon;
	[nosave] bool mbCanOnlyInteractWithMainBody;
	
	//------------------------------------------------------------
	
	cMatrixf m_mtxMoveBody;

	bool mbSwitchedOn;
	bool mbCanBeSwitchedOn;
	bool mbCanBeSwitchedOff;
	float mfStateAmount;
	float mfChangeStateAmount;
	float mfReturnToOffTime;
	float mfReturnToOffCount;
	
	bool mbLocked=false;
	bool mbDisabled=false;
	int mlBlinkCount=0;
		
	
	
	//------------------------------------------------------------
		
