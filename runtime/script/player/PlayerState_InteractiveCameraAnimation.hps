	//------------------------------------------------------------
	
	array<tString> mvNodes;
	bool mbExitOnLastNode;
	int mlPreviousState;
	
	tString msInteractCallback;
	cUtility_PickBasics mPickBasics;
	
	tID m_idAttachedEntity = tID_Invalid;
