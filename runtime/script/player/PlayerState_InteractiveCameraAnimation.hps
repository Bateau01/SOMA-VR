	bool mbAttachmentAlightPitch = false;
	bool mbAttachmentAlightRoll = false;
	
	////////////////////
	// Movement
	float mfDistanceMoved; // Total distance moved along spline
	float mfMovement; // Input converted to a movement multiplier where 1 is full forward speed and -1 is full reverse speed
	cVector3f mvCurrentMovementDir; // Input direction
	cVector3f mvGeneralMovementDir; // General input direction. Allows player to move the analog stick slightly without accidentally changing directions.
	float mfForwardSpeed;
	float mfBackSpeed;
	
	////////////////////
	// Rotation
	cMatrixf m_mtxCameraRotation;
	float mfPitch;
	float mfYaw;
	float mfMaxPitch;
	float mfMaxYaw;
