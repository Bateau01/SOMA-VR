	//------------------------------------------------------------
	
	float mfPitchMaxLimit;
	float mfPitchMinLimit;
	
	tString msVoiceCharacter;
	tString msFocusEntity;
	int mlHeadBoneIndex;
	cVector3f mvFocusPos;
	cVector3f mvFocusOffset;
	cVector3f mvStartFeetPos;
	float mfMaxMoveDist;
	
	float mfDirectLookCount;
	
	//------------------------------------------------------------
	
	bool mbResponseSelectionActive;
	float mfResponseAlpha;
	float mfResponseTimeCount;
	array<tWString> mvResponseOptions;
	int mlCurrentSelection;
	int mlNextSelection;
	int mlNextSelectionCount;
	
	array<cVector3f> mvReponseOptionAdd;
	array<eFontAlign> mvReponseOptionAlign;
	cVector3f mvInputPos;	
	bool mbResponseHasTimeLimit;
	
	tString msPositionArea;
	ePositionState mePositionState;
	float mfHeadBobCount=0.0f;
	cVector3f mvHeadBob;
	cVector3f mvLastPos;
	int mlFailedToMoveCount=0;
		
	//------------------------------------------------------------
		
}