	void CharBody_GravityCollide(iCharacterBody@ apCharBody, iPhysicsBody@ apBody, cCollideData @apCollideData)
	{
		
	}
	
	//------------------------------------------------------------
	
	void CharBody_HitGround(iCharacterBody@ apCharBody,const cVector3f &in avVel)
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPER METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	void SaveBodyProperties(iPhysicsBody @apBody)
	{
		
	}

	//-----------------------------------------------------------------------


	bool BodyIsAdded(iPhysicsBody @apBody)
	{
		return true;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// MEMBER VARIABLES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	tID mOpenPropID;
	
	float mfPrevDist = 1000;
	bool mbEnteringState;
	bool mbLeavingState;
	bool mbShowMouse = true;
	bool mbLockCamera = true;

	int mlDepthOfFieldID;
	
	float mfMoveSpeedMul;
	
	bool mbAllowCancel = true;
	bool mbGUIActiveOnTransitions = false;
	
	tString msHandAnimationSuffix;
	
	//////////////////////////////////////
	// Prop movement
	cMatrixf m_mtxOriginOrientation;
	float mfDistanceFromCamera;
	float mfYStartOffset;
	float mfStateTimer;
	cVector3f mvStartMovePos;
	cVector3f mvCamRelativeStart;
	
	//////////////////////////////////////
	// Sounds
	tString msCloseSound;
	
	//////////////////////////////////////
	// Callbacks
	tString msCloseCallback;
	
	//------------------------------------------------------------
		
}

