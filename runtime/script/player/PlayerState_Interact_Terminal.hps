#include "helpers/helper_modules.hps"
#include "player_types.hps"
#include "base/InputHandler_Types.hps"

// H5756N_DUALMODE_SCRIPT_GATE: fail closed to stock; MenuHandler owns the [nosave] session bit.
// H576BO_VR_FINGERTIP_TERMINAL: VR keeps the authored modal Terminal state but never snaps Simon/HMD to the screen.
bool _HPL3VR_RuntimeActive_TerminalState()
{
	cScript_SetGlobalReturnBool(false);
	cScript_RunGlobalFunc("MenuHandler", "cScrMenuHandler", "HPL3VR_GetRuntimeActive");
	return cScript_GetGlobalReturnBool();
}

/////////////////////////////////////////
// SETTINGS
/////////////////////////////////////////

//------------------------------------------------------------

const float gfHeadMoveAcc = 6.0f;
const float gfHeadMoveSpeed = 1.5f;
const float gfHeadMoveSlowdownDist = 0.3f;

const float gfHeadRotateAcc = 6.0f;
const float gfHeadRotateMaxSpeed = 1.5f;
const float gfHeadRotateSpeedMul = 2;

const float gfCheckMaxPushDist = 2.5f;
const float gfCheckPushDistTolerance = 0.1f;
const int glCheckMaxPushTries = 3;

//------------------------------------------------------------

class cScrPlayerState_Interact_Terminal : iScrPlayerState_Interact, iScrPlayerState_Interface
{
    [nosave] float mfVRNoTouchTime=0;
    [nosave] bool mbVRLeavePolicyChecked=false;
    [nosave] bool mbVRLeaveOwnsSequence=false;
    [nosave] bool mbVRCursorSaved=false;
    [nosave] bool mbVRCursorWasVisible=false;
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// USER SETTINGS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void LoadUserConfig()
	{
	
	}
	void SaveUserConfig()
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ENTER MAP
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
		mbVRLeavePolicyChecked=false;
		mfVRNoTouchTime=0;
	}
	void OnMapLeave(cLuxMap @apMap)
	{
		mbVRLeavePolicyChecked=false;
	}
	
	//------------------------------------------------------------
	
	void CreateWorldEntities(cLuxMap @apMap)
