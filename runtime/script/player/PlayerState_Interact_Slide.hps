// H5756N_DUALMODE_SCRIPT_GATE: fail closed to stock; MenuHandler owns the [nosave] session bit.
bool _HPL3VR_RuntimeActive_Slide()
{
	cScript_SetGlobalReturnBool(false);
	cScript_RunGlobalFunc("MenuHandler", "cScrMenuHandler", "HPL3VR_GetRuntimeActive");
	return cScript_GetGlobalReturnBool();
}

class cScrPlayerState_Interact_Slide : iScrPlayerState_Interact, iScrPlayerState_Interface 
{ 
 //------------------------------------------------------------ 
  
 ///////////////////////////////////////// 
 // INIT 
 ///////////////////////////////////////// 
  
 //------------------------------------------------------------ 
  
 void Init() 
 { 
  mfMoveToMouseAddFactor = 1.0f; 
  mfMaxForce = 1000.0f; 
 
  mForcePid.SetErrorNum(10);; 
  mForcePid.p = 6; 
  mForcePid.i = 0; 
  mForcePid.d = 0.1f; 
 } 
  
