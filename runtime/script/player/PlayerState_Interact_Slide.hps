 //------------------------------------------------------------ 
  
 cPidControllerVec3 mForcePid; 
 tID mCurrentJointID; 
  
 //------------------------------------------------------------ 
  
 float mfSlideMaxSpeed; 
 float mfSlideSlowDownFactor; 
 float mfSlideSpeedFactor; 
 tString msLockedSound; 
 tString msGrabStartSound; 
 tString msGrabEndSound; 
 float mfSlidePadMultiplier = 1.0f; 
  
 //------------------------------------------------------------ 
  
 bool mbHasGravity; 
 
 float mfMaxFocusPosDistance; 
 cVector3f mvLocalInteractPos; 
  
 float mfMaxStartPosDistance; 
 cVector3f mvStartInteractPos; 
 
 cVector2f mvMoveAdd; 
 cVector2f mvLastMouseAdd; 
 cVector3f mvLastForce; 
 
 float mfSlideSpeed; 
 bool mbHPL3VRDirectSpeed;
 bool mbHPL3VRTrackedSlide=false;
 float mfHPL3VRDirectSpeed;
 
 float mfMoveToMouseAddFactor; 
 float mfMaxForce; 
  
 bool mbLocked; 
 float mfLockedSoundCount; 
  
 //------------------------------------------------------------ 
   
