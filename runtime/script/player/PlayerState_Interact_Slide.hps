 float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY) 
 { 
  apSet.DrawFont(tWString("SlideSpeed:"+mfSlideSpeed+" MoveAdd"+mvMoveAdd), apFont, cVector3f(5,afStartY,0), cVector2f(14), cColor(1,1) ); 
  afStartY += 14; 
       
  return afStartY; 
 } 
  
