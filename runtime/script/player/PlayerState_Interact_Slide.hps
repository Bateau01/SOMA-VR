 //------------------------------------------------------------ 
  
 bool OnAction(int alAction, bool abPressed) 
 { 
  return true; 
 } 
  
 //------------------------------------------------------------ 
  
 bool OnAnalogInput(int alAnalogId, const cVector3f &in avAmount) 
 { 
 	if (!_HPL3VR_RuntimeActive_Slide())
 	{
 			///////////////////////////////////
 			// Looking
 			if(alAnalogId == eAnalogType_Look)
 			{	
 				cVector2f vAmount(avAmount.x, avAmount.y);
 				if(cLux_GetInputHandler().IsYAxisInverted()) vAmount.y = -vAmount.y;
 				if (cLux_GetInputHandler().WasAnalogueInputFromPad())
 					vAmount*=mfSlidePadMultiplier;
 				mvMoveAdd += vAmount;
 				
 				return false;
 			}
 			///////////////////////////////////
 			// Moving
 			else if(alAnalogId == eAnalogType_Move || alAnalogId == eAnalogType_GamepadMove)
 			{
 				if (avAmount.SqrLength() < 0.01) return true;
 				
 				cVector2f vAmount(avAmount.x, avAmount.y*-1);
 				mvMoveAdd += vAmount * mfMoveToMouseAddFactor;
 				return true;
 			}
 			
 			return true;
 	}
  /////////////////////////////////// 
  // Looking 
  if(alAnalogId == eAnalogType_Look) 
  {  
   if(avAmount.z > 5754.5f && avAmount.z < 5755.5f)
   {
    mfHPL3VRDirectSpeed = avAmount.x;
    mbHPL3VRDirectSpeed = true;
    mbHPL3VRTrackedSlide = true;
    return false;
   }
   cVector2f vAmount(avAmount.x, avAmount.y); 
   if(cLux_GetInputHandler().IsYAxisInverted()) vAmount.y = -vAmount.y; 
   if (cLux_GetInputHandler().WasAnalogueInputFromPad()) 
    vAmount*=mfSlidePadMultiplier; 
   mvMoveAdd += vAmount; 
    
   return false; 
  } 
  /////////////////////////////////// 
  // Moving 
  else if(alAnalogId == eAnalogType_Move || alAnalogId == eAnalogType_GamepadMove) 
  { 
   return true; // S26CE: locomotion is not drawer drag input. 
  } 
   
  return true; 
 } 
  
