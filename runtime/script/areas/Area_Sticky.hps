	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	/////////////////////////
	// Data
	tString msAttachFunction;
	tString msDetachFunction;

	tString msAttachSound;
	tString msDetachSound;

	tString msAttachPS;
	tString msDetachPS;
	
	[nosave] array<tString> mvsAttachableBodyNames;

	bool mbMoveBody;
	bool mbRotateBody;

	bool mbCheckCenterInArea;

	bool mbCanDetach;
	bool mbRequiresInteraction;

	float mfPoseTime;
	
	bool mbSpringy_Active;
	float mfSpringy_DetachDistanceMul;
	float mfSpringy_ForceMul;
	float mfSpringy_ReleaseTime;
	tString msSpringy_DetachLoopSound;

	/////////////////////////
	// Variables
	bool mbAttachedBodyGravity;
	float mfAttachedBodyMass;

	bool mbAttachedEntityFullGameSaved;

	tID mAttachedBodyID;
	tID mLastAttachedBodyID;
	
	tID m_idSpringyLoopSound;

	float mfSetMtxTime;
	cMatrixf m_mtxAttachedStart;
	
	bool mbLastAttachedInside;
	
	bool mbSpringyInProgress;
	bool mbSpringyAttach=false;
	float mfSpringyReleaseCount;
	cVector3f mvSpringyNoMovePostion;

	//------------------------------------------------------------
		
}	
