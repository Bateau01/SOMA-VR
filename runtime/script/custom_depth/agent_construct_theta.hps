	//------------------------------------------------------------
	
	bool DoDamage()
	{
		mBaseObj.DoDamageBox(cVector3f(1, 1, 1), cVector3f(0,0, 1.5f), mvMinMaxDamage, 100, 2, eDamageType_Hit);
		
		return Player_WasDamaged();
	}
	
