	/////////////////////////////////////////
	// CUSTOM
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void MoveTo(const cVector3f&in avPos, const tString&in asResultCallback="")
	{
		mpMover.SetUseMoveStateAnimations(true);
		mpPathfinder.MoveTo(avPos, 1.0f, true, asResultCallback, false);
	}
	
	//------------------------------------------------------------
		
	void MoveToNode(const tString& in asNodeName, const tString& in asCallbackFunc, const tString& in asResultCallback="")
	{
		mpMover.SetUseMoveStateAnimations(true);
		mpPathfinder.MoveToNode(asNodeName, 1.0f, true, asResultCallback, false);
		mpPathfinder.SetEndOfPathCallbackFunc(asCallbackFunc);
	}
	
	//------------------------------------------------------------
	
	void _Global_MoveToNode()
	{
		MoveToNode(cScript_GetGlobalArgString(0), cScript_GetGlobalArgString(1));
	}
	
	//------------------------------------------------------------
	
	void _Global_SetupPatrol()
	{
		mbPatrolLoop = cScript_GetGlobalArgBool(0);
		msPatrolOverCallback = cScript_GetGlobalArgString(1);
	}
	
	//------------------------------------------------------------
	
	void _Global_StartPatrol()
	{		
		if (mpStateMachine.GetCurrentState() != eThetaConstructState_Patrol)
			mpStateMachine.ChangeState(eThetaConstructState_Patrol);	
		else
			mpPathfinder.StartTrack(mbPatrolLoop, 1.0f, msPatrolOverCallback);
	}
	
	//------------------------------------------------------------
	
	float mfTargetEffectFactor;

	void UpdateProximityEffects(float afTimeStep)
	{
		///////////////////////////////////////
		// Get min and max effect distances
		float fMinDist = gfEffectMinDistanceNormal;
		float fMaxDist = gfEffectMaxDistanceNormal;
		
		if (mBaseObj.PlayerIsDetected())
		{
			fMinDist = gfEffectMinDistanceAlert;
			fMaxDist = gfEffectMaxDistanceAlert;
		}
		
		///////////////////////////////////////
		// Check if outside effect area
		float fPlayerDist = mBaseObj.GetDistanceToPlayer();
		if (fPlayerDist > fMaxDist)
		{
			return;
		}
		
		///////////////////////////////////////
		// Calculate effect intensity
		float fDistanceFraction = (fPlayerDist-fMinDist)/(fMaxDist-fMinDist);
		float fTargetEffectFactor = cMath_Clamp(1.f - fDistanceFraction, 0, 1.f);
		
		// Decrease effect if something is obstructing
		mfTargetEffectFactor = fTargetEffectFactor;
		mBaseObj.GetEntityIsInPlayerLineOfSight("ProximityEffects_InView", false);
	}

	void ProximityEffects_InView(bool abInView)
	{
		// Decrease effect if something is obstructing
		if (abInView == false) mfTargetEffectFactor *= gfEffectObstructionFactor;
		
	}
	
	//------------------------------------------------------------
	
	void _Global_SetProximityEffectsActive()
	{
		bool bState = cScript_GetGlobalArgBool(0);
		
		mbProximityEffectActive = bState;
	}
	
