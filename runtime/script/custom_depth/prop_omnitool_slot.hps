#include "helpers/helper_vr_guidance_hr.hps"
#include "Prop_Rigid.hps"
#include "helpers/helper_props.hps"
#include "helpers/helper_player.hps"
#include "helpers/helper_map.hps"

#include "helper_custom_depth_audio.hps"

// H5756N_DUALMODE_SCRIPT_GATE: fail closed to stock; MenuHandler owns the [nosave] session bit.
bool _HPL3VR_RuntimeActive_OmniSlot()
{
	cScript_SetGlobalReturnBool(false);
	cScript_RunGlobalFunc("MenuHandler", "cScrMenuHandler", "HPL3VR_GetRuntimeActive");
	return cScript_GetGlobalReturnBool();
}

const cColor gReadyColor = cColor(1, 0.5, 0);
const cColor gAttachedColor = cColor_Green;
const cColor gDetachColor = cColor_Red;

// H5756D_VR_OMNITOOL_PHYSICAL_DOCK
class cScrPropOmniSlot : cScrPropRigid
{
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		if (!_HPL3VR_RuntimeActive_OmniSlot())
		{
				cScrPropRigid::SetupAfterLoad(apWorld, apVars, apInstanceVars);
				
				mvSlotPosOffset = apVars.GetVarVector3f("SlotPositionOffset", 0);
				
				msOnLamp = apInstanceVars.GetVarString("OnLamp", "");
				msOffLamp = apInstanceVars.GetVarString("OffLamp", "");
				mBaseObj.SetVarString("Setup_AttachedTool", apInstanceVars.GetVarString("AttachedTool", ""));
				mBaseObj.SetVarBool("Setup_DetachAllowed", apInstanceVars.GetVarBool("DetachAllowed", false));
				mbAttachAllowed = apInstanceVars.GetVarBool("AttachAllowed", true);
				
				mBaseObj.SetVariableUpdateRate(0.2f); //call variable update no faster than once per 0.2 sec
				mBaseObj.SetAutoSleep(false);
				
				mBaseObj.SetVarBool("IsOmniSlot", true);
			return;
		}
		cScrPropRigid::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		
		mvSlotPosOffset = apVars.GetVarVector3f("SlotPositionOffset", 0);
		
		msOnLamp = apInstanceVars.GetVarString("OnLamp", "");
		msOffLamp = apInstanceVars.GetVarString("OffLamp", "");
		mBaseObj.SetVarString("Setup_AttachedTool", apInstanceVars.GetVarString("AttachedTool", ""));
		mBaseObj.SetVarBool("Setup_DetachAllowed", apInstanceVars.GetVarBool("DetachAllowed", false));
		mbAttachAllowed = apInstanceVars.GetVarBool("AttachAllowed", true);
		
		mBaseObj.SetVariableUpdateRate(0.0333f); // VR physical docking pose gate; no native scan/proximity authority
		mBaseObj.SetAutoSleep(false);
		
		mBaseObj.SetVarBool("IsOmniSlot", true);
	}
	
	//------------------------------------------------------------
	
	bool mbFirstUpdate = true;
	void OnUpdate(float afTimeStep)
	{
		if (!_HPL3VR_RuntimeActive_OmniSlot())
		{
                mVRGuide.Hide();
				if (!mbFirstUpdate) return;
				
				mbFirstUpdate = false;
				tString sAttachedTool = mBaseObj.GetVarString("Setup_AttachedTool");
				
				if (sAttachedTool=="")
				{
					SetAttachAllowed(mbAttachAllowed, false);
					return;
				}
				
				InsertTool(sAttachedTool, false);
				if (mBaseObj.GetVarBool("Setup_DetachAllowed"))
				{
					AllowDetach(sAttachedTool, false);
				}
			return;
		}
		if (mbFirstUpdate)
		{
			mbFirstUpdate = false;
			tString sAttachedTool = mBaseObj.GetVarString("Setup_AttachedTool");
			if (sAttachedTool=="")
			{
				SetAttachAllowed(mbAttachAllowed, false);
			}
			else
			{
				InsertTool(sAttachedTool, false);
				if (mBaseObj.GetVarBool("Setup_DetachAllowed")) AllowDetach(sAttachedTool, false);
			}
		}
		if(mfVRDockRetry>0) mfVRDockRetry-=afTimeStep;
		VR_UpdatePhysicalDock();
        VR_UpdateGuide(afTimeStep);
	}
	
	//------------------------------------------------------------
	
    [nosave] cVRGuideMesh mVRGuide;
    [nosave] float mfVRGuidePoll=0;
    void BeforeEntityDestruction(){mVRGuide.Dispose(mBaseObj.GetMap().GetWorld());}
    void VR_UpdateGuide(float dt)
    {
        if(!cLux_GetUserConfig().GetBool("SOMA_VR","InteractionGuides",true) ||
           !cScript_RunGlobalFunc("VRGUIDE","","ACTIVE")){mVRGuide.Hide();return;}
        mfVRGuidePoll-=dt;if(mfVRGuidePoll>0)return;mfVRGuidePoll=.125f;
        mVRGuide.Hide();
        if(mbVRDockCaptureLatched || mbVRDockAwaitExit || (!mbAttachAllowed && !VR_IsLambdaLifeboatSlot()))return;
        cScript_RunGlobalFunc("PlayerToolHandler","","_Global_VRGetCanonicalOmniName");
        cLuxProp@ tool=Map_GetProp(cScript_GetGlobalReturnString());
        if(tool is null || tool.GetMeshEntity() is null)return;
        cMatrixf target=VR_GetToolTargetMatrix(tool);
        if(cMath_Vector3Dist(tool.GetMatrix().GetTranslation(),target.GetTranslation())>2.0f)return;
        cScript_SetGlobalArgString(0,mBaseObj.GetName());cScript_SetGlobalReturnBool(false);
        cScript_RunGlobalFunc("PlayerToolHandler","","_Global_VRCanGuideOmniSlot");
        if(!cScript_GetGlobalReturnBool())return;
        tString file=cString_GetFileName(tool.GetFileName());
        // Verified campaign carrier meshes. HUD and unknown/custom models fail closed.
        if(file!="omnitool.ent" && file!="omnitool_with_securitychip.ent" &&
           file!="omnitool_with_cortexchip.ent" && file!="omnitool_with_securitychip_cortexchip.ent")return;
        tString meshFile="entities/station/gameplay/omnitool/"+cString_SetFileExt(file,"dae");
        // Rigid Lux props attach submeshes to their body. The cMeshEntity
        // container can remain at identity, even while the held tool moves.
        if(tool.GetMeshEntity().GetSubMeshEntityNum()==0)return;
        cMatrixf relative=cMath_MatrixMul(cMath_MatrixInverse(tool.GetMatrix()),tool.GetMeshEntity().GetSubMeshEntity(0).GetWorldMatrix());
        mVRGuide.Show(mBaseObj.GetMap().GetWorld(),"VRGuide_"+mBaseObj.GetName(),meshFile,cMath_MatrixMul(target,relative));
    }

    // Read-only bridge for the cortex-chip guide; reuse insertion geometry.
    void _Global_VRGuidePlacement()
    {
        // The global return is a single typed value: writing a success bool
        // after this matrix would replace it. RunGlobalFunc reports dispatch.
        cScript_SetGlobalReturnMatrix(cMatrixf_Identity);
        cLuxProp@ tool=Map_GetProp(cScript_GetGlobalArgString(0));
        if(tool is null || tool.GetBodyNum()==0)return;
        cScript_SetGlobalReturnMatrix(VR_GetToolTargetMatrix(tool));
    }

	cMatrixf VR_GetToolTargetMatrix(cLuxProp@ apTool)
	{
		cMatrixf offsetMtx = apTool.GetBodyExtraData(0).m_mtxLocalTransform;
		cMatrixf mtxTarget = cMath_MatrixTranslate(mvSlotPosOffset);
		mtxTarget = cMath_MatrixMul(mBaseObj.GetMatrix(), mtxTarget);
		mtxTarget = cMath_MatrixMul(mtxTarget, cMath_MatrixRotateX(cMath_PiDiv2));
		cVector3f vWorldOffset = cMath_MatrixMul(mtxTarget.GetRotation(), offsetMtx.GetTranslation());
		mtxTarget.SetTranslation(mtxTarget.GetTranslation()+vWorldOffset);
		return mtxTarget;
	}

    bool VR_IsLambdaLifeboatSlot()
    {
        if (mBaseObj.GetName() != "OmniToolSlotLifeBoat") return false;
        cLuxMap@ map = cLux_GetCurrentMap();
        return map !is null && map.GetName() == "02_01_ms_curie_outside";
    }

	void VR_UpdatePhysicalDock()
	{
        // S26GV: preserve the pre-GU gate for every other map/slot.
        if (!mbAttachAllowed && !VR_IsLambdaLifeboatSlot())
        { mbVRDockCaptureLatched = false; return; }
		cScript_RunGlobalFunc("PlayerToolHandler", "", "_Global_VRGetCanonicalOmniName");
		tString sTool = cScript_GetGlobalReturnString();
		if (sTool == "") { mbVRDockCaptureLatched = false; return; }
		cLuxProp@ pTool = Map_GetProp(sTool);
		if (pTool is null) { mbVRDockCaptureLatched = false; return; }
		iPhysicsBody@ pBody = pTool.GetMainBody();
		if (pBody is null || pBody.GetMass() <= 0.01f) { mbVRDockCaptureLatched = false; return; }

		cMatrixf mtxTarget = VR_GetToolTargetMatrix(pTool);
		cMatrixf mtxTool = pTool.GetMatrix();
		float fDist = cMath_Vector3Dist(mtxTool.GetTranslation(), mtxTarget.GetTranslation());
        // Ejection must not immediately redock a tool as the player retrieves it.
        // Preserve this across missing canonical carriers and save/load; require
        // physical withdrawal, not merely rotating the tool inside the socket.
        if (VR_IsLambdaLifeboatSlot() && mbVRDockAwaitExit)
        {
            if (fDist <= 0.12f) return;
            mbVRDockAwaitExit = false;
            mbVRDockCaptureLatched = false;
        }
		float fForward = cMath_Vector3Dot(mtxTool.GetForward(), mtxTarget.GetForward());
		float fUp = cMath_Vector3Dot(mtxTool.GetUp(), mtxTarget.GetUp());
		bool bCaptured = fDist <= 0.08f && fForward >= 0.80f && fUp >= 0.80f;
		if (!bCaptured) { mbVRDockCaptureLatched = false; return; }
		if (mbVRDockCaptureLatched || mfVRDockRetry>0) return;
		mfVRDockRetry=0.10f;

		// K is telemetry/intent only. The map's exact stored UseCallback still decides
		// whether insertion succeeds, and Catherine I is the only commit state.
		cScript_RunGlobalFunc("VROMNIDOCK", mBaseObj.GetName(), "K");
		cScript_SetGlobalArgString(0, mBaseObj.GetName());
		cScript_RunGlobalFunc("PlayerToolHandler", "", "_Global_VRPhysicalOmniUseSlot");
		mbVRDockCaptureLatched=cScript_GetGlobalReturnBool();
	}

	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////

	//-------------------------------------------------------
	
	void _Global_SetAttachAllowed()
	{
		SetAttachAllowed(cScript_GetGlobalArgBool(0), cScript_GetGlobalArgBool(1));
	}
	
	//------------------------------------------------------------
	
	void SetAttachAllowed(bool abState, bool abEffects)
	{
		if (msOffLamp != "") 
		{
			Entity_SetEffectBaseColor(msOffLamp, abState ? gReadyColor : gDetachColor);
			Lamp_SetLit(msOffLamp, abState, abEffects);
			Lamp_SetFlickerActive(msOffLamp, abState);
		}
		
		if (msOnLamp != "") 
			Lamp_SetLit(msOnLamp, false, abEffects);
		
		mbAttachAllowed = abState;
	}
	
	//------------------------------------------------------------
	
	void _Global_GetAttachAllowed()
	{
		cScript_SetGlobalReturnBool(mbAttachAllowed);
	}
	
	//------------------------------------------------------------
	
	void _Global_Insert()
	{
		InsertTool(cScript_GetGlobalArgString(0), cScript_GetGlobalArgBool(1));
	}

	//-------------------------------------------------------
	
	void InsertTool(const tString &in asTool, bool abEffects)
	{
		if (!_HPL3VR_RuntimeActive_OmniSlot())
		{
				cLuxProp@ pTool = Map_GetProp(asTool);
					
				cMatrixf offsetMtx = pTool.GetBodyExtraData(0).m_mtxLocalTransform;
				
				// Rotate and place tool
				cMatrixf mtx_orientation = cMath_MatrixTranslate(mvSlotPosOffset);
				mtx_orientation = cMath_MatrixMul(mBaseObj.GetMatrix(), mtx_orientation);
				mtx_orientation = cMath_MatrixMul(mtx_orientation, cMath_MatrixRotateX(cMath_PiDiv2));
				
				cVector3f vWorldOffset = cMath_MatrixMul(mtx_orientation.GetRotation(), offsetMtx.GetTranslation());
				mtx_orientation.SetTranslation(mtx_orientation.GetTranslation()+vWorldOffset);
				pTool.SetMatrix(mtx_orientation);
				
				if (abEffects) Depth_Audio_Omnitool_Insert(asTool);
				
				tString sName = mBaseObj.GetName();
				cScript_SetGlobalArgString(0, sName);
				cScript_RunGlobalFunc(asTool, "cScrPropCatherineTool", "Insert");
				
				if (msOffLamp != "")
					Lamp_SetLit(msOffLamp, false, abEffects);
				
				if (msOnLamp != "")
				{
					Entity_SetEffectBaseColor(msOnLamp, gAttachedColor);
					Lamp_SetLit(msOnLamp, true, abEffects);
				}
			return;
		}
		cLuxProp@ pTool = Map_GetProp(asTool);
			
		// Rotate/place through the exact same authored target used by the VR pose gate.
		pTool.SetMatrix(VR_GetToolTargetMatrix(pTool));
		
		if (abEffects) Depth_Audio_Omnitool_Insert(asTool);
		
		tString sName = mBaseObj.GetName();
		cScript_SetGlobalArgString(0, sName);
		cScript_RunGlobalFunc(asTool, "cScrPropCatherineTool", "Insert");
		
		if (msOffLamp != "")
			Lamp_SetLit(msOffLamp, false, abEffects);
		
		if (msOnLamp != "")
		{
			Entity_SetEffectBaseColor(msOnLamp, gAttachedColor);
			Lamp_SetLit(msOnLamp, true, abEffects);
		}
	}

	//-------------------------------------------------------
	
	void _Global_AllowDetach()
	{
		AllowDetach(cScript_GetGlobalArgString(0), cScript_GetGlobalArgBool(1));
	}

	//------------------------------------------------------------
	
	void AllowDetach(const tString &in asTool, bool abEffects)
	{		
        if (_HPL3VR_RuntimeActive_OmniSlot() && VR_IsLambdaLifeboatSlot()) mbVRDockAwaitExit = true;
		if (abEffects) Depth_Audio_Omnitool_Popout(asTool);
		
		cScript_RunGlobalFunc(asTool, "cScrPropCatherineTool", "Detach");
		
		if (msOffLamp != "")
		{
			Entity_SetEffectBaseColor(msOffLamp, gDetachColor);
			Lamp_SetLit(msOffLamp, true, abEffects);
			Lamp_SetFlickerActive(msOffLamp, true);
		}
		
		if (msOnLamp != "")
			Lamp_SetLit(msOnLamp, false, abEffects);
	}

	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	cVector3f mvSlotPosOffset;
	
	tString msOnLamp;
	tString msOffLamp;
	
	bool mbAttachAllowed = true;
    bool mbVRDockAwaitExit = false; // saved withdrawal requirement after ejection
	[nosave] bool mbVRDockCaptureLatched = false;
	[nosave] float mfVRDockRetry=0;
}

