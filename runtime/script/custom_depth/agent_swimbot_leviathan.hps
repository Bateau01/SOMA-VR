	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afY)
	{
		afY = cLux_DrawDebugText("Speed: "+mBaseObj.GetCharBody().GetVelocity(cEngine_GetStepSize()).Length(), afY);
		afY = cLux_DrawDebugText("PlayerIsDetected: "+mBaseObj.PlayerIsDetected(), afY);
		afY = cLux_DrawDebugText("PlayerIsInTheOpen: "+mbPlayerIsInTheOpen, afY);
		afY = cLux_DrawDebugText("HuntBuildUpCount: "+mfCirclePlayer_HuntBuildUpCount + " / "+mfCirclePlayer_HuntBuildUpMax, afY);
		afY = cLux_DrawDebugText("RetreatingCount: "+mfCirclePlayer_RetreatingCount, afY);
		afY = cLux_DrawDebugText("DistToPlayer: "+mBaseObj.GetDistanceToPlayer(), afY);
		
		if (cLux_GetExplorationModeActive())
		{
			afY = cLux_DrawDebugText("ExplorationMode_KnockAwayCooldown: " + mfExplorationMode_KnockAwayCooldown, afY);
		}
		
		return afY;
	}
	
	//------------------------------------------------------------
	
	void OnRenderSolid(cRendererCallbackFunctions@ apFunctions)
	{
		cVector3f vTopPos = mvCirclePlayer_GroundPos;
		vTopPos.y = mfCirclePlayer_WantedHeight;
		
		apFunctions.GetLowLevelGfx().DrawLine(mvCirclePlayer_GroundPos, vTopPos, cColor(5,0,5,1));
		apFunctions.GetLowLevelGfx().DrawSphere(mvCirclePlayer_GroundPos, 0.4f, cColor(5,0,5,1));
		apFunctions.GetLowLevelGfx().DrawSphere(vTopPos, 0.4f, cColor(5,0,5,1));
		
		apFunctions.GetLowLevelGfx().DrawSphere(mvHunt_GoalPosition, 0.6f, cColor(5,5,0,1));
	}
	
