enum eLeviathanState
{
	eLeviathanState_FollowTrack,
	eLeviathanState_CirclePlayer,
	eLeviathanState_Hunt,
}

enum eLeviathanSpeed
{
	eLeviathanSpeed_Normal,
	eLeviathanSpeed_CircleSlow,
	eLeviathanSpeed_CircleNormal,
	eLeviathanSpeed_CircleFast,
	eLeviathanSpeed_CircleCatchUp,
	eLeviathanSpeed_Hunt,
	eLeviathanSpeed_HuntDash,
}

enum eLeviathanBark
{
	eLeviathanBark_Search,
	eLeviathanBark_Hunt,
	eLeviathanBark_HuntIntense,
}
	
