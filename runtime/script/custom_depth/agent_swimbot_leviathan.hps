	/////////////////////////////////////////
	// GLOBAL
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_InitSilent()
	{
		mpBarkMachine.SetActive(false);
		msLoopSound_Idle = "";
		msLoopSound_Move = "";
	}
	
	//------------------------------------------------------------
	
	void _Global_SetFollowTrackDeathMeter()
	{
		mbFollowTrackDeathMeter = cScript_GetGlobalArgBool(0);
		float fDamage = cScript_GetGlobalArgFloat(1);
		
		if(mbFollowTrackDeathMeter)
		{
			AttackMeter_AddInstance(mBaseObj.GetID(), 9, 4.3f, fDamage, true, true, true);
			SetHuntDistortion();
		}
		else
		{
			AttackMeter_RemoveInstance(mBaseObj.GetID());
			SetDefaultDistortion();
		}
	}
	
	//------------------------------------------------------------
	
	void _Global_SetState_FollowTrack()
	{
		Music_RemoveDynamicTrack(mBaseObj.GetID());
			
		mpStateMachine.ChangeState(eLeviathanState_FollowTrack);
	}
	
	void _Global_SetState_CirclePlayer()
	{
		mpStateMachine.ChangeState(eLeviathanState_CirclePlayer);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetSpeed_Normal()
	{
		mpMover.SetSpeedState(eLeviathanSpeed_Normal);
	}
	
	void _Global_SetSpeed_Hunt()
	{
		mpMover.SetSpeedState(eLeviathanSpeed_Hunt);
	}
	
	void _Global_SetSpeed_CircleFast()
	{
		mpMover.SetSpeedState(eLeviathanSpeed_CircleFast);
	}
	
	void _Global_SetSpeed_HuntDash()
	{
		mpMover.SetSpeedState(eLeviathanSpeed_HuntDash);
	}
	//------------------------------------------------------------
	
	void _Global_SetLightBrightness()
	{
		mfLightBrightness = cScript_GetGlobalArgFloat(0);
	}
	
