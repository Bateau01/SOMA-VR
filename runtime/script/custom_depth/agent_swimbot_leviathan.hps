const tString gsMoveLoopSound = "NPC_Creatures/Foley/Underwater/Leviathan/moving";
const tString gsIdleLoopSound = "";
const float gfMoveLoopSoundMinSpeed =0;

const tString gsBarkSearch_Sound ="NPC_Creatures/Vocalisations/Underwater/Leviathan/search";
const float gfBarkSearch_MinTime=7;
const float gfBarkSearch_MaxTime=12;

const tString gsBarkHunt_Sound ="NPC_Creatures/Vocalisations/Underwater/Leviathan/hunt";
const float gfBarkHunt_MinTime=6;
const float gfBarkHunt_MaxTime=12;

const tString gsBarkHuntIntense_Sound ="NPC_Creatures/Vocalisations/Underwater/Leviathan/hunt_intense";
const float gfBarkHuntIntense_MinTime=6;
const float gfBarkHuntIntense_MaxTime=12;

const tString gfHuntBuildUpStartScream="";
const tString gfHuntStartScream="";

const tString gsCaptureStartSound = "NPC_Creatures/Foley/Underwater/Leviathan/capture/capture_start";
const tString gsCaptureLoopSound = "NPC_Creatures/Foley/Underwater/Leviathan/capture/capture_loop";
const tString gsCaptureEndSound = "NPC_Creatures/Foley/Underwater/Leviathan/capture/capture_end";

//}ENDBARKS
//-------------------------------------------------------
//Music for chase to be triggered in-game
const tString gsMusic_HuntBuildUp ="NPC_Creature_Attack";
const float gfMusic_HuntBuildUpVolume = 0.75f;

const tString gsMusic_Hunt ="NPC_creature_attack_brutal";
const float gfMusic_HuntVolume = 0.75f;

//-------------------------------------------------------


class cScrAgentLeviathan : cScrAgentSwimBot
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		cScrAgentSwimBot::Init();
		
		mBaseObj.SetUpdatePlayerDetection(true);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	//{//////////////////////////////////////
	
	
	//------------------------------------------------------------
	
	void SetupCharBody()
	{ 
		cScrAgentSwimBot::SetupCharBody();
		
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		pCharBody.SetMass(300);
		
		pCharBody.SetMaxPositiveMoveSpeed(eCharDir_Forward,1.55f);
		pCharBody.SetMoveAcc(eCharDir_Forward,2.3f);
		pCharBody.SetMoveDeacc(eCharDir_Forward,5.3);
		pCharBody.SetMoveOppositeDirAccMul(eCharDir_Forward,1);
		pCharBody.SetTestCollision(false);
		pCharBody.SetCollideCharacter(false);
		pCharBody.SetEntityPitchAmount(0.7f);
	}
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld,  cResourceVarsObject@ apVars,  cResourceVarsObject@ apInstanceVars)
	{
		cScrAgentSwimBot::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		
		/////////////////////////////////
		// Genral Setup
		mBaseObj.SetFOV(cMath_ToRad(230.0f));
		mBaseObj.SetSightRange(40);
		
		msLoopSound_Move = gsMoveLoopSound;
		msLoopSound_Idle = gsIdleLoopSound;
		mfLoopSoundMinMoveSpeed = gfMoveLoopSoundMinSpeed;
		mbBubbleEffectsActive = false;
		
		mpForceEmitter.SetActive(true);
		mpForceEmitter.SetRadius(4.4f);
		
		/////////////////////////////////
		// Mover
		mpMover.SetWallAvoidanceActive(true);
		mpMover.SetupWallAvoidance(4.75f, 12.0f, 8);
		mpMover.SetDynamicObjectAvoidanceActive(false);
		
		mpMover.SetWalkAnimName("swim");
		mpMover.SetMoveSpeedAnimMul(0.35);
		
				
		mpMover.SetStoppedToWalkSpeed(0.05);
		mpMover.SetWalkToStoppedSpeed(0.025);
		mpMover.SetWalkToRunSpeed(300);
		mpMover.SetRunToWalkSpeed(300);
		
		mpMover.SetTurnMinBreakAngle(cMath_ToRad(30) );
		mpMover.SetTurnBreakMul(0);
		mpMover.SetTurnSpeedMul(0.5);
		mpMover.SetTurnMaxSpeed(1.5);
		
		mpMover.SetBankingAngleMul(0.05);
		mpMover.SetBankingMaxAngle(cMath_ToRad(35));
		mpMover.SetBankingSpeedMul(2.0f);
		mpMover.SetBankingMaxSpeed(0.3f);
		
		/////////////////////////////////
		// Speed States
		mpMover.AddSpeedState(eLeviathanSpeed_Normal);
		mpMover.SetSpeedState_Forward(2.5f);
		mpMover.SetSpeedState_ForwardAcc(1.3f);
		mpMover.SetSpeedState_TurnSpeedMul(2.5f);
		mpMover.SetSpeedState_TurnMaxSpeed(5.0f);
		
		mpMover.AddSpeedState(eLeviathanSpeed_CircleSlow);
		mpMover.SetSpeedState_Forward(2.5f);
		mpMover.SetSpeedState_ForwardAcc(1.3f);
		mpMover.SetSpeedState_ForwardDeacc(1.5f);
		
		mpMover.AddSpeedState(eLeviathanSpeed_CircleNormal);
		mpMover.SetSpeedState_Forward(4.5f);
		mpMover.SetSpeedState_ForwardAcc(1.3f);
		mpMover.SetSpeedState_ForwardDeacc(1.5f);
		
		mpMover.AddSpeedState(eLeviathanSpeed_CircleFast);
		mpMover.SetSpeedState_Forward(6.0f);
		mpMover.SetSpeedState_ForwardAcc(1.3f);
		mpMover.SetSpeedState_ForwardDeacc(2.3f);
		
		mpMover.AddSpeedState(eLeviathanSpeed_CircleCatchUp);
		mpMover.SetSpeedState_Forward(12.0f);
		mpMover.SetSpeedState_ForwardAcc(5.3f);
				
		mpMover.AddSpeedState(eLeviathanSpeed_Hunt);
		mpMover.SetSpeedState_Forward(5.75);
		mpMover.SetSpeedState_ForwardAcc(5.3f);
		mpMover.SetSpeedState_TurnSpeedMul(2.5f);
		mpMover.SetSpeedState_TurnMaxSpeed(5.0f);
		
		mpMover.AddSpeedState(eLeviathanSpeed_HuntDash);
		mpMover.SetSpeedState_Forward(9.75);
		mpMover.SetSpeedState_ForwardAcc(5.3f);
		mpMover.SetSpeedState_TurnSpeedMul(3.5f);
		mpMover.SetSpeedState_TurnMaxSpeed(7.0f);
				
		/////////////////////////////////
		// States
		mpStateMachine.AddState("CirclePlayer", eLeviathanState_CirclePlayer);
		mpStateMachine.AddState("Hunt", eLeviathanState_Hunt);
		mpStateMachine.AddState("FollowTrack", eLeviathanState_FollowTrack);
		
		
		///////////////////////////////
		//Light Sensor
		@mpLightSensor = cLux_CreateEntityComponent_LightSensor(mBaseObj);
		
		
		/////////////////////////////////
		// BarkMachine
		@mpBarkMachine = cLux_CreateEntityComponent_BarkMachine(mBaseObj);
		mpBarkMachine.AddState(eLeviathanBark_Search);
		mpBarkMachine.SetState_SoundBark(gsBarkSearch_Sound, gfBarkSearch_MinTime,gfBarkSearch_MaxTime, true);
		
		mpBarkMachine.AddState(eLeviathanBark_Hunt);
		mpBarkMachine.SetState_SoundBark(gsBarkHunt_Sound, gfBarkHunt_MinTime,gfBarkHunt_MaxTime, true);
		
		mpBarkMachine.AddState(eLeviathanBark_HuntIntense);
		mpBarkMachine.SetState_SoundBark(gsBarkHuntIntense_Sound, gfBarkHuntIntense_MinTime,gfBarkHuntIntense_MaxTime, true);
		
		/////////////////////////////////
		// BackBone
		@mpBackboneTail = cLux_CreateEntityComponent_BackboneTail(mBaseObj);
		mpBackboneTail.SetAddTrailFreq(1.0f);
 		mpBackboneTail.SetMaxTrailSize(80);
		mpBackboneTail.SetStiffness(1.05f);
		array<tString> vBoneNames;
			vBoneNames.push_back("Spine_00");
			vBoneNames.push_back("Spine_01");
			vBoneNames.push_back("Spine_02");
			vBoneNames.push_back("Spine_03");
			vBoneNames.push_back("Spine_04");
			vBoneNames.push_back("Spine_05");
			vBoneNames.push_back("Spine_06");
			vBoneNames.push_back("Spine_07");
			vBoneNames.push_back("Spine_end");
		mpBackboneTail.Setup(vBoneNames);
	}
	
	//------------------------------------------------------------
	
	//} END LOADING
	
	/////////////////////////////////////////
	// GENERAL
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		cScrAgentSwimBot::OnUpdate(afTimeStep);
		
		//cLux_AddDebugMessage("Heading to: " + vMoveToTarget);
		//cLux_AddDebugMessage("Dist: " + cMath_Vector3Dist(vMoveToTarget, mBaseObj.GetPosition()));
		
		UpdatePlayerIsInTheOpen(afTimeStep);
		
		UpdateLightBrightness(afTimeStep);
		
		UpdateGroundCollideTest(afTimeStep);
	}
	
	//------------------------------------------------------------
	
	void UpdatePlayerIsInTheOpen(float afTimeStep)
	{
		mfCheckPlayerIsInTheOpenCount -= afTimeStep;
		if(mfCheckPlayerIsInTheOpenCount>0) return;
		mfCheckPlayerIsInTheOpenCount = 0.3f;
		
		mbPlayerIsInTheOpen = true;
		
		if(mbCirclePlayer_Capture) return;
		
		cVector3f vPlayerPos = mBaseObj.GetPlayerPos();
		
		cLuxClosestCharCollider output;
		
		array<cVector3f> vRayDirs; vRayDirs.resize(5);
		vRayDirs[0] = cVector3f(0,1,0);
		vRayDirs[1] = cVector3f(1,0,0);
		vRayDirs[2] = cVector3f(-1,0,0);
		vRayDirs[3] = cVector3f(0,0,1);
		vRayDirs[4] = cVector3f(0,0,-1);
		//vRayDirs[5] = cVector3f(1,0,1);
		//vRayDirs[6] = cVector3f(-1,0,1);
		//vRayDirs[7] = cVector3f(1,0,-1);
		//vRayDirs[8] = cVector3f(-1,0,-1);
		
		int lCount=0;
		int lGoalCount = 2;
		for(int i=0; i<vRayDirs.size(); ++i)
		{
			if(cLux_GetClosestCharCollider(vPlayerPos, vRayDirs[i], 1.9f, false,output))
				lCount++;
				
			if(lCount==lGoalCount)
			{
				mbPlayerIsInTheOpen=false;
				break;
			}
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateLightBrightness(float afTimeStep)
	{
		float fT = Effect_VideoDistortion_GetEffectAmount();
		
		float fBrightness = cMath_Easing(eEasing_QuadIn, fT, 	cMath_Min(0.3f*mfLightBrightness, 0.4f), 
																mfLightBrightness);
		
		mBaseObj.SetEffectBaseColor(cColor(fBrightness, 1.0f));
	}
	
	//------------------------------------------------------------
	
	void UpdateGroundCollideTest(float afTimeStep)
	{
		mfGroundCollideTestCount -= afTimeStep;
		if(mfGroundCollideTestCount>0) return;
		
		mfGroundCollideTestCount = 0.1f;
		
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		cVector3f vPushBack;
		
		//TODO!!
		//if(pCharBody.CheckCharacterFits(pCharBody.GetPosition(), false, 0, vPushBack)==false)
		//{
			//cLux_AddDebugMessage("COLLISION, Amount: "+vPushBack.Length());
		//}
	}
	
