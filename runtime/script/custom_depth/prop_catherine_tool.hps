	//------------------------------------------------------------
	
	bool VR_IsDeltaCrashDisplay()
	{
		if (mBaseObj.GetName()!="CathTool_Crashed") return false;
		cLuxMap@ pMap=cLux_GetCurrentMap();
		return pMap !is null && pMap.GetName()=="02_03_delta";
	}

    bool VR_IsPhysicalPickupReady()
    {
        return _HPL3VR_RuntimeActive_Catherine() && mbVRPhysicalDrawStarted &&
            !mbInserted && !mbVRReplacementSourceRetirePending && mBaseObj.IsActive() &&
            Player_ToolIsInInventory(mBaseObj.GetName());
    }

	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		if (mbVRReplacementSourceRetirePending) return false;
		if (!_HPL3VR_RuntimeActive_Catherine())
		{
				if (mbInserted&&CanGiveHint())
				{
					mBaseObj.Timer_Add(0, 3); //Do so do not get the crossed over icon straight after.
					
					 PlayHint();
					 return true;
				}
				 
				if (cScrPropTool::OnInteract(alType, apBody, avFocusPos, asData)==false)
				   return false;
			
				tString sSound = "";
				if (Player_GetUnderwater())
				{
					cLux_AddTodoMessage("Sound: Underwater cath tool interact");
					sSound = gsCathInteractUnderwaterSound;
					Sound_PlayGui("Entities_Station/object/cathtool/underwater/remove_cathtool_underwater", 1.0f, eSoundEntryType_WorldClean);
				}
				else
				{
					sSound = gsCathInteractNonUnderwaterSound;
					//Sound_PlayGui("Entities_Station/object/cathtool/remove_cathtool_nonunderwater", 1.0f, eSoundEntryType_World);
					Sound_CreateAtEntity("RemoveCathtoolNonunderwater", "Entities_Station/object/cathtool/remove_cathtool_nonunderwater", "Player");
				}
			  
				return true;
		}
		// S26BO: a consumed display's authored callback may try to interact with
		// the already-owned hidden tool again. Reject before that callback can run
		// or VR_BeginPhysicalDraw can rematerialize it without a shoulder handoff.
		// Preserve native hidden first acquisitions when no Omni is owned yet.
        cScript_RunGlobalFunc("PlayerToolHandler","","_Global_VRGetOwnedPhysicalOmniName");
        tString sOwnedBefore=cScript_GetGlobalReturnString();
        if (!mBaseObj.IsActive() && sOwnedBefore!="") return false;
		if (VR_IsDeltaCrashDisplay() && !mbInserted && !Player_ToolIsInInventory(mBaseObj.GetName()))
		{
			cLuxMap@ pMap=cLux_GetCurrentMap();
			if (!pMap.ScriptPrepare("bool VR_TakeCrashedCathTool()")) return false;
			return pMap.ScriptExecute() && pMap.GetReturnBool();
		}
		if (mbVRReplacementSourceRetirePending) return false;
		if (mbInserted&&CanGiveHint())
		{
			mBaseObj.Timer_Add(0, 3); //Do so do not get the crossed over icon straight after.
			
			 PlayHint();
			 return true;
		}
		 
		if (!mbInserted && Player_ToolIsInInventory(mBaseObj.GetName()))
		{
			VR_BeginPhysicalDraw();
			cScript_RunGlobalFunc("VROMNI", mBaseObj.GetName(), "G");
			return true;
		}

		// Slot retrieval / first world pickup is a physical pickup transaction.
		// The base Prop_Tool still owns callbacks and logical inventory; C keeps the
		// successfully acquired real Catherine dynamic in this gripping hand.
        cMatrixf mtxPickup=mBaseObj.GetMatrix();
		mbVRPhysicalPickupInProgress = true;
		mbVRPhysicalDrawStarted = false;
		bool bPicked = cScrPropTool::OnInteract(alType, apBody, avFocusPos, asData);
		mbVRPhysicalPickupInProgress = false;
        // BM: authored pickup callbacks can acquire a different Catherine, hide
        // this display and return false to avoid awarding the display itself.
        // Complete only that synchronous, newly-owned replacement transaction.
        // The nested OnInteract already published its physical draw/body capture.
        if(sOwnedBefore=="" && !mBaseObj.IsActive() && !Player_ToolIsInInventory(mBaseObj.GetName()))
        {
            cScript_RunGlobalFunc("PlayerToolHandler","","_Global_VRGetOwnedPhysicalOmniName");
            tString sReplacement=cScript_GetGlobalReturnString();
            if(sReplacement!="" && sReplacement!=mBaseObj.GetName())
            {
                cLuxProp@ pReplacement=Map_GetProp(sReplacement);
                if(pReplacement !is null && pReplacement.ScriptPrepare("bool VR_IsPhysicalPickupReady()") &&
                    pReplacement.ScriptExecute() && pReplacement.GetReturnBool())
                {
                    pReplacement.SetMatrix(mtxPickup);
                    pReplacement.SetSaveDataIsUpdated(true);
                    return true;
                }
            }
        }
		if (bPicked==false) return false;
		// A pickup callback may legally veto acquisition even if the base interaction
		// itself returned. Never report/sonify a physical retrieval unless the
		// logical PlayerToolHandler inventory actually accepted this exact Catherine.
		if (!Player_ToolIsInInventory(mBaseObj.GetName())) return false;

		tString sSound = "";
		if (Player_GetUnderwater())
		{
			cLux_AddTodoMessage("Sound: Underwater cath tool interact");
			sSound = gsCathInteractUnderwaterSound;
			Sound_PlayGui("Entities_Station/object/cathtool/underwater/remove_cathtool_underwater", 1.0f, eSoundEntryType_WorldClean);
		}
		else
		{
			sSound = gsCathInteractNonUnderwaterSound;
			//Sound_PlayGui("Entities_Station/object/cathtool/remove_cathtool_nonunderwater", 1.0f, eSoundEntryType_World);
			Sound_CreateAtEntity("RemoveCathtoolNonunderwater", "Entities_Station/object/cathtool/remove_cathtool_nonunderwater", "Player");
		}
	  
		return true;
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		if (mbInserted&&CanGiveHint())
		{
			if (Voice_SceneInvolvingCharacterIsActive(msVoiceCharacter))
				return eCrossHairState_TalkBusy;
			return eCrossHairState_Talk;
		}
		return cScrPropTool::GetInteractIconId(alType, apBody);
	}
	
	//------------------------------------------------------------
	// Hints
	//------------------------------------------------------------

	bool mbHintsEnabled = false;
	tString msHintsCallback = "";

	void ResetHints()
	{
		mbHintsEnabled = false;
		msHintsCallback = "";
	}

	//------------------------------------------------------------

	void _Global_SetHintsCallback()
	{
		SetHintsCallback(cScript_GetGlobalArgString(0));
	}

	//------------------------------------------------------------

	void SetHintsCallback(const tString& in asHintsCallback)
	{
		msHintsCallback = asHintsCallback;
	}

	//------------------------------------------------------------

	void _Global_SetHintsEnabled()
	{
		SetHintsEnabled(cScript_GetGlobalArgBool(0));
	}
	
	//------------------------------------------------------------

	void SetHintsEnabled(bool abEnabled)
	{
		mbHintsEnabled = abEnabled;
	}
	
	//------------------------------------------------------------

	bool CanGiveHint()
	{		
		if (!mbHintsEnabled)
			return false;
			
		tString sHintPrefix = GetHintStringPrefix();
		if (sHintPrefix=="")
			return false;
			
		tString sHint = GetValidHintStringVariant(sHintPrefix, false);
		if (sHint=="")
			return false;
			
		return true;
	}

	//------------------------------------------------------------

	tString GetHintStringPrefix()
	{
		if (msHintsCallback!="")
		{
			cLuxMap @pMap = mBaseObj.GetMap();
			if(pMap.ScriptPrepare("tString " + msHintsCallback + "(const tString &in asEntityName)" ) )
			{
				tString sName = mBaseObj.GetName();
				pMap.SetArgString(0, sName);
				pMap.ScriptExecute();
				tString sHint = pMap.GetReturnString();
				return sHint;
			}
		}
		return "";
	} 
	
	//------------------------------------------------------------
	
	tString GetValidHintStringVariant(const tString& in asHintPrefix, bool abUseTheHint)
	{
		int lPlayedTimes = GetHintPlayedTimes(asHintPrefix);
		lPlayedTimes++;
		tString sHint=asHintPrefix+"_"+lPlayedTimes;
		if (Voice_SubjectExists(sHint)==false)
		{
			//Check if we can go back to previous line?
			lPlayedTimes--;
			sHint=asHintPrefix+"_"+lPlayedTimes;
			if(Voice_SubjectExists(sHint)==false) return "";
		}
		else if(abUseTheHint)
		{
			IncHintPlayedTimes(asHintPrefix);
		}
		
		return sHint;
	}
	
	//------------------------------------------------------------
	
	void PlayHint()
	{
		if (!mbHintsEnabled)
			return;
		
		tString sHintPrefix = GetHintStringPrefix();
		if (sHintPrefix=="")
			return;
			
		tString sHint = GetValidHintStringVariant(sHintPrefix, true);
		if (sHint=="")
			return;
			
		if (Voice_SceneInvolvingCharacterIsActive(msVoiceCharacter))
			return;
			
		Voice_Play(sHint, -1,"", 10);
	}
	
	//------------------------------------------------------------
	
	void IncHintPlayedTimes(const tString& in asHint)
	{
		tString sHintVar = "Hint_"+cLux_GetCurrentMap().GetName()+"_"+asHint;
		cScript_SetGlobalVarInt(sHintVar, GetHintPlayedTimes(asHint)+1);
	}
	
	//------------------------------------------------------------
	
	int GetHintPlayedTimes(const tString& in asHint)
	{
		tString sHintVar = "Hint_"+cLux_GetCurrentMap().GetName()+"_"+asHint;
		return cScript_GetGlobalVarInt(sHintVar);
	}

	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// H57.56B PHYSICAL CATHERINE
	/////////////////////////////////////////

	void VR_PublishPlayerBodyPosition()
	{
		if (mbInserted || !Player_ToolIsInInventory(mBaseObj.GetName())) return;
		iCharacterBody@ pPlayerBody = cLux_GetPlayer().GetCharacterBody();
		if (pPlayerBody is null) return;
		cVector3f vPos = pPlayerBody.GetPosition();
		// H57.56I: C's calibrated hip location was camera-origin based, while D/H
		// correctly moved recurring translation to Simon's character body. Publish the
		// authored camera-to-body vertical origin once with the body position so native
		// can preserve C's physical hip height without returning to camera-relative X/Z.
		float fCameraBodyY = cLux_GetPlayer().GetCamera().GetPosition().y - vPos.y;
		tString sBodyPos = cString_ToString(vPos.x, 5) + "," +
					   cString_ToString(vPos.y, 5) + "," +
					   cString_ToString(vPos.z, 5) + "," +
					   cString_ToString(fCameraBodyY, 5);
		cScript_RunGlobalFunc("VROMNIBODY", sBodyPos, "B");
	}

	void VR_SetPhysicalBody(bool abLoose)
	{
        // Native maps attach inserted Catherine to a moving shuttle/zeppelin/lift.
        // Only successful, non-inserted ownership may release that attachment.
        if(mbInserted || !Player_ToolIsInInventory(mBaseObj.GetName())) return;
        cLuxProp@ parent=mBaseObj.GetAttachmentParent();
        if(parent !is null){parent.RemoveAttachedProp(mBaseObj);parent.SetSaveDataIsUpdated(true);}
        mBaseObj.RemoveEntityAttachment();
        mBaseObj.SetSaveDataIsUpdated(true);

		// H57.56H/I: an owned Catherine is ALWAYS a live dynamic world prop.
		// Vanilla PickUpTool deactivates the original world entity; merely making
		// its mesh visible (G) can leave the restored body static/non-colliding.
		// Rebuild ordinary dynamic physics first, then explicitly restore the body
		// collision flag and positive mass.  Holstering is kinematic parking of this
		// live body (gravity off), never SetStaticPhysics(true).
		mBaseObj.SetActive(true);
		cMeshEntity @pMeshEnt = mBaseObj.GetMeshEntity();
		if (pMeshEnt !is null)
		{
			pMeshEnt.SetVisible(true);
			pMeshEnt.ResetGraphicsUpdated();
		}
		mBaseObj.SetStaticPhysics(false);

		// H57.56F: bracket Catherine's own authored GetMainBody() call so native
		// code captures the exact dynamic wrapper SOMA returns after the static
		// transition above.  No entity-loader pointer reinterpretation is used.
		cScript_RunGlobalFunc("VROMNIBIND", mBaseObj.GetName(), "B");
		iPhysicsBody@ pBody = mBaseObj.GetMainBody();
		cScript_RunGlobalFunc("VROMNIBIND", mBaseObj.GetName(), "E");
		if (pBody !is null)
		{
			pBody.SetCollide(true);
			pBody.SetCollideCharacter(false);
			pBody.SetMass(1.0f);
			pBody.SetGravity(abLoose);
		}
		mBaseObj.SetAutoSleep(false);
		mBaseObj.WakeUp();
	}

	cMatrixf VR_GetStorageMatrix()
	{
		iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
		float fYaw = pBody.GetYaw();
		cMatrixf mtxYaw = cMath_MatrixRotateY(fYaw);
		// H57.56AN one-shot presentation seed: default to the mirrored right-shoulder body slot.
		// Native immediately takes over recurring motion and may select legacy hip mode from INI.
		cVector3f vOrigin = pBody.GetPosition();
		vOrigin.y = cLux_GetPlayer().GetCamera().GetPosition().y;
		cVector3f vOffset = cMath_MatrixMul(mtxYaw.GetRotation(), cVector3f(0.26f, -0.07f, -0.10f));
		cMatrixf mtxTool = cMath_MatrixMul(mtxYaw, cMath_MatrixRotateX(cMath_PiDiv2));
		mtxTool.SetTranslation(vOrigin + vOffset);
		return mtxTool;
	}

	void VR_UpdateHolsterTransform()
	{
		if (!mbVRHolstered || mbInserted) return;
		mBaseObj.SetMatrix(VR_GetStorageMatrix());
	}

	void VR_EnterHolster()
	{
		mbVRHolstered = true;
		VR_SetPhysicalBody(false);

		// H57.56G: seed the save-restored entity through HPL's own SetMatrix once.
		// F proved the raw body is valid, but raw Newton parking alone does not
		// guarantee an inactive/hidden saved render entity gets a world transform.
		// Native remains the ONLY recurring storage-slot authority after this seed.
		mBaseObj.SetMatrix(VR_GetStorageMatrix());
		cMeshEntity @pMeshEnt = mBaseObj.GetMeshEntity();
		if (pMeshEnt !is null) pMeshEnt.SetVisible(true);

		tString sPresentation = mBaseObj.IsActive() ? "A1" : "A0";
		sPresentation += (pMeshEnt !is null && pMeshEnt.IsVisible()) ? "V1" : "V0";
		cScript_RunGlobalFunc("VROMNIPRES", mBaseObj.GetName(), sPresentation);
	}

	void VR_BeginPhysicalDraw()
	{
		mbVRHolstered = false;
		VR_SetPhysicalBody(true);
	}

	void _Global_VRShoulderStore()
    {
        bool committed=VR_TryShoulderStore();
        cScript_SetGlobalReturnBool(committed);
    }

    bool VR_TryShoulderStore()
	{
		// AO: shoulder storage mirrors the left-shoulder inventory presentation.
		// Logical Tool ownership stays in PlayerToolHandler; only this physical
		// Catherine carrier is hidden/deactivated.  No map Use/Insert/Detach fires.
		
		if (!_HPL3VR_RuntimeActive_Catherine()) return false;
		if (mbInserted || mbVRReplacementSourceRetirePending) return false;
		if (!Player_ToolIsInInventory(mBaseObj.GetName())) return false;
		mbVRHolstered = true;
		cMeshEntity @pMeshEnt = mBaseObj.GetMeshEntity();
		if (pMeshEnt !is null)
		{
			pMeshEnt.SetVisible(false);
			pMeshEnt.ResetGraphicsUpdated();
		}
		mBaseObj.SetActive(false);
		cScript_RunGlobalFunc("VROMNI", mBaseObj.GetName(), "Y");
		return true;
	}

	void _Global_VRShoulderDraw()
    {
        bool committed=VR_TryShoulderDraw();
        cScript_SetGlobalReturnBool(committed);
    }

    bool VR_PreserveShoulderCarrierForDeload(float x, float y, float z)
    {
        if(!_HPL3VR_RuntimeActive_Catherine()) return false;
        if(mbInserted || mbVRReplacementSourceRetirePending || !mbVRHolstered) return false;
        if(mBaseObj.IsActive() || !Player_ToolIsInInventory(mBaseObj.GetName())) return false;
        // This is an inactive shoulder carrier, never a held/loose or slotted tool.
        // Keep it hidden and inactive; only its retained-region position changes.
        cMatrixf transform=mBaseObj.GetMatrix();
        transform.SetTranslation(cVector3f(x,y,z));
        mBaseObj.SetMatrix(transform);
        mBaseObj.SetSaveDataIsUpdated(true);
        return true;
    }

    bool VR_TryShoulderDraw()
	{
		// AO hidden body-slot gesture is physical presentation only. Do not invoke
		// Insert/Detach/map Use callbacks here; logical ownership must already exist.
		
		if (!_HPL3VR_RuntimeActive_Catherine()) return false;
		if (mbInserted || mbVRReplacementSourceRetirePending) return false;
		if (!Player_ToolIsInInventory(mBaseObj.GetName())) return false;
		VR_BeginPhysicalDraw();
		cScript_RunGlobalFunc("VROMNI", mBaseObj.GetName(), "R");
		return true;
	}

	void _Global_VREnsureOwnedPhysicalCarrier()
	{
		if (!_HPL3VR_RuntimeActive_Catherine()) return;
		cScript_SetGlobalReturnBool(false);
		if (mbInserted || !Player_ToolIsInInventory(mBaseObj.GetName())) return;

		// H57.56I: PlayerToolHandler resets its ensure latch when a physical slot
		// retrieval re-adds Catherine to logical inventory. That is a LIVE pickup, not
		// save reconstruction. C kept the successful physical pickup in the gripping
		// hand; E/H accidentally called VR_EnterHolster here and teleported it away.
		// mbVRPhysicalDrawStarted is nosave and is set only by the current OnInteract
		// pickup transaction, so saved/map-restored carriers still use the safe H path.
		if (mbVRPhysicalDrawStarted)
		{
			mbVRBootstrapDone = true;
			VR_PublishPlayerBodyPosition();
			cScript_SetGlobalReturnBool(true);
			return;
		}

		VR_EnterHolster();
		mbVRBootstrapDone = true;
		VR_PublishPlayerBodyPosition();
		// H57.56E: inventory authority may explicitly reassert the carrier after
		// save restoration. Native binding is deferred and fail-closed.
		cScript_RunGlobalFunc("VROMNI", mBaseObj.GetName(), "H");
		cScript_SetGlobalReturnBool(true);
	}

	void _Global_VRBootstrap()
	{
		if (!_HPL3VR_RuntimeActive_Catherine()) return;
		if (mbVRBootstrapDone) return;
		mbVRBootstrapDone = true;
		// S26BN: native map transfer can retain an unowned source as name__spawn__
		// with its old mbInserted/msSlot. It is not the separately owned carrier.
		// Resolve this BEFORE publishing either state or the chip-contact body;
		// otherwise a late source bootstrap overwrites H and disables shoulder draw.
		// Ordinary authored inserted carriers remain valid (including Delta's legacy
		// CathTool_Crashed). Live Insert/Detach and saved story state are untouched.
		if (!Player_ToolIsInInventory(mBaseObj.GetName()))
		{
			cScript_SetGlobalReturnString("");
			cScript_RunGlobalFunc("PlayerToolHandler", "", "_Global_VRGetOwnedPhysicalOmniName");
			tString sOwned = cScript_GetGlobalReturnString();
			if (sOwned != "" && sOwned != mBaseObj.GetName() &&
				(!mbInserted || cString_GetFirstStringPos(mBaseObj.GetName(), "__spawn__") >= 0))
			{
				LogNewLine("S26BN Omni bootstrap ignored superseded carrier " + mBaseObj.GetName() + "; owned=" + sOwned);
				return;
			}
		}
		// Match the native IsInserted contract: inactive presentations are not slots.
		if (mbInserted && !mBaseObj.IsActive()) return;
		if (mbInserted)
		{
			mbVRHolstered = false;
			cScript_RunGlobalFunc("VROMNI", mBaseObj.GetName(), "S");

			// H57.56AE: mbInserted/msSlot are authored saved state, while the native
			// docked-upgrade body identity and PlayerToolHandler VR context are
			// deliberately [nosave]. Reconstruct ONLY those two runtime identities
			// exactly as live Insert() does after SetStaticPhysics(true). The entity
			// is already in its authored inserted/static state on save load, so this
			// performs no Insert(), no animation, no movement, and no story callback.
			cScript_RunGlobalFunc("VROMNIUP", mBaseObj.GetName(), "B");
			iPhysicsBody@ pVRInsertedUpgradeBody = mBaseObj.GetMainBody();
			cScript_RunGlobalFunc("VROMNIUP", mBaseObj.GetName(), "E");
			cScript_SetGlobalArgString(0, mBaseObj.GetName());
			cScript_SetGlobalArgString(1, msSlot);
			cScript_RunGlobalFunc("PlayerToolHandler", "", "_Global_VRSetInsertedOmniContext");
			if (pVRInsertedUpgradeBody is null) {}
			return;
		}
		if (Player_ToolIsInInventory(mBaseObj.GetName()))
		{
			// H57.56BF: map/save bootstrap is also forbidden from synchronously
			// physicalising an owned Catherine. A live manual pickup remains in-hand;
			// all nonphysical ownership waits for PlayerToolHandler's delayed ensure.
			if (mbVRPhysicalDrawStarted)
			{
				VR_PublishPlayerBodyPosition();
				return;
			}
			mbVRHolstered = true;
			return;
		}
		mbVRHolstered = false;
		cScript_RunGlobalFunc("VROMNI", mBaseObj.GetName(), "F");
	}

	bool VR_RetireDeltaCrashDuplicate()
	{
		if (!_HPL3VR_RuntimeActive_Catherine() || !VR_IsDeltaCrashDisplay() || mbInserted) return false;
		if (!Player_ToolIsInInventory("CathTool")) return false;
		_Global_VRRetireReplacedCarrier();
		return true;
	}

	void _Global_VRRetireReplacedCarrier()
	{
		if (!_HPL3VR_RuntimeActive_Catherine()) return;
		if (mbInserted) return;
		mbVRReplacementSourceRetirePending = true;
		mfVRReplacementSourceRetireDelay = 0.12f;
		mbVRHolstered = false;
		mBaseObj.SetSaveDataIsUpdated(true);
		cScript_RunGlobalFunc("VROMNIRET", mBaseObj.GetName(), "A");
	}

	void VR_SuppressNonCanonicalOwnedDuplicate()
	{
		if (mbInserted || msSlot != "" || mbVRReplacementSourceRetirePending || Player_ToolIsInInventory(mBaseObj.GetName())) return;
		cScript_RunGlobalFunc("PlayerToolHandler", "", "_Global_VRGetCanonicalOmniName");
		tString sCanonical = cScript_GetGlobalReturnString();
		if (sCanonical == "")
		{
			// Older VR saves can contain the active source of an already-inserted
			// replacement, without the formerly unsaved retirement flag. Recover
			// through the same delayed retirement, only after validating insertion.
			cScript_RunGlobalFunc("PlayerToolHandler", "", "_Global_VRGetInsertedPhysicalOmniName");
			sCanonical = cScript_GetGlobalReturnString();
			if (sCanonical != "" && sCanonical != mBaseObj.GetName())
				_Global_VRRetireReplacedCarrier();
			return;
		}
		if (sCanonical == "" || sCanonical == mBaseObj.GetName()) return;
		if (!mbVRNonCanonicalSuppressed)
		{
			mbVRNonCanonicalSuppressed = true;
			cScript_RunGlobalFunc("VROMNI", mBaseObj.GetName(), "X");
		}
		mBaseObj.SetActive(false);
	}

    bool VR_IsInsertedPhysicalOmni()
    {
        return mbInserted && msSlot!="" && mBaseObj.IsActive();
    }

		/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	[nosave] bool mbVRHolstered = false;
	[nosave] bool mbVRBootstrapDone = false;
	[nosave] float mfVRBootstrapDelay = 0.0f;
	[nosave] bool mbVRPhysicalPickupInProgress = false;
	[nosave] bool mbVRPhysicalDrawStarted = false;
	[nosave] bool mbVRNonCanonicalSuppressed = false;
	// Persist the short retirement window: otherwise a save here restores an
	// active, unowned old carrier with no remaining cleanup transaction.
	bool mbVRReplacementSourceRetirePending = false;
	float mfVRReplacementSourceRetireDelay = 0.0f;
	bool mbInserted = false;
	tString msSlot = "";
	
	tString msVoiceCharacter="Catherine";
	
	//------------------------------------------------------------
	
	
	
	//------------------------------------------------------------
}

