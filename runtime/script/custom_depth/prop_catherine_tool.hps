	//------------------------------------------------------------
	
	void Insert()
	{
		if (!_HPL3VR_RuntimeActive_Catherine())
		{
				msSlot = cScript_GetGlobalArgString(0);
				mbInserted = true;
				
				mBaseObj.SetStaticPhysics(true);
				mBaseObj.SetActive(true);
				//mBaseObj.SetEffectBaseColor(cColor(0));
				//mBaseObj.FadeEffectBaseColor(cColor_White, 0.5);
			
				mBaseObj.GetMeshEntity().ProcPlayFadeToName("Insert", 0.5, false, 0);
				
				SetScreen(eCathToolScreen_Interact);
			return;
		}
		mbVRHolstered = false;
		cScript_RunGlobalFunc("VROMNI", mBaseObj.GetName(), "I");
		msSlot = cScript_GetGlobalArgString(0);
		mbInserted = true;
		
		mBaseObj.SetStaticPhysics(true);
		mBaseObj.SetActive(true);

		// S: the VROMNI I token above intentionally sees the pre-static physical holder.
		// Capture AGAIN only after SOMA has performed the authored static-physics transition,
		// so O5 compares the held chip against the exact slot-owned Catherine body.
		cScript_RunGlobalFunc("VROMNIUP", mBaseObj.GetName(), "B");
		iPhysicsBody@ pVRInsertedUpgradeBody = mBaseObj.GetMainBody();
		cScript_RunGlobalFunc("VROMNIUP", mBaseObj.GetName(), "E");
		cScript_SetGlobalArgString(0, mBaseObj.GetName());
		cScript_SetGlobalArgString(1, msSlot);
		cScript_RunGlobalFunc("PlayerToolHandler", "", "_Global_VRSetInsertedOmniContext");
		// Keep the local handle alive through the bracket; native only observes identity.
		if (pVRInsertedUpgradeBody is null) {}

		//mBaseObj.SetEffectBaseColor(cColor(0));
		//mBaseObj.FadeEffectBaseColor(cColor_White, 0.5);

		mBaseObj.GetMeshEntity().ProcPlayFadeToName("Insert", 0.5, false, 0);
		
		SetScreen(eCathToolScreen_Interact);
	}

	//-------------------------------------------------------
	
	void Detach()
	{
		if (!_HPL3VR_RuntimeActive_Catherine())
		{
				mBaseObj.SetInteractionDisabled(false);
				
				mBaseObj.WakeUp();
				mBaseObj.SetAutoSleep(false);
				//mBaseObj.FadeEffectBaseColor(cColor(0), 0.5);
			
				mbInserted = false;

				
				SetScreen(eCathToolScreen_Disconnected);
			return;
		}
		cScript_RunGlobalFunc("VROMNI", mBaseObj.GetName(), "D");
        cScript_SetGlobalArgString(0,mBaseObj.GetName());
        cScript_RunGlobalFunc("PlayerToolHandler","","_Global_VRClearInsertedOmniContext");
		mBaseObj.SetInteractionDisabled(false);
		
		mBaseObj.WakeUp();
		mBaseObj.SetAutoSleep(false);
		//mBaseObj.FadeEffectBaseColor(cColor(0), 0.5);

		mbInserted = false;
		
		SetScreen(eCathToolScreen_Disconnected);
	}
	
