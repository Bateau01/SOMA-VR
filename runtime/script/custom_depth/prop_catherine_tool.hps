//////////////////////////////////////////////////////
// TOOL
//////////////////////////////////////////////////////

//------------------------------------------------------------

// H5756I_VR_OMNITOOL_MANUAL_RETRIEVAL_C_FRAME
// H5756S_VR_OMNITOOL_POST_STATIC_UPGRADE_CAPTURE
// H5756T_VR_OMNITOOL_INSERTED_CONTEXT: after authored Insert() has switched Catherine to static slot ownership, capture that exact current main body for physical chip contact; never re-adopt into H26.
// H5756AE_VR_INSERTED_SAVE_CONTEXT_RESTORE: save bootstrap for mbInserted=true reconstructs the same post-static upgrade-body capture and PlayerToolHandler inserted context as live Insert(); no story callback or physical motion is invoked.
// H5756AN_VR_OMNITOOL_RIGHT_SHOULDER_SLOT lineage
// H5756AO_VR_OMNITOOL_RIGHT_SHOULDER_SLOT: default right-shoulder storage is hidden/bodyless like the left shoulder; fresh-Grip draw rematerializes owned non-inserted Catherine without map Use/slot callbacks; legacy physical hip mode remains native-configurable.
// H5756W_VR_OMNITOOL_REPLACED_SOURCE_RETIREMENT: Upsilon source OmniTool becomes non-interactable immediately after its authored replacement is inserted, then hides after a short safe delay so old Newton hand references are already released.
// H5756BG_VR_CATHERINE_LOCAL_BOOTSTRAP_DELAY: SetupAfterLoad never touches cLux_GetCurrentMap/Map_AddTimer; object-local OnUpdate delay owns bootstrap after entity construction.
void _CathTool_VRBootstrap_Timer(const tString &in asTimer)
{
	cScript_RunGlobalFunc(asTimer, "cScrPropCatherineTool", "_Global_VRBootstrap");
}

class cScrPropCatherineTool : cScrPropTool
{
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		// S26BX: replacement is an authored ownership transaction. Finish its
		// saved cleanup even when a VR-created save is resumed in flatscreen.
		// Keep the delay: native hand references must retire before body hiding.
		if (mbVRReplacementSourceRetirePending)
		{
			mfVRReplacementSourceRetireDelay -= afTimeStep;
			if (mfVRReplacementSourceRetireDelay <= 0.0f)
			{
				mbVRReplacementSourceRetirePending = false;
				mfVRReplacementSourceRetireDelay = 0.0f;
				mbVRHolstered = false;
				mBaseObj.SetActive(false);
				mBaseObj.SetSaveDataIsUpdated(true);
				if (_HPL3VR_RuntimeActive_Catherine())
					cScript_RunGlobalFunc("VROMNIRET", mBaseObj.GetName(), "H");
				return;
			}
		}
		if (!_HPL3VR_RuntimeActive_Catherine())
		{
				cScrPropTool::OnUpdate(afTimeStep);
				
				
			return;
		}
		cScrPropTool::OnUpdate(afTimeStep);
		if (!mbVRBootstrapDone && mfVRBootstrapDelay > 0.0f)
		{
			mfVRBootstrapDelay -= afTimeStep;
			if (mfVRBootstrapDelay <= 0.0f)
			{
				mfVRBootstrapDelay = 0.0f;
				_Global_VRBootstrap();
			}
		}
		VR_PublishPlayerBodyPosition();
		VR_SuppressNonCanonicalOwnedDuplicate();
	}
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
		cScrPropTool::OnSetActive(abX);
		
		if (abX==false && msSlot != "")
		{
			cScript_SetGlobalArgBool(0, false);
			cScript_RunGlobalFunc(msSlot, "cScrPropOmniSlot", "_Global_SetAttachAllowed");
			msSlot = "";
		}
	}
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		if (!_HPL3VR_RuntimeActive_Catherine())
		{
				cScrPropTool::SetupAfterLoad(apWorld, apVars, apInstanceVars);
				
				// Set up GUI screen
				SetUpOmnitoolGUI(mBaseObj);
				
				//Unless another callback has been set, use a default one
				if (msCanBeUsedCallback=="") msCanBeUsedCallback = "$CathTool_CanUse";
				
				mBaseObj.SetVariableUpdateRate(cMath_RandRectf(0.25f, 0.35f)); //call variable update no faster than once per 0.3 sec
				mBaseObj.SetAutoSleep(false);
				
				// Clear out hints after moving to new map (potential if streaming)
				ResetHints();
			return;
		}
		cScrPropTool::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		
		// Set up GUI screen
		SetUpOmnitoolGUI(mBaseObj);
		
		//Unless another callback has been set, use a default one
		if (msCanBeUsedCallback=="") msCanBeUsedCallback = "$CathTool_CanUse";
		
		// H57.56B: Catherine is now a real body-relative world prop while owned.
		// A modest 60 Hz variable update keeps the pre-first-draw storage park alive;
		// once native O2 has captured the raw body it owns the same park at Newton cadence.
		mBaseObj.SetVariableUpdateRate(0.0167f);
		mBaseObj.SetAutoSleep(false);
		mfVRBootstrapDelay = 0.35f;
		
		// Clear out hints after moving to new map (potential if streaming)
		ResetHints();
	}
	
	//------------------------------------------------------------
	
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		if (mbVRReplacementSourceRetirePending) return false;
		if (!_HPL3VR_RuntimeActive_Catherine())
		{
				if(cScrPropTool::CanInteract(alType, apBody)==false) return false;
				
				if (mbInserted)
				{
					if(mBaseObj.Timer_Exists(0)) return false; //Do so do not get the crossed over icon straight after.
					
					if (CanGiveHint())
						return true;
					return false;
				}
				return true;
		}
		// S26BO: retained physics/contact references must not make an inactive
		// slot display or hidden shoulder carrier interactable in the world.
		// Authored hidden first acquisition calls OnInteract directly instead.
		if (!mBaseObj.IsActive()) return false;
		// W: once this source carrier has been authoritatively replaced by another
		// Catherine entity, it is dead to VR interaction immediately even though its
		// world body stays alive briefly for safe Newton hand-reference retirement.
		if (VR_IsDeltaCrashDisplay() && !mbInserted && !Player_ToolIsInInventory(mBaseObj.GetName())) return Entity_IsActive("CathTool_InteractArea");
		// An already-owned physical Catherine may always be gripped directly.
		// Do not ask ToolHandler_CanPickOrUseTool(), which describes flatscreen HUD use.
		if (!mbInserted && Player_ToolIsInInventory(mBaseObj.GetName())) return true;
		if(cScrPropTool::CanInteract(alType, apBody)==false) return false;
		
		if (mbInserted)
		{
			if(mBaseObj.Timer_Exists(0)) return false; //Do so do not get the crossed over icon straight after.
			
			if (CanGiveHint())
				return true;
			return false;
		}
		return true;
	}
	
	//------------------------------------------------------------
	
	void PickUpTool(bool abEquipTool, bool abCallback)
	{
		if (!_HPL3VR_RuntimeActive_Catherine())
		{
				cScrPropTool::PickUpTool(abEquipTool, abCallback);
				
				Map_AddTimer(mBaseObj.GetName(), 1.0f, "$_CathTool_ResetScreen_Timer");
			return;
		}
		// H57.56C: one logical pickup only. A nested/repeated pickup after the first
		// AddTool must not publish P twice or create a second logical Catherine.
		if (Player_ToolIsInInventory(mBaseObj.GetName()))
		{
			if (mbVRPhysicalPickupInProgress && !mbVRPhysicalDrawStarted)
			{
				mbVRPhysicalDrawStarted = true;
				VR_BeginPhysicalDraw();
				cScript_RunGlobalFunc("VROMNI", mBaseObj.GetName(), "G");
			}
			return;
		}

		// Let the authored callback + PlayerToolHandler inventory transaction succeed
		// first. Only a successful inventory acquisition becomes a P token.
		cScrPropTool::PickUpTool(abEquipTool, abCallback);
		if (!Player_ToolIsInInventory(mBaseObj.GetName())) return;

		cScript_RunGlobalFunc("VROMNI", mBaseObj.GetName(), "P");
		if (mbVRPhysicalPickupInProgress)
		{
			if (!mbVRPhysicalDrawStarted)
			{
				mbVRPhysicalDrawStarted = true;
				VR_BeginPhysicalDraw();
				cScript_RunGlobalFunc("VROMNI", mBaseObj.GetName(), "G");
			}
		}
		else
		{
			// H57.56BF: map/story Tool_PickUp may run inside OnEnter while the old
			// world is still being retired. Do not create/activate/static-toggle/
			// GetMainBody/SetMatrix the Catherine carrier synchronously here.
			// PlayerToolHandler::VR_EnsurePhysicalOmniWorldEntity owns the delayed
			// physical rehydration once the new map/script/physics lifetime is mature.
			mbVRHolstered = true;
		}
		Map_AddTimer(mBaseObj.GetName(), 1.0f, "$_CathTool_ResetScreen_Timer");
	}
	
