void SetUpOmnitoolGUI(cLuxProp@ apBaseObj)
{
	// Set up GUI screen
	apBaseObj.CreateAndSetupGui("screen", cColor_White, 0, 0, cVector2f(512.0f, 320.0f));
	apBaseObj.SetOnGuiFunction("$_CathTool_OnGui");
}

