/**
 * Set hint callback for this map - will be called to see
 * if Cath wants to give a hint when she's not doing anything else and when CathTool_SetHintsActive(true)
 * was called.
 *
 * @param asCathTool, the CathTool entity.
 * @param asHintsCallback, a callback which will be called to work out which line to respond with. 
 * Return the name of a line _without_ numeric extension i.e. if your line variants are SomeHint_1, SomeHint_2, reply with SomeHint
 * If the line has already played, it'll play the next variant, until it runs out.
 *  Syntax: tString Func(const tString& in asEntityName)
 **/
void CathTool_SetHintsCallback(const tString &in asCathTool, const tString &in asHintsCallback)
{	
	cScript_SetGlobalArgString(0,asHintsCallback);
	cScript_RunGlobalFunc(asCathTool, "cScrPropCatherineTool", "_Global_SetHintsCallback");
}

