//-------------------------------------------------------

// H5756N_DUALMODE_SCRIPT_GATE: fail closed to stock; MenuHandler owns the [nosave] session bit.
bool _HPL3VR_RuntimeActive_CustomDepth()
{
	cScript_SetGlobalReturnBool(false);
	cScript_RunGlobalFunc("MenuHandler", "cScrMenuHandler", "HPL3VR_GetRuntimeActive");
	return cScript_GetGlobalReturnBool();
}

/**
 * Disable the growth for these entities
 * This is because most infection is being removed from the game,
 * but we still want to preserve the tentacles in-level.
 * @param asEntityName, name of the entity, wildcards supported.
 */
 
void Infection_Disable(const tString &in asEntityName)
{
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asEntityName, eLuxEntityType_Prop, "", vEntities);
	if(vEntities.length() == 0)
	{
		Error("Could not find any entities with name '"+asEntityName+"' for Infection_Disable");
		return;
	}
		
	/////////////////////////////
	// Iterate Props
	for(uint i=0; i<vEntities.length(); ++i)
	{
		cLuxProp@ pProp = cLux_ToProp(vEntities[i]);
		cScript_RunGlobalFunc(pProp.GetName(), "cScrPropInfection", "_Global_DisableInfection");
	}
}

//-------------------------------------------------------

/**
 * Setups an infection path. This is called automatically by both Infection_Begin and Infection_ConnectPaths and is only needed if you for example want a 
 * path that can start on any node.
 * 
 * @param asInfectionPathName, name of the path to set up. The names of the entities need to be PathName_X where X is the order in which the entities are activated.
 **/
void Infection_Setup(const tString &in asInfectionPathName)
{
	for(int i = 2; Entity_Exists(asInfectionPathName + "_" + i); i++)
	{
		Infection_ConnectNodes(asInfectionPathName + "_" + (i-1), asInfectionPathName + "_" + i);
	}
}

//-------------------------------------------------------

/**
 * Starts an infection path by setting up the connnections between entities and activating the first one.
 * 
 * @param asInfectionPathName, name of the path to start. The names of the entities need to be PathName_X where X is the order in which the entities are activated.
 **/
void Infection_Begin(const tString &in asInfectionPathName)
{
	Infection_Setup(asInfectionPathName);
	Infection_GrowNode(asInfectionPathName + "_1");
}

//-------------------------------------------------------

/**
 * Grows a specific infection node. If it is a part of a path, its children will start growing afterwards. Used automatically by Infection_Begin().
 * 
 * @param asNode, name of the node to grow.
 **/
void Infection_GrowNode(const tString &in asNode)
{
	cScript_RunGlobalFunc(asNode, "cScrPropInfection", "_Global_StartGrowth");
}

//-------------------------------------------------------

/**
 * Connects two nodes together. This is handled automatically for nodes in a path, but is good to have for short branches to a path.
 * 
 * @param asParent, name of parent node, can use wildcards (*).
 * @param asChild, name of child node.
 **/
void Infection_ConnectNodes(const tString &in asParent, const tString &in asChild)
{	
	cScript_SetGlobalArgString(0, asChild);
	cScript_RunGlobalFunc(asParent, "cScrPropInfection", "_Global_AddChild");
}

//-------------------------------------------------------

/**
 * Connects an entire path to an infection entity. Use this to branch a path.
 * 
 * @param asParent, name of parent node.
 * @param asChildPath, name of child path.
 **/
void Infection_ConnectPaths(const tString &in asParent, const tString &in asChildPath)
{
	Infection_Setup(asChildPath);
	cScript_SetGlobalArgString(0, asChildPath + "_1");
	cScript_RunGlobalFunc(asParent, "cScrPropInfection", "_Global_AddChild");
}

//-------------------------------------------------------

/**
 * Sets the time it takes for an infection entity to grow to its full size.
 * 
 * @param asNode, name of entity.
 * @param afTime, time to grow.
 **/
void Infection_SetNodeGrowthTime(const tString &in asEntity, float afTime)
{
	cScript_SetGlobalArgFloat(0, afTime);
	cScript_RunGlobalFunc(asEntity, "cScrPropInfection", "_Global_SetGrowthTime");
}

//-------------------------------------------------------

/**
 * Sets the time to wait between the parent's and the specified node's start time.
 * 
 * @param asNode, name of entity.
 * @param afDelay, delay in seconds.
 **/
void Infection_SetNodeGrowthDelay(const tString &in asNode, float afDelay)
{
	cScript_SetGlobalArgFloat(0, afDelay);
	cScript_RunGlobalFunc(asNode, "cScrPropInfection", "_Global_SetDelay");
}

//-------------------------------------------------------

/**
 * Sets a callback for the specified infection entity. Called both when it starts and stops growing
 * 
 * @param asNode, name of entity.
 * @param asCallback, callback function.
 * 
 * @syntax void FuncName(const tString &in asEntity, bool abStartOfGrowth)
 **/
void Infection_SetNodeCallback(const tString &in asNode, const tString &in asCallback)
{
	cScript_SetGlobalArgString(0, asCallback);
	cScript_RunGlobalFunc(asNode, "cScrPropInfection", "_Global_SetCallback");
}

