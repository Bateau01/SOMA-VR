{
	cScript_SetGlobalVarInt("CathToolScreen", int(aState));
	
	//cScript_SetGlobalArgInt(0, int(aState));
	//cScript_RunGlobalFunc(asCathTool, "cScrPropCatherineTool", "_Global_SetScreen");
}
 
eCathToolScreen CathTool_GetScreen(const tString &in asCathTool)
