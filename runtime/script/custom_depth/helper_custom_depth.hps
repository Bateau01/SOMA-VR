	return cScript_GetGlobalReturnString();
}

//-------------------------------------------------------

/**
 * Handles using the tool on an OmniPanel. 
 *
 * @param asCathTool, the CathTool entity.
 * @param asOmniPanel, the OmniPanel entity.
 * 
 **/
void CathTool_UseOnPanel(const tString &in asCathTool, const tString &in asOmniPanel)
{
	if (!_HPL3VR_RuntimeActive_CustomDepth())
	{
		if (Entity_GetVarBool(asOmniPanel, "InUse"))
			return;
			
		tString sHandAnimationSuffix = Tool_GetHandAnimationSuffix(asCathTool);
		cLux_AddDebugMessage("Playing anim: tool_"+sHandAnimationSuffix+"_use_panel");
			
		Entity_SetVarBool(asOmniPanel, "InUse", true);
		Player_PlayCustomToolAnimation("tool_"+sHandAnimationSuffix+"_use_panel", false, "");
		Player_FadeMoveSpeedMulTo(0.3, 0.5);
		Player_FadeLookSpeedMulTo(0.3, 0.5);
		Player_SetRunSpeedMul(0);
		Player_StartLookAt(asOmniPanel, 5, 2, 3);
		
		Map_AddTimer(asOmniPanel+","+asCathTool, 2, "$_CathTool_UseOnPanel_Timer");
		
		Map_AddTimer(asCathTool, 0.5f, "$_CathTool_SetInteractScreen_Timer");
		return;
	}
	if (Entity_GetVarBool(asOmniPanel, "InUse"))
		return;

	// H5756A_VR_OMNITOOL_PANEL_SEMANTIC_SHELL
	// VR owns head/look/locomotion and physical hand presentation. Keep SOMA's
	// authored panel busy flag, 2-second transaction timing, Omni-Tool screen
	// timing and final panel interaction callback, but do not slow/steer Simon or
	// play the flatscreen first-person hand animation.
	cScript_RunGlobalFunc("VROMNI", "", "U");
	Entity_SetVarBool(asOmniPanel, "InUse", true);
	Map_AddTimer(asOmniPanel+","+asCathTool, 2, "$_CathTool_UseOnPanel_Timer");
	Map_AddTimer(asCathTool, 0.5f, "$_CathTool_SetInteractScreen_Timer");
}

void _CathTool_SetInteractScreen_Timer(const tString &in asTimer)
{
	CathTool_SetScreen(asTimer, eCathToolScreen_Interact);
}

void _CathTool_UseOnPanel_Timer(const tString &in asTimer)
{
	if (!_HPL3VR_RuntimeActive_CustomDepth())
	{
		array<tString> vEntityNames;
		cString_GetStringVec(asTimer, vEntityNames, ",");
		tString sOmniPanel = vEntityNames[0];
		tString sCathTool = vEntityNames[1];
		
		Player_FadeMoveSpeedMulTo(1, 1);
		Player_FadeLookSpeedMulTo(1, 1);
		Player_SetRunSpeedMul(1);
		Player_StopLookAt(1);
		Entity_CallEntityInteract(sOmniPanel);
		
		Entity_SetVarBool(sOmniPanel, "InUse", false);
		
		Map_AddTimer(sCathTool, 0.1f, "$_CathTool_SetDisconnectedScreen_Timer");
		return;
	}
	array<tString> vEntityNames;
	cString_GetStringVec(asTimer, vEntityNames, ",");
	tString sOmniPanel = vEntityNames[0];
	tString sCathTool = vEntityNames[1];
	
	// H57.56A: no restoration writes are necessary because this VR shell never
	// changed movement/look/run state. Avoid clobbering any unrelated live modifier.
	cScript_RunGlobalFunc("VROMNI", "", "C");
	Entity_CallEntityInteract(sOmniPanel);
	
	Entity_SetVarBool(sOmniPanel, "InUse", false);
	
	Map_AddTimer(sCathTool, 0.1f, "$_CathTool_SetDisconnectedScreen_Timer");
}

void _CathTool_SetDisconnectedScreen_Timer(const tString &in asTimer)
{
	CathTool_SetScreen(asTimer, eCathToolScreen_Disconnected);
	
	// Slightly longer for the broken error message
	float fDisplayTime = CathTool_GetChipBroken() ? 3.0f : 1.5f;
	Map_AddTimer(asTimer, fDisplayTime, "$_CathTool_ResetScreen_Timer");
}


void _CathTool_ResetScreen_Timer(const tString &in asTimer)
{
	if(CathTool_GetScreen(asTimer)==eCathToolScreen_Disconnected)
		CathTool_SetScreen(asTimer, eCathToolScreen_PreInteract);
}

