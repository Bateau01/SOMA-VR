	return eCathToolScreen(cScript_GetGlobalVarInt("CathToolScreen"));
	
	//cScript_RunGlobalFunc(asCathTool, "cScrPropCatherineTool", "_Global_GetScreen");

	//return eCathToolScreen(cScript_GetGlobalReturnInt());
}

eCathToolTarget CathTool_GetTarget(const tString &in asCathTool)
{
	return eCathToolTarget(Entity_GetVarInt(asCathTool, "Target"));
}

void CathTool_ResetScreen(eCathToolVariant aVariant=eCathToolVariant_LastEnum)
{
	CathTool_SetDisabled("", false);
	CathTool_SetScreen("", eCathToolScreen_PreInteract);
	CathTool_SetChipBroken(false);
	
	if(aVariant!=eCathToolVariant_LastEnum)
		CathTool_SetVariant(aVariant);
}

