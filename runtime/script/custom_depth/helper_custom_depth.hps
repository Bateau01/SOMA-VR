/**
 * Draws the omnitool screen
 *
 * 
 *
 **/

void _CathTool_OnGui(const tString&in asEntityName, float afTimeStep)
{
	if(CathTool_GetDisabled())
		return;
		
	tString sToolName = asEntityName;
	int lNameLength = cString_GetLastStringPos(sToolName, "_HudObject");
	if(lNameLength>0) sToolName = cString_Sub(sToolName, 0, lNameLength);
	
	eCathToolVariant currentVariant = CathTool_GetVariant();
	
	/*if(CathTool_GetChipBroken())
		CathTool_OnGui_NoChip(afTimeStep, currentVariant);
	else
	{*/
		eCathToolScreen screen = CathTool_GetScreen(sToolName);
		switch(screen)
		{
			case eCathToolScreen_PreInteract:
			{
				eCathToolTarget target = CathTool_GetTarget(sToolName);
				CathTool_OnGui_PreInteract(afTimeStep, currentVariant, target);
				
				break;
			}
			case eCathToolScreen_Interact:		CathTool_OnGui_Interact(afTimeStep, currentVariant);			break;
			case eCathToolScreen_Disconnected:	CathTool_OnGui_Disconnected(afTimeStep, currentVariant);		break;
		}
	//}
}

//------------------------------------------------------------

void CathTool_OnGui_NoChip(float afTimeStep, eCathToolVariant aVariant)
{
	if(aVariant>eCathToolVariant_Cath)
		aVariant = eCathToolVariant_Cath;
		
	tString sBGSuffix = CathTool_GetBGVariantSuffix(aVariant);
	tString sChipSuffix = CathTool_GetChipVariantSuffix(aVariant);
	
	cImGuiGfx bg("omnitool_background_nochip" + sBGSuffix + ".dds", eImGuiGfx_Texture);
	cImGuiGfx error("omnitool_chip_error" + sChipSuffix + ".dds", eImGuiGfx_Texture);
	
	float fTitleSize = 45.0f;
	float fInfoSize = 35.0f;
	
	float fBlinkTime = 1.0f/1.5f;
	
	cColor colError(1.0f, 180.0f/255.0f, 0.0f, 1.0f);
	
	cImGuiLabelData label;
	label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
	label.mFont.mvSize = cVector2f(fTitleSize);
	label.mColorBase = colError;
			
	ImGui_DrawGfx(cImGuiGfx(), cVector3f_Zero, ImGui_NrmSize(1.0f, 1.0f), cColor(1,0,0,1));
	ImGui_DrawGfx(bg, cVector3f(0,0,0.5f));
	
	ImGui_SetTransCategory("");
	CathTool_DrawTitle(label);
	
	label.mFontAlign = eFontAlign_Left;
	label.mFont.mvSize = cVector2f(fInfoSize);
	
	if(aVariant==eCathToolVariant_HelperJane)
	{
		ImGui_LayoutBegin(eImGuiLayout_X, ImGui_NrmPos(0.5f, 0.85f,1.0f), ImGui_NrmSize(0.3f, 0.1f));
		{
			ImGui_DoLabelExt("A.I.: ", label, cVector3f_Zero);
			ImGui_DoLabelExt("Helper Jane", label, cVector3f_Zero);
			label.mFont.mvSize = cVector2f(fInfoSize)*0.6f;
			ImGui_DoLabelExt("tm", label, cVector3f(0,-2.5f,0));
		}
		ImGui_LayoutEnd();
	}
	else
	{
		ImGui_LayoutBegin(eImGuiLayout_X, ImGui_NrmPos(0.40f, 0.85f,1.0f), ImGui_NrmSize(0.3f, 0.1f));
		{
			ImGui_DoLabelExt("A.I.: ", label, cVector3f_Zero);
			ImGui_SetAlignment(eImGuiAlign_CenterLeft);
			ImGui_DoImage(cImGuiGfx("omnitool_ai_chun_nochip.dds", eImGuiGfx_Texture), cVector3f(-15,15,0));
			ImGui_SetAlignment(eImGuiAlign_TopLeft);
		}
		ImGui_LayoutEnd();
	}
	
	//////////////////////////////////////////////
	// Blinking chip	
	if(ImGui_TimerExists("ErrorBlinkOn")==false && ImGui_TimerExists("ErrorBlinkOff")==false || ImGui_TimerOver("ErrorBlinkOff"))
	{
		ImGui_AddTimer("ErrorBlinkOn", fBlinkTime);
	}
	if(ImGui_TimerOver("ErrorBlinkOn"))
	{
		ImGui_AddTimer("ErrorBlinkOff", fBlinkTime);
	}
	
	if(ImGui_TimerExists("ErrorBlinkOn"))
	{
		ImGui_SetAlignment(eImGuiAlign_CenterCenter);
		ImGui_DoImage(error, ImGui_NrmPos(0.5f, 0.5f, 1.0f), GetUsedGfxSize(error, cVector2f_MinusOne)*0.7f);
	}
}

//------------------------------------------------------------

void CathTool_OnGui_PreInteract(float afTimeStep, eCathToolVariant aVariant, eCathToolTarget aTarget)
{
	tString sBGSuffix = CathTool_GetBGVariantSuffix(aVariant);
	
	cImGuiGfx bg("omnitool_background" + sBGSuffix + ".dds", eImGuiGfx_Texture);
		
	float fTitleSize = 45.0f;
	float fInfoSize = 35.0f;
	
	float fBlinkTime = 1.0f/1.5f;
	
	cImGuiLabelData label;
	label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
	label.mFont.mvSize = cVector2f(fTitleSize);
	
	if(aTarget!=eCathToolTarget_None)
	{
		tString sAnim = "omnitool_";
		switch(aTarget)
		{
			case eCathToolTarget_Panel:		sAnim += "panel"; break;
			case eCathToolTarget_Slot:		sAnim += "slot"; break;
		}
		
		cImGuiGfx anim(sAnim + CathTool_GetAnimVariantSuffix(aVariant) + "_01.dds", eImGuiGfx_TextureAnimated);
		anim.mfAnimationTime = 1.0f / 14.0f;
		anim.mbCrossfadeAnimation = true;
		
		ImGui_SetAlignment(eImGuiAlign_CenterCenter);
		ImGui_DoImage(anim, ImGui_NrmPos(0.5f, 0.5f, 1.0), GetUsedGfxSize(anim, -1)*0.9f);
		ImGui_SetAlignment(eImGuiAlign_TopLeft);
	}
	
	ImGui_DrawGfx(bg, cVector3f(0,0,0));
	
	ImGui_SetTransCategory("");
	CathTool_DrawTitle(label);
	
	label.mFontAlign = eFontAlign_Left;
	label.mFont.mvSize = cVector2f(fInfoSize);
	
	if(aVariant==eCathToolVariant_HelperJane)
	{
		ImGui_LayoutBegin(eImGuiLayout_X, ImGui_NrmPos(0.5f, 0.85f,1.0f), ImGui_NrmSize(0.3f, 0.1f));
		{
			ImGui_DoLabelExt("A.I.: ", label, cVector3f_Zero);
			ImGui_DoLabelExt("Helper Jane", label, cVector3f_Zero);
			label.mFont.mvSize = cVector2f(fInfoSize)*0.6f;
			ImGui_DoLabelExt("tm", label, cVector3f(0,-2.5f,0));
		}
		ImGui_LayoutEnd();
	}
	else
	{
		ImGui_LayoutBegin(eImGuiLayout_X, ImGui_NrmPos(0.40f, 0.85f,1.0f), ImGui_NrmSize(0.3f, 0.1f));
		{
			ImGui_DoLabelExt("A.I.: ", label, cVector3f_Zero);
			ImGui_SetAlignment(eImGuiAlign_CenterLeft);
			ImGui_DoImage(cImGuiGfx("omnitool_ai_small" + sBGSuffix + ".dds", eImGuiGfx_Texture), cVector3f(-15,15,0));
			ImGui_SetAlignment(eImGuiAlign_TopLeft);
		}
		ImGui_LayoutEnd();
	}
	
	if(CathTool_GetChipBroken() == false)
	{
		cImGuiGfx chip("omnitool_chip" + CathTool_GetChipVariantSuffix(aVariant) + ".dds", eImGuiGfx_Texture);
		
		ImGui_SetAlignment(eImGuiAlign_TopRight);
		ImGui_DoImage(chip, ImGui_NrmPos(1.0f, 0.0f, 1.0f)+cVector3f(-15.0f, 20.0f, 0));
	}
}

//------------------------------------------------------------

void CathTool_OnGui_Interact(float afTimeStep, eCathToolVariant aVariant)
{
	tString sBGSuffix = CathTool_GetBGVariantSuffix(aVariant);
	tString sChipSuffix = CathTool_GetChipVariantSuffix(aVariant);
	
	cImGuiGfx bg("omnitool_background" + sBGSuffix + ".dds", eImGuiGfx_Texture);
	cImGuiGfx buffer("omnitool_buffer" + sChipSuffix +  ".dds", eImGuiGfx_Texture);
	
	float fTitleSize = 45.0f;
	float fInfoSize = 50.0f;
	
	float fBlinkTime = 1.0f/1.5f;
	
	cImGuiLabelData label;
	label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
	label.mFont.mvSize = cVector2f(fTitleSize);
				
	ImGui_DrawGfx(bg, cVector3f(0,0,0));

	ImGui_SetTransCategory("");
	CathTool_DrawTitle(label);
	
	label.mFontAlign = eFontAlign_Left;
	label.mFont.mvSize = cVector2f(fInfoSize);
	label.mFontAlign = eFontAlign_Center;
	
	if(aVariant==eCathToolVariant_HelperJane)
	{
		ImGui_LayoutBegin(eImGuiLayout_X, ImGui_NrmPos(0.2f, 0.40f,1.0f), ImGui_NrmSize(0.5f, 0.1f));
		{
			ImGui_DoLabelExt("A.I.: ", label, cVector3f_Zero);
			ImGui_DoLabelExt("Helper Jane", label, cVector3f_Zero);
			label.mFont.mvSize = cVector2f(fInfoSize)*0.6f;
			ImGui_DoLabelExt("tm", label, cVector3f(0,-2.5f,0));
		}
		ImGui_LayoutEnd();
	}
	else
	{
		ImGui_LayoutBegin(eImGuiLayout_X, ImGui_NrmPos(0.08f, 0.40f,1.0f), ImGui_NrmSize(0.5f, 0.1f));
		{
			ImGui_DoLabelExt("A.I.: ", label, cVector3f_Zero);
			ImGui_SetAlignment(eImGuiAlign_CenterLeft);
			ImGui_DoImage(cImGuiGfx("omnitool_ai" + sBGSuffix + ".dds", eImGuiGfx_Texture), cVector3f(-15,20,0));
			ImGui_SetAlignment(eImGuiAlign_TopLeft);
		}
		ImGui_LayoutEnd();
	}
	
	if(CathTool_GetChipBroken() == false)
	{
		cImGuiGfx chip("omnitool_chip_small" + sChipSuffix + ".dds", eImGuiGfx_Texture);
		
		ImGui_SetAlignment(eImGuiAlign_TopRight);
		ImGui_DoImage(chip, ImGui_NrmPos(1.0f, 0.0f, 1.0f)+cVector3f(-30.0f, 20.0f, 0));
	}
	
	ImGui_FadeStateColor("BufferAlpha", cColor(1,1.0f), 0.1f, eEasing_Linear, false);
	
	CathTool_DrawBuffer(buffer, afTimeStep, true);
}

//------------------------------------------------------------

void CathTool_OnGui_Disconnected(float afTimeStep, eCathToolVariant aVariant)
{
	if (CathTool_GetChipBroken())
	{
		CathTool_OnGui_NoChip(afTimeStep, aVariant);
		return;
	}
	
	tString sBGSuffix = CathTool_GetBGVariantSuffix(aVariant);
	tString sChipSuffix = CathTool_GetChipVariantSuffix(aVariant);
	
	cImGuiGfx bg("omnitool_background" + sBGSuffix + ".dds", eImGuiGfx_Texture);
	cImGuiGfx chip("omnitool_chip_small" + sChipSuffix + ".dds", eImGuiGfx_Texture);
	cImGuiGfx buffer("omnitool_buffer" + sChipSuffix +  ".dds", eImGuiGfx_Texture);
	cImGuiGfx disconnected("omnitool_disconnected" + sBGSuffix + ".dds", eImGuiGfx_Texture);
	
	float fTitleSize = 45.0f;
	float fInfoSize = 50.0f;
	
	float fBlinkTime = 1.0f/1.5f;
	
	cImGuiLabelData label;
	label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
	label.mFont.mvSize = cVector2f(fTitleSize);
				
	ImGui_DrawGfx(bg, cVector3f(0,0,0));

	ImGui_SetTransCategory("");
	CathTool_DrawTitle(label);
	
	label.mFontAlign = eFontAlign_Left;
	label.mFont.mvSize = cVector2f(fInfoSize);
	label.mFontAlign = eFontAlign_Center;
	
	ImGui_SetAlignment(eImGuiAlign_CenterCenter);
	ImGui_DoImage(disconnected, ImGui_NrmPos(0.5f, 0.55f, 1.0f));
	
	ImGui_SetAlignment(eImGuiAlign_TopRight);
	ImGui_DoImage(chip, ImGui_NrmPos(1.0f, 0.0f, 1.0f)+cVector3f(-30.0f, 20.0f, 0));
	
	ImGui_FadeStateColor("BufferAlpha", cColor(1,0.0f), 1.0f, eEasing_Linear, false);
	
	CathTool_DrawBuffer(buffer, afTimeStep, false);
}

//------------------------------------------------------------

tString CathTool_GetBGVariantSuffix(eCathToolVariant aVariant)
{
	tString sSuffix;
	switch(aVariant)
	{
		case eCathToolVariant_Cath:
		case eCathToolVariant_CathDelta:	sSuffix = "_chun";			break;
		
		case eCathToolVariant_CathAbyss:	sSuffix = "_chun_abyss";	break;
	}
	
	return sSuffix;
}

tString CathTool_GetAnimVariantSuffix(eCathToolVariant aVariant)
{
	tString sSuffix;
	switch(aVariant)
	{
		case eCathToolVariant_Cath:			sSuffix = "_chun";					break;
		
		case eCathToolVariant_CathDelta:	
		case eCathToolVariant_CathAbyss:	sSuffix = "_chun_delta";			break;
	}
	
	return sSuffix;
}

tString CathTool_GetChipVariantSuffix(eCathToolVariant aVariant)
{
	tString sSuffix;
	switch(aVariant)
	{
		case eCathToolVariant_Cath:			
		case eCathToolVariant_CathDelta:	
		case eCathToolVariant_CathAbyss:	sSuffix = "_chun";					break;
	}
	
	return sSuffix;
}

void CathTool_DrawTitle(const cImGuiLabelData &in aLabel)
{
	ImGui_DoLabelExt("OMNITOOL v2.5", aLabel, cVector3f(20, 20, 1.0f));
}

void CathTool_DrawBuffer(const cImGuiGfx &in aGfx, float afTimeStep, bool abRotate)
{
	ImGui_SetAlignment(eImGuiAlign_CenterCenter);
	ImGui_SetModRotateAngle(ImGui_GetStateFloat("BufferAngle", 0.0f));
	ImGui_SetModColorMul(ImGui_GetStateColor("BufferAlpha", cColor_White));
	ImGui_DoImage(aGfx, ImGui_NrmPos(0.8625f, 0.78f, 1.0f), GetUsedGfxSize(aGfx, -1)*0.8f);
	
	if(abRotate)
		ImGui_IncStateFloat("BufferAngle", 360.0f*afTimeStep);
}

