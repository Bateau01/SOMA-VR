	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		afStartY = cLux_DrawDebugText("InPlayerLOS: "+mbIsInPlayerLOS, afStartY);
		afStartY = cLux_DrawDebugText("PlayerDetected: "+mBaseObj.PlayerIsDetected(), afStartY);
		//afStartY = cLux_DrawDebugText("SpeedFWD: "+mBaseObj.GetCharBody().GetMaxPositiveMoveSpeed(eCharDir_Forward), afStartY);
		afStartY = cLux_DrawDebugText("StartHuntCount: "+mfStartHuntCount, afStartY);
		afStartY = cLux_DrawDebugText("AttackWhenLookingCount: "+mfHunt_AttackWhenLookingCount, afStartY);
		afStartY = cLux_DrawDebugText("DistToPlayer: "+mBaseObj.GetDistanceToPlayer(), afStartY);
		//afStartY = cLux_DrawDebugText("AttackPauseCount: "+mfHunt_AttackPauseCount, afStartY);
		//afStartY = cLux_DrawDebugText("AttackWhenLookingCount: "+mfHunt_AttackWhenLookingCount, afStartY);
		//afStartY = cLux_DrawDebugText("SpotPlayerCount: "+mfSpotPlayerCount, afStartY);
		//afStartY = cLux_DrawDebugText("TimeSinceKnockdown: "+mfTimeSinceKnockdown, afStartY);
		//afStartY = cLux_DrawDebugText("PlayerSpotted_Count: "+mfPlayerSpotted_Count, afStartY);
		afStartY = cLux_DrawDebugText("TrackActive: "+ mpPathfinder.GetTrackActive(), afStartY);
		afStartY = cLux_DrawDebugText("TrackPaused: "+ mpPathfinder.GetTrackPaused(), afStartY);
		afStartY = cLux_DrawDebugText("TrackNode: "+ mpPathfinder.GetCurrentTrackNode(), afStartY);
		afStartY = cLux_DrawDebugText("TrackWaitTime: "+ mpPathfinder.GetCurrentTrackWaitTime(), afStartY);
		afStartY = cLux_DrawDebugText("JustTeleportedCount: "+ mfJustTeleportedCount, afStartY);
		afStartY = cLux_DrawDebugText("StopWatchingCount: "+ mfPlayerSpotted_StopWatchingCount, afStartY);
		
		if (cLux_GetExplorationModeActive())
		{
			afStartY = cLux_DrawDebugText("EffectMul: " + mfDistortionEffectMul, afStartY);
		}
		
		
		return afStartY;
	}
	
